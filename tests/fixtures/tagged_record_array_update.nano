import "src_nano/parser.nano"
fn main() -> int {
    let tokens: List<LexerToken> = (tokenize_string "fn answer(x: int) -> int { return x }" "update.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "update.nano")
    assert (not parser.has_error)
    assert (== parser.functions_count 1)
    let alias: Parser = parser
    let owner: array<int> = (parser_get_function parser 0).affine_owner
    (array_set owner 0 7)
    (parser_set_function_affine parser 0 1)
    let checked: ASTFunction = (parser_get_function alias 0)
    assert (== checked.checked_affine 1)
    assert (== checked.affine_completed_epoch 7)
    assert (== checked.name "answer")
    assert (== checked.param_count 1)
    assert (== checked.return_type "int")
    assert (== (at checked.affine_owner 0) 7)
    (parser_set_function_affine alias 0 0)
    let reset: ASTFunction = (parser_get_function parser 0)
    assert (== reset.checked_affine 0)
    assert (== reset.affine_completed_epoch 0)
    assert (== (at owner 0) 7)
    assert (== reset.name "answer")
    return 0
}
shadow main { assert (== (main) 0) }
