# I keep source arrays unchanged and return the first matching index.
let mut trace: int = 0

fn search_values() -> array<int> {
    set trace (+ (* trace 10) 1)
    return [2, 1, 2]
}

shadow search_values {
    set trace 0
    assert (== (array_length (search_values)) 3)
    assert (== trace 1)
}

fn search_needle() -> int {
    set trace (+ (* trace 10) 2)
    return 2
}

shadow search_needle {
    set trace 0
    assert (== (search_needle) 2)
    assert (== trace 2)
}

fn main() -> int {
    set trace 0
    assert (== (array_index_of (search_values) (search_needle)) 0)
    assert (== trace 12)
    assert (== (array_length (array_reverse (search_values))) 3)
    assert (== trace 121)
    set trace 0
    assert (array_contains (search_values) (search_needle))
    assert (== trace 12)
    let integers: array<int> = [2, 1, 2]
    let reverse: array<int> = (array_reverse integers)
    assert (== (array_length reverse) 3)
    assert (== (at reverse 1) 1)
    assert (== (at integers 0) 2)
    assert (== (array_index_of integers 2) 0)
    assert (== (array_index_of integers 1) 1)
    assert (== (array_index_of integers 9) -1)
    assert (array_contains integers 1)
    assert (not (array_contains integers 9))
    let empty: array<int> = []
    assert (== (array_length (array_reverse empty)) 0)
    assert (== (array_index_of empty 1) -1)
    assert (not (array_contains empty 1))
    let words: array<string> = ["a", "b", "c"]
    let reversed_words: array<string> = (array_reverse words)
    assert (== (at reversed_words 0) "c")
    assert (== (at reversed_words 2) "a")
    assert (== (at words 0) "a")
    let floats: array<float> = (array_reverse [1.5, 2.5])
    assert (== (at floats 0) 2.5)
    let flags: array<bool> = (array_reverse [true, false])
    assert (not (at flags 0))
    assert (at flags 1)
    let empty_words: array<string> = []
    let reversed_empty: array<string> = (array_reverse empty_words)
    let filled: array<string> = (array_push reversed_empty "kept")
    assert (== (at filled 0) "kept")
    assert (== (array_length empty_words) 0)
    return 0
}

shadow main {
    assert (== (main) 0)
}
