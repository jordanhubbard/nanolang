module "src_nano/nvm2c/service_nominal.nano" as nominal
module "src_nano/nvm2c/service_module.nano" as shared
module "src_nano/nvm2c/service_catalog.nano" as catalog
module "src_nano/nvm2c/service_wire.nano" as service
module "src_nano/nvm2c/ownership.nano" as owner
module "src_nano/nvm2c/ownership_wire.nano" as read
module "src_nano/nvm2c/passive_calls.nano" as calls
extern fn get_argc() -> int
extern fn get_argv(index: int) -> string

fn numbers(values: array<int>, start: int, length: int) -> string {
    if (> length 64) {
        let left: int = (/ length 2)
        return (+ (numbers values start left) (numbers values (+ start left) (- length left)))
    }
    let mut result: string = ""
    let mut i: int = start
    while (< i (+ start length)) { set result (+ (+ result (int_to_string (at values i))) ",") set i (+ i 1) }
    return result
}
shadow numbers { assert (== (numbers [0,4294967295] 0 2) "0,4294967295,") }

fn row_numbers(row: nominal.Row) -> array<int> {
    return [(cond (row.found 1) (else 0)),row.global_index,row.instance,row.catalog,row.ordinal,row.source,row.kind,row.flags,row.category]
}
shadow row_numbers { assert (== (at (row_numbers (nominal.layout nominal.Plan { status: 1, instances: [], rows: [], record_rows: [], union_rows: [] } 0)) 0) 0) }
fn unified_numbers(row: nominal.Row) -> array<int> {
    return [(cond (row.found 1) (else 0)),row.global_index,(nominal.logical_id row),row.source,row.kind,row.flags,row.category]
}
shadow unified_numbers { assert (== (at (unified_numbers (nominal.logical_type nominal.Plan { status: 1, instances: [], rows: [], record_rows: [], union_rows: [] } 0)) 2) 4294967295) }
fn unified(plan: nominal.Plan) -> array<int> {
    let mut values: array<int> = []
    let mut i: int = 0
    while (<= i (array_length plan.rows)) {
        let row: array<int> = (unified_numbers (nominal.layout plan i))
        let mut j: int = 0
        while (< j 7) { set values (array_push values (at row j)) set j (+ j 1) }
        set i (+ i 1)
    }
    set i 0
    while (<= i (* (array_length plan.instances) 9)) {
        let row: array<int> = (unified_numbers (nominal.logical_type plan i))
        let mut j: int = 0
        while (< j 7) { set values (array_push values (at row j)) set j (+ j 1) }
        let cat: int = (nominal.instance_catalog plan (/ i 9))
        set values (array_push values (cond ((< (% i 9) (service.catalog_types cat)) 1) (else 0)))
        set values (array_push values (nominal.logical_types plan i))
        set values (array_push values (cond ((nominal.logical_endpoint plan i) 1) (else 0)))
        set i (+ i 1)
    }
    set i 0
    while (<= i (* (array_length plan.instances) 5)) {
        set values (array_push values (nominal.logical_import plan i))
        let cat: int = (nominal.instance_catalog plan (/ i 5))
        set values (array_push values (cond ((< (% i 5) (service.catalog_methods cat)) 1) (else 0)))
        set i (+ i 1)
    }
    return values
}
shadow unified { assert (> (array_length (unified nominal.Plan { status: 1, instances: [], rows: [], record_rows: [], union_rows: [] })) 0) }
fn report(plan: nominal.Plan, profile: int) -> string {
    if (!= plan.status 0) { return (int_to_string plan.status) }
    let mut values: array<int> = [(array_length plan.rows),(array_length plan.instances)]
    let mut i: int = 0
    while (<= i (array_length plan.rows)) {
        let row: array<int> = (row_numbers (nominal.layout plan i))
        let mut j: int = 0
        while (< j 9) { set values (array_push values (at row j)) set j (+ j 1) }
        set i (+ i 1)
    }
    set i 0
    while (<= i (array_length plan.instances)) {
        let mut types: int = 0
        let mut methods: int = 0
        if (< i (array_length plan.instances)) { set types (service.catalog_types (at plan.instances i).catalog) set methods (service.catalog_methods (at plan.instances i).catalog) }
        let mut j: int = 0
        while (<= j types) {
            let row: array<int> = (row_numbers (nominal.type_at plan i j))
            let mut k: int = 0
            while (< k 9) { set values (array_push values (at row k)) set k (+ k 1) }
            set j (+ j 1)
        }
        set j 0
        while (<= j methods) { set values (array_push values (nominal.import_index plan i j)) set j (+ j 1) }
        set i (+ i 1)
    }
    let mut kind: int = 0
    while (< kind 4) {
        let mut count: int = 0
        if (== kind 0) { set count (array_length plan.record_rows) }
        if (== kind 2) { set count (array_length plan.union_rows) }
        set i 0
        while (<= i count) {
            let row: array<int> = (row_numbers (nominal.source plan kind i))
            let mut j: int = 0
            while (< j 9) { set values (array_push values (at row j)) set j (+ j 1) }
            set i (+ i 1)
        }
        set kind (+ kind 1)
    }
    if (== profile 5) {
        let extra: array<int> = (unified plan)
        set i 0
        while (< i (array_length extra)) { set values (array_push values (at extra i)) set i (+ i 1) }
    }
    return (+ "0|" (numbers values 0 (array_length values)))
}
shadow report { assert (== (report nominal.Plan { status: 2, instances: [], rows: [], record_rows: [], union_rows: [] } 5) "2") }

fn shared_report(bytes: array<u8>, ownership: array<u8>, model: owner.Module, imports: array<nominal.Import>, refs: int, callbacks: int) -> string {
    let status: int = (shared.validate bytes ownership model imports refs callbacks)
    let present: bool = (shared.present bytes imports)
    let file: bool = (shared.file_instructions model)
    let first: string = (+ (+ (int_to_string status) "|") (int_to_string (cond (present 1) (else 0))))
    let second: string = (+ "," (int_to_string (cond (file 1) (else 0))))
    let third: string = (+ "," (int_to_string (cond ((or present file) 1) (else 0))))
    return (+ (+ first second) third)
}
shadow shared_report {
    let model: owner.Module = owner.Module { layouts: [], code: [], strings: [], functions: [], params: [], results: [], records: 0, enums: 0, unions: 0 }
    assert (== (shared_report [] [] model [] 0 0) "0|0,0,0")
}

fn analyze(input: array<u8>, profile: int) -> string {
    let pre: read.Cursor = (read.open input)
    let service_size: int = (read.read_u32 pre)
    let count: int = (read.read_u32 pre)
    let refs: int = (read.read_u32 pre)
    let callbacks: int = (read.read_u32 pre)
    if (or (!= (read.status pre) 0) (> count (/ (- (array_length input) (read.position pre)) 24))) { return "99" }
    let mut imports: array<nominal.Import> = []
    let mut item: int = 0
    while (< item count) {
        let module_name: int = (read.read_u32 pre)
        let symbol: int = (read.read_u32 pre)
        let kind: int = (read.read_u32 pre)
        let arity: int = (read.read_u32 pre)
        let result: int = (read.read_u32 pre)
        let length: int = (read.read_u32 pre)
        if (or (!= (read.status pre) 0) (or (> kind 255) (or (> arity 65535) (or (> result 255) (and (!= length 0) (!= length arity)))))) { return "99" }
        let start: int = (read.skip pre length)
        if (!= (read.status pre) 0) { return "99" }
        let mut tags: array<int> = []
        let mut j: int = 0
        while (< j length) { set tags (array_push tags (cast_int (at input (+ start j)))) set j (+ j 1) }
        set imports (array_push imports nominal.Import { module_name: module_name, symbol: symbol, kind: kind, arity: arity, result: result, params: tags })
        set item (+ item 1)
    }
    let service_at: int = (read.skip pre service_size)
    if (!= (read.status pre) 0) { return "99" }
    let service_bytes: array<u8> = (array_slice input service_at service_size)
    let bytes: array<u8> = (array_slice input (read.position pre) (- (array_length input) (read.position pre)))
    let c: read.Cursor = (read.open bytes)
    let layout_size: int = (read.read_u32 c)
    let own_size: int = (read.read_u32 c)
    let strings: int = (read.read_u32 c)
    let functions: int = (read.read_u32 c)
    let records: int = (read.read_u32 c)
    let enums: int = (read.read_u32 c)
    let unions: int = (read.read_u32 c)
    if (!= (read.status c) 0) { return "99" }
    if (> strings (/ (- (array_length bytes) (read.position c)) 4)) { return "99" }
    let mut names: array<array<u8>> = []
    let mut i: int = 0
    while (< i strings) {
        let length: int = (read.read_u32 c)
        let start: int = (read.skip c length)
        if (!= (read.status c) 0) { return "99" }
        set names (array_push names (array_slice bytes start length))
        set i (+ i 1)
    }
    if (> functions (/ (- (array_length bytes) (read.position c)) 32)) { return "99" }
    let mut entries: array<calls.Function> = []
    let mut params: array<array<int>> = []
    let mut results: array<int> = []
    set i 0
    while (< i functions) {
        let start: int = (read.read_u32 c)
        let length: int = (read.read_u32 c)
        let arity: int = (read.read_u32 c)
        let locals: int = (read.read_u32 c)
        let upvalues: int = (read.read_u32 c)
        let result_count: int = (read.read_u32 c)
        let result_tag: int = (read.read_u32 c)
        let types: int = (read.read_u32 c)
        if (!= (read.status c) 0) { return "99" }
        if (or (> arity 65535) (or (> locals 65535) (or (> upvalues 65535) (or (> result_count 255) (> result_tag 255))))) { return "99" }
        if (and (!= types 0) (!= types arity)) { return "99" }
        let at_position: int = (read.skip c types)
        if (!= (read.status c) 0) { return "99" }
        let mut tags: array<int> = []
        let mut j: int = 0
        while (< j types) {
            set tags (array_push tags (cast_int (at bytes (+ at_position j)))) set j (+ j 1)
        }
        set entries (array_push entries calls.Function { start: start, length: length, arity: arity, locals: locals, upvalues: upvalues, results: result_count })
        set params (array_push params tags)
        set results (array_push results result_tag)
        set i (+ i 1)
    }
    let layout_at: int = (read.skip c layout_size)
    let own_at: int = (read.skip c own_size)
    if (or (!= (read.status c) 0) (> (- (array_length bytes) (read.position c)) 4294967295)) { return "99" }
    let model: owner.Module = owner.Module {
        layouts: (array_slice bytes layout_at layout_size),
        code: (array_slice bytes (read.position c) (- (array_length bytes) (read.position c))),
        strings: names, functions: entries, params: params, results: results, records: records, enums: enums, unions: unions }
    if (== profile 0) { return (shared_report service_bytes (array_slice bytes own_at own_size) model imports refs callbacks) }
    return (report (nominal.prepare service_bytes (array_slice bytes own_at own_size) model imports refs callbacks profile) profile)
}
shadow analyze { assert (== (analyze [] 2) "99") }

fn string_token(text: string) -> string { return (+ (+ (+ (int_to_string (str_length text)) ":") text) ";") }
shadow string_token { assert (== (string_token "abc") "3:abc;") }
fn number_token(number: int) -> string { return (+ (+ "#" (int_to_string number)) ";") }
shadow number_token { assert (== (number_token 4) "#4;") }
fn catalog_view(cat: int) -> string {
    let mut prefix: string = "file"
    if (== cat 2) { set prefix "socket" }
    if (== cat 3) { set prefix "websocket" }
    let mut result: string = (+ prefix "-source-catalog1;")
    set result (+ result (string_token (catalog.text cat 0 0 0 0)))
    set result (+ result (number_token (catalog.count cat 1)))
    set result (+ result (number_token (catalog.count cat 2)))
    let mut i: int = 0
    while (< i (catalog.count cat 1)) {
        let mut f: int = 0
        while (< f 2) { set result (+ result (string_token (catalog.text cat 1 i f 0))) set f (+ f 1) }
        set f 0
        while (< f 2) { set result (+ result (number_token (catalog.number cat 1 i f 0))) set f (+ f 1) }
        let mut j: int = 0
        while (< j (catalog.number cat 1 i 1 0)) {
            set f 2
            while (< f 5) { set result (+ result (string_token (catalog.text cat 1 i f j))) set f (+ f 1) }
            set result (+ result (number_token (catalog.number cat 1 i 2 j)))
            set j (+ j 1)
        }
        set i (+ i 1)
    }
    set i 0
    while (< i (catalog.count cat 2)) {
        let mut f: int = 0
        while (< f 4) { set result (+ result (string_token (catalog.text cat 2 i f 0))) set f (+ f 1) }
        set f 0
        while (< f 5) { set result (+ result (number_token (catalog.number cat 2 i f 0))) set f (+ f 1) }
        let mut j: int = 0
        while (< j (catalog.number cat 2 i 4 0)) {
            set f 4
            while (< f 7) { set result (+ result (string_token (catalog.text cat 2 i f j))) set f (+ f 1) }
            set f 5
            while (< f 10) { set result (+ result (number_token (catalog.number cat 2 i f j))) set f (+ f 1) }
            set j (+ j 1)
        }
        set j 0
        while (< j 2) {
            set result (+ result (number_token (catalog.number cat 2 i 10 j)))
            set result (+ result (string_token (catalog.text cat 2 i 7 j)))
            set j (+ j 1)
        }
        set i (+ i 1)
    }
    return result
}
shadow catalog_view { assert (str_starts_with (catalog_view 1) "file-source-catalog1;") }
fn main() -> int {
    unsafe {
        if (== (get_argv 1) "--catalog") {
            let mut i: int = 1
            while (<= i 3) { (println (catalog_view i)) set i (+ i 1) }
            return 0
        }
        let profile: int = (string_to_int (get_argv 1))
        let mut i: int = 2
        while (< i (get_argc)) { (println (analyze (file_read_bytes (get_argv i)) profile)) set i (+ i 1) }
    }
    return 0
}
shadow main { assert (== (main) 0) }
