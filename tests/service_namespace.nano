# I compare original service identity after aliases and re-exports.
import "src_nano/compiler/service_namespace.nano"
import "src_nano/parser.nano"
from "src_nano/compiler/lexer.nano" import tokenize_string
import "src_nano/compiler/service_origins.nano"
import "src_nano/compiler/service_inputs.nano"
import "modules/file_source_inputs/file_source_inputs.nano"
extern fn get_argc() -> int
extern fn get_argv(index: int) -> string

fn check_namespace(one: string, two: string, bridge: string, root: string) -> int {
    let declaration: string = "service \"nsi:nanolang/filesystem\" catalog 1 from \"interface.nsi.json\"\n"
    let source: string = (+ (+ declaration declaration) "pub use \"one/binding.nano\" as files\nfrom \"one/binding.nano\" import File as Handle\nmodule \"bridge.nano\" as bridge\nmodule \"two/binding.nano\" as other\nfn ordinary() -> int { return 0 }\n")
    let tokens: List<LexerToken> = (tokenize_string source root (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) root)
    assert (not parser.has_error)
    let files: array<string> = [one, two, bridge, root]
    let sources: array<string> = [one, two, bridge, root, root, root, root, root]
    let origins: ServiceOrigins = (bind_service_origins parser files sources [1, 1, 1, 1, 2, 3, 4, 5])
    assert origins.ok
    unsafe {
        let context: NlFileSourceSnapshots = (nl_source_inputs_new)
        let inputs: ServiceInputs = (acquire_service_inputs parser files origins context)
        assert inputs.ok
        let space: ServiceNamespace = (resolve_service_namespace parser files sources [0, 0, 2, 1] origins inputs context)
        assert (== space.status 0)
        assert (== (array_length space.plan.rows) 27)
        let alias: int = (service_namespace_lookup space 3 "Handle")
        let qualified: int = (service_namespace_lookup space 3 "bridge.files.File")
        let distinct: int = (service_namespace_lookup space 3 "other.File")
        assert (>= alias 0) assert (>= qualified 0) assert (>= distinct 0)
        assert (== (at space.names alias).target (at space.names qualified).target)
        assert (!= (at space.names qualified).target (at space.names distinct).target)
        assert (== (at space.names qualified).target_owner 0)
        assert (== (at space.names distinct).target_owner 1)
        assert (== (service_namespace_lookup space 3 "bridge.files.Absent") -1)
        let bad_targets: ServiceNamespace = (resolve_service_namespace parser files sources [0, 0, 3, 1] origins inputs context)
        assert (== bad_targets.status 4)
        let bad_sources: ServiceNamespace = (resolve_service_namespace parser files [one, two, bridge, root, root, root, "/missing"] [0, 0, 2, 1] origins inputs context)
        assert (== bad_sources.status 1)
        let swapped: ServiceInputs = ServiceInputs { ok: true, paths: inputs.paths, snapshots: [1, 0] }
        assert (== (resolve_service_namespace parser files sources [0, 0, 2, 1] origins swapped context).status 1)
        let missing_paths: ServiceInputs = ServiceInputs { ok: true, paths: [], snapshots: inputs.snapshots }
        assert (== (resolve_service_namespace parser files sources [0, 0, 2, 1] origins missing_paths context).status 1)
        (nl_source_inputs_free context)
    }
    (println "PASS independent Nano namespace identities")
    return 0
}
shadow check_namespace {
    let space: ServiceNamespace = ServiceNamespace { status: 0, names: [], plan: FileSourcePlan { status: 0, rows: [], logical_bytes: 0 }, text_bytes: 0, ordinary_count: 0, alias_count: 0 }
    assert (== (service_namespace_lookup space 0 "File") -1)
}

fn main() -> int {
    unsafe {
        if (!= (get_argc) 5) { return 2 }
        return (check_namespace (get_argv 1) (get_argv 2) (get_argv 3) (get_argv 4))
    }
}
shadow main { assert true }
