/* Test: temporary file and directory operations */
from "modules/std/fs.nano" import exists, write, read, delete
fn main() -> int {
    return 0
}

shadow main {
    let dir = (tmp_dir)
    assert (!= dir "")

    let path = (mktemp "nanolang_test_")
    assert (!= path "")
    assert (exists path)
    assert (== (write path "hello") 0)
    let s = (read path)
    assert (== s "hello")
    assert (== (delete path) 0)

    let dpath = (mktemp_dir "nanolang_dir_")
    assert (!= dpath "")
    assert (exists dpath)
    assert (== (delete dpath) 0)
}
