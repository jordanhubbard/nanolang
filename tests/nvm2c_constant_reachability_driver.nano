module "src_nano/nvm2c/constant_reachability.nano" as reach
module "src_nano/nvm2c/container.nano" as wire
extern fn get_argc() -> int
extern fn get_argv(index: int) -> string

# My diagnostic packet is u32 function/import counts, selected function/query,
# then five u32 fields per function, two per import, followed by raw code.
fn describe(bytes: array<u8>) -> string {
    if (< (array_length bytes) 16) { return "0" }
    let count: int = (wire.read_u32 bytes 0)
    let foreign: int = (wire.read_u32 bytes 4)
    if (or (> count (/ (- (array_length bytes) 16) 20)) (> foreign (/ (- (array_length bytes) 16) 8))) { return "0" }
    let header: int = (+ 16 (+ (* count 20) (* foreign 8)))
    if (> header (array_length bytes)) { return "0" }
    let mut functions: array<reach.Function> = []
    let mut imports: array<reach.Foreign> = []
    let mut i: int = 0
    while (< i count) {
        let at_index: int = (+ 16 (* i 20))
        set functions (array_push functions reach.Function { start: (wire.read_u32 bytes at_index),
            length: (wire.read_u32 bytes (+ at_index 4)), arity: (wire.read_u32 bytes (+ at_index 8)),
            locals: (wire.read_u32 bytes (+ at_index 12)), results: (wire.read_u32 bytes (+ at_index 16)) })
        set i (+ i 1)
    }
    set i 0
    while (< i foreign) {
        let at_index: int = (+ 16 (+ (* count 20) (* i 8)))
        let parameters: int = (wire.read_u32 bytes at_index)
        let tag: int = (wire.read_u32 bytes (+ at_index 4))
        if (or (> parameters 65535) (> tag 255)) { return "0" }
        set imports (array_push imports reach.Foreign { parameters: parameters, return_tag: tag })
        set i (+ i 1)
    }
    if (reach.unreachable (array_slice bytes header (- (array_length bytes) header)) functions imports
        (wire.read_u32 bytes 8) (wire.read_u32 bytes 12)) { return "1" }
    return "0"
}
shadow describe { assert (== (describe []) "0") }
fn main() -> int {
    unsafe {
        for i in (range 1 (get_argc)) { (println (describe (file_read_bytes (get_argv i)))) }
    }
    return 0
}
