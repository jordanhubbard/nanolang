import "src_nano/typecheck.nano"
import "src_nano/compiler/lexer.nano"
import "src_nano/parser.nano"
import "src_nano/compiler/diagnostics.nano" as ScopeDiagnostics
extern fn get_argc() -> int
extern fn get_argv(index: int) -> string
extern fn file_read(path: string) -> string

fn scope_type_equal(left: NSType, right: NSType) -> bool {
    return (and (and (== left.kind right.kind) (== left.name right.name)) (and (== left.element_type_kind right.element_type_kind) (== left.element_type_name right.element_type_name)))
}
shadow scope_type_equal {
    assert (scope_type_equal (type_int) (type_int))
    assert (not (scope_type_equal (type_int) (type_float)))
    assert (not (scope_type_equal (type_array_of (type_string)) (type_array_of (type_int))))
}

fn scope_symbol_equal(left: Symbol, right: Symbol) -> bool {
    if (or (!= left.name right.name) (not (scope_type_equal left.sym_type right.sym_type))) { return false }
    if (or (!= left.is_mutable right.is_mutable) (!= left.is_function right.is_function)) { return false }
    if (or (!= left.defined right.defined) (!= left.param_count right.param_count)) { return false }
    if (not (scope_type_equal left.return_type right.return_type)) { return false }
    if (!= (array_length left.param_types) (array_length right.param_types)) { return false }
    let mut index: int = 0
    while (< index (array_length left.param_types)) {
        if (not (scope_type_equal (at left.param_types index) (at right.param_types index))) { return false }
        set index (+ index 1)
    }
    return true
}
shadow scope_symbol_equal {
    let first: Symbol = (symbol_new "first" (type_int) false false 0 (empty_param_types) (type_void))
    let other: Symbol = (symbol_new "other" (type_int) false false 0 (empty_param_types) (type_void))
    assert (scope_symbol_equal first first)
    assert (not (scope_symbol_equal first other))
    let metadata: Symbol = (symbol_new "first" (type_int) true true 1 [(type_bool)] (type_string))
    assert (not (scope_symbol_equal first metadata))
}

# I retain the original loop as my comparison, without calling the candidate.
fn scope_manual_copy(symbols: array<Symbol>) -> array<Symbol> {
    let mut copy: array<Symbol> = []
    let mut i: int = 0
    while (< i (array_length symbols)) {
        set copy (array_push copy (at symbols i))
        set i (+ i 1)
    }
    return copy
}
shadow scope_manual_copy {
    let input: array<Symbol> = [(symbol_new "outer" (type_int) false false 0 (empty_param_types) (type_void))]
    let copy: array<Symbol> = (scope_manual_copy input)
    assert (scope_symbol_equal (at input 0) (at copy 0))
    (array_set copy 0 (symbol_new "changed" (type_bool) false false 0 (empty_param_types) (type_void)))
    assert (== (at input 0).name "outer")
}

fn scope_check_copy(count: int) -> int {
    let mut input: array<Symbol> = []
    let mut index: int = 0
    while (< index count) {
        let mut parameter_types: array<NSType> = []
        set parameter_types (array_push parameter_types (type_int))
        set parameter_types (array_push parameter_types (type_array_of (type_bool)))
        let value: Symbol = Symbol {
            name: (+ "binding-" (int_to_string (% index 3))),
            sym_type: (type_array_of (type_string)),
            is_mutable: (== (% index 2) 0), is_function: true,
            param_count: 2, defined: (!= (% index 3) 0),
            param_types: parameter_types, return_type: (type_float)
        }
        set input (array_push input value)
        set index (+ index 1)
    }
    let expected: array<Symbol> = (scope_manual_copy input)
    let actual: array<Symbol> = (env_copy_symbols input)
    assert (== (array_length actual) count)
    set index 0
    while (< index count) {
        assert (scope_symbol_equal (at expected index) (at actual index))
        assert (scope_symbol_equal (at input index) (at actual index))
        set index (+ index 1)
    }
    for name in ["binding-0", "binding-1", "binding-2", "absent"] {
        assert (== (env_lookup actual name) (env_lookup expected name))
    }
    if (> count 0) {
        let child: array<NSType> = (at actual 0).param_types
        (array_set child 0 (type_bool))
        assert (== (at (at input 0).param_types 0).kind TypeKind.TYPE_BOOL)
        assert (== (at (at expected 0).param_types 0).kind TypeKind.TYPE_BOOL)
        let prior: Symbol = (at input 0)
        (array_set actual 0 (symbol_new "replacement" (type_int) false false 0 (empty_param_types) (type_void)))
        assert (scope_symbol_equal (at input 0) prior)
        assert (scope_symbol_equal (at expected 0) prior)
        assert (== (at actual 0).name "replacement")
    }
    let extended: array<Symbol> = (env_add_symbol actual (symbol_new "appended" (type_bool) false false 0 (empty_param_types) (type_void)))
    assert (== (array_length extended) (+ count 1))
    assert (== (array_length input) count)
    assert (== (array_length expected) count)
    assert (== (env_lookup extended "appended") count)
    return count
}
shadow scope_check_copy {
    assert (== (scope_check_copy 0) 0)
    assert (== (scope_check_copy 3) 3)
}

fn scope_function_tables() -> void {
    let parser: Parser = (resource_test_parser "extern fn observed(outside:string, enabled:bool)->float fn reader(amount:int)->int{return (+ outside amount)} fn floating(amount:float)->float{if (<= amount 0.0){return 0.0}return (floating (- amount 1.0))}")
    assert (not parser.has_error)
    let original: Symbol = (symbol_new "outside" (type_int) false false 0 (empty_param_types) (type_void))
    let mut symbols: array<Symbol> = []
    set symbols (array_push symbols original)
    let diagnostics: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let prototype: ASTFunction = (parser_get_function parser 0)
    assert (< prototype.body 0)
    assert (check_function parser prototype symbols diagnostics "function-scope.nano")
    assert (== (array_length symbols) 1)
    assert (scope_symbol_equal (at symbols 0) original)
    assert (< (env_lookup symbols "enabled") 0)
    let empty: array<Symbol> = []
    assert (check_function parser prototype empty diagnostics "function-scope.nano")
    assert (== (array_length empty) 0)
    let defined: ASTFunction = (parser_get_function parser 1)
    assert (== defined.body 0)
    assert (check_function parser defined symbols diagnostics "function-scope.nano")
    assert (scope_symbol_equal (at symbols 0) original)
    assert (< (env_lookup symbols "amount") 0)
    assert (check_function parser (parser_get_function parser 2) symbols diagnostics "function-scope.nano")
    assert (< (env_lookup symbols "floating") 0)
    assert (not (ScopeDiagnostics.diag_list_has_errors diagnostics))
    let reserved: Parser = (resource_test_parser "fn float_from_bits(amount:int)->float{return 0.0}")
    let refused: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    assert (not (check_function reserved (parser_get_function reserved 0) symbols refused "function-scope.nano"))
    assert (== (list_CompilerDiagnostic_length refused) 1)
    assert (== (list_CompilerDiagnostic_get refused 0).code "E0010")
    assert (scope_symbol_equal (at symbols 0) original)
}
shadow scope_function_tables { (scope_function_tables) }

fn scope_lookup_names() -> void {
    let mut symbols: array<Symbol> = []
    assert (== (env_lookup symbols "") -1)
    assert (== (env_lookup symbols "alpha") -1)
    set symbols (array_push symbols (symbol_new "" (type_void) false false 0 (empty_param_types) (type_void)))
    set symbols (array_push symbols (symbol_new "alpha" (type_int) false false 0 (empty_param_types) (type_void)))
    set symbols (array_push symbols (symbol_new "Alpha" (type_bool) false false 0 (empty_param_types) (type_void)))
    set symbols (array_push symbols (symbol_new "alpha" (type_string) false false 0 (empty_param_types) (type_void)))
    set symbols (array_push symbols (symbol_new "alphabet" (type_float) false false 0 (empty_param_types) (type_void)))
    let mut index: int = 0
    while (< index 128) {
        set symbols (array_push symbols (symbol_new (+ "slot-" (int_to_string index)) (type_array_of (type_string)) false false 0 (empty_param_types) (type_void)))
        set index (+ index 1)
    }
    assert (== (env_lookup symbols "") 0)
    assert (== (env_lookup symbols "alpha") 3)
    assert (== (env_lookup symbols "Alpha") 2)
    assert (== (env_lookup symbols "alphabet") 4)
    assert (== (env_lookup symbols "alph") -1)
    assert (== (env_lookup symbols "slot-0") 5)
    assert (== (env_lookup symbols "slot-64") 69)
    assert (== (env_lookup symbols "slot-127") 132)
    assert (== (env_lookup symbols "slot-128") -1)
    assert (== (env_lookup symbols "SLOT-0") -1)
    let copied: array<Symbol> = (env_copy_symbols symbols)
    let alias: array<Symbol> = symbols
    (array_set alias 3 (symbol_new "renamed" (type_int) false false 0 (empty_param_types) (type_void)))
    assert (== (array_length symbols) 133)
    assert (== (env_lookup symbols "alpha") 1)
    assert (== (env_lookup symbols "renamed") 3)
    assert (== (env_lookup copied "alpha") 3)
    assert (== (env_lookup copied "renamed") -1)
    (array_set alias 1 (symbol_new "replaced" (type_bool) false false 0 (empty_param_types) (type_void)))
    assert (== (env_lookup symbols "alpha") -1)
    assert (== (env_lookup symbols "replaced") 1)
    assert (== (env_lookup copied "alpha") 3)
    assert (== (env_lookup symbols "Alpha") 2)
}
shadow scope_lookup_names { (scope_lookup_names) }

fn scope_body_tables() -> void {
    let source: string = "fn isolated(outside:int)->int{let total:int=outside if true{let outside:bool=true assert outside let branch_only:string=\"branch\"} while false{let outside:string=\"loop\"} for item in [1]{let outside:bool=true assert outside} unsafe{let outside:float=1.0} return (+ total outside)}"
    let parser: Parser = (resource_test_parser source)
    assert (not parser.has_error)
    let outer: Symbol = (symbol_new "outside" (type_bool) true false 0 (empty_param_types) (type_void))
    let mut symbols: array<Symbol> = []
    set symbols (array_push symbols outer)
    let alias: array<Symbol> = symbols
    let diagnostics: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    assert (check_function parser (parser_get_function parser 0) symbols diagnostics "body-scope.nano")
    assert (not (ScopeDiagnostics.diag_list_has_errors diagnostics))
    assert (== (array_length symbols) 1)
    assert (== (array_length alias) 1)
    assert (scope_symbol_equal (at alias 0) outer)
    for name in ["total", "branch_only", "item"] { assert (< (env_lookup symbols name) 0) }
    let invalid: Parser = (resource_test_parser "fn isolated()->int{if true{let branch_only:int=1} return branch_only}")
    let refused: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    (check_function invalid (parser_get_function invalid 0) symbols refused "body-scope.nano")
    assert (ScopeDiagnostics.diag_list_has_errors refused)
    assert (scope_symbol_equal (at symbols 0) outer)

    let direct: Parser = (resource_test_parser "fn value()->int{let outside:string=\"private\" let local:int=3 if true{let nested:bool=false} local}")
    let block: ASTBlock = (parser_get_block direct (parser_get_function direct 0).body)
    let direct_diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let value: CheckedBlock = (check_statement_list direct block.statements symbols (type_int) direct_diags "body-scope.nano" "value" true)
    assert value.ok
    assert (== value.value_type.kind TypeKind.TYPE_INT)
    assert (not (ScopeDiagnostics.diag_list_has_errors direct_diags))
    assert (== (array_length symbols) 1)
    assert (scope_symbol_equal (at alias 0) outer)
    assert (< (env_lookup symbols "local") 0)
    assert (< (env_lookup symbols "nested") 0)
}
shadow scope_body_tables { (scope_body_tables) }

fn scope_report_octets(text: string) -> int {
    let data: array<u8> = (bytes_from_string text)
    (println (int_to_string (array_length data)))
    let mut index: int = 0
    while (< index (array_length data)) {
        (println (int_to_string (cast_int (at data index))))
        set index (+ index 1)
    }
    return (array_length data)
}
shadow scope_report_octets { assert (== (scope_report_octets "é") 2) }

fn scope_report_source(source: string) -> int {
    let lexical: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let tokens: List<LexerToken> = (tokenize_string source "scope.nano" lexical)
    assert (not (ScopeDiagnostics.diag_list_has_errors lexical))
    let parsed: Parser = (parse_program tokens (list_LexerToken_length tokens) "scope.nano")
    assert (not parsed.has_error)
    let checked: TypecheckPhaseOutput = (typecheck_phase parsed "scope.nano")
    (println "TYPECHECK")
    if checked.had_error { (println "1") } else { (println "0") }
    (println (int_to_string (list_CompilerDiagnostic_length checked.environment.diagnostics)))
    if checked.environment.has_error { (println "1") } else { (println "0") }
    (println (int_to_string checked.environment.error_count))
    (println (int_to_string (list_CompilerDiagnostic_length checked.diagnostics)))
    let mut index: int = 0
    while (< index (list_CompilerDiagnostic_length checked.diagnostics)) {
        let diag: CompilerDiagnostic = (list_CompilerDiagnostic_get checked.diagnostics index)
        (println (int_to_string diag.phase))
        (println (int_to_string diag.severity))
        (scope_report_octets diag.code)
        (scope_report_octets diag.message)
        (scope_report_octets diag.location.file)
        (println (int_to_string diag.location.line))
        (println (int_to_string diag.location.column))
        set index (+ index 1)
    }
    return checked.environment.error_count
}
shadow scope_report_source {
    assert (== (scope_report_source "fn value()->int{return 1}") 0)
    assert (> (scope_report_source "fn value()->int{return true}") 0)
}

fn main() -> int {
    (scope_lookup_names)
    (scope_function_tables)
    (scope_body_tables)
    for count in [0, 1, 2, 7, 8, 9, 15, 16, 17, 63, 64, 65, 127, 128] {
        assert (== (scope_check_copy count) count)
    }
    (println "SCOPE-COPY-OK")
    unsafe {
        if (== (get_argc) 1) { return 0 }
        if (!= (get_argc) 2) { return 2 }
        let errors: int = (scope_report_source (file_read (get_argv 1)))
        if (< errors 0) { return 1 }
    }
    return 0
}
shadow main { assert (== (scope_check_copy 2) 2) (scope_function_tables) (scope_lookup_names) (scope_body_tables) }
