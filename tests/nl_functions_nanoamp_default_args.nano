# Example: NanoAmp Default-Args Regression Test
# Purpose: Guard that sdl_nanoamp's `# Default Args:` header names a real
#          directory whose audio scan is non-empty, so the launcher never
#          silently runs the player with no music directory again.
# Category: language
# Difficulty: Intermediate
# Expected Output: ok
#
# This turns the manual `clean_env_run` verification for
# examples/audio/sdl_nanoamp.nano into an automated check that runs under
# `make test-quick`. It uses the repository's real header parser
# (examples/lib/example_discovery.nano :: parse_example_header) rather than a
# re-implementation, and mirrors the player's audio-extension predicate
# (the .mod/.mp3/.ogg/.wav set that examples/audio/sdl_nanoamp.nano scans).

from "examples/lib/example_discovery.nano" import parse_example_header, ExampleInfo
from "modules/std/fs.nano" import exists

module "modules/filesystem/filesystem.nano"

let NANOAMP_PATH: string = "examples/audio/sdl_nanoamp.nano"

# Count playable audio files in `dir`, mirroring the extension set the
# sdl_nanoamp player itself scans (.mod/.mp3/.ogg/.wav), using the same
# case-insensitive filesystem listing idiom.
fn count_playable_audio(dir: string) -> int {
    let mods: array<string> = (nl_fs_list_files_ci dir ".mod")
    let mp3s: array<string> = (nl_fs_list_files_ci dir ".mp3")
    let oggs: array<string> = (nl_fs_list_files_ci dir ".ogg")
    let wavs: array<string> = (nl_fs_list_files_ci dir ".wav")
    return (+ (array_length mods)
             (+ (array_length mp3s)
                (+ (array_length oggs) (array_length wavs))))
}

shadow count_playable_audio {
    # examples/audio commits gabba-studies-12.mod, so a scan of that
    # directory must surface at least one playable file.
    assert (> (count_playable_audio "examples/audio") 0)
    # A directory with no playable audio yields zero.
    assert (== (count_playable_audio "examples/lib") 0)
}

fn main() -> int {
    let info: ExampleInfo = (parse_example_header NANOAMP_PATH)

    # (a) The `# Default Args:` header must be present and non-empty.
    assert (> (str_length info.default_args) 0)
    (print "Default Args header: ")
    (println info.default_args)

    # (b) The directory the header names must exist relative to the repo root.
    assert (exists info.default_args)
    (println "Directory exists.")

    # (c) Scanning that directory with the player's audio-extension predicate
    #     must return at least one playable file.
    let count: int = (count_playable_audio info.default_args)
    (print "Playable audio files found: ")
    (println (int_to_string count))
    assert (> count 0)

    (println "nanoamp default-args regression check passed.")
    return 0
}

shadow main {
    assert (== 0 0)
}
