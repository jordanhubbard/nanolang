/* nl_functions_filter.nano - filter() builtin tests
 * Category: Core Language - Functions
 */

fn is_even(x: int) -> bool {
    return (== (% x 2) 0)
}

shadow is_even {
    assert (is_even 0)
    assert (is_even 2)
    assert (not (is_even 1))
}

fn double(x: int) -> int {
    return (* x 2)
}

shadow double {
    assert (== (double 5) 10)
}

fn add(a: int, b: int) -> int {
    return (+ a b)
}

shadow add {
    assert (== (add 2 3) 5)
}

fn filter_basic() -> array<int> {
    let nums: array<int> = [1, 2, 3, 4, 5, 6]
    return (filter nums is_even)
}

shadow filter_basic {
    let evens: array<int> = (filter_basic)
    assert (== (array_length evens) 3)
    assert (== (at evens 0) 2)
    assert (== (at evens 1) 4)
    assert (== (at evens 2) 6)
}

fn filter_empty_returns_empty() -> int {
    let nums: array<int> = (array_new 0 0)
    let evens: array<int> = (filter nums is_even)
    return (array_length evens)
}

shadow filter_empty_returns_empty {
    assert (== (filter_empty_returns_empty) 0)
}

fn positive_float(x: float) -> bool {
    return (> x 0.0)
}

shadow positive_float {
    assert (positive_float 1.5)
    assert (not (positive_float -1.5))
}

fn nonempty_string(x: string) -> bool {
    return (> (str_length x) 0)
}

shadow nonempty_string {
    assert (nonempty_string "nano")
    assert (not (nonempty_string ""))
}

fn is_true(x: bool) -> bool {
    return x
}

shadow is_true {
    assert (is_true true)
    assert (not (is_true false))
}

fn filter_scalar_literals() -> int {
    let ints: array<int> = (filter [1, 2, 3, 4] is_even)
    let floats: array<float> = (filter [-1.0, 2.5] positive_float)
    let strings: array<string> = (filter ["", "nano"] nonempty_string)
    let bools: array<bool> = (filter [false, true] is_true)
    assert (== (at ints 0) 2)
    assert (== (at floats 0) 2.5)
    assert (== (at strings 0) "nano")
    assert (at bools 0)
    return (+ (+ (array_length ints) (array_length floats))
              (+ (array_length strings) (array_length bools)))
}

shadow filter_scalar_literals {
    assert (== (filter_scalar_literals) 5)
}

fn filter_scalar_variables() -> int {
    let floats: array<float> = [-2.0, 3.5]
    let strings: array<string> = ["", "stage2"]
    let bools: array<bool> = [false, true]
    let filtered_floats: array<float> = (filter floats positive_float)
    let filtered_strings: array<string> = (filter strings nonempty_string)
    let filtered_bools: array<bool> = (filter bools is_true)
    assert (== (at filtered_floats 0) 3.5)
    assert (== (at filtered_strings 0) "stage2")
    assert (at filtered_bools 0)
    return (+ (+ (array_length filtered_floats) (array_length filtered_strings))
              (array_length filtered_bools))
}

shadow filter_scalar_variables {
    assert (== (filter_scalar_variables) 3)
}

fn filter_empty_bool_result() -> int {
    let values: array<bool> = [false]
    let result: array<bool> = (filter values is_true)
    return (array_length result)
}

shadow filter_empty_bool_result {
    assert (== (filter_empty_bool_result) 0)
}

fn pipeline_filter_map_reduce() -> int {
    let nums: array<int> = [1, 2, 3, 4]
    let evens: array<int> = (filter nums is_even)
    let doubled: array<int> = (map evens double)
    return (reduce doubled 0 add)
}

shadow pipeline_filter_map_reduce {
    assert (== (pipeline_filter_map_reduce) 12)
}

fn positive_float(value: float) -> bool { return (> value 0.0) }
shadow positive_float {
    assert (positive_float 2.5)
    assert (not (positive_float 0.0))
}

fn nonempty_text(value: string) -> bool { return (> (str_length value) 0) }
shadow nonempty_text {
    assert (nonempty_text "value")
    assert (not (nonempty_text ""))
}

fn keep_true(value: bool) -> bool { return value }
shadow keep_true {
    assert (keep_true true)
    assert (not (keep_true false))
}

fn main() -> int {
    # I execute callback checks in the native program as well as in shadows.
    let evens: array<int> = (filter_basic)
    assert (== (array_length evens) 3)
    assert (== (at evens 2) 6)
    assert (== (filter_empty_returns_empty) 0)
    assert (== (pipeline_filter_map_reduce) 12)
    let floats: array<float> = [0.0, 2.5]
    let positive: array<float> = (filter floats positive_float)
    assert (== (array_length positive) 1)
    assert (== (at positive 0) 2.5)
    assert (== (array_length floats) 2)
    let rejected: array<float> = (filter [0.0, -1.0] positive_float)
    assert (== (array_length rejected) 0)
    let appended: array<float> = (array_push rejected 3.5)
    assert (== (at appended 0) 3.5)
    let empty: array<float> = []
    let from_empty: array<float> = (filter empty positive_float)
    let filled: array<float> = (array_push from_empty 4.5)
    assert (== (at filled 0) 4.5)
    assert (== (array_length empty) 0)
    let words: array<string> = ["", "value"]
    let nonempty: array<string> = (filter words nonempty_text)
    assert (== (array_length nonempty) 1)
    assert (== (at nonempty 0) "value")
    let flags: array<bool> = (filter [false, true, false, true] keep_true)
    assert (== (array_length flags) 2)
    assert (at flags 0)
    assert (at flags 1)
    let kept_flags: array<bool> = (filter flags keep_true)
    assert (== (array_length kept_flags) 2)
    let no_flags: array<bool> = (filter [false] keep_true)
    let one_flag: array<bool> = (array_push no_flags true)
    assert (at one_flag 0)
    let literal_words: array<string> = (filter ["", "kept"] nonempty_text)
    assert (== (at literal_words 0) "kept")
    let no_words: array<string> = (filter [""] nonempty_text)
    let one_word: array<string> = (array_push no_words "added")
    assert (== (at one_word 0) "added")
    let literal_ints: array<int> = (filter [1, 2] is_even)
    assert (== (at literal_ints 0) 2)
    let empty_flags: array<bool> = (filter [] keep_true)
    let filled_flags: array<bool> = (array_push empty_flags true)
    assert (at filled_flags 0)
    let empty_words: array<string> = (filter [] nonempty_text)
    let filled_words: array<string> = (array_push empty_words "typed")
    assert (== (at filled_words 0) "typed")
    let empty_floats: array<float> = (filter [] positive_float)
    let filled_floats: array<float> = (array_push empty_floats 1.5)
    assert (== (at filled_floats 0) 1.5)
    (println "nl_functions_filter: All filter tests passed!")
    return 0
}

shadow main {
    assert (== (main) 0)
}
