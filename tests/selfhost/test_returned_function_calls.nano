fn add_one(value: int) -> int {
    return (+ value 1)
}

shadow add_one {
    assert (== (add_one 4) 5)
}

fn double(value: int) -> int {
    return (* value 2)
}

shadow double {
    assert (== (double 4) 8)
}

fn choose(add: bool) -> fn(int) -> int {
    if add {
        return add_one
    } else {
        return double
    }
}

shadow choose {
    assert (== ((choose true) 7) 8)
    assert (== ((choose false) 7) 14)
}

fn main() -> int {
    assert (== ((choose true) 7) 8)
    assert (== ((choose false) ((choose true) 4)) 10)
    return 0
}

shadow main {
    assert (== (main) 0)
}
