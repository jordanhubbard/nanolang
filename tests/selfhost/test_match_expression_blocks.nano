# I probe the C seed's arm-local expression-return convention; 5.0 semantics are pending.
union Choice {
    Some { value: int },
    None { }
}

fn match_local(choice: Choice) -> int {
    let result = (match choice {
        Some(item) => {
            let doubled: int = (* item.value 2)
            return doubled
        }
        None(empty) => { return 0 }
    })
    return (+ result 100)
}

shadow match_local {
    assert (== (match_local Choice.Some { value: 7 }) 114)
    assert (== (match_local Choice.None { }) 100)
}

fn match_effect(choice: Choice) -> int {
    let mut count: int = 0
    let result = (match choice {
        Some(item) => {
            set count (+ count 1)
            return item.value
        }
        None(empty) => {
            set count (+ count 2)
            return 0
        }
    })
    return (+ result (* count 100))
}

shadow match_effect {
    assert (== (match_effect Choice.Some { value: 7 }) 107)
    assert (== (match_effect Choice.None { }) 200)
}

fn match_branch(choice: Choice) -> int {
    let result = (match choice {
        Some(item) => {
            if (> item.value 0) { return 1 } else { return 2 }
        }
        None(empty) => { return 3 }
    })
    return (+ result 100)
}

shadow match_branch {
    assert (== (match_branch Choice.Some { value: 7 }) 101)
    assert (== (match_branch Choice.Some { value: -7 }) 102)
    assert (== (match_branch Choice.None { }) 103)
}

fn main() -> int {
    assert (== (match_local Choice.Some { value: 7 }) 114)
    assert (== (match_local Choice.None { }) 100)
    assert (== (match_effect Choice.Some { value: 7 }) 107)
    assert (== (match_effect Choice.None { }) 200)
    assert (== (match_branch Choice.Some { value: 7 }) 101)
    assert (== (match_branch Choice.Some { value: -7 }) 102)
    assert (== (match_branch Choice.None { }) 103)
    return 0
}

shadow main { assert (== (main) 0) }
