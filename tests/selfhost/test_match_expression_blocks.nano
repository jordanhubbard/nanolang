# I yield final expressions from match blocks; return always leaves my function.
union Choice {
    Some { value: int },
    None { }
}

fn match_local(choice: Choice) -> int {
    let result = (match choice {
        Some(item) => {
            let doubled: int = (* item.value 2)
            doubled
        }
        None(empty) => { 0 }
    })
    return (+ result 100)
}

shadow match_local {
    assert (== (match_local Choice.Some { value: 7 }) 114)
    assert (== (match_local Choice.None { }) 100)
}

fn match_effect(choice: Choice) -> int {
    let mut count: int = 0
    let result = (match choice {
        Some(item) => {
            set count (+ count 1)
            item.value
        }
        None(empty) => {
            set count (+ count 2)
            0
        }
    })
    return (+ result (* count 100))
}

shadow match_effect {
    assert (== (match_effect Choice.Some { value: 7 }) 107)
    assert (== (match_effect Choice.None { }) 200)
}

fn match_branch(choice: Choice) -> int {
    let result = (match choice {
        Some(item) => {
            if (> item.value 0) { return 1 }
            2
        }
        None(empty) => { 3 }
    })
    return (+ result 100)
}

shadow match_branch {
    assert (== (match_branch Choice.Some { value: 7 }) 1)
    assert (== (match_branch Choice.Some { value: -7 }) 102)
    assert (== (match_branch Choice.None { }) 103)
}

fn match_string(choice: Choice) -> int {
    let text = (match choice {
        Some(item) => { if (> item.value 0) { return 7 } "negative" }
        None(empty) => { "none" }
    })
    return (str_length text)
}

shadow match_string {
    assert (== (match_string Choice.Some { value: 7 }) 7)
    assert (== (match_string Choice.Some { value: -7 }) 8)
    assert (== (match_string Choice.None { }) 4)
}

fn match_return(choice: Choice) -> int {
    let value = (match choice {
        Some(item) => { return item.value }
        None(empty) => { 3 }
    })
    return (+ value 100)
}

shadow match_return {
    assert (== (match_return Choice.Some { value: 7 }) 7)
    assert (== (match_return Choice.None { }) 103)
}

fn main() -> int {
    assert (== (match_return Choice.Some { value: 7 }) 7)
    assert (== (match_return Choice.None { }) 103)
    assert (== (match_string Choice.Some { value: 7 }) 7)
    assert (== (match_string Choice.Some { value: -7 }) 8)
    assert (== (match_string Choice.None { }) 4)
    assert (== (match_local Choice.Some { value: 7 }) 114)
    assert (== (match_local Choice.None { }) 100)
    assert (== (match_effect Choice.Some { value: 7 }) 107)
    assert (== (match_effect Choice.None { }) 200)
    assert (== (match_branch Choice.Some { value: 7 }) 1)
    assert (== (match_branch Choice.Some { value: -7 }) 102)
    assert (== (match_branch Choice.None { }) 103)
    return 0
}

shadow main { assert (== (main) 0) }
