# I exercise my self-hosted ownership checker without claiming backend admission.
import "src_nano/typecheck.nano"
import "src_nano/parser.nano"
from "src_nano/compiler/lexer.nano" import tokenize_string
import "src_nano/compiler/diagnostics.nano" as Diagnostics
extern fn get_argc() -> int
extern fn get_argv(index:int) -> string
extern fn file_read(path:string) -> string

fn check_source(source:string) -> int {
    let diagnostics: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let tokens: List<LexerToken> = (tokenize_string source "ownership.nano" diagnostics)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "ownership.nano")
    if parser.has_error { (println "I could not parse the ownership fixture") return 2 }
    let checked: TypecheckPhaseOutput = (typecheck_phase parser "ownership.nano")
    let mut i: int = 0
    while (< i (Diagnostics.diag_list_count checked.diagnostics)) {
        let diagnostic: CompilerDiagnostic = (Diagnostics.diag_list_get checked.diagnostics i)
        (println diagnostic.message)
        set i (+ i 1)
    }
    if checked.had_error { return 1 }
    return 0
}
shadow check_source {
    assert (== (check_source "fn main()->int{return 7}") 0)
    assert (== (check_source "resource struct Handle{value:int} fn main()->int{let h:Handle=Handle{value:7} return 7}") 1)
}
fn main() -> int {
    unsafe {
        if (!= (get_argc) 2) { return 2 }
        return (check_source (file_read (get_argv 1)))
    }
}
shadow main { assert true }
