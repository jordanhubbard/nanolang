# I search byte sequences and report byte offsets, including overlapping matches.
fn check_search() -> int {
    assert (== (str_index_of "ababa" "aba") 0)
    assert (== (str_last_index_of "ababa" "aba") 2)
    assert (== (str_index_of "xxneedle" "needle") 2)
    assert (== (str_last_index_of "xxneedle" "needle") 2)
    assert (== (str_index_of "aaa" "aa") 0)
    assert (== (str_last_index_of "aaa" "aa") 1)
    assert (== (str_index_of "abc" "") 0)
    assert (== (str_last_index_of "abc" "") 3)
    assert (== (str_index_of "" "") 0)
    assert (== (str_last_index_of "" "") 0)
    assert (== (str_index_of "" "a") -1)
    assert (== (str_last_index_of "" "a") -1)
    assert (== (str_index_of "a" "ab") -1)
    assert (== (str_last_index_of "a" "ab") -1)
    assert (== (str_index_of "abc" "z") -1)
    assert (== (str_last_index_of "abc" "z") -1)
    assert (== (str_index_of "éxé" "x") 2)
    assert (== (str_last_index_of "éxé" "é") 3)
    return 0
}

shadow check_search { assert (== (check_search) 0) }

fn main() -> int {
    (check_search)
    (println "search-ok")
    return 0
}

shadow main { assert (== (main) 0) }
