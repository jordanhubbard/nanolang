module "src_nano/nvm2c/affine_graph.nano" as graph
module "src_nano/nvm2c/ownership_wire.nano" as read
module "tests/nvm2c_affine_fixture.nano" as fixture
extern fn get_argc() -> int
extern fn get_argv(index: int) -> string

fn describe(bytes: array<u8>) -> string {
    if (< (array_length bytes) 12) { return "D" }
    let cursor: read.Cursor = (read.open bytes)
    let entry: int = (read.read_u32 cursor)
    let present: int = (read.read_u32 cursor)
    let functions_present: int = (read.read_u32 cursor)
    if (or (> present 1) (> functions_present 1)) { return "D" }
    let image: fixture.Fixture = (fixture.parse (array_slice bytes 12 (- (array_length bytes) 12)))
    if (not image.valid) { return "D" }
    let context: graph.Context = graph.Context { present: (== present 1),
        functions_present: (== functions_present 1), entry: entry, model: image.model }
    if (graph.value_call_graph image.ownership context) { return "1" }
    return "0"
}
shadow describe { assert (== (describe []) "D") assert (== (describe [0,0,0,0]) "D") }

fn main() -> int {
    unsafe {
        let mut index: int = 1
        while (< index (get_argc)) {
            (println (describe (file_read_bytes (get_argv index))))
            set index (+ index 1)
        }
    }
    return 0
}
