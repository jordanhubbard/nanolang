# I parse the actual publisher bytes without executing their service shadows.
import "src_nano/parser.nano"
import "src_nano/compiler/lexer.nano"
import "src_nano/compiler/diagnostics.nano"
import "src_nano/generated/compiler_ast.nano"
from "src_nano/typecheck.nano" import typecheck_phase
from "src_nano/transpiler.nano" import transpile_parser, transpile_last_error, gen_match_variant_binding
from "src_nano/compiler/nanoisa_codegen.nano" import nisa_match_coverage

fn service_parse(source: string) -> Parser {
    let tokens: List<LexerToken> = (tokenize_string source "binding.nano" (diag_list_new))
    return (parse_program tokens (list_LexerToken_length tokens) "binding.nano")
}
shadow service_parse {
    let p: Parser = (service_parse "service \"nsi:nanolang/filesystem\" catalog 1 from \"interface.nsi.json\"")
    assert (not (parser_has_error p))
    assert (== p.services_count 1)
}
fn service_cases() -> void {
    let bad: array<string> = ["service", "pub service \"nsi:nanolang/filesystem\" catalog 1 from \"x\"", "service \"nsi:nanolang/filesystem\" catalog 01 from \"x\"", "service \"nsi:nanolang/filesystem\" catalog 1.0 from \"x\"", "service \"nsi:nanolang/filesystem\" catalog 2 from \"x\"", "service \"nsi:nanolang/filesystem\" catalog 1 from \"\"", "service \"nsi:nanolang/filesystem\" catalog 1 from \"/x\"", "service \"nsi:nanolang/filesystem\" catalog 1 from \"a\\0suffix\"", "service \"nsi:nanolang/filesystem\" catalog 1 from \"x\" extra", "service \"nsi:nanolang/filesystem\"\ncatalog 1 from \"x\""]
    for i in (range 0 (array_length bad)) {
        let p: Parser = (service_parse (at bad i))
        assert (parser_has_error p)
    }
    let declaration: string = "service \"nsi:nanolang/filesystem\" catalog 1 from \"interface.nsi.json\""
    let diagnostics: List<CompilerDiagnostic> = (diag_list_new)
    let tokens: List<LexerToken> = (tokenize_string declaration "counts.nano" diagnostics)
    let original: LexerToken = (list_LexerToken_get tokens 5)
    let invalid: array<int> = [-1,0,17,19,1048577]
    for i in (range 0 (array_length invalid)) {
        let changed: LexerToken = LexerToken { token_type: original.token_type, value: original.value, line: original.line, column: original.column, value_bytes: (at invalid i) }
        (list_LexerToken_set tokens 5 changed)
        let p: Parser = (parse_program tokens (list_LexerToken_length tokens) "counts.nano")
        assert (parser_has_error p)
    }
    let raws: array<string> = [(+ (string_from_char 192) (string_from_char 128)), (+ (string_from_char 237) (+ (string_from_char 160) (string_from_char 128))), (+ (string_from_char 244) (+ (string_from_char 144) (+ (string_from_char 128) (string_from_char 128)))), (+ (string_from_char 226) (string_from_char 130)), (string_from_char 128)]
    for i in (range 0 (array_length raws)) {
        let raw: string = (at raws i)
        let size: int = (str_length raw)
        let changed: LexerToken = LexerToken { token_type: original.token_type, value: raw, line: original.line, column: original.column, value_bytes: size }
        (list_LexerToken_set tokens 5 changed)
        let p: Parser = (parse_program tokens (list_LexerToken_length tokens) "utf8.nano")
        assert (parser_has_error p)
    }
    let good: LexerToken = LexerToken { token_type: original.token_type, value: "é", line: original.line, column: original.column, value_bytes: 2 }
    (list_LexerToken_set tokens 5 good)
    let accepted: Parser = (parse_program tokens (list_LexerToken_length tokens) "utf8.nano")
    assert (not (parser_has_error accepted))
}
shadow service_cases { (service_cases) }
fn ordinary_bindings() -> void {
    let prefix: string = "union Choice { None {}, Some { value: int } } fn main() -> int { match Choice.None {} { "
    let arms: array<string> = ["None() => { return 7 } Some(v) => { return v.value }", "None(n) => { return 7 } Some(_) => { return 8 }", "None() => { return 7 } Some() => { return 8 }", "Missing() => { return 7 } Some(v) => { return v.value }"]
    for i in (range 0 (array_length arms)) {
        let p: Parser = (service_parse (+ prefix (+ (at arms i) " } }")))
        assert (not (parser_has_error p))
        assert (== p.services_count 0)
        let matched: ASTMatch = (parser_get_match p 0)
        if (== i 1) {
            assert (== (at matched.arm_bindings 0) "n")
            assert (== (at matched.arm_bindings 1) "_")
        } else {
            assert (== (at matched.arm_bindings 0) "")
            if (== i 2) { assert (== (at matched.arm_bindings 1) "") }
            else { assert (== (at matched.arm_bindings 1) "v") }
        }
        assert (== (typecheck_phase p "ordinary-zero.nano").had_error (>= i 2))
        assert (== (nisa_match_coverage p matched (parser_get_union p 0)) (< i 2))
        if (< i 2) {
            let emitted: string = (transpile_parser p)
            assert (!= emitted "")
            assert (== (transpile_last_error) "")
            assert (== (gen_match_variant_binding p "Choice" "None" "" "") "")
            assert (== (transpile_last_error) "")
            assert (== (gen_match_variant_binding p "Choice" "Some" "" "") "")
            assert (str_contains (transpile_last_error) "zero-field")
            let recovered: string = (transpile_parser p)
            assert (!= recovered "")
            assert (== (transpile_last_error) "")
            assert (== (gen_match_variant_binding p "Choice" "Missing" "" "") "")
            assert (str_contains (transpile_last_error) "zero-field")
            let final: string = (transpile_parser p)
            assert (!= final "")
            assert (== (transpile_last_error) "")
        }
    }
    let malformed: Parser = (service_parse (+ prefix "None() => { return 7 } Some(,) => { return 8 } } }"))
    assert (parser_has_error malformed)
}
shadow ordinary_bindings { (ordinary_bindings) }
fn publisher_parse() -> void {
    let p: Parser = (service_parse @PUBLISHER_SOURCE@)
    assert (not (parser_has_error p))
    assert (== p.services_count 1)
    assert (== p.shadows_count 5)
    let declaration: ASTServiceDecl = (parser_get_service p 0)
    assert (== declaration.interface_id "nsi:nanolang/filesystem")
    assert (== declaration.document_path "interface.nsi.json")
    assert (== declaration.interface_bytes 23)
    assert (== declaration.path_bytes 18)
    assert (== declaration.origin_index -1)
}
shadow publisher_parse { (publisher_parse) }
fn main() -> int {
    (service_cases)
    (ordinary_bindings)
    (publisher_parse)
    (println "publisher:1:5:retained")
    return 0
}
