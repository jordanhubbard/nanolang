effect Text { text : string int -> string }
fn send(s: string, n: int) -> string { return perform Text.text(s n) }
fn exercise() -> string {
 let mut saved: string = "initial"
 let result = handle { (send "a" 12) } with { text s n -> {
   let own: string = (+ s "x")
   set saved own
   if (> n 0) { let child = (send own (- n 1)) assert (> (str_length child) 0) }
   own
 } }
 assert (== (str_length saved) 14)
 return result
}
fn leave() -> string {
 let mut saved: string = "initial"
 let result = handle { (send "a" 12) } with { text s n -> {
   let own: string = (+ s "x")
   set saved own
   if (> n 0) { let child = (send own (- n 1)) }
   return saved
 } }
 return result
}
fn main() -> int {
 let mut total: int = 0
 for i in (range 0 20) {
   let resumed = (exercise)
   let escaped = (leave)
   assert (== resumed "ax")
   assert (== (str_length escaped) 14)
   set total (+ total (str_length escaped))
 }
 return total
}

shadow send { assert (== (exercise) "ax") }
shadow exercise { assert (== (exercise) "ax") }
shadow leave { assert (== (str_length (leave)) 14) }
