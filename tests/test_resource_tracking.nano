/* Test resource tracking infrastructure */

resource struct FileHandle {
    fd: int
}

fn create_file() -> FileHandle {
    return FileHandle { fd: 42 }
}

fn close_file(f: FileHandle) -> void {
    # I dismantle a simulated handle, not an operating-system file.
    let FileHandle { fd } = f
    assert (== fd 42)
    (println "File closed")
}

shadow create_file { let f: FileHandle = (create_file) assert (== f.fd 42) (close_file f) }
shadow close_file { (close_file FileHandle { fd: 42 }) }

fn main() -> int {
    (println "Testing resource tracking infrastructure")

    /* Create a resource */
    let f: FileHandle = (create_file)

    /* Use the resource */
    (close_file f)

    (println "Resource tracking test passed!")
    return 0
}

shadow main {
    assert (== (main) 0)
}
