# Test row-polymorphic record types
# Open-record functions run via interpreter (shadow blocks)

struct Person {
    name: string,
    age: int
}

struct Employee {
    name: string,
    age: int,
    company: string
}

struct Reordered {
    age: int,
    name: string
}

let mut spread_calls: int = 0

fn spread_source() -> Reordered {
    set spread_calls (+ spread_calls 1)
    return Reordered { age: 40, name: "Carol" }
}

shadow spread_source {
    set spread_calls 0
    let record: Reordered = (spread_source)
    assert (== record.age 40)
    assert (== spread_calls 1)
}

fn spread_once() -> int {
    set spread_calls 0
    let updated: Person = {..(spread_source), age: 41}
    assert (== updated.name "Carol")
    assert (== updated.age 41)
    assert (== spread_calls 1)
    let __nano_spread_0: string = "Override"
    let replaced: Person = {..(spread_source), name: __nano_spread_0, age: 7}
    assert (== replaced.name "Override")
    assert (== replaced.age 7)
    assert (== spread_calls 2)
    return 0
}

shadow spread_once {
    assert (== (spread_once) 0)
}

# Open-record function: accepts any struct with a 'name: string' field
fn get_name(rec: {name: string | r}) -> string {
    return rec.name
}

# Open-record function: accepts any struct with 'name: string' and 'age: int' fields
fn get_age(rec: {name: string, age: int | r}) -> int {
    return rec.age
}

fn spread_basic() -> int {
    let base = Person { name: "Carol", age: 40 }
    let updated: Person = {..base, age: 41}
    assert (== updated.name "Carol")
    assert (== updated.age 41)
    assert (== base.age 40)
    return 0
}

fn spread_extend() -> int {
    let e = Employee { name: "Dave", age: 28, company: "BigCo" }
    let promoted: Employee = {..e, company: "NewCo"}
    assert (== promoted.name "Dave")
    assert (== promoted.age 28)
    assert (== promoted.company "NewCo")
    assert (== e.company "BigCo")
    return 0
}

shadow get_name {
    let p = Person { name: "Alice", age: 30 }
    assert (== (get_name p) "Alice")
    let e = Employee { name: "Bob", age: 25, company: "Acme" }
    assert (== (get_name e) "Bob")
}

shadow get_age {
    let e = Employee { name: "Bob", age: 25, company: "Acme" }
    assert (== (get_age e) 25)
}

shadow spread_basic {
    assert (== (spread_basic) 0)
}

shadow spread_extend {
    assert (== (spread_extend) 0)
}

shadow main {
    assert (== (main) 0)
}

fn main() -> int {
    assert (== (spread_once) 0)
    assert (== (spread_basic) 0)
    assert (== (spread_extend) 0)
    (println "I preserved record spread fields.")
    return 0
}
