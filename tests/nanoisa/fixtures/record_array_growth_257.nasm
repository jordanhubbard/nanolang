.entry main
.types 1 0 0
.function main 0 2 0 int 1
ARR_NEW 8
STORE_LOCAL 0
PUSH_I64 0
STORE_LOCAL 1
loop:
LOAD_LOCAL 0
LOAD_LOCAL 1
AGG_PACK 0 0 0 1
ARR_PUSH
POP
LOAD_LOCAL 1
PUSH_I64 1
I64_ADD
STORE_LOCAL 1
LOAD_LOCAL 1
PUSH_I64 257
I64_LT_S
JMP_FALSE done
JMP loop
done:
LOAD_LOCAL 0
ARR_LEN
PUSH_I64 257
EQ
ASSERT
PUSH_I64 0
RET
.end
