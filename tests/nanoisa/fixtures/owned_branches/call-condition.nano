resource struct Box{value:int,flag:bool}
fn test(token:Box)->bool {let Box{value,flag}=token return flag}
shadow test {let tok:Box=Box{value:0,flag:true} assert (test tok)}
fn pick(owner:Box,token:Box)->int {if (test token) {let Box{value,flag}=owner return value} else {let Box{value,flag}=owner return (+ value 1)}}
shadow pick {assert (== (main) 15)}
fn main()->int {return (+ (pick Box{value:7,flag:true} Box{value:0,flag:true}) (pick Box{value:7,flag:false} Box{value:0,flag:false}))}
shadow main {assert (== (main) 15)}
