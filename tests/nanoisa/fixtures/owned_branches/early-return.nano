resource struct Box {value:int, flag:bool}
fn pick(owner:Box, yes:bool)->int {if yes {let Box{value,flag}=owner return value} let Box{value,flag}=owner return (+ value 1)}
shadow pick {assert (== (main) 15)}
fn main()->int {return (+ (pick Box{value:7,flag:true} true) (pick Box{value:7,flag:false} false))}
shadow main {assert (== (main) 15)}
