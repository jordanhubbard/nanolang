struct Loc {
    file: string,
    line: int
}

struct Nest {
    inner: Loc,
    tag: int
}

fn nest_d() -> Nest {
    return Nest { inner: Loc { file: "f", line: 7 }, tag: 1 }
}

shadow nest_d {
    let n: Nest = (nest_d)
    assert (== n.tag 1)
}

fn via_nest() -> int {
    let n: Nest = (nest_d)
    let loc: Loc = n.inner
    return loc.line
}

shadow via_nest {
    assert (== (via_nest) 7)
}

fn nest_line() -> int {
    let n: Nest = (nest_d)
    return n.inner.line
}

shadow nest_line {
    assert (== (nest_line) 7)
}

fn via_nest_line() -> int {
    return (nest_line)
}

shadow via_nest_line {
    assert (== (via_nest_line) 7)
}

