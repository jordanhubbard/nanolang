    y: int
}

fn getx() -> int {
    let p: Point = Point { x: 3, y: 4 }
    return p.x
}

shadow getx {
    assert (== (getx) 3)
}

fn is_pos(c: int) -> bool {
    return (> c 0)
}

shadow is_pos {
    assert (is_pos 3)
    assert (not (is_pos 0))
}

fn yes() -> bool {
    return true
}

shadow yes {
    assert (yes)
}

fn no() -> bool {
    return false
}

shadow no {
    assert (not (no))
}

fn invert(b: bool) -> bool {
    return (not b)
}

shadow invert {
    assert (not (invert true))
    assert (invert false)
}

fn both(a: bool, b: bool) -> bool {
    return (and a b)
}

shadow both {
    assert (both true true)
    assert (not (both true false))
}

fn either(a: bool, b: bool) -> bool {
    return (or a b)
}

shadow either {
    assert (either false true)
    assert (not (either false false))
}

fn pick(c: int) -> int {
    return (cond
        ((> c 0) 1)
        (else 0)
    )
}

shadow pick {
    assert (== (pick 3) 1)
    assert (== (pick 0) 0)
}

fn say() -> int {
    (print 7)
    return 0
}

shadow say {
    assert (== (say) 0)
}

fn shout() -> int {
    (println 7)
    return 0
}

shadow shout {
    assert (== (shout) 0)
}

fn mutter() -> int {
    (print "")
    return 0
}

shadow mutter {
    assert (== (mutter) 0)
}

fn prove(b: bool) -> int {
    assert b
    return 0
}

shadow prove {
    assert (== (prove true) 0)
}

fn grow() -> int {
    let mut xs: array<int> = [1]
    set xs (array_push xs 2)
    return (array_length xs)
}

