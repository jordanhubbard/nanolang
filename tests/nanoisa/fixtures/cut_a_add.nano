fn one_lex() -> List<LexerToken> {
    let xs: List<LexerToken> = (list_LexerToken_new)
    (list_LexerToken_push xs LexerToken { token_type: 1, value: "hi", line: 2, column: 3 })
    return xs
}

shadow one_lex {
    let xs: List<LexerToken> = (one_lex)
    let t: LexerToken = (list_LexerToken_get xs 0)
    assert (== (str_length t.value) 2)
}

fn via_one_lex() -> int {
    let xs: List<LexerToken> = (one_lex)
    let t: LexerToken = (list_LexerToken_get xs 0)
    return (str_length t.value)
}

shadow via_one_lex {
    assert (== (via_one_lex) 2)
}

fn in_az(c: int) -> bool {
    return (and (>= c 65) (<= c 90))
}

shadow in_az {
    assert (in_az 65)
    assert (in_az 90)
    assert (not (in_az 64))
    assert (not (in_az 91))
}

fn via_az() -> int {
    if (in_az 65) {
        return 1
    } else {
        return 0
    }
}

shadow via_az {
    assert (== (via_az) 1)
}

