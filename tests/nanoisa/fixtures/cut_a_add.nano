fn add(a: int, b: int) -> int {
    return (+ a b)
}

shadow add {
    assert (== (add 2 3) 5)
}

fn main() -> int {
    return (add 40 2)
}

shadow main {
    assert (== (main) 42)
}

fn choose(c: int) -> int {
    if (> c 0) {
        return 1
    } else {
        return 0
    }
}

shadow choose {
    assert (== (choose 3) 1)
    assert (== (choose 0) 0)
}

fn loop_sum(n: int) -> int {
    let mut i: int = 0
    let mut s: int = 0
    while (< i n) {
        set s (+ s i)
        set i (+ i 1)
    }
    return s
}

shadow loop_sum {
    assert (== (loop_sum 4) 6)
}

fn greeting() -> string {
    return "hi"
}

shadow greeting {
    assert (== (greeting) "hi")
}

fn glue(a: string, b: string) -> string {
    return (+ a b)
}

shadow glue {
    assert (== (glue "a" "b") "ab")
}

fn len3() -> int {
    let xs: array<int> = [1, 2, 3]
    return (array_length xs)
}

shadow len3 {
    assert (== (len3) 3)
}

fn first() -> int {
    let xs: array<int> = [7, 8, 9]
    return (array_get xs 0)
}

shadow first {
    assert (== (first) 7)
}

struct Point {
    x: int,
    y: int
}

fn getx() -> int {
    let p: Point = Point { x: 3, y: 4 }
    return p.x
}

shadow getx {
    assert (== (getx) 3)
}

fn is_pos(c: int) -> bool {
    return (> c 0)
}

shadow is_pos {
    assert (is_pos 3)
    assert (not (is_pos 0))
}

fn yes() -> bool {
    return true
}

shadow yes {
    assert (yes)
}

fn no() -> bool {
    return false
}

shadow no {
    assert (not (no))
}

fn invert(b: bool) -> bool {
    return (not b)
}

shadow invert {
    assert (not (invert true))
    assert (invert false)
}

fn both(a: bool, b: bool) -> bool {
    return (and a b)
}

shadow both {
    assert (both true true)
    assert (not (both true false))
}

fn either(a: bool, b: bool) -> bool {
    return (or a b)
}

shadow either {
    assert (either false true)
    assert (not (either false false))
}

fn pick(c: int) -> int {
    return (cond
        ((> c 0) 1)
        (else 0)
    )
}

shadow pick {
    assert (== (pick 3) 1)
    assert (== (pick 0) 0)
}
