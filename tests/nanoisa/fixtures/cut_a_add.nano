}

fn put_l() -> int {
    let xs: List<int> = (list_int_new)
    (list_int_push xs 7)
    (list_int_set xs 0 9)
    return (list_int_get xs 0)
}

shadow put_l {
    assert (== (put_l) 9)
}

fn put_t() -> string {
    let xs: List<Tok> = (list_Tok_new)
    (list_Tok_push xs Tok { t: 1, s: "hi" })
    (list_Tok_set xs 0 Tok { t: 2, s: "no" })
    let p: Tok = (list_Tok_get xs 0)
    return p.s
}

shadow put_t {
    assert (== (put_t) "no")
}

fn put_s() -> string {
    let xs: List<string> = (list_string_new)
    (list_string_push xs "hi")
    (list_string_set xs 0 "no")
    return (list_string_get xs 0)
}

shadow put_s {
    assert (== (put_s) "no")
}

fn upto() -> int {
    let mut s: int = 0
    for x in [1, 2, 3] {
        set s (+ s x)
    }
    return s
}

shadow upto {
    assert (== (upto) 6)
}

