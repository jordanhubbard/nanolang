# I exercise retained bytecode callbacks with shared captures and nested waits.
module "modules/dispatch/dispatch.nano" as dispatch

fn run_callbacks() -> int {
    let mut state: array<int> = [0]
    let q: dispatch.NlQueue = (dispatch.queue_concurrent "nano.vm.callbacks")
    let inner: dispatch.NlQueue = (dispatch.queue_serial "nano.vm.inner")
    (dispatch.queue_sync q fn() -> void {
        (dispatch.queue_sync inner fn() -> void {
            (array_set state 0 (+ (at state 0) 1))
        })
    })
    assert (== (at state 0) 1)
    (dispatch.queue_destroy inner)
    let group: dispatch.NlQueueGroup = (dispatch.group_create)
    for i in (range 0 16) {
        (dispatch.group_async group q fn() -> void {
            (array_set state 0 (+ (at state 0) 1))
        })
    }
    assert (== (dispatch.group_wait_ms group 5000) 0)
    assert (== (at state 0) 17)
    (dispatch.group_notify group q fn() -> void {
        (array_set state 0 (+ (at state 0) 100))
    })
    (dispatch.queue_async q fn() -> void {
        (array_set state 0 (+ (at state 0) 10))
    })
    (dispatch.queue_barrier_async q fn() -> void {
        (array_set state 0 (+ (at state 0) 1000))
    })
    (dispatch.queue_after_ms q 10 fn() -> void {
        (array_set state 0 (+ (at state 0) 10000))
    })
    (dispatch.group_destroy group)
    (dispatch.queue_destroy q)
    return (at state 0)
}

shadow run_callbacks {
    assert (== (run_callbacks) 11127)
}

fn main() -> int {
    assert (== (run_callbacks) 11127)
    return 0
}

shadow main {
    assert (== (main) 0)
}
