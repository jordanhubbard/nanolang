# I run against SDL's dummy audio driver in the integration test.
module "modules/sdl/sdl.nano"
module "modules/sdl_mixer/sdl_mixer.nano"

fn run_post_mix() -> int {
    let mut observed: array<int> = [0]
    unsafe {
        assert (== (SDL_Init 16) 0)
        assert (>= (Mix_Init 0) 0)
        assert (== (Mix_OpenAudio 22050 32784 1 128) 0)
        assert (== (nl_mix_set_post_mix fn(userdata: Mix_UserData, buffer: Mix_AudioBuffer, length: int) -> void {
            assert (== userdata 0)
            assert (not (== buffer 0))
            assert (> length 0)
            (array_set observed 0 (+ (at observed 0) 1))
        } (null_opaque)) 0)
    }
    while (< (at observed 0) 8) {}
    unsafe {
        # I change playback while the audio thread continues invoking my closure.
        assert (== (Mix_AllocateChannels 16) 16)
        assert (== (Mix_GetNumChannels) 16)
        assert (== (Mix_PlayChannel -1 0 0) -1)
        assert (> (str_length (Mix_GetError)) 0)
        assert (== (Mix_ClearError) 0)
        assert (== (str_length (Mix_GetError)) 0)
        assert (== (Mix_AllocateChannels 9223372036854775807) -1)
        assert (> (str_length (Mix_GetError)) 0)
        let missing: Mix_Chunk = (Mix_LoadWAV "examples/audio/nanolang-test-tone.wav/missing")
        assert (== missing 0)
        assert (> (str_length (Mix_GetError)) 0)
        let chunk: Mix_Chunk = (Mix_LoadWAV "examples/audio/nanolang-test-tone.wav")
        assert (not (== chunk 0))
        assert (>= (Mix_VolumeChunk chunk 64) 0)
        assert (>= (Mix_Volume 0 64) 0)
        assert (== (Mix_PlayChannel 0 chunk -1) 0)
        assert (> (Mix_Playing 0) 0)
        assert (== (Mix_Paused 0) 0)
        assert (== (Mix_HaltChannel 0) 0)
        assert (== (Mix_PlayChannelTimed 0 chunk -1 10000) 0)
        assert (== (Mix_FadeOutChannel 0 10) 1)
        assert (== (Mix_HaltChannel 0) 0)
        assert (== (Mix_FadeInChannel 0 chunk -1 10) 0)
        assert (== (Mix_FreeChunk chunk) 0)
        assert (== (Mix_Playing 0) 0)
        let missing_music: Mix_Music = (Mix_LoadMUS "examples/audio/nanolang-test-tone.wav/missing")
        assert (== missing_music 0)
        assert (> (str_length (Mix_GetError)) 0)
        let music: Mix_Music = (Mix_LoadMUS "examples/audio/nanolang-test-tone.wav")
        assert (not (== music 0))
        assert (== (Mix_PlayMusic music -1) 0)
        assert (> (Mix_PlayingMusic) 0)
        (Mix_PauseMusic)
        assert (> (Mix_PausedMusic) 0)
        (Mix_ResumeMusic)
        assert (== (Mix_PausedMusic) 0)
        assert (>= (Mix_VolumeMusic 64) 0)
        assert (== (Mix_RewindMusic) 0)
        assert (== (Mix_HaltMusic) 0)
        assert (== (Mix_FadeInMusic music -1 10) 0)
        assert (== (Mix_HaltMusic) 0)
        assert (== (Mix_FadeInMusicPos music -1 10 0.0) 0)
        assert (== (Mix_FadeOutMusic 10) 1)
        (Mix_FreeMusic music)
        assert (== (Mix_PlayingMusic) 0)
    }
    while (< (at observed 0) 16) {}
    unsafe {
        (nl_mix_clear_post_mix)
        (Mix_CloseAudio)
        (Mix_Quit)
        (SDL_Quit)
    }
    return (at observed 0)
}

shadow run_post_mix {
    assert (>= (run_post_mix) 8)
}

fn main() -> int {
    assert (>= (run_post_mix) 8)
    return 0
}

shadow main {
    assert (== (main) 0)
}
