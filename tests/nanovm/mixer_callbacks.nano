# I run against SDL's dummy audio driver in the integration test.
module "modules/sdl/sdl.nano"
module "modules/sdl_mixer/sdl_mixer.nano"

fn run_post_mix() -> int {
    let mut observed: array<int> = [0]
    unsafe {
        assert (== (SDL_Init 16) 0)
        assert (== (Mix_OpenAudio 22050 32784 1 128) 0)
        assert (== (nl_mix_set_post_mix fn(userdata: Mix_UserData, buffer: Mix_AudioBuffer, length: int) -> void {
            assert (== userdata 0)
            assert (not (== buffer 0))
            assert (> length 0)
            (array_set observed 0 (+ (at observed 0) 1))
        } (null_opaque)) 0)
    }
    while (< (at observed 0) 8) {}
    unsafe {
        (nl_mix_clear_post_mix)
        (Mix_CloseAudio)
        (SDL_Quit)
    }
    return (at observed 0)
}

shadow run_post_mix {
    assert (>= (run_post_mix) 8)
}

fn main() -> int {
    assert (>= (run_post_mix) 8)
    return 0
}

shadow main {
    assert (== (main) 0)
}
