/* Test fs_walkdir function */

module "modules/std/fs.nano" as fs

fn main() -> int {
    let directory: string = (mktemp_dir "nano_walk_fixture_")
    assert (!= directory "")
    let nested: string = (fs.join directory "nested")
    let first: string = (fs.join directory "first.txt")
    let second: string = (fs.join nested "second.txt")
    assert (== (fs.mkdir_p nested) 0)
    assert (== (fs.write first "one") 0)
    assert (== (fs.write second "two") 0)
    let files: array<string> = (fs.walkdir directory)
    assert (== (array_length files) 2)
    let mut saw_first: bool = false
    let mut saw_second: bool = false
    for i in (range 0 (array_length files)) {
        let path: string = (at files i)
        if (== path first) {
            assert (== (fs.basename path) "first.txt")
            set saw_first true
        }
        if (== path second) {
            assert (== (fs.basename path) "second.txt")
            set saw_second true
        }
    }
    assert saw_first
    assert saw_second
    assert (== (array_length (fs.walkdir (fs.join directory "missing"))) 0)
    assert (== (fs.delete first) 0)
    assert (== (fs.delete second) 0)
    assert (== (fs.delete nested) 0)
    assert (== (fs.delete directory) 0)
    (println "I found both fixture files.")
    return 0
}

shadow main {
    assert (== (main) 0)
}
