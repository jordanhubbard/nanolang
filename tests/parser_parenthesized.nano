# I execute these assertions even when imported shadows are not run.
import "src_nano/parser.nano"
import "src_nano/compiler/lexer.nano"

fn main() -> int {
    let sources: array<string> = ["(sum + i)", "(a + b * c)", "(p.1, p.0)", "(p.x, p.y)", "(x, y)", "(f x)", "(f)", "(Mod.f x)"]
    let kinds: array<int> = [ParseNodeType.PNODE_BINARY_OP, ParseNodeType.PNODE_BINARY_OP, ParseNodeType.PNODE_TUPLE_LITERAL, ParseNodeType.PNODE_TUPLE_LITERAL, ParseNodeType.PNODE_TUPLE_LITERAL, ParseNodeType.PNODE_CALL, ParseNodeType.PNODE_CALL, ParseNodeType.PNODE_MODULE_QUALIFIED_CALL]
    let mut i: int = 0
    while (< i (array_length sources)) {
        let tokens: List<LexerToken> = (tokenize_string (at sources i) "parser-test.nano" (list_CompilerDiagnostic_new))
        let parsed: Parser = (parse_primary (parser_new tokens (list_LexerToken_length tokens) "parser-test.nano"))
        assert (not (parser_has_error parsed))
        assert (== parsed.last_expr_node_type (at kinds i))
        assert (parser_is_at_end parsed)
        if (== i 1) {
            let root: ASTBinaryOp = (list_ASTBinaryOp_get parsed.binary_ops parsed.last_expr_node_id)
            assert (== root.op (token_star))
            assert (== root.left_type ParseNodeType.PNODE_BINARY_OP)
            let left: ASTBinaryOp = (list_ASTBinaryOp_get parsed.binary_ops root.left)
            assert (== left.op (token_plus))
        }
        set i (+ i 1)
    }
    let starts: array<string> = ["f x)", "f)", "Mod.f x)", "x + y)", "p.1, p.0)", "p.x, p.y)", "42)"]
    let expected: array<bool> = [true, true, true, false, false, false, false]
    set i 0
    while (< i (array_length starts)) {
        let tokens: List<LexerToken> = (tokenize_string (at starts i) "parser-test.nano" (list_CompilerDiagnostic_new))
        assert (== (parenthesized_call_start (parser_new tokens (list_LexerToken_length tokens) "parser-test.nano")) (at expected i))
        set i (+ i 1)
    }
    let malformed: List<LexerToken> = (tokenize_string "(x +)" "parser-test.nano" (list_CompilerDiagnostic_new))
    let rejected: Parser = (parse_primary (parser_new malformed (list_LexerToken_length malformed) "parser-test.nano"))
    assert (parser_has_error rejected)
    (println "I passed the compiled parenthesized-parser assertions.")
    return 0
}

shadow main { assert (== (main) 0) }
