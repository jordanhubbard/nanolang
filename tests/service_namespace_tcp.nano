# I preserve distinct File/TCP nominal identities through aliases and re-exports.
import "src_nano/compiler/service_namespace.nano"
import "src_nano/compiler/service_types.nano"
import "src_nano/compiler/service_bodies.nano"
import "src_nano/compiler/service_ownership.nano"
import "src_nano/parser.nano"
from "src_nano/compiler/lexer.nano" import tokenize_string
import "src_nano/compiler/service_origins.nano"
import "src_nano/compiler/service_inputs.nano"
import "modules/file_source_inputs/file_source_inputs.nano"
extern fn get_argc() -> int
extern fn get_argv(index: int) -> string

fn check_mixed(one: string, two: string, bridge: string, root: string) -> int {
    let source: string = "service \"nsi:nanolang/filesystem\" catalog 1 from \"interface.nsi.json\"\nservice \"nsi:nanolang/net\" catalog 1 from \"interface.nsi.json\"\npub use \"two/binding.nano\" as net\nmodule \"one/binding.nano\" as files\nmodule \"bridge.nano\" as bridge\nfrom \"two/binding.nano\" import Conn as Handle, Endpoint as Address\nfn retain(value: Handle) -> bridge.net.Conn { return value }\n"
    let tokens: List<LexerToken> = (tokenize_string source root (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) root)
    assert (not parser.has_error)
    let files: array<string> = [one, two, bridge, root]
    let sources: array<string> = [one, two, bridge, root, root, root, root]
    let origins: ServiceOrigins = (bind_service_origins parser files sources [1, 1, 1, 1, 2, 3, 4])
    assert origins.ok
    unsafe {
        let context: NlFileSourceSnapshots = (nl_source_inputs_new)
        let inputs: ServiceInputs = (acquire_service_inputs parser files origins context)
        assert inputs.ok
        let space: ServiceNamespace = (resolve_service_namespace parser files sources [1, 0, 2, 1] origins inputs context)
        assert (== space.status 0)
        assert (== (array_length space.plan.rows) 29)
        assert (== (service_namespace_catalog space 0) 1)
        assert (== (service_namespace_catalog space 1) 2)
        let conn: ServiceType = (service_named_type space 3 "Handle")
        let endpoint: ServiceType = (service_named_type space 3 "Address")
        assert (== conn.category 1)
        assert (== endpoint.kind 5)
        assert (== endpoint.ordinal 8)
        assert (service_types_equal conn (service_named_type space 3 "bridge.net.Conn"))
        assert (not (service_types_equal conn (service_named_type space 3 "files.File")))
        assert (not (service_types_equal (service_named_type space 3 "files.ReadByte") (service_named_type space 3 "bridge.net.ReadByte")))
        assert (== (service_named_type space 3 "bridge.net.Socket").kind 0)
        assert (== (service_member_type space endpoint "family").kind 1)
        assert (== (service_member_type space endpoint "scope_id").kind 1)
        assert (== (service_member_type space endpoint "absent").kind 0)
        let error: ServiceType = (service_named_type space 1 "SocketError")
        assert (== (service_member_type space error "connect_pending").kind 2)
        assert (== (service_member_type space error "host_errno").kind 1)
        let result: ServiceType = (service_named_type space 1 "ConnectResult")
        assert (service_types_equal (service_member_type space result "Ok") conn)
        assert (service_types_equal (service_member_type space result "Error") error)
        let methods: array<string> = ["begin_connect", "send_byte", "finish_connect", "receive_byte", "close"]
        let counts: array<int> = [1, 2, 1, 1, 1]
        let mut i: int = 0
        while (< i 5) {
            let method: ServiceMethodType = (service_method_type space 3 (+ "bridge.net." (at methods i)))
            assert method.ok
            assert (== (array_length method.parameters) (at counts i))
            assert (== method.result.ordinal (+ i 3))
            assert (== method.result.owner 1)
            let mut expected: ServiceType = conn
            if (== i 0) { set expected endpoint }
            assert (service_types_equal (at method.parameters 0) expected)
            set i (+ i 1)
        }
        let annotations: ServiceAnnotationFacts = (bind_service_annotations parser files sources space)
        assert annotations.ok
        assert (== (array_length annotations.annotations) 2)
        let mut annotation: int = 0
        while (< annotation (array_length annotations.annotations)) {
            let leaves: array<ServiceTypeLeaf> = (at annotations.annotations annotation).leaves
            assert (== (array_length leaves) 1)
            assert (== (at leaves 0).type.owner 1)
            set annotation (+ annotation 1)
        }
        let body: ServiceBodyCheck = (check_service_bodies parser files sources space)
        assert (== body.status 0)
        let owners: ServiceOwnershipCheck = (check_service_ownership parser files sources space body)
        assert (== owners.status 0)
        (nl_source_inputs_free context)
    }
    (println "PASS mixed File TCP namespace identities")
    return 0
}
shadow check_mixed {
    let space: ServiceNamespace = ServiceNamespace { status: 0, names: [], plan: FileSourcePlan { status: 0, rows: [], logical_bytes: 0 }, text_bytes: 0, ordinary_count: 0, alias_count: 0 }
    assert (== (service_named_type space 0 "Conn").kind 0)
}
fn main() -> int {
    unsafe {
        if (!= (get_argc) 5) { return 2 }
        return (check_mixed (get_argv 1) (get_argv 2) (get_argv 3) (get_argv 4))
    }
}
shadow main { assert true }
