# I check small arithmetic in shadows and million-step tail recursion at runtime.

fn factorial_tail(n: int, acc: int) -> int {
    if (== n 0) { return acc }
    return (factorial_tail (- n 1) (* acc n))
}

shadow factorial_tail {
    assert (== (factorial_tail 0 7) 7)
    assert (== (factorial_tail 5 1) 120)
}

fn factorial(n: int) -> int {
    return (factorial_tail n 1)
}

shadow factorial {
    assert (== (factorial 0) 1)
    assert (== (factorial 10) 3628800)
}

fn fibonacci_tail(n: int, a: int, b: int) -> int {
    if (== n 0) { return a }
    return (fibonacci_tail (- n 1) b (+ a b))
}

shadow fibonacci_tail {
    assert (== (fibonacci_tail 0 3 5) 3)
    assert (== (fibonacci_tail 5 0 1) 5)
}

fn fibonacci(n: int) -> int {
    return (fibonacci_tail n 0 1)
}

shadow fibonacci {
    assert (== (fibonacci 0) 0)
    assert (== (fibonacci 20) 6765)
}

fn count_tail(n: int, acc: int) -> int {
    if (== n 0) { return acc }
    return (count_tail (- n 1) (+ acc 1))
}

shadow count_tail {
    assert (== (count_tail 0 7) 7)
    assert (== (count_tail 10 7) 17)
}

fn main() -> int {
    assert (== (factorial 5) 120)
    assert (== (factorial 10) 3628800)
    assert (== (fibonacci 20) 6765)
    # I avoid overflowing factorial arithmetic in my stack-depth check.
    assert (== (count_tail 1000000 0) 1000000)
    (println "I completed one million tail calls.")
    return 0
}

shadow main {
    # I test arithmetic here; the executable checks the compiled stack depth.
    assert (== (factorial 5) 120)
    assert (== (fibonacci 20) 6765)
    assert (== (count_tail 10 0) 10)
}
