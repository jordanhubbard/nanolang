module "src_nano/nvm2c/function_body.nano" as body
module "src_nano/nvm2c/stack_heights.nano" as heights
module "src_nano/nvm2c/container.nano" as wire
extern fn get_argc() -> int
extern fn get_argv(index: int) -> string

fn describe(bytes: array<u8>) -> string {
    if (< (array_length bytes) 40) { return "D" }
    let count: int = (wire.read_u32 bytes 8)
    let foreign: int = (wire.read_u32 bytes 16)
    let link_count: int = (wire.read_u32 bytes 20)
    let strings: int = (wire.read_u32 bytes 24)
    let header: int = (+ 40 (+ (* count 20) (* foreign 8)))
    if (or (or (== count 0) (> count 65536)) (or (> foreign 65536) (or (> link_count 64) (or (> strings 65536) (> header (array_length bytes)))))) { return "D" }
    let mut functions: array<body.Function> = []
    let mut imports: array<heights.Import> = []
    let mut linked: array<body.Linked> = []
    let mut cursor: int = 40
    let mut i: int = 0
    while (< i count) {
        set functions (array_push functions body.Function { arity: (wire.read_u32 bytes cursor),
            results: (wire.read_u32 bytes (+ cursor 4)), result_tag: (wire.read_u32 bytes (+ cursor 8)),
            locals: (wire.read_u32 bytes (+ cursor 12)), upvalues: (wire.read_u32 bytes (+ cursor 16)) })
        set cursor (+ cursor 20) set i (+ i 1)
    }
    set i 0
    while (< i foreign) {
        set imports (array_push imports heights.Import { parameters: (wire.read_u32 bytes cursor), return_tag: (wire.read_u32 bytes (+ cursor 4)) })
        set cursor (+ cursor 8) set i (+ i 1)
    }
    set i 0
    while (< i link_count) {
        if (not (wire.contains bytes cursor 8)) { return "D" }
        let resolved: int = (wire.read_u32 bytes cursor)
        let size: int = (wire.read_u32 bytes (+ cursor 4))
        set cursor (+ cursor 8)
        if (or (> resolved 1) (or (> size 65536) (not (wire.contains bytes cursor (* size 8))))) { return "D" }
        let mut signatures: array<heights.Signature> = []
        let mut j: int = 0
        while (< j size) {
            set signatures (array_push signatures heights.Signature { arity: (wire.read_u32 bytes cursor), results: (wire.read_u32 bytes (+ cursor 4)) })
            set cursor (+ cursor 8) set j (+ j 1)
        }
        set linked (array_push linked body.Linked { resolved: (== resolved 1), functions: signatures })
        set i (+ i 1)
    }
    let context: body.Context = body.Context { functions: functions, imports: imports, linked: linked,
        strings: strings, records: (wire.read_u32 bytes 28), enums: (wire.read_u32 bytes 32), unions: (wire.read_u32 bytes 36) }
    let result: body.Result = (body.verify (array_slice bytes cursor (- (array_length bytes) cursor))
        (wire.read_u32 bytes 0) (wire.read_u32 bytes 4) context (wire.read_u32 bytes 12))
    if (not result.decoded) { return "D" }
    if (not result.supported) { return "A" }
    if result.valid { return (+ "1:" (int_to_string result.maximum)) }
    return (+ "0:" result.message)
}
shadow describe { assert (== (describe []) "D") }
fn main() -> int {
    unsafe {
        let mut i: int = 1
        while (< i (get_argc)) {
            (println (describe (file_read_bytes (get_argv i))))
            set i (+ i 1)
        }
    }
    return 0
}
