# I retain declared element representations when record fields start empty.
module "empty_array_return_module.nano" as imported
struct Item { value: int }
struct Store {
    items: array<Item>,
    names: array<string>,
    measures: array<float>,
    flags: array<bool>
}
fn empty_store() -> Store {
    return Store { items: [], names: [], measures: [], flags: [] }
}
shadow empty_store {
    let store: Store = (empty_store)
    assert (== (array_length store.items) 0)
}
fn check_fields() -> int {
    let store: Store = (empty_store)
    let item: Item = Item { value: 42 }
    let items: array<Item> = (array_push store.items item)
    let names: array<string> = (array_push store.names "retained")
    let measures: array<float> = (array_push store.measures 1.5)
    let flags: array<bool> = (array_push store.flags true)
    let found: Item = (at items 0)
    assert (== found.value 42)
    assert (== (at names 0) "retained")
    assert (== (at measures 0) 1.5)
    assert (at flags 0)
    return 0
}
shadow check_fields { assert (== (check_fields) 0) }
fn add_name(values: array<string>) -> array<string> {
    return (array_push values "named")
}
shadow add_name {
    let values: array<string> = (add_name [])
    assert (== (at values 0) "named")
}
fn add_measure(values: array<float>) -> array<float> {
    return (array_push values 1.5)
}
shadow add_measure {
    let values: array<float> = (add_measure [])
    assert (== (at values 0) 1.5)
}
fn add_flag(values: array<bool>) -> array<bool> {
    return (array_push values true)
}
shadow add_flag {
    let values: array<bool> = (add_flag [])
    assert (at values 0)
}
fn add_item(values: array<Item>) -> array<Item> {
    let item: Item = Item { value: 42 }
    return (array_push values item)
}
shadow add_item {
    let values: array<Item> = (add_item [])
    let item: Item = (at values 0)
    assert (== item.value 42)
}
fn check_inferred_push() -> int {
    let names: array<string> = (array_push (array_push [] "first") "second")
    let measures: array<float> = (array_push [] 1.5)
    let flags: array<bool> = (array_push [] true)
    let record: Item = Item { value: 42 }
    let items: array<Item> = (array_push [] record)
    let found: Item = (at items 0)
    assert (== (at names 0) "first")
    assert (== (at names 1) "second")
    assert (== (at measures 0) 1.5)
    assert (at flags 0)
    assert (== found.value 42)
    return 0
}
shadow check_inferred_push { assert (== (check_inferred_push) 0) }
fn main() -> int {
    assert (at (imported.flags []) 0)
    assert (at (add_flag []) 0)
    assert (== (at (add_measure []) 0) 1.5)
    assert (== (at (add_name []) 0) "named")
    let direct_item: Item = (at (add_item []) 0)
    assert (== direct_item.value 42)
    assert (== (check_inferred_push) 0)
    let names: array<string> = (add_name [])
    let measures: array<float> = (add_measure [])
    let flags: array<bool> = (add_flag [])
    assert (== (at names 0) "named")
    assert (== (at measures 0) 1.5)
    assert (at flags 0)
    let items: array<Item> = (add_item [])
    let item: Item = (at items 0)
    assert (== item.value 42)
    return (check_fields)
}
shadow main { assert (== (main) 0) }
