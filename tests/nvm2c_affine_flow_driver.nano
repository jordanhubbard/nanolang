module "src_nano/nvm2c/affine_worklist.nano" as work
module "src_nano/nvm2c/affine_global_flow.nano" as global
module "src_nano/nvm2c/ownership_wire.nano" as read
extern fn get_argc() -> int
extern fn get_argv(index: int) -> string

fn number(value: int) -> string { return (+ (int_to_string value) ",") }
shadow number { assert (== (number 65535) "65535,") }
fn flag(value: bool) -> string { if value { return "1" } return "0" }
shadow flag { assert (== (flag true) "1") assert (== (flag false) "0") }

fn describe_queue(c: read.Cursor) -> string {
    let capacity: int = (read.read_u32 c)
    let count: int = (read.read_u32 c)
    if (or (< capacity 1) (or (> capacity 4096) (> count 100000))) { return "D" }
    let mut queue: work.Queue = (work.create capacity)
    let mut text: string = ""
    for command in (range 0 count) {
        let op: int = (read.read_u32 c)
        let index: int = (read.read_u32 c)
        if (or (> op 1) (and (== op 0) (>= index capacity))) { return "D" }
        let mut step: work.Change = work.Change { valid: false, index: -1, queue: queue }
        if (== op 0) { set step (work.enqueue queue index) } else { set step (work.dequeue queue) }
        set queue step.queue
        set text (+ text (+ (+ (flag step.valid) ",") (+ (number step.index) (+ (number queue.head) (+ (number queue.tail) (int_to_string queue.pending))))))
        set text (+ text ":")
        if (> queue.pending 0) { set text (+ text (number (at queue.items queue.head))) }
        set text (+ text ";")
    }
    return text
}
shadow describe_queue { assert (== (describe_queue (read.open [])) "D") }

fn describe_flows(c: read.Cursor) -> string {
    let count: int = (read.read_u32 c)
    if (> count 200000) { return "D" }
    let mut text: string = ""
    for index in (range 0 count) {
        let op: int = (read.read_u32 c)
        let a: int = (read.read_u32 c) let b: int = (read.read_u32 c) let d: int = (read.read_u32 c)
        let e: int = (read.read_u32 c) let f: int = (read.read_u32 c) let g: int = (read.read_u32 c)
        if (or (> op 4) (or (> a 255) (or (> b 255) (or (> d 255) (or (> e 255) (or (> f 255) (> g 255))))))) { return "D" }
        if (== op 0) { set text (+ text (+ (number (global.require a b)) ";")) }
        else if (== op 1) { set text (+ text (+ (number (global.compose a b)) ";")) }
        else {
            let first: global.Flow = (global.flow a b d)
            let second: global.Flow = (global.flow e f g)
            let mut result: global.Flow = first
            if (== op 3) { set result (global.then first second) }
            if (== op 4) { set result (global.join first second) }
            set text (+ text (+ (number result.allowed) (+ (number result.normal) (+ (number result.lexical_return) ";"))))
        }
    }
    return text
}
shadow describe_flows { assert (== (describe_flows (read.open [0,0,0,0])) "") }

fn describe(bytes: array<u8>) -> string {
    if (< (array_length bytes) 4) { return "D" }
    let cursor: read.Cursor = (read.open bytes)
    let kind: int = (read.read_u32 cursor)
    let mut text: string = "D"
    if (== kind 0) { set text (describe_flows cursor) }
    if (== kind 1) { set text (describe_queue cursor) }
    if (or (!= (read.status cursor) 0) (!= (read.position cursor) (array_length bytes))) { return "D" }
    return text
}
shadow describe { assert (== (describe []) "D") assert (== (describe [0,0,0,0,0,0,0,0]) "") }

fn main() -> int {
    unsafe {
        let mut index: int = 1
        while (< index (get_argc)) { (println (describe (file_read_bytes (get_argv index)))) set index (+ index 1) }
    }
    return 0
}
shadow main { assert (== (describe [0,0,0,0,0,0,0,0]) "") }
