/* Simple test for path operations */

module "modules/std/fs.nano" as fs

fn main() -> int {
    (println "Testing path operations")
    
    let p1: string = (fs.normalize "/foo/./bar")
    assert (== p1 "/foo/bar")
    (println p1)
    
    let p2: string = (fs.join "foo" "bar")
    assert (== p2 "foo/bar")
    (println p2)
    
    let p3: string = (fs.basename "/foo/bar/baz.txt")
    assert (== p3 "baz.txt")
    (println p3)
    
    let p4: string = (fs.dirname "/foo/bar/baz.txt")
    assert (== p4 "/foo/bar")
    (println p4)
    
    return 0
}

shadow main {
    assert (== (main) 0)
}
