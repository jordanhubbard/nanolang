{
  "name": "audio_helpers",
  "version": "1.0.0",
  "stability": "experimental",
  "summary": "Audio utility functions for common audio tasks.",
  "use_when": [
    "User needs audio utilities",
    "User says 'audio processing', 'waveform', 'audio analysis'",
    "User wants simplified audio operations"
  ],
  "avoid_when": [
    "User wants raw audio control (use sdl_mixer)"
  ],
  "capabilities": [
    "audio_processing",
    "waveform_analysis"
  ],
  "keywords": [
    "audio",
    "utilities",
    "processing",
    "analysis"
  ],
  "examples": [
    "examples/audio/sdl_audio_wav.nano"
  ],
  "dependencies": {
    "nanolang": [
      "core>=1.0"
    ],
    "modules": [
      "sdl_mixer"
    ],
    "system": []
  },
  "io_surfaces": [
    "audio"
  ],
  "alternatives": [
    {
      "when": "direct audio",
      "module": "sdl_mixer"
    }
  ],
  "nsi": {
    "interface_id": "nsi:nanolang/audio",
    "interface_version": "0",
    "schema": "schema/nsi/modules/audio.nsi.json",
    "required_capabilities": [
      "cap:nanolang/audio.write_frame"
    ],
    "isolation": "local-process",
    "resource_budgets": {
      "queue": 8,
      "memory_bytes": 65536
    },
    "restart": "never",
    "adapter": "local"
  }
}
