{
  "name": "proptest",
  "version": "0.1.0",
  "stability": "experimental",
  "summary": "Property-based testing helpers for NanoLang programs.",
  "use_when": [
    "User wants QuickCheck-style property testing with automatic counterexamples",
    "Need reproducible random generators or shrinking utilities"
  ],
  "avoid_when": [
    "User only needs deterministic unit tests",
    "Heavy structured data generators are required (module currently int-focused)"
  ],
  "capabilities": [
    "generate_ints",
    "generate_pairs",
    "generate_arrays",
    "property_runner",
    "shrinking"
  ],
  "keywords": [
    "testing",
    "property",
    "quickcheck",
    "random",
    "shrinking"
  ],
  "examples": [
    "tests/test_proptest.nano"
  ],
  "dependencies": {
    "nanolang": [],
    "system": []
  },
  "io_surfaces": [
    "terminal"
  ],
  "alternatives": [],
  "nsi": {
    "interface_id": "nsi:nanolang/pure",
    "interface_version": "0",
    "schema": "schema/nsi/modules/pure.nsi.json",
    "required_capabilities": [],
    "isolation": "in-process",
    "resource_budgets": {
      "queue": 8,
      "memory_bytes": 65536
    },
    "restart": "never",
    "adapter": "inproc"
  }
}
