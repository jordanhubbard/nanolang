/* =============================================================================
 * websocket - WebSocket client module (RFC 6455)
 * ============================================================================= */

module websocket

extern fn nl_ws_connect(_url: string) -> int
extern fn nl_ws_send(_handle: int, _message: string) -> int
extern fn nl_ws_receive(_handle: int) -> string
extern fn nl_ws_receive_timeout(_handle: int, _timeout_ms: int) -> string
extern fn nl_ws_close(_handle: int) -> int
extern fn nl_ws_is_connected(_handle: int) -> int
extern fn nl_ws_last_error(_handle: int) -> string

/* I connect to ws://host:port/path. I refuse wss:// until TLS exists.
 * My nonzero handle is a legacy registry identity, not an affine resource.
 * I bound connect/upgrade I/O to ten seconds; DNS remains synchronous. */
pub fn connect(url: string) -> int {
    unsafe {
        return (nl_ws_connect url)
    }
}

shadow connect {
    /* I refuse invalid transport requests without needing a peer. */
    let h: int = (connect "ws://127.0.0.1:0/")
    assert (== h 0)
    assert (== (connect "wss://localhost/private") 0)
}

/* Send a UTF-8 text message. Returns 0 on success. */
pub fn send(h: int, message: string) -> int {
    unsafe {
        return (nl_ws_send h message)
    }
}

shadow send {
    assert (== (send 0 "hello") -1)  /* invalid handle returns error */
}

/* I receive a complete text message within a ten-second I/O deadline.
 * I return "" on timeout, error or close; I retain partial frames on timeout. */
pub fn receive(h: int) -> string {
    unsafe {
        return (nl_ws_receive h)
    }
}

shadow receive {
    assert (== (receive 0) "")  /* invalid handle returns empty */
}

/* I accept a timeout from zero through 60000 milliseconds.
 * I return "" on timeout, invalid timeout or error. */
pub fn receive_timeout(h: int, timeout_ms: int) -> string {
    unsafe {
        return (nl_ws_receive_timeout h timeout_ms)
    }
}

shadow receive_timeout {
    assert (== (receive_timeout 0 100) "")
}

/* Close the WebSocket connection. Returns 0 on success. */
pub fn close(h: int) -> int {
    unsafe {
        return (nl_ws_close h)
    }
}

shadow close {
    assert (== (close 0) -1)  /* invalid handle */
}

/* Returns true if the handle refers to an open connection. */
pub fn is_connected(h: int) -> bool {
    unsafe {
        return (!= (nl_ws_is_connected h) 0)
    }
}

shadow is_connected {
    assert (not (is_connected 0))
}

/* Returns the last error message for a handle. */
pub fn last_error(h: int) -> string {
    unsafe {
        return (nl_ws_last_error h)
    }
}

shadow last_error {
    let msg: string = (last_error 0)
    assert (!= msg "")
}
