# GLUT - OpenGL Utility Toolkit Module
# Provides 3D geometric primitives, text rendering, and the iconic Utah Teapot
# 
# This module gives access to GLUT's extensive functionality including:
# - Solid and wireframe 3D shapes (sphere, cube, cone, torus, teapot, etc.)
# - Bitmap and stroke text rendering
# - Window and input handling utilities

# === GLUT Constants ===

# Display modes
let GLUT_RGB: int = 0
let GLUT_RGBA: int = 0
let GLUT_INDEX: int = 1
let GLUT_SINGLE: int = 0
let GLUT_DOUBLE: int = 2
let GLUT_ACCUM: int = 4
let GLUT_ALPHA: int = 8
let GLUT_DEPTH: int = 16
let GLUT_STENCIL: int = 32

# Rendering modes
let GLUT_POINT: int = 0
let GLUT_LINE: int = 1
let GLUT_FILL: int = 2

# Fonts (as integer handles)
let GLUT_BITMAP_9_BY_15: int = 2
let GLUT_BITMAP_8_BY_13: int = 3
let GLUT_BITMAP_TIMES_ROMAN_10: int = 4
let GLUT_BITMAP_TIMES_ROMAN_24: int = 5
let GLUT_BITMAP_HELVETICA_10: int = 6
let GLUT_BITMAP_HELVETICA_12: int = 7
let GLUT_BITMAP_HELVETICA_18: int = 8

# === GLUT Initialization ===

# GLUT's solid/wire primitives read the library's global state, so freeglut
# aborts with "glutSolidSphere called without first calling glutInit" when they
# are drawn before initialization. Programs that let GLFW own the window and
# the event loop still have to initialize GLUT, so this module owns one shared,
# idempotent entry point for it: glut_ensure_initialized.
#
# The shim below never calls glutCreateWindow and never enters glutMainLoop, so
# window ownership stays with whichever toolkit created the window.
pub extern fn nl_glut_ensure_init() -> int
pub extern fn nl_glut_is_initialized() -> int

# Initialize GLUT once so the primitive drawing functions are usable.
# Safe to call repeatedly; only the first call initializes.
# Returns true when GLUT state is ready, false when the process has no display
# and initialization was skipped.
pub fn glut_ensure_initialized() -> bool {
    unsafe {
        return (== (nl_glut_ensure_init) 1)
    }
}

shadow glut_ensure_initialized {
    # Requires the linked GLUT library; not exercisable from the interpreter.
    assert true
}

# Report whether GLUT has been initialized by glut_ensure_initialized.
pub fn glut_is_initialized() -> bool {
    unsafe {
        return (== (nl_glut_is_initialized) 1)
    }
}

shadow glut_is_initialized {
    # Requires the linked GLUT library; not exercisable from the interpreter.
    assert true
}

# Prefer glut_ensure_initialized over calling glutInit directly: glutInit reads
# through its argc/argv pointers, and calling it twice is an error.
extern fn glutInit(_argcp: int, _argv: int) -> void
extern fn glutInitDisplayMode(_mode: int) -> void
extern fn glutInitWindowSize(_width: int, _height: int) -> void
extern fn glutInitWindowPosition(_x: int, _y: int) -> void
extern fn glutCreateWindow(_title: string) -> int

# === 3D Solid Shapes ===

# The famous Utah Teapot!
pub extern fn glutSolidTeapot(_size: float) -> void
pub extern fn glutWireTeapot(_size: float) -> void

# Sphere
pub extern fn glutSolidSphere(_radius: float, _slices: int, _stacks: int) -> void
pub extern fn glutWireSphere(_radius: float, _slices: int, _stacks: int) -> void

# Cube
pub extern fn glutSolidCube(_size: float) -> void
pub extern fn glutWireCube(_size: float) -> void

# Cone
pub extern fn glutSolidCone(_base: float, _height: float, _slices: int, _stacks: int) -> void
pub extern fn glutWireCone(_base: float, _height: float, _slices: int, _stacks: int) -> void

# Torus (donut)
pub extern fn glutSolidTorus(_innerRadius: float, _outerRadius: float, _sides: int, _rings: int) -> void
pub extern fn glutWireTorus(_innerRadius: float, _outerRadius: float, _sides: int, _rings: int) -> void

# Dodecahedron (12-sided)
pub extern fn glutSolidDodecahedron() -> void
pub extern fn glutWireDodecahedron() -> void

# Octahedron (8-sided)
pub extern fn glutSolidOctahedron() -> void
pub extern fn glutWireOctahedron() -> void

# Tetrahedron (4-sided)
pub extern fn glutSolidTetrahedron() -> void
pub extern fn glutWireTetrahedron() -> void

# Icosahedron (20-sided)
pub extern fn glutSolidIcosahedron() -> void
pub extern fn glutWireIcosahedron() -> void

# === Text Rendering ===

# Bitmap text rendering (fast, simple)
# Note: font parameter is an integer representing the font type
pub extern fn glutBitmapCharacter(_font: int, _character: int) -> void
extern fn glutBitmapWidth(_font: int, _character: int) -> int
pub extern fn glutBitmapLength(_font: int, _str: string) -> int

# === Utility Functions ===

extern fn glutGet(_state: int) -> int
extern fn glutSwapBuffers() -> void
extern fn glutPostRedisplay() -> void
extern fn glutMainLoop() -> void
