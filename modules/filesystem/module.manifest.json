{
  "name": "filesystem",
  "version": "1.0.0",
  "stability": "experimental",
  "summary": "Advanced filesystem operations (walk directory trees, glob patterns).",
  "use_when": [
    "User needs to traverse directory trees",
    "User needs glob pattern matching",
    "User says 'walk directory', 'find files', 'recursive search'"
  ],
  "avoid_when": [
    "User only needs basic file I/O (use std module)"
  ],
  "capabilities": [
    "walk_directory",
    "glob_patterns",
    "recursive_search",
    "file_filtering"
  ],
  "keywords": [
    "files",
    "filesystem",
    "directory",
    "glob",
    "search"
  ],
  "examples": [],
  "dependencies": {
    "nanolang": [
      "core>=1.0"
    ],
    "modules": [
      "std"
    ],
    "system": []
  },
  "io_surfaces": [
    "files"
  ],
  "alternatives": [
    {
      "when": "basic file ops",
      "module": "std"
    }
  ],
  "nsi": {
    "interface_id": "nsi:nanolang/filesystem",
    "interface_version": "0",
    "schema": "schema/nsi/modules/filesystem.nsi.json",
    "required_capabilities": [
      "cap:nanolang/filesystem.open"
    ],
    "isolation": "local-process",
    "resource_budgets": {
      "queue": 8,
      "memory_bytes": 65536
    },
    "restart": "never",
    "adapter": "local"
  }
}
