# Extended Math Module for nanolang
# Provides additional math functions via FFI
# 
# This module extends nanolang's built-in math with functions needed for
# game development, physics simulations, and advanced graphics.

# Inverse trigonometric functions
pub extern fn asin(_x: float) -> float
pub extern fn acos(_x: float) -> float
pub extern fn atan(_x: float) -> float

# Logarithmic and exponential functions
pub extern fn log(_x: float) -> float    # Natural logarithm (base e)
pub extern fn log10(_x: float) -> float  # Base-10 logarithm
pub extern fn exp(_x: float) -> float    # e^x

# Hyperbolic functions (useful for some physics)
pub extern fn sinh(_x: float) -> float
pub extern fn cosh(_x: float) -> float
pub extern fn tanh(_x: float) -> float

# Additional utility functions
pub extern fn fmod(_x: float, _y: float) -> float  # Floating-point remainder
pub extern fn fabs(_x: float) -> float            # Floating-point absolute value
