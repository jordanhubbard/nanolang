{
  "name": "dispatch",
  "description": "Grand Central Dispatch (libdispatch) bindings — serial/concurrent queues, groups, async/sync dispatch",
  "version": "1.0.0",
  "headers": ["dispatch.h"],
  "c_sources": ["dispatch.c"],
  "cflags": ["-Imodules/dispatch"],
  "cflags_macos": ["-fblocks"],
  "ldflags_macos": [],
  "ldflags_linux": [],
  "dependencies": [],
  "callback_adapters": {
    "nl_queue_async": {"symbol": "nl_queue_async_retained", "abi": "retained_v1", "execution": "owner"},
    "nl_queue_sync": {"symbol": "nl_queue_sync_retained", "abi": "retained_v1", "execution": "worker"},
    "nl_queue_barrier_async": {"symbol": "nl_queue_barrier_async_retained", "abi": "retained_v1", "execution": "owner"},
    "nl_queue_after_ns": {"symbol": "nl_queue_after_ns_retained", "abi": "retained_v1", "execution": "owner"},
    "nl_group_async": {"symbol": "nl_group_async_retained", "abi": "retained_v1", "execution": "owner"},
    "nl_group_notify": {"symbol": "nl_group_notify_retained", "abi": "retained_v1", "execution": "owner"},
    "nl_group_wait_ns": {"symbol": "nl_group_wait_ns_retained", "abi": "retained_v1", "execution": "worker"},
    "nl_queue_destroy": {"symbol": "nl_queue_destroy", "abi": "retained_v1", "execution": "worker"}
  },
  "platform_notes": "I require Apple libdispatch and clang -fblocks for execution. My non-Apple stubs report unavailable and abort dispatch operations; they do not simulate concurrency. My retained bytecode adapters execute in-process; isolated callback imports are rejected."
}
