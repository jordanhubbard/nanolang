module compiler_support

extern fn nlc_module_artifact(source_path: string) -> string
extern fn nlc_module_header_constants(source_path: string) -> string

pub fn module_header_constants(source_path: string) -> string {
    unsafe { return (+ "" (nlc_module_header_constants source_path)) }
}
shadow module_header_constants {
    assert (== (module_header_constants "") "")
}

pub fn module_artifact(source_path: string) -> string {
    unsafe { return (+ "" (nlc_module_artifact source_path)) }
}
shadow module_artifact {
    assert (== (module_artifact "") "")
}
