# sdl_term module MVP — compile-only smoke. Extern SDL/term calls stay
# inside unsafe. Event polling is out of this smoke; the old KeyCode
# helper is not an extern.

module "modules/sdl/sdl.nano"
module "modules/sdl_term/sdl_term.nano"

fn main() -> int {
    if false {
        unsafe { (SDL_Init 0) }
        unsafe { (SDL_Quit) }
        let mut term: int = 0
        unsafe { set term (nl_sdl_term_create "" 14 8 8) }
        if (!= term 0) {
            unsafe { (nl_sdl_term_destroy term) }
        } else { (print "") }
    }
    return 0
}

shadow main {
    assert true
}
