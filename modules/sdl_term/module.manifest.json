{
  "name": "sdl_term",
  "version": "1.0.0",
  "stability": "experimental",
  "summary": "SDL2 terminal emulator \u2014 embed a VT100-compatible terminal in any SDL window.",
  "use_when": [
    "User wants a terminal/REPL embedded inside an SDL graphical window",
    "User says 'SDL terminal', 'graphical terminal', 'embed terminal in SDL'",
    "User wants to display subprocess output in an SDL window"
  ],
  "avoid_when": [
    "User wants a standalone terminal app (use ncurses instead)",
    "User only needs text output without SDL"
  ],
  "capabilities": [
    "vt100_emulation",
    "sdl_text_rendering",
    "cursor_tracking",
    "colour_attributes",
    "bold_underline",
    "keyboard_input_mapping"
  ],
  "keywords": [
    "terminal",
    "sdl",
    "vt100",
    "ansi",
    "emulator",
    "subprocess",
    "repl"
  ],
  "examples": [
    "modules/sdl_term/mvp.nano"
  ],
  "dependencies": {
    "nanolang": [
      "sdl",
      "sdl_ttf"
    ],
    "system": [
      {
        "id": "sdl2",
        "install": {
          "apt": "libsdl2-dev",
          "brew": "sdl2"
        },
        "version": ">=2.0"
      },
      {
        "id": "sdl2_ttf",
        "install": {
          "apt": "libsdl2-ttf-dev",
          "brew": "sdl2_ttf"
        },
        "version": ">=2.0"
      }
    ]
  },
  "io_surfaces": [
    "window"
  ],
  "alternatives": [
    {
      "when": "standalone terminal TUI",
      "module": "ncurses"
    }
  ],
  "nsi": {
    "interface_id": "nsi:nanolang/graphics",
    "interface_version": "0",
    "schema": "schema/nsi/modules/graphics.nsi.json",
    "required_capabilities": [
      "cap:nanolang/graphics.present"
    ],
    "isolation": "local-process",
    "resource_budgets": {
      "queue": 8,
      "memory_bytes": 65536
    },
    "restart": "never",
    "adapter": "local"
  }
}
