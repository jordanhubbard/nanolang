{
  "name": "nano_tools",
  "version": "0.1.0",
  "stability": "experimental",
  "summary": "Tooling helpers for linting and syntax checks.",
  "use_when": [
    "User wants to lint or statically check NanoLang code",
    "User wants tooling helpers for syntax diagnostics"
  ],
  "avoid_when": [],
  "capabilities": [
    "lint",
    "syntax_check",
    "diagnostics",
    "pretty_print",
    "highlight"
  ],
  "keywords": [
    "lint",
    "syntax",
    "diagnostics",
    "tools",
    "nanolang",
    "pretty",
    "highlight"
  ],
  "examples": [
    "examples/nano_tools_lint.nano"
  ],
  "dependencies": {
    "nanolang": [
      "core>=1.0"
    ],
    "modules": [],
    "system": []
  },
  "io_surfaces": [
    "files"
  ],
  "nsi": {
    "interface_id": "nsi:nanolang/pure",
    "interface_version": "0",
    "schema": "schema/nsi/modules/pure.nsi.json",
    "required_capabilities": [],
    "isolation": "in-process",
    "resource_budgets": {
      "queue": 8,
      "memory_bytes": 65536
    },
    "restart": "never",
    "adapter": "inproc"
  }
}
