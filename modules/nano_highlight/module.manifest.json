{
  "name": "nano_highlight",
  "version": "0.1.0",
  "stability": "experimental",
  "summary": "NanoLang syntax highlighting and HTML formatting.",
  "use_when": [
    "User wants syntax highlighting for NanoLang",
    "User wants pretty-printing or code formatting",
    "User wants NanoLang source displayed in UI or docs"
  ],
  "avoid_when": [],
  "capabilities": [
    "highlight",
    "pretty_print",
    "tokenize"
  ],
  "keywords": [
    "syntax",
    "highlight",
    "format",
    "code",
    "nanolang"
  ],
  "examples": [],
  "dependencies": {
    "nanolang": [
      "core>=1.0"
    ],
    "modules": [],
    "system": []
  },
  "io_surfaces": [
    "files"
  ],
  "nsi": {
    "interface_id": "nsi:nanolang/pure",
    "interface_version": "0",
    "schema": "schema/nsi/modules/pure.nsi.json",
    "required_capabilities": [],
    "isolation": "in-process",
    "resource_budgets": {
      "queue": 8,
      "memory_bytes": 65536
    },
    "restart": "never",
    "adapter": "inproc"
  }
}
