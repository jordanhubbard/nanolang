/* =============================================================================
 * std::fs - File system operations: I/O + traversal + glob + path utilities
 * =============================================================================
 */

module std_fs

/* FFI declarations for filesystem operations */
extern fn fs_walkdir(_root: string) -> array<string>
extern fn path_normalize(_path: string) -> string
extern fn path_canonical(_path: string) -> string
extern fn path_join(_a: string, _b: string) -> string
extern fn path_basename(_path: string) -> string
extern fn path_dirname(_path: string) -> string
extern fn path_relpath(_target: string, _base: string) -> string

# I declare the ownership companions used by my C-seed adapters.
extern fn path_normalize__nano_string_release_v1(_result: string) -> void
extern fn path_canonical__nano_string_release_v1(_result: string) -> void
extern fn path_join__nano_string_release_v1(_result: string) -> void
extern fn path_basename__nano_string_release_v1(_result: string) -> void
extern fn path_dirname__nano_string_release_v1(_result: string) -> void
extern fn path_relpath__nano_string_release_v1(_result: string) -> void
extern fn file_read(_path: string) -> string
extern fn file_write(_path: string, _content: string) -> int
extern fn file_append(_path: string, _content: string) -> int
extern fn file_exists(_path: string) -> bool
extern fn file_delete(_path: string) -> int
extern fn fs_mkdir_p(_path: string) -> int
extern fn file_copy(_src: string, _dst: string) -> int
extern fn dir_copy(_src: string, _dst: string) -> int
/* Note: getcwd is a builtin and doesn't need extern declaration */

# I follow directory links once per opened directory identity, in unspecified
# order. Missing/unreadable paths are omitted; this is a best-effort walk, not
# a complete snapshot or a confinement boundary. Host path limits still apply.
pub fn walkdir(root: string) -> array<string> {
    unsafe {
        return (fs_walkdir root)
    }
}

shadow walkdir {
    let directory: string = (mktemp_dir "nano_fs_walk_")
    assert (!= directory "")
    if (!= directory "") {
        let path: string = (+ directory "/one.txt")
        assert (== (write path "one") 0)
        let files: array<string> = (walkdir directory)
        assert (== (array_length files) 1)
        assert (== (at files 0) path)
        assert (== (delete path) 0)
        assert (== (delete directory) 0)
    }
}

pub fn normalize(path: string) -> string {
    unsafe {
        return (path_normalize path)
    }
}

# I resolve existing paths, including symlinks; failure returns an empty string.
pub fn canonical(path: string) -> string {
    unsafe { return (path_canonical path) }
}

shadow canonical {
    assert (== (canonical "") "")
    let directory: string = (mktemp_dir "nano_fs_canonical_")
    assert (!= directory "")
    if (!= directory "") {
        let resolved: string = (canonical directory)
        assert (!= resolved "")
        assert (== (canonical (+ directory "/.")) resolved)
        assert (== (canonical (+ directory "/absent")) "")
        assert (== (delete directory) 0)
    }
}

shadow normalize {
    assert (== (normalize "/foo/./bar/../baz") "/foo/baz")
    assert (== (normalize "foo/bar/..") "foo")
    assert (== (normalize "./foo") "foo")
}

pub fn join(a: string, b: string) -> string {
    unsafe {
        return (path_join a b)
    }
}

shadow join {
    assert (== (join "foo" "bar") "foo/bar")
    assert (== (join "foo/" "bar") "foo/bar")
    assert (== (join "" "bar") "bar")
}

pub fn basename(path: string) -> string {
    unsafe {
        return (path_basename path)
    }
}

shadow basename {
    assert (== (basename "/foo/bar/baz.txt") "baz.txt")
    assert (== (basename "baz.txt") "baz.txt")
}

pub fn dirname(path: string) -> string {
    unsafe {
        return (path_dirname path)
    }
}

shadow dirname {
    assert (== (dirname "/foo/bar/baz.txt") "/foo/bar")
    assert (== (dirname "foo/bar") "foo")
}


pub fn relpath(target: string, base: string) -> string {
    unsafe {
        return (path_relpath target base)
    }
}

shadow relpath {
    assert (== (relpath "/a/b/c" "/a") "b/c")
    assert (== (relpath "leaf" ".") "leaf")
    assert (== (relpath "../leaf" "..") "leaf")
    assert (== (relpath "/leaf" ".") (relpath "/leaf" (cwd)))
    assert (== (normalize (join "." (relpath "leaf" "."))) (normalize "leaf"))
    assert (== (normalize (join ".." (relpath "../leaf" ".."))) (normalize "../leaf"))
}

pub fn cwd() -> string {
    unsafe {
        return (getcwd)
    }
}

shadow cwd {
    let dir: string = (cwd)
    assert (> (str_length dir) 0)
}

# @pure
fn glob_match_impl(pattern: string, pi: int, text: string, ti: int) -> bool {
    let plen: int = (str_length pattern)
    let tlen: int = (str_length text)

    if (== pi plen) {
        return (== ti tlen)
    }

    let pc: int = (char_at pattern pi)

    /* '*' */
    if (== pc 42) {
        let mut pi2: int = pi
        while (and (< pi2 plen) (== (char_at pattern pi2) 42)) {
            set pi2 (+ pi2 1)
        }

        /* Trailing '*' matches everything */
        if (== pi2 plen) {
            return true
        }

        let mut t: int = ti
        while (<= t tlen) {
            if (glob_match_impl pattern pi2 text t) {
                return true
            }
            set t (+ t 1)
        }

        return false
    }

    if (== ti tlen) {
        return false
    }

    /* '?' */
    if (== pc 63) {
        return (glob_match_impl pattern (+ pi 1) text (+ ti 1))
    }

    if (== pc (char_at text ti)) {
        return (glob_match_impl pattern (+ pi 1) text (+ ti 1))
    }

    return false
}

shadow glob_match_impl {
    assert (glob_match_impl "*" 0 "nanolang" 0)
    assert (glob_match_impl "a?c" 0 "abc" 0)
    assert (not (glob_match_impl "abc" 0 "ab" 0))
}

pub fn glob_match(pattern: string, text: string) -> bool {
    return (glob_match_impl pattern 0 text 0)
}

shadow glob_match {
    assert (glob_match "*.txt" "foo.txt")
    assert (glob_match "test_*.c" "test_foo.c")
    assert (glob_match "???.txt" "foo.txt")
    assert (not (glob_match "*.c" "foo.txt"))
}

pub fn glob(root: string, pattern: string) -> array<string> {
    let files: array<string> = (walkdir root)
    let mut out: array<string> = []

    let n: int = (array_length files)
    let mut i: int = 0

    while (< i n) {
        let p: string = (at files i)
        let b: string = (basename p)
        if (glob_match pattern b) {
            set out (array_push out p)
        }
        set i (+ i 1)
    }
    return out
}

shadow glob {
    let directory: string = (mktemp_dir "nano_fs_glob_")
    assert (!= directory "")
    if (!= directory "") {
        let path: string = (+ directory "/one.nano")
        assert (== (write path "one") 0)
        assert (== (write (+ directory "/two.txt") "two") 0)
        let nanos: array<string> = (glob directory "*.nano")
        assert (== (array_length nanos) 1)
        assert (== (at nanos 0) path)
        assert (== (delete path) 0)
        assert (== (delete (+ directory "/two.txt")) 0)
        assert (== (delete directory) 0)
    }
}

/* =============================================================================
 * FILE I/O OPERATIONS
 * ============================================================================= */

pub fn read(path: string) -> string {
    unsafe {
        return (file_read path)
    }
}

shadow read {
    let directory: string = (mktemp_dir "nano_fs_read_")
    assert (!= directory "")
    if (!= directory "") {
        let path: string = (+ directory "/read.txt")
        assert (== (write path "read back") 0)
        assert (== (read path) "read back")
        assert (== (delete path) 0)
        assert (== (delete directory) 0)
    }
}

pub fn write(path: string, content: string) -> int {
    unsafe {
        return (file_write path content)
    }
}

shadow write {
    let directory: string = (mktemp_dir "nano_fs_write_")
    assert (!= directory "")
    if (!= directory "") {
        let path: string = (+ directory "/write.txt")
        assert (== (write path "test content") 0)
        assert (== (read path) "test content")
        assert (== (delete path) 0)
        assert (== (delete directory) 0)
    }
}

pub fn append(path: string, content: string) -> int {
    unsafe {
        return (file_append path content)
    }
}

shadow append {
    let directory: string = (mktemp_dir "nano_fs_append_")
    assert (!= directory "")
    if (!= directory "") {
        let path: string = (+ directory "/append.txt")
        assert (== (write path "line1\n") 0)
        assert (== (append path "line2\n") 0)
        assert (== (read path) "line1\nline2\n")
        assert (== (delete path) 0)
        assert (== (delete directory) 0)
    }
}

pub fn exists(path: string) -> bool {
    unsafe {
        return (file_exists path)
    }
}

shadow exists {
    let directory: string = (mktemp_dir "nano_fs_exists_")
    assert (!= directory "")
    if (!= directory "") {
        let path: string = (+ directory "/exists.txt")
        assert (not (exists path))
        assert (== (write path "present") 0)
        assert (exists path)
        assert (== (delete path) 0)
        assert (not (exists path))
        assert (== (delete directory) 0)
    }
}

pub fn delete(path: string) -> int {
    unsafe {
        return (file_delete path)
    }
}

shadow delete {
    let directory: string = (mktemp_dir "nano_fs_delete_")
    assert (!= directory "")
    if (!= directory "") {
        let path: string = (+ directory "/delete.txt")
        assert (== (write path "temp") 0)
        assert (exists path)
        assert (== (delete path) 0)
        assert (not (exists path))
        assert (== (delete directory) 0)
    }
}


pub fn mkdir_p(path: string) -> int {
    unsafe {
        return (fs_mkdir_p path)
    }
}

shadow mkdir_p {
    let directory: string = (mktemp_dir "nano_fs_mkdir_")
    assert (!= directory "")
    if (!= directory "") {
        let path: string = (+ directory "/parent/child")
        assert (== (mkdir_p path) 0)
        assert (== (mkdir_p path) 0)
        assert (exists path)
        assert (== (delete path) 0)
        assert (== (delete (+ directory "/parent")) 0)
        assert (== (delete directory) 0)
    }
}

pub fn copy_file(src: string, dst: string) -> int {
    unsafe {
        return (file_copy src dst)
    }
}

shadow copy_file {
    let directory: string = (mktemp_dir "nano_fs_copy_")
    assert (!= directory "")
    if (!= directory "") {
        let src: string = (+ directory "/source.txt")
        let dst: string = (+ directory "/destination.txt")
        assert (== (write src "hello") 0)
        assert (== (copy_file src dst) 0)
        assert (== (read dst) "hello")
        assert (== (delete src) 0)
        assert (== (delete dst) 0)
        assert (== (delete directory) 0)
    }
}

pub fn copy_dir(src: string, dst: string) -> int {
    unsafe {
        return (dir_copy src dst)
    }
}

shadow copy_dir {
    let directory: string = (mktemp_dir "nano_fs_copy_dir_")
    assert (!= directory "")
    if (!= directory "") {
        let src: string = (+ directory "/source")
        let dst: string = (+ directory "/destination")
        assert (== (mkdir_p src) 0)
        assert (== (write (+ src "/file.txt") "ok") 0)
        assert (== (copy_dir src dst) 0)
        assert (== (read (+ dst "/file.txt")) "ok")
        assert (== (delete (+ src "/file.txt")) 0)
        assert (== (delete (+ dst "/file.txt")) 0)
        assert (== (delete src) 0)
        assert (== (delete dst) 0)
        assert (== (delete directory) 0)
    }
}
