/* I retain my native owner/intrinsic source as C string text. */
"/* I retain owner shells across explicit free and reclaim unreachable leaves with native roots. */\n"
"typedef struct { nbpayload_t *payload; } nbowner;\n"
"static void nbowner_release(nmap_value value) {\n"
"    nbowner *owner = (nbowner *)value.text;\n"
"    if (!owner || value.kind != 6) NVM2C_ABORT();\n"
"    if (owner->payload) {\n"
"        nmap_bytes_drop(sizeof *owner->payload + owner->payload->capacity);\n"
"        nbpayload_free(owner->payload);\n"
"    }\n"
"    nmap_bytes_drop(sizeof *owner);\n"
"    free(owner);\n"
"}\n"
"static inline nbowner *nbowner_require(nmap_value value) {\n"
"    if (value.kind != 6 || !value.text) NVM2C_ABORT();\n"
"    for (nvalue_owned *entry = nvalue_owned_head; entry; entry = entry->next)\n"
"        if (entry->value.kind == 6 && entry->value.text == value.text && entry->release == nbowner_release) {\n"
"            nbowner *owner = (nbowner *)value.text;\n"
"            if (!owner->payload) NVM2C_ABORT();\n"
"            return owner;\n"
"        }\n"
"    NVM2C_ABORT();\n"
"}\n"
"static inline nmap_value nbowner_adopt(nbpayload_t *payload) {\n"
"    if (!payload || payload->capacity > SIZE_MAX - sizeof *payload - sizeof(nbowner) - sizeof(nvalue_owned)) NVM2C_ABORT();\n"
"    nbowner *owner = malloc(sizeof *owner);\n"
"    nvalue_owned *entry = malloc(sizeof *entry);\n"
"    if (!owner || !entry) { free(owner); free(entry); nbpayload_free(payload); NVM2C_ABORT(); }\n"
"    nmap_bytes_add(sizeof *payload + payload->capacity + sizeof *owner + sizeof *entry);\n"
"    owner->payload = payload;\n"
"    nmap_value value = {6, 0, (char *)owner};\n"
"    *entry = (nvalue_owned){value, nvalue_owned_head, 0, nbowner_release};\n"
"    nvalue_owned_head = entry;\n"
"    if (++nmap_owned_live > nmap_owned_peak) nmap_owned_peak = nmap_owned_live;\n"
"    return value;\n"
"}\n"
"static inline nmap_value nhost_vm_bstring_new(const char *text) {\n"
"    if (!text) NVM2C_ABORT();\n"
"    return nbowner_adopt(nbpayload_new(text));\n"
"}\n"
"static inline nmap_value nhost_vm_bstring_new_binary(nmap_value array) {\n"
"    if (array.kind != 7 || !array.text) NVM2C_ABORT();\n"
"    if (array.integer != 15) return nbowner_adopt(nbpayload_new_binary(\"\", 0));\n"
"    narr_t bytes = (narr_t)array.text;\n"
"    if (bytes->len > INT64_MAX || (bytes->len && !bytes->data)) NVM2C_ABORT();\n"
"    if (!bytes->len) return nbowner_adopt(nbpayload_new_binary(\"\", 0));\n"
"    unsigned char *copy = malloc(bytes->len);\n"
"    if (!copy) NVM2C_ABORT();\n"
"    for (size_t i = 0; i < bytes->len; ++i) {\n"
"        if (bytes->data[i] < 0 || bytes->data[i] > 255) { free(copy); NVM2C_ABORT(); }\n"
"        copy[i] = (unsigned char)bytes->data[i];\n"
"    }\n"
"    nbpayload_t *payload = nbpayload_new_binary(copy, bytes->len);\n"
"    free(copy);\n"
"    return nbowner_adopt(payload);\n"
"}\n"
"static inline int64_t nhost_vm_bstring_length(nmap_value value) {\n"
"    nbpayload_t *payload = nbowner_require(value)->payload;\n"
"    if (payload->length > INT64_MAX) NVM2C_ABORT();\n"
"    return (int64_t)nbpayload_length(payload);\n"
"}\n"
"static inline nmap_value nhost_vm_bstring_concat(nmap_value a, nmap_value b) {\n"
"    nbpayload_t *left = nbowner_require(a)->payload, *right = nbowner_require(b)->payload;\n"
"    if (right->length >= SIZE_MAX - left->length) NVM2C_ABORT();\n"
"    return nbowner_adopt(nbpayload_concat(left, right));\n"
"}\n"
"static inline nmap_value nhost_vm_bstring_substring(nmap_value value, int64_t start, int64_t length) {\n"
"    nbpayload_t *payload = nbowner_require(value)->payload;\n"
"    if (start < 0 || length < 0) return nbowner_adopt(nbpayload_new(\"\"));\n"
"    size_t offset = (uint64_t)start > payload->length ? payload->length : (size_t)start;\n"
"    size_t remaining = payload->length - offset;\n"
"    size_t count = (uint64_t)length > remaining ? remaining : (size_t)length;\n"
"    return nbowner_adopt(nbpayload_substring(payload, offset, count));\n"
"}\n"
"static inline int64_t nhost_vm_bstring_equals(nmap_value a, nmap_value b) {\n"
"    return nbpayload_equals(nbowner_require(a)->payload, nbowner_require(b)->payload);\n"
"}\n"
"static inline int64_t nhost_vm_bstring_byte_at(nmap_value value, int64_t index) {\n"
"    nbpayload_t *payload = nbowner_require(value)->payload;\n"
"    return index < 0 || (uint64_t)index >= payload->length ? 0 : (unsigned char)nbpayload_byte_at(payload, (size_t)index);\n"
"}\n"
"static inline int64_t nhost_vm_bstring_validate_utf8(nmap_value value) {\n"
"    return nbpayload_validate_utf8(nbowner_require(value)->payload);\n"
"}\n"
"static inline int64_t nhost_vm_bstring_utf8_length(nmap_value value) {\n"
"    return nbpayload_utf8_length(nbowner_require(value)->payload);\n"
"}\n"
"static inline int64_t nhost_vm_bstring_utf8_char_at(nmap_value value, int64_t index) {\n"
"    nbpayload_t *payload = nbowner_require(value)->payload;\n"
"    return index < 0 ? -1 : nbpayload_utf8_char_at(payload, (size_t)index);\n"
"}\n"
"static inline const char *nhost_vm_bstring_to_cstr(nmap_value value) {\n"
"    nbpayload_t *payload = nbowner_require(value)->payload;\n"
"    size_t before = payload->capacity;\n"
"    const char *text = nbpayload_to_cstr(payload);\n"
"    if (payload->capacity > before) nmap_bytes_add(payload->capacity - before);\n"
"    if (!text || !payload->null_terminated) NVM2C_ABORT();\n"
"    size_t length = strlen(text);\n"
"    char *snapshot = nstr_allocate(length);\n"
"    memcpy(snapshot, text, length + 1);\n"
"    return snapshot;\n"
"}\n"
"static inline void nhost_vm_bstring_free(nmap_value value) {\n"
"    nbowner *owner = nbowner_require(value);\n"
"    nmap_bytes_drop(sizeof *owner->payload + owner->payload->capacity);\n"
"    nbpayload_free(owner->payload);\n"
"    owner->payload = NULL;\n"
"}\n"
