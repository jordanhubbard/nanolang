/* I trace live native frames and aggregate edges before reclaiming map owners.
 * Kinds here are NVM2C_VK_* storage kinds, not NanoISA runtime tags. */
"typedef struct { uint8_t kind; const void *ptr; } nroot_ref;\n"
"typedef struct { nroot_ref *items; size_t count, capacity; } nroot_list;\n"
"typedef struct nroot_frame { nroot_list live; struct nroot_frame *prev; } nroot_frame;\n"
"static nroot_frame *nroot_head;\n"
"static void nroot_add(nroot_list *list, uint8_t kind, const void *ptr) {\n"
"    if (!ptr || kind == 0 || kind == 2 || kind == 3 || kind == 9 || kind == 10 || kind == 11) return;\n"
"    for (size_t i = 0; i < list->count; ++i)\n"
"        if (list->items[i].kind == kind && list->items[i].ptr == ptr) return;\n"
"    if (list->count == list->capacity) {\n"
"        if (list->capacity > SIZE_MAX / 2 / sizeof *list->items) abort();\n"
"        size_t capacity = list->capacity ? list->capacity * 2 : 16;\n"
"        nroot_ref *items = realloc(list->items, capacity * sizeof *items);\n"
"        if (!items) abort();\n"
"        list->items = items; list->capacity = capacity;\n"
"    }\n"
"    list->items[list->count++] = (nroot_ref){kind, ptr};\n}\n"
"static void nroot_value(nroot_list *work, nmap_value value) {\n"
"    if (value.kind == 5) nroot_add(work, 1, value.text);\n"
"    else if (value.kind == 13) nroot_add(work, 7, value.text);\n"
"    else if (value.kind == 7) nroot_add(work, (uint8_t)value.integer, value.text);\n}\n"
"static void nroot_trace(nroot_list *work) {\n"
"    for (size_t cursor = 0; cursor < work->count; ++cursor) {\n"
"        nroot_ref root = work->items[cursor];\n"
"        if (root.kind == 1) {\n"
"            for (nvalue_owned *v = nvalue_owned_head; v; v = v->next)\n"
"                if (v->value.text == root.ptr) v->marked = 1;\n"
"        } else if (root.kind == 7) {\n"
"            for (nmap_owned *m = nmap_owned_head; m; m = m->next)\n"
"                if (m->map == root.ptr) m->marked = 1;\n"
"        } else if (root.kind == 8) nroot_value(work, *(const nmap_value *)root.ptr);\n"
"        else if (root.kind == 5) {\n"
"            const nsarr_s *a = root.ptr;\n"
"            for (size_t i = 0; i < a->len; ++i) nroot_add(work, 1, a->data[i]);\n"
"        } else if (root.kind == 6) {\n"
"            const nrarr_s *a = root.ptr;\n"
"            for (size_t i = 0; i < a->len; ++i) nroot_add(work, 4, &a->data[i]);\n"
"        } else if (root.kind == 4) {\n"
"            const nrec_t *r = root.ptr;\n"
"            for (size_t i = 0; i < r->n; ++i) {\n"
"                if (r->k[i] == 1) nroot_add(work, 1, r->s[i]);\n"
"                else if (r->k[i] == 4) nroot_add(work, 4, r->rec[i]);\n"
"                else if (r->k[i] == 5) nroot_add(work, 5, r->sa[i]);\n"
"                else if (r->k[i] == 6) nroot_add(work, 6, r->ra[i]);\n"
"                else if (r->k[i] == 7) nroot_add(work, 7, r->m[i]);\n"
"                else if (r->k[i] == 8) nroot_value(work, (nmap_value){r->vk[i], r->f[i], (char *)r->s[i]});\n"
"            }\n"
"        }\n"
"    }\n}\n"
"static void nmap_sweep(void) {\n"
"    nmap_owned **maps = &nmap_owned_head;\n"
"    while (*maps) {\n"
"        nmap_owned *owner = *maps;\n"
"        if (owner->marked) { owner->marked = 0; maps = &owner->next; }\n"
"        else { *maps = owner->next; nmap_destroy(owner->map); free(owner); --nmap_owned_live; }\n"
"    }\n"
"    nvalue_owned **values = &nvalue_owned_head;\n"
"    while (*values) {\n"
"        nvalue_owned *owner = *values;\n"
"        if (owner->marked) { owner->marked = 0; values = &owner->next; }\n"
"        else { *values = owner->next; nmap_release_value(owner->value); free(owner); --nmap_owned_live; }\n"
"    }\n}\n"
