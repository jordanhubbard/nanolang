/* I trace live native frames and aggregate edges before reclaiming owners.
 * Kind 128 is an internal exact owner key obtained from a currently live array
 * handle. I never retain/dereference a discarded foreign stack handle.
 * Kinds here are NVM2C_VK_* storage kinds, not NanoISA runtime tags.
 * I keep traversal order in items; my half-full power-of-two index stores
 * item indices plus one so reallocating items never invalidates membership. */
"typedef struct { uint8_t kind; const void *ptr; } nroot_ref;\n"
"typedef struct { nroot_ref *items; size_t count, capacity; size_t *slots; size_t slot_count; } nroot_list;\n"
"typedef struct nroot_frame { nroot_list live; struct nroot_frame *prev; } nroot_frame;\n"
"static nroot_frame *nroot_head;\n"
"static size_t nroot_hash(uint8_t kind, const void *ptr) {\n"
"    uint64_t value = (uint64_t)(uintptr_t)ptr ^ kind;\n"
"    value = (value ^ (value >> 30)) * UINT64_C(0xbf58476d1ce4e5b9);\n"
"    value = (value ^ (value >> 27)) * UINT64_C(0x94d049bb133111eb);\n"
"    return (size_t)(value ^ (value >> 31));\n"
"}\n"
"static size_t nroot_slot(const nroot_list *list, uint8_t kind, const void *ptr) {\n"
"    size_t slot = nroot_hash(kind, ptr) & (list->slot_count - 1);\n"
"    while (list->slots[slot]) {\n"
"        size_t index = list->slots[slot] - 1;\n"
"        if (list->items[index].kind == kind && list->items[index].ptr == ptr) break;\n"
"        slot = (slot + 1) & (list->slot_count - 1);\n"
"    }\n"
"    return slot;\n"
"}\n"
"static int nroot_contains(const nroot_list *list, uint8_t kind, const void *ptr) {\n"
"    return list->slot_count && list->slots[nroot_slot(list, kind, ptr)] != 0;\n"
"}\n"
"static inline void nroot_reset(nroot_list *list) {\n"
"    list->count = 0;\n"
"    if (list->slot_count) memset(list->slots, 0, list->slot_count * sizeof *list->slots);\n"
"}\n"
"static void nroot_destroy(nroot_list *list) {\n"
"    free(list->items); free(list->slots); *list = (nroot_list){0};\n"
"}\n"
"static void nroot_add(nroot_list *list, uint8_t kind, const void *ptr) {\n"
"    if (!ptr || kind == 0 || kind == 2 || kind == 9 || kind == 11) return;\n"
"    if (nroot_contains(list, kind, ptr)) return;\n"
"    if (list->count >= list->slot_count / 2) {\n"
"        if (list->slot_count > SIZE_MAX / 2 / sizeof *list->slots) NVM2C_ABORT();\n"
"        size_t count = list->slot_count ? list->slot_count * 2 : 32;\n"
"        size_t *slots = calloc(count, sizeof *slots);\n"
"        if (!slots) NVM2C_ABORT();\n"
"        free(list->slots); list->slots = slots; list->slot_count = count;\n"
"        for (size_t i = 0; i < list->count; ++i)\n"
"            list->slots[nroot_slot(list, list->items[i].kind, list->items[i].ptr)] = i + 1;\n"
"    }\n"
"    if (list->count == list->capacity) {\n"
"        if (list->capacity > SIZE_MAX / 2 / sizeof *list->items) NVM2C_ABORT();\n"
"        size_t capacity = list->capacity ? list->capacity * 2 : 16;\n"
"        nroot_ref *items = realloc(list->items, capacity * sizeof *items);\n"
"        if (!items) NVM2C_ABORT();\n"
"        list->items = items; list->capacity = capacity;\n"
"    }\n"
"    size_t slot = nroot_slot(list, kind, ptr);\n"
"    list->items[list->count++] = (nroot_ref){kind, ptr};\n"
"    list->slots[slot] = list->count;\n"
"}\n"
"static void nroot_value(nroot_list *work, nmap_value value) {\n"
"    if (value.kind == 8) nroot_add(work, 4, value.text);\n"
"    else if (value.kind == 5) nroot_add(work, 1, value.text);\n"
"    else if (value.kind == 13) nroot_add(work, 7, value.text);\n"
"    else if (value.kind == 7) nroot_add(work, (uint8_t)value.integer, value.text);\n"
"}\n"
"static void nroot_trace(nroot_list *work) {\n"
"    for (size_t cursor = 0; cursor < work->count; ++cursor) {\n"
"        nroot_ref root = work->items[cursor];\n"
"        if (root.kind == 8) nroot_value(work, *(const nmap_value *)root.ptr);\n"
"        else if (root.kind == 3 || root.kind == 10 || root.kind == 12 || root.kind == 15) {\n"
"            const narr_s *a = root.ptr;\n"
"            nroot_add(work, 128, a->owner);\n"
"        }\n"
"        else if (root.kind == 5) {\n"
"            const nsarr_s *a = root.ptr;\n"
"            nroot_add(work, 128, a->owner);\n"
"            for (size_t i = 0; i < a->len; ++i) nroot_add(work, 1, a->data[i]);\n"
"        } else if (root.kind == 13) {\n"
"            const naarr_s *a = root.ptr;\n"
"            nroot_add(work, 128, a->owner);\n"
"            if (a->len && !a->data) NVM2C_ABORT();\n"
"            for (size_t i = 0; i < a->len; ++i) nroot_value(work, a->data[i]);\n"
"        } else if (root.kind == 6) {\n"
"            const nrarr_s *a = root.ptr;\n"
"            nroot_add(work, 128, a->owner);\n"
"            if (a->len && !a->data) NVM2C_ABORT();\n"
"            for (size_t i = 0; i < a->len; ++i) nroot_add(work, 4, &a->data[i]);\n"
"        } else if (root.kind == 4) {\n"
"            const nrec_t *r = root.ptr;\n"
"            for (size_t i = 0; i < r->n; ++i) {\n"
"                if (r->k[i] == 1) nroot_add(work, 1, r->s[i]);\n"
"                else if (r->k[i] == 3 || r->k[i] == 10 || r->k[i] == 12 || r->k[i] == 15) nroot_add(work, r->k[i], r->a[i]);\n"
"                else if (r->k[i] == 4) nroot_add(work, 4, r->rec[i]);\n"
"                else if (r->k[i] == 5) nroot_add(work, 5, r->sa[i]);\n"
"                else if (r->k[i] == 6) nroot_add(work, 6, r->ra[i]);\n"
"                else if (r->k[i] == 7) nroot_add(work, 7, r->m[i]);\n"
"                else if (r->k[i] == 8) nroot_value(work, (nmap_value){r->vk[i], r->f[i], (char *)r->s[i]});\n"
"            }\n"
"        }\n"
"    }\n"
"    /* I mark each owner once after closing the same reachable graph. */\n"
"    for (nvalue_owned *v = nvalue_owned_head; v; v = v->next)\n"
"        if (nroot_contains(work, 1, v->value.text)) v->marked = 1;\n"
"    for (nmap_owned *m = nmap_owned_head; m; m = m->next)\n"
"        if (nroot_contains(work, 7, m->map)) m->marked = 1;\n"
"}\n"
"static void nmap_sweep(void) {\n"
"    nmap_owned **maps = &nmap_owned_head;\n"
"    while (*maps) {\n"
"        nmap_owned *owner = *maps;\n"
"        if (owner->marked) { owner->marked = 0; maps = &owner->next; }\n"
"        else { *maps = owner->next; nmap_destroy(owner->map); nmap_bytes_drop(sizeof *owner); free(owner); --nmap_owned_live; }\n"
"    }\n"
"    nvalue_owned **values = &nvalue_owned_head;\n"
"    while (*values) {\n"
"        nvalue_owned *owner = *values;\n"
"        if (owner->marked) { owner->marked = 0; values = &owner->next; }\n"
"        else { *values = owner->next; nmap_release_value(owner->value); nmap_bytes_drop(sizeof *owner); free(owner); --nmap_owned_live; }\n"
"    }\n"
"}\n"
