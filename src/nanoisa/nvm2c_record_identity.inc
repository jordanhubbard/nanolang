/* I emit canonical record storage only after complete public-array admission. */
"typedef struct nrec_owned {\n"
"    nrec_t value; struct nrec_owned *next;\n"
"    int64_t f[NREC_WIDTH]; const char *s[NREC_WIDTH];\n"
"    narr_t a[NREC_WIDTH]; nsarr_t sa[NREC_WIDTH]; nrarr_t ra[NREC_WIDTH];\n"
"    const nrec_t *rec[NREC_WIDTH]; uint8_t k[NREC_WIDTH], vk[NREC_WIDTH]; nmap_t m[NREC_WIDTH];\n"
"} nrec_owned;\n"
"static nrec_owned *nrec_owned_head;\n"
"static inline int nrec_empty_slot(const nrec_t *r) {\n"
"    return !r->identity && !r->f && !r->s && !r->a && !r->sa && !r->ra &&\n"
"        !r->rec && !r->k && !r->vk && !r->m && !r->n && !r->tag && !r->kind && !r->callable_target;\n"
"}\n"
"static inline nrec_t nrec_create(uint16_t count, uint8_t kind, uint16_t tag) {\n"
"    if (count > NREC_WIDTH || kind != 0) NVM2C_ABORT();\n"
"    nrec_owned *node = calloc(1, sizeof *node); if (!node) NVM2C_ABORT();\n"
"    node->value = (nrec_t){.f=node->f, .s=node->s, .a=node->a, .sa=node->sa,\n"
"        .ra=node->ra, .rec=node->rec, .k=node->k, .vk=node->vk, .m=node->m,\n"
"        .n=count, .tag=tag, .kind=kind, .identity=&node->value};\n"
"    nagg_add(sizeof *node); node->next=nrec_owned_head; nrec_owned_head=node;\n"
"    return node->value;\n"
"}\n"
"static inline const nrec_t *nrec_snapshot(nrec_t value) {\n"
"    if (!value.identity) NVM2C_ABORT();\n"
"    return value.identity;\n"
"}\n"
"static void nrec_release_snapshots(void) {\n"
"    while (nrec_owned_head) { nrec_owned *node=nrec_owned_head;\n"
"        nrec_owned_head=node->next; nagg_drop(sizeof *node); free(node); }\n"
"}\n"
