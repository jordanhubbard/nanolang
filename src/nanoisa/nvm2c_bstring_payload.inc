/* I derive this payload from runtime/nl_string.h and runtime/nl_string.c. */
"#include <stddef.h>\n"
"#include <stdint.h>\n"
"#include <stdbool.h>\n"
"#include <stdlib.h>\n"
"#include <string.h>\n"
"#if defined(__GNUC__) || defined(__clang__)\n"
"#define NBPAYLOAD_INLINE static inline __attribute__((unused))\n"
"#else\n"
"#define NBPAYLOAD_INLINE static inline\n"
"#endif\n"
"extern bool nl_utf8_validate(const char *, size_t, size_t *);\n"
"typedef struct {\n"
"    char *data;         // Raw byte data (may contain nulls)\n"
"    size_t length;      // Byte length (not including null terminator if present)\n"
"    size_t capacity;    // Allocated capacity\n"
"    bool is_utf8;       // True if validated as UTF-8\n"
"    bool null_terminated; // True if data has '\\0' at data[length]\n"
"} nbpayload_t;\n"
"\n"
"/* I share payload destruction with heap-only users without adding a link dependency. */\n"
"static inline void nbpayload_free_owned_storage(nbpayload_t *str) {\n"
"    if (!str) return;\n"
"    free(str->data);\n"
"    free(str);\n"
"}\n"
"\n"
"/* ============================================================================\n"
" * Creation & Destruction\n"
" * ============================================================================ */\n"
"\n"
"/**\n"
" * I copy a NUL-terminated C string into length-aware storage.\n"
" * I leave UTF-8 status unvalidated; call nbpayload_validate_utf8 before\n"
" * querying UTF-8 length or characters.\n"
" */\n"
"NBPAYLOAD_INLINE nbpayload_t* nbpayload_new(const char *cstr);\n"
"\n"
"/**\n"
" * Create string from binary data with explicit length\n"
" * No UTF-8 validation performed.\n"
" */\n"
"NBPAYLOAD_INLINE nbpayload_t* nbpayload_new_binary(const void *data, size_t length);\n"
"\n"
"/**\n"
" * Create string from UTF-8 data with validation\n"
" * Returns NULL if invalid UTF-8.\n"
" */\n"
"NBPAYLOAD_INLINE nbpayload_t* nbpayload_from_utf8(const char *utf8_data, size_t length);\n"
"\n"
"/**\n"
" * Create empty string with given capacity\n"
" */\n"
"NBPAYLOAD_INLINE nbpayload_t* nbpayload_with_capacity(size_t capacity);\n"
"\n"
"/**\n"
" * Free string and its data\n"
" */\n"
"NBPAYLOAD_INLINE void nbpayload_free(nbpayload_t *str);\n"
"\n"
"/* ============================================================================\n"
" * Basic Operations\n"
" * ============================================================================ */\n"
"\n"
"/**\n"
" * Get byte length\n"
" */\n"
"NBPAYLOAD_INLINE size_t nbpayload_length(const nbpayload_t *str);\n"
"\n"
"/**\n"
" * Get byte at index (no bounds checking for performance)\n"
" */\n"
"NBPAYLOAD_INLINE char nbpayload_byte_at(const nbpayload_t *str, size_t index);\n"
"\n"
"/**\n"
" * Get byte at index with bounds checking\n"
" */\n"
"NBPAYLOAD_INLINE bool nbpayload_byte_at_safe(const nbpayload_t *str, size_t index, char *out);\n"
"\n"
"/**\n"
" * Concatenate two strings\n"
" * Returns new string, originals unchanged.\n"
" */\n"
"NBPAYLOAD_INLINE nbpayload_t* nbpayload_concat(const nbpayload_t *a, const nbpayload_t *b);\n"
"\n"
"/**\n"
" * Extract substring [start, start+length)\n"
" * Returns new string.\n"
" */\n"
"NBPAYLOAD_INLINE nbpayload_t* nbpayload_substring(const nbpayload_t *str, size_t start, size_t length);\n"
"\n"
"/**\n"
" * Compare two strings for equality\n"
" */\n"
"NBPAYLOAD_INLINE bool nbpayload_equals(const nbpayload_t *a, const nbpayload_t *b);\n"
"\n"
"/**\n"
" * Compare string with C string\n"
" */\n"
"NBPAYLOAD_INLINE bool nbpayload_equals_cstr(const nbpayload_t *str, const char *cstr);\n"
"\n"
"/* ============================================================================\n"
" * UTF-8 Operations\n"
" * ============================================================================ */\n"
"\n"
"/**\n"
" * Validate UTF-8 encoding\n"
" * Returns true if valid, updates str->is_utf8 flag.\n"
" */\n"
"NBPAYLOAD_INLINE bool nbpayload_validate_utf8(nbpayload_t *str);\n"
"\n"
"/**\n"
" * Get UTF-8 character count (not byte count)\n"
" * Only works if is_utf8 is true.\n"
" * Returns -1 if not UTF-8.\n"
" */\n"
"NBPAYLOAD_INLINE int64_t nbpayload_utf8_length(const nbpayload_t *str);\n"
"\n"
"/**\n"
" * Get UTF-8 codepoint at character index\n"
" * Returns codepoint or -1 on error.\n"
" */\n"
"NBPAYLOAD_INLINE int32_t nbpayload_utf8_char_at(const nbpayload_t *str, size_t char_index);\n"
"\n"
"/**\n"
" * UTF-8 substring by character positions\n"
" */\n"
"NBPAYLOAD_INLINE nbpayload_t* nbpayload_utf8_substring(const nbpayload_t *str, size_t char_start, size_t char_length);\n"
"\n"
"/* ============================================================================\n"
" * Conversion & Interoperability\n"
" * ============================================================================ */\n"
"\n"
"/**\n"
" * Get as null-terminated C string\n"
" * Returns internal buffer if already null-terminated,\n"
" * otherwise creates temporary null-terminated copy.\n"
" * WARNING: Pointer may become invalid after string modification!\n"
" */\n"
"NBPAYLOAD_INLINE const char* nbpayload_to_cstr(nbpayload_t *str);\n"
"\n"
"/**\n"
" * Get raw binary data and length\n"
" */\n"
"NBPAYLOAD_INLINE const void* nbpayload_to_binary(const nbpayload_t *str, size_t *out_length);\n"
"\n"
"/**\n"
" * Ensure string is null-terminated (for FFI)\n"
" * Adds '\\0' at str->data[str->length] if not present.\n"
" */\n"
"NBPAYLOAD_INLINE void nbpayload_ensure_null_terminated(nbpayload_t *str);\n"
"\n"
"/* ============================================================================\n"
" * Memory Management\n"
" * ============================================================================ */\n"
"\n"
"/**\n"
" * Reserve capacity (for efficient concatenation)\n"
" */\n"
"NBPAYLOAD_INLINE void nbpayload_reserve(nbpayload_t *str, size_t new_capacity);\n"
"\n"
"/**\n"
" * Shrink capacity to fit current length\n"
" */\n"
"NBPAYLOAD_INLINE void nbpayload_shrink_to_fit(nbpayload_t *str);\n"
"\n"
"/**\n"
" * Clone string (deep copy)\n"
" */\n"
"NBPAYLOAD_INLINE nbpayload_t* nbpayload_clone(const nbpayload_t *str);\n"
"\n"
"/* ============================================================================\n"
" * UTF-8 Helper Functions\n"
" * ============================================================================ */\n"
"\n"
"/**\n"
" * Get number of bytes in UTF-8 sequence from first byte\n"
" * Returns 0 for invalid lead byte\n"
" */\n"
"NBPAYLOAD_INLINE int nbpayload_sequence_length(unsigned char first_byte) {\n"
"    if ((first_byte & 0x80) == 0) return 1;      // 0xxxxxxx\n"
"    if ((first_byte & 0xE0) == 0xC0) return 2;   // 110xxxxx\n"
"    if ((first_byte & 0xF0) == 0xE0) return 3;   // 1110xxxx\n"
"    if ((first_byte & 0xF8) == 0xF0) return 4;   // 11110xxx\n"
"    return 0; // Invalid\n"
"}\n"
"\n"
"/* ============================================================================\n"
" * Creation & Destruction\n"
" * ============================================================================ */\n"
"\n"
"NBPAYLOAD_INLINE nbpayload_t* nbpayload_new(const char *cstr) {\n"
"    if (!cstr) return NULL;\n"
"    \n"
"    size_t len = strlen(cstr);\n"
"    nbpayload_t *str = malloc(sizeof(nbpayload_t));\n"
"    if (!str) return NULL;\n"
"    \n"
"    str->capacity = len + 1;\n"
"    str->data = malloc(str->capacity);\n"
"    if (!str->data) {\n"
"        free(str);\n"
"        return NULL;\n"
"    }\n"
"    \n"
"    memcpy(str->data, cstr, len);\n"
"    str->data[len] = '\\0';\n"
"    str->length = len;\n"
"    str->null_terminated = true;\n"
"    str->is_utf8 = false; // Will validate on demand\n"
"    \n"
"    return str;\n"
"}\n"
"\n"
"NBPAYLOAD_INLINE nbpayload_t* nbpayload_new_binary(const void *data, size_t length) {\n"
"    if (!data && length > 0) return NULL;\n"
"    \n"
"    nbpayload_t *str = malloc(sizeof(nbpayload_t));\n"
"    if (!str) return NULL;\n"
"    \n"
"    str->capacity = length;\n"
"    str->data = malloc(str->capacity);\n"
"    if (!str->data) {\n"
"        free(str);\n"
"        return NULL;\n"
"    }\n"
"    \n"
"    if (length > 0) {\n"
"        memcpy(str->data, data, length);\n"
"    }\n"
"    str->length = length;\n"
"    str->null_terminated = false;\n"
"    str->is_utf8 = false;\n"
"    \n"
"    return str;\n"
"}\n"
"\n"
"NBPAYLOAD_INLINE nbpayload_t* nbpayload_from_utf8(const char *utf8_data, size_t length) {\n"
"    nbpayload_t *str = nbpayload_new_binary(utf8_data, length);\n"
"    if (!str) return NULL;\n"
"    \n"
"    if (!nbpayload_validate_utf8(str)) {\n"
"        nbpayload_free(str);\n"
"        return NULL;\n"
"    }\n"
"    \n"
"    return str;\n"
"}\n"
"\n"
"NBPAYLOAD_INLINE nbpayload_t* nbpayload_with_capacity(size_t capacity) {\n"
"    nbpayload_t *str = malloc(sizeof(nbpayload_t));\n"
"    if (!str) return NULL;\n"
"    \n"
"    str->capacity = capacity;\n"
"    str->data = malloc(capacity);\n"
"    if (!str->data) {\n"
"        free(str);\n"
"        return NULL;\n"
"    }\n"
"    \n"
"    str->length = 0;\n"
"    str->null_terminated = false;\n"
"    str->is_utf8 = true; // Empty string is valid UTF-8\n"
"    \n"
"    return str;\n"
"}\n"
"\n"
"NBPAYLOAD_INLINE void nbpayload_free(nbpayload_t *str) {\n"
"    nbpayload_free_owned_storage(str);\n"
"}\n"
"\n"
"/* ============================================================================\n"
" * Basic Operations\n"
" * ============================================================================ */\n"
"\n"
"NBPAYLOAD_INLINE size_t nbpayload_length(const nbpayload_t *str) {\n"
"    return str ? str->length : 0;\n"
"}\n"
"\n"
"NBPAYLOAD_INLINE char nbpayload_byte_at(const nbpayload_t *str, size_t index) {\n"
"    return str->data[index];\n"
"}\n"
"\n"
"NBPAYLOAD_INLINE bool nbpayload_byte_at_safe(const nbpayload_t *str, size_t index, char *out) {\n"
"    if (!str || index >= str->length || !out) return false;\n"
"    *out = str->data[index];\n"
"    return true;\n"
"}\n"
"\n"
"NBPAYLOAD_INLINE nbpayload_t* nbpayload_concat(const nbpayload_t *a, const nbpayload_t *b) {\n"
"    if (!a || !b) return NULL;\n"
"    \n"
"    size_t new_len = a->length + b->length;\n"
"    nbpayload_t *result = nbpayload_with_capacity(new_len + 1);\n"
"    if (!result) return NULL;\n"
"    \n"
"    memcpy(result->data, a->data, a->length);\n"
"    memcpy(result->data + a->length, b->data, b->length);\n"
"    result->data[new_len] = '\\0';\n"
"    result->length = new_len;\n"
"    result->null_terminated = true;\n"
"    result->is_utf8 = a->is_utf8 && b->is_utf8;\n"
"    \n"
"    return result;\n"
"}\n"
"\n"
"NBPAYLOAD_INLINE nbpayload_t* nbpayload_substring(const nbpayload_t *str, size_t start, size_t length) {\n"
"    if (!str || start >= str->length) {\n"
"        return nbpayload_with_capacity(0);\n"
"    }\n"
"    \n"
"    if (length > str->length - start) {\n"
"        length = str->length - start;\n"
"    }\n"
"    \n"
"    nbpayload_t *result = nbpayload_new_binary(str->data + start, length);\n"
"    if (result && str->is_utf8) {\n"
"        // Substring of UTF-8 string may not be valid UTF-8 if split mid-character\n"
"        nbpayload_validate_utf8(result);\n"
"    }\n"
"    \n"
"    return result;\n"
"}\n"
"\n"
"NBPAYLOAD_INLINE bool nbpayload_equals(const nbpayload_t *a, const nbpayload_t *b) {\n"
"    if (!a || !b) return a == b;\n"
"    if (a->length != b->length) return false;\n"
"    return memcmp(a->data, b->data, a->length) == 0;\n"
"}\n"
"\n"
"NBPAYLOAD_INLINE bool nbpayload_equals_cstr(const nbpayload_t *str, const char *cstr) {\n"
"    if (!str || !cstr) return false;\n"
"    size_t cstr_len = strlen(cstr);\n"
"    if (str->length != cstr_len) return false;\n"
"    return memcmp(str->data, cstr, cstr_len) == 0;\n"
"}\n"
"\n"
"/* ============================================================================\n"
" * UTF-8 Operations\n"
" * ============================================================================ */\n"
"\n"
"NBPAYLOAD_INLINE bool nbpayload_validate_utf8(nbpayload_t *str) {\n"
"    if (!str) return false;\n"
"    if (!nl_utf8_validate(str->data, str->length, NULL)) {\n"
"        str->is_utf8 = false;\n"
"        return false;\n"
"    }\n"
"    str->is_utf8 = true;\n"
"    return true;\n"
"}\n"
"\n"
"NBPAYLOAD_INLINE int64_t nbpayload_utf8_length(const nbpayload_t *str) {\n"
"    if (!str) return -1;\n"
"    if (!str->is_utf8) return -1;\n"
"    \n"
"    int64_t count = 0;\n"
"    size_t i = 0;\n"
"    \n"
"    while (i < str->length) {\n"
"        int seq_len = nbpayload_sequence_length(str->data[i]);\n"
"        if (seq_len == 0) return -1; // Shouldn't happen if validated\n"
"        i += seq_len;\n"
"        count++;\n"
"    }\n"
"    \n"
"    return count;\n"
"}\n"
"\n"
"NBPAYLOAD_INLINE int32_t nbpayload_utf8_char_at(const nbpayload_t *str, size_t char_index) {\n"
"    if (!str || !str->is_utf8) return -1;\n"
"    \n"
"    size_t current_char = 0;\n"
"    size_t i = 0;\n"
"    \n"
"    while (i < str->length) {\n"
"        if (current_char == char_index) {\n"
"            // Decode UTF-8 codepoint\n"
"            unsigned char byte = str->data[i];\n"
"            int seq_len = nbpayload_sequence_length(byte);\n"
"            \n"
"            if (seq_len == 1) {\n"
"                return byte;\n"
"            } else if (seq_len == 2) {\n"
"                return ((byte & 0x1F) << 6) | (str->data[i+1] & 0x3F);\n"
"            } else if (seq_len == 3) {\n"
"                return ((byte & 0x0F) << 12) | \n"
"                       ((str->data[i+1] & 0x3F) << 6) |\n"
"                       (str->data[i+2] & 0x3F);\n"
"            } else if (seq_len == 4) {\n"
"                return ((byte & 0x07) << 18) |\n"
"                       ((str->data[i+1] & 0x3F) << 12) |\n"
"                       ((str->data[i+2] & 0x3F) << 6) |\n"
"                       (str->data[i+3] & 0x3F);\n"
"            }\n"
"        }\n"
"        \n"
"        int seq_len = nbpayload_sequence_length(str->data[i]);\n"
"        i += seq_len;\n"
"        current_char++;\n"
"    }\n"
"    \n"
"    return -1; // Index out of range\n"
"}\n"
"\n"
"NBPAYLOAD_INLINE nbpayload_t* nbpayload_utf8_substring(const nbpayload_t *str, size_t char_start, size_t char_length) {\n"
"    if (!str || !str->is_utf8) return NULL;\n"
"    \n"
"    // Find byte positions for character positions\n"
"    size_t byte_start = 0;\n"
"    size_t byte_end = 0;\n"
"    size_t current_char = 0;\n"
"    size_t i = 0;\n"
"    bool found_start = false;\n"
"    \n"
"    while (i < str->length && current_char <= char_start + char_length) {\n"
"        if (current_char == char_start) {\n"
"            byte_start = i;\n"
"            found_start = true;\n"
"        }\n"
"        if (current_char == char_start + char_length) {\n"
"            byte_end = i;\n"
"            break;\n"
"        }\n"
"        \n"
"        int seq_len = nbpayload_sequence_length(str->data[i]);\n"
"        i += seq_len;\n"
"        current_char++;\n"
"    }\n"
"    \n"
"    if (!found_start) return nbpayload_with_capacity(0);\n"
"    if (byte_end == 0) byte_end = str->length;\n"
"    \n"
"    return nbpayload_substring(str, byte_start, byte_end - byte_start);\n"
"}\n"
"\n"
"/* ============================================================================\n"
" * Conversion & Interoperability\n"
" * ============================================================================ */\n"
"\n"
"NBPAYLOAD_INLINE const char* nbpayload_to_cstr(nbpayload_t *str) {\n"
"    if (!str) return \"\";\n"
"    \n"
"    if (!str->null_terminated) {\n"
"        nbpayload_ensure_null_terminated(str);\n"
"    }\n"
"    \n"
"    return str->data;\n"
"}\n"
"\n"
"NBPAYLOAD_INLINE const void* nbpayload_to_binary(const nbpayload_t *str, size_t *out_length) {\n"
"    if (!str) {\n"
"        if (out_length) *out_length = 0;\n"
"        return NULL;\n"
"    }\n"
"    \n"
"    if (out_length) *out_length = str->length;\n"
"    return str->data;\n"
"}\n"
"\n"
"NBPAYLOAD_INLINE void nbpayload_ensure_null_terminated(nbpayload_t *str) {\n"
"    if (!str || str->null_terminated) return;\n"
"    \n"
"    if (str->length >= str->capacity) {\n"
"        // Need to reallocate\n"
"        size_t new_capacity = str->length + 1;\n"
"        char *new_data = realloc(str->data, new_capacity);\n"
"        if (!new_data) return; // Can't allocate, leave unchanged\n"
"        str->data = new_data;\n"
"        str->capacity = new_capacity;\n"
"    }\n"
"    \n"
"    str->data[str->length] = '\\0';\n"
"    str->null_terminated = true;\n"
"}\n"
"\n"
"/* ============================================================================\n"
" * Memory Management\n"
" * ============================================================================ */\n"
"\n"
"NBPAYLOAD_INLINE void nbpayload_reserve(nbpayload_t *str, size_t new_capacity) {\n"
"    if (!str || new_capacity <= str->capacity) return;\n"
"    \n"
"    char *new_data = realloc(str->data, new_capacity);\n"
"    if (!new_data) return;\n"
"    \n"
"    str->data = new_data;\n"
"    str->capacity = new_capacity;\n"
"}\n"
"\n"
"NBPAYLOAD_INLINE void nbpayload_shrink_to_fit(nbpayload_t *str) {\n"
"    if (!str || str->capacity == str->length) return;\n"
"    \n"
"    size_t new_capacity = str->length + (str->null_terminated ? 1 : 0);\n"
"    char *new_data = realloc(str->data, new_capacity);\n"
"    if (!new_data) return;\n"
"    \n"
"    str->data = new_data;\n"
"    str->capacity = new_capacity;\n"
"}\n"
"\n"
"NBPAYLOAD_INLINE nbpayload_t* nbpayload_clone(const nbpayload_t *str) {\n"
"    if (!str) return NULL;\n"
"    \n"
"    nbpayload_t *clone = malloc(sizeof(nbpayload_t));\n"
"    if (!clone) return NULL;\n"
"    \n"
"    clone->capacity = str->capacity;\n"
"    clone->data = malloc(clone->capacity);\n"
"    if (!clone->data) {\n"
"        free(clone);\n"
"        return NULL;\n"
"    }\n"
"    \n"
"    memcpy(clone->data, str->data, str->length);\n"
"    if (str->null_terminated) {\n"
"        clone->data[str->length] = '\\0';\n"
"    }\n"
"    \n"
"    clone->length = str->length;\n"
"    clone->is_utf8 = str->is_utf8;\n"
"    clone->null_terminated = str->null_terminated;\n"
"\n"
"    return clone;\n"
"}\n"
"#undef NBPAYLOAD_INLINE\n"
