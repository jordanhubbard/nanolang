/* I keep this runtime as C source text so AOT output remains self-contained.
 * Set inputs are borrowed. Successful get results own their copied text and
 * must be released. Missing gets return a void value (kind zero).
 * I retain exact INT/STRING key tags; I never stringify integer keys. */
"/* I count retained owned map storage, including API copies until release.\n"
" * Bucket growth charges net capacity; temporary old/new overlap and allocator\n"
" * overhead are not counted, so this is neither instantaneous allocation nor RSS. */\n"
"static size_t nmap_live_bytes, nmap_peak_bytes, nmap_allocation_debt;\n"
"static void nmap_bytes_add(size_t bytes) {\n"
"    if (bytes > SIZE_MAX - nmap_live_bytes || bytes > SIZE_MAX - nmap_allocation_debt) NVM2C_ABORT();\n"
"    nmap_live_bytes += bytes; nmap_allocation_debt += bytes;\n"
"    if (nmap_live_bytes > nmap_peak_bytes) nmap_peak_bytes = nmap_live_bytes;\n"
"}\n"
"static void nmap_bytes_drop(size_t bytes) {\n"
"    if (bytes > nmap_live_bytes) NVM2C_ABORT();\n"
"    nmap_live_bytes -= bytes;\n"
"}\n"
"static size_t nmap_text_bytes(const char *text) {\n"
"    if (!text) NVM2C_ABORT();\n"
"    size_t n = strlen(text); if (n == SIZE_MAX) NVM2C_ABORT(); return n + 1;\n"
"}\n"
"static void nmap_release_text(char *text) {\n"
"    nmap_bytes_drop(nmap_text_bytes(text)); free(text);\n"
"}\n"
"typedef struct { uint8_t kind; int64_t integer; char *text; } nmap_value;\n"
"typedef union { char *text; int64_t integer; } nmap_key;\n"
"typedef struct nmap_entry { uint64_t hash; nmap_key key; nmap_value value; struct nmap_entry *next; } nmap_entry;\n"
"typedef struct nmap_s { nmap_entry **buckets; size_t capacity, count; uint8_t value_kind, key_kind; } nmap_s;\n"
"typedef nmap_s *nmap_t;\n"
"static char *nmap_copy_text(const char *text) {\n"
"    if (!text) NVM2C_ABORT();\n"
"    size_t n = strlen(text); if (n == SIZE_MAX) NVM2C_ABORT();\n"
"    char *copy = malloc(n + 1); if (!copy) NVM2C_ABORT();\n"
"    nmap_bytes_add(n + 1); memcpy(copy, text, n + 1); return copy;\n"
"}\n"
"static nmap_value nmap_copy_value(nmap_value value) {\n"
"    if (value.kind == 5) value.text = nmap_copy_text(value.text);\n"
"    else if (value.kind == 1) value.text = NULL;\n"
"    else NVM2C_ABORT();\n"
"    return value;\n"
"}\n"
"static void nmap_release_value(nmap_value value) { if (value.kind == 5) nmap_release_text(value.text); }\n"
"static uint64_t nmap_hash(const char *key) {\n"
"    if (!key) NVM2C_ABORT();\n"
"    uint64_t h = UINT64_C(14695981039346656037);\n"
"    for (const unsigned char *p = (const unsigned char *)key; *p; ++p) {\n"
"        h ^= *p; h *= UINT64_C(1099511628211);\n"
"    } return h;\n"
"}\n"
"static nmap_t nmap_new_pair(uint8_t key_kind, uint8_t value_kind) {\n"
"    if ((key_kind != 1 && key_kind != 5) || (value_kind != 1 && value_kind != 5)) NVM2C_ABORT();\n"
"    nmap_t map = calloc(1, sizeof *map); if (!map) NVM2C_ABORT();\n"
"    map->capacity = 16; map->value_kind = value_kind; map->key_kind = key_kind;\n"
"    map->buckets = calloc(map->capacity, sizeof *map->buckets);\n"
"    if (!map->buckets) { free(map); NVM2C_ABORT(); }\n"
"    nmap_bytes_add(sizeof *map + map->capacity * sizeof *map->buckets);\n"
"    return map;\n"
"}\n"
"static nmap_t nmap_new(uint8_t value_kind) { return nmap_new_pair(5, value_kind); }\n"
"static uint64_t nmap_key_hash(nmap_value key) {\n"
"    if (key.kind == 5) return nmap_hash(key.text);\n"
"    if (key.kind != 1) NVM2C_ABORT();\n"
"    uint64_t bits = (uint64_t)key.integer;\n"
"    bits ^= bits >> 30; bits *= UINT64_C(0xbf58476d1ce4e5b9);\n"
"    bits ^= bits >> 27; bits *= UINT64_C(0x94d049bb133111eb);\n"
"    return bits ^ (bits >> 31);\n"
"}\n"
"static inline uint8_t nmap_key_kind(nmap_t map) {\n"
"    if (!map || (map->key_kind != 1 && map->key_kind != 5)) NVM2C_ABORT();\n"
"    return map->key_kind;\n"
"}\n"
"static void nmap_require_key(nmap_t map, nmap_value key) {\n"
"    if (!map || (key.kind != 1 && key.kind != 5) || key.kind != nmap_key_kind(map) ||\n"
"        (key.kind == 5 && !key.text)) NVM2C_ABORT();\n"
"}\n"
"static int nmap_key_equal(nmap_t map, nmap_entry *entry, nmap_value key) {\n"
"    return map->key_kind == 1 ? entry->key.integer == key.integer : strcmp(entry->key.text, key.text) == 0;\n"
"}\n"
"static nmap_entry *nmap_find_key(nmap_t map, nmap_value key, uint64_t hash) {\n"
"    nmap_require_key(map, key);\n"
"    for (nmap_entry *entry = map->buckets[hash & (map->capacity - 1)]; entry; entry = entry->next)\n"
"        if (entry->hash == hash && nmap_key_equal(map, entry, key)) return entry;\n"
"    return NULL;\n"
"}\n"
"static void nmap_grow(nmap_t map) {\n"
"    if (map->capacity > SIZE_MAX / 2 / sizeof *map->buckets) NVM2C_ABORT();\n"
"    size_t capacity = map->capacity * 2;\n"
"    nmap_entry **buckets = calloc(capacity, sizeof *buckets); if (!buckets) NVM2C_ABORT();\n"
"    for (size_t i = 0; i < map->capacity; ++i) {\n"
"        nmap_entry *entry = map->buckets[i];\n"
"        while (entry) { nmap_entry *next = entry->next;\n"
"            size_t at = entry->hash & (capacity - 1);\n"
"            entry->next = buckets[at]; buckets[at] = entry; entry = next; }\n"
"    }\n"
"    nmap_bytes_add((capacity - map->capacity) * sizeof *buckets);\n"
"    free(map->buckets); map->buckets = buckets; map->capacity = capacity;\n"
"}\n"
"static nmap_t nmap_set_key(nmap_t map, nmap_value key, nmap_value value) {\n"
"    nmap_require_key(map, key);\n"
"    if (value.kind != map->value_kind) NVM2C_ABORT();\n"
"    uint64_t hash = nmap_key_hash(key); nmap_entry *entry = nmap_find_key(map, key, hash);\n"
"    nmap_value owned = nmap_copy_value(value);\n"
"    if (entry) { nmap_release_value(entry->value); entry->value = owned; return map; }\n"
"    char *owned_key = key.kind == 5 ? nmap_copy_text(key.text) : NULL;\n"
"    entry = malloc(sizeof *entry);\n"
"    if (!entry) { if (owned_key) nmap_release_text(owned_key); nmap_release_value(owned); NVM2C_ABORT(); }\n"
"    nmap_bytes_add(sizeof *entry);\n"
"    if (map->count >= map->capacity / 2) nmap_grow(map);\n"
"    size_t at = hash & (map->capacity - 1);\n"
"    *entry = (nmap_entry){0}; entry->hash = hash; entry->value = owned; entry->next = map->buckets[at];\n"
"    if (key.kind == 5) entry->key.text = owned_key; else entry->key.integer = key.integer;\n"
"    map->buckets[at] = entry; ++map->count; return map;\n"
"}\n"
"static int nmap_has_key(nmap_t map, nmap_value key) { return nmap_find_key(map, key, nmap_key_hash(key)) != NULL; }\n"
"static nmap_value nmap_get_key(nmap_t map, nmap_value key) {\n"
"    nmap_entry *entry = nmap_find_key(map, key, nmap_key_hash(key));\n"
"    return entry ? nmap_copy_value(entry->value) : (nmap_value){0};\n"
"}\n"
"static nmap_t nmap_set(nmap_t map, const char *key, nmap_value value) { return nmap_set_key(map, (nmap_value){5, 0, (char *)key}, value); }\n"
"static int nmap_has(nmap_t map, const char *key) { return nmap_has_key(map, (nmap_value){5, 0, (char *)key}); }\n"
"static nmap_value nmap_get(nmap_t map, const char *key) { return nmap_get_key(map, (nmap_value){5, 0, (char *)key}); }\n"
"static size_t nmap_len(nmap_t map) { if (!map) NVM2C_ABORT(); return map->count; }\n"
"static nmap_t nmap_delete_key(nmap_t map, nmap_value key) {\n"
"    nmap_require_key(map, key);\n"
"    uint64_t hash = nmap_key_hash(key);\n"
"    nmap_entry **link = &map->buckets[hash & (map->capacity - 1)];\n"
"    while (*link) { nmap_entry *entry = *link;\n"
"        if (entry->hash == hash && nmap_key_equal(map, entry, key)) {\n"
"            *link = entry->next; if (map->key_kind == 5) nmap_release_text(entry->key.text); nmap_release_value(entry->value);\n"
"            nmap_bytes_drop(sizeof *entry); free(entry); --map->count; break; }\n"
"        link = &entry->next;\n"
"    } return map;\n"
"}\n"
"static nmap_t nmap_delete(nmap_t map, const char *key) { return nmap_delete_key(map, (nmap_value){5, 0, (char *)key}); }\n"
"static void nmap_destroy(nmap_t map) {\n"
"    if (!map) return;\n"
"    for (size_t i = 0; i < map->capacity; ++i) {\n"
"        nmap_entry *entry = map->buckets[i];\n"
"        while (entry) { nmap_entry *next = entry->next; if (map->key_kind == 5) nmap_release_text(entry->key.text);\n"
"            nmap_release_value(entry->value); nmap_bytes_drop(sizeof *entry); free(entry); entry = next; }\n"
"    } nmap_bytes_drop(sizeof *map + map->capacity * sizeof *map->buckets);\n"
"    free(map->buckets); free(map);\n"
"}\n"
