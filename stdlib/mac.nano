# MAC Task Ledger Module
# Provides programmatic access to the MAC hub task ledger via the `mac` CLI.
# Enables creating, querying, and managing tasks from NanoLang code.
#
# This is the successor to the old beads module: NanoLang tracks work in the
# MAC hub task ledger (`mac task`), not bd/beads.
#
# JSON parsing is provided by the modules/std/json module (cJSON-backed).
# See: modules/std/json/json.nano
from "modules/std/json/json.nano" import parse as json_parse, free as json_free,
    is_array as json_is_array, is_null as json_is_null,
    array_size as json_array_size, get_index as json_get_index,
    get as json_get,
    get_string as json_get_string, get_int as json_get_int,
    object_has as json_object_has, as_string as json_as_string, Json

# C FFI: run command capturing stdout; run command returning exit code
extern fn nl_exec_capture(cmd: string) -> string
extern fn nl_exec_shell(cmd: string) -> int

struct CommandResult {
    stdout: string,
    stderr: string,
    exit_code: int
}

# Run a shell command, capturing stdout and exit code
fn exec_command(command: string) -> CommandResult {
    let out: string = (nl_exec_capture command)
    let code: int = (nl_exec_shell command)
    return CommandResult {
        stdout: out,
        stderr: "",
        exit_code: code
    }
}

shadow exec_command {
    let result: CommandResult = (exec_command "echo test")
    assert (>= result.exit_code 0)
}

# JSON parsing is handled by the imported std_json module (Json type + helpers above).

# Core Task structure matching `mac task ... --json` output.
# The MAC task model fields are: id, title, description, project, priority (int),
# state, created_at, updated_at. States are: open, waiting, blocked, claimed,
# running, needs_review, needs_input, stopped, reviewing, completed, failed,
# cancelled. Priority is an integer (lower = more urgent on this hub).
struct Task {
    id: string,
    title: string,
    description: string,
    state: string,            # open, claimed, running, completed, cancelled, ...
    priority: int,            # integer priority
    project: string,
    created_at: string,
    updated_at: string
}

struct TaskStats {
    total: int,
    open: int,
    claimed: int,
    running: int,
    blocked: int,
    completed: int,
    cancelled: int
}

struct TaskCreateOptions {
    title: string,
    description: string,
    priority: int,
    kind: string              # "code" (default) or "report"
}

# === Core Functions ===

# List tasks with optional state filter (e.g. "open", "running", "" for active).
fn mac_list(state: string) -> array<Task> {
    let mut cmd: string = "mac task list --json --all-states"

    if (!= state "") {
        set cmd (+ cmd (+ " --state=" state))
    }

    let result: CommandResult = (exec_command cmd)

    if (!= result.exit_code 0) {
        (println (+ "Error running mac task list: " result.stderr))
        return []
    }

    # Parse JSON output
    let json_val: Json = (json_parse result.stdout)
    let tasks: array<Task> = (tasks_from_json json_val)
    (json_free json_val)
    return tasks
}

shadow mac_list {
    let tasks: array<Task> = (mac_list "")
    assert (>= (array_length tasks) 0)
}

# Get all open tasks
fn mac_open() -> array<Task> {
    return (mac_list "open")
}

shadow mac_open {
    let tasks: array<Task> = (mac_open)
    assert (>= (array_length tasks) 0)
}

# Get all task-ready work (`mac task ready`)
fn mac_ready() -> array<Task> {
    let result: CommandResult = (exec_command "mac task ready --json")

    if (!= result.exit_code 0) {
        return []
    }

    let json_val: Json = (json_parse result.stdout)
    let tasks: array<Task> = (tasks_from_json json_val)
    (json_free json_val)
    return tasks
}

shadow mac_ready {
    let tasks: array<Task> = (mac_ready)
    assert (>= (array_length tasks) 0)
}

# Get tasks at (or filtered to) a given integer priority via the selector.
fn mac_by_priority(priority: int) -> array<Task> {
    let mut cmd: string = "mac task list --json --all-states --selector priority="
    set cmd (+ cmd (int_to_string priority))

    let result: CommandResult = (exec_command cmd)

    if (!= result.exit_code 0) {
        return []
    }

    let json_val: Json = (json_parse result.stdout)
    let tasks: array<Task> = (tasks_from_json json_val)
    (json_free json_val)
    return tasks
}

shadow mac_by_priority {
    let tasks: array<Task> = (mac_by_priority 0)
    assert (>= (array_length tasks) 0)
}

# Show a specific task by ID (`mac task show <id> --json`).
fn mac_show(id: string) -> Task {
    let cmd: string = (+ "mac task show --json " id)
    let result: CommandResult = (exec_command cmd)

    if (!= result.exit_code 0) {
        (println (+ "Error showing task: " result.stderr))
        return (task_empty)
    }

    let json_val: Json = (json_parse result.stdout)
    let task: Task = (task_from_json json_val)
    (json_free json_val)
    return task
}

shadow mac_show {
    let task: Task = (mac_show "does-not-exist")
    # Returns empty task if mac is unavailable or the id is unknown
    assert (>= (str_length task.id) 0)
}

# Create a new task. Returns the new task id (or "" on failure).
fn mac_create(title: string, description: string, priority: int, kind: string) -> string {
    let mut cmd: string = "mac task create"
    set cmd (+ cmd (+ " \"" (+ title "\"")))
    set cmd (+ cmd (+ " --description=\"" (+ description "\"")))
    set cmd (+ cmd (+ " --priority=" (int_to_string priority)))
    if (!= kind "") {
        set cmd (+ cmd (+ " --kind=" kind))
    }

    let result: CommandResult = (exec_command cmd)

    if (!= result.exit_code 0) {
        (println (+ "Error creating task: " result.stderr))
        return ""
    }

    return (extract_task_id result.stdout)
}

shadow mac_create {
    # Structure only — won't actually create without an authenticated mac CLI.
    let id: string = (mac_create "Test" "Description" 4 "report")
    # Returns empty string if mac is unavailable
    assert (>= (str_length id) 0)
}

# Create a task with full options
fn mac_create_with_options(opts: TaskCreateOptions) -> string {
    return (mac_create opts.title opts.description opts.priority opts.kind)
}

shadow mac_create_with_options {
    let opts: TaskCreateOptions = TaskCreateOptions {
        title: "Test",
        description: "Test",
        priority: 4,
        kind: "report"
    }
    let id: string = (mac_create_with_options opts)
    assert (>= (str_length id) 0)
}

# Close a task. `mac task close` completes by default; cancellation needs a reason.
fn mac_close(id: string, reason: string) -> bool {
    let mut cmd: string = (+ "mac task close " id)

    if (!= reason "") {
        set cmd (+ cmd (+ " --reason=\"" (+ reason "\"")))
    }

    let result: CommandResult = (exec_command cmd)
    return (== result.exit_code 0)
}

shadow mac_close {
    let success: bool = (mac_close "does-not-exist" "test reason")
    # Returns false if mac is unavailable
    assert (or (== success true) (== success false))
}

# Get statistics by counting tasks per state (portable across mac versions).
fn mac_stats() -> TaskStats {
    let all: array<Task> = (mac_list "")
    let mut open: int = 0
    let mut claimed: int = 0
    let mut running: int = 0
    let mut blocked: int = 0
    let mut completed: int = 0
    let mut cancelled: int = 0

    let mut i: int = 0
    while (< i (array_length all)) {
        let t: Task = (at all i)
        if (== t.state "open") { set open (+ open 1) } else {
            if (== t.state "claimed") { set claimed (+ claimed 1) } else {
                if (== t.state "running") { set running (+ running 1) } else {
                    if (== t.state "blocked") { set blocked (+ blocked 1) } else {
                        if (== t.state "completed") { set completed (+ completed 1) } else {
                            if (== t.state "cancelled") { set cancelled (+ cancelled 1) } else {}
                        }
                    }
                }
            }
        }
        set i (+ i 1)
    }

    return TaskStats {
        total: (array_length all),
        open: open,
        claimed: claimed,
        running: running,
        blocked: blocked,
        completed: completed,
        cancelled: cancelled
    }
}

shadow mac_stats {
    let stats: TaskStats = (mac_stats)
    assert (>= stats.total 0)
}

# === Helper Functions ===

fn task_empty() -> Task {
    return Task {
        id: "",
        title: "",
        description: "",
        state: "",
        priority: 0,
        project: "",
        created_at: "",
        updated_at: ""
    }
}

fn task_stats_empty() -> TaskStats {
    return TaskStats {
        total: 0,
        open: 0,
        claimed: 0,
        running: 0,
        blocked: 0,
        completed: 0,
        cancelled: 0
    }
}

# Build a single Task from a JSON object (falling back to empty fields).
fn task_from_json_obj(item: Json) -> Task {
    let id: string       = (json_get_string item "id")
    let title: string    = (json_get_string item "title")
    let desc: string     = (json_get_string item "description")
    let state: string    = (json_get_string item "state")
    let project: string  = (json_get_string item "project")
    let created: string  = (json_get_string item "created_at")
    let updated: string  = (json_get_string item "updated_at")
    let priority: int    = (json_get_int item "priority")

    return Task {
        id: id,
        title: title,
        description: desc,
        state: state,
        priority: priority,
        project: project,
        created_at: created,
        updated_at: updated
    }
}

# Parse a single task object (from `mac task show --json`).
fn task_from_json(json_val: Json) -> Task {
    if (json_is_null json_val) {
        return (task_empty)
    }
    if (json_is_array json_val) {
        # If show returned an array, take the first element.
        if (> (json_array_size json_val) 0) {
            let item: Json = (json_get_index json_val 0)
            let t: Task = (task_from_json_obj item)
            (json_free item)
            return t
        }
        return (task_empty)
    }
    return (task_from_json_obj json_val)
}

shadow task_from_json {
    let obj: Json = (json_parse "{\"id\":\"task_abc\",\"title\":\"Hi\",\"description\":\"\",\"state\":\"open\",\"priority\":2,\"project\":\"nanolang\",\"created_at\":\"\",\"updated_at\":\"\"}")
    let t: Task = (task_from_json obj)
    assert (== t.id "task_abc")
    assert (== t.title "Hi")
    assert (== t.priority 2)
    assert (== t.state "open")
    (json_free obj)

    let nul: Json = (json_parse "null")
    let empty: Task = (task_from_json nul)
    assert (== empty.id "")
    (json_free nul)
}

# Parse an array of task objects (from `mac task list --json`).
fn tasks_from_json(json_val: Json) -> array<Task> {
    # Guard: top-level value must be a non-null JSON array
    if (json_is_null json_val) {
        return []
    }
    if (!= (json_is_array json_val) true) {
        return []
    }

    let count: int = (json_array_size json_val)
    let mut result: array<Task> = []

    let mut i: int = 0
    while (< i count) {
        let item: Json = (json_get_index json_val i)

        # Skip null or non-object entries
        if (!= (json_is_null item) true) {
            let task: Task = (task_from_json_obj item)
            set result (array_push result task)
        }

        (json_free item)

        set i (+ i 1)
    }

    return result
}

shadow tasks_from_json {
    # Empty JSON array -> empty Task array
    let json: Json = (json_parse "[]")
    let tasks: array<Task> = (tasks_from_json json)
    assert (== (array_length tasks) 0)
    (json_free json)

    # Non-array JSON -> empty Task array (guard path)
    let obj: Json = (json_parse "{}")
    let tasks2: array<Task> = (tasks_from_json obj)
    assert (== (array_length tasks2) 0)
    (json_free obj)

    # Minimal well-formed task entry
    let arr_json: Json = (json_parse "[{\"id\":\"task_001\",\"title\":\"Test task\",\"description\":\"\",\"state\":\"open\",\"priority\":3,\"project\":\"nanolang\",\"created_at\":\"\",\"updated_at\":\"\"}]")
    let tasks3: array<Task> = (tasks_from_json arr_json)
    assert (== (array_length tasks3) 1)
    let t: Task = (at tasks3 0)
    assert (== t.id "task_001")
    assert (== t.title "Test task")
    assert (== t.priority 3)
    (json_free arr_json)
}

# Extract the task ID from `mac task create` output.
#
# mac prints the new task id on creation (canonical ids look like
# "task_<hex>"). Strategy: split output into lines, scan for a token that looks
# like a task id ("task_..." or a bare hex id), and return the first match.
fn extract_task_id(output: string) -> string {
    let lines: array<string> = (str_split output "\n")
    let n: int = (array_length lines)
    let mut i: int = 0
    while (< i n) {
        let line: string = (at lines i)
        let words: array<string> = (str_split line " ")
        let wn: int = (array_length words)
        let mut w: int = 0
        while (< w wn) {
            let word: string = (str_trim (at words w))
            if (str_starts_with word "task_") {
                return word
            } else {}
            set w (+ w 1)
        }
        set i (+ i 1)
    }
    return ""
}

shadow extract_task_id {
    # Plain "task_<hex>" token on its own line
    assert (str_equals (extract_task_id "task_abc123") "task_abc123")

    # Full creation line
    assert (str_equals (extract_task_id "Created task task_deadbeef in project nanolang") "task_deadbeef")

    # Multi-line output — should pick the first task_ token
    assert (str_equals (extract_task_id "Filing...\nCreated task_cafe01\nDone.") "task_cafe01")

    # No task id present — must return empty string
    assert (str_equals (extract_task_id "missing bearer token") "")

    # Empty input
    assert (str_equals (extract_task_id "") "")
}

# === assert_with_task ===
# Automatically file a MAC task from a failing assertion.

fn assert_with_task(condition: bool, title: string, priority: int, description: string) -> bool {
    if (not condition) {
        # File a task for this failing assertion
        let task_id: string = (mac_create title description priority "report")

        (println (+ "Assertion failed - filed task: " task_id))
        (println (+ "  Title: " title))
        (println (+ "  Priority: P" (int_to_string priority)))
    }

    return condition
}

# Enhanced version that auto-captures context
fn assert_with_task_context(
    condition: bool,
    title: string,
    priority: int,
    file: string,
    line: int,
    context: string
) -> bool {
    if (not condition) {
        let mut desc: string = (+ "Assertion failed at " file)
        set desc (+ desc (+ ":" (int_to_string line)))
        set desc (+ desc (+ "\n\nContext:\n" context))

        let task_id: string = (mac_create title desc priority "report")

        (println (+ "Assertion failed - filed task: " task_id))
        (println (+ "   Location: " (+ file (+ ":" (int_to_string line)))))
        (println (+ "   Priority: P" (int_to_string priority)))
    }

    return condition
}

shadow assert_with_task_context {
    # Test that true conditions don't file tasks
    let result: bool = (assert_with_task_context true "Test" 4 "test.nano" 1 "context")
    assert (== result true)

    # Test that false conditions return false
    let result2: bool = (assert_with_task_context false "Test" 4 "test.nano" 1 "context")
    assert (== result2 false)
}

# === Shadow Tests ===

shadow task_empty {
    let empty: Task = (task_empty)
    assert (== empty.id "")
    assert (== empty.priority 0)
    assert (== empty.state "")
}

shadow task_stats_empty {
    let stats: TaskStats = (task_stats_empty)
    assert (== stats.total 0)
    assert (== stats.open 0)
    assert (== stats.completed 0)
}

shadow task_from_json_obj {
    let obj: Json = (json_parse "{\"id\":\"task_x\",\"title\":\"T\",\"description\":\"d\",\"state\":\"running\",\"priority\":1,\"project\":\"p\",\"created_at\":\"c\",\"updated_at\":\"u\"}")
    let t: Task = (task_from_json_obj obj)
    assert (== t.id "task_x")
    assert (== t.state "running")
    assert (== t.priority 1)
    (json_free obj)
}

shadow assert_with_task {
    # Test that true conditions don't file tasks
    let result: bool = (assert_with_task true "Should not file" 0 "Test")
    assert (== result true)

    # Test that false conditions return false
    # (Note: This will actually file a task if mac is authenticated)
    let result2: bool = (assert_with_task false "Test assertion" 4 "Testing task creation")
    assert (== result2 false)
}
