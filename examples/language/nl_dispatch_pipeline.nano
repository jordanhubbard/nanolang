# Example: Dispatch Pipeline
# Purpose: Demonstrate fan-out and fan-in with dispatch queues
# Features: dispatch module, queue_async, group_wait, shadow tests
# Difficulty: Advanced
# Category: language
# Prerequisites: nl_dispatch_counter
# Track: modules
# Build: external-deps
# Dependencies: modules/dispatch, libdispatch
# Tags: concurrency, native-only
# Expected Output: SKIP: libdispatch is not available on this platform

/* nl_dispatch_pipeline.nano
 * Demonstrates queue_async fan-out + group_wait fan-in pattern.
 *
 * Pattern:
 *   1. Fan out N tasks onto a concurrent queue, tracked by a group
 *   2. group_wait collects all (fan-in)
 *   3. Serial result queue is used for sequenced work
 *
 * Note: NanoLang closures are anonymous functions and do not capture outer
 * variables.  This example demonstrates the dispatch API structure without
 * relying on closure variable capture.
 */

module "modules/dispatch/dispatch.nano" as dispatch

# @pure
fn noop_work() -> void {}

shadow noop_work {
    (noop_work)
}

fn main() -> int {
    if (not (dispatch.dispatch_available)) {
        (println "SKIP: libdispatch is not available on this platform")
        return 0
    }
    if (> (str_length (getenv "NANO_INTERPRETER")) 0) {
        (println "SKIP: the tree-walking interpreter cannot run libdispatch callbacks")
        return 0
    }

    let n_tasks: int = 16
    let q_work: dispatch.NlQueue = (dispatch.queue_concurrent "nano.pipeline.work")
    let q_result: dispatch.NlQueue = (dispatch.queue_serial "nano.pipeline.result")
    let g: dispatch.NlQueueGroup = (dispatch.group_create)

    /* Fan out N no-op tasks */
    let mut i: int = 0
    while (< i n_tasks) {
        (dispatch.group_async g q_work fn() -> void { (noop_work) })
        set i (+ i 1)
    }

    /* Wait for all compute tasks */
    let rc: int = (dispatch.group_wait_ms g 5000)
    if (!= rc 0) {
        (println "FAIL: compute group_wait failed!")
        (dispatch.group_destroy g)
        (dispatch.queue_destroy q_work)
        (dispatch.queue_destroy q_result)
        return 1
    }

    /* Drain result queue with a no-op */
    (dispatch.queue_sync q_result fn() -> void {})

    (println "PASS: all pipeline tasks completed")

    (dispatch.group_destroy g)
    (dispatch.queue_destroy q_work)
    (dispatch.queue_destroy q_result)
    return 0
}

shadow main {
    (print "")
}
