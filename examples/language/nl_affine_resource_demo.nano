# Example: Affine Resource Demo
# Purpose: I transfer and dismantle a simulated file handle
# Features: resource struct, functions, shadow tests
# Difficulty: Intermediate
# Category: language
# Prerequisites: nl_struct, nl_functions_basic
# Track: learn
# Build: local
# Dependencies: none
# Tags: resource, affine, shadow-tested
# Expected Output: audit.log, resource closed

resource struct FileHandle {
    fd: int
}

fn open_file(path: string) -> FileHandle {
    # I model a handle here; I do not open an operating-system file.
    (println path)
    return FileHandle { fd: 42 }
}

shadow open_file {
    let f: FileHandle = (open_file "audit.log")
    (close_file f)
}

fn close_file(_f: FileHandle) -> void {
    let FileHandle { fd } = _f
    assert (> fd 0)
    (println "resource closed")
}

shadow close_file {
    let f: FileHandle = FileHandle { fd: 1 }
    (close_file f)
}

fn main() -> int {
    let f: FileHandle = (open_file "audit.log")
    (close_file f)
    return 0
}

shadow main {
    assert (== (main) 0)
}
