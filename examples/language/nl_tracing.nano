# Example: Runtime Tracing
# Purpose: Record function spans and named events with my tracing API
# Features: trace spans, trace events, structured logging, shadow tests
# Difficulty: Beginner
# Category: language
# Prerequisites: nl_functions_basic
# Track: modules
# Build: local
# Dependencies: none
# Tags: tracing, debugging, shadow-tested
# Expected Output: trace records followed by total: 15

module "modules/std/log/log.nano" as log

fn calculate_sum(numbers: array<int>) -> int {
    let trace_id: int = (log.trace_enter "calculate_sum")
    let mut total: int = 0
    let mut i: int = 0
    while (< i (array_length numbers)) {
        set total (+ total (at numbers i))
        set i (+ i 1)
    }
    (log.trace_event "sum_complete" (+ "total=" (int_to_string total)))
    (log.trace_exit trace_id "calculate_sum")
    return total
}

shadow calculate_sum {
    assert (== (calculate_sum [1, 2, 3]) 6)
    assert (== (calculate_sum []) 0)
}

fn main() -> int {
    (log.set_log_level 0)
    let total: int = (calculate_sum [1, 2, 3, 4, 5])
    (println (+ "total: " (int_to_string total)))
    return 0
}

shadow main {
    assert (== (calculate_sum [5, 10]) 15)
}
