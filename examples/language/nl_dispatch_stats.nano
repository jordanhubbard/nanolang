# Example: Dispatch Stats
# Purpose: Demonstrate serialized state updates through a dispatch queue
# Features: dispatch module, serial queues, shadow tests
# Difficulty: Advanced
# Category: language
# Prerequisites: nl_dispatch_counter
# Track: modules
# Build: external-deps
# Dependencies: modules/dispatch, libdispatch
# Tags: concurrency, native-only
# Expected Output: SKIP: libdispatch is not available on this platform

/* nl_dispatch_stats.nano
 * Demonstrates a serial queue guarding shared state.
 *
 * All writes to shared state go through a serial queue so they are
 * serialized even when submitted from a concurrent queue.
 *
 * Note: NanoLang closures do not capture outer variables.
 * This example demonstrates the dispatch API structure.
 */

module "modules/dispatch/dispatch.nano" as dispatch

# @pure
fn noop_update() -> void {}

shadow noop_update {
    (noop_update)
}

fn main() -> int {
    if (not (dispatch.dispatch_available)) {
        (println "SKIP: libdispatch is not available on this platform")
        return 0
    }
    if (> (str_length (getenv "NANO_INTERPRETER")) 0) {
        (println "SKIP: the tree-walking interpreter cannot run libdispatch callbacks")
        return 0
    }

    let q_stats: dispatch.NlQueue = (dispatch.queue_serial "nano.main.stats")
    let q_work: dispatch.NlQueue = (dispatch.queue_concurrent "nano.main.workers")
    let g: dispatch.NlQueueGroup = (dispatch.group_create)

    /* Submit 100 no-op tasks to the work queue */
    let mut i: int = 0
    while (< i 100) {
        (dispatch.group_async g q_work fn() -> void { (noop_update) })
        set i (+ i 1)
    }

    let rc: int = (dispatch.group_wait_ms g 5000)
    if (!= rc 0) {
        (println "FAIL: group_wait failed!")
        (dispatch.group_destroy g)
        (dispatch.queue_destroy q_work)
        (dispatch.queue_destroy q_stats)
        return 1
    }

    (dispatch.queue_sync q_stats fn() -> void {})

    (println "PASS: all 100 serialized updates completed")

    (dispatch.group_destroy g)
    (dispatch.queue_destroy q_work)
    (dispatch.queue_destroy q_stats)
    return 0
}

shadow main {
    (print "")
}
