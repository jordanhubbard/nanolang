# Example: Prime Sieve (Eratosthenes)
# Purpose: I replace the trial division from nl_primes with a sieve for the million-number benchmark
# Features: arrays, bool arrays, nested loops, algorithm comparison
# Difficulty: Intermediate
# Category: language
# Prerequisites: nl_hello, nl_control_if_while, nl_primes
# Expected Output: Calculating primes up to 1,000,000 (OPTIMIZED - Sieve of Eratosthenes)...

# @pure
fn count_primes_sieve(limit: int) -> int {
    if (< limit 2) {
        return 0
    }
    
    # Allocate boolean array for the sieve
    let mut sieve: array<bool> = (array_new limit true)
    
    # 0 and 1 are not prime
    (array_set sieve 0 false)
    (array_set sieve 1 false)
    
    # Sieve of Eratosthenes algorithm
    let mut p: int = 2
    while (< (* p p) limit) {
        if (at sieve p) {
            # Mark all multiples of p as not prime
            let mut i: int = (* p p)
            while (< i limit) {
                (array_set sieve i false)
                set i (+ i p)
            }
        }
        set p (+ p 1)
    }
    
    # Count primes
    let mut count: int = 0
    let mut idx: int = 0
    while (< idx limit) {
        if (at sieve idx) {
            set count (+ count 1)
        }
        set idx (+ idx 1)
    }
    return count
}

shadow count_primes_sieve {
    assert (== (count_primes_sieve 0) 0)
    assert (== (count_primes_sieve 2) 0)
    assert (== (count_primes_sieve 10) 4)
    assert (== (count_primes_sieve 100) 25)
}

fn example_prime_limit() -> int {
    let override: string = (getenv "NANO_PRIME_LIMIT")
    if (> (str_length override) 0) {
        return (string_to_int override)
    }
    let interp: string = (getenv "NANO_INTERPRETER")
    if (> (str_length interp) 0) {
        return 10000
    }
    return 1000000
}

shadow example_prime_limit {
    let limit: int = (example_prime_limit)
    assert (> limit 0)
}

fn main() -> int {
    let limit: int = (example_prime_limit)
    print((+ "Calculating primes up to " (+ (int_to_string limit) " (OPTIMIZED - Sieve of Eratosthenes)...")))
    let total: int = (count_primes_sieve limit)
    print("Total primes found: ")
    print((int_to_string total))
    return 0
}

shadow main {
    assert (== (main) 0)
}
