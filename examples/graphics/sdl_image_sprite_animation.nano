# Example: Sprite Sheet Animation
# Purpose: Select timed source rectangles from one PNG sprite sheet
# Features: SDL_image, sprite sheets, source rectangles, frame timing, movement
# Difficulty: Intermediate
# Category: graphics
# Prerequisites: sdl_image_demo
# Track: graphics
# Build: graphical, external-deps
# Dependencies: SDL2, SDL2_image
# Tags: sprite-sheet, animation, timing, shadow-tested
# Expected Output: graphical

unsafe module "modules/sdl/sdl.nano"
unsafe module "modules/sdl_helpers/sdl_helpers.nano"
unsafe module "modules/sdl_image/sdl_image.nano"

let FRAME_WIDTH: int = 32
let FRAME_HEIGHT: int = 32
let FRAME_COUNT: int = 4

fn animation_frame(elapsed_ms: int) -> int {
    return (% (/ elapsed_ms 120) FRAME_COUNT)
}

shadow animation_frame {
    assert (== (animation_frame 0) 0)
    assert (== (animation_frame 120) 1)
    assert (== (animation_frame 480) 0)
}

fn bounce_velocity(position: int, velocity: int, limit: int) -> int {
    if (or (<= position 0) (>= position limit)) {
        return (- 0 velocity)
    }
    return velocity
}

shadow bounce_velocity {
    assert (== (bounce_velocity 0 -2 736) 2)
    assert (== (bounce_velocity 200 2 736) 2)
    assert (== (bounce_velocity 736 2 736) -2)
}

fn main() -> int {
    if (!= (SDL_Init SDL_INIT_VIDEO) 0) {
        (println (+ "SDL initialization failed: " (SDL_GetError)))
        return 1
    }
    if (== (IMG_Init IMG_INIT_PNG) 0) {
        (println "SDL_image PNG initialization failed")
        (SDL_Quit)
        return 1
    }

    let window: SDL_Window = (SDL_CreateWindow "Sprite Sheet Animation"
        SDL_WINDOWPOS_CENTERED SDL_WINDOWPOS_CENTERED 800 600 SDL_WINDOW_SHOWN)
    let renderer: SDL_Renderer = (SDL_CreateRenderer window -1
        (+ SDL_RENDERER_ACCELERATED SDL_RENDERER_PRESENTVSYNC))
    if (or (== window 0) (== renderer 0)) {
        (println (+ "SDL setup failed: " (SDL_GetError)))
        if (!= renderer 0) { (SDL_DestroyRenderer renderer) }
        if (!= window 0) { (SDL_DestroyWindow window) }
        (IMG_Quit)
        (SDL_Quit)
        return 1
    }

    let sheet: int = (nl_img_load_png_texture renderer
        "examples/graphics/assets/orb_sprite_sheet.png")
    if (== sheet 0) {
        (println "Could not load examples/graphics/assets/orb_sprite_sheet.png")
        (SDL_DestroyRenderer renderer)
        (SDL_DestroyWindow window)
        (IMG_Quit)
        (SDL_Quit)
        return 1
    }

    let mut x: int = 100
    let mut y: int = 250
    let mut vx: int = 3
    let mut vy: int = 2
    let mut running: bool = true
    while running {
        if (or (!= (nl_sdl_poll_event_quit) 0) (== (nl_sdl_poll_keypress) 41)) {
            set running false
        }

        set x (+ x vx)
        set y (+ y vy)
        set vx (bounce_velocity x vx 736)
        set vy (bounce_velocity y vy 536)
        if (< x 0) { set x 0 }
        if (> x 736) { set x 736 }
        if (< y 0) { set y 0 }
        if (> y 536) { set y 536 }

        let frame: int = (animation_frame (SDL_GetTicks))
        (SDL_SetRenderDrawColor renderer 18 20 30 255)
        (SDL_RenderClear renderer)
        (nl_img_render_texture_sprite renderer sheet
            (* frame FRAME_WIDTH) 0 FRAME_WIDTH FRAME_HEIGHT
            x y 64 64)
        (SDL_RenderPresent renderer)
    }

    (nl_img_destroy_texture sheet)
    (SDL_DestroyRenderer renderer)
    (SDL_DestroyWindow window)
    (IMG_Quit)
    (SDL_Quit)
    return 0
}

shadow main {
    assert (== (animation_frame 360) 3)
}
