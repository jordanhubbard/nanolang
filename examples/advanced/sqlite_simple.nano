# Example: SQLite Prepared CRUD
# Purpose: Create, read, update, and delete rows with prepared statements and bound values
# Features: SQLite, prepared statements, parameter binding, CRUD
# Difficulty: Intermediate
# Category: advanced
# Prerequisites: ffi_tutorial
# Track: modules
# Build: external-deps
# Dependencies: SQLite3
# Tags: sqlite, prepared-statements, crud, local
# Expected Output: prepared CRUD: Alice -> Alicia -> deleted

unsafe module "modules/sqlite/sqlite.nano" as sqlite

fn execute_insert(db: int, name: string, email: string) -> int {
    let stmt: int = (sqlite.prepare db
        "INSERT INTO contacts (name, email) VALUES (?, ?)")
    if (== stmt 0) { return 1 }
    let mut result: int = (sqlite.bind_text stmt 1 name)
    if (== result 0) { set result (sqlite.bind_text stmt 2 email) }
    if (== result 0) {
        let step_result: int = (sqlite.step stmt)
        if (!= step_result (sqlite.SQLITE_DONE)) { set result step_result }
    }
    (sqlite.finalize stmt)
    return result
}

shadow execute_insert {
    let db: int = (sqlite.open ":memory:")
    assert (!= db 0)
    assert (== (sqlite.exec db "CREATE TABLE contacts (id INTEGER PRIMARY KEY, name TEXT, email TEXT)") 0)
    assert (== (execute_insert db "Alice" "alice@example.com") 0)
    assert (== (sqlite.changes db) 1)
    (sqlite.close db)
}

fn execute_update(db: int, id: int, name: string) -> int {
    let stmt: int = (sqlite.prepare db "UPDATE contacts SET name = ? WHERE id = ?")
    if (== stmt 0) { return 1 }
    let mut result: int = (sqlite.bind_text stmt 1 name)
    if (== result 0) { set result (sqlite.bind_int stmt 2 id) }
    if (== result 0) {
        let step_result: int = (sqlite.step stmt)
        if (!= step_result (sqlite.SQLITE_DONE)) { set result step_result }
    }
    (sqlite.finalize stmt)
    return result
}

shadow execute_update {
    let db: int = (sqlite.open ":memory:")
    (sqlite.exec db "CREATE TABLE contacts (id INTEGER PRIMARY KEY, name TEXT, email TEXT)")
    (execute_insert db "Alice" "alice@example.com")
    assert (== (execute_update db 1 "Alicia") 0)
    assert (== (sqlite.changes db) 1)
    (sqlite.close db)
}

fn select_name(db: int, id: int) -> string {
    let stmt: int = (sqlite.prepare db "SELECT name FROM contacts WHERE id = ?")
    if (== stmt 0) { return "" }
    if (!= (sqlite.bind_int stmt 1 id) 0) {
        (sqlite.finalize stmt)
        return ""
    }
    let mut name: string = ""
    if (== (sqlite.step stmt) (sqlite.SQLITE_ROW)) {
        # SQLite owns column text until the statement is finalized, so copy it.
        set name (+ "" (sqlite.column_text stmt 0))
    }
    (sqlite.finalize stmt)
    return name
}

shadow select_name {
    let db: int = (sqlite.open ":memory:")
    (sqlite.exec db "CREATE TABLE contacts (id INTEGER PRIMARY KEY, name TEXT, email TEXT)")
    (execute_insert db "Alice" "alice@example.com")
    assert (== (select_name db 1) "Alice")
    assert (== (select_name db 99) "")
    (sqlite.close db)
}

fn execute_delete(db: int, id: int) -> int {
    let stmt: int = (sqlite.prepare db "DELETE FROM contacts WHERE id = ?")
    if (== stmt 0) { return 1 }
    let mut result: int = (sqlite.bind_int stmt 1 id)
    if (== result 0) {
        let step_result: int = (sqlite.step stmt)
        if (!= step_result (sqlite.SQLITE_DONE)) { set result step_result }
    }
    (sqlite.finalize stmt)
    return result
}

shadow execute_delete {
    let db: int = (sqlite.open ":memory:")
    (sqlite.exec db "CREATE TABLE contacts (id INTEGER PRIMARY KEY, name TEXT, email TEXT)")
    (execute_insert db "Alice" "alice@example.com")
    assert (== (execute_delete db 1) 0)
    assert (== (select_name db 1) "")
    (sqlite.close db)
}

fn main() -> int {
    let db: int = (sqlite.open ":memory:")
    if (== db 0) {
        (println "Could not open an in-memory SQLite database")
        return 1
    }
    if (!= (sqlite.exec db "CREATE TABLE contacts (id INTEGER PRIMARY KEY, name TEXT, email TEXT)") 0) {
        (println (sqlite.errmsg db))
        (sqlite.close db)
        return 1
    }
    if (!= (execute_insert db "Alice" "alice@example.com") 0) {
        (println (sqlite.errmsg db))
        (sqlite.close db)
        return 1
    }
    let id: int = (sqlite.last_insert_rowid db)
    let original: string = (select_name db id)
    if (!= (execute_update db id "Alicia") 0) {
        (println (sqlite.errmsg db))
        (sqlite.close db)
        return 1
    }
    let updated: string = (select_name db id)
    if (!= (execute_delete db id) 0) {
        (println (sqlite.errmsg db))
        (sqlite.close db)
        return 1
    }
    let deleted: bool = (== (select_name db id) "")
    (sqlite.close db)

    if (and (== original "Alice") (and (== updated "Alicia") deleted)) {
        (println "prepared CRUD: Alice -> Alicia -> deleted")
        return 0
    }
    (println (+ "CRUD verification failed: original="
        (+ original (+ ", updated=" updated))))
    return 1
}

shadow main {
    let db: int = (sqlite.open ":memory:")
    assert (!= db 0)
    (sqlite.close db)
}
