# Example: libevent Timed Loop Exit
# Purpose: Schedule an event-loop exit and dispatch until that timeout expires
# Features: libevent base lifecycle, timed loop exit, dispatch
# Difficulty: Advanced
# Category: advanced
# Prerequisites: ffi_tutorial
# Track: modules
# Build: external-deps
# Dependencies: libevent
# Tags: event-loop, timer, ffi
# Expected Output: libevent dispatch completed after one second

unsafe module "modules/event/event.nano"

fn run_timed_dispatch(seconds: int) -> int {
    let base: int = (nl_event_base_new)
    if (== base 0) { return -1 }

    let schedule_result: int = (nl_event_base_loopexit base seconds)
    if (!= schedule_result 0) {
        (nl_event_base_free base)
        return schedule_result
    }

    let dispatch_result: int = (nl_event_base_dispatch base)
    (nl_event_base_free base)
    return dispatch_result
}

shadow run_timed_dispatch {
    # Zero requests exit after the current loop iteration and does not wait.
    assert (== (run_timed_dispatch 0) 0)
}

fn main() -> int {
    (println (+ "libevent " (nl_event_get_version)))
    let result: int = (run_timed_dispatch 1)
    if (== result 0) {
        (println "libevent dispatch completed after one second")
        return 0
    }
    (println (+ "libevent dispatch failed: " (int_to_string result)))
    return 1
}

shadow main {
    assert (> (nl_event_get_version_number) 0)
}
