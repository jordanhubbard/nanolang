# Example: libuv Loop Inspection
# Purpose: Create an empty libuv loop, poll it without blocking, and close it
# Features: libuv loop lifecycle, non-blocking polling, timing, system queries
# Difficulty: Advanced
# Category: advanced
# Prerequisites: ffi_tutorial
# Track: modules
# Build: external-deps
# Dependencies: libuv
# Tags: event-loop, polling, ffi
# Expected Output: empty libuv loop polled and closed

unsafe module "modules/uv/uv.nano"

fn inspect_empty_loop() -> int {
    let loop: int = (nl_uv_loop_new)
    if (== loop 0) { return 1 }

    let alive_before: int = (nl_uv_loop_alive loop)
    let run_result: int = (nl_uv_run loop 2)
    let alive_after: int = (nl_uv_loop_alive loop)
    let close_result: int = (nl_uv_loop_close loop)

    if (!= alive_before 0) { return 2 }
    if (!= run_result 0) { return 3 }
    if (!= alive_after 0) { return 4 }
    if (!= close_result 0) { return 5 }
    return 0
}

shadow inspect_empty_loop {
    assert (== (inspect_empty_loop) 0)
}

fn main() -> int {
    (println (+ "libuv " (nl_uv_version_string)))
    (println (+ "host: " (nl_uv_os_gethostname)))
    let start: int = (nl_uv_hrtime)
    let result: int = (inspect_empty_loop)
    let elapsed: int = (- (nl_uv_hrtime) start)
    if (== result 0) {
        (println (+ "empty libuv loop polled and closed in "
            (+ (int_to_string elapsed) " ns")))
    }
    return result
}

shadow main {
    assert (> (nl_uv_version) 0)
}
