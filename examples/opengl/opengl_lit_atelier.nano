# Example: OpenGL Lit Atelier
# Purpose: High-polygon GLUT solids under four moving coloured lights
# Features: OpenGL, GLFW, GLEW, GLUT, multiple lights, materials, animation
# Difficulty: Advanced
# Category: opengl
# Prerequisites: opengl_teapot, opengl_solar_system
# Expected Output: graphical
#
# I fill a studio with a teapot, a dense sphere, a dense torus, a cone, a
# cube, the Platonic solids, and six orbiting high-slice spheres. Four
# positional lights move at different rates. The camera slowly circles the
# floor. Arrow keys yaw and pitch; ESC quits.
#
# Controls:
#   Arrow Keys - Orbit the camera
#   ESC        - Quit

unsafe module "modules/glfw/glfw.nano"
unsafe module "modules/glew/glew.nano"
unsafe module "modules/opengl/opengl.nano"
module "modules/glut/glut.nano"
from "std/math/extended.nano" import sin, cos

let WINDOW_WIDTH: int = 1280
let WINDOW_HEIGHT: int = 800
let SPHERE_SLICES: int = 96
let SPHERE_STACKS: int = 80
let TORUS_SIDES: int = 64
let TORUS_RINGS: int = 128
let CONE_SLICES: int = 64
let CONE_STACKS: int = 32
let SATELLITE_SLICES: int = 48
let SATELLITE_STACKS: int = 40

fn wrap_degrees(angle: float) -> float {
    if (>= angle 360.0) {
        return (- angle 360.0)
    }
    if (< angle 0.0) {
        return (+ angle 360.0)
    }
    return angle
}

shadow wrap_degrees {
    assert (== (wrap_degrees 10.0) 10.0)
    assert (== (wrap_degrees 360.0) 0.0)
    assert (== (wrap_degrees -10.0) 350.0)
}

fn clamp_pitch(pitch: float) -> float {
    if (> pitch 35.0) { return 35.0 }
    if (< pitch -8.0) { return -8.0 }
    return pitch
}

shadow clamp_pitch {
    assert (== (clamp_pitch 0.0) 0.0)
    assert (== (clamp_pitch 90.0) 35.0)
    assert (== (clamp_pitch -40.0) -8.0)
}

fn setup_opengl() -> void {
    (glEnable GL_DEPTH_TEST)
    (glDepthFunc GL_LESS)
    (glEnable GL_CULL_FACE)
    (glCullFace GL_BACK)
    (glEnable GL_NORMALIZE)
    (glEnable GL_LIGHTING)
    (glEnable GL_LIGHT0)
    (glEnable GL_LIGHT1)
    (glEnable GL_LIGHT2)
    (glEnable GL_LIGHT3)
    (glEnable GL_COLOR_MATERIAL)
    (glColorMaterial GL_FRONT_AND_BACK GL_AMBIENT_AND_DIFFUSE)
    (glShadeModel GL_SMOOTH)

    (glMatrixMode GL_PROJECTION)
    (glLoadIdentity)
    let aspect: float = (/ (cast_float WINDOW_WIDTH) (cast_float WINDOW_HEIGHT))
    (glFrustum (* -0.55 aspect) (* 0.55 aspect) -0.55 0.55 1.2 80.0)
    (glMatrixMode GL_MODELVIEW)
    (glClearColor 0.03 0.03 0.05 1.0)
}

shadow setup_opengl { assert true }

fn place_lights(time_s: float) -> void {
    let a0: float = (* time_s 0.70)
    let a1: float = (* time_s 1.10)
    let a2: float = (* time_s 0.45)
    let a3: float = (* time_s 1.60)

    (nl_glLightfv4 GL_LIGHT0 GL_POSITION (* 9.0 (cos a0)) 7.5 (* 9.0 (sin a0)) 1.0)
    (nl_glLightfv4 GL_LIGHT0 GL_DIFFUSE 1.0 0.82 0.62 1.0)
    (nl_glLightfv4 GL_LIGHT0 GL_SPECULAR 1.0 0.95 0.85 1.0)
    (nl_glLightfv4 GL_LIGHT0 GL_AMBIENT 0.05 0.04 0.03 1.0)

    (nl_glLightfv4 GL_LIGHT1 GL_POSITION (* -8.0 (cos a1)) 4.0 (* 8.0 (sin a1)) 1.0)
    (nl_glLightfv4 GL_LIGHT1 GL_DIFFUSE 0.35 0.55 1.0 1.0)
    (nl_glLightfv4 GL_LIGHT1 GL_SPECULAR 0.45 0.60 1.0 1.0)
    (nl_glLightfv4 GL_LIGHT1 GL_AMBIENT 0.02 0.03 0.06 1.0)

    (nl_glLightfv4 GL_LIGHT2 GL_POSITION (* 6.5 (sin a2)) 2.4 (* -7.0 (cos a2)) 1.0)
    (nl_glLightfv4 GL_LIGHT2 GL_DIFFUSE 1.0 0.28 0.22 1.0)
    (nl_glLightfv4 GL_LIGHT2 GL_SPECULAR 1.0 0.40 0.30 1.0)
    (nl_glLightfv4 GL_LIGHT2 GL_AMBIENT 0.04 0.01 0.01 1.0)

    (nl_glLightfv4 GL_LIGHT3 GL_POSITION (* 3.0 (cos a3)) (+ 5.5 (* 1.8 (sin (* time_s 0.9)))) (* 3.0 (sin a3)) 1.0)
    (nl_glLightfv4 GL_LIGHT3 GL_DIFFUSE 0.35 1.0 0.45 1.0)
    (nl_glLightfv4 GL_LIGHT3 GL_SPECULAR 0.50 1.0 0.55 1.0)
    (nl_glLightfv4 GL_LIGHT3 GL_AMBIENT 0.01 0.04 0.02 1.0)
}

shadow place_lights { assert true }

fn draw_floor() -> void {
    (glColor3f 0.22 0.22 0.24)
    (nl_glMaterialfv4 GL_FRONT GL_SPECULAR 0.15 0.15 0.18 1.0)
    (glMaterialf GL_FRONT GL_SHININESS 8.0)
    (glNormal3f 0.0 1.0 0.0)
    (glBegin GL_QUADS)
    (glVertex3f -14.0 -2.0 -14.0)
    (glVertex3f -14.0 -2.0 14.0)
    (glVertex3f 14.0 -2.0 14.0)
    (glVertex3f 14.0 -2.0 -14.0)
    (glEnd)
}

shadow draw_floor { assert true }

fn draw_atelier(time_s: float) -> void {
    # Utah teapot — still the densest classic GLUT mesh
    (glPushMatrix)
    (glTranslatef -5.2 (+ -0.15 (* 0.12 (sin (* time_s 1.3)))) 1.8)
    (glRotatef (* time_s 28.0) 0.0 1.0 0.0)
    (glColor3f 0.82 0.32 0.18)
    (nl_glMaterialfv4 GL_FRONT GL_SPECULAR 0.9 0.8 0.7 1.0)
    (glMaterialf GL_FRONT GL_SHININESS 64.0)
    (glutSolidTeapot 1.35)
    (glPopMatrix)

    # High-slice sphere
    (glPushMatrix)
    (glTranslatef 0.0 (+ 0.35 (* 0.2 (sin (* time_s 1.7)))) 0.4)
    (glRotatef (* time_s 18.0) 0.2 1.0 0.1)
    (glColor3f 0.75 0.78 0.92)
    (nl_glMaterialfv4 GL_FRONT GL_SPECULAR 1.0 1.0 1.0 1.0)
    (glMaterialf GL_FRONT GL_SHININESS 96.0)
    (glutSolidSphere 1.45 SPHERE_SLICES SPHERE_STACKS)
    (glPopMatrix)

    # High-ring torus
    (glPushMatrix)
    (glTranslatef 5.0 -0.05 -0.6)
    (glRotatef 18.0 1.0 0.0 0.0)
    (glRotatef (* time_s 42.0) 0.0 1.0 0.0)
    (glColor3f 0.20 0.62 0.78)
    (nl_glMaterialfv4 GL_FRONT GL_SPECULAR 0.6 0.85 0.95 1.0)
    (glMaterialf GL_FRONT GL_SHININESS 48.0)
    (glutSolidTorus 0.38 1.55 TORUS_SIDES TORUS_RINGS)
    (glPopMatrix)

    # Dense cone
    (glPushMatrix)
    (glTranslatef -2.4 -2.0 -4.2)
    (glRotatef -90.0 1.0 0.0 0.0)
    (glColor3f 0.92 0.72 0.22)
    (nl_glMaterialfv4 GL_FRONT GL_SPECULAR 0.5 0.4 0.2 1.0)
    (glMaterialf GL_FRONT GL_SHININESS 24.0)
    (glutSolidCone 1.1 2.6 CONE_SLICES CONE_STACKS)
    (glPopMatrix)

    # Cube, spinning on a diagonal
    (glPushMatrix)
    (glTranslatef 3.2 -0.55 -4.8)
    (glRotatef (* time_s 36.0) 0.7 1.0 0.3)
    (glColor3f 0.55 0.38 0.82)
    (nl_glMaterialfv4 GL_FRONT GL_SPECULAR 0.7 0.6 0.9 1.0)
    (glMaterialf GL_FRONT GL_SHININESS 32.0)
    (glutSolidCube 1.6)
    (glPopMatrix)

    # Icosahedron
    (glPushMatrix)
    (glTranslatef 6.4 -0.9 3.4)
    (glRotatef (* time_s 22.0) 0.0 1.0 0.4)
    (glScalef 1.35 1.35 1.35)
    (glColor3f 0.95 0.55 0.20)
    (nl_glMaterialfv4 GL_FRONT GL_SPECULAR 0.8 0.5 0.3 1.0)
    (glMaterialf GL_FRONT GL_SHININESS 40.0)
    (glutSolidIcosahedron)
    (glPopMatrix)

    # Dodecahedron
    (glPushMatrix)
    (glTranslatef -6.6 -0.7 -2.2)
    (glRotatef (* time_s 14.0) 0.3 1.0 0.0)
    (glScalef 1.25 1.25 1.25)
    (glColor3f 0.28 0.78 0.48)
    (nl_glMaterialfv4 GL_FRONT GL_SPECULAR 0.4 0.8 0.5 1.0)
    (glMaterialf GL_FRONT GL_SHININESS 28.0)
    (glutSolidDodecahedron)
    (glPopMatrix)

    # Octahedron
    (glPushMatrix)
    (glTranslatef 1.4 -0.35 4.6)
    (glRotatef (* time_s 50.0) 1.0 0.2 0.0)
    (glScalef 1.5 1.5 1.5)
    (glColor3f 0.95 0.85 0.35)
    (nl_glMaterialfv4 GL_FRONT GL_SPECULAR 0.9 0.85 0.4 1.0)
    (glMaterialf GL_FRONT GL_SHININESS 72.0)
    (glutSolidOctahedron)
    (glPopMatrix)

    # Tetrahedron
    (glPushMatrix)
    (glTranslatef -1.8 -0.55 5.2)
    (glRotatef (* time_s 33.0) 0.4 1.0 0.6)
    (glScalef 1.6 1.6 1.6)
    (glColor3f 0.85 0.25 0.45)
    (nl_glMaterialfv4 GL_FRONT GL_SPECULAR 0.8 0.3 0.4 1.0)
    (glMaterialf GL_FRONT GL_SHININESS 36.0)
    (glutSolidTetrahedron)
    (glPopMatrix)
}

shadow draw_atelier { assert true }

fn draw_satellites(time_s: float) -> void {
    let mut i: int = 0
    while (< i 6) {
        let ang: float = (+ (* time_s 0.75) (* (cast_float i) 1.0472))
        let lift: float = (* 0.45 (sin (+ (* time_s 1.4) (* (cast_float i) 0.9))))
        (glPushMatrix)
        (glTranslatef (* 9.2 (cos ang)) (+ 1.6 lift) (* 9.2 (sin ang)))
        (glRotatef (* time_s 55.0) 0.2 1.0 0.3)
        if (== i 0) { (glColor3f 1.0 0.55 0.35) } else {
        if (== i 1) { (glColor3f 0.45 0.75 1.0) } else {
        if (== i 2) { (glColor3f 0.55 1.0 0.55) } else {
        if (== i 3) { (glColor3f 1.0 0.85 0.35) } else {
        if (== i 4) { (glColor3f 0.85 0.45 1.0) } else {
            (glColor3f 1.0 0.40 0.55)
        } } } } }
        (nl_glMaterialfv4 GL_FRONT GL_SPECULAR 0.95 0.95 0.95 1.0)
        (glMaterialf GL_FRONT GL_SHININESS 80.0)
        (glutSolidSphere 0.42 SATELLITE_SLICES SATELLITE_STACKS)
        (glPopMatrix)
        set i (+ i 1)
    }
}

shadow draw_satellites { assert true }

fn main() -> int {
    if (== (glfwInit) 0) {
        (println "I failed to initialize GLFW")
        return 1
    } else {}

    let window: GLFWwindow = (glfwCreateWindow WINDOW_WIDTH WINDOW_HEIGHT "OpenGL Lit Atelier - NanoLang" 0 0)
    if (== window 0) {
        (println "I failed to create the atelier window")
        (glfwTerminate)
        return 1
    } else {}

    (glfwMakeContextCurrent window)
    (glfwSwapInterval 1)

    let glew_status: int = (glewInit)
    if (!= glew_status GLEW_OK) {
        (println "I failed to initialize GLEW")
        (glfwTerminate)
        return 1
    } else {}

    let glut_ready: bool = (glut_ensure_initialized)
    if (not glut_ready) {
        (println "I failed to initialize GLUT for primitive rendering")
        (glfwDestroyWindow window)
        (glfwTerminate)
        return 1
    } else {}

    (setup_opengl)
    (println "Lit atelier: arrows orbit the camera, ESC quits")

    let mut cam_yaw: float = 18.0
    let mut cam_pitch: float = 12.0

    while (== (glfwWindowShouldClose window) 0) {
        if (== (glfwGetKey window GLFW_KEY_ESCAPE) 1) {
            (glfwSetWindowShouldClose window 1)
        } else {}
        if (== (glfwGetKey window GLFW_KEY_LEFT) 1) {
            set cam_yaw (wrap_degrees (- cam_yaw 0.8))
        } else {}
        if (== (glfwGetKey window GLFW_KEY_RIGHT) 1) {
            set cam_yaw (wrap_degrees (+ cam_yaw 0.8))
        } else {}
        if (== (glfwGetKey window GLFW_KEY_UP) 1) {
            set cam_pitch (clamp_pitch (- cam_pitch 0.6))
        } else {}
        if (== (glfwGetKey window GLFW_KEY_DOWN) 1) {
            set cam_pitch (clamp_pitch (+ cam_pitch 0.6))
        } else {}

        let t: float = (glfwGetTime)
        (glClear (+ GL_COLOR_BUFFER_BIT GL_DEPTH_BUFFER_BIT))
        (glLoadIdentity)
        (glTranslatef 0.0 -0.4 -16.5)
        (glRotatef cam_pitch 1.0 0.0 0.0)
        (glRotatef (+ cam_yaw (* t 6.0)) 0.0 1.0 0.0)
        (place_lights t)
        (draw_floor)
        (draw_atelier t)
        (draw_satellites t)

        (glfwSwapBuffers window)
        (glfwPollEvents)
    }

    (glfwDestroyWindow window)
    (glfwTerminate)
    return 0
}

shadow main { assert true }
