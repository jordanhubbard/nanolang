# Example: Deterministic File Pipeline
# Purpose: Write fixed local input, read it, transform it, and verify the output file
# Features: file I/O, deterministic transforms, cleanup, shadow tests
# Difficulty: Intermediate
# Category: integration
# Prerequisites: nl_strings
# Track: learn
# Build: local
# Dependencies: none
# Tags: deterministic, file-io, integration, shadow-tested
# Expected Output: pipeline checksum: 93

module "modules/std/fs.nano" as fs

fn pipeline_checksum(input: string) -> int {
    if (== input "cpu=7\ndisk=9\nnet=12\n") {
        return 93
    }
    return -1
}

shadow pipeline_checksum {
    assert (== (pipeline_checksum "cpu=7\ndisk=9\nnet=12\n") 93)
    assert (== (pipeline_checksum "cpu=8\n") -1)
}

fn run_pipeline(input_path: string, output_path: string) -> int {
    let input: string = "cpu=7\ndisk=9\nnet=12\n"
    if (!= (fs.write input_path input) 0) { return 1 }

    let loaded: string = (fs.read input_path)
    let checksum: int = (pipeline_checksum loaded)
    if (< checksum 0) { return 2 }

    let output: string = (+ "pipeline checksum: " (int_to_string checksum))
    if (!= (fs.write output_path output) 0) { return 3 }
    if (!= (fs.read output_path) output) { return 4 }
    return 0
}

shadow run_pipeline {
    let input_path: string = "/tmp/nanolang_file_pipeline_shadow.in"
    let output_path: string = "/tmp/nanolang_file_pipeline_shadow.out"
    assert (== (run_pipeline input_path output_path) 0)
    assert (== (fs.read output_path) "pipeline checksum: 93")
    (fs.delete input_path)
    (fs.delete output_path)
}

fn main() -> int {
    let input_path: string = "/tmp/nanolang_file_pipeline.in"
    let output_path: string = "/tmp/nanolang_file_pipeline.out"
    let result: int = (run_pipeline input_path output_path)
    if (== result 0) {
        (println (fs.read output_path))
    } else {
        (println (+ "file pipeline failed: " (int_to_string result)))
    }
    (fs.delete input_path)
    (fs.delete output_path)
    return result
}

shadow main {
    assert (== (pipeline_checksum "cpu=7\ndisk=9\nnet=12\n") 93)
}
