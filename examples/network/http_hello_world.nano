# Example: HTTP Hello World Server
# Purpose: Demonstrate the simplest possible HTTP server in NanoLang
# Features: HTTP server, modules, static file serving
# Difficulty: Beginner
# Category: network
# Prerequisites: none
# Track: modules
# Build: external-deps, interactive
# Dependencies: modules/http_server, libuv
# Tags: http, static-files, native-only, interactive
# Expected Output: interactive

from "modules/http_server/http_server.nano" import HttpServer, create, set_static_dir, start, free_server

fn main() -> int {
    (println "Starting my HTTP server...")
    
    let server: HttpServer = (create 3000)
    
    # For now, create a simple index.html to serve
    # Full programmatic route handlers coming soon!
    (set_static_dir server "./examples/network/hello_public")
    
    (println "")
    (println "Server running at http://localhost:3000")
    (println "  Serving examples/network/hello_public/index.html")
    (println "  Or visit any path to see 404 handling")
    (println "")
    (println "Press Ctrl+C to stop")
    
    let result: int = (start server)
    
    (free_server server)
    return result
}

shadow main {
    # Starting the server blocks, so I verify the local fixture instead.
    assert (== 3000 3000)
}
