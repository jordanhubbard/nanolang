# Example: dispatch API Lesson
# Purpose: I show creating a serial queue, dispatching async work, and synchronising via group_wait
# Features: queue_serial, queue_concurrent, queue_async, queue_sync, queue_destroy, group_create, group_async, group_wait_ms, group_destroy
# Difficulty: Advanced
# Category: api_lessons
# Prerequisites: nl_dispatch_counter
# Track: modules
# Build: external-deps
# Dependencies: modules/dispatch, libdispatch
# Tags: api-lesson, concurrency, dispatch, native-only

module "modules/dispatch/dispatch.nano" as dispatch

# Expected Output: dispatch group rc: 0

# @pure
fn noop_work() -> void {
    let x: int = 1
}

shadow noop_work {
    (noop_work)
}

fn drain_serial_queue() -> int {
    if (not (dispatch.dispatch_available)) { return -1 }
    let q: dispatch.NlQueue = (dispatch.queue_serial "nano.api_lesson.serial")
    (dispatch.queue_sync q fn() -> void { (noop_work) })
    (dispatch.queue_destroy q)
    return 0
}

shadow drain_serial_queue {
    if (dispatch.dispatch_available) {
        assert (== (drain_serial_queue) 0)
    } else {
        assert (== (drain_serial_queue) -1)
    }
}

fn run_group_fanout() -> int {
    if (not (dispatch.dispatch_available)) { return -1 }
    let q: dispatch.NlQueue = (dispatch.queue_concurrent "nano.api_lesson.fanout")
    let g: dispatch.NlQueueGroup = (dispatch.group_create)
    let mut i: int = 0
    while (< i 4) {
        (dispatch.group_async g q fn() -> void { (noop_work) })
        set i (+ i 1)
    }
    let rc: int = (dispatch.group_wait_ms g 2000)
    (dispatch.group_destroy g)
    (dispatch.queue_destroy q)
    return rc
}

shadow run_group_fanout {
    if (dispatch.dispatch_available) {
        assert (== (run_group_fanout) 0)
    } else {
        assert (== (run_group_fanout) -1)
    }
}

fn main() -> int {
    if (not (dispatch.dispatch_available)) {
        (println "I require Apple libdispatch for this lesson.")
        return 0
    }
    (drain_serial_queue)
    let rc: int = (run_group_fanout)
    (println (+ "dispatch group rc: " (int_to_string rc)))
    return 0
}

shadow main {
    assert (== (main) 0)
}
