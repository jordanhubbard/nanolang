# Example: Test the Proof Boundary
# Purpose: Separate NanoCore semantic guarantees from executable function tests
# Features: unions, pattern matching, arrays, integer arithmetic, shadow tests
# Difficulty: Advanced
# Category: verified
# Prerequisites: none
# Track: modules
# Build: local
# Dependencies: none
# Tags: verified-subset, adversarial-tests, shadow-tested
# Expected Output: a summary of proved, tested, and assumed claims

/*
 * My Coq theorems apply to functions classified [verified] by --trust-report.
 * They establish language-level properties in the NanoCore model. They do not
 * prove that fibonacci computes Fibonacci numbers, that gcd is mathematically
 * a greatest common divisor, or that this test set covers every input.
 *
 * Run:
 *   nanoc examples/verified/break_the_proof.nano
 *   nanoc examples/verified/break_the_proof.nano --trust-report
 */

union DivResult {
    Quotient { value: int },
    DivisionByZero { dividend: int }
}

fn fibonacci(n: int) -> int {
    if (<= n 0) { return 0 }
    if (== n 1) { return 1 }
    let mut previous: int = 0
    let mut current: int = 1
    let mut index: int = 2
    while (<= index n) {
        let next: int = (+ previous current)
        set previous current
        set current next
        set index (+ index 1)
    }
    return current
}

shadow fibonacci {
    assert (== (fibonacci -3) 0)
    assert (== (fibonacci 0) 0)
    assert (== (fibonacci 1) 1)
    assert (== (fibonacci 10) 55)
    assert (== (fibonacci 20) 6765)
}

fn gcd(a: int, b: int) -> int {
    let mut x: int = a
    let mut y: int = b
    if (< x 0) { set x (- 0 x) }
    if (< y 0) { set y (- 0 y) }
    while (!= y 0) {
        let remainder: int = (% x y)
        set x y
        set y remainder
    }
    return x
}

shadow gcd {
    assert (== (gcd 48 18) 6)
    assert (== (gcd 18 48) 6)
    assert (== (gcd -12 8) 4)
    assert (== (gcd 17 13) 1)
    assert (== (gcd 0 0) 0)
}

fn safe_divide(dividend: int, divisor: int) -> DivResult {
    if (== divisor 0) {
        return DivResult.DivisionByZero { dividend: dividend }
    }
    return DivResult.Quotient { value: (/ dividend divisor) }
}

shadow safe_divide {
    let ordinary: DivResult = (safe_divide 100 7)
    let mut quotient: int = 0
    match ordinary {
        Quotient(q) => { set quotient q.value },
        DivisionByZero(e) => { set quotient e.dividend }
    }
    assert (== quotient 14)

    let zero: DivResult = (safe_divide 9 0)
    let mut rejected: bool = false
    match zero {
        Quotient(q) => {},
        DivisionByZero(e) => { set rejected (== e.dividend 9) }
    }
    assert rejected
}

fn checksum(data: array<int>, modulus: int) -> int {
    if (<= modulus 0) { return 0 }
    let mut sum: int = 0
    let mut index: int = 0
    while (< index (array_length data)) {
        let mut value: int = (at data index)
        if (< value 0) { set value (- 0 value) }
        set sum (% (+ sum value) modulus)
        set index (+ index 1)
    }
    return sum
}

shadow checksum {
    assert (== (checksum [1, 2, 3, 4, 5] 997) 15)
    assert (== (checksum [997] 997) 0)
    assert (== (checksum [-1, 2, -3] 997) 6)
    assert (== (checksum [] 997) 0)
    assert (== (checksum [1, 2] 0) 0)
}

fn clamp(value: int, low: int, high: int) -> int {
    if (< value low) { return low }
    if (> value high) { return high }
    return value
}

shadow clamp {
    assert (== (clamp -10 0 100) 0)
    assert (== (clamp 50 0 100) 50)
    assert (== (clamp 150 0 100) 100)
}

fn run_behavior_checks() -> int {
    let mut passed: int = 0
    if (== (fibonacci 10) 55) { set passed (+ passed 1) }
    if (== (gcd 48 18) 6) { set passed (+ passed 1) }
    if (== (checksum [1, 2, 3, 4, 5] 997) 15) { set passed (+ passed 1) }
    if (== (clamp 150 0 100) 100) { set passed (+ passed 1) }

    let division: DivResult = (safe_divide 1 0)
    match division {
        Quotient(_q) => {},
        DivisionByZero(_e) => { set passed (+ passed 1) }
    }
    return passed
}

shadow run_behavior_checks {
    assert (== (run_behavior_checks) 5)
}

fn main() -> int {
    let passed: int = (run_behavior_checks)
    (println "Proof boundary report")
    (println "  Proved: NanoCore semantic theorems apply where --trust-report says [verified].")
    (println "  Tested: five named behavior checks passed in this execution.")
    (println "  Assumed: the algorithms and domain meanings match their intended specifications.")
    if (!= passed 5) { return 1 }
    return 0
}

shadow main {
    assert (== (main) 0)
}
