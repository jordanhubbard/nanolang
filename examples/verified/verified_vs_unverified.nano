# Example: Verified and Typechecked
# Purpose: Show what the trust report classifies without equating verification with correctness
# Features: unions, pattern matching, arrays, assert, shadow tests
# Difficulty: Beginner
# Category: verified
# Prerequisites: none
# Track: modules
# Build: local
# Dependencies: none
# Tags: trust-report, verified-boundary, shadow-tested
# Expected Output: a concise trust-boundary comparison

/*
 * The names below describe implementation style, not theorem results.
 * --trust-report is the authority: NanoCore-only functions are [verified],
 * while functions containing assert are [typechecked]. The semantic proofs do
 * not prove a business contract such as "this is the right fallback value."
 */

union LookupResult {
    Found { value: int },
    Missing { index: int }
}

fn lookup_with_result(values: array<int>, index: int) -> LookupResult {
    if (< index 0) { return LookupResult.Missing { index: index } }
    if (>= index (array_length values)) {
        return LookupResult.Missing { index: index }
    }
    return LookupResult.Found { value: (at values index) }
}

shadow lookup_with_result {
    let values: array<int> = [10, 20, 30]
    let found: LookupResult = (lookup_with_result values 1)
    let mut value: int = -1
    match found { Found(v) => { set value v.value }, Missing(m) => {} }
    assert (== value 20)

    let missing: LookupResult = (lookup_with_result values 9)
    let mut rejected: bool = false
    match missing { Found(v) => {}, Missing(m) => { set rejected (== m.index 9) } }
    assert rejected
}

fn lookup_with_assert(values: array<int>, index: int) -> int {
    assert (>= index 0)
    assert (< index (array_length values))
    return (at values index)
}

shadow lookup_with_assert {
    assert (== (lookup_with_assert [10, 20, 30] 1) 20)
}

fn clamp(value: int, low: int, high: int) -> int {
    if (< value low) { return low }
    if (> value high) { return high }
    return value
}

shadow clamp {
    assert (== (clamp -1 0 10) 0)
    assert (== (clamp 5 0 10) 5)
    assert (== (clamp 11 0 10) 10)
}

fn require_in_range(value: int, low: int, high: int) -> int {
    assert (>= value low)
    assert (<= value high)
    return value
}

shadow require_in_range {
    assert (== (require_in_range 5 0 10) 5)
}

fn main() -> int {
    let values: array<int> = [10, 20, 30]
    let checked: LookupResult = (lookup_with_result values 9)
    let mut handled: bool = false
    match checked {
        Found(v) => { set handled (< v.value 0) },
        Missing(m) => { set handled (== m.index 9) }
    }

    let in_bounds: int = (lookup_with_assert values 1)
    let bounded: int = (clamp 50 0 10)
    (println "Trust report, not naming, decides the boundary:")
    (println "  lookup_with_result and clamp use the NanoCore subset.")
    (println "  lookup_with_assert and require_in_range contain runtime assertions.")
    (println "  Shadows test concrete behavior; they do not prove these contracts.")
    if (and handled (and (== in_bounds 20) (== bounded 10))) { return 0 }
    return 1
}

shadow main {
    assert (== (main) 0)
}
