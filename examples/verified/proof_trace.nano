# Example: Semantics Walkthrough
# Purpose: Illustrate selected formal rules without claiming to extract a Coq proof trace
# Features: integer arithmetic, conditionals, unions, pattern matching, arrays, shadow tests
# Difficulty: Advanced
# Category: verified
# Prerequisites: none
# Expected Output: three illustrative evaluations and their evidence boundary

/*
 * This is a hand-written walkthrough aligned with names in my formal model.
 * It is not generated by Coq and is not evidence that the compiler followed
 * these printed steps. The executable shadows test the corresponding results.
 * --trust-report separately says which functions stay inside NanoCore.
 */

union Choice {
    Number { value: int },
    Empty { reason: string }
}

fn arithmetic_example() -> int {
    return (+ (* 3 4) (- 10 5))
}

shadow arithmetic_example {
    assert (== (arithmetic_example) 17)
}

fn conditional_example(enabled: bool) -> int {
    if enabled { return 100 }
    return 200
}

shadow conditional_example {
    assert (== (conditional_example true) 100)
    assert (== (conditional_example false) 200)
}

fn match_example(choice: Choice) -> int {
    let mut result: int = -1
    match choice {
        Number(n) => { set result n.value },
        Empty(_e) => { set result 0 }
    }
    return result
}

shadow match_example {
    assert (== (match_example Choice.Number { value: 42 }) 42)
    assert (== (match_example Choice.Empty { reason: "none" }) 0)
}

fn array_sum(values: array<int>) -> int {
    let mut total: int = 0
    let mut index: int = 0
    while (< index (array_length values)) {
        set total (+ total (at values index))
        set index (+ index 1)
    }
    return total
}

shadow array_sum {
    assert (== (array_sum []) 0)
    assert (== (array_sum [10, 20, 30]) 60)
    assert (== (array_sum [-5, 2]) -3)
}

fn main() -> int {
    (println "Illustrative semantics walkthrough")
    (println "  arithmetic: literals and binary operations produce 17")
    (println "  conditional: one branch produces 100 or 200")
    (println "  match: the selected variant determines the branch")
    (println "  array: bounded indexing sums [10, 20, 30] to 60")
    (println "")
    (println "Proved: the formal theorems cover their stated NanoCore semantics.")
    (println "Tested: shadows check the concrete results above.")
    (println "Assumed: these labels accurately summarize the cited formal rules.")
    return 0
}

shadow main {
    assert (== (main) 0)
}
