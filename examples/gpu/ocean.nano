# Example: GPU Ocean
# Purpose: Stress the GPU with a dense perspective ocean and a tessellated vessel responding to distributed wave samples
# Features: gpu fn, OpenCL, CUDA, high-density 2D height field, perspective projection, buoyancy, wake
# Difficulty: Advanced
# Category: gpu
# Prerequisites: vector_add, sdl_drawing_primitives
# Track: showcase
# Build: gpu, graphical, external-deps
# Dependencies: modules/gpu, SDL2, generated PTX/OpenCL kernels, CUDA driver or OpenCL 1.2 with fp64
# Tags: gpu, graphical, native-only
# Expected Output: graphical
#
# I generate a 384 x 256 directional wave field and shade a 1600 x 1000
# procedural seascape on the selected CUDA or OpenCL device. Each frame launches
# 1,698,304 work items and transfers a 1.6-million-pixel image. Layered waves,
# finite-difference normals, foam, caustics, haze, and sun glitter keep the
# arithmetic units and memory path occupied. I then overlay a ship built from
# 12,288 tessellated hull facets. This is a GPU stress scene, not a claim of
# naval-architecture fidelity.
#
# Build:
#   make -C examples gpu-kernels
#   ./bin/nanoc_c examples/gpu/ocean.nano -o bin/ocean
#
# Runtime requirements:
#   CUDA: NVIDIA driver support for the generated PTX target.
#   OpenCL: OpenCL C 1.2, 64-bit integers, byte-addressable stores, and fp64.
#   The matching ocean.ptx and ocean.cl files must remain together.

import "modules/gpu/gpu.nano"
unsafe module "modules/sdl/sdl.nano"
unsafe module "modules/sdl_helpers/sdl_helpers.nano"
from "std/math/extended.nano" import sin, cos, sqrt

let W: int = 1600
let H: int = 1000
let COLS: int = 384
let ROWS: int = 256
let SIN_N: int = 1024
let SHIP_LENGTH_SEGMENTS: int = 256
let SHIP_HEIGHT_SEGMENTS: int = 24
let CELL_X: float = 0.62
let CELL_Z: float = 0.70
let CAMERA_Y: float = 28.0
let CAMERA_Z: float = -34.0
let FOCAL: float = 860.0
let HORIZON: int = 270
let DT: float = 0.016

struct ScreenPoint {
    x: int,
    y: int
}

fn clamp_int(value: int, low: int, high: int) -> int {
    if (< value low) { return low }
    if (> value high) { return high }
    return value
}

shadow clamp_int {
    assert (== (clamp_int -3 0 9) 0)
    assert (== (clamp_int 4 0 9) 4)
    assert (== (clamp_int 12 0 9) 9)
}

fn field_index(col: int, row: int) -> int {
    return (+ (* row COLS) col)
}

shadow field_index {
    assert (== (field_index 3 2) (+ (* 2 COLS) 3))
}

fn sample_height(field: array<int>, col: int, row: int) -> float {
    let cx: int = (clamp_int col 0 (- COLS 1))
    let rz: int = (clamp_int row 0 (- ROWS 1))
    return (/ (cast_float (at field (field_index cx rz))) 1000.0)
}

shadow sample_height {
    let mut field: array<int> = []
    let mut i: int = 0
    while (< i (* COLS ROWS)) {
        let mut value: int = 0
        if (== i (field_index 2 3)) { set value 1750 }
        set field (array_push field value)
        set i (+ i 1)
    }
    assert (> (sample_height field 2 3) 1.7)
    assert (< (sample_height field 2 3) 1.8)
}

fn project_point(world_x: float, world_y: float, world_z: float) -> ScreenPoint {
    let depth: float = (+ (- world_z CAMERA_Z) 18.0)
    let scale: float = (/ FOCAL depth)
    return ScreenPoint {
        x: (cast_int (+ (/ (cast_float W) 2.0) (* world_x scale))),
        y: (cast_int (+ (cast_float HORIZON) (* (- CAMERA_Y world_y) scale)))
    }
}

shadow project_point {
    let near: ScreenPoint = (project_point 0.0 0.0 0.0)
    let far: ScreenPoint = (project_point 0.0 0.0 100.0)
    assert (== near.x (/ W 2))
    assert (> near.y far.y)
}

gpu fn compute_ocean(d_sin: int, d_heights: int, cols: int, tick: int) -> void {
    let col: int = (global_id_x)
    let row: int = (global_id_y)
    if (and (< col cols) (< row 256)) {
        let BIG: int = 102400000
        # Eight directional Gerstner-style height components. Integer lookup
        # tables keep CUDA and OpenCL output on the same supported subset.
        let p1: int = (% (+ (+ (+ (* 17 col) (* 7 row)) (* (- 0 4) tick)) BIG) 1024)
        let p2: int = (% (+ (+ (+ (* (- 0 9) col) (* 21 row)) (* (- 0 7) tick)) BIG) 1024)
        let p3: int = (% (+ (+ (+ (* 5 col) (* 4 row)) (* (- 0 2) tick)) BIG) 1024)
        let p4: int = (% (+ (+ (+ (* 31 col) (* (- 0 13) row)) (* (- 0 11) tick)) BIG) 1024)
        let p5: int = (% (+ (+ (+ (* 43 col) (* 19 row)) (* (- 0 13) tick)) BIG) 1024)
        let p6: int = (% (+ (+ (+ (* (- 0 37) col) (* 29 row)) (* (- 0 17) tick)) BIG) 1024)
        let p7: int = (% (+ (+ (+ (* 61 col) (* (- 0 23) row)) (* (- 0 19) tick)) BIG) 1024)
        let p8: int = (% (+ (+ (+ (* 73 col) (* 41 row)) (* (- 0 23) tick)) BIG) 1024)
        let h1: int = (* 2800 (gpu_load (+ d_sin (* p1 8))))
        let h2: int = (* 1350 (gpu_load (+ d_sin (* p2 8))))
        let h3: int = (* 2200 (gpu_load (+ d_sin (* p3 8))))
        let h4: int = (* 650 (gpu_load (+ d_sin (* p4 8))))
        let h5: int = (* 420 (gpu_load (+ d_sin (* p5 8))))
        let h6: int = (* 310 (gpu_load (+ d_sin (* p6 8))))
        let h7: int = (* 220 (gpu_load (+ d_sin (* p7 8))))
        let h8: int = (* 150 (gpu_load (+ d_sin (* p8 8))))
        let height: int = (/ (+ (+ (+ h1 h2) (+ h3 h4)) (+ (+ h5 h6) (+ h7 h8))) 1000)
        let index: int = (+ (* row cols) col)
        (gpu_store (+ d_heights (* index 8)) height)
        return
    }
}

shadow compute_ocean { assert true }

gpu fn shade_ocean(d_sin: int, d_pixels: int, width: int, tick: int) -> void {
    let x: int = (global_id_x)
    let y: int = (global_id_y)
    if (and (< x width) (< y 1000)) {
        if (< y 270) {
            # Layered atmospheric bands and a tight sunset disk.
            let haze: int = (/ (* y 92) 270)
            let sun_dx: int = (- x 1160)
            let sun_dy: int = (- y 168)
            let sun_dist: int = (+ (* sun_dx sun_dx) (* sun_dy sun_dy))
            if (< sun_dist 3600) {
                let sun_green: int = (- 224 (/ sun_dist 180))
                let sun_blue: int = (- 164 (/ sun_dist 90))
                let sun_pixel: int = (+ (* 255 16777216) (+ (* 248 65536) (+ (* sun_green 256) sun_blue)))
                let sun_index: int = (+ (* y width) x)
                (gpu_store (+ d_pixels (* sun_index 8)) sun_pixel)
                return
            }
            let sky_red: int = (+ 12 haze)
            let sky_green: int = (+ 31 haze)
            let sky_blue: int = (+ 68 haze)
            let sky_pixel: int = (+ (* 255 16777216) (+ (* sky_red 65536) (+ (* sky_green 256) sky_blue)))
            let sky_index: int = (+ (* y width) x)
            (gpu_store (+ d_pixels (* sky_index 8)) sky_pixel)
            return
        } else {
            # Perspective maps nearby pixels over more water than distant ones.
            let depth: int = (+ (- y 270) 18)
            let world_z: int = (/ 180000 depth)
            let world_x: int = (/ (* (- x (/ width 2)) (+ depth 42)) 190)
            let BIG: int = 102400000
            let p1: int = (% (+ (+ (+ (* 17 world_x) (* 7 world_z)) (* (- 0 4) tick)) BIG) 1024)
            let p2: int = (% (+ (+ (+ (* (- 0 9) world_x) (* 21 world_z)) (* (- 0 7) tick)) BIG) 1024)
            let p3: int = (% (+ (+ (+ (* 31 world_x) (* (- 0 13) world_z)) (* (- 0 11) tick)) BIG) 1024)
            let p4: int = (% (+ (+ (+ (* 61 world_x) (* 29 world_z)) (* (- 0 19) tick)) BIG) 1024)
            let q1: int = (% (+ p1 17) 1024)
            let q2: int = (% (+ p2 21) 1024)
            let q3: int = (% (+ p3 31) 1024)
            let q4: int = (% (+ p4 43) 1024)
            let wave: int = (/ (+ (+ (* 30 (gpu_load (+ d_sin (* p1 8))))
                (* 18 (gpu_load (+ d_sin (* p2 8)))))
                (+ (* 11 (gpu_load (+ d_sin (* p3 8))))
                (* 7 (gpu_load (+ d_sin (* p4 8)))))) 1000)
            let slope: int = (/ (+ (+ (* 30 (- (gpu_load (+ d_sin (* q1 8))) (gpu_load (+ d_sin (* p1 8)))))
                (* 18 (- (gpu_load (+ d_sin (* q2 8))) (gpu_load (+ d_sin (* p2 8))))))
                (+ (* 11 (- (gpu_load (+ d_sin (* q3 8))) (gpu_load (+ d_sin (* p3 8)))))
                (* 7 (- (gpu_load (+ d_sin (* q4 8))) (gpu_load (+ d_sin (* p4 8))))))) 1000)
            let horizon_fade: int = (/ (* (- y 270) 70) 730)
            let glitter_axis: int = (/ (* (- x 1160) depth) 760)
            let glitter_energy: int = (+ 18 (+ (* glitter_axis glitter_axis) (* slope slope)))
            let glitter: int = (/ 1044 glitter_energy)
            let foam_seed: int = (% (+ (+ (* world_x 13) (* world_z 29)) (* tick 3)) 97)
            let foam: int = (% (+ (* wave wave) (* foam_seed foam_seed)) 23)
            let red: int = (+ (+ 10 (/ slope 8)) (+ (/ glitter 2) foam))
            let green: int = (+ (+ 52 horizon_fade) (+ glitter foam))
            let blue: int = (+ (+ 92 horizon_fade) (+ glitter foam))
            let pixel: int = (+ (* 255 16777216) (+ (* red 65536) (+ (* green 256) blue)))
            let index: int = (+ (* y width) x)
            (gpu_store (+ d_pixels (* index 8)) pixel)
            return
        }
    }
}

shadow shade_ocean { assert true }

fn cpu_height(sine: array<int>, col: int, row: int, tick: int) -> int {
    let BIG: int = 102400000
    let p1: int = (% (+ (+ (+ (* 17 col) (* 7 row)) (* (- 0 4) tick)) BIG) SIN_N)
    let p2: int = (% (+ (+ (+ (* (- 0 9) col) (* 21 row)) (* (- 0 7) tick)) BIG) SIN_N)
    let p3: int = (% (+ (+ (+ (* 5 col) (* 4 row)) (* (- 0 2) tick)) BIG) SIN_N)
    let p4: int = (% (+ (+ (+ (* 31 col) (* (- 0 13) row)) (* (- 0 11) tick)) BIG) SIN_N)
    let p5: int = (% (+ (+ (+ (* 43 col) (* 19 row)) (* (- 0 13) tick)) BIG) SIN_N)
    let p6: int = (% (+ (+ (+ (* (- 0 37) col) (* 29 row)) (* (- 0 17) tick)) BIG) SIN_N)
    let p7: int = (% (+ (+ (+ (* 61 col) (* (- 0 23) row)) (* (- 0 19) tick)) BIG) SIN_N)
    let p8: int = (% (+ (+ (+ (* 73 col) (* 41 row)) (* (- 0 23) tick)) BIG) SIN_N)
    return (/ (+ (+ (+ (* 2800 (at sine p1)) (* 1350 (at sine p2)))
        (+ (* 2200 (at sine p3)) (* 650 (at sine p4))))
        (+ (+ (* 420 (at sine p5)) (* 310 (at sine p6)))
        (+ (* 220 (at sine p7)) (* 150 (at sine p8))))) 1000)
}

shadow cpu_height {
    let mut sine: array<int> = []
    let mut i: int = 0
    while (< i SIN_N) {
        set sine (array_push sine 0)
        set i (+ i 1)
    }
    assert (== (cpu_height sine 0 0 0) 0)
}

fn draw_sky(renderer: SDL_Renderer) -> void {
    let mut y: int = 0
    while (< y HORIZON) {
        let r: int = (+ 10 (/ (* y 72) HORIZON))
        let g: int = (+ 28 (/ (* y 100) HORIZON))
        let b: int = (+ 58 (/ (* y 118) HORIZON))
        (SDL_SetRenderDrawColor renderer r g b 255)
        (SDL_RenderDrawLine renderer 0 y W y)
        set y (+ y 1)
    }
    # A narrow horizon glow gives the mesh depth without pretending it is fog.
    set y (- HORIZON 28)
    while (< y HORIZON) {
        let glow: int = (/ (* (- y (- HORIZON 28)) 55) 28)
        (SDL_SetRenderDrawColor renderer (+ 75 glow) (+ 105 glow) (+ 125 glow) 255)
        (SDL_RenderDrawLine renderer 0 y W y)
        set y (+ y 1)
    }
}

shadow draw_sky { assert true }

fn draw_ocean(renderer: SDL_Renderer, field: array<int>) -> void {
    # Draw far rows first. Each cell uses its local height gradient as a normal
    # proxy, so light changes with the actual 2D surface rather than screen Y.
    let mut row: int = (- ROWS 2)
    while (>= row 0) {
        let z0: float = (* (cast_float row) CELL_Z)
        let z1: float = (* (cast_float (+ row 1)) CELL_Z)
        let mut col: int = 0
        while (< col (- COLS 1)) {
            let wx0: float = (* (- (cast_float col) (/ (cast_float COLS) 2.0)) CELL_X)
            let wx1: float = (+ wx0 CELL_X)
            let h00: float = (sample_height field col row)
            let h10: float = (sample_height field (+ col 1) row)
            let h01: float = (sample_height field col (+ row 1))
            let h11: float = (sample_height field (+ col 1) (+ row 1))
            let p00: ScreenPoint = (project_point wx0 h00 z0)
            let p10: ScreenPoint = (project_point wx1 h10 z0)
            let p01: ScreenPoint = (project_point wx0 h01 z1)
            let p11: ScreenPoint = (project_point wx1 h11 z1)

            let slope_x: float = (/ (- h10 h00) CELL_X)
            let slope_z: float = (/ (- h01 h00) CELL_Z)
            let normal_light: float = (- (- 0.35 slope_x) slope_z)
            let light: int = (clamp_int (cast_int (+ 118.0 (* 62.0 normal_light))) 45 205)
            let depth_blue: int = (clamp_int (+ 65 (/ (* row 90) ROWS)) 65 180)
            (SDL_SetRenderDrawColor renderer (/ light 5) (/ (+ light 90) 2) depth_blue 255)
            # Dense cross-hatched cells read as a continuous moving surface and
            # preserve the two-dimensional wave direction at distance.
            (SDL_RenderDrawLine renderer p00.x p00.y p10.x p10.y)
            (SDL_RenderDrawLine renderer p00.x p00.y p01.x p01.y)
            # Both diagonals expose all four triangular facets in each cell.
            (SDL_RenderDrawLine renderer p00.x p00.y p11.x p11.y)
            (SDL_RenderDrawLine renderer p10.x p10.y p01.x p01.y)
            set col (+ col 1)
        }
        set row (- row 1)
    }
}

shadow draw_ocean { assert true }

fn draw_wake(renderer: SDL_Renderer, ship_x: float, ship_z: float, tick: int) -> void {
    let mut segment: int = 1
    while (< segment 18) {
        let z: float = (- ship_z (* (cast_float segment) 2.1))
        let spread: float = (+ 2.0 (* (cast_float segment) 0.62))
        let pulse: float = (* 0.7 (sin (* (cast_float (+ tick (* segment 9))) 0.045)))
        let left: ScreenPoint = (project_point (- ship_x (+ spread pulse)) 0.25 z)
        let right: ScreenPoint = (project_point (+ ship_x (+ spread pulse)) 0.25 z)
        let alpha_col: int = (clamp_int (- 235 (* segment 9)) 70 235)
        (SDL_SetRenderDrawColor renderer alpha_col alpha_col 245 255)
        (SDL_RenderDrawLine renderer left.x left.y right.x right.y)
        set segment (+ segment 1)
    }
}

shadow draw_wake { assert true }

fn ship_half_height(x: float) -> float {
    let normalized: float = (/ x 168.0)
    let profile: float = (- 1.0 (* normalized normalized))
    if (< profile 0.0) { return 0.0 }
    return (* 30.0 (sqrt profile))
}

shadow ship_half_height {
    assert (> (ship_half_height 0.0) 29.9)
    assert (< (ship_half_height 168.0) 0.1)
}

fn draw_ship(renderer: SDL_Renderer, center_x: int, center_y: int,
             pitch: float, roll: float) -> void {
    let length_step: float = (/ 336.0 (cast_float SHIP_LENGTH_SEGMENTS))
    let mut segment: int = 0
    while (< segment SHIP_LENGTH_SEGMENTS) {
        let x0: float = (+ -168.0 (* (cast_float segment) length_step))
        let x1: float = (+ x0 length_step)
        let half0: float = (ship_half_height x0)
        let half1: float = (ship_half_height x1)
        let pitch0: float = (* pitch x0)
        let pitch1: float = (* pitch x1)
        let mut band: int = 0
        while (< band SHIP_HEIGHT_SEGMENTS) {
            let v0: float = (- (/ (* (cast_float band) 2.0) (cast_float SHIP_HEIGHT_SEGMENTS)) 1.0)
            let v1: float = (- (/ (* (cast_float (+ band 1)) 2.0) (cast_float SHIP_HEIGHT_SEGMENTS)) 1.0)
            let y00: int = (cast_int (+ (+ (cast_float center_y) pitch0) (+ (* v0 half0) (* (* roll v0) 22.0))))
            let y01: int = (cast_int (+ (+ (cast_float center_y) pitch0) (+ (* v1 half0) (* (* roll v1) 22.0))))
            let y10: int = (cast_int (+ (+ (cast_float center_y) pitch1) (+ (* v0 half1) (* (* roll v0) 22.0))))
            let y11: int = (cast_int (+ (+ (cast_float center_y) pitch1) (+ (* v1 half1) (* (* roll v1) 22.0))))
            let sx0: int = (+ center_x (cast_int x0))
            let sx1: int = (+ center_x (cast_int x1))
            let shade: int = (+ 34 (/ (* band 150) SHIP_HEIGHT_SEGMENTS))
            (SDL_SetRenderDrawColor renderer shade (+ shade 8) (+ shade 16) 255)
            (SDL_RenderDrawLine renderer sx0 y00 sx1 y10)
            (SDL_RenderDrawLine renderer sx0 y00 sx0 y01)
            (SDL_RenderDrawLine renderer sx0 y00 sx1 y11)
            (SDL_RenderDrawLine renderer sx1 y10 sx0 y01)
            set band (+ band 1)
        }
        set segment (+ segment 1)
    }

    # The bridge is another fine triangular lattice rather than one rectangle.
    let mut deck: int = 0
    while (< deck 12) {
        let deck_y: int = (- center_y (+ 33 (* deck 3)))
        let deck_half: int = (- 74 (* deck 3))
        let mut panel: int = 0
        while (< panel 48) {
            let x0: int = (- center_x deck_half)
            let x1: int = (+ x0 (/ (* panel (* deck_half 2)) 48))
            let x2: int = (+ x0 (/ (* (+ panel 1) (* deck_half 2)) 48))
            let next_y: int = (- deck_y 3)
            (SDL_SetRenderDrawColor renderer (+ 118 (* deck 5)) (+ 132 (* deck 5)) (+ 142 (* deck 5)) 255)
            (SDL_RenderDrawLine renderer x1 deck_y x2 deck_y)
            (SDL_RenderDrawLine renderer x1 deck_y x2 next_y)
            (SDL_RenderDrawLine renderer x1 next_y x2 deck_y)
            set panel (+ panel 1)
        }
        set deck (+ deck 1)
    }

    # Mast, radar bars, bridge glazing, and navigation lights survive the mesh.
    (SDL_SetRenderDrawColor renderer 22 31 42 255)
    (nl_sdl_render_fill_rect renderer (- center_x 62) (- center_y 49) 124 8)
    (nl_sdl_render_fill_rect renderer (- center_x 8) (- center_y 112) 16 63)
    (SDL_SetRenderDrawColor renderer 155 210 226 255)
    (SDL_RenderDrawLine renderer (- center_x 42) (- center_y 83) (+ center_x 42) (- center_y 83))
    (SDL_RenderDrawLine renderer (- center_x 34) (- center_y 93) (+ center_x 34) (- center_y 93))
    (SDL_SetRenderDrawColor renderer 230 60 45 255)
    (nl_sdl_render_fill_rect renderer (- center_x 45) (- center_y 87) 6 6)
    (SDL_SetRenderDrawColor renderer 55 230 110 255)
    (nl_sdl_render_fill_rect renderer (+ center_x 39) (- center_y 87) 6 6)
}

shadow draw_ship { assert true }

fn main() -> int {
    let mut sine: array<int> = []
    let mut i: int = 0
    while (< i SIN_N) {
        let angle: float = (* (cast_float i) (/ 6.283185307 (cast_float SIN_N)))
        set sine (array_push sine (cast_int (* (sin angle) 1000.0)))
        set i (+ i 1)
    }
    let mut field: array<int> = []
    set i 0
    while (< i (* COLS ROWS)) {
        set field (array_push field 0)
        set i (+ i 1)
    }
    let mut pixels: array<int> = []
    set i 0
    while (< i (* W H)) {
        set pixels (array_push pixels 0)
        set i (+ i 1)
    }

    let mut gpu_ready: bool = (gpu_init)
    let mut d_sine: int = 0
    let mut d_field: int = 0
    let mut d_pixels: int = 0
    if gpu_ready {
        (println (+ "Ocean compute: " (gpu_device_info 0)))
        set d_sine (gpu_alloc (* SIN_N 8))
        set d_field (gpu_alloc (* (* COLS ROWS) 8))
        set d_pixels (gpu_alloc (* (* W H) 8))
        if (or (or (== d_sine 0) (== d_field 0)) (== d_pixels 0)) {
            (println (+ "I cannot allocate the ocean field: " (gpu_last_error)))
            set gpu_ready false
        }
        if gpu_ready {
            if (not (gpu_memcpy_to_device d_sine sine (* SIN_N 8))) {
                (println (+ "I cannot upload the wave table: " (gpu_last_error)))
                set gpu_ready false
            }
        }
    } else {
        (println "No CUDA or OpenCL runtime accepted the ocean kernel; I am using the tested CPU equivalent.")
    }

    if (!= (SDL_Init SDL_INIT_VIDEO) 0) {
        (println (+ "I cannot initialize SDL: " (SDL_GetError)))
        return 1
    }
    let window: SDL_Window = (SDL_CreateWindow "NanoLang GPU Ocean"
        SDL_WINDOWPOS_CENTERED SDL_WINDOWPOS_CENTERED W H SDL_WINDOW_SHOWN)
    if (== window 0) {
        (println (+ "I cannot create the ocean window: " (SDL_GetError)))
        (SDL_Quit)
        return 1
    }
    let mut renderer: SDL_Renderer = (SDL_CreateRenderer window -1
        (+ SDL_RENDERER_ACCELERATED SDL_RENDERER_PRESENTVSYNC))
    if (== renderer 0) { set renderer (SDL_CreateRenderer window -1 SDL_RENDERER_SOFTWARE) }
    if (== renderer 0) {
        (println (+ "I cannot create the ocean renderer: " (SDL_GetError)))
        (SDL_DestroyWindow window)
        (SDL_Quit)
        return 1
    }
    let texture: SDL_Texture = (SDL_CreateTexture renderer 372645892 1 W H)
    if (== texture 0) {
        (println (+ "I cannot create the ocean texture: " (SDL_GetError)))
        if (!= d_sine 0) { (gpu_free d_sine) }
        if (!= d_field 0) { (gpu_free d_field) }
        if (!= d_pixels 0) { (gpu_free d_pixels) }
        (SDL_DestroyRenderer renderer)
        (SDL_DestroyWindow window)
        (SDL_Quit)
        return 1
    }

    let ship_col: int = (/ COLS 2)
    let ship_row: int = 15
    let ship_world_z: float = (* (cast_float ship_row) CELL_Z)
    let mut heave: float = 0.0
    let mut heave_v: float = 0.0
    let mut pitch: float = 0.0
    let mut pitch_v: float = 0.0
    let mut roll: float = 0.0
    let mut roll_v: float = 0.0
    let mut tick: int = 0
    let mut running: bool = true

    while running {
        if (== (nl_sdl_poll_event_quit) 1) { set running false }
        let key: int = (nl_sdl_poll_keypress)
        if (or (== key 41) (== key 20)) { set running false }

        let mut frame_on_gpu: bool = false
        if gpu_ready {
            let block_x: int = 8
            let block_y: int = 8
            let grid_x: int = (/ (+ COLS (- block_x 1)) block_x)
            let grid_y: int = (/ (+ ROWS (- block_y 1)) block_y)
            let launched: bool = (gpu_launch2d "examples/gpu/ocean.ptx" "compute_ocean"
                grid_x grid_y block_x block_y d_sine d_field COLS tick)
            if launched {
                (gpu_sync)
                set frame_on_gpu (gpu_memcpy_from_device field d_field (* (* COLS ROWS) 8))
            }
            if frame_on_gpu {
                let pixel_grid_x: int = (/ (+ W (- block_x 1)) block_x)
                let pixel_grid_y: int = (/ (+ H (- block_y 1)) block_y)
                set frame_on_gpu (gpu_launch2d "examples/gpu/ocean.ptx" "shade_ocean"
                    pixel_grid_x pixel_grid_y block_x block_y d_sine d_pixels W tick)
                if frame_on_gpu {
                    (gpu_sync)
                    set frame_on_gpu (gpu_memcpy_from_device pixels d_pixels (* (* W H) 8))
                }
            }
            if (not frame_on_gpu) {
                (println (+ "The GPU ocean kernel failed; I am switching to CPU: " (gpu_last_error)))
                set gpu_ready false
            }
        }
        if (not frame_on_gpu) {
            let mut cpu_row: int = 0
            while (< cpu_row ROWS) {
                let mut cpu_col: int = 0
                while (< cpu_col COLS) {
                    (array_set field (field_index cpu_col cpu_row)
                        (cpu_height sine cpu_col cpu_row tick))
                    set cpu_col (+ cpu_col 1)
                }
                set cpu_row (+ cpu_row 1)
            }
        }

        # Nine distributed hull stations: bow/mid/stern crossed with port,
        # centre, and starboard. Their averages drive three damped responses.
        let stern_h: float = (/ (+ (+ (sample_height field (- ship_col 8) (- ship_row 2))
            (sample_height field (- ship_col 8) ship_row))
            (sample_height field (- ship_col 8) (+ ship_row 2))) 3.0)
        let mid_h: float = (/ (+ (+ (sample_height field ship_col (- ship_row 2))
            (sample_height field ship_col ship_row))
            (sample_height field ship_col (+ ship_row 2))) 3.0)
        let bow_h: float = (/ (+ (+ (sample_height field (+ ship_col 8) (- ship_row 2))
            (sample_height field (+ ship_col 8) ship_row))
            (sample_height field (+ ship_col 8) (+ ship_row 2))) 3.0)
        let port_h: float = (/ (+ (+ (sample_height field (- ship_col 8) (- ship_row 2))
            (sample_height field ship_col (- ship_row 2)))
            (sample_height field (+ ship_col 8) (- ship_row 2))) 3.0)
        let starboard_h: float = (/ (+ (+ (sample_height field (- ship_col 8) (+ ship_row 2))
            (sample_height field ship_col (+ ship_row 2)))
            (sample_height field (+ ship_col 8) (+ ship_row 2))) 3.0)

        let heave_force: float = (- (* 4.8 (- mid_h heave)) (* 2.9 heave_v))
        set heave_v (+ heave_v (* heave_force DT))
        set heave (+ heave (* heave_v DT))
        let target_pitch: float = (/ (- bow_h stern_h) 51.2)
        let pitch_force: float = (- (* 7.0 (- target_pitch pitch)) (* 3.4 pitch_v))
        set pitch_v (+ pitch_v (* pitch_force DT))
        set pitch (+ pitch (* pitch_v DT))
        let target_roll: float = (/ (- starboard_h port_h) 13.6)
        let roll_force: float = (- (* 8.0 (- target_roll roll)) (* 3.8 roll_v))
        set roll_v (+ roll_v (* roll_force DT))
        set roll (+ roll (* roll_v DT))

        (SDL_SetRenderDrawColor renderer 5 12 27 255)
        (SDL_RenderClear renderer)
        if frame_on_gpu {
            (nl_sdl_update_texture texture pixels W H)
            (nl_sdl_render_texture renderer texture 0 0 W H)
        } else {
            (draw_sky renderer)
            (draw_ocean renderer field)
        }
        (draw_wake renderer 0.0 ship_world_z tick)
        let ship_screen: ScreenPoint = (project_point 0.0 (+ heave 1.8) ship_world_z)
        (draw_ship renderer ship_screen.x ship_screen.y pitch roll)
        (SDL_RenderPresent renderer)
        (SDL_Delay 16)
        set tick (+ tick 1)
    }

    if (!= d_sine 0) { (gpu_free d_sine) }
    if (!= d_field 0) { (gpu_free d_field) }
    if (!= d_pixels 0) { (gpu_free d_pixels) }
    (SDL_DestroyTexture texture)
    (SDL_DestroyRenderer renderer)
    (SDL_DestroyWindow window)
    (SDL_Quit)
    return 0
}

shadow main { assert true }
