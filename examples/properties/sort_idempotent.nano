# Example: Property Test Laws
# Purpose: Demonstrate passing property tests for integer and boolean laws
# Features: property tests, generated inputs, shrinking, shadow tests
# Difficulty: Intermediate
# Category: properties
# Prerequisites: none
# Track: learn
# Build: local
# Dependencies: proptest runner
# Tags: properties, testing
# Expected Output: all properties pass
#
# Example property tests for nanolang --proptest mode
#
# Functions prefixed with prop_ are automatically discovered by the proptest
# runner (nano --proptest sort_idempotent.nano).
#
# Each property function must:
#   - Accept typed parameters (int, float, bool, string)
#   - Return bool (true = property holds, false = counterexample found)
#
# The runner generates 100 random inputs per property and shrinks failures
# to find a minimal counterexample.

# ── Integer properties ────────────────────────────────────────────────────

# @property
# Addition is commutative: a + b == b + a
fn prop_add_commutative(a: int, b: int) -> bool {
    return (== (+ a b) (+ b a))
}

shadow prop_add_commutative {
    assert (prop_add_commutative 2 5)
    assert (prop_add_commutative -7 3)
}

# @property
# Adding zero is identity: a + 0 == a
fn prop_add_identity(a: int) -> bool {
    return (== (+ a 0) a)
}

shadow prop_add_identity {
    assert (prop_add_identity 0)
    assert (prop_add_identity -9)
}

# @property
# Absolute value is non-negative
fn prop_abs_nonnegative(x: int) -> bool {
    let mut ax: int = 0
    if (< x 0) {
        set ax (* x -1)
    } else {
        set ax x
    }
    return (>= ax 0)
}

shadow prop_abs_nonnegative {
    assert (prop_abs_nonnegative -8)
    assert (prop_abs_nonnegative 0)
}

# @property
# Multiplication is commutative: a * b == b * a
fn prop_mul_commutative(a: int, b: int) -> bool {
    return (== (* a b) (* b a))
}

shadow prop_mul_commutative {
    assert (prop_mul_commutative 3 4)
    assert (prop_mul_commutative -2 6)
}

# @property
# Multiply by zero always yields zero
fn prop_mul_zero(a: int) -> bool {
    return (== (* a 0) 0)
}

shadow prop_mul_zero {
    assert (prop_mul_zero 12)
    assert (prop_mul_zero -1)
}

# @property
# Multiply by one is identity: a * 1 == a
fn prop_mul_identity(a: int) -> bool {
    return (== (* a 1) a)
}

shadow prop_mul_identity {
    assert (prop_mul_identity 12)
    assert (prop_mul_identity -1)
}

# ── Boolean properties ───────────────────────────────────────────────────

# @property
# Bool negation is an involution: not (not x) == x
fn prop_bool_double_neg(x: bool) -> bool {
    return (== (not (not x)) x)
}

shadow prop_bool_double_neg {
    assert (prop_bool_double_neg true)
    assert (prop_bool_double_neg false)
}

# @property
# x or (not x) is always true (excluded middle)
fn prop_bool_excluded_middle(x: bool) -> bool {
    return (or x (not x))
}

shadow prop_bool_excluded_middle {
    assert (prop_bool_excluded_middle true)
    assert (prop_bool_excluded_middle false)
}

# ── Entry point ───────────────────────────────────────────────────────────
# Run with:  nano --proptest examples/properties/sort_idempotent.nano
fn main() -> int {
    (println "Run with: nano --proptest examples/properties/sort_idempotent.nano")
    return 0
}

shadow main { assert (== (main) 0) }
