# Example: Explicit Record Projection
# Purpose: I show the concrete record conversion used while open row types remain unsupported
# Features: structs, explicit projection, record construction
# Difficulty: Intermediate
# Category: language
# Prerequisites: nl_struct
# Track: language
# Build: local
# Dependencies: none
# Tags: records, explicit-conversion, shadow-tested
# Expected Output: Hello, Alice!

struct Named { name: string }
struct User { name: string, age: int }

fn as_named(user: User) -> Named {
    return Named { name: user.name }
}

shadow as_named {
    let named: Named = (as_named User { name: "Ada", age: 36 })
    assert (== named.name "Ada")
}

fn greet(person: Named) -> string {
    return (+ "Hello, " (+ person.name "!"))
}

shadow greet {
    assert (== (greet Named { name: "Alice" }) "Hello, Alice!")
}

fn main() -> int {
    let user: User = User { name: "Alice", age: 30 }
    (println (greet (as_named user)))
    return 0
}

shadow main {
    assert (== (main) 0)
}
