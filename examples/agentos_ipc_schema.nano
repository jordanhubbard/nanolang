# Example: IPC Message Schema
# Purpose: I model a small IPC envelope with explicit concrete message records
# Features: structs, validation, deterministic local fixtures
# Difficulty: Intermediate
# Category: language
# Prerequisites: nl_struct
# Track: applications
# Build: local
# Dependencies: none
# Tags: ipc, records, validation, shadow-tested
# Expected Output: spawn worker: valid

struct SpawnMessage { id: string, timestamp: int, image: string, args: string }

fn valid_spawn(message: SpawnMessage) -> bool {
    return (and (> (str_length message.id) 0) (> (str_length message.image) 0))
}

shadow valid_spawn {
    let valid: SpawnMessage = SpawnMessage { id: "msg-1", timestamp: 10, image: "worker", args: "--once" }
    let invalid: SpawnMessage = SpawnMessage { id: "", timestamp: 10, image: "worker", args: "" }
    assert (valid_spawn valid)
    assert (not (valid_spawn invalid))
}

fn describe_spawn(message: SpawnMessage) -> string {
    return (+ "spawn " (+ message.image (cond ((valid_spawn message) ": valid") (else ": invalid"))))
}

shadow describe_spawn {
    let message: SpawnMessage = SpawnMessage { id: "msg-1", timestamp: 10, image: "worker", args: "--once" }
    assert (== (describe_spawn message) "spawn worker: valid")
}

fn main() -> int {
    let message: SpawnMessage = SpawnMessage { id: "msg-1", timestamp: 10, image: "worker", args: "--once" }
    (println (describe_spawn message))
    return 0
}

shadow main {
    assert (== (main) 0)
}
