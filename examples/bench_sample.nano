# Example: Bench sample
# Purpose: Two tiny zero-parameter workloads for nanoc --bench
# Features: loops, integers, shadow tests
# Difficulty: Beginner
# Category: language
# Prerequisites: nl_hello
# Track: internal
# Build: local
# Dependencies: none
# Tags: shadow-tested, native-compatible
# Expected Output: bench JSON

fn bench_add_loop() -> int {
    let mut total: int = 0
    let mut i: int = 0
    while (< i 64) {
        set total (+ total i)
        set i (+ i 1)
    }
    return total
}

shadow bench_add_loop {
    assert (== (bench_add_loop) 2016)
}

fn bench_mul_loop() -> int {
    let mut total: int = 1
    let mut i: int = 1
    while (<= i 8) {
        set total (* total i)
        set i (+ i 1)
    }
    return total
}

shadow bench_mul_loop {
    assert (== (bench_mul_loop) 40320)
}

fn main() -> int {
    (println (int_to_string (bench_add_loop)))
    (println (int_to_string (bench_mul_loop)))
    return 0
}

shadow main {
    assert (== (main) 0)
}
