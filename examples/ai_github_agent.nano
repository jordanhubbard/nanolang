# Example: Offline Issue Triage
# Purpose: I show deterministic issue prompt construction without contacting GitHub or an LLM
# Features: structs, local fixtures, prompt construction, classification
# Difficulty: Intermediate
# Category: language
# Prerequisites: nl_struct, nl_string_operations
# Track: applications
# Build: local
# Dependencies: none
# Tags: agent, offline, deterministic, shadow-tested
# Expected Output: issue #42: high

struct Issue {
    number: int,
    title: string,
    body: string
}

fn classify_issue(issue: Issue) -> string {
    if (or (str_contains issue.title "crash") (str_contains issue.body "data loss")) {
        return "high"
    } else {
        if (str_contains issue.title "docs") { return "low" } else { return "medium" }
    }
}

shadow classify_issue {
    let crash: Issue = Issue { number: 1, title: "compiler crash", body: "on empty input" }
    let docs: Issue = Issue { number: 2, title: "docs typo", body: "one word" }
    let feature: Issue = Issue { number: 3, title: "add tuples", body: "proposal" }
    assert (== (classify_issue crash) "high")
    assert (== (classify_issue docs) "low")
    assert (== (classify_issue feature) "medium")
}

fn build_analysis_prompt(issue: Issue) -> string {
    return (+ "Issue #" (+ (int_to_string issue.number) (+ ": " (+ issue.title (+ "\n\n" issue.body)))))
}

shadow build_analysis_prompt {
    let issue: Issue = Issue { number: 42, title: "parser crash", body: "empty input" }
    let prompt: string = (build_analysis_prompt issue)
    assert (str_contains prompt "Issue #42")
    assert (str_contains prompt "empty input")
}

fn main() -> int {
    let issue: Issue = Issue { number: 42, title: "compiler crash", body: "A malformed module causes data loss." }
    (println (+ "issue #42: " (classify_issue issue)))
    (println (build_analysis_prompt issue))
    return 0
}

shadow main {
    assert (== (main) 0)
}
