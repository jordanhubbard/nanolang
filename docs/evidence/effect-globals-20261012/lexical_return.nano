resource struct Handle{value:int}
fn consume(h:Handle)->int{let Handle{value}=h return value}
shadow consume{assert (== (consume Handle{value:7}) 7)}
let mut total:int=0 effect E{tick:int->int}
fn main()->int{handle {perform E.tick(3)} with {tick value->{set total (+ value 4) return total}} return 0}
shadow main{assert true}
