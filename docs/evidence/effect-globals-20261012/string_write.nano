resource struct Handle{value:int}
fn consume(h:Handle)->int{let Handle{value}=h return value}
shadow consume{assert (== (consume Handle{value:7}) 7)}
let mut text:string="before" effect E{tick:string->string}
fn main()->int{let got:string=handle {perform E.tick("after")} with {tick value->{set text value value}} assert (== got text) assert (== text "after") return 7}
shadow main{assert true}
