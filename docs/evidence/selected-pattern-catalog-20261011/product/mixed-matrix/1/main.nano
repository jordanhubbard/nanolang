resource struct Unused { value: int } fn consume(h: Unused) -> int { let Unused { value } = h return value } shadow consume { assert (== (consume Unused { value: 7 }) 7) }
union Box<T> { Some { value: T }, Other { value: T }, None {} }
fn read(boxed: Box<string>) -> int { match boxed {
 Some(payload) => { let Box.Some { value } = payload assert (== value payload.value) return 7 }
 Other(payload) => { return 0 }
 None(payload) => { let Box.None {} = payload return 0 }
} }
shadow read { let boxed: Box<string> = Box.Some { value: "kept" } assert (== (read boxed) 7) let empty: Box<string> = Box.None {} assert (== (read empty) 0) }
fn main() -> int { let boxed: Box<string> = Box.Some { value: "kept" } return (- (read boxed) 7) }
shadow main { assert (== (main) 0) }
