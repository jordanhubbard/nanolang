resource struct Handle{value:int}
fn consume(h:Handle)->int{let Handle{value}=h return value}
shadow consume{assert (== (consume Handle{value:7}) 7)}
resource struct Batch{items:array<int>} effect E{pass:Batch->Batch}
fn main()->int{let b:Batch=handle {perform E.pass(Batch{items:[7]})} with {pass b->{b}} let Batch{items}=b return (at items 0)}
shadow main{assert true}
