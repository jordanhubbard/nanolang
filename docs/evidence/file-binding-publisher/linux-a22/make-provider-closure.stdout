/usr/bin/gcc  -Wall -Wextra -Werror -std=c99 -g -O3 -ftree-vectorize -fPIC -Isrc -D_GNU_SOURCE  -o bin/nsi-file-binding obj/file-binding-publisher/nsi_file_binding_main.o obj/file-binding-publisher/nsi_file_publish.o obj/file-binding-publisher/nsi_file_binding.o obj/file-binding-publisher/nsi_file_plan.o obj/file-binding-publisher/nsi.o obj/file-binding-publisher/cJSON.o obj/file-binding-publisher/utf8.o -lm -lcrypto -lffi  -rdynamic
