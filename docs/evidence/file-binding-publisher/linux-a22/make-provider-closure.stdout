/usr/bin/gcc  -Wall -Wextra -Werror -std=c99 -g -O3 -ftree-vectorize -fPIC -Isrc -D_GNU_SOURCE  -MMD -MP -c "src/nsi_file_binding.c" -o "obj/file-binding-publisher/nsi_file_binding.o"
/usr/bin/gcc  -Wall -Wextra -Werror -std=c99 -g -O3 -ftree-vectorize -fPIC -Isrc -D_GNU_SOURCE  -MMD -MP -c "src/nsi_file_plan.c" -o "obj/file-binding-publisher/nsi_file_plan.o"
/usr/bin/gcc  -Wall -Wextra -Werror -std=c99 -g -O3 -ftree-vectorize -fPIC -Isrc -D_GNU_SOURCE  -MMD -MP -c "src/nsi.c" -o "obj/file-binding-publisher/nsi.o"
