+# I share ordinary value admission with locals while excluding resource storage.
+fn nisa_union_value_type_seen(parser: Parser, t: string, signatures: array<string>) -> bool {
+    if (>= (nisa_opaque_index parser t) 0) { return false }
+    if (not (nisa_tuple_storage_ok parser t [])) { return false }
+    return (nisa_type_ok_seen parser t signatures)
+}
+shadow nisa_union_value_type_seen {
+    let tokens: List<LexerToken> = (tokenize_string "struct Item { label:string } resource struct Handle { value:int } union Box<T> { Some {value:T} }" "union-value.nano" (diag_list_new))
+    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "union-value.nano")
+    assert (nisa_union_value_type_seen parser "Item" [])
+    assert (nisa_union_value_type_seen parser "array<Item>" [])
+    assert (nisa_union_value_type_seen parser "List<string>" [])
+    assert (nisa_union_value_type_seen parser "(int,string)" [])
+    assert (not (nisa_union_value_type_seen parser "Handle" []))
+    assert (not (nisa_union_value_type_seen parser "array<Handle>" []))
+    assert (not (nisa_union_value_type_seen parser "Box<Handle>" []))
+}
