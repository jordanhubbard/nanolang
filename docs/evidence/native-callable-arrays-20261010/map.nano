fn increment(value:int)->int{return (+ value 1)}
shadow increment {assert (== (increment 7) 8)}
fn apply(callback:fn(int)->int)->int{return (callback 7)}
shadow apply {assert (== (apply increment) 8)}
fn main()->int {
let callbacks:array<fn(int)->int> = [increment]
let values:array<int> = (map callbacks apply)
assert (== (at values 0) 8)
return 0
}
shadow main {assert (== (main) 0)}
