or (int i = 0; i < tuple->element_count; i++) {\n         if (tuple->elements[i].type == VAL_STRING && tuple->elements[i].as.string_val) {\n             free(tuple->elements[i].as.string_val);\n+        } else if (tuple->elements[i].type == VAL_FUNCTION) {\n+            free(tuple->elements[i].as.function_val.function_name);\n+            free_function_signature(tuple->elements[i].as.function_val.signature);\n         }\n     }\n     \ndiff --git a/src/eval.c b/src/eval.c\nindex dd40d3dce..0cf7f0b0c 100644\n--- a/src/eval.c\n+++ b/src/eval.c\n@@ -5791,6 +5791,9 @@ static Value eval_expression(ASTNode *expr, Environment *env) {\n                 return create_void();\n             }\n             \n+            /* I return an independently owned callable, as array reads do. */\n+            if (tv->elements[index].type == VAL_FUNCTION)\n+                return copy_array_callable(tv->elements[index]);\n             return tv->elements[index];\n         }\n \ndiff --git a/src/transpiler.c b/src/transpiler.c\nindex 9611e946a..c4ef6edc1 100644\n--- a/src/transpiler.c\n+++ b/src/transpiler.c\n@@ -3472,6 +3472,8 @@ static void generate_module_function_declarations(StringBuilder *sb, ASTNode *pr\n                 } else {\n                     sb_append(sb, \"void*\");\n                 }\n+            } else if (mi->as.function.return_type == TYPE_TUPLE && mi->as.function.return_type_info) {\n+                emit_signature_type(sb, env, TYPE_TUPLE, NULL, mi->as.function.return_type_info);\n             } else if (mi->as.function.return_type == TYPE_FUNCTION) {\n                 /* Avoid emitting incorrect prototypes (not needed for current stdlib) */\n                 continue;\n@@ -3526,6 +3528,8 @@ static void generate_module_function_declarations(StringBuilder *sb, ASTNode *pr\n                     } else {\n                         sb_append(sb, \"void*\");\n                     }\n+                } else if (param->type == TYPE_TUPLE && param->type_info) {\n+       