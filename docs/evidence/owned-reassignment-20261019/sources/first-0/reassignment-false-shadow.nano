}
fn nlr_f1_owned_1(nlr_a0: &mut NlrOwned0) -> int {
    let mut nlr_rs_a: int = 0
    let mut nlr_rs_b: int = 0
    let nlr_rs_low: int = (- -9223372036854775807 1)
    let nlr_rs_high: int = 9223372036854775807
    let mut nlr_rs_boundary: int = 0
    let nlr_t0: int = nlr_a0.f0
    set nlr_rs_a nlr_t0
    set nlr_rs_b 1
    let mut nlr_t14: int = 0
    if (> nlr_rs_b 0) {
        set nlr_rs_boundary (- nlr_rs_high nlr_rs_b)
        if (> nlr_rs_a nlr_rs_boundary) { set nlr_t14 (+ nlr_rs_low (- (- nlr_rs_a nlr_rs_boundary) 1)) } else { set nlr_t14 (+ nlr_rs_a nlr_rs_b) }
    } else { if (< nlr_rs_b 0) {
        set nlr_rs_boundary (- nlr_rs_low nlr_rs_b)
        if (< nlr_rs_a nlr_rs_boundary) { set nlr_t14 (+ nlr_rs_high (+ (- nlr_rs_a nlr_rs_boundary) 1)) } else { set nlr_t14 (+ nlr_rs_a nlr_rs_b) }
    } else { set nlr_t14 (+ nlr_rs_a nlr_rs_b) } }
    set nlr_a0.f0 nlr_t14
    let nlr_t20: int = nlr_a0.f0
    return nlr_t20
}

