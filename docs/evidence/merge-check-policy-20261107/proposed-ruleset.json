{
  "name": "sanity",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "~DEFAULT_BRANCH"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "required_reviewers": [],
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "require_extra_approval_for_unattributed_changes": true,
        "allowed_merge_methods": [
          "merge",
          "squash",
          "rebase"
        ]
      }
    },
    {
      "type": "copilot_code_review",
      "parameters": {
        "review_on_push": true,
        "review_draft_pull_requests": false
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Build and Test (ubuntu-latest, x64)"
          },
          {
            "context": "Build and Test (ubuntu-24.04-arm, arm64)"
          },
          {
            "context": "Build and Test (macos-14, arm64)"
          },
          {
            "context": "Code Coverage"
          },
          {
            "context": "Strict examples (x64)"
          },
          {
            "context": "Strict examples (arm64)"
          },
          {
            "context": "Docs (link check)"
          },
          {
            "context": "API Docs (nanodoc)"
          },
          {
            "context": "Code Quality"
          },
          {
            "context": "Concurrency (clang + libdispatch)"
          },
          {
            "context": "Benchmark measurement check"
          },
          {
            "context": "Fast gate (GCC and clang)"
          },
          {
            "context": "Immutable instrumented toolchain"
          },
          {
            "context": "Memory Sanitizers Stage 1"
          },
          {
            "context": "Memory Sanitizers"
          },
          {
            "context": "Coverage compiler generations"
          },
          {
            "context": "Performance Benchmarks"
          },
          {
            "context": "Qualification (retirement, ubuntu-latest)"
          },
          {
            "context": "Qualification (retirement, xcode-27)"
          },
          {
            "context": "Qualification (compiler-contracts, ubuntu-latest)"
          },
          {
            "context": "Qualification (compiler-contracts, xcode-27)"
          },
          {
            "context": "Qualification (contract-effects, ubuntu-latest)"
          },
          {
            "context": "Qualification (contract-effects, xcode-27)"
          },
          {
            "context": "Qualification (record-maps, ubuntu-latest)"
          },
          {
            "context": "Qualification (record-maps, xcode-27)"
          }
        ]
      }
    }
  ]
}
