struct Box { rows:array<array<float>> }
fn main()->int {
 let box:Box=Box{rows:[[]]}
 let alias:array<array<float>> =box.rows
 (array_set box.rows 0 [])
 let row:array<float> =(at alias 0)
 let filled:array<float> =(array_push row 1.25)
 assert (== (at filled 0) 1.25)
 let added:array<array<float>> =(array_push box.rows [])
 let last:array<float> =(array_push (at added 1) 1.25)
 assert (== (at last 0) 1.25)
 (array_set added 0 [1.25])
 assert (== (at (at added 0) 0) 1.25)
 let literal:array<array<float>> =(array_push added [1.25])
 assert (== (at (at literal 2) 0) 1.25)
 return 0
}
shadow main {assert (== (main) 0)}
