struct Box { rows:array<array<bool>> }
fn main()->int {
 let box:Box=Box{rows:[[]]}
 let alias:array<array<bool>> =box.rows
 (array_set box.rows 0 [])
 let row:array<bool> =(at alias 0)
 let filled:array<bool> =(array_push row true)
 assert (== (at filled 0) true)
 let added:array<array<bool>> =(array_push box.rows [])
 let last:array<bool> =(array_push (at added 1) true)
 assert (== (at last 0) true)
 (array_set added 0 [true])
 assert (== (at (at added 0) 0) true)
 let literal:array<array<bool>> =(array_push added [true])
 assert (== (at (at literal 2) 0) true)
 return 0
}
shadow main {assert (== (main) 0)}
