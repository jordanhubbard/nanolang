resource struct Leaf { value: int, enabled: bool }
resource struct Pair { left: Leaf, right: Leaf }
resource struct Tree { branch: Pair }
fn read(first: &Leaf, second: &Leaf) -> int { assert second.enabled return (+ (* first.value 10) second.value) }
shadow read {
 let one: Leaf = Leaf { value: 2, enabled: true }
 let two: Leaf = Leaf { value: 7, enabled: true }
 let pair: Pair = Pair { right: two, left: one }
 let root: Tree = Tree { branch: pair }
 assert (== (read &root.branch.left &root.branch.left) 22)
 assert (== (read &root.branch.left &root.branch.right) 27)
 assert (== (read &root.branch.right &root.branch.left) 72)
 let Tree { branch } = root
 let Pair { left, right } = branch
 let Leaf { value, enabled } = left
 assert (== value 2) assert enabled
 let Leaf { value, enabled } = right
 assert (== value 7) assert enabled
}
fn main() -> int {
 let one: Leaf = Leaf { value: 2, enabled: true }
 let two: Leaf = Leaf { value: 7, enabled: true }
 let pair: Pair = Pair { right: two, left: one }
 let root: Tree = Tree { branch: pair }
 assert (== (read &root.branch.left &root.branch.left) 22)
 assert (== (read &root.branch.left &root.branch.right) 27)
 assert (== (read &root.branch.right &root.branch.left) 72)
 let Tree { branch } = root
 let Pair { left, right } = branch
 let Leaf { value, enabled } = left
 assert (== value 2) assert enabled
 let Leaf { value, enabled } = right
 assert (== value 7) assert enabled
 return 0
}
shadow main { assert true }
