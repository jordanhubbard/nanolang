 tests with sanitizers\n        # Sanitizer instrumentation is substantially slower, and the full\n        # instrumented unit suite outgrew the previous 45-minute budget: hosted\n        # run 37201123652 was cancelled at exactly 45 minutes while tests were\n        # still running. Raise the step well above that ceiling and keep the\n        # job-level limit above the step so a slow-but-progressing suite can\n        # finish.\n        timeout-minutes: 120\n        run: |\n          export ASAN_OPTIONS=detect_leaks=0\n          make test-units CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS"\n\n      - name: Run negative tests with sanitizers\n        env:\n          NANOLANG_COMPILER: ./bin/nanoc_c\n        run: |\n          export ASAN_OPTIONS=detect_leaks=0\n          bash tests/run_negative_tests.sh\n\n      - name: Retain verifier and bootstrap diagnostics\n        if: failure()\n        uses: actions/upload-artifact@v4\n        with:\n          name: verifier-corpus-sanitizers\n          path: |\n            .test_output/verifier-corpus/\n            .test_output/sanitizer-checkpoint-resume-plan.log\n            obj/component-logs/\n            obj/bootstrap-nanoisa/**/*.log\n            obj/bootstrap-nanoisa/**/manifest.json\n          include-hidden-files: true\n          if-no-files-found: ignore\n          retention-days: 7\n\n      - name: Show sanitizer error logs on failure\n        if: failure()\n        shell: bash\n        run: |\n          echo "=== Showing first 3 failed test logs ==="\n          for log in .test_output/*.compile.log; do\n            if [ -f "$log" ]; then\n              echo "=== $log ==="\n              cat "$log"\n              echo ""\n            fi\n          done | head -200\n\n  coverage:\n    name: Code Coverage\n    needs: fast-gate\n    if: needs.fast-gate.outputs.code == \'true\'\n    env:\n      NANO_SHADOW_TIMEOUT_SECONDS: "300"\n      CFLAGS: "-Wall -Wextra -Werror -std=c99 -O3 -g -Isrc -D_GNU_SOURCE -fprofile-arcs -ftest-cove