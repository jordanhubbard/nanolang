resource struct Box {value:int,flag:bool}
fn pick(owner:Box,count:int)->int {let mut i:int=0 while (< i count) {let Box{value,flag}=owner set i (+ i 1)} return i}
shadow pick {assert (== (main) 3)}
fn main()->int {return (+ (pick Box{value:7,flag:true} 3) (pick Box{value:7,flag:true} 0))}
shadow main {assert (== (main) 3)}
