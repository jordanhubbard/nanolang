resource struct Box {value:int,flag:bool}
fn pick(owner:Box,count:int)->int {let mut i:int=0 let mut sum:int=0 while (< i count) {let fresh:Box=Box{value:2,flag:true} let Box{value,flag}=fresh set sum (+ sum value) set i (+ i 1)} let Box{value,flag}=owner return (+ value sum)}
shadow pick {assert (== (main) 20)}
fn main()->int {return (+ (pick Box{value:7,flag:true} 3) (pick Box{value:7,flag:true} 0))}
shadow main {assert (== (main) 20)}
