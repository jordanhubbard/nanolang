resource struct Box {value:int,flag:bool}
fn pick(owner:Box,count:int)->int {let mut i:int=0 while (< i count) {if (== i 1) {let Box{value,flag}=owner return (+ value 100)} set i (+ i 1)} let Box{value,flag}=owner return value}
shadow pick {assert (== (main) 114)}
fn main()->int {return (+ (pick Box{value:7,flag:true} 3) (pick Box{value:7,flag:true} 0))}
shadow main {assert (== (main) 114)}
