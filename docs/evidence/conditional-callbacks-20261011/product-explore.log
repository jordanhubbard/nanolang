```python
27	import sys
28	import wave
29	
30	SAMPLE_RATE = 44100
31	SAMPLE_WIDTH = 2  # 16-bit PCM
32	CHANNELS = 1
33	DURATION_S = 1.5
34	AMPLITUDE = 0.35  # headroom below full scale; avoids clipping on mixdown
35	
36	# An A-major arpeggio: A4, C#5, E5, A5. Equal-tempered, rounded to 3 decimals
37	# so the frequencies are exact literals rather than platform-dependent
38	# computations.
39	NOTES_HZ = (440.000, 554.365, 659.255, 880.000)
40	
41	# Per-note and whole-file fades. Without these the note boundaries and the
42	# buffer edges produce audible clicks, which is exactly what a playback smoke
43	# test should not be teaching people to ignore.
44	NOTE_FADE_S = 0.008
45	FILE_FADE_S = 0.050
46	
47	
48	def _envelope(index: int, total: int, note_index: int, note_len: int) -> float:
49	    """Amplitude scale at ``index``, combining the note and file envelopes."""
50	    note_pos = index - (note_index * note_len)
51	    note_fade = NOTE_FADE_S * SAMPLE_RATE
52	    file_fade = FILE_FADE_S * SAMPLE_RATE
53	
54	    note_env = min(1.0, note_pos / note_fade, (note_len - note_pos) / note_fade)
55	    file_env = min(1.0, index / file_fade, (total - index) / file_fade)
56	    return max(0.0, min(note_env, file_env))
57	
58	
59	def render() -> bytes:
60	    """Render the arpeggio as little-endian signed 16-bit PCM frames."""
61	    total = int(SAMPLE_RATE * DURATION_S)
62	    note_len = total // len(NOTES_HZ)
63	    frames = bytearray()
64	
65	    for index in range(total):
66	        note_index = min(index // note_len, len(NOTES_HZ) - 1)
67	        freq = NOTES_HZ[note_index]
68	        phase = 2.0 * math.pi * freq * (index / SAMPLE_RATE)
69	        value = AMPLITUDE * _envelope(index, total, note_index, note_len) * math.sin(phase)
70	        frames += struct.pack("<h", int(value * 32767.0))
71	
72	    return bytes(frames)
73	
74	
75	def write(path: pathlib.Path) -> None:
76	    path.parent.mkdir(parents=True, exist_ok=True)
77	    with wave.open(str(path), "wb") as out:
78	        out.setnchannels(CHANNELS)
79	        out.setsampwidth(SAMPLE_WIDTH)
80	        out.setframerate(SAMPLE_RATE)
81	        out.writeframes(render())
82	
83	
84	def main(argv: list[str]) -> int:
85	    if len(argv) > 1:
