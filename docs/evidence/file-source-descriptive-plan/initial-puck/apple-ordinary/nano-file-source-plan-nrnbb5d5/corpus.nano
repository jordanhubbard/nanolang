module "src_nano/compiler/file_source_plan.nano" as Plan
fn emit(index: int, plan: FileSourcePlan) -> void {
 (println (+ "CASE " (+ (int_to_string index) (+ " " (+ (int_to_string plan.status) (+ " " (int_to_string (array_length plan.rows))))))))
 let mut i: int = 0
 while (< i (array_length plan.rows)) {
 let row: FileSourceRow = (at plan.rows i)
 let mut line: string = (+ (int_to_string (str_length row.module_id)) (+ ":" (+ row.module_id (+ "|" (+ (int_to_string (str_length row.name)) (+ ":" (+ row.name "|")))))))
 set line (+ line (int_to_string row.id))
 set line (+ line (+ "|" (int_to_string row.target)))
 set line (+ line (+ "|" (int_to_string row.request)))
 set line (+ line (+ "|" (int_to_string row.kind)))
 set line (+ line (+ "|" (int_to_string row.ordinal)))
 set line (+ line (+ "|" (int_to_string row.category)))
 set line (+ line (+ "|" (int_to_string row.input_mode)))
 set line (+ line (+ "|" (int_to_string row.result_ordinal)))
 set line (+ line (+ "|" (int_to_string row.global_layout)))
 set line (+ line (+ "|" (int_to_string row.import_index)))
 set line (+ line (+ "|" (int_to_string row.line)))
 set line (+ line (+ "|" (int_to_string row.column)))
 (println line) set i (+ i 1)
 }
}
shadow emit { let rows: array<FileSourceRow> = [] (emit -1 FileSourcePlan { status: 1, rows: rows, logical_bytes: 0 }) assert (== (array_length rows) 0) }
