 set b0 (array_push b0 FileSourceBinding { id: 8, kind: 0, ordinal: 7, name: FileSourceText { data: "CloseResult", size: 11 } })
 set b0 (array_push b0 FileSourceBinding { id: 9, kind: 1, ordinal: 0, name: FileSourceText { data: "temp", size: 4 } })
 set b0 (array_push b0 FileSourceBinding { id: 10, kind: 1, ordinal: 1, name: FileSourceText { data: "write_byte", size: 10 } })
 set b0 (array_push b0 FileSourceBinding { id: 11, kind: 1, ordinal: 2, name: FileSourceText { data: "rewind", size: 6 } })
