
resource struct Handle { fd: int }
let first: int = (read)
let later: int = 7

fn read() -> int { return later }
shadow read { assert (== (read) 7) }

fn main() -> int {
    let handle: Handle = Handle { fd: 7 }
    let Handle { fd } = handle
    assert (== fd 7)
    assert (== first 7)
    return 0
}
shadow main { assert (== (main) 0) }
