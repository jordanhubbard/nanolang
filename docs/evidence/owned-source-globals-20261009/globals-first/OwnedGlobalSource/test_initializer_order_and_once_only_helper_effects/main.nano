
resource struct Handle { fd: int }
let mut calls: int = 0
let first: int = (next)
let second: int = (next)

fn next() -> int { set calls (+ calls 1) return calls }
shadow next { set calls 1 assert (== (next) 2) }

fn main() -> int {
    let handle: Handle = Handle { fd: 7 }
    let Handle { fd } = handle
    assert (== fd 7)
    assert (== first 1)
assert (== second 2)
assert (== calls 2)
    return 0
}
shadow main { assert (== (main) 0) }
