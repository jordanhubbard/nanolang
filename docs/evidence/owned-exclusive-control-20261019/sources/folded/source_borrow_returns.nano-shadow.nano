resource struct NlrOwned0 { f0: int, f1: bool }
# I reconstruct ordered resource transfers; original shadows are not retained.
fn main() -> int {
    let nlr_tshadow_1: NlrOwned0 = NlrOwned0 { f0: 0, f1: false }
    let mut nlr_l0: NlrOwned0 = nlr_tshadow_1
    let nlr_tshadow_2: int = (nlr_f1_owned_1 &mut nlr_l0)
    let NlrOwned0 { f0, f1 } = nlr_l0
    let nlr_tshadow_3: int = f0
    let nlr_tshadow_4: bool = f1
    let nlr_tshadow_5: NlrOwned0 = NlrOwned0 { f0: 0, f1: false }
    let mut nlr_l1: NlrOwned0 = nlr_tshadow_5
    let nlr_tshadow_6: int = (nlr_f1_owned_1 &mut nlr_l1)
    let NlrOwned0 { f0, f1 } = nlr_l1
    let nlr_tshadow_7: int = f0
    let nlr_tshadow_8: bool = f1
    assert (== nlr_tshadow_2 nlr_tshadow_6)
    assert (== nlr_tshadow_3 nlr_tshadow_7)
    assert (== nlr_tshadow_4 nlr_tshadow_8)

 return 0
}
fn nlr_f1_owned_1(nlr_a0: &mut NlrOwned0) -> int {
    let mut nlr_l1: int = 0
    let mut nlr_l2: int = 0
    let nlr_t0: bool = nlr_a0.f1
    if nlr_t0 {
        let nlr_t10: int = nlr_a0.f0
        let nlr_t24: bool = (< nlr_t10 3)
        if nlr_t24 {
            set nlr_a0.f0 3
            let nlr_t44: int = nlr_a0.f0
            set nlr_l1 nlr_t44
            let nlr_t52: int = nlr_l1
            return nlr_t52
        }
        let nlr_t56: int = nlr_a0.f0
        set nlr_l2 nlr_t56
        let nlr_t64: int = nlr_l2
        return nlr_t64
    }
    let nlr_t68: int = nlr_a0.f0
    let nlr_t82: bool = (== nlr_t68 4)
    if nlr_t82 {
        return 4
    }
    return 1
}

shadow nlr_f1_owned_1 {
    let nlr_tshadow_1: NlrOwned0 = NlrOwned0 { f0: 0, f1: false }
    let mut nlr_l0: NlrOwned0 = nlr_tshadow_1
    let nlr_tshadow_2: int = (nlr_f1_owned_1 &mut nlr_l0)
    let NlrOwned0 { f0, f1 } = nlr_l0
    let nlr_tshadow_3: int = f0
    let nlr_tshadow_4: bool = f1
    let nlr_tshadow_5: NlrOwned0 = NlrOwned0 { f0: 0, f1: false }
    let mut nlr_l1: NlrOwned0 = nlr_tshadow_5
    let nlr_tshadow_6: int = (nlr_f1_owned_1 &mut nlr_l1)
    let NlrOwned0 { f0, f1 } = nlr_l1
    let nlr_tshadow_7: int = f0
    let nlr_tshadow_8: bool = f1
    assert (== nlr_tshadow_2 nlr_tshadow_6)
    assert (== nlr_tshadow_3 nlr_tshadow_7)
    assert (== nlr_tshadow_4 nlr_tshadow_8)
}
