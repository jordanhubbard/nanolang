    assert (== nlr_tshadow_17 0)
    assert (== nlr_tshadow_18 false)
    assert (== nlr_tshadow_19 0)
    assert (== nlr_tshadow_20 false)
    assert (== nlr_tshadow_4 nlr_tshadow_14)
    assert (== nlr_tshadow_7 nlr_tshadow_17)
    assert (== nlr_tshadow_8 nlr_tshadow_18)
    assert (== nlr_tshadow_9 nlr_tshadow_19)
    assert (== nlr_tshadow_10 nlr_tshadow_20)
