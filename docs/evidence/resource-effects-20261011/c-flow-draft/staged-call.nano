resource struct Handle{value:int}
fn consume(h:Handle)->int{let Handle{value}=h return value}
shadow consume{assert (== (consume Handle{value:7}) 7)}
effect Transfer{pass:Handle int->Handle,tick:int->int}
fn tick()->int{return perform Transfer.tick(0)}
shadow tick{assert true}
fn main()->int{let h:Handle=Handle{value:7} let k:Handle=handle {perform Transfer.pass(h (tick))} with {pass value number->{value} tick number->{return 7}} return (consume k)}
shadow main{assert true}
