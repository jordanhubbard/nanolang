#!/usr/bin/env python3
import os,sys,json,shutil,hashlib
from pathlib import Path
out=Path(__file__).parent
args=sys.argv[1:]
assert len(args)==2 and args[0]=='--check-shadows'
source=Path(args[1]);data=source.read_bytes()
target=out/(os.environ['MAP_CAPTURE_LABEL']+'-checked-shadow.nvm')
assert not target.exists()
target.write_bytes(data)
(out/(os.environ['MAP_CAPTURE_LABEL']+'-shadow-capture.json')).write_text(json.dumps(dict(argv=args,source=str(source),destination=str(target),sha256=hashlib.sha256(data).hexdigest(),vm_sha256=hashlib.sha256((out/'nano_vm').read_bytes()).hexdigest()),indent=2)+'\n')
os.execv(str(out/'nano_vm'),[str(out/'nano_vm')]+args)
