resource struct Box{value:int,flag:bool}
fn pick(owner:Box)->int {if owner.flag {let Box{value,flag}=owner return value} else {let Box{value,flag}=owner return (+ value 1)}}
shadow pick {assert true}
fn main()->int {return (+ (pick Box{value:7,flag:true}) (pick Box{value:7,flag:false}))}
shadow main {assert true}
