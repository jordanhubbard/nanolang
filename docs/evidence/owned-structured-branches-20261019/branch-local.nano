resource struct Box {value:int, flag:bool}
fn pick(owner:Box, yes:bool)->int {let Box{value,flag}=owner let mut out:int=0 if yes {let fresh:Box=Box{value:value,flag:flag} let Box{value,flag}=fresh set out value} else {let fresh:Box=Box{value:value,flag:flag} let Box{value,flag}=fresh set out (+ value 1)} return out}
shadow pick {assert true}
fn main()->int {return (+ (pick Box{value:7,flag:true} true) (pick Box{value:7,flag:false} false))}
shadow main {assert true}
