import "src_nano/parser.nano"
import "src_nano/compiler/nanoisa_borrows.nano"
from "src_nano/compiler/lexer.nano" import tokenize_string
module "modules/nanoisa/nanoisa.nano" as Nanoisa
extern fn get_argv(index:int)->string
extern fn file_read(path:string)->string
fn main()->int{
    let mut path:string="" let mut output:string="" let mut source:string=""
    unsafe {set path (get_argv 1) set output (get_argv 4) set source (file_read path)}
    let tokens:List<LexerToken> =(tokenize_string source path (list_CompilerDiagnostic_new))
    let parser:Parser=(parse_program tokens (list_LexerToken_length tokens) path)
    if (parser_has_error parser){return 1}
    let assembly:string=(nanoisa_borrow_emit parser false 0)
    if (== assembly ""){(println (nanoisa_borrow_error)) return 1}
    let result:int=(Nanoisa.assemble_text_save assembly output)
    if (!= result 0){(println (Nanoisa.last_error)) return 1}
    return 0
}
shadow main{assert true}
