        if (> call.borrow_mode 0) {
            (resource_flow_error diags file_name call.line call.column "I cannot store or escape a borrow")
            return flow
        }
        let mut direct: bool = false
        if (== call.function_type ParseNodeType.PNODE_IDENTIFIER) {
