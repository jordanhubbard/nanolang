                return flow
            }
            if (resource_type_is_declared parser state.type_name) {
                if state.moved { (resource_flow_error diags file_name id.line id.column (+ "I cannot use a moved value: " id.name)) }
                if move { return ResourceFlow { states: (resource_replace states index true), next: true } }
            }
        }
        return flow
    }
    if (== node_type ParseNodeType.PNODE_BLOCK) {
        let block: ASTBlock = (parser_get_block parser node_id)
        return (resource_flow_block parser block.statements states move loop_entry diags file_name return_type expected_type)
