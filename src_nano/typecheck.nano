            let branch: ResourceFlow = (resource_flow_value parser (at matched.arm_body_ids arm) (at matched.arm_body_types arm) expected_type arm_states move loop_entry diags file_name return_type)
            if branch.next { (resource_resolve_exit parser branch.states first diags file_name) }
            let outer: ResourceFlow = ResourceFlow { states: (resource_copy branch.states first), next: branch.next }
            set joined (resource_join parser joined outer diags file_name)
            set arm (+ arm 1)
        }
        return joined
    }
    if (or (== node_type ParseNodeType.PNODE_WHILE) (== node_type ParseNodeType.PNODE_FOR)) {
        let mut body: int = -1
        let mut condition: int = -1
        let mut condition_type: int = -1
        let mut variable: string = ""
        if (== node_type ParseNodeType.PNODE_WHILE) {
            let loop: ASTWhile = (parser_get_while parser node_id)
            set body loop.body set condition loop.condition set condition_type loop.condition_type
        } else {
            let loop: ASTFor = (parser_get_for parser node_id)
            set body loop.body set condition loop.iterable set condition_type loop.iterable_type set variable loop.var_name
        }
        let entry: array<ResourceState> = (resource_copy states (array_length states))
        set flow (resource_flow_node parser condition condition_type states false entry diags file_name return_type "")
        if (not flow.next) { return flow }
        (resource_loop_edge parser flow.states entry diags file_name)
        let mut body_states: array<ResourceState> = (resource_copy flow.states (array_length flow.states))
        if (!= variable "") { set body_states (array_push body_states ResourceState { held_places: [], name: variable, type_name: "int", moved: false, line: 0, column: 0 }) }
        set flow (resource_flow_node parser body ParseNodeType.PNODE_BLOCK body_states false entry diags file_name return_type "")
        if flow.next { (resource_loop_edge parser flow.states entry diags file_name) }
