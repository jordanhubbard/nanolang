            if (resource_place_conflict state.held_places "" false) {
                (resource_flow_error diags file_name id.line id.column "I cannot access an exclusively borrowed owner")
                return flow
            }
            if (and move (or (> (array_length state.held_places) 0) (str_starts_with state.type_name "&"))) {
