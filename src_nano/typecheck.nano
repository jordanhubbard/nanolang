                if (and (!= binding "") (!= binding "_")) {
                    set arm_states (array_push arm_states ResourceState { held_places: [], name: binding, type_name: payload, moved: false, line: matched.line, column: matched.column })
                } else {
                    if (resource_type_is_declared parser payload) { (resource_flow_error diags file_name matched.line matched.column "I require a binding for the selected resource payload") }
                }
            }
            let guard_id: int = (at matched.arm_guard_ids arm)
            if (>= guard_id 0) {
