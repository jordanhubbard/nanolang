/* Check type of a literal number */
fn check_number_literal(value: string) -> NSType {
    if (str_contains value ".") {
        return (type_float)
    } else {
        return (type_int)
    }
}

shadow check_number_literal {
    let t: NSType = (check_number_literal "42")
    assert (== t.kind TypeKind.TYPE_INT)
    let tf: NSType = (check_number_literal "3.14")
    assert (== tf.kind TypeKind.TYPE_FLOAT)
}

/* Check type of a string literal */
fn check_string_literal() -> NSType {
    return (type_string)
}

shadow check_string_literal {
    let t: NSType = (check_string_literal)
    assert (== t.kind TypeKind.TYPE_STRING)
}

/* Check type of a boolean literal */
fn check_bool_literal() -> NSType {
    return (type_bool)
}

shadow check_bool_literal {
    let t: NSType = (check_bool_literal)
    assert (== t.kind TypeKind.TYPE_BOOL)
}

/* Check if operator is valid for given types */
/* I select only exact flat numeric arrays; other legacy profiles keep their checker path. */
fn array_arithmetic_element(t: NSType) -> int {
    if (!= t.kind TypeKind.TYPE_ARRAY) { return TypeKind.TYPE_UNKNOWN }
    if (and (== t.element_type_kind TypeKind.TYPE_INT)
            (or (== t.element_type_name "") (== t.element_type_name "int"))) { return TypeKind.TYPE_INT }
    if (and (== t.element_type_kind TypeKind.TYPE_FLOAT)
            (or (== t.element_type_name "") (== t.element_type_name "float"))) { return TypeKind.TYPE_FLOAT }
    return TypeKind.TYPE_UNKNOWN
}
shadow array_arithmetic_element {
    assert (== (array_arithmetic_element (type_array TypeKind.TYPE_INT "int")) TypeKind.TYPE_INT)
    assert (== (array_arithmetic_element (type_array TypeKind.TYPE_FLOAT "")) TypeKind.TYPE_FLOAT)
    assert (== (array_arithmetic_element (type_array TypeKind.TYPE_INT "u8")) TypeKind.TYPE_UNKNOWN)
    assert (== (array_arithmetic_element (type_array TypeKind.TYPE_ARRAY "array<int>")) TypeKind.TYPE_UNKNOWN)
}
fn array_arithmetic_selected(op: string, left: NSType, right: NSType) -> bool {
    let arithmetic: bool = (or (or (== op "+") (== op "-")) (or (== op "*") (== op "/")))
    return (and arithmetic (or (!= (array_arithmetic_element left) TypeKind.TYPE_UNKNOWN)
                               (!= (array_arithmetic_element right) TypeKind.TYPE_UNKNOWN)))
}
shadow array_arithmetic_selected {
    let ints: NSType = (type_array TypeKind.TYPE_INT "int")
    assert (array_arithmetic_selected "+" ints (type_int))
    assert (not (array_arithmetic_selected "%" ints ints))
    assert (not (array_arithmetic_selected "+" (type_array TypeKind.TYPE_STRING "string") (type_string)))
}
fn array_arithmetic_matches(t: NSType, element: int) -> bool {
    if (== t.kind TypeKind.TYPE_ARRAY) { return (== (array_arithmetic_element t) element) }
    let mut name: string = "int"
    if (== element TypeKind.TYPE_FLOAT) { set name "float" }
    return (and (== t.kind element) (or (== t.name "") (== t.name name)))
}
shadow array_arithmetic_matches {
    assert (array_arithmetic_matches (type_float) TypeKind.TYPE_FLOAT)
    assert (not (array_arithmetic_matches (type_int) TypeKind.TYPE_FLOAT))
    assert (not (array_arithmetic_matches (type_unknown_named "") TypeKind.TYPE_INT))
}

fn check_binary_op(op: string, left_type: NSType, right_type: NSType) -> NSType {
    if (array_arithmetic_selected op left_type right_type) {
        let mut array_type: NSType = left_type
        if (!= left_type.kind TypeKind.TYPE_ARRAY) { set array_type right_type }
        let element: int = (array_arithmetic_element array_type)
        if (and (array_arithmetic_matches left_type element) (array_arithmetic_matches right_type element)) {
            return array_type
        }
        return (type_unknown_named "incompatible numeric array arithmetic")
    }

    /* Special case: + for string concatenation */
    if (== op "+") {
        if (and (== left_type.kind TypeKind.TYPE_STRING) (== right_type.kind TypeKind.TYPE_STRING)) {
            return (type_string)
        } else {
            # If one side is known string, allow the other side to be unknown.
            # This preserves string context through nested concatenations in self-hosting.
            if (and (== left_type.kind TypeKind.TYPE_STRING) (== right_type.kind TypeKind.TYPE_UNKNOWN)) {
                return (type_string)
            } else {}
            if (and (== right_type.kind TypeKind.TYPE_STRING) (== left_type.kind TypeKind.TYPE_UNKNOWN)) {
                return (type_string)
            } else {}
            (print "")
        }
    } else {
        (print "")
    }
    
    /* Arithmetic ops: +, -, *, /, % */
    if (or (or (or (or (== op "+") (== op "-")) (== op "*")) (== op "/")) (== op "%")) {
        /* Both operands must be int or float */
        if (and (== left_type.kind TypeKind.TYPE_INT) (== right_type.kind TypeKind.TYPE_INT)) {
            return (type_int)
        } else {
            if (or (== left_type.kind TypeKind.TYPE_FLOAT) (== right_type.kind TypeKind.TYPE_FLOAT)) {
                return (type_float)
            } else {
                if (or (== left_type.kind TypeKind.TYPE_UNKNOWN) (== right_type.kind TypeKind.TYPE_UNKNOWN)) {
                    /* If one side is known, propagate that type; otherwise default to int */
                    if (== left_type.kind TypeKind.TYPE_INT) { return (type_int) } else { (print "") }
                    if (== right_type.kind TypeKind.TYPE_INT) { return (type_int) } else { (print "") }
                    if (== left_type.kind TypeKind.TYPE_FLOAT) { return (type_float) } else { (print "") }
                    if (== right_type.kind TypeKind.TYPE_FLOAT) { return (type_float) } else { (print "") }
                    return (type_int)
                } else {
                    /* NSType error */
                    return (type_unknown_named "error")
                }
            }
        }
    } else {
        /* Comparison ops: ==, !=, <, >, <=, >= */
        if (or (or (or (or (or (== op "==") (== op "!=")) (== op "<")) (== op ">")) (== op "<=")) (== op ">=")) {
            /* Comparisons always return bool, even if operand types don't perfectly match */
            /* This is more lenient for bootstrap compiler */
            return (type_bool)
        } else {
            /* Logical ops: and, or */
            if (or (== op "and") (== op "or")) {
                /* Logical operators return bool (lenient for bootstrap) */
                return (type_bool)
            } else {
                /* Unknown operator */
                return (type_unknown_named "error")
            }
        }
    }
}

shadow check_binary_op {
    let int_t: NSType = (type_int)
    let bool_t: NSType = (type_bool)
    
    /* Test arithmetic */
    let result1: NSType = (check_binary_op "+" int_t int_t)
    assert (== result1.kind TypeKind.TYPE_INT)
    
    let floats: NSType = (type_array TypeKind.TYPE_FLOAT "float")
    let broadcast: NSType = (check_binary_op "-" (type_float) floats)
    assert (== broadcast.kind TypeKind.TYPE_ARRAY)
    assert (== broadcast.element_type_kind TypeKind.TYPE_FLOAT)
    let pair: NSType = (check_binary_op "/" floats floats)
    assert (== pair.kind TypeKind.TYPE_ARRAY)
    let mismatch: NSType = (check_binary_op "+" floats int_t)
    assert (== mismatch.kind TypeKind.TYPE_UNKNOWN)

    /* Test comparison */
    let result2: NSType = (check_binary_op "==" int_t int_t)
    assert (== result2.kind TypeKind.TYPE_BOOL)
    
    /* Test logical */
    let result3: NSType = (check_binary_op "and" bool_t bool_t)
    assert (== result3.kind TypeKind.TYPE_BOOL)
}

/* AST and Parser IR types are provided by src_nano/compiler/ir.nano */

/* =============================================================================
 * AST TYPE CHECKING - Expression evaluation
 * ============================================================================= */

fn op_token_to_string(op: int) -> string {
    if (== op LexerTokenType.TOKEN_PLUS) { return "+" }
    else {
        if (== op LexerTokenType.TOKEN_MINUS) { return "-" }
        else {
            if (== op LexerTokenType.TOKEN_STAR) { return "*" }
            else {
                if (== op LexerTokenType.TOKEN_SLASH) { return "/" }
                else {
                    if (== op LexerTokenType.TOKEN_PERCENT) { return "%" }
                    else {
                        if (== op LexerTokenType.TOKEN_EQ) { return "==" }
                        else {
                            if (== op LexerTokenType.TOKEN_NE) { return "!=" }
                            else {
                                if (== op LexerTokenType.TOKEN_LT) { return "<" }
                                else {
                                    if (== op LexerTokenType.TOKEN_GT) { return ">" }
                                    else {
                                        if (== op LexerTokenType.TOKEN_LE) { return "<=" }
                                        else {
                                            if (== op LexerTokenType.TOKEN_GE) { return ">=" }
                                            else {
                                                if (== op LexerTokenType.TOKEN_AND) { return "and" }
                                                else {
                                                    if (== op LexerTokenType.TOKEN_OR) { return "or" }
                                                    else { return "?" }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

shadow op_token_to_string {
    assert (== (op_token_to_string LexerTokenType.TOKEN_PLUS) "+")
    assert (== (op_token_to_string LexerTokenType.TOKEN_MINUS) "-")
    assert (== (op_token_to_string LexerTokenType.TOKEN_STAR) "*")
    assert (== (op_token_to_string LexerTokenType.TOKEN_EQ) "==")
    assert (== (op_token_to_string LexerTokenType.TOKEN_AND) "and")
}

/* NSType check an expression node by ID
 * 
 * This recursively evaluates the type of an expression node.
 * Node IDs are used to reference nodes in the Parser's storage lists.
 * 
 * Args:
 *   parser: The Parser containing AST nodes
 *   node_id: Index into the appropriate AST list
 *   node_type: 0=number, 1=identifier, 2=binary_op
 *   symbols: Symbol table for identifier lookup
 * 
 * Returns: The type of the expression, or TYPE_UNKNOWN on error
 */
fn ensure_known_expr_node(node_type: int) -> bool {
    if (== node_type ParseNodeType.PNODE_NUMBER) { return true }
    if (== node_type ParseNodeType.PNODE_STRING) { return true }
    if (== node_type ParseNodeType.PNODE_BOOL) { return true }
    if (== node_type ParseNodeType.PNODE_FLOAT) { return true }
    if (== node_type ParseNodeType.PNODE_IDENTIFIER) { return true }
    if (== node_type ParseNodeType.PNODE_CALL) { return true }
    if (== node_type ParseNodeType.PNODE_MODULE_QUALIFIED_CALL) { return true }
    if (== node_type ParseNodeType.PNODE_BINARY_OP) { return true }
    if (== node_type ParseNodeType.PNODE_FIELD_ACCESS) { return true }
    if (== node_type ParseNodeType.PNODE_MATCH) { return true }
    if (== node_type ParseNodeType.PNODE_IF) { return true }
    if (== node_type ParseNodeType.PNODE_BLOCK) { return true }
    if (== node_type ParseNodeType.PNODE_TUPLE_LITERAL) { return true }
    if (== node_type ParseNodeType.PNODE_TUPLE_INDEX) { return true }
    if (== node_type ParseNodeType.PNODE_UNSAFE_BLOCK) { return true }
    if (== node_type ParseNodeType.PNODE_ARRAY_LITERAL) { return true }
    if (== node_type ParseNodeType.PNODE_STRUCT_LITERAL) { return true }
    if (== node_type ParseNodeType.PNODE_UNION_CONSTRUCT) { return true }
    return false
}

shadow ensure_known_expr_node {
    assert (ensure_known_expr_node ParseNodeType.PNODE_NUMBER)
    assert (ensure_known_expr_node ParseNodeType.PNODE_STRING)
    assert (ensure_known_expr_node ParseNodeType.PNODE_BOOL)
    assert (ensure_known_expr_node ParseNodeType.PNODE_CALL)
    assert (ensure_known_expr_node ParseNodeType.PNODE_BINARY_OP)
    assert (not (ensure_known_expr_node ParseNodeType.PNODE_FUNCTION))
}

/* Check union construction expression
 * Example: Option.Some { value: 42 }
 * Returns: The union type (TYPE_UNION with union name)
 */
# I validate actual constructor nodes without coercing selected payload variables.
fn check_constructor_argument(parser: Parser, node_id: int, node_type: int, actual: NSType, expected: NSType, symbols: array<Symbol>, diags: List<CompilerDiagnostic>, file_name: string) -> NSType {
    if (or (!= expected.kind TypeKind.TYPE_UNION) (!= node_type ParseNodeType.PNODE_UNION_CONSTRUCT)) {
        return (check_contextual_value parser node_id node_type actual expected symbols diags file_name)
    }
    let literal: ASTUnionConstruct = (parser_get_union_construct parser node_id)
    let concrete: string = (type_to_string expected)
    let identity: string = (resource_type_identity parser concrete literal.line)
    let actual_identity: string = (resource_type_identity parser literal.union_name literal.line)
    if (!= (base_type_name identity) (base_type_name actual_identity)) { return actual }
    if (and (> (array_length (tc_generic_arguments literal.union_name)) 0) (!= actual_identity identity)) {
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0010" "I require the constructor's explicit generic arguments to match the declared union context." (Diagnostics.diag_location file_name literal.line literal.column)))
        return actual
    }
    let index: int = (resource_union_index parser identity)
    if (< index 0) { return actual }
    let definition: ASTUnion = (parser_get_union parser index)
    let arguments: array<string> = (tc_generic_arguments concrete)
    let mut valid: bool = (== definition.generic_param_count (array_length arguments))
    let mut selected: int = -1
    let mut offset: int = 0
    let mut vi: int = 0
    while (< vi definition.variant_count) {
        if (== literal.variant_name (at definition.variant_names vi)) { set selected vi }
        if (< selected 0) { set offset (+ offset (at definition.variant_field_counts vi)) }
        set vi (+ vi 1)
    }
    if (< selected 0) { set valid false } else {
        let count: int = (at definition.variant_field_counts selected)
        if (!= literal.field_count count) { set valid false }
        let mut field: int = 0
        while (< field literal.field_count) {
            let name: string = (at literal.field_names field)
            let mut slot: int = -1
            let mut j: int = 0
            while (< j count) {
                if (== name (at definition.variant_field_names (+ offset j))) { set slot j }
                set j (+ j 1)
            }
            set j 0
            while (< j field) {
                if (== name (at literal.field_names j)) { set valid false }
                set j (+ j 1)
            }
            if (< slot 0) { set valid false } else {
                let field_spelling: string = (tc_substitute_generic (at definition.variant_field_types (+ offset slot)) definition.generic_params arguments)
                let field_expected: NSType = (type_from_string_with_parser parser field_spelling)
                let value_id: int = (at literal.field_value_ids field)
                let value_kind: int = (at literal.field_value_types field)
                let raw: NSType = (check_expr_node parser value_id value_kind symbols diags file_name)
                let checked: NSType = (check_constructor_argument parser value_id value_kind raw field_expected symbols diags file_name)
                if (or (== checked.kind TypeKind.TYPE_UNKNOWN) (not (types_equal checked field_expected))) { set valid false }
            }
            set field (+ field 1)
        }
    }
    if (not valid) {
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0010" "I require a declared union variant with each payload field exactly once and matching concrete types." (Diagnostics.diag_location file_name literal.line literal.column)))
        return actual
    }
    return expected
}
shadow check_constructor_argument {
    let parser: Parser = (resource_test_parser "union Choice { Some { n: int } } fn f() -> void { (consume (Choice.Some { n: 1 })) }")
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let expected: NSType = (type_from_string_with_parser parser "Choice")
    let actual: NSType = (check_union_construct parser 0)
    let checked: NSType = (check_constructor_argument parser 0 ParseNodeType.PNODE_UNION_CONSTRUCT actual expected [] diags "constructor.nano")
    assert (types_equal checked expected)
    assert (== (list_CompilerDiagnostic_length diags) 0)
    let phantom: Parser = (resource_test_parser "union Phantom<T> { Mark { value: int } } fn f() -> void { (consume (Phantom.Mark { value: 1 })) }")
    let wanted: NSType = (type_from_string_with_parser phantom "Phantom<int>")
    let inferred: NSType = (check_constructor_argument phantom 0 ParseNodeType.PNODE_UNION_CONSTRUCT (check_union_construct phantom 0) wanted [] diags "constructor.nano")
    assert (types_equal inferred wanted)
    assert (== (list_CompilerDiagnostic_length diags) 0)
    let item: ASTUnionConstruct = (parser_get_union_construct phantom 0)
    (list_ASTUnionConstruct_set phantom.union_constructs 0 (ASTUnionConstruct { node_type: item.node_type, line: item.line, column: item.column, union_name: "Phantom<string>", variant_name: item.variant_name, field_names: item.field_names, field_value_ids: item.field_value_ids, field_value_types: item.field_value_types, field_count: item.field_count }))
    let retained: NSType = (check_constructor_argument phantom 0 ParseNodeType.PNODE_UNION_CONSTRUCT (check_union_construct phantom 0) wanted [] diags "constructor.nano")
    assert (not (types_equal retained wanted))
    assert (== (list_CompilerDiagnostic_length diags) 1)
}

# I do not treat unknown array elements as evidence about an existing value.
fn record_field_types_known(actual: NSType, expected: NSType) -> bool {
    if (or (== actual.kind TypeKind.TYPE_UNKNOWN) (== expected.kind TypeKind.TYPE_UNKNOWN)) { return false }
    if (and (== actual.kind TypeKind.TYPE_ARRAY) (== expected.kind TypeKind.TYPE_ARRAY)) {
        if (or (== actual.element_type_kind TypeKind.TYPE_UNKNOWN) (== expected.element_type_kind TypeKind.TYPE_UNKNOWN)) { return false }
        let actual_element: string = (array_elem_type_from_array_decl (type_to_string actual))
        let expected_element: string = (array_elem_type_from_array_decl (type_to_string expected))
        if (or (== actual_element "") (== expected_element "")) { return false }
        return (and (types_equal actual expected) (record_field_types_known (type_from_string actual_element) (type_from_string expected_element)))
    }
    return (types_equal actual expected)
}

shadow record_field_types_known {
    assert (record_field_types_known (type_from_string "array<array<int>>") (type_from_string "array<array<int>>"))
    assert (not (record_field_types_known (type_array TypeKind.TYPE_UNKNOWN "") (type_from_string "array<int>")))
    assert (not (record_field_types_known (type_from_string "array<Left>") (type_from_string "array<Right>")))
    assert (not (record_field_types_known (type_unknown_named "missing") (type_int)))
}

# I validate literal members against their destination before publishing its annotation.
fn check_record_field_value(parser: Parser, node_id: int, node_type: int, actual: NSType, expected: NSType, symbols: array<Symbol>, diags: List<CompilerDiagnostic>, file_name: string) -> bool {
    let before: int = (list_CompilerDiagnostic_length diags)
    let checked: NSType = (check_constructor_argument parser node_id node_type actual expected symbols diags file_name)
    return (and (not (checked_value_errors diags before)) (record_field_types_known checked expected))
}

shadow check_record_field_value {
    let parser: Parser = (resource_test_parser "fn f() -> void { let empty = [] let mixed = [1, true] let good = [[1], []] }")
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let expected: NSType = (type_from_string "array<int>")
    let empty: ASTLet = (parser_get_let parser 0)
    assert (check_record_field_value parser empty.value empty.value_type (type_array TypeKind.TYPE_UNKNOWN "") expected [] diags "field.nano")
    assert (== (parser_get_array_literal parser empty.value).element_type "int")
    let mixed: ASTLet = (parser_get_let parser 1)
    let prior: string = (parser_get_array_literal parser mixed.value).element_type
    assert (not (check_record_field_value parser mixed.value mixed.value_type (type_array TypeKind.TYPE_UNKNOWN "") expected [] diags "field.nano"))
    assert (== (parser_get_array_literal parser mixed.value).element_type prior)
    let good: ASTLet = (parser_get_let parser 2)
    assert (check_record_field_value parser good.value good.value_type (type_array TypeKind.TYPE_UNKNOWN "") (type_from_string "array<array<int>>") [] diags "field.nano")
}

fn check_array_new_call(parser: Parser, call: ASTCall, symbols: array<Symbol>, diags: List<CompilerDiagnostic>, file_name: string) -> NSType {
    if (!= call.arg_count 2) {
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0010" "I require a count and a fill value for array_new." (Diagnostics.diag_location file_name call.line call.column)))
        return (type_unknown_named "array_new")
    }
    let count: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
    let count_type: NSType = (check_expr_node parser count.node_id count.node_type symbols diags file_name)
    let fill: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
    let element: NSType = (check_expr_node parser fill.node_id fill.node_type symbols diags file_name)
    if (or (== count_type.kind TypeKind.TYPE_UNKNOWN) (or (not (or (types_equal count_type (type_int)) (== (type_to_string count_type) "u8"))) (not (reduce_type_known parser element)))) {
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0010" "I require a checked integer count and a known fill type for array_new." (Diagnostics.diag_location file_name call.line call.column)))
        return (type_unknown_named "array_new")
    }
    return (type_array_of element)
}

