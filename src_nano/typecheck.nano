    let parser: Parser = (resource_test_parser "fn f() -> void { let a = (cond (true { let local: int = 1 [local] }) (else [])) }")
    assert (not (parser_has_error parser))
    let body: ASTBlock = (parser_get_block parser (parser_get_function parser 0).body)
    let value: ASTLet = (parser_get_let parser (list_ASTStmtRef_get body.statements 0).node_id)
    let fact: CheckedBlock = (check_value_facts parser value.value value.value_type [] (list_CompilerDiagnostic_new) "branch.nano")
    assert fact.ok
    assert (== (type_to_string fact.value_type) "array<int>")
}

fn check_map_call(parser: Parser, call: ASTCall, symbols: array<Symbol>, diags: List<CompilerDiagnostic>, file_name: string) -> NSType {
    let location: CompilerSourceLocation = (Diagnostics.diag_location file_name call.line call.column)
    if (!= call.arg_count 2) {
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0010" "I require a source array and one transform in map." location))
        return (type_unknown_named "map")
    }
    let source: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
    let callback: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
    let source_type: NSType = (check_expr_node parser source.node_id source.node_type symbols diags file_name)
    let callback_type: NSType = (check_expr_node parser callback.node_id callback.node_type symbols diags file_name)
    if (!= source_type.kind TypeKind.TYPE_ARRAY) {
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0010" "I require an array source in map." location))
    }
    if (!= callback_type.kind TypeKind.TYPE_FUNCTION) {
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0010" "I require a function transform in map." location))
        return (type_unknown_named "map")
    }
    let parameters: array<NSType> = (fn_type_params_with_parser parser callback_type.name)
    if (!= (array_length parameters) 1) {
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0010" "I require a unary transform in map." location))
        return (type_unknown_named "map")
    }
    let parameter: NSType = (at parameters 0)
    let result: NSType = (type_from_string_with_parser parser (type_to_string (fn_type_return_type callback_type.name)))
    if (or (== result.kind TypeKind.TYPE_VOID) (not (and (reduce_type_known parser parameter) (reduce_type_known parser result)))) {
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0010" "I require a known value-producing transform in map." location))
        return (type_unknown_named "map")
    }
    let expected_source: NSType = (type_array_of parameter)
    let checked_source: NSType = (check_contextual_value parser source.node_id source.node_type source_type expected_source symbols diags file_name)
    if (not (reduce_types_exact parser checked_source expected_source)) { return (type_unknown_named "map source") }
    let name: ASTIdentifier = (parser_get_identifier parser call.function)
    if (== (tc_bound_name name.name name.line symbols) "filter") {
        if (!= result.kind TypeKind.TYPE_BOOL) {
            (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0010" "I require a bool predicate result in filter." location))
            return (type_unknown_named "filter predicate")
        }
        return checked_source
    }
    return (type_array_of result)
}

shadow check_map_call {
    let tokens: List<LexerToken> = (tokenize_string "fn main() -> int { let value = (map [1] convert) return 0 }" "map.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "map.nano")
