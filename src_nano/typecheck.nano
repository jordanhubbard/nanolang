from "src_nano/compiler/declaration_ownership.nano" import declaration_local_lets
from "src_nano/compiler/lexer.nano" import tokenize_string
import "src_nano/ast_shared.nano"
import "src_nano/compiler/ir.nano"
from "src_nano/compiler/type_substitution.nano" import substitute_type_parameters
import "src_nano/compiler/module_bindings.nano"
import "src_nano/generated/purity_intrinsics.nano"
import "src_nano/compiler/diagnostics.nano" as Diagnostics
from "src_nano/compiler/error_messages.nano" import encode_type_mismatch_message, encode_undefined_name_message, encode_wrong_arg_count_message, encode_missing_return_message, encode_immutable_assignment_message

/* =============================================================================
 * TYPE SYSTEM
 * ============================================================================= */

/* TypeKind and NSType are provided by src_nano/compiler/ir.nano */

# I scope these to a function check in my sequential bootstrap checker.
let mut tc_enclosing_function: string = ""
let mut tc_enclosing_return: string = "void"

struct CheckedBlock {
    ok: bool,
    value_type: NSType,
    empty_holes: bool,
    terminates: bool
}

/* Function signature for type checking */
struct FunctionType {
    name: string,
    param_count: int,
    return_type: NSType
    /* Note: param types stored separately in environment */
}

/* =============================================================================
 * SYMBOL TABLE / ENVIRONMENT
 * ============================================================================= */

/* Symbol in the environment (variable or function) */
struct Symbol {
    name: string,
    sym_type: NSType,
    is_mutable: bool,
    is_function: bool,
    param_count: int,
    defined: bool,
    param_types: array<NSType>,
    return_type: NSType  /* Return type for functions - enables proper type inference */
}

struct ResourceState {
    name: string,
    type_name: string,
    moved: bool,
    held_places: array<string>,
    line: int,
    column: int
}

fn resource_name_in(names: array<string>, name: string) -> bool {
    let mut i: int = 0
    while (< i (array_length names)) {
        if (== (at names i) name) { return true }
        set i (+ i 1)
    }
    return false
}

shadow resource_name_in {
    assert (resource_name_in ["Handle", "Wrapper"] "Wrapper")
    assert (not (resource_name_in ["Handle"] "int"))
}

fn resource_variant_key(union_index: int, variant_index: int) -> string {
    return (+ (+ (+ "#variant:" (int_to_string union_index)) ":") (int_to_string variant_index))
}
shadow resource_variant_key {
    assert (== (resource_variant_key 2 3) "#variant:2:3")
}

# I qualify ownership facts by declaration, independently of source spelling.
fn resource_type_identity(parser: Parser, type_name: string, line: int) -> string {
    if (str_starts_with type_name "&mut ") { return (+ "&mut " (resource_type_identity parser (str_substring type_name 5 (str_length type_name)) line)) }
    if (str_starts_with type_name "&") { return (+ "&" (resource_type_identity parser (str_substring type_name 1 (str_length type_name)) line)) }
    if (> (array_length (tc_generic_arguments type_name)) 0) { return (resource_concrete_identity parser type_name line 0) }
    let owner: int = (mb_owner line)
    let mut found: string = ""
    let mut matches: int = 0
    let mut i: int = 0
    while (< i (parser_get_struct_def_count parser)) {
        let def: ASTStruct = (parser_get_struct_def parser i)
        let key: string = (+ "#record:" (int_to_string i))
        if (== type_name key) { return key }
        if (== def.name type_name) {
            if (== (mb_owner def.line) owner) { return key }
            set found key set matches (+ matches 1)
        }
        set i (+ i 1)
    }
    set i 0
    while (< i (parser_get_union_count parser)) {
        let def: ASTUnion = (parser_get_union parser i)
        let key: string = (+ "#union:" (int_to_string i))
        if (== type_name key) { return key }
        let mut variant: int = 0
        while (< variant def.variant_count) {
            let variant_key: string = (resource_variant_key i variant)
            if (== type_name variant_key) { return variant_key }
            if (== type_name (+ (+ def.name ".") (at def.variant_names variant))) {
                if (== (mb_owner def.line) owner) { return variant_key }
                set found variant_key set matches (+ matches 1)
            }
            set variant (+ variant 1)
        }
        if (== def.name type_name) {
            if (== (mb_owner def.line) owner) { return key }
            set found key set matches (+ matches 1)
        }
        set i (+ i 1)
    }
    # I retain the existing unique imported-name boundary; ambiguous names
    # require an explicit module binding before they can be used as types.
    if (== matches 1) { return found }
    return type_name
}
# I retain declaration identities for the outer union and every concrete argument.
fn resource_concrete_identity(parser: Parser, spelling: string, line: int, depth: int) -> string {
    if (> depth 128) { return spelling }
    let args: array<string> = (tc_generic_arguments spelling)
    if (== (array_length args) 0) { return (resource_type_identity parser spelling line) }
    let base: string = (base_type_name spelling)
    if (tc_str_starts_with base "fn(") { return spelling }
    let mut result: string = (+ (resource_type_identity parser base line) "<")
    let mut i: int = 0
    while (< i (array_length args)) {
        if (> i 0) { set result (+ result ",") }
        set result (+ result (resource_concrete_identity parser (at args i) line (+ depth 1)))
        set i (+ i 1)
    }
    return (+ result ">")
}
shadow resource_concrete_identity {
    let parser: Parser = (resource_test_parser "resource struct Handle { fd: int } union Result<T,E> { Ok { value: T }, Err { error: E } } union Box<T> { Some { value: T } }")
    assert (== (resource_concrete_identity parser "Result<int,Handle>" 1 0) "#union:0<int,#record:0>")
    assert (== (resource_concrete_identity parser "Box<Result<int,Handle>>" 1 0) "#union:1<#union:0<int,#record:0>>")
    assert (== (resource_concrete_identity parser "#union:0<int,#record:0>" 1 0) "#union:0<int,#record:0>")
}

shadow resource_type_identity {
    let parser: Parser = (resource_test_parser "struct Handle { plain: int }\nresource struct Handle { fd: int }\n")
    (mb_reset [1, 2])
    assert (!= (resource_type_identity parser "Handle" 1) (resource_type_identity parser "Handle" 2))
    assert (== (resource_type_identity parser "int" 1) "int")
    assert (not (resource_type_is_declared parser (resource_type_identity parser "Handle" 1)))
    assert (resource_type_is_declared parser (resource_type_identity parser "Handle" 2))
    (mb_reset [])
}

# I unwrap fixed array payloads inside the declaring formal scope.
fn resource_fixed_payload_bearing(parser: Parser, spelling: string, line: int, formals: array<string>, bearing: array<string>, depth: int) -> bool {
    if (> depth 128) { return true }
    if (== (base_type_name spelling) "array") {
        let args: array<string> = (tc_generic_arguments spelling)
        if (!= (array_length args) 1) { return true }
        return (resource_fixed_payload_bearing parser (at args 0) line formals bearing (+ depth 1))
    }
    if (resource_name_in formals spelling) { return false }
    return (resource_name_in bearing (resource_type_identity parser spelling line))
}
shadow resource_fixed_payload_bearing {
    let parser: Parser = (resource_test_parser "resource struct Handle { fd: int }")
    let roots: array<string> = [(resource_type_identity parser "Handle" 1)]
    assert (resource_fixed_payload_bearing parser "array<array<Handle>>" 1 [] roots 0)
    assert (not (resource_fixed_payload_bearing parser "array<Handle>" 1 ["Handle"] roots 0))
    assert (not (resource_fixed_payload_bearing parser "array<int>" 1 [] roots 0))
}

# I expand concrete payloads against current fixed-point facts, preserving
# formal names until their declaring union supplies concrete arguments.
fn resource_concrete_payload_fact(parser: Parser, spelling: string, line: int, formals: array<string>, bearing: array<string>, collections: array<string>, collections_only: bool, active: array<string>, depth: int) -> bool {
    # Reserved scalar types cannot contain a nominal resource payload.
    if (or (== spelling "int") (or (== spelling "float") (or (== spelling "bool") (or (== spelling "string") (== spelling "void"))))) { return false }
    if (> depth 128) { return true }
    if (resource_name_in formals spelling) { return false }
    let raw_base: string = (base_type_name spelling)
    let args: array<string> = (tc_generic_arguments spelling)
    let collection: bool = (or (== raw_base "array") (or (== raw_base "List") (== raw_base "HashMap")))
    if collection {
        let mut i: int = 0
        while (< i (array_length args)) {
            if (resource_concrete_payload_fact parser (at args i) line formals bearing collections false active (+ depth 1)) { return true }
            set i (+ i 1)
        }
        return false
    }
    let identity: string = (resource_type_identity parser spelling line)
    let base: string = (base_type_name identity)
    if (> (array_length args) 0) {
        let mut key: string = (+ identity ":owned")
        if collections_only { set key (+ identity ":collections") }
        if (resource_name_in active key) { return false }
        let next: array<string> = (array_push active key)
        let mut i: int = 0
        while (< i (parser_get_union_count parser)) {
            let def: ASTUnion = (parser_get_union parser i)
            if (== base (resource_type_identity parser def.name def.line)) {
                if (!= def.generic_param_count (array_length args)) { return true }
                let mut field: int = 0
                while (< field (array_length def.variant_field_types)) {
                    let concrete: string = (tc_substitute_generic (at def.variant_field_types field) def.generic_params args)
                    if (resource_concrete_payload_fact parser concrete def.line formals bearing collections collections_only next (+ depth 1)) { return true }
                    set field (+ field 1)
                }
                return false
            }
            set i (+ i 1)
        }
    }
    if collections_only { return (resource_name_in collections identity) }
    return (resource_name_in bearing identity)
}

shadow resource_concrete_payload_fact {
    let parser: Parser = (resource_test_parser "resource struct T { fd: int } union Box<X> { Some { value: X }, None {} } union Marker<X> { Mark { number: int } } union Cycle<X> { Next { next: Cycle<X> }, None {} }")
    let roots: array<string> = [(resource_type_identity parser "T" 1)]
    assert (resource_concrete_payload_fact parser "Box<T>" 1 [] roots [] false [] 0)
    assert (not (resource_concrete_payload_fact parser "Box<T>" 1 ["T"] roots [] false [] 0))
    assert (not (resource_concrete_payload_fact parser "Marker<T>" 1 [] roots [] false [] 0))
    assert (not (resource_concrete_payload_fact parser "Cycle<int>" 1 [] roots [] false [] 0))
    assert (resource_concrete_payload_fact parser "array<Box<T>>" 1 [] roots [] true [] 0)
    # Each fixture isolates one fixed-point relation; I retain every query
    # without repeatedly traversing unrelated generic declaration graphs.
    let records: Parser = (resource_test_parser "resource struct Handle { fd: int } union Box<T> { Some { value: T }, None {} } struct Owned { boxed: Box<Handle> } struct Nested { owned: Owned }")
    assert (resource_classify records "Owned" false)
    assert (not (resource_classify records "Owned" true))
    assert (resource_classify records "Nested" false)
    let ordinary: Parser = (resource_test_parser "resource struct Handle { fd: int } union Box<T> { Some { value: T }, None {} } union Marker<T> { Mark { number: int } } struct Ordinary { boxed: Box<int> } struct Phantom { boxed: Marker<Handle> }")
    assert (not (resource_classify ordinary "Ordinary" false))
    assert (not (resource_classify ordinary "Phantom" false))
    let collection: Parser = (resource_test_parser "resource struct Handle { fd: int } union Box<T> { Some { value: T }, None {} } struct Collection { boxed: Box<array<Handle>> }")
    assert (resource_classify collection "Collection" true)
    let cycle: Parser = (resource_test_parser "resource struct Handle { fd: int } struct Cycle { children: array<Cycle> }")
    assert (not (resource_classify cycle "Cycle" false))
    let recursive: Parser = (resource_test_parser "resource struct Handle { fd: int } union Chain<T> { More { children: array<Chain<T>> }, Value { value: T }, None {} } struct Recursive { chain: Chain<Handle> }")
    assert (resource_classify recursive "Recursive" true)
}

fn resource_classify(parser: Parser, type_name: string, collections_only: bool) -> bool {
    if (tc_str_starts_with type_name "fn(") { return false }
    # Reserved scalar types cannot contain a nominal resource payload.
    if (or (== type_name "int") (or (== type_name "float") (or (== type_name "bool") (or (== type_name "string") (== type_name "void"))))) { return false }
    if (> (array_length (tc_generic_arguments type_name)) 0) { return (resource_instantiated_classify parser type_name 0 0 collections_only) }
    let mut collections: array<string> = []
    let mut bearing: array<string> = []
    let mut i: int = 0
    while (< i (parser_get_struct_def_count parser)) {
        let def: ASTStruct = (parser_get_struct_def parser i)
        if def.is_resource { set bearing (array_push bearing (resource_type_identity parser def.name def.line)) }
        set i (+ i 1)
    }
    if (== (array_length bearing) 0) { return false }
    # A cycle alone creates no obligation. I propagate only from resource roots.
    let mut changed: bool = true
    while changed {
        set changed false
        set i 0
        while (< i (parser_get_struct_def_count parser)) {
            let def: ASTStruct = (parser_get_struct_def parser i)
            if (or (not (resource_name_in bearing (resource_type_identity parser def.name def.line))) (not (resource_name_in collections (resource_type_identity parser def.name def.line)))) {
                let mut field: int = 0
                let mut owns: bool = false
                let mut unsupported: bool = false
                while (< field (array_length def.field_types)) {
                    let spelling: string = (at def.field_types field)
                    if (resource_concrete_payload_fact parser spelling def.line [] bearing collections false [] 0) { set owns true }
                    if (resource_concrete_payload_fact parser spelling def.line [] bearing collections true [] 0) { set unsupported true }
                    set field (+ field 1)
                }
                let key: string = (resource_type_identity parser def.name def.line)
                if (and owns (not (resource_name_in bearing key))) { set bearing (array_push bearing key) set changed true }
                if (and unsupported (not (resource_name_in collections key))) { set collections (array_push collections key) set changed true }
            }
            set i (+ i 1)
        }
        set i 0
        while (< i (parser_get_union_count parser)) {
            let def: ASTUnion = (parser_get_union parser i)
            if (or (not (resource_name_in bearing (resource_type_identity parser def.name def.line))) (not (resource_name_in collections (resource_type_identity parser def.name def.line)))) {
                let mut field: int = 0
                let mut owns: bool = false
                let mut unsupported: bool = false
                while (< field (array_length def.variant_field_types)) {
                    let spelling: string = (at def.variant_field_types field)
                    if (resource_concrete_payload_fact parser spelling def.line def.generic_params bearing collections false [] 0) { set owns true }
                    if (resource_concrete_payload_fact parser spelling def.line def.generic_params bearing collections true [] 0) { set unsupported true }
                    set field (+ field 1)
                }
                let key: string = (resource_type_identity parser def.name def.line)
                if (and owns (not (resource_name_in bearing key))) { set bearing (array_push bearing key) set changed true }
                if (and unsupported (not (resource_name_in collections key))) { set collections (array_push collections key) set changed true }
            }
            set i (+ i 1)
        }
    }
    let queried: string = (resource_type_identity parser type_name 0)
    let mut ui: int = 0
    while (< ui (parser_get_union_count parser)) {
        let def: ASTUnion = (parser_get_union parser ui)
        let mut offset: int = 0
        let mut variant: int = 0
        while (< variant def.variant_count) {
            let count: int = (at def.variant_field_counts variant)
            if (== queried (resource_variant_key ui variant)) {
                let mut owned: bool = false
                let mut unsupported: bool = false
                let mut field: int = 0
                while (< field count) {
                    let spelling: string = (at def.variant_field_types (+ offset field))
                    let field_owned: bool = (resource_concrete_payload_fact parser spelling def.line def.generic_params bearing collections false [] 0)
                    if field_owned { set owned true }
                    if (resource_concrete_payload_fact parser spelling def.line def.generic_params bearing collections true [] 0) { set unsupported true }
                    set field (+ field 1)
                }
                if collections_only { return unsupported }
                return owned
            }
            set offset (+ offset count)
            set variant (+ variant 1)
        }
        set ui (+ ui 1)
    }
    if collections_only { return (resource_name_in collections (resource_type_identity parser type_name 0)) }
    return (resource_name_in bearing (resource_type_identity parser type_name 0))
}

shadow resource_classify {
    let parser: Parser = (resource_test_parser "resource struct Handle { fd: int } union Owners { Some { values: array<Handle> }, None {} } union Plain { Some { values: array<int> }, None {} }")
    assert (resource_classify parser "Owners" false)
    assert (resource_classify parser "Owners" true)
    assert (not (resource_classify parser "Handle" true))
    assert (not (resource_classify parser "Plain" false))
    assert (not (resource_classify parser "Plain" true))
}

fn resource_type_is_declared(parser: Parser, type_name: string) -> bool {
    return (resource_classify parser type_name false)
}

fn resource_has_collection_payload(parser: Parser, type_name: string) -> bool {
    return (resource_classify parser type_name true)
}
shadow resource_has_collection_payload {
    let parser: Parser = (resource_test_parser "resource struct Handle { fd: int } union Owners { Some { values: array<Handle> }, None {} } struct Outer { owners: Owners }")
    assert (resource_has_collection_payload parser "Owners")
    assert (resource_has_collection_payload parser "Outer")
    assert (not (resource_has_collection_payload parser "Handle"))
}

shadow resource_type_is_declared {
    let parser: Parser = (resource_test_parser "resource struct Handle { fd: int } struct Outer { inner: Inner } struct Inner { owner: Handle } struct Cycle { next: Cycle } union Wrapped { Some { owner: Outer }, None {} } struct Envelope { item: Wrapped }")
    assert (resource_type_is_declared parser "Handle")
    assert (resource_type_is_declared parser "Outer")
    assert (resource_type_is_declared parser "Wrapped")
    assert (resource_type_is_declared parser "Envelope")
    assert (not (resource_type_is_declared parser "Cycle"))
    assert (not (resource_type_is_declared parser "int"))
    let shadowed: Parser = (resource_test_parser "resource struct T { fd: int } union Box<T> { Some { value: T }, None {} }")
    assert (resource_type_is_declared shadowed "T")
    assert (not (resource_type_is_declared shadowed "Box"))
}

fn resource_find(states: array<ResourceState>, name: string) -> int {
    let mut i: int = (- (array_length states) 1)
    while (>= i 0) {
        let state: ResourceState = (at states i)
        if (== state.name name) { return i } else { set i (- i 1) }
    }
    return (- 0 1)
}

shadow resource_find {
    let states: array<ResourceState> = [ResourceState { held_places: [], name: "file", type_name: "File", moved: false, line: 1, column: 1 }]
    assert (== (resource_find states "file") 0)
}



struct ResourceFlow {
    states: array<ResourceState>,
    next: bool
}

fn resource_test_parser(source: string) -> Parser {
    let tokens: List<LexerToken> = (tokenize_string source "ownership.nano" (list_CompilerDiagnostic_new))
    return (parse_program tokens (list_LexerToken_length tokens) "ownership.nano")
}

shadow resource_test_parser {
    let parsed: Parser = (resource_test_parser "resource struct File { fd: int }")
    assert (== (parser_get_struct_def_count parsed) 1)
}

# I copy snapshots explicitly: dynamic arrays can otherwise share storage.
fn resource_copy(states: array<ResourceState>, count: int) -> array<ResourceState> {
    let mut copy: array<ResourceState> = []
    let mut i: int = 0
    while (< i count) { set copy (array_push copy (at states i)) set i (+ i 1) }
    return copy
}

shadow resource_copy {
    let states: array<ResourceState> = [ResourceState { held_places: [], name: "x", type_name: "File", moved: false, line: 1, column: 1 }]
    let copy: array<ResourceState> = (resource_copy states 0)
    assert (== (array_length copy) 0)
    assert (== (array_length states) 1)
}

fn resource_place_root(parser: Parser, node_id: int, node_type: int) -> string {
    if (== node_type ParseNodeType.PNODE_IDENTIFIER) { return (parser_get_identifier parser node_id).name }
    if (== node_type ParseNodeType.PNODE_FIELD_ACCESS) {
        let field: ASTFieldAccess = (parser_get_field_access parser node_id)
        return (resource_place_root parser field.object field.object_type)
    }
    return ""
}
shadow resource_place_root {
    let parser: Parser = (resource_test_parser "fn main() -> int { return owner.left.fd }")
    assert (== (resource_place_root parser 1 ParseNodeType.PNODE_FIELD_ACCESS) "owner")
}

fn resource_place_path(parser: Parser, node_id: int, node_type: int) -> string {
    if (== node_type ParseNodeType.PNODE_FIELD_ACCESS) {
        let field: ASTFieldAccess = (parser_get_field_access parser node_id)
        return (+ (resource_place_path parser field.object field.object_type) (+ "." field.field_name))
    }
    return ""
}
shadow resource_place_path {
    let parser: Parser = (resource_test_parser "fn main() -> int { return owner.left.fd }")
    assert (== (resource_place_path parser 1 ParseNodeType.PNODE_FIELD_ACCESS) ".left.fd")
}

fn resource_path_prefix(prefix: string, path: string) -> bool {
    if (== prefix path) { return true }
    return (str_starts_with path (+ prefix "."))
}
shadow resource_path_prefix {
    assert (resource_path_prefix "" ".left")
    assert (resource_path_prefix ".left" ".left.fd")
    assert (not (resource_path_prefix ".left" ".leftover"))
}

fn resource_place_conflict(held: array<string>, path: string, exclusive: bool) -> bool {
    let mut i: int = 0
    while (< i (array_length held)) {
        let item: string = (at held i)
        let other: string = (str_substring item 1 (- (str_length item) 1))
        if (and (or exclusive (str_starts_with item "E")) (or (resource_path_prefix path other) (resource_path_prefix other path))) { return true }
        set i (+ i 1)
    }
    return false
}
shadow resource_place_conflict {
    assert (resource_place_conflict ["E.left"] ".left.fd" false)
    assert (resource_place_conflict ["S.left"] "" true)
    assert (not (resource_place_conflict ["S.left"] ".left" false))
    assert (not (resource_place_conflict ["E.left"] ".right" true))
}

fn resource_place_hold(states: array<ResourceState>, index: int, path: string, exclusive: bool) -> array<ResourceState> {
    let mut result: array<ResourceState> = []
    let mut i: int = 0
    while (< i (array_length states)) {
        let state: ResourceState = (at states i)
        let mut holds: array<string> = []
        let mut j: int = 0
        while (< j (array_length state.held_places)) { set holds (array_push holds (at state.held_places j)) set j (+ j 1) }
        if (== i index) {
            let mut mode: string = "S"
            if exclusive { set mode "E" }
            set holds (array_push holds (+ mode path))
        }
        set result (array_push result ResourceState { held_places: holds, name: state.name, type_name: state.type_name, moved: state.moved, line: state.line, column: state.column })
        set i (+ i 1)
    }
    return result
}
shadow resource_place_hold {
    let states: array<ResourceState> = [ResourceState { held_places: [], name: "owner", type_name: "Pair", moved: false, line: 1, column: 1 }]
    let held: array<ResourceState> = (resource_place_hold states 0 ".left" true)
    assert (== (array_length (at states 0).held_places) 0)
    assert (resource_place_conflict (at held 0).held_places ".left" false)
    let next: array<ResourceState> = (resource_place_hold held 0 ".right" false)
    assert (== (array_length (at held 0).held_places) 1)
    assert (== (array_length (at next 0).held_places) 2)
}

fn resource_restore_holds(states: array<ResourceState>, entry: array<ResourceState>) -> array<ResourceState> {
    let mut result: array<ResourceState> = []
    let mut i: int = 0
    while (< i (array_length states)) {
        let state: ResourceState = (at states i)
        let mut holds: array<string> = state.held_places
        if (< i (array_length entry)) { set holds (at entry i).held_places }
        set result (array_push result ResourceState { held_places: holds, name: state.name, type_name: state.type_name, moved: state.moved, line: state.line, column: state.column })
        set i (+ i 1)
    }
    return result
}
shadow resource_restore_holds {
    let states: array<ResourceState> = [ResourceState { held_places: ["S.left"], name: "owner", type_name: "Pair", moved: false, line: 1, column: 1 }]
    let held: array<ResourceState> = (resource_place_hold states 0 ".right" true)
    let restored: array<ResourceState> = (resource_restore_holds held states)
    assert (== (array_length (at restored 0).held_places) 1)
    assert (== (at (at restored 0).held_places 0) "S.left")
}

fn resource_replace(states: array<ResourceState>, index: int, moved: bool) -> array<ResourceState> {
    let mut copy: array<ResourceState> = []
    let mut i: int = 0
    while (< i (array_length states)) {
        let state: ResourceState = (at states i)
        let mut value: bool = state.moved
        if (== i index) { set value moved }
        set copy (array_push copy ResourceState { held_places: state.held_places, name: state.name, type_name: state.type_name, moved: value, line: state.line, column: state.column })
        set i (+ i 1)
    }
    return copy
}

shadow resource_replace {
    let states: array<ResourceState> = [ResourceState { held_places: [], name: "x", type_name: "File", moved: false, line: 1, column: 1 }]
    let changed: array<ResourceState> = (resource_replace states 0 true)
    let original: ResourceState = (at states 0)
    let updated: ResourceState = (at changed 0)
    assert (not original.moved)
    assert updated.moved
}

fn resource_flow_error(diags: List<CompilerDiagnostic>, file_name: string, line: int, column: int, message: string) -> void {
    (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0036" (+ "I cannot verify ownership: " message) (Diagnostics.diag_location file_name line column)))
}

shadow resource_flow_error {
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    (resource_flow_error diags "test.nano" 1 1 "unresolved resource")
    assert (== (Diagnostics.diag_list_count diags) 1)
}

fn resource_resolve_exit(parser: Parser, states: array<ResourceState>, first: int, diags: List<CompilerDiagnostic>, file_name: string) -> void {
    let mut i: int = first
    while (< i (array_length states)) {
        let state: ResourceState = (at states i)
        if (and (not state.moved) (resource_type_is_declared parser state.type_name)) {
            (resource_flow_error diags file_name state.line state.column (+ "resource remains live at scope exit: " state.name))
        }
        set i (+ i 1)
    }
}

shadow resource_resolve_exit {
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    (resource_resolve_exit (resource_test_parser "") (resource_copy [] 0) 0 diags "test.nano")
    assert (== (Diagnostics.diag_list_count diags) 0)
}

fn resource_join(parser: Parser, left: ResourceFlow, right: ResourceFlow, diags: List<CompilerDiagnostic>, file_name: string) -> ResourceFlow {
    if (not left.next) { return right }
    if (not right.next) { return left }
    let mut i: int = 0
    while (< i (array_length left.states)) {
        let a: ResourceState = (at left.states i)
        let b: ResourceState = (at right.states i)
        if (and (!= a.moved b.moved) (resource_type_is_declared parser a.type_name)) {
            (resource_flow_error diags file_name a.line a.column (+ "branches disagree on resource ownership: " a.name))
        }
        set i (+ i 1)
    }
    return left
}

shadow resource_join {
    let empty: array<ResourceState> = []
    let joined: ResourceFlow = (resource_join (resource_test_parser "") ResourceFlow { states: empty, next: false } ResourceFlow { states: empty, next: true } (list_CompilerDiagnostic_new) "test.nano")
    assert joined.next
}

fn resource_loop_edge(parser: Parser, states: array<ResourceState>, entry: array<ResourceState>, diags: List<CompilerDiagnostic>, file_name: string) -> void {
    (resource_resolve_exit parser states (array_length entry) diags file_name)
    let mut i: int = 0
    while (< i (array_length entry)) {
        let before: ResourceState = (at entry i)
        let after: ResourceState = (at states i)
        if (and (!= before.moved after.moved) (resource_type_is_declared parser before.type_name)) {
            (resource_flow_error diags file_name before.line before.column (+ "loop changes ownership of an outer resource: " before.name))
        }
        set i (+ i 1)
    }
}

shadow resource_loop_edge {
    let empty: array<ResourceState> = []
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    (resource_loop_edge (resource_test_parser "") empty empty diags "test.nano")
    assert (== (Diagnostics.diag_list_count diags) 0)
}

fn resource_value_type(parser: Parser, node_id: int, node_type: int, states: array<ResourceState>) -> string {
    if (< node_id 0) { return "" }
    if (== node_type ParseNodeType.PNODE_FIELD_ACCESS) {
        let field: ASTFieldAccess = (parser_get_field_access parser node_id)
        let owner: string = (resource_value_type parser field.object field.object_type states)
        let mut i: int = 0
        while (< i (parser_get_struct_def_count parser)) {
            let record: ASTStruct = (parser_get_struct_def parser i)
            if (== (resource_type_identity parser record.name record.line) owner) {
                let mut j: int = 0
                while (< j (array_length record.field_names)) {
                    if (== (at record.field_names j) field.field_name) { return (resource_type_identity parser (at record.field_types j) record.line) }
                    set j (+ j 1)
                }
            }
            set i (+ i 1)
        }
    }
    if (== node_type ParseNodeType.PNODE_FIELD_ACCESS) {
        let field: ASTFieldAccess = (parser_get_field_access parser node_id)
        let owner: string = (resource_value_type parser field.object field.object_type states)
        let mut ui: int = 0
        while (< ui (parser_get_union_count parser)) {
            let def: ASTUnion = (parser_get_union parser ui)
            let mut offset: int = 0
            let mut variant: int = 0
            while (< variant def.variant_count) {
                let count: int = (at def.variant_field_counts variant)
                if (== (base_type_name owner) (resource_variant_key ui variant)) {
                    let mut f: int = 0
                    while (< f count) {
                        if (== field.field_name (at def.variant_field_names (+ offset f))) {
                            let concrete: string = (tc_substitute_generic (at def.variant_field_types (+ offset f)) def.generic_params (tc_generic_arguments owner))
                            return (resource_type_identity parser concrete def.line)
                        }
                        set f (+ f 1)
                    }
                }
                set offset (+ offset count)
                set variant (+ variant 1)
            }
            set ui (+ ui 1)
        }
    }
    if (== node_type ParseNodeType.PNODE_IDENTIFIER) {
        let id: ASTIdentifier = (parser_get_identifier parser node_id)
        let index: int = (resource_find states id.name)
        if (>= index 0) { let state: ResourceState = (at states index) return state.type_name }
        let mut fi: int = 0
        while (< fi (parser_get_function_count parser)) {
            let func: ASTFunction = (parser_get_function parser fi)
            if (== func.name (mb_lookup (mb_owner id.line) id.name)) {
                let mut signature: string = "fn("
                let mut pi: int = 0
                while (< pi func.param_count) {
                    if (> pi 0) { set signature (+ signature ",") }
                    let param: ASTLet = (parser_get_let parser (+ func.param_start pi))
                    set signature (+ signature param.var_type)
                    set pi (+ pi 1)
                }
                return (+ (+ signature ")->") func.return_type)
            }
            set fi (+ fi 1)
        }
    }
    if (== node_type ParseNodeType.PNODE_STRUCT_LITERAL) {
        let value: ASTStructLiteral = (parser_get_struct_literal parser node_id)
        let mut ui: int = 0
        while (< ui (parser_get_union_count parser)) {
            let union_def: ASTUnion = (parser_get_union parser ui)
            if (tc_str_starts_with value.struct_name (+ union_def.name ".")) {
                return (resource_type_identity parser union_def.name value.line)
            }
            set ui (+ ui 1)
        }
        return (resource_type_identity parser value.struct_name value.line)
    }
    if (== node_type ParseNodeType.PNODE_UNION_CONSTRUCT) { let value: ASTUnionConstruct = (parser_get_union_construct parser node_id) return (resource_type_identity parser value.union_name value.line) }
    if (== node_type ParseNodeType.PNODE_MODULE_QUALIFIED_CALL) {
        let call: ASTModuleQualifiedCall = (parser_get_module_qualified_call parser node_id)
        let target: string = (mb_lookup (mb_owner call.line) call.function_name)
        let mut i: int = 0
        while (< i (parser_get_function_count parser)) {
            let func: ASTFunction = (parser_get_function parser i)
            if (== func.name target) { return (resource_type_identity parser func.return_type func.line) }
            set i (+ i 1)
        }
    }
    if (== node_type ParseNodeType.PNODE_CALL) {
        let call: ASTCall = (parser_get_call parser node_id)
        let callee: string = (resource_value_type parser call.function call.function_type states)
        if (> (str_length callee) 0) {
            let result: NSType = (fn_type_return_type callee)
            return (type_to_string result)
        }
        if (== call.function_type ParseNodeType.PNODE_IDENTIFIER) {
            let id: ASTIdentifier = (parser_get_identifier parser call.function)
            let mut i: int = 0
            while (< i (parser_get_function_count parser)) {
                let func: ASTFunction = (parser_get_function parser i)
                if (== func.name (mb_lookup (mb_owner id.line) id.name)) { return (resource_type_identity parser func.return_type func.line) }
                set i (+ i 1)
            }
        }
    }
    return ""
}

shadow resource_value_type {
    assert (== (resource_value_type (resource_test_parser "") -1 ParseNodeType.PNODE_IDENTIFIER [] ) "")
    let parser: Parser = (resource_test_parser "resource struct Handle { fd: int } union Box<T> { Some { value: T } } fn probe() -> int { return payload.value }")
    let ret: ASTReturn = (parser_get_return parser 0)
    let owned: array<ResourceState> = [ResourceState { held_places: [], name: "payload", type_name: "#variant:0:0<#record:0>", moved: false, line: 1, column: 1 }]
    let plain: array<ResourceState> = [ResourceState { held_places: [], name: "payload", type_name: "#variant:0:0<int>", moved: false, line: 1, column: 1 }]
    assert (== (resource_value_type parser ret.value ret.value_type owned) "#record:0")
    assert (== (resource_value_type parser ret.value ret.value_type plain) "int")
    let callbacks: Parser = (resource_test_parser "fn make() -> int { return 7 } fn main() -> int { let factory = make return 0 }")
    let binding: ASTLet = (parser_get_let callbacks 0)
    assert (== (resource_value_type callbacks binding.value binding.value_type []) "fn()->int")
}

# I preserve argument nesting when substituting concrete union payload types.
fn tc_generic_arguments(spelling: string) -> array<string> {
    let text: string = (strip_spaces spelling)
    let start: int = (tc_str_index_of text "<")
    if (or (< start 0) (not (tc_str_ends_with text ">"))) { return [] }
    return (split_tuple_type_names (+ "(" (+ (str_substring text (+ start 1) (- (str_length text) (+ start 2))) ")")))
}
shadow tc_generic_arguments {
    let args: array<string> = (tc_generic_arguments "Pair<int,Box<string>>")
    assert (== (array_length args) 2)
    assert (== (at args 1) "Box<string>")
    assert (== (array_length (tc_generic_arguments "int")) 0)
}

fn tc_substitute_generic(spelling: string, params: array<string>, args: array<string>) -> string {
    return (substitute_type_parameters spelling params args)
}
shadow tc_substitute_generic {
    assert (== (tc_substitute_generic "Pair<T,array<E>>" ["T", "E"] ["int", "Handle"]) "Pair<int,array<Handle>>")
    assert (== (tc_substitute_generic "Tree" ["T"] ["int"]) "Tree")
}

fn resource_instantiated_classify(parser: Parser, spelling: string, line: int, depth: int, collections_only: bool) -> bool {
    if (tc_str_starts_with spelling "fn(") { return false }
    # I fail closed at my finite substitution boundary.
    if (> depth 128) { return true }
    if (and (tc_str_starts_with spelling "(") (tc_str_ends_with spelling ")")) {
        let fields: array<string> = (split_tuple_type_names spelling)
        let mut field: int = 0
        while (< field (array_length fields)) {
            if (resource_instantiated_classify parser (at fields field) line (+ depth 1) collections_only) { return true }
            set field (+ field 1)
        }
        return false
    }
    let identity: string = (resource_type_identity parser spelling line)
    let base: string = (base_type_name identity)
    if (resource_classify parser base collections_only) { return true }
    let args: array<string> = (tc_generic_arguments identity)
    if (== (array_length args) 0) { return false }
    let mut i: int = 0
    while (< i (parser_get_union_count parser)) {
        let def: ASTUnion = (parser_get_union parser i)
        let mut offset: int = 0
        let mut variant: int = 0
        while (< variant def.variant_count) {
            let count: int = (at def.variant_field_counts variant)
            if (== base (resource_variant_key i variant)) {
                if (!= def.generic_param_count (array_length args)) { return true }
                let mut field: int = 0
                while (< field count) {
                    let concrete: string = (tc_substitute_generic (at def.variant_field_types (+ offset field)) def.generic_params args)
                    if (resource_instantiated_classify parser concrete def.line (+ depth 1) collections_only) { return true }
                    set field (+ field 1)
                }
                return false
            }
            set offset (+ offset count)
            set variant (+ variant 1)
        }
        if (== (resource_type_identity parser def.name def.line) base) {
            if (!= def.generic_param_count (array_length args)) { return true }
            let mut field: int = 0
            while (< field (array_length def.variant_field_types)) {
                let concrete: string = (tc_substitute_generic (at def.variant_field_types field) def.generic_params args)
                if (resource_instantiated_classify parser concrete def.line (+ depth 1) collections_only) { return true }
                set field (+ field 1)
            }
            return false
        }
        set i (+ i 1)
    }
    # Collections and unknown generic boundaries retain conservative rejection.
    let collection: bool = (or (== base "array") (or (== base "List") (== base "HashMap")))
    set i 0
    while (< i (array_length args)) {
        if (resource_instantiated_classify parser (at args i) line (+ depth 1) (and collections_only (not collection))) { return true }
        set i (+ i 1)
    }
    return false
}
shadow resource_instantiated_classify {
    let parser: Parser = (resource_test_parser "resource struct Handle { fd: int } union Box<T> { Some { value: T }, None {} } union Marker<T> { Mark { value: int } } union Values<T> { Some { values: array<T> } }")
    assert (resource_instantiated_classify parser "Box<Handle>" 1 0 false)
    assert (not (resource_instantiated_classify parser "Box<int>" 1 0 false))
    assert (not (resource_instantiated_classify parser "Marker<Handle>" 1 0 false))
    assert (resource_instantiated_classify parser "#variant:0:0<#record:0>" 1 0 false)
    assert (not (resource_instantiated_classify parser "#variant:0:1<#record:0>" 1 0 false))
    assert (not (resource_instantiated_classify parser "#variant:1:0<#record:0>" 1 0 false))
    assert (resource_instantiated_classify parser "Values<Handle>" 1 0 true)
    assert (not (resource_instantiated_classify parser "Box<Handle>" 1 0 true))
    assert (resource_instantiated_classify parser "Box<Values<Handle>>" 1 0 true)
    assert (resource_instantiated_classify parser "(Handle,int)" 1 0 false)
    assert (not (resource_instantiated_classify parser "(int,string)" 1 0 false))
    assert (not (resource_instantiated_classify parser "(Handle,int)" 1 0 true))
}

fn resource_generic_contains(parser: Parser, spelling: string, line: int, depth: int) -> bool {
    return (resource_instantiated_classify parser spelling line depth false)
}
shadow resource_generic_contains {
    let parser: Parser = (resource_test_parser "resource struct Handle { fd: int } union Box<T> { Some { value: T }, None {} } union Marker<T> { Mark { value: int } }")
    assert (resource_generic_contains parser "Box<Handle>" 1 0)
    assert (resource_generic_contains parser "array<Box<Handle>>" 1 0)
    assert (not (resource_generic_contains parser "Box<int>" 1 0))
    assert (not (resource_generic_contains parser "Marker<Handle>" 1 0))
    assert (not (resource_generic_contains parser "fn()->Marker<Handle>" 1 0))
    assert (not (resource_type_is_declared parser "fn()->Marker<Handle>"))
}

# I admit only closed payload shapes whose selected fields can transfer.
fn resource_transfer_supported(parser: Parser, spelling: string, line: int, depth: int) -> bool {
    if (> depth 128) { return false }
    if (not (resource_generic_contains parser spelling line 0)) { return true }
    let identity: string = (resource_type_identity parser spelling line)
    if (resource_has_collection_payload parser identity) { return false }
    let base: string = (base_type_name identity)
    let args: array<string> = (tc_generic_arguments identity)
    if (and (tc_str_starts_with base "#record:") (== (array_length args) 0)) { return true }
    let mut index: int = 0
    while (< index (parser_get_union_count parser)) {
        let definition: ASTUnion = (parser_get_union parser index)
        let whole: bool = (== base (+ "#union:" (int_to_string index)))
        let mut offset: int = 0
        let mut variant: int = 0
        let mut found: bool = false
        while (< variant definition.variant_count) {
            let count: int = (at definition.variant_field_counts variant)
            if (or whole (== base (resource_variant_key index variant))) {
                set found true
                if (!= definition.generic_param_count (array_length args)) { return false }
                let mut field: int = 0
                while (< field count) {
                    let concrete: string = (tc_substitute_generic (at definition.variant_field_types (+ offset field)) definition.generic_params args)
                    if (not (resource_transfer_supported parser concrete definition.line (+ depth 1))) { return false }
                    set field (+ field 1)
                }
            }
            set offset (+ offset count)
            set variant (+ variant 1)
        }
        if found { return true }
        set index (+ index 1)
    }
    return false
}
shadow resource_transfer_supported {
    let parser: Parser = (resource_test_parser "resource struct Handle { fd: int } union Box<T> { Some { value: T }, None {} } union Bundle<T> { Some { value: (T,int) } }")
    assert (resource_transfer_supported parser "Box<Handle>" 1 0)
    assert (resource_transfer_supported parser "#variant:0:1<#record:0>" 1 0)
    assert (resource_transfer_supported parser "Box<Box<Handle>>" 1 0)
    assert (not (resource_transfer_supported parser "Box<array<Handle>>" 1 0))
    assert (not (resource_transfer_supported parser "Bundle<Handle>" 1 0))
}

# I walk function annotations separately from owned values: a callback is
# ordinary, but its resource transfer contract can still be unsupported.
fn resource_callback_unsupported(parser: Parser, spelling: string, line: int, depth: int) -> bool {
    if (> depth 128) { return true }
    if (tc_str_starts_with spelling "fn(") {
        let params: array<NSType> = (fn_type_param_types spelling)
        let mut i: int = 0
        while (< i (array_length params)) {
            if (resource_callback_unsupported parser (type_to_string (at params i)) line (+ depth 1)) { return true }
            set i (+ i 1)
        }
        return (resource_callback_unsupported parser (type_to_string (fn_type_return_type spelling)) line (+ depth 1))
    }
    if (resource_instantiated_classify parser spelling line 0 true) { return true }
    if (not (resource_generic_contains parser spelling line 0)) { return false }
    if (> (array_length (tc_generic_arguments spelling)) 0) { return true }
    return (not (resource_transfer_supported parser spelling line 0))
}
shadow resource_callback_unsupported {
    let parser: Parser = (resource_test_parser "resource struct Handle { fd: int } union Box<T> { Some { value: T }, None {} } union Marker<T> { Mark { value: int } }")
    assert (resource_callback_unsupported parser "fn()->Box<Handle>" 1 0)
    assert (resource_callback_unsupported parser "fn(Box<Handle>)->int" 1 0)
    assert (resource_callback_unsupported parser "fn()->fn()->Box<Handle>" 1 0)
    assert (not (resource_callback_unsupported parser "fn()->Handle" 1 0))
    assert (not (resource_callback_unsupported parser "fn()->Marker<Handle>" 1 0))
    assert (not (resource_callback_unsupported parser "fn()->Box<int>" 1 0))
}

fn resource_check_annotation(parser: Parser, spelling: string, diags: List<CompilerDiagnostic>, file_name: string, line: int, column: int) -> void {
    if (tc_str_starts_with spelling "fn(") {
        if (str_contains spelling "&") {
            (resource_flow_error diags file_name line column "I do not support borrowed callback signatures yet")
            return
        }
        if (resource_callback_unsupported parser spelling line 0) {
            (resource_flow_error diags file_name line column "generic resource callback signatures need ownership lowering")
        }
        return
    }
    if (resource_has_collection_payload parser (resource_type_identity parser spelling line)) {
        (resource_flow_error diags file_name line column "resource-bearing union collection payloads are not supported")
        return
    }
    let typ: NSType = (type_from_string spelling)
    let collection: bool = (or (== typ.kind TypeKind.TYPE_ARRAY) (or (== typ.kind TypeKind.TYPE_LIST_GENERIC) (tc_str_starts_with spelling "HashMap<")))
    if (and (not collection) (== (array_length (tc_generic_arguments spelling)) 0)) { return }
    if (resource_generic_contains parser spelling line 0) {
        if collection { (resource_flow_error diags file_name line column "resource-bearing collections are not supported") }
        else { if (not (resource_transfer_supported parser spelling line 0)) {
            (resource_flow_error diags file_name line column "this resource payload shape needs ownership lowering")
        } }
    }
    if (not collection) { return }
    let tokens: List<LexerToken> = (tokenize_string spelling file_name (list_CompilerDiagnostic_new))
    let mut i: int = 0
    while (< i (list_LexerToken_length tokens)) {
        let token: LexerToken = (list_LexerToken_get tokens i)
        if (resource_type_is_declared parser (resource_type_identity parser token.value line)) {
            (resource_flow_error diags file_name line column "resource-bearing collections are not supported")
        }
        set i (+ i 1)
    }
}

shadow resource_check_annotation {
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    (resource_check_annotation (resource_test_parser "") "array<int>" diags "test.nano" 1 1)
    (resource_check_annotation (resource_test_parser "") "fn(int)->int" diags "test.nano" 1 1)
    assert (== (Diagnostics.diag_list_count diags) 0)
    let borrowed: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    (resource_check_annotation (resource_test_parser "") "fn(&Handle)->int" borrowed "test.nano" 1 1)
    assert (== (Diagnostics.diag_list_count borrowed) 1)
}

fn resource_flow_block(parser: Parser, statements: List<ASTStmtRef>, states: array<ResourceState>, move: bool, loop_entry: array<ResourceState>, diags: List<CompilerDiagnostic>, file_name: string, return_type: string, expected_type: string) -> ResourceFlow {
    let first: int = (array_length states)
    let mut flow: ResourceFlow = ResourceFlow { states: (resource_copy states first), next: true }
    let mut i: int = 0
    while (and flow.next (< i (list_ASTStmtRef_length statements))) {
        let stmt: ASTStmtRef = (list_ASTStmtRef_get statements i)
        let final_value: bool = (and move (== i (- (list_ASTStmtRef_length statements) 1)))
        set flow (resource_flow_value parser stmt.node_id stmt.node_type (cond (final_value expected_type) (else "")) flow.states final_value loop_entry diags file_name return_type)
        set i (+ i 1)
    }
    if flow.next { (resource_resolve_exit parser flow.states first diags file_name) }
    return ResourceFlow { states: (resource_copy flow.states first), next: flow.next }
}

shadow resource_flow_block {
    let flow: ResourceFlow = (resource_flow_block (resource_test_parser "") (list_ASTStmtRef_new) [] false [] (list_CompilerDiagnostic_new) "test.nano" "" "")
    assert flow.next
    assert (== (array_length flow.states) 0)
}

fn resource_union_index(parser: Parser, input: string) -> int {
    let identity: string = (base_type_name (resource_type_identity parser input 0))
    let mut i: int = 0
    while (< i (parser_get_union_count parser)) {
        if (== identity (+ "#union:" (int_to_string i))) { return i }
        set i (+ i 1)
    }
    return -1
}
shadow resource_union_index {
    let parser: Parser = (resource_test_parser "union Choice { None {} } union Box<T> { Some { item: T } }")
    assert (== (resource_union_index parser "Box<int>") 1)
    assert (== (resource_union_index parser "#union:1<int>") 1)
    assert (== (resource_union_index parser "missing") -1)
}

fn resource_selected_identity(input: string, union_index: int, variant_index: int) -> string {
    let key: string = (resource_variant_key union_index variant_index)
    let start: int = (tc_str_index_of input "<")
    if (< start 0) { return key }
    return (+ key (str_substring input start (- (str_length input) start)))
}
shadow resource_selected_identity {
    assert (== (resource_selected_identity "#union:2<int,#record:0>" 2 1) "#variant:2:1<int,#record:0>")
    assert (== (resource_selected_identity "#union:2" 2 1) "#variant:2:1")
}

fn resource_owned_union_index(parser: Parser, input: string) -> int {
    let index: int = (resource_union_index parser input)
    if (< index 0) { return -1 }
    let def: ASTUnion = (parser_get_union parser index)
    if (!= def.generic_param_count (array_length (tc_generic_arguments input))) { return -1 }
    if (or (resource_has_collection_payload parser input) (not (resource_transfer_supported parser input def.line 0))) { return -1 }
    return index
}
shadow resource_owned_union_index {
    let parser: Parser = (resource_test_parser "union Choice { None {} } union Box<T> { Some { item: T } }")
    assert (== (resource_owned_union_index parser "Choice") 0)
    assert (== (resource_owned_union_index parser "Box") -1)
    assert (== (resource_owned_union_index parser "Box<int>") 1)
}

# I visit real guard effects but retain a checked refusal for changed owner state.
fn resource_guard_preserves(parser: Parser, before: array<ResourceState>, after: ResourceFlow, line: int, column: int, diags: List<CompilerDiagnostic>, file_name: string) -> void {
    let mut same: bool = (and after.next (== (array_length before) (array_length after.states)))
    if same {
        let mut i: int = 0
        while (< i (array_length before)) {
            let a: ResourceState = (at before i)
            let b: ResourceState = (at after.states i)
            if (and (resource_type_is_declared parser a.type_name) (!= a.moved b.moved)) { set same false }
            if (!= (array_length a.held_places) (array_length b.held_places)) { set same false }
            else {
                let mut j: int = 0
                while (< j (array_length a.held_places)) {
                    if (!= (at a.held_places j) (at b.held_places j)) { set same false }
                    set j (+ j 1)
                }
            }
            set i (+ i 1)
        }
    }
    if (not same) { (resource_flow_error diags file_name line column "I do not yet accept ownership-changing or terminal match guards") }
}
shadow resource_guard_preserves {
    let parser: Parser = (resource_test_parser "resource struct Handle { fd: int }")
    let state: array<ResourceState> = [ResourceState { held_places: [], name: "h", type_name: "Handle", moved: false, line: 1, column: 1 }]
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    (resource_guard_preserves parser state ResourceFlow { states: state, next: true } 1 1 diags "guard.nano")
    assert (== (Diagnostics.diag_list_count diags) 0)
    (resource_guard_preserves parser state ResourceFlow { states: (resource_replace state 0 true), next: true } 1 1 diags "guard.nano")
    assert (== (Diagnostics.diag_list_count diags) 1)
    let guarded: Parser = (resource_test_parser "resource struct Handle { fd: int } fn consume(h: Handle) -> bool { return false } fn read(h: Handle) -> int { return match 1 { _ if (consume h) => 1 _ => 0 } }")
    let errors: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let walked: ResourceFlow = (resource_flow_node guarded 0 ParseNodeType.PNODE_MATCH state false [] errors "guard.nano" "int" "")
    assert (> (Diagnostics.diag_list_count errors) 0)
}

fn resource_match_supported(parser: Parser, matched: ASTMatch, input: string) -> bool {
    let index: int = (resource_owned_union_index parser input)
    if (< index 0) { return false }
    let def: ASTUnion = (parser_get_union parser index)
    if (!= matched.arm_count def.variant_count) { return false }
    let mut arm: int = 0
    while (< arm matched.arm_count) {
        let name: string = (at matched.arm_variants arm)
        if (>= (at matched.arm_guard_ids arm) 0) { return false }
        if (not (resource_name_in def.variant_names name)) { return false }
        let mut prior: int = 0
        while (< prior arm) {
            if (== name (at matched.arm_variants prior)) { return false }
            set prior (+ prior 1)
        }
        set arm (+ arm 1)
    }
    return true
}
shadow resource_match_supported {
    let parser: Parser = (resource_test_parser "union Choice { None {} } fn read(value: Choice) -> int { match value { None(payload) => { return 0 } } }")
    assert (resource_match_supported parser (parser_get_match parser 0) "Choice")
}

fn resource_parameter_type(parser: Parser, name: string, line: int, argument: int, states: array<ResourceState>) -> string {
    if (>= (resource_find states name) 0) { return "" }
    let target: string = (mb_lookup (mb_owner line) name)
    let mut index: int = 0
    while (< index (parser_get_function_count parser)) {
        let definition: ASTFunction = (parser_get_function parser index)
        if (and (== definition.name target) (< argument definition.param_count)) {
            let parameter: ASTLet = (parser_get_let parser (+ definition.param_start argument))
            return (resource_type_identity parser parameter.var_type parameter.line)
        }
        set index (+ index 1)
    }
    return ""
}
shadow resource_parameter_type {
    let parser: Parser = (resource_test_parser "union Box<T> { Some { value: T } } fn read(value: Box<int>) -> int { return 0 }")
    assert (== (resource_parameter_type parser "read" 1 0 []) "#union:0<int>")
    assert (== (resource_parameter_type parser "read" 1 1 []) "")
}

# I pass an already checked declared context to union constructor payloads.
# Other expression forms keep their existing ownership traversal.
fn resource_flow_value(parser: Parser, node_id: int, node_type: int, expected: string, states: array<ResourceState>, move: bool, loop_entry: array<ResourceState>, diags: List<CompilerDiagnostic>, file_name: string, return_type: string) -> ResourceFlow {
    let index: int = (resource_owned_union_index parser expected)
    if (or (< index 0) (not (or (== node_type ParseNodeType.PNODE_UNION_CONSTRUCT) (== node_type ParseNodeType.PNODE_STRUCT_LITERAL)))) {
        return (resource_flow_node parser node_id node_type states move loop_entry diags file_name return_type expected)
    }
    let identity: string = (resource_type_identity parser expected 0)
    let actual: string = (resource_value_type parser node_id node_type states)
    if (!= (base_type_name actual) (base_type_name identity)) {
        return (resource_flow_node parser node_id node_type states move loop_entry diags file_name return_type expected)
    }
    let definition: ASTUnion = (parser_get_union parser index)
    let mut names: array<string> = []
    let mut ids: array<int> = []
    let mut types: array<int> = []
    let mut selected: string = ""
    let mut line: int = 0
    let mut column: int = 0
    if (== node_type ParseNodeType.PNODE_UNION_CONSTRUCT) {
        let literal: ASTUnionConstruct = (parser_get_union_construct parser node_id)
        set names literal.field_names set ids literal.field_value_ids set types literal.field_value_types
        set selected literal.variant_name set line literal.line set column literal.column
    } else {
        let literal: ASTStructLiteral = (parser_get_struct_literal parser node_id)
        set names literal.field_names set ids literal.field_value_ids set types literal.field_value_types
        let prefix: string = (+ definition.name ".")
        if (not (tc_str_starts_with literal.struct_name prefix)) {
            return (resource_flow_node parser node_id node_type states move loop_entry diags file_name return_type expected)
        }
        set selected (str_substring literal.struct_name (str_length prefix) (- (str_length literal.struct_name) (str_length prefix)))
        set line literal.line set column literal.column
    }
    let mut flow: ResourceFlow = ResourceFlow { states: states, next: true }
    let mut offset: int = 0
    let mut variant: int = 0
    while (< variant definition.variant_count) {
        let count: int = (at definition.variant_field_counts variant)
        if (== selected (at definition.variant_names variant)) {
            let mut field: int = 0
            while (and flow.next (< field (array_length names))) {
                let mut slot: int = 0
                let mut context: string = ""
                while (< slot count) {
                    if (== (at names field) (at definition.variant_field_names (+ offset slot))) {
                        set context (tc_substitute_generic (at definition.variant_field_types (+ offset slot)) definition.generic_params (tc_generic_arguments identity))
                    }
                    set slot (+ slot 1)
                }
                set flow (resource_flow_value parser (at ids field) (at types field) (resource_type_identity parser context definition.line) flow.states true loop_entry diags file_name return_type)
                set field (+ field 1)
            }
            if (and flow.next (and (not move) (resource_type_is_declared parser identity))) {
                (resource_flow_error diags file_name line column "resource construction has no resolved owner")
            }
            return flow
        }
        set offset (+ offset count)
        set variant (+ variant 1)
    }
    return (resource_flow_node parser node_id node_type states move loop_entry diags file_name return_type expected)
}
shadow resource_flow_value {
    let parser: Parser = (resource_test_parser "union Box<T> { Some { value: T }, None {} } fn read() -> int { let value: Box<int> = Box.Some { value: 7 } return 0 }")
    let binding: ASTLet = (parser_get_let parser 0)
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let result: ResourceFlow = (resource_flow_value parser binding.value binding.value_type "Box<int>" [] true [] diags "test.nano" "")
    assert result.next
    assert (== (Diagnostics.diag_list_count diags) 0)
}

fn resource_flow_node(parser: Parser, node_id: int, node_type: int, states: array<ResourceState>, move: bool, loop_entry: array<ResourceState>, diags: List<CompilerDiagnostic>, file_name: string, return_type: string, expected_type: string) -> ResourceFlow {
    let mut flow: ResourceFlow = ResourceFlow { states: states, next: true }
    if (or (== node_type ParseNodeType.PNODE_BREAK) (== node_type ParseNodeType.PNODE_CONTINUE)) {
        (resource_loop_edge parser states loop_entry diags file_name)
