    if (== node_type ParseNodeType.PNODE_UNSAFE_BLOCK) {
        let block: ASTUnsafeBlock = (parser_get_unsafe_block parser node_id)
        return (resource_flow_block parser block.statements states move loop_entry diags file_name return_type expected_type)
    }
    if (== node_type ParseNodeType.PNODE_LET) {
        let binding: ASTLet = (parser_get_let parser node_id)
        let mut nominal: string = binding.var_type
        if (or binding.is_destructure (or (== nominal "") (== nominal "unknown"))) { set nominal (resource_value_type parser binding.value binding.value_type states) }
        (resource_check_annotation parser nominal diags file_name binding.line binding.column)
        if (not binding.is_destructure_projection) {
            set flow (resource_flow_value parser binding.value binding.value_type (resource_type_identity parser nominal binding.line) states true loop_entry diags file_name return_type)
        }
        if flow.next {
            let updated: array<ResourceState> = (resource_copy flow.states (array_length flow.states))
            return ResourceFlow { states: (array_push updated ResourceState { held_places: [], name: binding.name, type_name: (resource_type_identity parser nominal binding.line), moved: binding.is_destructure, line: binding.line, column: binding.column }), next: true }
        }
        return flow
    }
    if (== node_type ParseNodeType.PNODE_SET) {
        let assignment: ASTSet = (parser_get_set parser node_id)
        let index: int = (resource_find states assignment.target)
        if (!= assignment.field_name "") {
            let mut allowed: bool = false
            if (>= index 0) {
                let owner: ResourceState = (at states index)
                set allowed (and (str_starts_with owner.type_name "&mut ") (and (not owner.moved) (not (resource_place_conflict owner.held_places (+ "." assignment.field_name) true))))
            }
            if (not allowed) { (resource_flow_error diags file_name assignment.line assignment.column "I require an available exclusive borrow for field mutation") }
            return (resource_flow_node parser assignment.value assignment.value_type states true loop_entry diags file_name return_type "")
