        }
        let mut context: string = ""
        if (>= index 0) { let destination: ResourceState = (at states index) set context destination.type_name }
        set flow (resource_flow_value parser assignment.value assignment.value_type context states true loop_entry diags file_name return_type)
        if (and flow.next (>= index 0)) { return ResourceFlow { states: (resource_replace flow.states index false), next: true } }
        return flow
    }
    if (== node_type ParseNodeType.PNODE_RETURN) {
        let ret: ASTReturn = (parser_get_return parser node_id)
        set flow (resource_flow_value parser ret.value ret.value_type return_type states true loop_entry diags file_name return_type)
        if flow.next { (resource_resolve_exit parser flow.states 0 diags file_name) }
        return ResourceFlow { states: flow.states, next: false }
    }
    if (== node_type ParseNodeType.PNODE_IF) {
        let branch: ASTIf = (parser_get_if parser node_id)
        set flow (resource_flow_node parser branch.condition branch.condition_type states false loop_entry diags file_name return_type "")
        if (not flow.next) { return flow }
        let left: ResourceFlow = (resource_flow_value parser branch.then_body ParseNodeType.PNODE_BLOCK expected_type (resource_copy flow.states (array_length flow.states)) move loop_entry diags file_name return_type)
        let right: ResourceFlow = (resource_flow_value parser branch.else_body ParseNodeType.PNODE_BLOCK expected_type (resource_copy flow.states (array_length flow.states)) move loop_entry diags file_name return_type)
        return (resource_join parser left right diags file_name)
    }
    if (== node_type ParseNodeType.PNODE_MATCH) {
        let matched: ASTMatch = (parser_get_match parser node_id)
        let input: string = (resource_value_type parser matched.scrutinee matched.scrutinee_type states)
        let owned: bool = (resource_generic_contains parser input matched.line 0)
        let supported: bool = (resource_match_supported parser matched input)
        if (and owned (not supported)) {
            (resource_flow_error diags file_name matched.line matched.column "I require an exhaustive unguarded owned match with supported concrete payloads")
        }
        set flow (resource_flow_node parser matched.scrutinee matched.scrutinee_type states (and owned supported) loop_entry diags file_name return_type "")
        if (not flow.next) { return flow }
        let first: int = (array_length flow.states)
        let mut joined: ResourceFlow = ResourceFlow { states: flow.states, next: false }
        let mut arm: int = 0
        while (< arm matched.arm_count) {
            let mut arm_states: array<ResourceState> = (resource_copy flow.states first)
            let mut payload: string = ""
            let index: int = (resource_union_index parser input)
            if (>= index 0) {
                let def: ASTUnion = (parser_get_union parser index)
                let mut variant: int = 0
