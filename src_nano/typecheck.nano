fn check_variant_field_type(parser: Parser, variant_label: string, field_name: string, concrete: string) -> NSType {
    let mut ui: int = 0
    while (< ui (parser_get_union_count parser)) {
        let u: ASTUnion = (parser_get_union parser ui)
        let mut vi: int = 0
        let mut offset: int = 0
        while (< vi u.variant_count) {
            let count: int = (at u.variant_field_counts vi)
            if (== variant_label (+ u.name (+ "." (at u.variant_names vi)))) {
                let mut fi: int = 0
                while (< fi count) {
                    if (== field_name (at u.variant_field_names (+ offset fi))) {
                        return (type_from_string_with_parser parser (tc_substitute_generic (at u.variant_field_types (+ offset fi)) u.generic_params (tc_generic_arguments concrete)))
                    }
                    set fi (+ fi 1)
                }
            }
            set offset (+ offset count)
            set vi (+ vi 1)
        }
        set ui (+ ui 1)
    }
    return (type_unknown_named "variant_field")
}

shadow check_variant_field_type {
    let toks: List<LexerToken> = (tokenize_string "union Choice { Some { value: string }, None {} }" "variant.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program toks (list_LexerToken_length toks) "variant.nano")
    let found: NSType = (check_variant_field_type parser "Choice.Some" "value" "Choice")
    assert (== found.kind TypeKind.TYPE_STRING)
    let missing: NSType = (check_variant_field_type parser "Choice.None" "value" "Choice")
    assert (== missing.kind TypeKind.TYPE_UNKNOWN)
}

fn tc_bound_name(name: string, line: int, symbols: array<Symbol>) -> string {
    let index: int = (env_lookup symbols name)
    if (>= index 0) {
        let symbol: Symbol = (at symbols index)
        if (not symbol.is_function) { return name }
    }
    return (mb_lookup (mb_owner line) name)
}
shadow tc_bound_name {
    (mb_reset [1])
    (mb_add 0 "answer" "owned_answer")
    assert (== (tc_bound_name "answer" 1 []) "owned_answer")
    let symbols: array<Symbol> = [(symbol_new "answer" (type_int) false false 0 (empty_param_types) (type_void))]
    assert (== (tc_bound_name "answer" 1 symbols) "answer")
    (mb_reset [])
}

fn reduce_type_known(parser: Parser, value: NSType) -> bool {
    # I retain the existing reserved byte spelling used by contextual conversion.
    if (and (== value.kind TypeKind.TYPE_STRUCT) (== value.name "u8")) { return true }
    if (or (== value.kind TypeKind.TYPE_UNKNOWN) (== value.kind TypeKind.TYPE_GENERIC)) { return false }
    if (== value.kind TypeKind.TYPE_ARRAY) {
        if (== value.element_type_kind TypeKind.TYPE_UNKNOWN) { return false }
        return (reduce_type_known parser (type_from_string_with_parser parser (type_kind_to_string value.element_type_kind value.element_type_name)))
    }
    if (== value.kind TypeKind.TYPE_FUNCTION) {
        if (not (tc_str_starts_with value.name "fn(")) { return false }
        let parameters: array<NSType> = (fn_type_params_with_parser parser value.name)
        let mut i: int = 0
        while (< i (array_length parameters)) {
            if (not (reduce_type_known parser (at parameters i))) { return false }
            set i (+ i 1)
        }
        return (reduce_type_known parser (type_from_string_with_parser parser (type_to_string (fn_type_return_type value.name))))
    }
    if (== value.kind TypeKind.TYPE_TUPLE) {
        let components: array<string> = (split_tuple_type_names value.name)
        if (== (array_length components) 0) { return false }
        let mut i: int = 0
        while (< i (array_length components)) {
            if (not (reduce_type_known parser (type_from_string_with_parser parser (at components i)))) { return false }
            set i (+ i 1)
        }
        return true
    }
    if (== value.kind TypeKind.TYPE_LIST_GENERIC) {
        return (reduce_type_known parser (type_from_string_with_parser parser value.element_type_name))
    }
    if (or (== value.kind TypeKind.TYPE_STRUCT) (== value.kind TypeKind.TYPE_UNION)) {
        let spelling: string = (type_to_string value)
        let base: string = (base_type_name spelling)
        let arguments: array<string> = (tc_generic_arguments spelling)
        let mut declared: bool = (tc_is_opaque_name parser base)
        let mut i: int = 0
        while (< i (parser_get_struct_def_count parser)) {
            if (== (parser_get_struct_def parser i).name base) { set declared true }
            set i (+ i 1)
        }
        set i 0
        while (< i (parser_get_union_count parser)) {
            let definition: ASTUnion = (parser_get_union parser i)
            if (== definition.name base) { set declared (== definition.generic_param_count (array_length arguments)) }
            set i (+ i 1)
        }
        if (not declared) { return false }
        set i 0
        while (< i (array_length arguments)) {
            if (not (reduce_type_known parser (type_from_string_with_parser parser (at arguments i)))) { return false }
            set i (+ i 1)
        }
    }
    return true
}
shadow reduce_type_known {
    let parser: Parser = (resource_test_parser "union Box<T> { Some { value: T } }")
    assert (reduce_type_known parser (type_from_string_with_parser parser "array<Box<int>>"))
    assert (reduce_type_known parser (type_from_string "array<u8>"))
    assert (not (reduce_type_known parser (type_from_string_with_parser parser "array<array<unknown>>")))
    assert (not (reduce_type_known parser (type_from_string_with_parser parser "Box<unknown>")))
    assert (not (reduce_type_known parser (type_from_string_with_parser parser "Box<T>")))
    assert (not (reduce_type_known parser (type_from_string_with_parser parser "fn(unknown,int)->int")))
    assert (not (reduce_type_known parser (type_from_string_with_parser parser "fn(int,int)->unknown")))
}

fn reduce_types_exact(parser: Parser, actual: NSType, expected: NSType) -> bool {
    if (!= actual.kind expected.kind) { return false }
    if (not (and (reduce_type_known parser actual) (reduce_type_known parser expected))) { return false }
    return (== (strip_spaces (type_to_string actual)) (strip_spaces (type_to_string expected)))
}
shadow reduce_types_exact {
    let parser: Parser = (resource_test_parser "enum Number { One } union Box<T> { Some { value: T } }")
    assert (not (reduce_types_exact parser (type_from_string_with_parser parser "Number") (type_int)))
    assert (not (reduce_types_exact parser (type_int) (type_from_string "unknown")))
    assert (not (reduce_types_exact parser (type_from_string_with_parser parser "Box<int>") (type_from_string_with_parser parser "Box<string>")))
    assert (reduce_types_exact parser (type_from_string_with_parser parser "array<Box<int>>") (type_from_string_with_parser parser "array<Box<int>>"))
}

fn check_reduce_call(parser: Parser, call: ASTCall, symbols: array<Symbol>, diags: List<CompilerDiagnostic>, file_name: string) -> NSType {
    let location: CompilerSourceLocation = (Diagnostics.diag_location file_name call.line call.column)
    if (!= call.arg_count 3) {
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0010" "I require an array, initializer and binary callback in reduce." location))
        return (type_unknown_named "reduce")
    }
    let source: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
    let initial: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
    let callback: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 2))
    let source_type: NSType = (check_expr_node parser source.node_id source.node_type symbols diags file_name)
    let accumulator: NSType = (check_expr_node parser initial.node_id initial.node_type symbols diags file_name)
    let callback_type: NSType = (check_expr_node parser callback.node_id callback.node_type symbols diags file_name)
    if (or (!= source_type.kind TypeKind.TYPE_ARRAY) (!= callback_type.kind TypeKind.TYPE_FUNCTION)) {
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0010" "I require an array and a function callback in reduce." location))
        return (type_unknown_named "reduce")
    }
    let parameters: array<NSType> = (fn_type_params_with_parser parser callback_type.name)
    let result: NSType = (type_from_string_with_parser parser (type_to_string (fn_type_return_type callback_type.name)))
    if (!= (array_length parameters) 2) {
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0010" "I require a binary callback in reduce." location))
        return (type_unknown_named "reduce")
    }
    let first: NSType = (at parameters 0)
    let element: NSType = (at parameters 1)
    let known: bool = (and (and (reduce_type_known parser accumulator) (!= accumulator.kind TypeKind.TYPE_VOID)) (and (reduce_type_known parser element) (!= element.kind TypeKind.TYPE_VOID)))
    let mut matches: bool = (and known (and (reduce_types_exact parser accumulator first) (reduce_types_exact parser accumulator result)))
    if (== source_type.element_type_kind TypeKind.TYPE_UNKNOWN) {
        let mut empty_literal: bool = false
        if (== source.node_type ParseNodeType.PNODE_ARRAY_LITERAL) {
            set empty_literal (== (parser_get_array_literal parser source.node_id).element_count 0)
        }
        set matches (and matches empty_literal)
    } else {
        set matches (and matches (reduce_types_exact parser source_type (type_array_of element)))
    }
    if (not matches) {
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0010" "I require reduce callback fn(A,E)->A to match the initializer and array elements exactly." location))
        return (type_unknown_named "reduce")
    }
    return accumulator
}
shadow check_reduce_call {
    let tokens: List<LexerToken> = (tokenize_string "fn main() -> int { let value = (reduce [1.0] 0.0 combine) return 0 }" "reduce.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "reduce.nano")
    let symbols: array<Symbol> = [(symbol_new "combine" (type_float) false true 2 [(type_float),(type_float)] (type_float))]
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    assert (== (check_reduce_call parser (parser_get_call parser 0) symbols diags "reduce.nano").kind TypeKind.TYPE_FLOAT)
    assert (== (list_CompilerDiagnostic_length diags) 0)
    let wrong: array<Symbol> = [(symbol_new "combine" (type_int) false true 2 [(type_float),(type_float)] (type_int))]
    assert (== (check_reduce_call parser (parser_get_call parser 0) wrong diags "reduce.nano").kind TypeKind.TYPE_UNKNOWN)
    assert (> (list_CompilerDiagnostic_length diags) 0)
}

# I carry empty syntax and terminal control separately from missing type facts.
fn checked_value_errors(diags: List<CompilerDiagnostic>, start: int) -> bool {
    let mut i: int = start
    while (< i (list_CompilerDiagnostic_length diags)) {
        if (== (list_CompilerDiagnostic_get diags i).severity DiagnosticSeverity.DIAG_ERROR) { return true }
        set i (+ i 1)
    }
    return false
}
shadow checked_value_errors {
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let location: CompilerSourceLocation = (Diagnostics.diag_location "value.nano" 1 1)
    (Diagnostics.diag_list_add diags (Diagnostics.diag_warning CompilerPhase.PHASE_TYPECHECK "W0002" "I retain this warning." location))
    assert (not (checked_value_errors diags 0))
    (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0001" "I retain this error." location))
    assert (checked_value_errors diags 1)
    assert (not (checked_value_errors diags 2))
}

fn checked_value(value: NSType, ok: bool, holes: bool, terminal: bool) -> CheckedBlock {
    return CheckedBlock { ok: ok, value_type: value, empty_holes: holes, terminates: terminal }
}
shadow checked_value {
    let empty: CheckedBlock = (checked_value (type_array TypeKind.TYPE_UNKNOWN "") true true false)
    let terminal: CheckedBlock = (checked_value (type_void) true false true)
    assert (and empty.empty_holes (not empty.terminates))
    assert (and terminal.terminates (not terminal.empty_holes))
}

fn array_element_fact(parser: Parser, value: NSType) -> NSType {
    if (!= value.kind TypeKind.TYPE_ARRAY) { return (type_unknown_named "array element") }
    return (type_from_string_with_parser parser (array_elem_type_from_array_decl (type_to_string value)))
}
shadow array_element_fact {
    let parser: Parser = (resource_test_parser "struct Item { value: int }")
    assert (== (type_to_string (array_element_fact parser (type_from_string "array<array<Item>>"))) "array<Item>")
    assert (== (array_element_fact parser (type_int)).kind TypeKind.TYPE_UNKNOWN)
}

# My caller has already proved that every unknown leaf is an actual empty hole.
fn merge_literal_types(parser: Parser, left: NSType, right: NSType) -> NSType {
    if (== left.kind TypeKind.TYPE_UNKNOWN) { return right }
    if (== right.kind TypeKind.TYPE_UNKNOWN) { return left }
    if (and (== left.kind TypeKind.TYPE_ARRAY) (== right.kind TypeKind.TYPE_ARRAY)) {
        let a: NSType = (array_element_fact parser left)
        let b: NSType = (array_element_fact parser right)
        let element: NSType = (merge_literal_types parser a b)
        if (and (== element.kind TypeKind.TYPE_UNKNOWN) (not (and (== a.kind TypeKind.TYPE_UNKNOWN) (== b.kind TypeKind.TYPE_UNKNOWN)))) { return (type_unknown_named "incompatible members") }
        return (type_array_of element)
    }
    if (and (== left.kind TypeKind.TYPE_TUPLE) (== right.kind TypeKind.TYPE_TUPLE)) {
        let a: array<string> = (split_tuple_type_names left.name)
        let b: array<string> = (split_tuple_type_names right.name)
        if (!= (array_length a) (array_length b)) { return (type_unknown_named "tuple arity") }
        let mut spelling: string = "("
        let mut i: int = 0
        while (< i (array_length a)) {
            let member: NSType = (merge_literal_types parser (type_from_string_with_parser parser (at a i)) (type_from_string_with_parser parser (at b i)))
            if (== member.kind TypeKind.TYPE_UNKNOWN) { return member }
            if (> i 0) { set spelling (+ spelling ",") }
            set spelling (+ spelling (type_to_string member))
            set i (+ i 1)
        }
        return (type_from_string_with_parser parser (+ spelling ")"))
    }
    if (and (== left.kind TypeKind.TYPE_ENUM) (== right.kind TypeKind.TYPE_ENUM)) {
        if (!= left.name right.name) { return (type_unknown_named "distinct enum members") }
    }
    if (types_equal left right) { return left }
    return (type_unknown_named "incompatible members")
}
shadow merge_literal_types {
    let parser: Parser = (resource_test_parser "struct Left { value: int } struct Right { value: int }")
    assert (== (type_to_string (merge_literal_types parser (type_from_string "array<unknown>") (type_from_string "array<Left>"))) "array<Left>")
    assert (== (merge_literal_types parser (type_from_string "array<Left>") (type_from_string "array<Right>")).kind TypeKind.TYPE_UNKNOWN)
}

fn join_checked_values(parser: Parser, left: CheckedBlock, right: CheckedBlock) -> CheckedBlock {
    if (not (and left.ok right.ok)) { return (checked_value (type_unknown_named "invalid value") false false false) }
    if left.terminates { return right }
    if right.terminates { return left }
    let merged: NSType = (merge_literal_types parser left.value_type right.value_type)
    let valid: bool = (!= merged.kind TypeKind.TYPE_UNKNOWN)
    return (checked_value merged valid (and valid (or left.empty_holes right.empty_holes)) false)
}
shadow join_checked_values {
    let parser: Parser = (resource_test_parser "")
    let value: CheckedBlock = (checked_value (type_int) true false false)
    let terminal: CheckedBlock = (checked_value (type_void) true false true)
    assert (== (join_checked_values parser terminal value).value_type.kind TypeKind.TYPE_INT)
    assert (join_checked_values parser terminal terminal).terminates
    assert (not (join_checked_values parser value (checked_value (type_unknown_named "missing") false false false)).ok)
}

fn check_literal_facts(parser: Parser, node_id: int, symbols: array<Symbol>, diags: List<CompilerDiagnostic>, file_name: string) -> CheckedBlock {
    let literal: ASTArrayLiteral = (parser_get_array_literal parser node_id)
    if (== literal.element_count 0) {
        if (!= literal.element_type "") {
            let declared: NSType = (type_array_of (type_from_string_with_parser parser literal.element_type))
            return (checked_value declared (reduce_type_known parser declared) false false)
        }
        return (checked_value (type_array TypeKind.TYPE_UNKNOWN "") true true false)
    }
    let mut result: CheckedBlock = (checked_value (type_void) true false true)
    let mut i: int = 0
    while (< i literal.element_count) {
        let member: ASTStmtRef = (parser_get_array_element parser (+ literal.element_start i))
        let fact: CheckedBlock = (check_value_facts parser member.node_id member.node_type symbols diags file_name)
        # A terminating member cannot supply an element representation.
        if fact.terminates { set result (checked_value (type_unknown_named "terminal member") false false false) }
        else { set result (join_checked_values parser result fact) }
        set i (+ i 1)
    }
    if (!= literal.element_type "") {
        let expected: NSType = (type_array_of (type_from_string_with_parser parser literal.element_type))
        let before: int = (list_CompilerDiagnostic_length diags)
        let contextual: NSType = (check_contextual_value parser node_id ParseNodeType.PNODE_ARRAY_LITERAL (type_array_of result.value_type) expected symbols diags file_name)
        return (checked_value contextual (and (not (checked_value_errors diags before)) (reduce_type_known parser contextual)) false false)
    }
    if (not result.ok) { return result }
    return (checked_value (type_array_of result.value_type) true result.empty_holes false)
}
shadow check_literal_facts {
    let parser: Parser = (resource_test_parser "fn f() -> void { let a = [[], [1]] let b = [[1], [true]] }")
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let first: ASTLet = (parser_get_let parser 0)
    let second: ASTLet = (parser_get_let parser 1)
    assert (== (type_to_string (check_literal_facts parser first.value [] diags "array.nano").value_type) "array<array<int>>")
    assert (not (check_literal_facts parser second.value [] diags "array.nano").ok)
}

fn check_value_facts(parser: Parser, node_id: int, node_type: int, symbols: array<Symbol>, diags: List<CompilerDiagnostic>, file_name: string) -> CheckedBlock {
    if (== node_type ParseNodeType.PNODE_RETURN) {
        let valid: bool = (check_return_statement parser (parser_get_return parser node_id) (type_from_string_with_parser parser tc_enclosing_return) symbols diags file_name tc_enclosing_function)
        return (checked_value (type_void) valid false true)
    }
    if (or (== node_type ParseNodeType.PNODE_BREAK) (== node_type ParseNodeType.PNODE_CONTINUE)) { return (checked_value (type_void) true false true) }
    if (== node_type ParseNodeType.PNODE_TUPLE_LITERAL) {
        let literal: ASTTupleLiteral = (parser_get_tuple_literal parser node_id)
        let mut spelling: string = "("
        let mut valid: bool = true
        let mut holes: bool = false
        let mut i: int = 0
        while (< i literal.element_count) {
            let fact: CheckedBlock = (check_value_facts parser (at literal.element_ids i) (at literal.element_types i) symbols diags file_name)
            if (or (not fact.ok) fact.terminates) { set valid false }
            if fact.empty_holes { set holes true }
            if (> i 0) { set spelling (+ spelling ",") }
            set spelling (+ spelling (type_to_string fact.value_type))
            set i (+ i 1)
        }
        return (checked_value (type_from_string_with_parser parser (+ spelling ")")) valid holes false)
    }
    if (== node_type ParseNodeType.PNODE_ARRAY_LITERAL) { return (check_literal_facts parser node_id symbols diags file_name) }
    if (== node_type ParseNodeType.PNODE_IF) { return (check_if_value parser node_id symbols (type_unknown_named "inference") diags file_name) }
    if (== node_type ParseNodeType.PNODE_MATCH) { return (check_match_value parser node_id symbols (type_unknown_named "inference") diags file_name) }
    if (== node_type ParseNodeType.PNODE_BLOCK) {
        return (check_block_value parser node_id symbols (type_from_string_with_parser parser tc_enclosing_return) diags file_name tc_enclosing_function)
    }
    let actual: NSType = (check_expr_node parser node_id node_type symbols diags file_name)
    return (checked_value actual (reduce_type_known parser actual) false false)
}
shadow check_value_facts {
    let parser: Parser = (resource_test_parser "fn f() -> void { let a = unknown_array }")
    let value: ASTLet = (parser_get_let parser 0)
    let symbols: array<Symbol> = [(symbol_new "unknown_array" (type_array TypeKind.TYPE_UNKNOWN "") false false 0 (empty_param_types) (type_void))]
    assert (not (check_value_facts parser value.value value.value_type symbols (list_CompilerDiagnostic_new) "array.nano").ok)
}

fn check_if_value(parser: Parser, node_id: int, symbols: array<Symbol>, expected: NSType, diags: List<CompilerDiagnostic>, file_name: string) -> CheckedBlock {
    let branch: ASTIf = (parser_get_if parser node_id)
    let condition: NSType = (check_expr_node parser branch.condition branch.condition_type symbols diags file_name)
    let valid: bool = (== condition.kind TypeKind.TYPE_BOOL)
    if (not valid) { (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0001" "I require a bool condition." (Diagnostics.diag_location file_name branch.line branch.column))) }
    let enclosing: NSType = (type_from_string_with_parser parser tc_enclosing_return)
    let mut left: CheckedBlock = (checked_value (type_void) true false false)
    let mut right: CheckedBlock = left
    if (>= branch.then_body 0) {
        set left (check_statement_values parser (parser_get_block parser branch.then_body).statements symbols enclosing expected true diags file_name tc_enclosing_function)
    }
    if (>= branch.else_body 0) {
        set right (check_statement_values parser (parser_get_block parser branch.else_body).statements symbols enclosing expected true diags file_name tc_enclosing_function)
    }
    let joined: CheckedBlock = (join_checked_values parser left right)
    return (checked_value joined.value_type (and valid joined.ok) joined.empty_holes joined.terminates)
}
