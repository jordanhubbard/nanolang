fn array_intrinsic_name(name: string) -> bool {
    return (or (== name "array_new") (or (== name "array_push") (or (== name "array_set") (or (== name "array_slice") (or (== name "at") (or (== name "array_get") (or (== name "map") (or (== name "array_map") (== name "filter")))))))))
}
shadow array_intrinsic_name {
    assert (array_intrinsic_name "array_set")
    assert (not (array_intrinsic_name "foreign.array_set"))
}

fn check_array_operation(parser: Parser, call: ASTCall, name: string, symbols: array<Symbol>, diags: List<CompilerDiagnostic>, file_name: string) -> NSType {
    let location: CompilerSourceLocation = (Diagnostics.diag_location file_name call.line call.column)
    let push: bool = (== name "array_push")
    let write: bool = (== name "array_set")
    let slice: bool = (== name "array_slice")
    let count: int = (cond ((or write slice) 3) (else 2))
    if (!= call.arg_count count) {
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0010" "I require the declared array intrinsic arity." location))
        return (type_unknown_named "array arity")
    }
    let source: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
    let source_fact: CheckedBlock = (check_value_facts parser source.node_id source.node_type symbols diags file_name)
    let mut receiver: NSType = source_fact.value_type
    let mut valid: bool = (and source_fact.ok (and (not source_fact.terminates) (== receiver.kind TypeKind.TYPE_ARRAY)))
    if push {
        # Only genuine empty syntax may receive its element facts from the value.
        if (and valid (and source_fact.empty_holes (not (reduce_type_known parser receiver)))) {
            let value: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
            let element: NSType = (check_expr_node parser value.node_id value.node_type symbols diags file_name)
            if (reduce_type_known parser element) {
                set receiver (check_contextual_value parser source.node_id source.node_type receiver (type_array_of element) symbols diags file_name)
            }
        }
    }
    if (not (reduce_type_known parser receiver)) { set valid false }
    if (not push) {
        let index: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
        let index_type: NSType = (check_expr_node parser index.node_id index.node_type symbols diags file_name)
        if (not (or (== index_type.kind TypeKind.TYPE_INT) (== (type_to_string index_type) "u8"))) { set valid false }
    }
    if slice {
        let end: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 2))
        let end_type: NSType = (check_expr_node parser end.node_id end.node_type symbols diags file_name)
        if (not (or (== end_type.kind TypeKind.TYPE_INT) (== (type_to_string end_type) "u8"))) { set valid false }
    }
    if (and valid (or push write)) {
        let offset: int = (cond (push 1) (else 2))
        let value: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start offset))
        let raw: NSType = (check_expr_node parser value.node_id value.node_type symbols diags file_name)
        let expected: NSType = (array_element_fact parser receiver)
        let before: int = (list_CompilerDiagnostic_length diags)
        let checked: NSType = (check_constructor_argument parser value.node_id value.node_type raw expected symbols diags file_name)
        if (not (and (not (checked_value_errors diags before)) (and (reduce_type_known parser checked) (types_equal checked expected)))) { set valid false }
    }
    if (not valid) {
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0010" "I require a complete array receiver, integer indices and its exact element destination." location))
        return (type_unknown_named "array operands")
    }
    if write { return (type_void) }
    if (or push slice) { return receiver }
    return (array_element_fact parser receiver)
}
shadow check_array_operation {
    let parser: Parser = (resource_test_parser "struct Item { value: int } fn f() -> void { (array_push values true) (array_set values 0 1) let nested = (at nested_values 0) }")
    let symbols: array<Symbol> = [(symbol_new "values" (type_from_string "array<int>") true false 0 (empty_param_types) (type_void)), (symbol_new "nested_values" (type_from_string "array<array<Item>>") false false 0 (empty_param_types) (type_void))]
    let bad: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    assert (== (check_array_operation parser (parser_get_call parser 0) "array_push" symbols bad "array.nano").kind TypeKind.TYPE_UNKNOWN)
    assert (> (list_CompilerDiagnostic_length bad) 0)
    let good: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    assert (== (check_array_operation parser (parser_get_call parser 1) "array_set" symbols good "array.nano").kind TypeKind.TYPE_VOID)
    assert (== (type_to_string (check_array_operation parser (parser_get_call parser 2) "at" symbols good "array.nano")) "array<Item>")
    assert (== (list_CompilerDiagnostic_length good) 0)
}

fn check_expr_node(parser: Parser, node_id: int, node_type: int, symbols: array<Symbol>, diags: List<CompilerDiagnostic>, file_name: string) -> NSType {
    if (== node_type ParseNodeType.PNODE_BLOCK) {
        let expected: NSType = (type_from_string_with_parser parser tc_enclosing_return)
        let checked: CheckedBlock = (check_block_value parser node_id symbols expected diags file_name tc_enclosing_function)
        return checked.value_type
    }
    if (== node_type ParseNodeType.PNODE_NUMBER) { return (type_int) } else { (print "") }
    if (== node_type ParseNodeType.PNODE_STRING) { return (type_string) } else { (print "") }
    if (== node_type ParseNodeType.PNODE_BOOL) { return (type_bool) } else { (print "") }
    if (== node_type ParseNodeType.PNODE_FLOAT) { return (type_float) } else { (print "") }
    if (== node_type ParseNodeType.PNODE_IDENTIFIER) {
        let id_node: ASTIdentifier = (parser_get_identifier parser node_id)
        let lookup: OptionType = (env_get_type symbols (tc_bound_name id_node.name id_node.line symbols))
        if lookup.has_value { return lookup.value }
        let builtin: NSType = (check_builtin_function id_node.name)
        let named_type: bool = (or (is_enum_name parser id_node.name) (is_union_name parser id_node.name))
        if (and (not named_type) (== builtin.kind TypeKind.TYPE_UNKNOWN)) {
            (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0011" (+ "I cannot find this name in the current scope: " id_node.name) (Diagnostics.diag_location file_name id_node.line id_node.column)))
        }
        return (type_unknown_named id_node.name)
    } else { (print "") }
    if (== node_type ParseNodeType.PNODE_BINARY_OP) {
        let binop: ASTBinaryOp = (parser_get_binary_op parser node_id)
        let left_t: NSType = (check_expr_node parser binop.left binop.left_type symbols diags file_name)
        let right_t: NSType = (check_expr_node parser binop.right binop.right_type symbols diags file_name)
        let op_str: string = (op_token_to_string binop.op)
        let result: NSType = (check_binary_op op_str left_t right_t)
        if (and (array_arithmetic_selected op_str left_t right_t) (== result.kind TypeKind.TYPE_UNKNOWN)) {
            (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0011" "I require matching flat numeric array and scalar element types for arithmetic." (Diagnostics.diag_location file_name binop.line binop.column)))
        }
        return result
    } else { (print "") }
    if (== node_type ParseNodeType.PNODE_CALL) {
        let call_node: ASTCall = (parser_get_call parser node_id)
        if (> call_node.borrow_mode 0) {
            if (and (or (== call_node.borrow_mode 1) (== call_node.borrow_mode 2)) (== call_node.arg_count 1)) {
                let place: ASTStmtRef = (parser_get_call_arg parser call_node.arg_start)
                let root: string = (resource_place_root parser place.node_id place.node_type)
                if (!= root "") {
                    let referent: NSType = (check_expr_node parser place.node_id place.node_type symbols diags file_name)
                    let mut prefix: string = "&"
                    let mut mutable: bool = true
                    if (== call_node.borrow_mode 2) {
                        set prefix "&mut "
                        let index: int = (env_lookup symbols root)
                        set mutable false
                        if (>= index 0) { let owner: Symbol = (at symbols index) set mutable owner.is_mutable }
                    }
                    let annotation: string = (+ prefix referent.name)
                    if (and mutable (scalar_borrow_shape parser annotation)) { return (type_from_string annotation) }
                }
            }
            (resource_flow_error diags file_name call_node.line call_node.column "I require an explicit borrow of a supported owner with matching mutability")
            return (type_unknown_named "invalid borrow")
        }
        if (!= call_node.function_type ParseNodeType.PNODE_IDENTIFIER) {
            let callee_type: NSType = (check_expr_node parser call_node.function call_node.function_type symbols diags file_name)
            if (!= callee_type.kind TypeKind.TYPE_FUNCTION) {
                let msg: string = (+ "I cannot call an expression of type `" (+ (type_to_string callee_type) "`."))
                let diag: CompilerDiagnostic = (Diagnostics.diag_typecheck_error "E0010" msg (Diagnostics.diag_location file_name call_node.line call_node.column))
                (Diagnostics.diag_list_add diags diag)
                return (type_unknown_named "call")
            } else { (print "") }
            let param_types: array<NSType> = (fn_type_params_with_parser parser callee_type.name)
            let param_count: int = (array_length param_types)
            if (!= call_node.arg_count param_count) {
                let msg: string = (+ "The function expression expects " (+ (int_to_string param_count) (+ " argument(s), but I see " (+ (int_to_string call_node.arg_count) "."))))
                let diag: CompilerDiagnostic = (Diagnostics.diag_typecheck_error "E0010" msg (Diagnostics.diag_location file_name call_node.line call_node.column))
                (Diagnostics.diag_list_add diags diag)
            } else { (print "") }
            let mut j: int = 0
            while (< j call_node.arg_count) {
                let arg_ref: ASTStmtRef = (parser_get_call_arg parser (+ call_node.arg_start j))
                let arg_raw: NSType = (check_expr_node parser arg_ref.node_id arg_ref.node_type symbols diags file_name)
                if (< j param_count) {
                    let param_type: NSType = (at param_types j)
                    let arg_type: NSType = (check_constructor_argument parser arg_ref.node_id arg_ref.node_type arg_raw param_type symbols diags file_name)
                    if (not (types_equal arg_type param_type)) {
                        let msg: string = (+ "Argument " (+ (int_to_string (+ j 1)) (+ " to the function expression: expected " (+ (type_to_string param_type) (+ ", got " (type_to_string arg_type))))))
                        let diag: CompilerDiagnostic = (Diagnostics.diag_typecheck_error "E0010" msg (Diagnostics.diag_location file_name call_node.line call_node.column))
                        (Diagnostics.diag_list_add diags diag)
                    } else { (print "") }
                } else { (print "") }
                set j (+ j 1)
            }
            return (type_from_string_with_parser parser (type_to_string (fn_type_return_type callee_type.name)))
        } else { (print "") }
        let mut i: int = 0
        while (< i call_node.arg_count) {
            let arg_ref: ASTStmtRef = (parser_get_call_arg parser (+ call_node.arg_start i))
            let _arg_t: NSType = (check_expr_node parser arg_ref.node_id arg_ref.node_type symbols diags file_name)
            set i (+ i 1)
        }
        /* Get function name from identifier node */
        let fn_id_node: ASTIdentifier = (parser_get_identifier parser call_node.function)
        let fn_name: string = (tc_bound_name fn_id_node.name fn_id_node.line symbols)
        if (and (== fn_name "array_new") (< (env_lookup symbols fn_name) 0)) {
            return (check_array_new_call parser call_node symbols diags file_name)
        }
        if (and (== fn_name "map_get") (and (== call_node.arg_count 2) (< (env_lookup symbols fn_name) 0))) {
            let receiver: ASTStmtRef = (parser_get_call_arg parser call_node.arg_start)
            let receiver_type: NSType = (check_expr_node parser receiver.node_id receiver.node_type symbols diags file_name)
            if (and (== receiver_type.kind TypeKind.TYPE_STRUCT) (== (base_type_name receiver_type.name) "HashMap")) {
                let arguments: array<string> = (tc_generic_arguments receiver_type.name)
                if (== (array_length arguments) 2) {
                    let key: ASTStmtRef = (parser_get_call_arg parser (+ call_node.arg_start 1))
                    let key_type: NSType = (check_expr_node parser key.node_id key.node_type symbols diags file_name)
                    let expected_key: NSType = (type_from_string_with_parser parser (at arguments 0))
                    if (not (types_equal key_type expected_key)) {
                        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0010" "I require the declared map key type." (Diagnostics.diag_location file_name call_node.line call_node.column)))
                    }
                    return (type_from_string_with_parser parser (at arguments 1))
                }
            }
        }
        if (and (or (== fn_name "reduce") (== fn_name "array_fold")) (< (env_lookup symbols fn_name) 0)) {
            return (check_reduce_call parser call_node symbols diags file_name)
        }
        if (and (or (== fn_name "map") (or (== fn_name "array_map") (== fn_name "filter"))) (< (env_lookup symbols fn_name) 0)) {
            return (check_map_call parser call_node symbols diags file_name)
        }
        if (and (array_intrinsic_name fn_name) (< (env_lookup symbols fn_name) 0)) {
            return (check_array_operation parser call_node fn_name symbols diags file_name)
        }
        if (or (== fn_name "sb_new") (or (== fn_name "sb_with_capacity") (or (== fn_name "sb_append") (or (== fn_name "sb_append_line") (or (== fn_name "sb_append_int") (or (== fn_name "sb_append_char") (or (== fn_name "sb_clear") (or (== fn_name "sb_free") (or (== fn_name "sb_is_empty") (or (== fn_name "sb_length") (or (== fn_name "sb_capacity") (== fn_name "sb_to_string")))))))))))) {
            if (or (== fn_name "sb_to_string") (or (== fn_name "sb_length") (== fn_name "sb_capacity"))) {
                if (or (== fn_name "sb_length") (== fn_name "sb_capacity")) {
                    return (type_int)
                } else {
                    return (type_string)
                }
            } else {
                if (or (== fn_name "sb_free") (== fn_name "sb_is_empty")) {
                    if (== fn_name "sb_is_empty") { return (type_bool) } else { return (type_void) }
                } else {
                    return (type_from_string "StringBuilder")
                }
            }
        } else { (print "") }
        /* Check if it's a builtin function/operator */
        if (and (or (== fn_name "float_from_bits") (== fn_name "float_to_bits")) (>= (env_lookup symbols fn_name) 0)) {
            (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0010" "I cannot use a bound value as a binary64 bit intrinsic." (Diagnostics.diag_location file_name call_node.line call_node.column)))
            return (type_unknown_named fn_name)
        }
        if (and (or (== fn_name "float_from_bits") (== fn_name "float_to_bits")) (< (env_lookup symbols fn_name) 0)) {
            let mut valid_bits: bool = (== call_node.arg_count 1)
            if valid_bits {
                let bits_arg: ASTStmtRef = (parser_get_call_arg parser call_node.arg_start)
                let bits_type: NSType = (check_expr_node parser bits_arg.node_id bits_arg.node_type symbols diags file_name)
                if (== fn_name "float_from_bits") { set valid_bits (== bits_type.kind TypeKind.TYPE_INT) }
                else { set valid_bits (== bits_type.kind TypeKind.TYPE_FLOAT) }
            }
            if (not valid_bits) {
                (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0010" "I require one exactly typed operand for binary64 bit transport." (Diagnostics.diag_location file_name call_node.line call_node.column)))
            }
            return (check_builtin_function fn_name)
        }
        let mut builtin_type: NSType = (check_builtin_function fn_name)
        if (and (or (== fn_name "string_to_float") (or (== fn_name "float_from_bits") (== fn_name "float_to_bits"))) (>= (env_lookup symbols fn_name) 0)) {
            set builtin_type (type_unknown_named fn_name)
        }
        # I keep bound mutation names on the ordinary symbol-checking path.
        if (and (array_intrinsic_name fn_name) (>= (env_lookup symbols fn_name) 0)) {
            set builtin_type (type_unknown_named fn_name)
        }
        if (!= builtin_type.kind TypeKind.TYPE_UNKNOWN) {
            return builtin_type
        } else {
            /* Check if it's a List<T> function (only for functions starting with "list_") */
            if (tc_str_starts_with fn_name "list_") {
                let list_type: NSType = (check_list_function_call fn_name)
                if (!= list_type.kind TypeKind.TYPE_UNKNOWN) {
                    return list_type
                } else { (print "") }
            } else { (print "") }

            /* Check if it's a user-defined function */
            let idx: int = (env_lookup symbols fn_name)
            if (>= idx 0) {
                let sym: Symbol = (at symbols idx)
                if sym.is_function {
                    if (!= call_node.arg_count sym.param_count) {
                        let msg: string = (+ "The function `" (+ fn_name (+ "` expects " (+ (int_to_string sym.param_count) (+ " argument(s), but I see " (+ (int_to_string call_node.arg_count) "."))))))
                        let diag: CompilerDiagnostic = (Diagnostics.diag_typecheck_error "E0010" msg (Diagnostics.diag_location file_name call_node.line call_node.column))
                        (Diagnostics.diag_list_add diags diag)
                    } else { (print "") }
                    /* Validate argument types against parameter types */
                    let mut j: int = 0
                    while (< j call_node.arg_count) {
                        if (< j sym.param_count) {
                            let arg_ref2: ASTStmtRef = (parser_get_call_arg parser (+ call_node.arg_start j))
                            let param_t: NSType = (at sym.param_types j)
                            let arg_raw2: NSType = (check_expr_node parser arg_ref2.node_id arg_ref2.node_type symbols diags file_name)
                            let arg_hint2: NSType = (check_contextual_value parser arg_ref2.node_id arg_ref2.node_type arg_raw2 param_t symbols diags file_name)
                            let arg_t2: NSType = (check_constructor_argument parser arg_ref2.node_id arg_ref2.node_type arg_hint2 param_t symbols diags file_name)
                            let opaque_param: bool = (tc_is_opaque_name parser param_t.name)
                            let mut opaque_null: bool = false
                            if (and opaque_param (== arg_ref2.node_type ParseNodeType.PNODE_NUMBER)) {
                                let number_arg: ASTNumber = (parser_get_number parser arg_ref2.node_id)
                                if (== number_arg.value "0") { set opaque_null true } else { (print "") }
                            } else { (print "") }
                            if (and (not opaque_null) (not (types_equal arg_t2 param_t))) {
                                let msg: string = (+ "Argument " (+ (int_to_string (+ j 1)) (+ " to '" (+ fn_name (+ "': expected " (+ (type_to_string param_t) (+ ", got " (type_to_string arg_t2))))))))
                                let diag: CompilerDiagnostic = (Diagnostics.diag_typecheck_error "E0010" msg (Diagnostics.diag_location file_name call_node.line call_node.column))
                                (Diagnostics.diag_list_add diags diag)
                            } else { (print "") }
                        } else { (print "") }
                        set j (+ j 1)
                    }
                    return sym.return_type
                } else {
                    /* Variable being called - if it's a function type, extract return type */
                    if (== sym.sym_type.kind TypeKind.TYPE_FUNCTION) {
                        let params: array<NSType> = (fn_type_params_with_parser parser sym.sym_type.name)
                        if (!= call_node.arg_count (array_length params)) {
                            let msg: string = (+ "The function value `" (+ fn_name (+ "` expects " (+ (int_to_string (array_length params)) (+ " argument(s), but I see " (+ (int_to_string call_node.arg_count) "."))))))
                            let diag: CompilerDiagnostic = (Diagnostics.diag_typecheck_error "E0010" msg (Diagnostics.diag_location file_name call_node.line call_node.column))
                            (Diagnostics.diag_list_add diags diag)
                        } else { (print "") }
                        let mut argument_index: int = 0
                        while (< argument_index call_node.arg_count) {
                            if (< argument_index (array_length params)) {
                                let argument: ASTStmtRef = (parser_get_call_arg parser (+ call_node.arg_start argument_index))
                                let expected: NSType = (at params argument_index)
                                let raw: NSType = (check_expr_node parser argument.node_id argument.node_type symbols diags file_name)
                                let hinted: NSType = (check_contextual_value parser argument.node_id argument.node_type raw expected symbols diags file_name)
                                let actual: NSType = (check_constructor_argument parser argument.node_id argument.node_type hinted expected symbols diags file_name)
                                if (not (types_equal actual expected)) {
                                    let message: string = (+ "I require the declared callback argument type: expected " (+ (type_to_string expected) (+ ", got " (type_to_string actual))))
                                    (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0010" message (Diagnostics.diag_location file_name call_node.line call_node.column)))
                                }
                            }
                            set argument_index (+ argument_index 1)
                        }
                        return (type_from_string_with_parser parser (type_to_string (fn_type_return_type sym.sym_type.name)))
                    } else {
                        return sym.sym_type
                    }
                }
            } else {
                return (type_unknown_named fn_name)
            }
        }
    } else { (print "") }
    if (== node_type ParseNodeType.PNODE_MODULE_QUALIFIED_CALL) {
        let mqc_node: ASTModuleQualifiedCall = (parser_get_module_qualified_call parser node_id)
        /* Use function_name which contains full qualified name (Module.function) */
        let qualified_name: string = (mb_lookup (mb_owner mqc_node.line) mqc_node.function_name)
        let mut arg_index: int = 0
        while (< arg_index mqc_node.arg_count) {
            let arg: ASTStmtRef = (parser_get_call_arg parser (+ mqc_node.arg_start arg_index))
            (check_expr_node parser arg.node_id arg.node_type symbols diags file_name)
            set arg_index (+ arg_index 1)
        }
        let short_name: string = (module_qualified_suffix qualified_name)
        /* Allow builtin/mapped helpers for module-qualified calls (e.g., Diagnostics.*) */
        let mut builtin_type: NSType = (check_builtin_function short_name)
        if (and (== short_name "string_to_float") (>= (env_lookup symbols qualified_name) 0)) {
            set builtin_type (type_unknown_named qualified_name)
        }
        if (array_intrinsic_name short_name) {
            set builtin_type (type_unknown_named qualified_name)
        }
        if (!= builtin_type.kind TypeKind.TYPE_UNKNOWN) {
            return builtin_type
        } else { (print "") }
        # I retain the mapped helper fallback, then check callback contracts.
        let mut idx: int = (env_lookup symbols qualified_name)
        if (and (< idx 0) (not (array_intrinsic_name short_name))) { set idx (env_lookup symbols (module_qualified_suffix qualified_name)) }
        if (>= idx 0) {
            let sym: Symbol = (at symbols idx)
            if (or sym.is_function (== sym.sym_type.kind TypeKind.TYPE_FUNCTION)) {
                let mut parameters: array<NSType> = sym.param_types
                let mut result: NSType = sym.return_type
                if (not sym.is_function) {
                    set parameters (fn_type_params_with_parser parser sym.sym_type.name)
                    set result (type_from_string_with_parser parser (type_to_string (fn_type_return_type sym.sym_type.name)))
                }
                if (!= mqc_node.arg_count (array_length parameters)) {
                    (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0010" "I require the declared qualified call arity." (Diagnostics.diag_location file_name mqc_node.line mqc_node.column)))
                }
                let mut j: int = 0
                while (< j mqc_node.arg_count) {
                    if (< j (array_length parameters)) {
                        let expected: NSType = (at parameters j)
                        let argument: ASTStmtRef = (parser_get_call_arg parser (+ mqc_node.arg_start j))
                        let raw: NSType = (check_expr_node parser argument.node_id argument.node_type symbols diags file_name)
                        let actual: NSType = (check_constructor_argument parser argument.node_id argument.node_type raw expected symbols diags file_name)
                        if (not (types_equal actual expected)) {
                            let message: string = (+ "I require the declared qualified argument type: expected " (+ (type_to_string expected) (+ ", got " (type_to_string actual))))
                            (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0010" message (Diagnostics.diag_location file_name mqc_node.line mqc_node.column)))
                        }
                    }
                    set j (+ j 1)
                }
                return result
            } else {
                return sym.sym_type
            }
        } else {
            return (type_unknown_named qualified_name)
        }
    } else { (print "") }
    if (== node_type ParseNodeType.PNODE_FIELD_ACCESS) {
        let fa: ASTFieldAccess = (parser_get_field_access parser node_id)
        if (== fa.object_type ParseNodeType.PNODE_IDENTIFIER) {
            let receiver: ASTIdentifier = (parser_get_identifier parser fa.object)
            if (< (env_lookup symbols (tc_bound_name receiver.name receiver.line symbols)) 0) {
                let mut enum_index: int = 0
                while (< enum_index (parser_get_enum_count parser)) {
                    let definition: ASTEnum = (parser_get_enum parser enum_index)
                    if (== definition.name receiver.name) {
                        if (resource_name_in definition.variant_names fa.field_name) {
                            return (type_from_string_with_parser parser definition.name)
                        }
                        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0011" "I cannot find this member in the declared enum." (Diagnostics.diag_location file_name fa.line fa.column)))
                        return (type_unknown_named "enum member")
                    }
                    set enum_index (+ enum_index 1)
                }
            }
        }
        let obj_t: NSType = (check_expr_node parser fa.object fa.object_type symbols diags file_name)
        if (== obj_t.kind TypeKind.TYPE_STRUCT) {
            let metadata: array<FieldMetadata> = (merge_struct_metadata parser)
            let field_t: NSType = (lookup_field_type metadata obj_t.name fa.field_name)
            if (== field_t.kind TypeKind.TYPE_UNKNOWN) {
                return (check_variant_field_type parser obj_t.name fa.field_name obj_t.element_type_name)
            }
            return (type_from_string_with_parser parser (type_to_string field_t))
        } else {
            if (== obj_t.kind TypeKind.TYPE_UNION) {
                let metadata: array<FieldMetadata> = (merge_struct_metadata parser)
                let variant_t: NSType = (lookup_field_type metadata obj_t.name fa.field_name)
                return variant_t
            } else {
                return (type_unknown_named "field_access")
            }
        }
    } else { (print "") }
    if (== node_type ParseNodeType.PNODE_ARRAY_LITERAL) {
        let fact: CheckedBlock = (check_literal_facts parser node_id symbols diags file_name)
        return fact.value_type
    }
    if (== node_type ParseNodeType.PNODE_STRUCT_LITERAL) {
        return (check_struct_literal parser node_id symbols diags file_name)
    } else { (print "") }
    if (== node_type ParseNodeType.PNODE_UNION_CONSTRUCT) { return (check_union_construct parser node_id) } else { (print "") }
    if (== node_type ParseNodeType.PNODE_MATCH) { return (check_match_expr parser node_id symbols diags file_name) } else { (print "") }
    if (== node_type ParseNodeType.PNODE_IF) {
        return (check_if_value parser node_id symbols (type_unknown_named "inference") diags file_name).value_type
    }
    if (== node_type ParseNodeType.PNODE_FIELD_ACCESS) {
        /* Field access: use heuristics for common field types (bootstrap leniency) */
        let field_node: ASTFieldAccess = (parser_get_field_access parser node_id)
        let fname: string = field_node.field_name
        /* Heuristic type inference based on field name patterns */
        /* Special case: fields that ARE NSType (not just related to types) */
        if (or (== fname "return_type") (== fname "sym_type")) {
            /* These fields in Symbol are NSType themselves */
            return NSType {
                kind: TypeKind.TYPE_STRUCT,
                name: "NSType",
                element_type_kind: TypeKind.TYPE_UNKNOWN,
                element_type_name: ""
            }
        } else { (print "") }
        /* Special case: string fields that contain type names (not int type IDs) */
        if (or (== fname "element_type") (or (== fname "var_type") (== fname "expected_type"))) {
            return (type_string)
        } else { (print "") }
        if (or (tc_str_ends_with fname "_count") (or (tc_str_ends_with fname "_id") (or (tc_str_ends_with fname "_type") (or (== fname "line") (or (== fname "column") (or (== fname "position") (== fname "length"))))))) {
            return (type_int)
        } else { (print "") }
        if (or (tc_str_ends_with fname "_name") (or (== fname "name") (== fname "message"))) {
            return (type_string)
        } else { (print "") }
        if (or (tc_str_ends_with fname "is_mut") (or (tc_str_ends_with fname "is_function") (or (tc_str_ends_with fname "has_value") (or (tc_str_ends_with fname "has_error") (or (tc_str_ends_with fname "had_error") (or (== fname "defined") (or (== fname "ok") (== fname "show_help")))))))) {
            return (type_bool)
        } else { (print "") }
        /* For other fields, try to infer from object type */
        let obj_type: NSType = (check_expr_node parser field_node.object field_node.object_type symbols diags file_name)
        /* Special case: value field on ASTBool is bool */
        if (and (== fname "value") (== obj_type.name "ASTBool")) {
            return (type_bool)
        } else { (print "") }
        /* Return unknown with field name for better error messages */
        return (type_unknown_named fname)
    } else { (print "") }
    if (== node_type ParseNodeType.PNODE_TUPLE_LITERAL) {
        /* Tuple literal: compute concrete tuple type from element types */
        let tl: ASTTupleLiteral = (parser_get_tuple_literal parser node_id)
        let tuple_name: string = (tuple_type_string_from_literal parser tl symbols diags file_name)
        return NSType {
            kind: TypeKind.TYPE_TUPLE,
            name: tuple_name,
            element_type_kind: TypeKind.TYPE_UNKNOWN,
            element_type_name: ""
        }
    } else { (print "") }
    if (== node_type ParseNodeType.PNODE_TUPLE_INDEX) {
        /* Tuple index: look up element type from the tuple's type */
        let ti: ASTTupleIndex = (parser_get_tuple_index parser node_id)
        let tuple_type: NSType = (check_expr_node parser ti.tuple ti.tuple_type symbols diags file_name)
        if (and (== tuple_type.kind TypeKind.TYPE_TUPLE) (!= tuple_type.name "")) {
            let elem_names: array<string> = (split_tuple_type_names tuple_type.name)
            if (< ti.index (array_length elem_names)) {
                let elem_str: string = (strip_spaces (at elem_names ti.index))
                return (type_from_string elem_str)
            } else {
                return (type_int)
            }
        } else {
            return (type_int)
        }
    } else { (print "") }
    if (== node_type ParseNodeType.PNODE_UNSAFE_BLOCK) {
        /* Unsafe block: assume returns int */
        return (type_int)
    } else { (print "") }
    return (type_unknown_named "expr")
}

shadow check_expr_node {
    let source: string = "fn message(var_name: string) -> string { return (+ \"Error: \" (+ var_name \"not found\")) }"
    let tokens: List<LexerToken> = (tokenize_string source "test.nano" (list_CompilerDiagnostic_new))
    let parsed: Parser = (parse_program tokens (list_LexerToken_length tokens) "test.nano")
    assert (not (parser_has_error parsed))
    let function: ASTFunction = (parser_get_function parsed 0)
    let body: ASTBlock = (parser_get_block parsed function.body)
    let statement: ASTStmtRef = (list_ASTStmtRef_get body.statements 0)
    let ret: ASTReturn = (parser_get_return parsed statement.node_id)
    let mut symbols: array<Symbol> = []
    let sym: Symbol = (symbol_new "var_name" (type_string) false false 0 (empty_param_types) (type_void))
    set symbols (env_add_symbol symbols sym)
    let diags: List<CompilerDiagnostic> = (Diagnostics.diag_list_new)
    let result: NSType = (check_expr_node parsed ret.value ret.value_type symbols diags "test.nano")
    assert (== result.kind TypeKind.TYPE_STRING)
    assert (== (list_CompilerDiagnostic_length diags) 0)
    let record_parser: Parser = (resource_test_parser "union Box<T> { Some { value: T }, None {} } struct Outer { boxed: Box<int> } fn main() -> int { let boxed: Box<int> = outer.boxed return 0 }")
    let record_symbols: array<Symbol> = [(symbol_new "outer" (type_from_string_with_parser record_parser "Outer") false false 0 (empty_param_types) (type_void))]
    let record_diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let field: NSType = (check_expr_node record_parser 0 ParseNodeType.PNODE_FIELD_ACCESS record_symbols record_diags "record.nano")
    assert (== field.kind TypeKind.TYPE_UNION)
    assert (== (type_to_string field) "Box<int>")
    let enumerated: Parser = (resource_test_parser "enum Mode { Low = -3, High = 7 } struct Box { Low: string } fn main() -> int { let value = Mode.Low return 0 }")
    let enum_diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let member: NSType = (check_expr_node enumerated 0 ParseNodeType.PNODE_FIELD_ACCESS [] enum_diags "enum.nano")
    assert (== member.kind TypeKind.TYPE_ENUM)
    assert (== member.name "Mode")
    let shadowed_symbols: array<Symbol> = [(symbol_new "Mode" (type_from_string "Box") false false 0 (empty_param_types) (type_void))]
    let shadowed_member: NSType = (check_expr_node enumerated 0 ParseNodeType.PNODE_FIELD_ACCESS shadowed_symbols enum_diags "enum.nano")
    assert (== shadowed_member.kind TypeKind.TYPE_STRING)
    assert (== (list_CompilerDiagnostic_length enum_diags) 0)

    # I distinguish unbound mutation results from declared and lexical callables.
    (mb_reset [])
    let mutation_names: array<string> = ["array_push", "array_set"]
    let float_array: NSType = (type_array_of (type_float))
    let values: Symbol = (symbol_new "values" float_array false false 0 (empty_param_types) (type_void))
    let mut mutation_index: int = 0
    while (< mutation_index 2) {
        let name: string = (at mutation_names mutation_index)
        let mut arguments: string = " values 1.5"
        let mut parameters: array<NSType> = [float_array, (type_float)]
        let mut callback_name: string = "fn(array<float>,float)->bool"
        if (== mutation_index 1) {
            set arguments " values 0 1.5"
            set parameters [float_array, (type_int), (type_float)]
            set callback_name "fn(array<float>,int,float)->bool"
        }
        let mutation_parser: Parser = (resource_test_parser (+ "fn main() -> int { return (" (+ name (+ arguments ") }"))))
        assert (not (parser_has_error mutation_parser))
        let mutation_diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
        let unbound: NSType = (check_expr_node mutation_parser 0 ParseNodeType.PNODE_CALL [values] mutation_diags "mutation.nano")
        if (== mutation_index 0) { assert (== (type_to_string unbound) "array<float>") }
        else { assert (== unbound.kind TypeKind.TYPE_VOID) }
        let declaration: Symbol = (symbol_new name (type_int) false true (array_length parameters) parameters (type_int))
        let declared: array<Symbol> = [values, declaration]
        assert (== (check_expr_node mutation_parser 0 ParseNodeType.PNODE_CALL declared mutation_diags "mutation.nano").kind TypeKind.TYPE_INT)
        let callback: Symbol = (symbol_new name (type_from_string callback_name) false false 0 (empty_param_types) (type_void))
        let lexical: array<Symbol> = [values, declaration, callback]
        assert (== (check_expr_node mutation_parser 0 ParseNodeType.PNODE_CALL lexical mutation_diags "mutation.nano").kind TypeKind.TYPE_BOOL)
        assert (== (check_expr_node mutation_parser 0 ParseNodeType.PNODE_CALL declared mutation_diags "mutation.nano").kind TypeKind.TYPE_INT)
        assert (== (list_CompilerDiagnostic_length mutation_diags) 0)
        let wrong: Symbol = (symbol_new name (type_int) false true 0 (empty_param_types) (type_int))
        let wrong_diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
        let _: NSType = (check_expr_node mutation_parser 0 ParseNodeType.PNODE_CALL [values, wrong] wrong_diags "mutation.nano")
        assert (> (list_CompilerDiagnostic_length wrong_diags) 0)
        let qualified_name: string = (+ "Tools." name)
        let qualified_parser: Parser = (resource_test_parser (+ "fn main() -> int { return (" (+ qualified_name (+ arguments ") }"))))
        assert (not (parser_has_error qualified_parser))
        let qualified_function: ASTFunction = (parser_get_function qualified_parser 0)
        let qualified_statement: ASTStmtRef = (list_ASTStmtRef_get (parser_get_block qualified_parser qualified_function.body).statements 0)
        let qualified_return: ASTReturn = (parser_get_return qualified_parser qualified_statement.node_id)
        let qualified_symbol: Symbol = (symbol_new qualified_name (type_int) false true (array_length parameters) parameters (type_int))
        assert (== (check_expr_node qualified_parser qualified_return.value qualified_return.value_type [values, qualified_symbol] mutation_diags "mutation.nano").kind TypeKind.TYPE_INT)
        assert (== (list_CompilerDiagnostic_length mutation_diags) 0)
        set mutation_index (+ mutation_index 1)
    }
    (mb_reset [])
}

/* NSType check a return statement expression
 * 
 * Validates that the return expression type matches the expected function return type
 */
fn typecheck_return_expr(ret_node: ASTReturn, expected_type: NSType, diags: List<CompilerDiagnostic>) -> bool {
    if (< ret_node.value 0) {
        /* No return value - expect void */
        if (== expected_type.kind TypeKind.TYPE_VOID) {
            return true
        } else {
            let msg: string = (encode_missing_return_message "<unnamed>" (type_to_string expected_type))
            let diag: CompilerDiagnostic = (Diagnostics.diag_typecheck_error "E0001" msg (Diagnostics.diag_location "" ret_node.line ret_node.column))
            (Diagnostics.diag_list_add diags diag)
            return false
        }
    } else {
        /* Has return value - type check it */
        /* For now, assume it's valid */
        /* Full implementation would check the expression type */
        return true
    }
}

shadow typecheck_return_expr { assert true }

/* =============================================================================
 * AST TYPE CHECKING - Statement validation
 * ============================================================================= */

fn array_elem_type_from_array_decl(t: string) -> string {
    let length: int = (str_length t)
    if (and (tc_str_starts_with t "array<") (and (> length 7) (tc_str_ends_with t ">"))) {
        return (str_substring t 6 (- length 7))
    }
    return ""
}


shadow array_elem_type_from_array_decl {
    assert (== (array_elem_type_from_array_decl "array<fn(array<int>)->int>") "fn(array<int>)->int")
    assert (== (array_elem_type_from_array_decl "Box<array<int>>") "")
    assert (== (array_elem_type_from_array_decl "array<int>") "int")
    assert (== (array_elem_type_from_array_decl "array<string>") "string")
    assert (== (array_elem_type_from_array_decl "array<array<int>>") "array<int>")
}

/* NSType check a let statement
 * 
 * Validates that:
 * 1. The variable is not already defined
 * 2. The initialization expression type matches the declared type
 * 
 * Returns: Updated symbols array with the new variable
 */
fn owned_pattern_complete(parser: Parser, binding: ASTLet) -> bool {
    let mut names: array<string> = []
    let mut found: bool = false
    let mut i: int = 0
    while (< i (parser_get_struct_def_count parser)) {
        let record: ASTStruct = (parser_get_struct_def parser i)
        if (== record.name binding.var_type) { set names record.field_names set found true }
        set i (+ i 1)
    }
    set i 0
    while (and (not found) (< i (parser_get_union_count parser))) {
        let definition: ASTUnion = (parser_get_union parser i)
        let mut offset: int = 0
        let mut variant: int = 0
        while (< variant definition.variant_count) {
            let count: int = (at definition.variant_field_counts variant)
            if (== binding.var_type (+ (+ definition.name ".") (at definition.variant_names variant))) {
                set found true
                let mut field: int = 0
                while (< field count) {
                    set names (array_push names (at definition.variant_field_names (+ offset field)))
                    set field (+ field 1)
                }
            }
            set offset (+ offset count)
            set variant (+ variant 1)
        }
        set i (+ i 1)
    }
    if (or (not found) (!= (array_length names) (array_length binding.destructure_names))) { return false }
    let mut field: int = 0
    while (< field (array_length binding.destructure_names)) {
        let name: string = (at binding.destructure_names field)
        if (not (resource_name_in names name)) { return false }
        let mut previous: int = 0
        while (< previous field) {
            if (== name (at binding.destructure_names previous)) { return false }
            set previous (+ previous 1)
        }
        set field (+ field 1)
    }
    return true
}

shadow owned_pattern_complete {
    let parsed: Parser = (resource_test_parser "struct Box { item: int } fn unpack(box: Box) -> int { let Box { item } = box return item }")
    assert (owned_pattern_complete parsed (parser_get_let parsed 1))
    let bad: Parser = (resource_test_parser "struct Box { item: int } fn unpack(box: Box) -> int { let Box {} = box return 0 }")
    assert (not (owned_pattern_complete bad (parser_get_let bad 1)))
    let generic: Parser = (resource_test_parser "union Box<T> { Some { value: T }, None {} } fn unpack(box: Box<int>) -> int { match box { Some(payload) => { let Box.Some { value } = payload return value } None(payload) => { return 0 } } }")
    assert (owned_pattern_complete generic (parser_get_let generic 1))
}

fn check_let_statement(parser: Parser, let_node: ASTLet, node_id: int, symbols: array<Symbol>, diags: List<CompilerDiagnostic>, file_name: string) -> array<Symbol> {
    if (and let_node.is_destructure (not (owned_pattern_complete parser let_node))) {
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0036" "I require every record or selected variant field exactly once in an owned pattern." (Diagnostics.diag_location file_name let_node.line let_node.column)))
        return symbols
    }
    if let_node.is_destructure {
        let selected: NSType = (check_expr_node parser let_node.value let_node.value_type symbols diags file_name)
        if (or (!= selected.kind TypeKind.TYPE_STRUCT) (!= selected.name let_node.var_type)) {
            (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0036" "I require the pattern to name the selected record or variant." (Diagnostics.diag_location file_name let_node.line let_node.column)))
            return symbols
        }
        # Preserve the concrete union arguments on the hidden payload alias.
        return (env_add_symbol symbols (symbol_new let_node.name selected let_node.is_mut false 0 (empty_param_types) (type_void)))
    }
    # Allow variable redefinition (shadowing) to match C reference compiler behavior.
    # Shadow tests commonly reuse names (e.g., `let result` across multiple asserts).

    /* Type inference: let x = expr  (no declared type) */
    if (== let_node.var_type "") {
        if (>= let_node.value 0) {
            let fact: CheckedBlock = (check_value_facts parser let_node.value let_node.value_type symbols diags file_name)
            let inferred: NSType = fact.value_type
            if (and fact.ok (and (== inferred.kind TypeKind.TYPE_ARRAY) (reduce_type_known parser inferred))) {
                (check_contextual_value parser let_node.value let_node.value_type inferred inferred symbols diags file_name)
            }
            if (or (not fact.ok) fact.terminates) {
                (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0001" "I require compatible, resolved values for inference; only literal empties supply holes." (Diagnostics.diag_location file_name let_node.line let_node.column)))
            }
            let inferred_str: string = (cond ((and (== inferred.kind TypeKind.TYPE_UNION) (!= inferred.element_type_name "")) inferred.element_type_name) (else (type_to_string inferred)))
            # I publish only complete inference; literal holes stay tied to their AST.
            if (reduce_type_known parser inferred) { (parser_set_let_var_type parser node_id inferred_str) }
            let sym: Symbol = (symbol_new let_node.name inferred let_node.is_mut false 0 (empty_param_types) (type_void))
            return (env_add_symbol symbols sym)
        } else {
            let diag: CompilerDiagnostic = (Diagnostics.diag_typecheck_error "E0001" "type-inferred let requires an initializer" (Diagnostics.diag_location file_name let_node.line let_node.column))
            (Diagnostics.diag_list_add diags diag)
            return symbols
        }
    } else { (print "") }

    /* Get declared type */
    let declared_type: NSType = (type_from_string_with_parser parser let_node.var_type)

    if (>= let_node.value 0) {
        let init_type_raw: NSType = (check_expr_node parser let_node.value let_node.value_type symbols diags file_name)
        let init_type_hint: NSType = (check_contextual_value parser let_node.value let_node.value_type init_type_raw declared_type symbols diags file_name)
        let mut init_type: NSType = (apply_return_type_hint init_type_hint declared_type)
        if (and (== let_node.value_type ParseNodeType.PNODE_ARRAY_LITERAL) (and (== declared_type.kind TypeKind.TYPE_ARRAY) (== declared_type.element_type_kind TypeKind.TYPE_INT))) {
            let literal: ASTArrayLiteral = (parser_get_array_literal parser let_node.value)
            let mut has_enum: bool = false
            let mut integer_elements: bool = true
            let mut element_index: int = 0
            while (< element_index literal.element_count) {
                let element: ASTStmtRef = (parser_get_array_element parser (+ literal.element_start element_index))
                let actual: NSType = (check_expr_node parser element.node_id element.node_type symbols diags file_name)
                if (== actual.kind TypeKind.TYPE_ENUM) { set has_enum true }
                if (not (or (== actual.kind TypeKind.TYPE_INT) (== actual.kind TypeKind.TYPE_ENUM))) { set integer_elements false }
                set element_index (+ element_index 1)
            }
            if has_enum {
                if integer_elements { set init_type declared_type }
                else {
                    (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0001" "I require integer or enum scalar elements in this integer array literal." (Diagnostics.diag_location file_name let_node.line let_node.column)))
                }
            }
        }
        if (not (types_equal init_type declared_type)) {
            let detail: string = (+ "Variable " let_node.name)
            let msg: string = (encode_type_mismatch_message "variable_assignment" (type_to_string declared_type) (type_to_string init_type) detail)
            let diag: CompilerDiagnostic = (Diagnostics.diag_typecheck_error "E0001" msg (Diagnostics.diag_location file_name let_node.line let_node.column))
            (Diagnostics.diag_list_add diags diag)
        } else {
            (print "")
        }
    } else {
        (print "")
    }

    let sym: Symbol = (symbol_new let_node.name declared_type let_node.is_mut false 0 (empty_param_types) (type_void))
    return (env_add_symbol symbols sym)
}

shadow check_let_statement {
    let tokens: List<LexerToken> = (tokenize_string "fn main() -> int { let value: array<int> = (map [1] convert) return 0 }" "map.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "map.nano")
    let params: array<NSType> = [(type_int)]
    let symbols: array<Symbol> = [(symbol_new "convert" (type_float) false true 1 params (type_float))]
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    (check_let_statement parser (parser_get_let parser 0) 0 symbols diags "map.nano")
    assert (> (list_CompilerDiagnostic_length diags) 0)
    let generic: Parser = (resource_test_parser "union Box<T> { Some { value: T }, None {} } fn main() -> int { let copy = source return 0 }")
    let concrete: NSType = (type_from_string_with_parser generic "Box<int>")
    let source_symbols: array<Symbol> = [(symbol_new "source" concrete false false 0 (empty_param_types) (type_void))]
    let clean: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    (check_let_statement generic (parser_get_let generic 0) 0 source_symbols clean "generic.nano")
    assert (== (list_CompilerDiagnostic_length clean) 0)
    let copied: ASTLet = (parser_get_let generic 0)
    assert (== copied.var_type "Box<int>")
    let mapped: Parser = (resource_test_parser "fn main() -> int { let fetched = (map_get values \"key\") return 0 }")
    let map_symbols: array<Symbol> = [(symbol_new "values" (type_from_string "HashMap<string,string>") false false 0 (empty_param_types) (type_void))]
    let map_diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    (check_let_statement mapped (parser_get_let mapped 0) 0 map_symbols map_diags "map.nano")
    assert (== (list_CompilerDiagnostic_length map_diags) 0)
    assert (== (parser_get_let mapped 0).var_type "string")
    let explicit_unknown: Parser = (resource_test_parser "fn main() -> int { let fetched: unknown = (map_get values \"key\") return 0 }")
    (check_let_statement explicit_unknown (parser_get_let explicit_unknown 0) 0 map_symbols map_diags "map.nano")
    assert (== (parser_get_let explicit_unknown 0).var_type "unknown")
    let ordinary: Parser = (resource_test_parser "fn main() -> int { let fetched = (map_get values \"key\") return 0 }")
    let ordinary_symbols: array<Symbol> = (env_add_symbol map_symbols (symbol_new "map_get" (type_int) false true 2 [(type_from_string "HashMap<string,string>"), (type_string)] (type_int)))
    (check_let_statement ordinary (parser_get_let ordinary 0) 0 ordinary_symbols map_diags "map.nano")
    assert (== (parser_get_let ordinary 0).var_type "int")
    assert (== (list_CompilerDiagnostic_length map_diags) 0)
}

/* NSType check a return statement
 * 
 * Validates that the return expression type matches the function's return type
 * 
 * Returns: true if valid, false if type error
 */
fn check_return_statement(parser: Parser, ret_node: ASTReturn, expected_type: NSType, symbols: array<Symbol>, diags: List<CompilerDiagnostic>, file_name: string, current_function: string) -> bool {
    /* If no return value, expect void */
    if (< ret_node.value 0) {
        if (== expected_type.kind TypeKind.TYPE_VOID) {
            return true
        } else {
            let msg: string = (encode_missing_return_message current_function (type_to_string expected_type))
            let diag: CompilerDiagnostic = (Diagnostics.diag_typecheck_error "E0001" msg (Diagnostics.diag_location file_name ret_node.line ret_node.column))
            (Diagnostics.diag_list_add diags diag)
            return false
        }
    } else {
        let expr_t_raw: NSType = (check_expr_node parser ret_node.value ret_node.value_type symbols diags file_name)
        let expr_t_hint: NSType = (check_contextual_value parser ret_node.value ret_node.value_type expr_t_raw expected_type symbols diags file_name)
        let expr_t: NSType = (apply_return_type_hint expr_t_hint expected_type)
        if (not (types_equal expr_t expected_type)) {
            let detail: string = (+ "Return value of " current_function)
            let msg: string = (encode_type_mismatch_message "return" (type_to_string expected_type) (type_to_string expr_t) detail)
            let diag: CompilerDiagnostic = (Diagnostics.diag_typecheck_error "E0001" msg (Diagnostics.diag_location file_name ret_node.line ret_node.column))
            (Diagnostics.diag_list_add diags diag)
            return false
        } else {
            return true
        }
    }
}

shadow check_return_statement { assert true }

fn check_set_statement(parser: Parser, set_node: ASTSet, symbols: array<Symbol>, diags: List<CompilerDiagnostic>, file_name: string) -> bool {
    let idx: int = (env_lookup symbols set_node.target)
    if (< idx 0) {
        let msg: string = (encode_undefined_name_message set_node.target)
        let diag: CompilerDiagnostic = (Diagnostics.diag_typecheck_error "E0002" msg (Diagnostics.diag_location file_name set_node.line set_node.column))
        (Diagnostics.diag_list_add diags diag)
        return false
    } else {
        let sym: Symbol = (at symbols idx)
        if (!= set_node.field_name "") {
            let mut i: int = 0
            while (< i (parser_get_struct_def_count parser)) {
                let record: ASTStruct = (parser_get_struct_def parser i)
                if (== record.name sym.sym_type.name) {
                    let mut field: int = 0
                    while (< field record.field_count) {
                        if (== (at record.field_names field) set_node.field_name) {
                            let actual: NSType = (check_expr_node parser set_node.value set_node.value_type symbols diags file_name)
                            let expected: NSType = (type_from_string_with_parser parser (at record.field_types field))
                            if (check_record_field_value parser set_node.value set_node.value_type actual expected symbols diags file_name) { return true }
                            (resource_flow_error diags file_name set_node.line set_node.column "I require the declared field type for borrowed mutation")
                            return false
                        }
                        set field (+ field 1)
                    }
                }
                set i (+ i 1)
            }
            (resource_flow_error diags file_name set_node.line set_node.column "I cannot find the named field in this borrowed owner")
            return false
        }
        if (not sym.is_mutable) {
            let msg: string = (encode_immutable_assignment_message set_node.target)
            let diag: CompilerDiagnostic = (Diagnostics.diag_typecheck_error "E0005" msg (Diagnostics.diag_location file_name set_node.line set_node.column))
            (Diagnostics.diag_list_add diags diag)
            return false
        } else {
            let rhs_t_raw: NSType = (check_expr_node parser set_node.value set_node.value_type symbols diags file_name)
            let rhs_t_hint: NSType = (check_contextual_value parser set_node.value set_node.value_type rhs_t_raw sym.sym_type symbols diags file_name)
            let rhs_t: NSType = (apply_return_type_hint rhs_t_hint sym.sym_type)
            if (not (types_equal rhs_t sym.sym_type)) {
                let detail: string = (+ "Assignment to " set_node.target)
                let msg: string = (encode_type_mismatch_message "variable_assignment" (type_to_string sym.sym_type) (type_to_string rhs_t) detail)
                let diag: CompilerDiagnostic = (Diagnostics.diag_typecheck_error "E0001" msg (Diagnostics.diag_location file_name set_node.line set_node.column))
                (Diagnostics.diag_list_add diags diag)
                return false
            } else {
                return true
            }
        }
    }
}

shadow check_set_statement { assert true }

fn expr_kind_from_pnode(pnode_type: int) -> int {
    if (== pnode_type ParseNodeType.PNODE_NUMBER) { return 0 }
    else { if (== pnode_type ParseNodeType.PNODE_IDENTIFIER) { return 1 }
    else { if (== pnode_type ParseNodeType.PNODE_BINARY_OP) { return 2 }
    else { if (== pnode_type ParseNodeType.PNODE_CALL) { return 3 }
    else { if (== pnode_type ParseNodeType.PNODE_STRING) { return 4 }
    else { if (== pnode_type ParseNodeType.PNODE_BOOL) { return 5 }
    else { if (== pnode_type ParseNodeType.PNODE_FLOAT) { return 6 }
    else { if (== pnode_type ParseNodeType.PNODE_UNION_CONSTRUCT) { return 7 }
    else { if (== pnode_type ParseNodeType.PNODE_MATCH) { return 8 }
    else { if (== pnode_type ParseNodeType.PNODE_TUPLE_LITERAL) { return 9 }
    else { if (== pnode_type ParseNodeType.PNODE_TUPLE_INDEX) { return 10 }
    else { return (- 0 1) } } } } } } } } } } }
}

shadow expr_kind_from_pnode {
    assert (== (expr_kind_from_pnode ParseNodeType.PNODE_NUMBER) 0)
    assert (== (expr_kind_from_pnode ParseNodeType.PNODE_IDENTIFIER) 1)
    assert (== (expr_kind_from_pnode ParseNodeType.PNODE_CALL) 3)
}

fn par_scalar_expr(parser: Parser, node_id: int, kind: int, symbols: array<Symbol>, names: array<string>) -> bool {
    if (or (== kind ParseNodeType.PNODE_NUMBER) (or (== kind ParseNodeType.PNODE_FLOAT)
           (or (== kind ParseNodeType.PNODE_STRING) (== kind ParseNodeType.PNODE_BOOL)))) { return true }
    if (== kind ParseNodeType.PNODE_IDENTIFIER) {
        let name: string = (parser_get_identifier parser node_id).name
        let mut i: int = 0
        while (< i (array_length names)) {
            if (== name (at names i)) { return false }
            set i (+ i 1)
        }
        let index: int = (env_lookup symbols name)
        if (< index 0) { return false }
        let symbol: Symbol = (at symbols index)
        let tag: int = symbol.sym_type.kind
        return (and (not symbol.is_mutable) (and (not symbol.is_function)
            (or (== tag TypeKind.TYPE_INT) (or (== tag TypeKind.TYPE_FLOAT)
                (or (== tag TypeKind.TYPE_STRING) (== tag TypeKind.TYPE_BOOL))))))
    }
    if (== kind ParseNodeType.PNODE_BINARY_OP) {
        let node: ASTBinaryOp = (parser_get_binary_op parser node_id)
        if node.is_unary { return (par_scalar_expr parser node.right node.right_type symbols names) }
        return (and (par_scalar_expr parser node.left node.left_type symbols names)
                    (par_scalar_expr parser node.right node.right_type symbols names))
    }
    if (or (== kind ParseNodeType.PNODE_CALL) (== kind ParseNodeType.PNODE_MODULE_QUALIFIED_CALL)) {
        let mut name: string = ""
        let mut line: int = 0
        let mut start: int = 0
        let mut length: int = 0
        if (== kind ParseNodeType.PNODE_CALL) {
            let call: ASTCall = (parser_get_call parser node_id)
            if (or (!= call.function_type ParseNodeType.PNODE_IDENTIFIER) (!= call.borrow_mode 0)) { return false }
            let ident: ASTIdentifier = (parser_get_identifier parser call.function)
            let binding: int = (env_lookup symbols ident.name)
            if (>= binding 0) {
                if (not (at symbols binding).is_function) { return false }
            }
            set name ident.name set line ident.line set start call.arg_start set length call.arg_count
        } else {
            let call: ASTModuleQualifiedCall = (parser_get_module_qualified_call parser node_id)
            set name call.function_name set line call.line set start call.arg_start set length call.arg_count
        }
        if (not (par_closed_call parser name line length)) { return false }
        let mut i: int = 0
        while (< i length) {
            let arg: ASTStmtRef = (parser_get_call_arg parser (+ start i))
            if (not (par_scalar_expr parser arg.node_id arg.node_type symbols names)) { return false }
            set i (+ i 1)
        }
        return true
    }
    return false
}
shadow par_scalar_expr {
    let parsed: Parser = (resource_test_parser "fn main() -> int { return 1 }")
    let names: array<string> = []
    let symbols: array<Symbol> = []
    assert (par_scalar_expr parsed 0 ParseNodeType.PNODE_NUMBER symbols names)
    assert (not (par_scalar_expr parsed 0 ParseNodeType.PNODE_ARRAY_LITERAL symbols names))
}

fn check_flow_statement(parser: Parser, block: ASTBlock, symbols: array<Symbol>, diags: List<CompilerDiagnostic>, file_name: string) -> array<Symbol> {
    let count: int = (list_ASTStmtRef_length block.statements)
    let order: array<int> = (passive_order parser block)
    if (or (== count 0) (!= (array_length order) count)) {
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0036" "I require distinct immutable scalar flow bindings with acyclic dependencies." (Diagnostics.diag_location file_name block.line block.column)))
        return symbols
    }
    let mut result: array<Symbol> = (env_copy_symbols symbols)
    let names: array<string> = []
    let mut i: int = 0
    while (< i count) {
        let statement: ASTStmtRef = (list_ASTStmtRef_get block.statements (at order i))
        let binding: ASTLet = (parser_get_let parser statement.node_id)
        if (not (par_scalar_expr parser binding.value binding.value_type result names)) {
            (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0036" "I require scalar flow expressions and checked closed scalar calls." (Diagnostics.diag_location file_name block.line block.column)))
            return result
        }
        set result (check_let_statement parser binding statement.node_id result diags file_name)
        set i (+ i 1)
    }
    return result
}
shadow check_flow_statement {
    let good: Parser = (resource_test_parser "fn main() -> int { flow { let b: int = (+ a 1) let a: int = 2 } return b }")
    assert (not (typecheck_phase good "flow.nano").had_error)
    let bad: Parser = (resource_test_parser "fn main() -> int { flow { let a: int = b let b: int = a } return b }")
    assert (typecheck_phase bad "flow.nano").had_error
}

fn check_par_statement(parser: Parser, block: ASTBlock, symbols: array<Symbol>, diags: List<CompilerDiagnostic>, file_name: string) -> array<Symbol> {
    let count: int = (list_ASTStmtRef_length block.statements)
    let mut names: array<string> = []
    let mut valid: bool = (> count 0)
    let mut i: int = 0
    while (< i count) {
        let statement: ASTStmtRef = (list_ASTStmtRef_get block.statements i)
        if (!= statement.node_type ParseNodeType.PNODE_LET) { set valid false }
        else {
            let binding: ASTLet = (parser_get_let parser statement.node_id)
            if binding.is_mut { set valid false }
            let mut j: int = 0
            while (< j (array_length names)) {
                if (== binding.name (at names j)) { set valid false }
                set j (+ j 1)
            }
            set names (array_push names binding.name)
        }
        set i (+ i 1)
    }
    set i 0
    while (and valid (< i count)) {
        let binding: ASTLet = (parser_get_let parser (list_ASTStmtRef_get block.statements i).node_id)
        if (not (par_scalar_expr parser binding.value binding.value_type symbols names)) { set valid false }
        set i (+ i 1)
    }
    if (not valid) {
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0036" "I require nonempty independent immutable scalar let bindings in par and checked closed scalar calls." (Diagnostics.diag_location file_name block.line block.column)))
        return symbols
    }
    let mut result: array<Symbol> = (env_copy_symbols symbols)
    set i 0
    while (< i count) {
        let statement: ASTStmtRef = (list_ASTStmtRef_get block.statements i)
        set result (check_let_statement parser (parser_get_let parser statement.node_id) statement.node_id result diags file_name)
        set i (+ i 1)
    }
    return result
}
shadow check_par_statement {
    let good: Parser = (resource_test_parser "fn main() -> int { par { let a: int = 1 let b: int = 2 } return (+ a b) }")
    assert (not (typecheck_phase good "par.nano").had_error)
    let bad: Parser = (resource_test_parser "fn main() -> int { par { let a: int = 1 let b: int = a } return b }")
    assert (typecheck_phase bad "par.nano").had_error
}

fn check_block_value(parser: Parser, block_id: int, symbols: array<Symbol>, expected_return: NSType, diags: List<CompilerDiagnostic>, file_name: string, current_function: string) -> CheckedBlock {
    let block: ASTBlock = (parser_get_block parser block_id)
    return (check_statement_list parser block.statements symbols expected_return diags file_name current_function)
}

fn check_statement_values(parser: Parser, statements: List<ASTStmtRef>, symbols: array<Symbol>, expected_return: NSType, expected_value: NSType, value_required: bool, diags: List<CompilerDiagnostic>, file_name: string, current_function: string) -> CheckedBlock {
    let errors_start: int = (list_CompilerDiagnostic_length diags)
    let stmt_count: int = (list_ASTStmtRef_length statements)
    let mut local_symbols: array<Symbol> = (env_copy_symbols symbols)
    let mut ok: bool = true
    let mut returned: bool = false
    let mut value_fact: CheckedBlock = (checked_value (type_void) true false false)

    let mut i: int = 0
    while (< i stmt_count) {
        let stmt: ASTStmtRef = (list_ASTStmtRef_get statements i)

        /* Dead code detection: warn if statement follows a return */
        if (== returned true) {
            let ret_diag: CompilerDiagnostic = (Diagnostics.diag_warning CompilerPhase.PHASE_TYPECHECK "W0002" "Unreachable code after return" (Diagnostics.diag_location file_name 0 0))
            (Diagnostics.diag_list_add diags ret_diag)
        } else { (print "") }
        
        if (== stmt.node_type ParseNodeType.PNODE_BLOCK) {
            let parallel_block: ASTBlock = (parser_get_block parser stmt.node_id)
            if (or parallel_block.is_par parallel_block.is_flow) {
                let before: int = (list_CompilerDiagnostic_length diags)
                if parallel_block.is_flow {
                    set local_symbols (check_flow_statement parser parallel_block local_symbols diags file_name)
                } else {
                    set local_symbols (check_par_statement parser parallel_block local_symbols diags file_name)
                }
                if (> (list_CompilerDiagnostic_length diags) before) { set ok false }
                set i (+ i 1)
                continue
            }
            let mut destination: NSType = (type_unknown_named "unused block")
            if (== i (- stmt_count 1)) { set destination expected_value }
            let nested: CheckedBlock = (check_statement_values parser parallel_block.statements local_symbols expected_return destination (and value_required (== i (- stmt_count 1))) diags file_name current_function)
            if (not nested.ok) { set ok false }
            if (not returned) {
                if (== i (- stmt_count 1)) { set value_fact nested }
                if nested.terminates { set returned true }
            }
            set i (+ i 1)
            continue
        }
        if (or (== stmt.node_type ParseNodeType.PNODE_BREAK) (== stmt.node_type ParseNodeType.PNODE_CONTINUE)) {
            set returned true
            set i (+ i 1)
            continue
        }
        if (== stmt.node_type ParseNodeType.PNODE_LET) {
            let let_node: ASTLet = (parser_get_let parser stmt.node_id)
            set local_symbols (check_let_statement parser let_node stmt.node_id local_symbols diags file_name)
        } else { if (== stmt.node_type ParseNodeType.PNODE_SET) {
            let set_node: ASTSet = (parser_get_set parser stmt.node_id)
            if (not (check_set_statement parser set_node local_symbols diags file_name)) { set ok false } else { (print "") }
        } else { if (== stmt.node_type ParseNodeType.PNODE_IF) {
            if (and value_required (and (not returned) (== i (- stmt_count 1)))) {
                set value_fact (check_if_value parser stmt.node_id local_symbols expected_value diags file_name)
                set returned value_fact.terminates
                if (not value_fact.ok) { set ok false }
                set i (+ i 1)
                continue
            }
            let if_node: ASTIf = (parser_get_if parser stmt.node_id)
            let cond_raw: NSType = (check_expr_node parser if_node.condition if_node.condition_type local_symbols diags file_name)
            let cond_t: NSType = (apply_return_type_hint cond_raw (type_bool))
            if (!= cond_t.kind TypeKind.TYPE_BOOL) {
                let diag: CompilerDiagnostic = (Diagnostics.diag_typecheck_error "E0001" "if condition must be bool" (Diagnostics.diag_location file_name if_node.line if_node.column))
                (Diagnostics.diag_list_add diags diag)
                set ok false
            } else { (print "") }

            let mut then_terminal: bool = false
            let mut else_terminal: bool = false
            if (>= if_node.then_body 0) {
                let checked: CheckedBlock = (check_statement_values parser (parser_get_block parser if_node.then_body).statements local_symbols expected_return (type_unknown_named "unused branch value") false diags file_name current_function)
                if (not checked.ok) { set ok false }
                set then_terminal checked.terminates
            }
            if (>= if_node.else_body 0) {
                let checked: CheckedBlock = (check_statement_values parser (parser_get_block parser if_node.else_body).statements local_symbols expected_return (type_unknown_named "unused branch value") false diags file_name current_function)
                if (not checked.ok) { set ok false }
                set else_terminal checked.terminates
            }
            if (and then_terminal else_terminal) { set returned true }
        } else { if (== stmt.node_type ParseNodeType.PNODE_WHILE) {
            let while_node: ASTWhile = (parser_get_while parser stmt.node_id)
            let cond_raw: NSType = (check_expr_node parser while_node.condition while_node.condition_type local_symbols diags file_name)
            let cond_t: NSType = (apply_return_type_hint cond_raw (type_bool))
            if (!= cond_t.kind TypeKind.TYPE_BOOL) {
                let diag: CompilerDiagnostic = (Diagnostics.diag_typecheck_error "E0001" "while condition must be bool" (Diagnostics.diag_location file_name while_node.line while_node.column))
                (Diagnostics.diag_list_add diags diag)
                set ok false
            } else { (print "") }

            if (>= while_node.body 0) {
                if (not (check_block parser while_node.body local_symbols expected_return diags file_name current_function)) { set ok false } else { (print "") }
            } else { (print "") }
        } else { if (== stmt.node_type ParseNodeType.PNODE_FOR) {
            let for_node: ASTFor = (parser_get_for parser stmt.node_id)
            /* Determine loop variable type from iterable */
            let iter_type: NSType = (check_expr_node parser for_node.iterable for_node.iterable_type local_symbols diags file_name)
            let mut loop_var_type: NSType = (type_int)
            if (== iter_type.kind TypeKind.TYPE_LIST_GENERIC) {
                set loop_var_type (type_from_string_with_parser parser iter_type.element_type_name)
            } else { if (== iter_type.kind TypeKind.TYPE_ARRAY) {
                set loop_var_type (array_element_fact parser iter_type)
                if (not (reduce_type_known parser loop_var_type)) {
                    (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0001" "I require complete array element facts for iteration." (Diagnostics.diag_location file_name for_node.line for_node.column)))
                    set ok false
                }
            } else { (print "") } }
            /* Add loop var to symbols, then check body */
            let loop_sym: Symbol = (symbol_new for_node.var_name loop_var_type false false 0 (empty_param_types) (type_void))
            let body_symbols: array<Symbol> = (env_add_symbol (env_copy_symbols local_symbols) loop_sym)
            if (>= for_node.body 0) {
                if (not (check_block parser for_node.body body_symbols expected_return diags file_name current_function)) { set ok false } else { (print "") }
            } else { (print "") }
        } else { if (== stmt.node_type ParseNodeType.PNODE_RETURN) {
            let ret_node: ASTReturn = (parser_get_return parser stmt.node_id)
            
            if (not (check_return_statement parser ret_node expected_return local_symbols diags file_name current_function)) {
                set ok false
            } else { (print "") }
            set returned true
        } else { if (== stmt.node_type ParseNodeType.PNODE_ASSERT) {
            let a: ASTAssert = (parser_get_assert parser stmt.node_id)
            let cond_raw: NSType = (check_expr_node parser a.condition a.condition_type local_symbols diags file_name)
            let cond_t: NSType = (apply_return_type_hint cond_raw (type_bool))
            if (!= cond_t.kind TypeKind.TYPE_BOOL) {
                let diag: CompilerDiagnostic = (Diagnostics.diag_typecheck_error "E0001" "assert condition must be bool" (Diagnostics.diag_location file_name a.line a.column))
                (Diagnostics.diag_list_add diags diag)
                set ok false
            } else { (print "") }
        } else { if (== stmt.node_type ParseNodeType.PNODE_UNSAFE_BLOCK) {
            let unsafe_block: ASTUnsafeBlock = (parser_get_unsafe_block parser stmt.node_id)
            let mut destination: NSType = (type_unknown_named "unused block")
            if (== i (- stmt_count 1)) { set destination expected_value }
            let checked: CheckedBlock = (check_statement_values parser unsafe_block.statements local_symbols expected_return destination (and value_required (== i (- stmt_count 1))) diags file_name current_function)
            if (not checked.ok) { set ok false }
            if (not returned) {
                if (== i (- stmt_count 1)) { set value_fact checked }
                if checked.terminates { set returned true }
            }
        } else {
            /* Expression statement */
            if (parser_is_value_expression stmt.node_type) {
                let fact: CheckedBlock = (check_value_facts parser stmt.node_id stmt.node_type local_symbols diags file_name)
                if (and (not returned) (== i (- stmt_count 1))) {
                    set value_fact fact
                    if (and (not fact.terminates) (!= expected_value.kind TypeKind.TYPE_UNKNOWN)) {
                        let before: int = (list_CompilerDiagnostic_length diags)
                        let contextual: NSType = (check_contextual_value parser stmt.node_id stmt.node_type fact.value_type expected_value local_symbols diags file_name)
                        set value_fact (checked_value contextual (and (not (checked_value_errors diags before)) (and (reduce_type_known parser contextual) (types_equal contextual expected_value))) false false)
                    }
                }
                if fact.terminates { set returned true if (not fact.ok) { set ok false } }
            } else {
                (print "")
            }
        } } } } } } } }

        set i (+ i 1)
    }

    if (checked_value_errors diags errors_start) { set ok false }
    if returned { return (checked_value (type_void) ok false true) }
    if (not value_required) { return (checked_value (type_void) ok false false) }
    return (checked_value value_fact.value_type (and ok value_fact.ok) value_fact.empty_holes false)
}

fn check_statement_list(parser: Parser, statements: List<ASTStmtRef>, symbols: array<Symbol>, expected_return: NSType, diags: List<CompilerDiagnostic>, file_name: string, current_function: string) -> CheckedBlock {
    return (check_statement_values parser statements symbols expected_return (type_unknown_named "inference") true diags file_name current_function)
}
