            let context: string = (resource_parameter_type parser call.function_name call.line i states)
            set flow (resource_flow_value parser arg.node_id arg.node_type context flow.states true loop_entry diags file_name return_type)
            set i (+ i 1)
        }
        if (and flow.next (and (not move) (resource_type_is_declared parser (resource_value_type parser node_id node_type states)))) {
            (resource_flow_error diags file_name call.line call.column "resource result has no resolved owner")
        }
        return flow
    }
