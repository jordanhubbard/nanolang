    let parser: Parser = (resource_test_parser "fn f() -> void { let a = match 1 { 1 => [] _ => [1] } }")
    let result: CheckedBlock = (check_match_value parser 0 [] (type_unknown_named "inference") (list_CompilerDiagnostic_new) "match.nano")
