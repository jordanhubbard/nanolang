    let symbols: array<Symbol> = [(symbol_new "source" (type_from_string "array<Right>") false false 0 (empty_param_types) (type_void))]
    let value: ASTLet = (parser_get_let exact 0)
    let before: int = (list_CompilerDiagnostic_length diags)
    (check_struct_literal exact value.value symbols diags "record.nano")
    assert (> (list_CompilerDiagnostic_length diags) before)
}

fn check_union_construct(parser: Parser, node_id: int) -> NSType {
    let uc: ASTUnionConstruct = (parser_get_union_construct parser node_id)
    if (> (array_length (tc_generic_arguments uc.union_name)) 0) {
        let concrete: NSType = (type_from_string_with_parser parser uc.union_name)
        if (== concrete.kind TypeKind.TYPE_UNION) { return concrete }
    }
    
    /* Return union type */
    return NSType {
        kind: TypeKind.TYPE_UNION,
        name: uc.union_name,
        element_type_kind: TypeKind.TYPE_UNKNOWN,
        element_type_name: ""
    }
}

shadow check_union_construct {
    let parser: Parser = (resource_test_parser "union Box<T> { Some { value: T }, None {} } fn f() -> Box<int> { return Box<int>.None {} }")
    let concrete: NSType = (check_union_construct parser 0)
    assert (types_equal concrete (type_from_string_with_parser parser "Box<int>"))
    assert (not (types_equal concrete (type_from_string_with_parser parser "Box<string>")))
    assert (== (type_to_string concrete) "Box<int>")
}

/* Check match expression  
 * Example: match opt { Some(s) => s.value, None(n) => 0 }
 * Returns: NSType of the match arms (must all match)
 */
# I check patterns against the actual domain, preserving conditional arm order.
fn check_match_coverage(parser: Parser, matched: ASTMatch, actual: NSType, diags: List<CompilerDiagnostic>, file_name: string) -> void {
    let is_int: bool = (== actual.kind TypeKind.TYPE_INT)
    let mut variants: array<string> = []
    let mut ui: int = 0
    while (< ui (parser_get_union_count parser)) {
        let definition: ASTUnion = (parser_get_union parser ui)
        if (== definition.name (base_type_name actual.name)) { set variants definition.variant_names }
        set ui (+ ui 1)
    }
    let mut covered: array<string> = []
    let mut wildcard: bool = false
    let mut i: int = 0
    while (< i matched.arm_count) {
        let pattern: string = (at matched.arm_variants i)
        if wildcard {
            (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E036" "I cannot reach an arm after an unconditional wildcard" (Diagnostics.diag_location file_name matched.line matched.column)))
        }
        if (!= pattern "_") {
            let valid: bool = (cond (is_int (tc_str_starts_with pattern "INT:")) (else (resource_name_in variants pattern)))
            if (not valid) {
                (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0001" "I require a pattern from the exact match domain" (Diagnostics.diag_location file_name matched.line matched.column)))
            }
        }
        if (parser_match_arm_unconditional parser matched i) {
            if (== pattern "_") { set wildcard true }
            else { set covered (array_push covered pattern) }
        }
        set i (+ i 1)
    }
    let mut total: bool = wildcard
    if (and (not is_int) (> (array_length variants) 0)) {
        let mut all: bool = true
        set i 0
        while (< i (array_length variants)) {
            if (not (resource_name_in covered (at variants i))) { set all false }
            set i (+ i 1)
        }
        if all { set total true }
    }
    if (not total) {
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E035" "I require unconditional coverage of every match value" (Diagnostics.diag_location file_name matched.line matched.column)))
    }
}
shadow check_match_coverage {
    let parser: Parser = (resource_test_parser "fn f() -> int { return match 1 { 1 if false => 2 _ if true => 3 } } fn g() -> int { return match 1 { 1 if true => 2 } } fn h() -> int { return match 1 { _ => 2 1 => 3 } }")
    let valid: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    (check_match_coverage parser (parser_get_match parser 0) (type_int) valid "coverage.nano")
    assert (== (Diagnostics.diag_list_count valid) 0)
    let missing: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    (check_match_coverage parser (parser_get_match parser 1) (type_int) missing "coverage.nano")
    assert (== (Diagnostics.diag_list_count missing) 1)
    let dead: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    (check_match_coverage parser (parser_get_match parser 2) (type_int) dead "coverage.nano")
    assert (== (Diagnostics.diag_list_count dead) 1)
}

fn check_match_value(parser: Parser, node_id: int, symbols: array<Symbol>, expected: NSType, diags: List<CompilerDiagnostic>, file_name: string) -> CheckedBlock {
    let before: int = (list_CompilerDiagnostic_length diags)
    let m: ASTMatch = (parser_get_match parser node_id)
    
    /* Check scrutinee (expression being matched) */
    let scrutinee_type: NSType = (check_expr_node parser m.scrutinee m.scrutinee_type symbols diags file_name)

    if (and (!= scrutinee_type.kind TypeKind.TYPE_UNION) (!= scrutinee_type.kind TypeKind.TYPE_INT)) {
        let diag: CompilerDiagnostic = (Diagnostics.diag_typecheck_error "E0001" "I require an exact int or union match scrutinee" (Diagnostics.diag_location file_name m.line m.column))
        (Diagnostics.diag_list_add diags diag)
        return (checked_value (type_unknown_named "match_error") false false false)
    }
    (check_match_coverage parser m scrutinee_type diags file_name)

    if (<= m.arm_count 0) {
        return (checked_value (type_unknown_named "empty_match") false false false)
    } else {
        (print "")
    }

    let mut i: int = 0
    let mut joined: CheckedBlock = (checked_value (type_void) true false true)
    let union_name: string = scrutinee_type.name

    while (< i m.arm_count) {
        let mut arm_symbols: array<Symbol> = (env_copy_symbols symbols)
        let has_bindings: bool = (< i (array_length m.arm_bindings))
        if has_bindings {
            let binding_name: string = (at m.arm_bindings i)
            if (and (!= binding_name "") (!= binding_name "_")) {
                let variant_name: string = (at m.arm_variants i)
                let variant_label: string = (+ union_name (+ "." variant_name))
                let binding_type: NSType = NSType {
                    kind: TypeKind.TYPE_STRUCT,
                    name: variant_label,
                    element_type_kind: TypeKind.TYPE_UNKNOWN,
                    element_type_name: scrutinee_type.element_type_name
                }
                let binding_sym: Symbol = (symbol_new binding_name binding_type false false 0 (empty_param_types) (type_void))
                set arm_symbols (env_add_symbol arm_symbols binding_sym)
            } else {
                (print "")
            }
        } else {
            (print "")
        }

        if (< i (array_length m.arm_guard_ids)) {
            let guard_id: int = (at m.arm_guard_ids i)
            if (>= guard_id 0) {
                let guard_type: NSType = (check_expr_node parser guard_id (at m.arm_guard_types i) arm_symbols diags file_name)
                if (!= guard_type.kind TypeKind.TYPE_BOOL) {
                    let diag: CompilerDiagnostic = (Diagnostics.diag_typecheck_error "E0001" "I require an exact bool match guard" (Diagnostics.diag_location file_name m.line m.column))
                    (Diagnostics.diag_list_add diags diag)
                }
            }
        }

        let body_id: int = (at m.arm_body_ids i)
        let body_type: int = (at m.arm_body_types i)
        let mut fact: CheckedBlock = (check_value_facts parser body_id body_type arm_symbols diags file_name)
        if (and (not fact.terminates) (!= expected.kind TypeKind.TYPE_UNKNOWN)) {
            let before: int = (list_CompilerDiagnostic_length diags)
            let value: NSType = (check_contextual_value parser body_id body_type fact.value_type expected arm_symbols diags file_name)
            set fact (checked_value value (and (not (checked_value_errors diags before)) (and (reduce_type_known parser value) (types_equal value expected))) false false)
        }
        set joined (join_checked_values parser joined fact)

        set i (+ i 1)
    }

    return (checked_value joined.value_type (and joined.ok (not (checked_value_errors diags before))) joined.empty_holes joined.terminates)
}

fn check_match_expr(parser: Parser, node_id: int, symbols: array<Symbol>, diags: List<CompilerDiagnostic>, file_name: string) -> NSType {
    return (check_match_value parser node_id symbols (type_unknown_named "inference") diags file_name).value_type
}
