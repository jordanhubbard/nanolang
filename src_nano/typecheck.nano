fn check_block(parser: Parser, block_id: int, symbols: array<Symbol>, expected_return: NSType, diags: List<CompilerDiagnostic>, file_name: string, current_function: string) -> bool {
    let checked: CheckedBlock = (check_statement_values parser (parser_get_block parser block_id).statements symbols expected_return (type_unknown_named "unused block value") false diags file_name current_function)
    return checked.ok
}

shadow check_statement_list {
    let tokens: List<LexerToken> = (tokenize_string "fn main() -> int { return 0 return 1 }" "unreachable.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "unreachable.nano")
    let result: TypecheckPhaseOutput = (typecheck_phase parser "unreachable.nano")
    assert (not result.had_error)
    assert (== (list_CompilerDiagnostic_length result.diagnostics) 1)
    let warning: CompilerDiagnostic = (list_CompilerDiagnostic_get result.diagnostics 0)
    assert (== warning.code "W0002")
    assert (== warning.severity DiagnosticSeverity.DIAG_WARNING)
    assert (== warning.phase CompilerPhase.PHASE_TYPECHECK)
    let invalid_tokens: List<LexerToken> = (tokenize_string "fn main() -> int { return 0 let wrong: int = \"text\" }" "unreachable-error.nano" (list_CompilerDiagnostic_new))
    let invalid: Parser = (parse_program invalid_tokens (list_LexerToken_length invalid_tokens) "unreachable-error.nano")
    assert (typecheck_phase invalid "unreachable-error.nano").had_error
}

shadow check_block {
    let statement: Parser = (resource_test_parser "fn f() -> void { if true { (array_push [1] 2) } }")
    assert (not (typecheck_phase statement "statement.nano").had_error)
    let scoped: Parser = (resource_test_parser "fn f() -> int { { let value: int = 1 assert (== value 1) } return 0 }")
    assert (not (typecheck_phase scoped "scope.nano").had_error)
    let bad: Parser = (resource_test_parser "fn f() -> int { { let value: int = true } return 0 }")
    assert (typecheck_phase bad "scope.nano").had_error
}

/* =============================================================================
 * AST TYPE CHECKING - Function validation
 * ============================================================================= */

/* NSType check a function definition
 * 
 * Validates:
 * 1. Parameters are valid types
 * 2. Function body statements are well-typed
 * 3. All return statements match the declared return type
 * 
 * Returns: true if valid, false if type errors
 */
fn scalar_borrow_shape(parser: Parser, annotation: string) -> bool {
    if (not (str_starts_with annotation "&")) { return false }
    let mut offset: int = 1
    if (str_starts_with annotation "&mut ") { set offset 5 }
    let name: string = (str_substring annotation offset (str_length annotation))
    let mut i: int = 0
    while (< i (parser_get_struct_def_count parser)) {
        let record: ASTStruct = (parser_get_struct_def parser i)
        if (and record.is_resource (== record.name name)) {
            let mut j: int = 0
            while (< j record.field_count) {
                let field: string = (at record.field_types j)
                if (not (or (== field "int") (or (== field "float") (== field "bool")))) { return false }
                set j (+ j 1)
            }
            return true
        }
        set i (+ i 1)
    }
    return false
}
shadow scalar_borrow_shape {
    let parser: Parser = (resource_test_parser "resource struct Owner { fd: int } resource struct Unsupported { name: string }")
    assert (scalar_borrow_shape parser "&Owner")
    assert (scalar_borrow_shape parser "&mut Owner")
    assert (not (scalar_borrow_shape parser "&Unsupported"))
}

fn check_function(parser: Parser, func: ASTFunction, symbols: array<Symbol>, diags: List<CompilerDiagnostic>, file_name: string) -> bool {
    if (or (== func.name "float_from_bits") (== func.name "float_to_bits")) {
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0010" "I reserve binary64 bit intrinsic names." (Diagnostics.diag_location file_name func.line func.column)))
        return false
    }
    let return_type: NSType = (type_from_string_with_parser parser func.return_type)
    
    /* Create a fresh symbol table for this function.
     * All symbols at this point are functions or mutable globals (set up in Phase 1),
     * so no filtering is needed — just use them all. This avoids the O(n^2) rebuild. */
    let mut func_symbols: array<Symbol> = (env_copy_symbols symbols)

    /* Add parameters as symbols (stored as lets starting at func.param_start) */
    let mut i: int = 0
    while (< i func.param_count) {
        let param_let: ASTLet = (parser_get_let parser (+ func.param_start i))
        let mut parameter_type: string = param_let.var_type
        let exclusive: bool = (str_starts_with parameter_type "&mut ")
        if exclusive { set parameter_type (str_substring parameter_type 5 (str_length parameter_type)) }
        else { if (str_starts_with parameter_type "&") { set parameter_type (str_substring parameter_type 1 (str_length parameter_type)) } }
        let ptype: NSType = (type_from_string_with_parser parser parameter_type)
        let psym: Symbol = (symbol_new param_let.name ptype (or param_let.is_mut exclusive) false 0 (empty_param_types) (type_void))
        set func_symbols (env_add_symbol func_symbols psym)
        set i (+ i 1)
    }

    if (< func.body 0) {
        /* extern fn */
        return true
    } else {
        let mut local_symbols: array<Symbol> = func_symbols
        if (== func.return_type "float") {
            let mut param_types: array<NSType> = []
            let mut pidx: int = 0
            while (< pidx func.param_count) {
                let param_let: ASTLet = (parser_get_let parser (+ func.param_start pidx))
                let param_type: NSType = (type_from_string_with_parser parser param_let.var_type)
                set param_types (array_push param_types param_type)
                set pidx (+ pidx 1)
            }
            let float_sym: Symbol = (symbol_new func.name (type_float) false true func.param_count param_types (type_float))
            set local_symbols (env_add_symbol local_symbols float_sym)
        } else { (print "") }
        let previous_function: string = tc_enclosing_function
        let previous_return: string = tc_enclosing_return
        set tc_enclosing_function func.name
        set tc_enclosing_return func.return_type
        let ok: bool = (check_block parser func.body local_symbols return_type diags file_name func.name)
        set tc_enclosing_function previous_function
        set tc_enclosing_return previous_return
        return ok
    }
}

shadow check_function { assert true }

/* =============================================================================
 * TYPE CHECKING WRAPPER - Top-level entry point for type checking a program
 * ============================================================================= */

fn typecheck_output(diagnostics: List<CompilerDiagnostic>, error_count: int, had_error: bool) -> TypecheckPhaseOutput {
    let env: TypeEnvironment = TypeEnvironment {
        error_count: error_count,
        has_error: had_error,
        diagnostics: diagnostics
    }
    return TypecheckPhaseOutput {
        environment: env,
        diagnostics: diagnostics,
        had_error: had_error
    }
}

shadow typecheck_output { assert true }

fn apply_return_type_hint(expr_type: NSType, expected_type: NSType) -> NSType {
    if (== expected_type.kind TypeKind.TYPE_FLOAT) {
        if (or (== expr_type.kind TypeKind.TYPE_FLOAT) (or (== expr_type.kind TypeKind.TYPE_INT) (== expr_type.kind TypeKind.TYPE_UNKNOWN))) {
            return expected_type
        } else { (print "") }
    } else { (print "") }
    if (== expected_type.kind TypeKind.TYPE_ARRAY) {
        if (== expr_type.kind TypeKind.TYPE_ARRAY) {
            if (== expr_type.element_type_kind TypeKind.TYPE_UNKNOWN) {
                return expected_type
            } else { (print "") }
        } else { (print "") }
    } else { (print "") }
    if (== expected_type.kind TypeKind.TYPE_INT) {
        if (or (== expr_type.kind TypeKind.TYPE_INT) (or (== expr_type.kind TypeKind.TYPE_UNKNOWN) (== expr_type.kind TypeKind.TYPE_ENUM))) {
            return expected_type
        } else { (print "") }
    } else { (print "") }
    if (== expected_type.kind TypeKind.TYPE_BOOL) {
        if (or (== expr_type.kind TypeKind.TYPE_BOOL) (== expr_type.kind TypeKind.TYPE_UNKNOWN)) {
            return expected_type
        } else { (print "") }
    } else { (print "") }
    /* Function types: allow if both are function types with matching signatures */
    if (== expected_type.kind TypeKind.TYPE_FUNCTION) {
        if (== expr_type.kind TypeKind.TYPE_FUNCTION) {
            return expected_type
        } else { (print "") }
    } else { (print "") }
    return expr_type
}

# I convert a checked literal destination without converting existing array values.
fn check_contextual_value(parser: Parser, node_id: int, node_type: int, actual: NSType, expected: NSType, symbols: array<Symbol>, diags: List<CompilerDiagnostic>, file_name: string) -> NSType {
    if (and (== (type_to_string expected) "u8") (== actual.kind TypeKind.TYPE_INT)) { return expected }
    if (or (== node_type ParseNodeType.PNODE_IF) (or (== node_type ParseNodeType.PNODE_BLOCK) (== node_type ParseNodeType.PNODE_MATCH))) {
        let mut fact: CheckedBlock = (checked_value actual false false false)
        if (== node_type ParseNodeType.PNODE_IF) { set fact (check_if_value parser node_id symbols expected diags file_name) }
        if (== node_type ParseNodeType.PNODE_MATCH) { set fact (check_match_value parser node_id symbols expected diags file_name) }
        if (== node_type ParseNodeType.PNODE_BLOCK) {
            set fact (check_statement_values parser (parser_get_block parser node_id).statements symbols (type_from_string_with_parser parser tc_enclosing_return) expected true diags file_name tc_enclosing_function)
        }
        # A checked terminal branch supplies no value, but satisfies this unreachable destination.
        # I never infer an empty array or annotate a terminal expression from that fact.
        if (and fact.terminates fact.ok) { return expected }
        if (and fact.ok (types_equal fact.value_type expected)) { return fact.value_type }
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0001" "I require every value-producing branch to match its destination." (Diagnostics.diag_location file_name 0 0)))
        return (type_unknown_named "invalid branches")
    }
    if (and (== expected.kind TypeKind.TYPE_TUPLE) (== node_type ParseNodeType.PNODE_TUPLE_LITERAL)) {
        let literal: ASTTupleLiteral = (parser_get_tuple_literal parser node_id)
        let elements: array<string> = (split_tuple_type_names expected.name)
        let before: int = (list_CompilerDiagnostic_length diags)
        let mut valid: bool = (and (reduce_type_known parser expected) (== literal.element_count (array_length elements)))
        let mut i: int = 0
        while (< i literal.element_count) {
            let id: int = (at literal.element_ids i)
            let kind: int = (at literal.element_types i)
            let raw: NSType = (check_expr_node parser id kind symbols diags file_name)
            if (< i (array_length elements)) {
                let destination: NSType = (type_from_string_with_parser parser (at elements i))
                let checked: NSType = (check_constructor_argument parser id kind raw destination symbols diags file_name)
                if (not (and (reduce_type_known parser checked) (types_equal checked destination))) { set valid false }
            }
            set i (+ i 1)
        }
        if (checked_value_errors diags before) { set valid false }
        if valid { return expected }
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0001" "I require every tuple literal member to match its destination." (Diagnostics.diag_location file_name 0 0)))
        return actual
    }
    if (== expected.kind TypeKind.TYPE_ARRAY) {
        if (== node_type ParseNodeType.PNODE_ARRAY_LITERAL) {
            let literal: ASTArrayLiteral = (parser_get_array_literal parser node_id)
            let element_type: NSType = (array_element_fact parser expected)
            let before: int = (list_CompilerDiagnostic_length diags)
            let mut valid: bool = (reduce_type_known parser element_type)
            let mut i: int = 0
            while (< i literal.element_count) {
                let member: ASTStmtRef = (parser_get_array_element parser (+ literal.element_start i))
                let raw: NSType = (check_expr_node parser member.node_id member.node_type symbols diags file_name)
                let checked: NSType = (check_constructor_argument parser member.node_id member.node_type raw element_type symbols diags file_name)
                if (not (and (reduce_type_known parser checked) (types_equal checked element_type))) { set valid false }
                set i (+ i 1)
            }
            if (checked_value_errors diags before) { set valid false }
            if valid {
                (parser_set_array_literal_element_type parser node_id (type_to_string element_type))
                return expected
            }
            (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0001" "I require every array literal member to match its complete destination type." (Diagnostics.diag_location file_name literal.line literal.column)))
        } else {
            if (reduce_types_exact parser actual expected) { return actual }
            (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0001" "I retain the complete declared element identity of an existing array." (Diagnostics.diag_location file_name 0 0)))
        }
        return actual
    }
    if (== node_type ParseNodeType.PNODE_ARRAY_LITERAL) {
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0001" "I require an array destination for an array literal." (Diagnostics.diag_location file_name 0 0)))
        return (type_unknown_named "array at scalar destination")
    }
    return (apply_value_type_hint parser node_id node_type actual expected)
}

shadow check_contextual_value {
    let parser: Parser = (resource_test_parser "fn main() -> int { let good: array<u8> = [257, -1] let wrong: array<u8> = [1, true] let existing: array<u8> = source return 0 }")
    let expected: NSType = (type_from_string "array<u8>")
    let integers: NSType = (type_from_string "array<int>")
    let symbols: array<Symbol> = [(symbol_new "source" integers false false 0 (empty_param_types) (type_void))]
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let good: ASTLet = (parser_get_let parser 0)
    assert (types_equal (check_contextual_value parser good.value good.value_type integers expected symbols diags "byte.nano") expected)
    assert (== (parser_get_array_literal parser good.value).element_type "u8")
    assert (== (list_CompilerDiagnostic_length diags) 0)
    let wrong: ASTLet = (parser_get_let parser 1)
    let before: string = (parser_get_array_literal parser wrong.value).element_type
    (check_contextual_value parser wrong.value wrong.value_type (type_unknown_named "mixed") expected symbols diags "byte.nano")
    assert (== (list_CompilerDiagnostic_length diags) 1)
    assert (== (parser_get_array_literal parser wrong.value).element_type before)
    let scalar: NSType = (type_from_string "u8")
    assert (types_equal (check_contextual_value parser 0 ParseNodeType.PNODE_IDENTIFIER (type_int) scalar symbols diags "byte.nano") scalar)
    assert (not (types_equal (check_contextual_value parser 0 ParseNodeType.PNODE_IDENTIFIER (type_float) scalar symbols diags "byte.nano") scalar))
    let existing: ASTLet = (parser_get_let parser 2)
    assert (not (types_equal (check_contextual_value parser existing.value existing.value_type integers expected symbols diags "byte.nano") expected))
}

shadow check_contextual_value {
    let parser: Parser = (resource_test_parser "struct Left { value: int } struct Right { value: int } fn f() -> void { let good = [[], [Left { value: 1 }]] let bad = [[], foreign] let mixed = [[1], [true]] let unknown = missing }")
    assert (not (parser_has_error parser))
    let expected: NSType = (type_from_string "array<array<Left>>")
    let symbols: array<Symbol> = [(symbol_new "foreign" (type_from_string "array<Right>") false false 0 (empty_param_types) (type_void)), (symbol_new "missing" (type_array TypeKind.TYPE_UNKNOWN "") false false 0 (empty_param_types) (type_void))]
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let good: ASTLet = (parser_get_let parser 0)
    let raw: NSType = (check_expr_node parser good.value good.value_type symbols diags "nested.nano")
    assert (== (type_to_string raw) "array<array<Left>>")
    assert (reduce_types_exact parser (check_contextual_value parser good.value good.value_type raw expected symbols diags "nested.nano") expected)
    assert (not (checked_value_errors diags 0))
    let bad: ASTLet = (parser_get_let parser 1)
    let before: string = (parser_get_array_literal parser bad.value).element_type
    let foreign_raw: NSType = (check_expr_node parser bad.value bad.value_type symbols diags "nested.nano")
    assert (== (type_to_string foreign_raw) "array<array<Right>>")
    let rejected: NSType = (check_contextual_value parser bad.value bad.value_type foreign_raw expected symbols diags "nested.nano")
    assert (== (type_to_string rejected) "array<array<Right>>")
    assert (checked_value_errors diags 0)
    assert (== (parser_get_array_literal parser bad.value).element_type before)
    let unknown: ASTLet = (parser_get_let parser 3)
    let start: int = (list_CompilerDiagnostic_length diags)
    (check_contextual_value parser unknown.value unknown.value_type (type_array TypeKind.TYPE_UNKNOWN "") (type_from_string "array<int>") symbols diags "nested.nano")
    assert (checked_value_errors diags start)
}

fn apply_value_type_hint(parser: Parser, node_id: int, node_type: int, expr_type: NSType, expected_type: NSType) -> NSType {
    if (and (== (type_to_string expected_type) "u8") (and (== expr_type.kind TypeKind.TYPE_INT) (== node_type ParseNodeType.PNODE_NUMBER))) {
        let literal: int = (string_to_int (parser_get_number parser node_id).value)
        if (and (>= literal 0) (<= literal 255)) { return expected_type }
    }
    return expr_type
}

shadow apply_value_type_hint {
    let parser: Parser = (resource_test_parser "fn main() -> int { let octet: u8 = 255 let too_large: u8 = 256 let computed: u8 = (+ 1 2) return 0 }")
    let octet: ASTLet = (parser_get_let parser 0)
    let too_large: ASTLet = (parser_get_let parser 1)
    let computed: ASTLet = (parser_get_let parser 2)
    assert (== (type_to_string (apply_value_type_hint parser octet.value octet.value_type (type_int) (type_from_string "u8"))) "u8")
    assert (== (apply_value_type_hint parser too_large.value too_large.value_type (type_int) (type_from_string "u8")).kind TypeKind.TYPE_INT)
    assert (== (apply_value_type_hint parser computed.value computed.value_type (type_int) (type_from_string "u8")).kind TypeKind.TYPE_INT)
}

shadow apply_return_type_hint {
    let int_t: NSType = (type_int)
    let float_t: NSType = (type_float)
    let result: NSType = (apply_return_type_hint int_t float_t)
    assert (== result.kind TypeKind.TYPE_FLOAT)
    let same: NSType = (apply_return_type_hint int_t int_t)
    assert (== same.kind TypeKind.TYPE_INT)
    let integers: NSType = (type_array TypeKind.TYPE_INT "")
    let strings: NSType = (type_array TypeKind.TYPE_STRING "")
    let retained: NSType = (apply_return_type_hint integers strings)
    assert (== retained.element_type_kind TypeKind.TYPE_INT)
    let inferred: NSType = (apply_return_type_hint (type_array TypeKind.TYPE_UNKNOWN "") strings)
    assert (== inferred.element_type_kind TypeKind.TYPE_STRING)
}

/* Typecheck a parsed program with full AST walking */
pub fn typecheck_phase(parser: Parser, file_name: string) -> TypecheckPhaseOutput {
    let empty_symbols: array<Symbol> = []
    return (typecheck_phase_with_symbols parser file_name empty_symbols)
}

shadow typecheck_phase { assert true }

/* NSType check with initial symbol table (for transitive imports) */
pub fn typecheck_phase_with_symbols(parser: Parser, file_name: string, initial_symbols: array<Symbol>) -> TypecheckPhaseOutput {
    return (typecheck_phase_with_shadows parser file_name initial_symbols parser.shadows_count)
}

# I close summaries over reachable bodies; annotations never substitute for bodies.
# Bits: I/O 1, mutable read 2, mutation 4, unknown 8, unsafe 16, resource 32.
struct PurityContext {
    names: array<string>,
    mutable: array<bool>,
    seen: array<bool>,
    globals: array<Symbol>
}

fn purity_join(a: int, b: int) -> int {
    let mut bit: int = 1
    let mut result: int = 0
    while (<= bit 32) {
        if (or (== (% (/ a bit) 2) 1) (== (% (/ b bit) 2) 1)) { set result (+ result bit) }
        set bit (* bit 2)
    }
    return result
}
shadow purity_join {
    assert (== (purity_join 3 6) 7)
    assert (== (purity_join 32 32) 32)
    assert (== (purity_join 0 24) 24)
}

fn purity_local(context: PurityContext, name: string, count: int) -> int {
    let mut i: int = (- count 1)
    while (>= i 0) {
        if (== (at context.names i) name) { return i }
        set i (- i 1)
    }
    return -1
}
shadow purity_local {
    let c: PurityContext = PurityContext { names: ["x", "x"], mutable: [false, true], seen: [], globals: [] }
    assert (== (purity_local c "x" 2) 1)
    assert (== (purity_local c "x" 1) 0)
    assert (== (purity_local c "y" 2) -1)
}

fn purity_add(context: PurityContext, name: string, mutable: bool, count: int) -> void {
    let names: array<string> = context.names
    let flags: array<bool> = context.mutable
    (array_set names count name)
    (array_set flags count mutable)
}
shadow purity_add {
    let c: PurityContext = PurityContext { names: [""], mutable: [false], seen: [], globals: [] }
    (purity_add c "first" false 0)
    (purity_add c "second" true 0)
    assert (== (array_length c.names) 1)
    assert (== (at c.names 0) "second")
    assert (at c.mutable 0)
}

fn purity_type(parser: Parser, name: string) -> int {
    # I inspect nested generic and tuple names as well as their outer spelling.
    let mut word: string = ""
    let mut i: int = 0
    while (<= i (str_length name)) {
        let mut c: int = 32
        if (< i (str_length name)) { set c (char_at name i) }
        if (or (or (is_alnum c) (== c 95)) (== c 46)) {
            set word (+ word (string_from_char c))
        } else {
            if (or (== word "opaque") (resource_type_is_declared parser word)) { return 32 }
            set word ""
        }
        set i (+ i 1)
    }
    return 0
}
shadow purity_type {
    let p: Parser = (parser_new (list_LexerToken_new) 0 "purity.nano")
    assert (== (purity_type p "array<opaque>") 32)
    assert (== (purity_type p "array<int>") 0)
}

# I do not infer deep immutability from an immutable aggregate handle.
fn purity_input_value(parser: Parser, name: string, line: int, depth: int) -> bool {
    if (> depth 32) { return false }
    if (or (or (== name "int") (== name "u8")) (or (== name "float") (== name "bool"))) { return true }
    if (or (== name "string") (== name "void")) { return true }
    let identity: string = (resource_type_identity parser name line)
    let mut i: int = 0
    while (< i parser.structs_count) {
        let record: ASTStruct = (parser_get_struct_def parser i)
        if (== (resource_type_identity parser record.name record.line) identity) {
            if record.is_resource { return false }
            let mut field: int = 0
            while (< field (array_length record.field_types)) {
                if (not (purity_input_value parser (at record.field_types field) record.line (+ depth 1))) { return false }
                set field (+ field 1)
            }
            return true
        }
        set i (+ i 1)
    }
    set i 0
    while (< i parser.enums_count) {
        if (== (list_ASTEnum_get parser.enums i).name name) { return true }
        set i (+ i 1)
    }
    return false
}
shadow purity_input_value {
    let p: Parser = (resource_test_parser "struct Point { x: int } struct Box { values: array<int> } struct Outer { inner: Box }")
    assert (purity_input_value p "Point" 1 0)
    assert (not (purity_input_value p "array<int>" 1 0))
    assert (not (purity_input_value p "Outer" 1 0))
    assert (not (purity_input_value p "HashMap<string,int>" 1 0))
}

fn purity_identifier(parser: Parser, context: PurityContext, name: string, count: int) -> int {
    let local: int = (purity_local context name count)
    if (>= local 0) {
        if (at context.mutable local) { return 2 }
        return 0
    }
    let mut result: int = 0
    let mut found: bool = false
    let mut i: int = 0
    while (< i (array_length context.globals)) {
        let sym: Symbol = (at context.globals i)
        if (and (== sym.name name) (not sym.is_function)) {
            set found true
            if (or sym.is_mutable (not (purity_input_value parser (type_to_string sym.sym_type) 0 0))) { set result (purity_join result 2) }
            set result (purity_join result (purity_type parser (type_to_string sym.sym_type)))
        }
        set i (+ i 1)
    }
    if found { return result }
    set i 0
    while (< i parser.enums_count) {
        if (== (list_ASTEnum_get parser.enums i).name name) { return 0 }
        set i (+ i 1)
    }
    # Taking a resolved declaration's function value is effect-free. Calling a
    # function-typed local stays unknown in purity_call until its type proves it.
    set i 0
    while (< i parser.functions_count) {
        if (== (parser_get_function parser i).name name) { return 0 }
        set i (+ i 1)
    }
    return 8
}
shadow purity_identifier {
    let p: Parser = (parser_new (list_LexerToken_new) 0 "purity.nano")
    let c: PurityContext = PurityContext { names: ["x"], mutable: [true], seen: [], globals: [] }
    assert (== (purity_identifier p c "x" 1) 2)
    assert (== (purity_identifier p c "absent" 1) 8)
    let diagnostics: List<CompilerDiagnostic> = (Diagnostics.diag_list_new)
    let tokens: List<LexerToken> = (tokenize_string "fn helper(x: int) -> int { return x }" "purity.nano" diagnostics)
    let parsed: Parser = (parse_program tokens (list_LexerToken_length tokens) "purity.nano")
    assert (== (purity_identifier parsed c "helper" 0) 0)
}

fn purity_call(parser: Parser, context: PurityContext, name: string, count: int) -> int {
    if (or (== name "") (>= (purity_local context name count) 0)) { return 8 }
    let mut i: int = 0
    while (< i parser.functions_count) {
        let f: ASTFunction = (parser_get_function parser i)
        if (== f.name name) {
            if (< f.body 0) { return 8 }
            return (purity_function parser context i)
        }
        set i (+ i 1)
    }
    if (purity_intrinsic name) { return 0 }
    if (purity_observable name) { return 1 }
    return 8
}
shadow purity_call {
    let p: Parser = (parser_new (list_LexerToken_new) 0 "purity.nano")
    let c: PurityContext = PurityContext { names: ["abs"], mutable: [false], seen: [], globals: [] }
    assert (== (purity_call p c "abs" 0) 0)
    assert (== (purity_call p c "abs" 1) 8)
    assert (== (purity_call p c "println" 0) 1)
}

fn purity_node(parser: Parser, id: int, kind: int, context: PurityContext, count: int) -> int {
    if (< id 0) { return 0 }
    if (or (or (== kind ParseNodeType.PNODE_NUMBER) (== kind ParseNodeType.PNODE_FLOAT)) (or (== kind ParseNodeType.PNODE_STRING) (== kind ParseNodeType.PNODE_BOOL))) { return 0 }
    if (== kind ParseNodeType.PNODE_IDENTIFIER) { return (purity_identifier parser context (parser_get_identifier parser id).name count) }
    if (== kind ParseNodeType.PNODE_BINARY_OP) {
        let n: ASTBinaryOp = (parser_get_binary_op parser id)
        return (purity_join (purity_node parser n.left n.left_type context count) (purity_node parser n.right n.right_type context count))
    }
    if (or (== kind ParseNodeType.PNODE_CALL) (== kind ParseNodeType.PNODE_MODULE_QUALIFIED_CALL)) {
        let mut name: string = ""
        let mut start: int = 0
        let mut length: int = 0
        if (== kind ParseNodeType.PNODE_CALL) {
            let n: ASTCall = (parser_get_call parser id)
            set start n.arg_start
            set length n.arg_count
            if (== n.function_type ParseNodeType.PNODE_IDENTIFIER) {
                let ident: ASTIdentifier = (parser_get_identifier parser n.function)
                if (< (purity_local context ident.name count) 0) { set name (mb_lookup (mb_owner ident.line) ident.name) }
            }
        } else {
            let n: ASTModuleQualifiedCall = (parser_get_module_qualified_call parser id)
            set name (mb_lookup (mb_owner n.line) n.function_name)
            set start n.arg_start
            set length n.arg_count
        }
        let mut result: int = (purity_call parser context name count)
        let mut i: int = 0
        while (< i length) {
            let arg: ASTStmtRef = (parser_get_call_arg parser (+ start i))
            set result (purity_join result (purity_node parser arg.node_id arg.node_type context count))
            set i (+ i 1)
        }
        return result
    }
    if (== kind ParseNodeType.PNODE_BLOCK) {
        let block: ASTBlock = (parser_get_block parser id)
        let mut local_count: int = count
        let mut result: int = 0
        let mut i: int = 0
        while (< i (list_ASTStmtRef_length block.statements)) {
            let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements i)
            set result (purity_join result (purity_node parser stmt.node_id stmt.node_type context local_count))
            if (== stmt.node_type ParseNodeType.PNODE_LET) {
                let n: ASTLet = (parser_get_let parser stmt.node_id)
                (purity_add context n.name n.is_mut local_count)
                set local_count (+ local_count 1)
            }
            set i (+ i 1)
        }
        return result
    }
    if (== kind ParseNodeType.PNODE_LET) {
        let n: ASTLet = (parser_get_let parser id)
        let mut result: int = (purity_join (purity_type parser n.var_type) (purity_node parser n.value n.value_type context count))
        if n.is_mut { set result (purity_join result 4) }
        if n.is_destructure { set result (purity_join result 8) }
        return result
    }
    if (== kind ParseNodeType.PNODE_SET) {
        let n: ASTSet = (parser_get_set parser id)
        return (purity_join 4 (purity_node parser n.value n.value_type context count))
    }
    if (== kind ParseNodeType.PNODE_IF) {
        let n: ASTIf = (parser_get_if parser id)
        return (purity_join (purity_node parser n.condition n.condition_type context count) (purity_join (purity_node parser n.then_body ParseNodeType.PNODE_BLOCK context count) (purity_node parser n.else_body ParseNodeType.PNODE_BLOCK context count)))
    }
    if (== kind ParseNodeType.PNODE_MATCH) {
        let n: ASTMatch = (parser_get_match parser id)
        let mut result: int = (purity_node parser n.scrutinee n.scrutinee_type context count)
        let mut i: int = 0
        while (< i n.arm_count) {
            let mut body_count: int = count
            if (< i (array_length n.arm_bindings)) {
                let binding: string = (at n.arm_bindings i)
                if (and (!= binding "") (!= binding "_")) {
                    (purity_add context binding false body_count)
                    set body_count (+ body_count 1)
                }
            }
            let guard_id: int = (at n.arm_guard_ids i)
            if (>= guard_id 0) { set result (purity_join result (purity_node parser guard_id (at n.arm_guard_types i) context body_count)) }
            set result (purity_join result (purity_node parser (at n.arm_body_ids i) (at n.arm_body_types i) context body_count))
            set i (+ i 1)
        }
        return result
    }
    if (== kind ParseNodeType.PNODE_RETURN) {
        let n: ASTReturn = (parser_get_return parser id)
        return (purity_node parser n.value n.value_type context count)
    }
    if (== kind ParseNodeType.PNODE_PRINT) {
        let n: ASTPrint = (list_ASTPrint_get parser.prints id)
        return (purity_join 1 (purity_node parser n.value n.value_type context count))
    }
    if (== kind ParseNodeType.PNODE_ASSERT) {
        let n: ASTAssert = (parser_get_assert parser id)
        return (purity_node parser n.condition n.condition_type context count)
    }
    if (== kind ParseNodeType.PNODE_FIELD_ACCESS) {
        let n: ASTFieldAccess = (parser_get_field_access parser id)
        return (purity_node parser n.object n.object_type context count)
    }
    if (== kind ParseNodeType.PNODE_ARRAY_LITERAL) {
        let n: ASTArrayLiteral = (parser_get_array_literal parser id)
        let mut result: int = (purity_type parser n.element_type)
        let mut i: int = 0
        while (< i n.element_count) {
            let item: ASTStmtRef = (parser_get_array_element parser (+ n.element_start i))
            set result (purity_join result (purity_node parser item.node_id item.node_type context count))
            set i (+ i 1)
        }
        return result
    }
    if (== kind ParseNodeType.PNODE_STRUCT_LITERAL) {
        let n: ASTStructLiteral = (parser_get_struct_literal parser id)
        let mut result: int = (purity_type parser n.struct_name)
        let mut i: int = 0
        while (< i n.field_count) {
            set result (purity_join result (purity_node parser (at n.field_value_ids i) (at n.field_value_types i) context count))
            set i (+ i 1)
        }
        return result
    }
    if (== kind ParseNodeType.PNODE_TUPLE_LITERAL) {
        let n: ASTTupleLiteral = (parser_get_tuple_literal parser id)
        let mut result: int = 0
        let mut i: int = 0
        while (< i n.element_count) {
            set result (purity_join result (purity_node parser (at n.element_ids i) (at n.element_types i) context count))
            set i (+ i 1)
        }
        return result
    }
    if (== kind ParseNodeType.PNODE_TUPLE_INDEX) {
        let n: ASTTupleIndex = (parser_get_tuple_index parser id)
        return (purity_node parser n.tuple n.tuple_type context count)
    }
    if (== kind ParseNodeType.PNODE_UNSAFE_BLOCK) { return 24 }
    return 8
}
shadow purity_node {
    let p: Parser = (parser_new (list_LexerToken_new) 0 "purity.nano")
    let c: PurityContext = PurityContext { names: [], mutable: [], seen: [], globals: [] }
    assert (== (purity_node p -1 ParseNodeType.PNODE_BLOCK c 0) 0)
    assert (== (purity_node p 0 ParseNodeType.PNODE_UNSAFE_BLOCK c 0) 24)
    assert (== (purity_node p 0 ParseNodeType.PNODE_WHILE c 0) 8)
    let diagnostics: List<CompilerDiagnostic> = (Diagnostics.diag_list_new)
    let tokens: List<LexerToken> = (tokenize_string "union Choice { Number { value: int }, Empty {} } fn f(choice: Choice) -> int { return match choice { Number(n) => n.value Empty(_e) => 0 } }" "purity.nano" diagnostics)
    let parsed: Parser = (parse_program tokens (list_LexerToken_length tokens) "purity.nano")
    let match_context: PurityContext = PurityContext { names: ["choice", ""], mutable: [false, false], seen: [false], globals: [] }
    assert (== (purity_node parsed 0 ParseNodeType.PNODE_MATCH match_context 1) 0)
    let guarded: Parser = (resource_test_parser "union Choice { Number { value: int }, Empty {} } fn f(choice: Choice, flag: bool) -> int { return match choice { Number(n) if flag => n.value Number(n) => 0 Empty(e) => 0 } } fn g(choice: Choice) -> int { return match choice { Number(n) if (== n.value 1) => n.value Number(n) => 0 Empty(e) => 0 } }")
    let context: PurityContext = PurityContext { names: ["choice", "flag", ""], mutable: [false, true, false], seen: [false, false], globals: [] }
    assert (== (purity_node guarded 0 ParseNodeType.PNODE_MATCH context 2) 2)
    assert (== (purity_node guarded 1 ParseNodeType.PNODE_MATCH context 2) 0)
}

fn purity_function(parser: Parser, parent: PurityContext, index: int) -> int {
    let f: ASTFunction = (parser_get_function parser index)
    if (< f.body 0) { return 8 }
    if (at parent.seen index) { return 0 }
    let visited: array<bool> = parent.seen
    (array_set visited index true)
    let mut names: array<string> = []
    let mut flags: array<bool> = []
    let mut capacity: int = parser.lets_count
    let mut match_index: int = 0
    while (< match_index (parser_get_match_count parser)) {
        let matched: ASTMatch = (parser_get_match parser match_index)
        set capacity (+ capacity matched.arm_count)
        set match_index (+ match_index 1)
    }
    let mut slot: int = 0
    while (< slot capacity) {
        set names (array_push names "")
        set flags (array_push flags false)
        set slot (+ slot 1)
    }
    let context: PurityContext = PurityContext { names: names, mutable: flags, seen: parent.seen, globals: parent.globals }
    let mut result: int = (purity_type parser f.return_type)
    let mut i: int = 0
    while (< i f.param_count) {
        let param: ASTLet = (parser_get_let parser (+ f.param_start i))
        set result (purity_join result (purity_type parser param.var_type))
        if (not (purity_input_value parser param.var_type f.line 0)) { set result (purity_join result 2) }
        (purity_add context param.name false i)
        set i (+ i 1)
    }
    return (purity_join result (purity_node parser f.body ParseNodeType.PNODE_BLOCK context f.param_count))
}
shadow purity_function {
    let diagnostics: List<CompilerDiagnostic> = (Diagnostics.diag_list_new)
    let tokens: List<LexerToken> = (tokenize_string "fn f(x: int) -> int { return (+ x 1) }" "purity.nano" diagnostics)
    let p: Parser = (parse_program tokens (list_LexerToken_length tokens) "purity.nano")
    let c: PurityContext = PurityContext { names: [], mutable: [], seen: [false], globals: [] }
    assert (== (purity_function p c 0) 0)
    assert (at c.seen 0)
}

fn purity_summary(parser: Parser, index: int, globals: array<Symbol>) -> int {
    let mut seen: array<bool> = []
    let mut i: int = 0
    while (< i parser.functions_count) { set seen (array_push seen false) set i (+ i 1) }
    let context: PurityContext = PurityContext { names: [], mutable: [], seen: seen, globals: globals }
    return (purity_function parser context index)
}
shadow purity_summary {
    let diagnostics: List<CompilerDiagnostic> = (Diagnostics.diag_list_new)
    let tokens: List<LexerToken> = (tokenize_string "fn f() -> int { return (g) } fn g() -> int { (println 1) return (f) }" "purity.nano" diagnostics)
    let p: Parser = (parse_program tokens (list_LexerToken_length tokens) "purity.nano")
    assert (== (purity_summary p 0 []) 1)
}

pub fn typecheck_phase_with_shadows(parser: Parser, file_name: string, initial_symbols: array<Symbol>, first_shadow: int) -> TypecheckPhaseOutput {
    let env: TypeEnvironment = (env_new)
    let mut symbols: array<Symbol> = (env_copy_symbols initial_symbols)
    let mut error_count: int = 0

    /* Get function count using accessor */
    let func_count: int = (parser_get_function_count parser)

    # I refuse parser-only annotations before building signatures or publishing output.
    let mut borrow_fn: int = 0
    while (< borrow_fn func_count) {
        let item: ASTFunction = (parser_get_function parser borrow_fn)
        let mut argument: int = 0
        while (< argument item.param_count) {
            let parameter: ASTLet = (parser_get_let parser (+ item.param_start argument))
            if (str_starts_with parameter.var_type "&") {
                if (or (< item.body 0) (not (scalar_borrow_shape parser parameter.var_type))) {
                    (Diagnostics.diag_list_add env.diagnostics (Diagnostics.diag_typecheck_error "E0036" "I currently borrow only checked fixed resource records with numeric or boolean fields" (Diagnostics.diag_location file_name parameter.line parameter.column)))
                    return (typecheck_output env.diagnostics 1 true)
                }
            }
            set argument (+ argument 1)
        }
        set borrow_fn (+ borrow_fn 1)
    }

    /* Validate we have at least one function */
    if (<= func_count 0) {
        (println "Error: No functions found")
        let diag: CompilerDiagnostic = (Diagnostics.diag_error CompilerPhase.PHASE_TYPECHECK "TC0001" "No functions found" (Diagnostics.diag_location file_name 0 0))
        (Diagnostics.diag_list_add env.diagnostics diag)
        return (typecheck_output env.diagnostics (+ error_count 1) true)
    } else {
        (print "")
    }
    
    /* Add built-in functions to symbol table */
    let println_sym: Symbol = (symbol_new "println" (type_void) false true (- 0 1) (empty_param_types) (type_void))
    set symbols (env_add_symbol symbols println_sym)
    let print_sym: Symbol = (symbol_new "print" (type_void) false true (- 0 1) (empty_param_types) (type_void))
    set symbols (env_add_symbol symbols print_sym)

    /* Minimal builtins used by nanoc_v06 */
    let system_sym: Symbol = (symbol_new "system" (type_int) false true (- 0 1) (empty_param_types) (type_int))
    set symbols (env_add_symbol symbols system_sym)
    let str_concat_sym: Symbol = (symbol_new "str_concat" (type_string) false true (- 0 1) (empty_param_types) (type_string))
    set symbols (env_add_symbol symbols str_concat_sym)
    let str_equals_sym: Symbol = (symbol_new "str_equals" (type_bool) false true (- 0 1) (empty_param_types) (type_bool))
    set symbols (env_add_symbol symbols str_equals_sym)
    let not_sym: Symbol = (symbol_new "not" (type_bool) false true (- 0 1) (empty_param_types) (type_bool))
    set symbols (env_add_symbol symbols not_sym)
    let and_sym: Symbol = (symbol_new "and" (type_bool) false true (- 0 1) (empty_param_types) (type_bool))
    set symbols (env_add_symbol symbols and_sym)
    let or_sym: Symbol = (symbol_new "or" (type_bool) false true (- 0 1) (empty_param_types) (type_bool))
    set symbols (env_add_symbol symbols or_sym)

    /* Bootstrap: Add known top-level global variables from transpiler.nano */
    let module_aliases_sym: Symbol = (symbol_new "module_aliases" (type_array TypeKind.TYPE_STRING "string") true false 0 (empty_param_types) (type_void))
    set symbols (env_add_symbol symbols module_aliases_sym)
    let module_alias_targets_sym: Symbol = (symbol_new "module_alias_targets" (type_array TypeKind.TYPE_STRING "string") true false 0 (empty_param_types) (type_void))
    set symbols (env_add_symbol symbols module_alias_targets_sym)
    let func_aliases_sym: Symbol = (symbol_new "func_aliases" (type_array TypeKind.TYPE_STRING "string") true false 0 (empty_param_types) (type_void))
    set symbols (env_add_symbol symbols func_aliases_sym)
    let func_alias_targets_sym: Symbol = (symbol_new "func_alias_targets" (type_array TypeKind.TYPE_STRING "string") true false 0 (empty_param_types) (type_void))
    set symbols (env_add_symbol symbols func_alias_targets_sym)

    /* Phase 0.5: Add global let constants to symbol table */
    let global_let_count: int = (parser_get_let_count parser)
    let local_lets: array<bool> = (typecheck_local_lets parser)
    let mut gli: int = 0
    while (< gli global_let_count) {
        let gl: ASTLet = (parser_get_let parser gli)
        if (not (at local_lets gli)) {
            (resource_check_global parser gl env.diagnostics file_name)
            let gl_type: NSType = (type_from_string_with_parser parser gl.var_type)
            if (!= gl_type.kind TypeKind.TYPE_UNKNOWN) {
                let gl_sym: Symbol = (symbol_new gl.name gl_type gl.is_mut false 0 (empty_param_types) (type_void))
                set symbols (env_add_symbol symbols gl_sym)
            } else { (print "") }
        } else { (print "") }
        set gli (+ gli 1)
    }

    /* Phase 1: Add all user function signatures to symbol table */
    let mut i: int = 0
    while (< i func_count) {
        let func: ASTFunction = (parser_get_function parser i)
        let return_type: NSType = (type_from_string_with_parser parser func.return_type)
        let mut param_types: array<NSType> = []
        if (and (> func.param_count 0) (>= func.param_start 0)) {
            let mut pidx: int = 0
            while (< pidx func.param_count) {
                let param_let: ASTLet = (parser_get_let parser (+ func.param_start pidx))
                let param_type: NSType = (type_from_string_with_parser parser param_let.var_type)
                set param_types (array_push param_types param_type)
                set pidx (+ pidx 1)
            }
        } else {
            (print "")
        }

        let func_sym: Symbol = (symbol_new func.name return_type false true func.param_count param_types return_type)
        set symbols (env_add_symbol symbols func_sym)
        set i (+ i 1)
    }
    
    /* Phase 2: NSType check each function body */
    set i 0
    while (< i func_count) {
        let func: ASTFunction = (parser_get_function parser i)
        let valid: bool = (check_function parser func symbols env.diagnostics file_name)
        (resource_check_function parser func env.diagnostics file_name)
        if (and func.is_pure (>= func.body 0)) {
            if (!= (purity_summary parser i symbols) 0) {
                (Diagnostics.diag_list_add env.diagnostics (Diagnostics.diag_typecheck_error "E002" "I cannot prove a closed empty effect summary for this pure fn" (Diagnostics.diag_location file_name func.line func.column)))
                set error_count (+ error_count 1)
            }
        }
        if (not valid) {
            set error_count (+ error_count 1)
        } else {
            (print "")
        }
        set i (+ i 1)
    }

    if (or (< first_shadow 0) (> first_shadow parser.shadows_count)) {
        (Diagnostics.diag_list_add env.diagnostics (Diagnostics.diag_typecheck_error "SH0001" "I cannot select this shadow range" (Diagnostics.diag_location file_name 0 0)))
        return (typecheck_output env.diagnostics (+ error_count 1) true)
    }
    set i first_shadow
    while (< i parser.shadows_count) {
        let sh: ASTShadow = (list_ASTShadow_get parser.shadows i)
        let mut target: int = -1
        let mut fi: int = 0
        while (< fi func_count) {
            let func: ASTFunction = (parser_get_function parser fi)
            if (== func.name sh.target_name) { set target fi }
            set fi (+ fi 1)
        }
        if (< target 0) {
            (Diagnostics.diag_list_add env.diagnostics (Diagnostics.diag_typecheck_error "SH0002" (+ "I cannot find the shadow target: " sh.target_name) (Diagnostics.diag_location file_name sh.line sh.column)))
            set error_count (+ error_count 1)
        } else {
            let func: ASTFunction = (parser_get_function parser target)
            if (< func.body 0) {
                (Diagnostics.diag_list_add env.diagnostics (Diagnostics.diag_typecheck_error "SH0003" "I require a non-extern shadow target" (Diagnostics.diag_location file_name sh.line sh.column)))
                set error_count (+ error_count 1)
            } else {
                let synthetic: ASTFunction = ASTFunction { node_type: ParseNodeType.PNODE_FUNCTION, line: sh.line, column: sh.column, name: (+ "shadow " sh.target_name), param_start: 0, param_count: 0, return_type: "void", body: sh.body, is_pure: false }
                if (not (check_function parser synthetic symbols env.diagnostics file_name)) { set error_count (+ error_count 1) }
            }
        }
        set i (+ i 1)
    }
    let had_error: bool = (or (> error_count 0) (Diagnostics.diag_list_has_errors env.diagnostics))
    return (typecheck_output env.diagnostics error_count had_error)
}

shadow typecheck_phase_with_symbols { assert true }

shadow typecheck_phase_with_shadows {
    let tokens: List<LexerToken> = (tokenize_string "fn f() -> int { return 1 } shadow f { assert 7 }" "shadow.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program tokens (list_LexerToken_length tokens) "shadow.nano")
    let symbols: array<Symbol> = []
    assert (typecheck_phase_with_shadows p "shadow.nano" symbols 0).had_error
}

/* Compatibility wrapper returning legacy status code */
pub fn typecheck_parser(parser: Parser) -> int {
    let output: TypecheckPhaseOutput = (typecheck_phase parser "")
    if output.had_error {
        (println "Diagnostics:")
        let count: int = (Diagnostics.diag_list_count output.diagnostics)
        let mut i: int = 0
        while (< i count) {
            let diag: CompilerDiagnostic = (Diagnostics.diag_list_get output.diagnostics i)
            (print "  [")
            (print diag.code)
            (print "] ")
            (print diag.message)
            (print " (")
            (print diag.location.file)
            (print ":")
            (print (int_to_string diag.location.line))
            (print ":")
            (print (int_to_string diag.location.column))
            (println ")")
            set i (+ i 1)
        }
        return 1
    } else {
        return 0
    }
}

shadow typecheck_parser { assert true }

/* Simplified typecheck for count-based validation */
fn typecheck_with_count(func_count: int) -> int {
    (println "=== NSType Checking (Count-based) ===")
    (print "Validating ")
    (print (int_to_string func_count))
    (println " functions")
    
    if (<= func_count 0) {
        (println "Error: No functions found")
        return 1
    } else {
        (println "NSType checking complete!")
        return 0
    }
}

shadow typecheck_with_count {
    assert (== (typecheck_with_count 5) 0)
    assert (== (typecheck_with_count 0) 1)
}

/* Wrapper for integration (no parser argument) */
fn typecheck() -> int {
    /* Simplified version - assumes at least one function exists */
    return (typecheck_with_count 1)
}

shadow typecheck {
    assert (== (typecheck) 0)
}
