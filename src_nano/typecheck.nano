        assert (> (list_CompilerDiagnostic_length diags) before)
        set i (+ i 1)
    }
}

fn check_struct_literal(parser: Parser, node_id: int, symbols: array<Symbol>, diags: List<CompilerDiagnostic>, file_name: string) -> NSType {
    let literal: ASTStructLiteral = (parser_get_struct_literal parser node_id)
    let actual: NSType = NSType { kind: TypeKind.TYPE_STRUCT, name: literal.struct_name, element_type_kind: TypeKind.TYPE_UNKNOWN, element_type_name: "" }
    let mut selected: int = -1
    let mut declarations: int = 0
    let mut i: int = 0
    while (< i (parser_get_struct_def_count parser)) {
        if (== (parser_get_struct_def parser i).name literal.struct_name) {
            set selected i
            set declarations (+ declarations 1)
        }
        set i (+ i 1)
    }
    if (!= declarations 1) {
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0001" "I require one exact declared record for this literal." (Diagnostics.diag_location file_name literal.line literal.column)))
        return actual
    }
    let definition: ASTStruct = (parser_get_struct_def parser selected)
    let mut valid: bool = (== definition.field_count literal.field_count)
    set i 0
    while (< i literal.field_count) {
        let name: string = (at literal.field_names i)
        let mut slot: int = -1
        let mut j: int = 0
        while (< j definition.field_count) {
            if (== name (at definition.field_names j)) { set slot j }
            set j (+ j 1)
        }
        set j 0
        while (< j i) {
            if (== name (at literal.field_names j)) { set valid false }
            set j (+ j 1)
        }
        let value: int = (at literal.field_value_ids i)
        let kind: int = (at literal.field_value_types i)
        let raw: NSType = (check_expr_node parser value kind symbols diags file_name)
        if (< slot 0) { set valid false } else {
            let expected: NSType = (type_from_string_with_parser parser (at definition.field_types slot))
            if (not (check_record_field_value parser value kind raw expected symbols diags file_name)) { set valid false }
        }
        set i (+ i 1)
    }
    if (not valid) {
        (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "E0001" "I require every declared record field exactly once with its declared destination type." (Diagnostics.diag_location file_name literal.line literal.column)))
    }
    return actual
}

