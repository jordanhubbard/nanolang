shadow check_statement_list {
    let tokens: List<LexerToken> = (tokenize_string "fn main() -> int { unsafe { assert 7 } return 0 }" "unsafe.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program tokens (list_LexerToken_length tokens) "unsafe.nano")
    assert (typecheck_phase p "unsafe.nano").had_error
