    let parser: Parser = (resource_test_parser "struct Item { value: int } struct Pair { left: int, right: int } struct Holder { values: array<Item> } fn f() -> void { let good = Holder { values: [] } let wrong = Holder { values: [1, true] } let missing = Item {} let repeated = Pair { left: 1, left: 2 } let unknown = Item { other: 1 } let scalar = Item { value: true } let absent = Absent {} }")
