    }
    if (< node_id 0) { return flow }
    if (== node_type ParseNodeType.PNODE_IDENTIFIER) {
        let id: ASTIdentifier = (parser_get_identifier parser node_id)
        let index: int = (resource_find states id.name)
        let signature: string = (resource_value_type parser node_id node_type states)
        if (and (tc_str_starts_with signature "fn(") (str_contains signature "&")) {
