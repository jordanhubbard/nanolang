    let parser: Parser = (resource_test_parser "fn f() -> int { return 1 }")
    let function: ASTFunction = (parser_get_function parser 0)
    let result: CheckedBlock = (check_statement_values parser (parser_get_block parser function.body).statements [] (type_int) (type_unknown_named "inference") true (list_CompilerDiagnostic_new) "block.nano" "f")
    assert result.terminates
    assert (not result.empty_holes)
}

shadow check_block_value {
