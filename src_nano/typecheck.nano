    assert (== (list_CompilerDiagnostic_length diags) 0)
    let symbols: array<Symbol> = [(symbol_new "array_new" (type_int) false true 2 [(type_int), (type_string)] (type_int))]
    assert (== (type_to_string (check_expr_node parser strings.value strings.value_type symbols diags "new.nano")) "int")
