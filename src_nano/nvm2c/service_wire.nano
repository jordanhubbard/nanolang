module nvm2c_service_wire
module "src_nano/nvm2c/container.nano" as wire

# I describe raw service tables, never module, execution or host authority.
# Profiles: 1 legacy File, 2 File nominal, 3 TCP nominal, 4 WebSocket nominal,
# 5 multi-instance nominal. My carrier arrays have the exact profile shapes.
pub struct Instance { catalog: int, imports: array<int>, layouts: array<int> }
pub struct Bindings { status: int, instances: array<Instance> }
pub struct Encoded { status: int, bytes: array<u8> }

fn refused(status: int) -> Bindings {
    return Bindings { status: status, instances: [] }
}
shadow refused { assert (== (refused 8).status 8) assert (== (array_length (refused 8).instances) 0) }

pub fn catalog_methods(catalog: int) -> int {
    if (or (== catalog 1) (== catalog 2)) { return 5 }
    if (== catalog 3) { return 4 }
    return 0
}
shadow catalog_methods { assert (== (catalog_methods 1) 5) assert (== (catalog_methods 3) 4) assert (== (catalog_methods 0) 0) }

pub fn catalog_types(catalog: int) -> int {
    if (== catalog 1) { return 8 }
    if (== catalog 2) { return 9 }
    if (== catalog 3) { return 7 }
    return 0
}
shadow catalog_types { assert (== (catalog_types 1) 8) assert (== (catalog_types 2) 9) assert (== (catalog_types 3) 7) assert (== (catalog_types 4) 0) }

fn indices(values: array<int>) -> bool {
    let mut i: int = 0
    while (< i (array_length values)) {
        let index: int = (at values i)
        if (or (< index 0) (>= index 4294967295)) { return false }
        let mut j: int = 0
        while (< j i) { if (== index (at values j)) { return false } set j (+ j 1) }
        set i (+ i 1)
    }
    return true
}
shadow indices {
    assert (indices [0,4294967294])
    assert (not (indices [0,0]))
    assert (not (indices [4294967295]))
}

pub fn check(instances: array<Instance>, profile: int) -> int {
    if (or (< profile 1) (> profile 5)) { return 1 }
    let count: int = (array_length instances)
    if (!= profile 5) {
        if (!= count 1) { return 5 }
        let row: Instance = (at instances 0)
        let mut methods: int = 5
        let mut types: int = 0
        if (> profile 1) { set methods (catalog_methods (- profile 1)) set types (catalog_types (- profile 1)) }
        if (or (!= (array_length row.imports) methods) (!= (array_length row.layouts) types)) { return 1 }
        if (not (and (indices row.imports) (indices row.layouts))) { return 8 }
        return 0
    }
    if (or (== count 0) (> count 64)) { return 5 }
    let mut i: int = 0
    while (< i count) {
        let row: Instance = (at instances i)
        let types: int = (catalog_types row.catalog)
        let methods: int = (catalog_methods row.catalog)
        if (or (== types 0) (== methods 0)) { return 4 }
        if (or (!= (array_length row.imports) 5) (!= (array_length row.layouts) 9)) { return 1 }
        let mut k: int = types
        while (< k 9) { if (!= (at row.layouts k) 4294967295) { return 6 } set k (+ k 1) }
        set k methods
        while (< k 5) { if (!= (at row.imports k) 4294967295) { return 6 } set k (+ k 1) }
        let mut table: int = 0
        while (< table 2) {
            let mut values: array<int> = row.imports
            let mut length: int = methods
            if (== table 1) { set values row.layouts set length types }
            set k 0
            while (< k length) {
                let index: int = (at values k)
                if (or (< index 0) (>= index 4294967295)) { return 8 }
                let mut j: int = 0
                while (<= j i) {
                    let prior: Instance = (at instances j)
                    let mut other: array<int> = prior.imports
                    let mut end: int = (catalog_methods prior.catalog)
                    if (== table 1) { set other prior.layouts set end (catalog_types prior.catalog) }
                    if (== j i) { set end k }
                    let mut n: int = 0
                    while (< n end) { if (== index (at other n)) { return 8 } set n (+ n 1) }
                    set j (+ j 1)
                }
                set k (+ k 1)
            }
            set table (+ table 1)
        }
        set i (+ i 1)
    }
    return 0
}
shadow check {
    let row: Instance = Instance { catalog: 1, imports: [0,1,2,3,4], layouts: [] }
    assert (== (check [row] 1) 0)
    assert (== (check [] 5) 5)
    assert (== (check [row] 0) 1)
    let bad: Instance = Instance { catalog: 1, imports: [0,1,2,3,3], layouts: [] }
    assert (== (check [bad] 1) 8)
}

fn fixed_decode(bytes: array<u8>, profile: int) -> Bindings {
    let mut catalog: int = 1
    let mut version: int = 1
    let mut methods: int = 5
    let mut types: int = 0
    if (> profile 1) { set catalog (- profile 1) set version 2 set methods (catalog_methods catalog) set types (catalog_types catalog) }
    if (!= (array_length bytes) (+ 16 (* 8 (+ methods types)))) { return (refused 2) }
    if (!= (wire.read_u16 bytes 0) version) { return (refused 3) }
    if (!= (wire.read_u16 bytes 2) catalog) { return (refused 4) }
    if (!= (wire.read_u32 bytes 4) methods) { return (refused 5) }
    if (and (> profile 1) (!= (wire.read_u32 bytes 8) types)) { return (refused 5) }
    if (or (and (== profile 1) (!= (wire.read_u32 bytes 8) 0)) (!= (wire.read_u32 bytes 12) 0)) { return (refused 6) }
    let mut imports: array<int> = []
    let mut layouts: array<int> = []
    let mut i: int = 0
    while (< i (+ methods types)) {
        let offset: int = (+ 16 (* i 8))
        let mut ordinal: int = i
        if (>= i methods) { set ordinal (- i methods) }
        if (!= (wire.read_u32 bytes offset) ordinal) { return (refused 7) }
        let index: int = (wire.read_u32 bytes (+ offset 4))
        if (< i methods) { set imports (array_push imports index) } else { set layouts (array_push layouts index) }
        set i (+ i 1)
    }
    let instances: array<Instance> = [Instance { catalog: catalog, imports: imports, layouts: layouts }]
    let status: int = (check instances profile)
    if (!= status 0) { return (refused status) }
    return Bindings { status: 0, instances: instances }
}
shadow fixed_decode {
    assert (== (fixed_decode [] 1).status 2)
    let mut bytes: array<u8> = []
    let mut i: int = 0
    while (< i 56) { set bytes (array_push bytes 0) set i (+ i 1) }
    assert (== (fixed_decode bytes 1).status 3)
}

pub fn decode(bytes: array<u8>, profile: int) -> Bindings {
    if (or (< profile 1) (> profile 5)) { return (refused 1) }
    if (!= profile 5) { return (fixed_decode bytes profile) }
    let size: int = (array_length bytes)
    if (or (< size 16) (> size 4112)) { return (refused 2) }
    if (!= (wire.read_u16 bytes 0) 3) { return (refused 3) }
    if (or (!= (wire.read_u16 bytes 2) 0) (!= (wire.read_u32 bytes 12) 0)) { return (refused 6) }
    let count: int = (wire.read_u32 bytes 4)
    if (or (== count 0) (> count 64)) { return (refused 5) }
    if (or (!= (wire.read_u32 bytes 8) 64) (!= size (+ 16 (* count 64)))) { return (refused 2) }
    let mut instances: array<Instance> = []
    let mut i: int = 0
    while (< i count) {
        let offset: int = (+ 16 (* i 64))
        if (!= (wire.read_u32 bytes offset) i) { return (refused 7) }
        let catalog: int = (wire.read_u16 bytes (+ offset 4))
        if (!= (wire.read_u16 bytes (+ offset 6)) 0) { return (refused 6) }
        let mut imports: array<int> = []
        let mut layouts: array<int> = []
        let mut j: int = 0
        while (< j 5) { set imports (array_push imports (wire.read_u32 bytes (+ (+ offset 8) (* j 4)))) set j (+ j 1) }
        set j 0
        while (< j 9) { set layouts (array_push layouts (wire.read_u32 bytes (+ (+ offset 28) (* j 4)))) set j (+ j 1) }
        set instances (array_push instances Instance { catalog: catalog, imports: imports, layouts: layouts })
        set i (+ i 1)
    }
    let status: int = (check instances 5)
    if (!= status 0) { return (refused status) }
    return Bindings { status: 0, instances: instances }
}
shadow decode {
    assert (== (decode [] 5).status 2)
    assert (== (decode [] 6).status 1)
    let bytes: array<u8> = [3,0,0,0,0,0,0,0,64,0,0,0,0,0,0,0]
    assert (== (decode bytes 5).status 5)
}

fn append_unsigned(bytes: array<u8>, number: int, width: int) -> array<u8> {
    let mut result: array<u8> = bytes
    let mut value: int = number
    let mut i: int = 0
    while (< i width) { set result (array_push result (% value 256)) set value (/ value 256) set i (+ i 1) }
    return result
}
shadow append_unsigned {
    let bytes: array<u8> = (append_unsigned [] 4294967294 4)
    assert (== (array_length bytes) 4)
    assert (== (at bytes 0) 254)
    assert (== (at bytes 3) 255)
}

pub fn encode(instances: array<Instance>, profile: int) -> Encoded {
    let status: int = (check instances profile)
    if (!= status 0) { return Encoded { status: status, bytes: [] } }
    let mut bytes: array<u8> = []
    if (== profile 5) {
        set bytes (append_unsigned bytes 3 2)
        set bytes (append_unsigned bytes 0 2)
        set bytes (append_unsigned bytes (array_length instances) 4)
        set bytes (append_unsigned bytes 64 4)
        set bytes (append_unsigned bytes 0 4)
        let mut i: int = 0
        while (< i (array_length instances)) {
            let row: Instance = (at instances i)
            set bytes (append_unsigned bytes i 4)
            set bytes (append_unsigned bytes row.catalog 2)
            set bytes (append_unsigned bytes 0 2)
            let mut j: int = 0
            while (< j 5) { set bytes (append_unsigned bytes (at row.imports j) 4) set j (+ j 1) }
            set j 0
            while (< j 9) { set bytes (append_unsigned bytes (at row.layouts j) 4) set j (+ j 1) }
            set i (+ i 1)
        }
    } else {
        let row: Instance = (at instances 0)
        let mut catalog: int = 1
        let mut version: int = 1
        if (> profile 1) { set catalog (- profile 1) set version 2 }
        set bytes (append_unsigned bytes version 2)
        set bytes (append_unsigned bytes catalog 2)
        set bytes (append_unsigned bytes (array_length row.imports) 4)
        set bytes (append_unsigned bytes (array_length row.layouts) 4)
        set bytes (append_unsigned bytes 0 4)
        let mut table: int = 0
        while (< table 2) {
            let mut values: array<int> = row.imports
            if (== table 1) { set values row.layouts }
            let mut i: int = 0
            while (< i (array_length values)) { set bytes (append_unsigned bytes i 4) set bytes (append_unsigned bytes (at values i) 4) set i (+ i 1) }
            set table (+ table 1)
        }
    }
    return Encoded { status: 0, bytes: bytes }
}
shadow encode {
    let row: Instance = Instance { catalog: 1, imports: [0,1,2,3,4], layouts: [] }
    let encoded: Encoded = (encode [row] 1)
    assert (== encoded.status 0)
    assert (== (array_length encoded.bytes) 56)
    let decoded: Bindings = (decode encoded.bytes 1)
    assert (== decoded.status 0)
    assert (== (at (at decoded.instances 0).imports 4) 4)
    assert (== (encode [] 5).status 5)
    assert (== (array_length (encode [] 5).bytes) 0)
}
