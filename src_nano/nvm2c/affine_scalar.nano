module nvm2c_affine_scalar
module "src_nano/nvm2c/affine_frame.nano" as frame
module "src_nano/nvm2c/affine_facts.nano" as facts
module "src_nano/nvm2c/affine_state.nano" as state

pub struct Transition { handled: bool, valid: bool, frame: frame.Frame, message: string }

# I dispatch only context-independent scalar transfers, not profile admission.
pub fn handles(opcode: int) -> bool {
    if (and (>= opcode 0) (<= opcode 9)) { return (!= opcode 4) }
    return (or (and (>= opcode 32) (<= opcode 37))
        (or (and (>= opcode 40) (<= opcode 45))
        (or (and (>= opcode 48) (<= opcode 50))
        (or (and (>= opcode 56) (<= opcode 58))
        (or (or (== opcode 160) (== opcode 161))
        (or (or (== opcode 163) (== opcode 164))
        (or (and (>= opcode 200) (<= opcode 204))
            (and (>= opcode 216) (<= opcode 221)))))))))
}
shadow handles {
    assert (handles 0) assert (handles 1) assert (handles 9)
    assert (handles 163) assert (handles 221)
    assert (not (handles -1)) assert (not (handles 4))
    assert (not (handles 10)) assert (not (handles 16))
    assert (not (handles 59)) assert (not (handles 167))
    assert (not (handles 255)) assert (not (handles 256))
}

fn reject(input: frame.Frame, message: string) -> Transition {
    return Transition { handled: true, valid: false, frame: (frame.clone input), message: message }
}
shadow reject {
    let input: frame.Frame = (frame.create (state.empty) 1)
    let rejected: Transition = (reject input "refused")
    (array_set rejected.frame.globals 0 15)
    assert (not rejected.valid) assert rejected.handled
    assert (== rejected.message "refused")
    assert (== (at input.globals 0) 9)
}

fn wrap(result: frame.Join, message: string) -> Transition {
    if result.valid {
        return Transition { handled: true, valid: true, frame: result.frame, message: "" }
    }
    return Transition { handled: true, valid: false, frame: result.frame, message: message }
}
shadow wrap {
    let input: frame.Frame = (frame.create (state.empty) 0)
    let failed: Transition = (wrap (frame.pop_scalar input 3) "missing")
    assert (not failed.valid) assert (== failed.message "missing")
    let added: Transition = (wrap (frame.push input (frame.value 3 false 65535 false 4294967295 65535)) "unused")
    assert added.valid assert (== added.message "")
    assert (== (array_length added.frame.stack) 1)
}

# I receive decoded operands and a graph mode established by my caller.
# I retain failure snapshots; this operation grants no graph or CFG authority.
pub fn transfer(input: frame.Frame, opcode: int, operand: int, value_graph: bool) -> Transition {
    if (not (handles opcode)) {
        return Transition { handled: false, valid: false, frame: (frame.clone input), message: "" }
    }
    if (or (== opcode 0) (or (== opcode 56) (== opcode 163))) {
        return Transition { handled: true, valid: true, frame: (frame.clone input), message: "" }
    }
    if (and (>= opcode 1) (<= opcode 6)) {
        let mut tag: int = opcode
        if (== opcode 5) { set tag 0 }
        if (== opcode 6) { set tag 4 }
        if (and (== opcode 3) (or (< operand 0) (> operand 1))) {
            return (reject input "I require a Boolean literal")
        }
        return (wrap (frame.push input (frame.value tag false 65535 false 4294967295 65535)) "I cannot extend my analysis stack")
    }
    let count: int = (array_length input.stack)
    if (== opcode 7) {
        if (== count 0) { return (reject input "I refuse to duplicate reference authority") }
        let top: frame.Value = (at input.stack (- count 1))
        if (or top.observation top.owned) { return (reject input "I refuse to duplicate reference authority") }
        if (and (not value_graph) (== top.tag 5)) { return (reject input "I refuse unsupported string duplication") }
        return (wrap (frame.push input top) "I cannot extend my analysis stack")
    }
    if (== opcode 8) {
        if (== count 0) { return (reject input "I require a scalar discard; an observation is not an owned consume") }
        let top: frame.Value = (at input.stack (- count 1))
        if (or top.observation top.owned) { return (reject input "I require a scalar discard; an observation is not an owned consume") }
        if (and (not value_graph) (== top.tag 5)) { return (reject input "I require PRINT or PRINTLN to consume a string") }
        return (wrap (frame.pop_scalar input top.tag) "I require a scalar discard; an observation is not an owned consume")
    }
    if (== opcode 9) {
        if (< count 2) { return (reject input "I require scalar stack permutation") }
        let upper: frame.Value = (at input.stack (- count 1))
        let lower: frame.Value = (at input.stack (- count 2))
        if (or upper.observation (or upper.owned (or lower.observation lower.owned))) {
            return (reject input "I require scalar stack permutation")
        }
        if (and (not value_graph) (or (== upper.tag 5) (== lower.tag 5))) {
            return (reject input "I refuse unsupported string permutation")
        }
        let copied: frame.Frame = (frame.clone input)
        let top: frame.Value = (at copied.stack (- count 1))
        let below: frame.Value = (at copied.stack (- count 2))
        (array_set copied.stack (- count 1) below)
        (array_set copied.stack (- count 2) top)
        return Transition { handled: true, valid: true, frame: copied, message: "" }
    }
    if (or (== opcode 160) (== opcode 164)) {
        if (not value_graph) { return (reject input "I require string output inside an owned value-call graph") }
        return (wrap (frame.pop_scalar input 5) "I require one exact immutable string print operand")
    }
    if (== opcode 161) {
        return (wrap (frame.pop_scalar input 3) "I require an exact Boolean assertion condition")
    }
    if (or (== opcode 57) (== opcode 58)) {
        return (wrap (frame.pop_scalar input 3) "I require an exact Boolean branch condition")
    }

    let mut tag: int = 0
    let mut result_tag: int = 0
    let mut needed: int = 2
    let mut error: string = ""
    if (and (>= opcode 48) (<= opcode 50)) {
        set tag 3 set result_tag 3 set error "I require Boolean operands"
        if (== opcode 50) { set needed 1 }
    } else if (and (>= opcode 32) (<= opcode 37)) {
        set tag 1 set result_tag 1 set error "I require integer arithmetic operands"
        if (== opcode 37) { set needed 1 }
    } else if (and (>= opcode 200) (<= opcode 204)) {
        set tag 2 set result_tag 2 set error "I require float arithmetic operands"
        if (== opcode 204) { set needed 1 }
    } else if (and (>= opcode 216) (<= opcode 221)) {
        set tag 2 set result_tag 3 set error "I require float comparison operands"
    } else {
        if (== count 0) { return (reject input "I require scalar comparison operands") }
        let top: frame.Value = (at input.stack (- count 1))
        if (and value_graph (and (or (== opcode 40) (== opcode 41)) (== top.tag 5))) {
            set tag 5 set error "I require exact STRING equality operands"
        } else {
            if (or top.observation (or top.owned (not (facts.scalar top.tag)))) {
                return (reject input "I require scalar comparison operands")
            }
            set tag top.tag set error "I require matching comparison tags"
        }
        set result_tag 3
    }
    if (< count needed) { return (reject input error) }
    for offset in (range 0 needed) {
        let item: frame.Value = (at input.stack (- (- count 1) offset))
        if (or item.observation (or item.owned (!= item.tag tag))) { return (reject input error) }
    }
    let copied: frame.Frame = (frame.clone input)
    let remaining: array<frame.Value> = (array_slice copied.stack 0 (- count needed))
    let stack: array<frame.Value> = (array_push remaining (frame.value result_tag false 65535 false 4294967295 65535))
    return Transition { handled: true, valid: true, message: "", frame: frame.Frame {
        locals: copied.locals, stack: stack, globals: copied.globals, handlers: copied.handlers,
        floor: copied.floor, activation: copied.activation } }
}
shadow transfer {
    let empty: frame.Frame = (frame.create (state.empty) 1)
    assert (not (transfer empty 4 0 true).handled)
    assert (transfer empty 0 0 false).valid
    assert (== (transfer empty 3 2 false).message "I require a Boolean literal")
    assert (== (transfer empty 160 0 false).message "I require string output inside an owned value-call graph")
    let integer: frame.Frame = (transfer empty 1 0 false).frame
    let pair: frame.Frame = (transfer integer 1 0 false).frame
    let added: Transition = (transfer pair 32 0 false)
    assert added.valid assert (== (array_length added.frame.stack) 1)
    assert (== (at added.frame.stack 0).tag 1)
    assert (== (array_length pair.stack) 2)
    let text: frame.Frame = (frame.push empty (frame.value 5 false 7 false 9 2)).frame
    assert (not (transfer text 7 0 false).valid)
    let duplicated: Transition = (transfer text 7 0 true)
    assert duplicated.valid assert (== (array_length duplicated.frame.stack) 2)
    (array_set (at duplicated.frame.stack 1).excluded 7 true)
    assert (not (at (at duplicated.frame.stack 0).excluded 7))
    assert (not (at (at text.stack 0).excluded 7))
    assert (transfer text 160 0 true).valid
    assert (== (transfer text 40 0 true).message "I require exact STRING equality operands")
    let boolean: frame.Frame = (transfer empty 3 1 false).frame
    assert (transfer boolean 57 0 false).valid
    assert (not (transfer integer 57 0 false).valid)
    let normalized: Transition = (transfer boolean 50 0 false)
    assert normalized.valid assert (== (at normalized.frame.stack 0).root 65535)
    assert (== (at normalized.frame.stack 0).layout 4294967295)
    assert (== (at normalized.frame.stack 0).variant 65535)
}
