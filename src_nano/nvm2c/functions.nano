module nvm2c_functions
module "src_nano/nvm2c/container.nano" as wire
module "src_nano/nvm2c/instructions.nano" as primary

# I decode every byte, including unreachable instructions. This is not a proof
# of stack, type, lifetime, effect or host admission. My views stay immutable.
pub struct Function {
    valid: bool,
    size: int,
    starts: array<int>,
    next: array<int>,
    targets: array<int>,
    instructions: array<primary.Instruction>,
    boundaries: array<bool>,
    indices: array<int>
}

fn refused() -> Function {
    return Function { valid: false, size: 0, starts: [], next: [], targets: [],
                      instructions: [], boundaries: [], indices: [] }
}
shadow refused {
    let f: Function = (refused)
    assert (not f.valid)
    assert (== (array_length f.boundaries) 0)
}

pub fn has_boundary(f: Function, offset: int) -> bool {
    if (or (< offset 0) (>= offset (array_length f.boundaries))) { return false }
    return (at f.boundaries offset)
}
shadow has_boundary {
    assert (not (has_boundary (refused) 0))
    assert (not (has_boundary (refused) -1))
}

# I return -1 for the terminal boundary as well as instruction interiors.
# The terminal byte is a boundary, but it does not name an instruction.
pub fn index_at(f: Function, offset: int) -> int {
    if (or (< offset 0) (>= offset f.size)) { return -1 }
    if (>= offset (array_length f.indices)) { return -1 }
    return (- (at f.indices offset) 1)
}
shadow index_at {
    assert (== (index_at (refused) 0) -1)
    assert (== (index_at (refused) -1) -1)
}

fn branch_operand(opcode: int) -> int {
    # JMP, JMP_TRUE, JMP_FALSE; MATCH_TAG, HANDLER_PUSH, FILE_RESULT_BRANCH.
    if (or (== opcode 56) (or (== opcode 57) (== opcode 58))) { return 0 }
    if (or (== opcode 107) (or (== opcode 165) (== opcode 146))) { return 1 }
    return -1
}
shadow branch_operand {
    assert (== (branch_operand 56) 0)
    assert (== (branch_operand 165) 1)
    assert (== (branch_operand 59) -1)
}

pub fn decode(code: array<u8>, start: int, length: int, function_count: int) -> Function {
    if (or (<= function_count 0) (> function_count 4294967295)) { return (refused) }
    if (or (> start 4294967295) (> length 4294967295)) { return (refused) }
    if (not (wire.contains code start length)) { return (refused) }
    let mut starts: array<int> = []
    let mut next: array<int> = []
    let mut targets: array<int> = []
    let mut instructions: array<primary.Instruction> = []
    let mut boundaries: array<bool> = []
    let mut indices: array<int> = []
    let mut i: int = 0
    while (<= i length) {
        set boundaries (array_push boundaries false)
        set indices (array_push indices 0)
        set i (+ i 1)
    }
    let mut position: int = 0
    while (< position length) {
        let item: primary.Instruction = (primary.decode code (+ start position) (- length position))
        if (== item.length 0) { return (refused) }
        set starts (array_push starts position)
        set next (array_push next (+ position item.length))
        set targets (array_push targets 4294967295)
        set instructions (array_push instructions item)
        (array_set boundaries position true)
        (array_set indices position (array_length instructions))
        set position (+ position item.length)
    }
    (array_set boundaries length true)
    let result: Function = Function { valid: true, size: length, starts: starts,
        next: next, targets: targets, instructions: instructions,
        boundaries: boundaries, indices: indices }
    set i 0
    while (< i (array_length instructions)) {
        let item: primary.Instruction = (at instructions i)
        let operand: int = (branch_operand item.opcode)
        if (>= operand 0) {
            let target: int = (+ (at starts i) (primary.integer item operand))
            if (or (< target 0) (> target 4294967295)) { return (refused) }
            if (and (== item.opcode 146) (or (>= target length) (>= (at next i) length))) { return (refused) }
            if (not (has_boundary result target)) { return (refused) }
            (array_set targets i (% (+ start target) 4294967296))
        } else if (or (== item.opcode 59) (== item.opcode 51)) {
            let target: int = (primary.integer item 0)
            if (>= target function_count) { return (refused) }
            (array_set targets i target)
        }
        set i (+ i 1)
    }
    return result
}
shadow decode {
    let empty: Function = (decode [] 0 0 1)
    assert empty.valid
    assert (has_boundary empty 0)
    assert (== (index_at empty 0) -1)
    let terminal: Function = (decode [255,56,5,0,0,0] 1 5 1)
    assert terminal.valid
    assert (== (at terminal.targets 0) 6)
    assert (has_boundary terminal 5)
    assert (not (has_boundary terminal 1))
    assert (== (index_at terminal 0) 0)
    assert (not (decode [56,1,0,0,0] 0 5 1).valid)
    assert (not (decode [59,1,0,0,0] 0 5 1).valid)
    assert (decode [51,1,0,0,0] 0 5 2).valid
    assert (not (decode [] 0 0 0).valid)
    assert (not (decode [0] -1 1 1).valid)
    assert (not (decode [0] 0 -1 1).valid)
    assert (not (decode [0] 0 4294967296 1).valid)
    assert (not (decode [255] 0 1 1).valid)
}
