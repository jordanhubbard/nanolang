module nvm2c_service_catalog
# I generate immutable data with scripts/generate_nvm2c_service_catalog.py.
# I call no C catalog getter at runtime. Unknown selectors stay empty/-1.

pub fn count(catalog: int, kind: int) -> int {
    if (== catalog 1) {
        if (== kind 1) { return 8 }
        if (== kind 2) { return 5 }
    }
    if (== catalog 2) {
        if (== kind 1) { return 9 }
        if (== kind 2) { return 5 }
    }
    if (== catalog 3) {
        if (== kind 1) { return 7 }
        if (== kind 2) { return 4 }
    }
    return -1
}
shadow count { assert (== (count 1 1) 8) assert (== (count 3 2) 4) assert (== (count 0 1) -1) }

