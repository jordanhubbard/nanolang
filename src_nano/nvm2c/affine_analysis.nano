module nvm2c_affine_analysis
module "src_nano/nvm2c/affine_analysis_cache.nano" as cache
module "src_nano/nvm2c/affine_call_context.nano" as calls_context
module "src_nano/nvm2c/affine_preflight.nano" as preflight
module "src_nano/nvm2c/affine_worklist.nano" as work
module "src_nano/nvm2c/affine_frame.nano" as frame
module "src_nano/nvm2c/affine_state.nano" as state
module "src_nano/nvm2c/affine_facts.nano" as facts
module "src_nano/nvm2c/affine_scalar.nano" as scalar
module "src_nano/nvm2c/affine_locals.nano" as locals
module "src_nano/nvm2c/affine_globals.nano" as globals
module "src_nano/nvm2c/affine_global_flow.nano" as relations
module "src_nano/nvm2c/affine_arrays.nano" as arrays
module "src_nano/nvm2c/affine_owners.nano" as owners
