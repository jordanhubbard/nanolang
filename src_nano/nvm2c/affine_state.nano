    if (or (not s.valid) (or (!= s.facts.parameters 1) (== (array_length s.facts.locals) 0))) { return (no_value) }
    let param: facts.Slot = (at s.facts.locals 0)
    if (or (!= param.tag 8) (or (!= param.mode 0) (not (facts.resource_value s.facts param)))) { return (no_value) }
    if (not (facts.complete (at s.facts.flags param.layout))) { return (no_value) }
    return (value param 0)
}
shadow owned_parameter_type { assert (not (owned_parameter_type (sample)).valid) }

fn nested_result_tree(f: facts.Facts, root: int) -> bool {
    let mut depths: array<int> = []
    let mut i: int = 0
    while (<= i root) { set depths (array_push depths 0) set i (+ i 1) }
    (array_set depths root 1)
    let owned: bool = (facts.resource_flag (at f.flags root))
    set i root
    while (>= i 0) {
        if (> (at depths i) 0) {
            let row: places.Layout = (at f.rows i)
            let flag: int = (at f.flags i)
            if (or (not (facts.complete flag)) (or (!= (facts.resource_flag flag) owned)
                (or (and (!= row.kind 0) (!= row.kind 2)) (> (array_length row.fields) 256)))) { return false }
            let mut field: int = 0
            while (< field (array_length row.fields)) {
                let item: places.Field = (at row.fields field)
                if (or (== item.tag 8) (== item.tag 10)) {
                    if (or (or (< item.nested 0) (>= item.nested i)) (>= (at depths i) 32)) { return false }
                    let child_depth: int = (+ (at depths i) 1)
                    if (< (at depths item.nested) child_depth) { (array_set depths item.nested child_depth) }
                } else if (or (not (or (== item.tag 1) (or (== item.tag 4) (or (== item.tag 2) (== item.tag 5))))) (!= item.nested 4294967295)) { return false }
                set field (+ field 1)
            }
        }
        set i (- i 1)
    }
    return true
}
shadow nested_result_tree { assert (nested_result_tree (sample).facts 0) }

pub fn value_result(s: State) -> Query {
    if (not s.valid) { return (no_value) }
    let item: facts.Slot = s.facts.result
    let expected: int = (cond ((== item.tag 0) 0) (else 1))
    if (or (!= item.mode 0) (or (!= s.facts.result_tag item.tag) (!= s.facts.result_count expected))) { return (no_value) }
    let mut count: int = 0
    if (== item.tag 8) {
        if (or (< item.layout 0) (>= item.layout (array_length s.facts.rows))) { return (no_value) }
        if (not (facts.complete (at s.facts.flags item.layout))) { return (no_value) }
        let row: places.Layout = (at s.facts.rows item.layout)
        if (!= row.kind 0) { return (no_value) }
        let mut nested: bool = false
        let mut i: int = 0
        while (< i (array_length row.fields)) {
            let field: places.Field = (at row.fields i)
            if (or (== field.tag 8) (== field.tag 10)) { set nested true }
            else if (or (not (or (== field.tag 1) (or (== field.tag 4) (or (== field.tag 2) (== field.tag 5))))) (!= field.nested 4294967295)) { return (no_value) }
            set i (+ i 1)
        }
        if (and nested (not (nested_result_tree s.facts item.layout))) { return (no_value) }
        set count (array_length row.fields)
    } else if (== item.tag 10) {
        if (not (facts.union_value s.facts item)) { return (no_value) }
    } else if (== item.tag 7) {
        if (not (facts.supported s.facts item)) { return (no_value) }
    } else if (or (not (or (== item.tag 0) (or (== item.tag 1) (or (== item.tag 4) (== item.tag 2))))) (!= item.layout 4294967295)) { return (no_value) }
    return (value item count)
}
shadow value_result { assert (value_result (sample)).valid assert (== (value_result (sample)).value.tag 0) }

pub fn value_parameters(s: State, capacity: int, output_present: bool, consuming: bool) -> Query {
    if (or (not s.valid) (or (not output_present) (or (> s.facts.parameters 8)
        (or (> s.facts.parameters capacity) (> s.facts.parameters (array_length s.facts.locals)))))) { return (no_value) }
    let mut values: array<facts.Slot> = []
    let mut owned: bool = false
    let mut i: int = 0
    while (< i s.facts.parameters) {
        let item: facts.Slot = (at s.facts.locals i)
        if (!= item.mode 0) { return (no_value) }
        if (== item.tag 8) {
            if (or (< item.layout 0) (>= item.layout (array_length s.facts.rows))) { return (no_value) }
            if (or (!= (at s.facts.rows item.layout).kind 0) (not (facts.complete (at s.facts.flags item.layout)))) { return (no_value) }
        } else if (== item.tag 5) {
            if (!= item.layout 4294967295) { return (no_value) }
        } else if (== item.tag 10) {
            if (not (facts.union_value s.facts item)) { return (no_value) }
        } else if (== item.tag 7) {
            if (not (facts.supported s.facts item)) { return (no_value) }
        } else if (not (or (== item.tag 1) (or (== item.tag 4) (== item.tag 2)))) { return (no_value) }
        if (type_owned s item) { set owned true }
        set values (array_push values item)
        set i (+ i 1)
    }
    if (and consuming (not owned)) { return (no_value) }
    return Query { valid: true, value: (facts.slot 0 0), number: s.facts.parameters, values: values }
}
shadow value_parameters { assert (value_parameters (sample) 0 true false).valid assert (not (value_parameters (sample) 0 true true).valid) }
