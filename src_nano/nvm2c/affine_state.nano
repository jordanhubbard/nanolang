module nvm2c_affine_state
module "src_nano/nvm2c/affine_facts.nano" as facts
module "src_nano/nvm2c/reference_places.nano" as places

pub struct Reference { live: bool, region: int, parent: int, place: places.Place }
pub struct Origin { low: int, high: int, local: int, layout: int }
pub struct State {
    valid: bool, facts: facts.Facts, live: array<bool>, variants: array<int>,
    references: array<Reference>, control: array<int>, origins: array<Origin>
}
# Control retains region, caller-bound, handler, first arm local, handler key,
# resume tag/layout and the low/high invocation words. I copy before mutation.
pub struct Transition { valid: bool, changed: bool, state: State }
pub struct Query { valid: bool, value: facts.Slot, number: int, values: array<facts.Slot> }

fn absent_place() -> places.Place {
    return places.Place { present: true, invocation_low: 0, invocation_high: 0,
        local: 0, root_layout: 0, fields_present: true, fields: [], referent_layout: 0, mode: 0 }
}
shadow absent_place { assert (not (places.descriptor_valid (absent_place))) }

fn empty_reference() -> Reference { return Reference { live: false, region: 0, parent: 0, place: (absent_place) } }
shadow empty_reference { assert (not (empty_reference).live) }

pub fn empty() -> State {
    return State { valid: false, facts: (facts.empty), live: [], variants: [],
        references: [], control: [0,0,0,0,0,0,0,1,0], origins: [] }
}
shadow empty { assert (not (empty).valid) assert (== (at (empty).control 7) 1) }

fn refused(s: State) -> Transition { return Transition { valid: false, changed: false, state: s } }
shadow refused { assert (not (refused (empty)).valid) assert (not (refused (empty)).changed) }

fn accepted(s: State) -> Transition { return Transition { valid: true, changed: false, state: s } }
shadow accepted { assert (accepted (empty)).valid }

fn no_value() -> Query { return Query { valid: false, value: (facts.slot 0 0), number: 0, values: [] } }
shadow no_value { assert (not (no_value).valid) assert (== (array_length (no_value).values) 0) }

fn value(item: facts.Slot, number: int) -> Query { return Query { valid: true, value: item, number: number, values: [] } }
shadow value { assert (value (facts.slot 1 0) 7).valid assert (== (value (facts.slot 1 0) 7).number 7) }

fn clone_place(p: places.Place) -> places.Place {
    return places.Place { present: p.present, invocation_low: p.invocation_low, invocation_high: p.invocation_high,
        local: p.local, root_layout: p.root_layout, fields_present: p.fields_present,
        fields: (array_slice p.fields 0 (array_length p.fields)), referent_layout: p.referent_layout, mode: p.mode }
}
shadow clone_place {
    let p: places.Place = places.Place { present: true, invocation_low: 1, invocation_high: 0,
        local: 0, root_layout: 1, fields_present: true, fields: [0], referent_layout: 0, mode: 1 }
    let copied: places.Place = (clone_place p)
    (array_set p.fields 0 1)
    assert (== (at copied.fields 0) 0)
}

pub fn clone(s: State) -> State {
    if (not s.valid) { return s }
    let mut references: array<Reference> = []
    let mut i: int = 0
    while (< i (array_length s.references)) {
        let ref: Reference = (at s.references i)
        let copied: places.Place = (clone_place ref.place)
        set references (array_push references Reference { live: ref.live, region: ref.region, parent: ref.parent, place: copied })
        set i (+ i 1)
    }
    return State { valid: true, facts: s.facts,
        live: (array_slice s.live 0 (array_length s.live)),
        variants: (array_slice s.variants 0 (array_length s.variants)),
        references: references,
        control: (array_slice s.control 0 (array_length s.control)),
        origins: (array_slice s.origins 0 (array_length s.origins)) }
}
shadow clone { assert (not (clone (empty)).valid) }

fn with_origins(s: State, origins: array<Origin>) -> State {
    return State { valid: s.valid, facts: s.facts, live: s.live, variants: s.variants,
        references: s.references, control: s.control, origins: origins }
}
shadow with_origins { assert (== (array_length (with_origins (empty) [Origin { low: 1, high: 0, local: 2, layout: 3 }]).origins) 1) }

pub fn create(f: facts.Facts, references: int) -> State {
    if (or (not f.valid) (or (< references 0) (> references 4294967295))) { return (empty) }
    let mut live: array<bool> = []
    let mut variants: array<int> = []
    let mut refs: array<Reference> = []
    let mut i: int = 0
    while (< i (array_length f.locals)) {
        set live (array_push live (< i f.parameters))
        set variants (array_push variants 65535)
        set i (+ i 1)
    }
    set i 0
    while (< i references) { set refs (array_push refs (empty_reference)) set i (+ i 1) }
    set i 0
    while (< i f.parameters) {
        let item: facts.Slot = (at f.locals i)
        if (!= item.mode 0) {
            if (>= i references) { return (empty) }
            let place: places.Place = places.Place { present: true, invocation_low: 1, invocation_high: 0,
                local: i, root_layout: item.layout, fields_present: true, fields: [], referent_layout: item.layout, mode: item.mode }
            (array_set refs i Reference { live: true, region: 0, parent: 4294967295, place: place })
        }
        set i (+ i 1)
    }
    return State { valid: true, facts: f, live: live, variants: variants, references: refs,
        control: [0,0,0,0,0,0,0,1,0], origins: [] }
}
shadow create { assert (not (create (facts.empty) 0).valid) }

fn sample() -> State {
    let f: facts.Facts = facts.Facts { valid: true, analysis: 1, module_identity: 1, function: 0,
        rows: [places.Layout { kind: 0, fields_present: true, fields: [places.Field { tag: 1, nested: 4294967295 }] }],
        flags: [3], locals: [(facts.slot 1 4294967295), (facts.slot 8 0), (facts.slot 8 0)],
        result: (facts.slot 0 4294967295), parameters: 0, result_count: 0, result_tag: 0,
        arrays: [], variants: [], effects: [] }
    return (define_scalar (create f 3) 0).state
}
shadow sample { assert (sample).valid assert (at (sample).live 0) assert (not (at (sample).live 1)) }

fn local_exists(s: State, local: int) -> bool {
    return (and s.valid (and (>= local 0) (< local (array_length s.facts.locals))))
}
shadow local_exists { assert (not (local_exists (empty) 0)) }

fn value_local(s: State, local: int) -> bool {
    if (not (local_exists s local)) { return false }
    let item: facts.Slot = (at s.facts.locals local)
    return (and (== item.mode 0) (not (and (!= (at s.control 2) 0)
        (and (< local (at s.control 3)) (facts.resource_value s.facts item)))))
}
shadow value_local { assert (not (value_local (empty) 0)) }

fn resolve(s: State, local: int, path: array<int>) -> Query {
    if (not (local_exists s local)) { return (no_value) }
    let mut item: facts.Slot = (at s.facts.locals local)
    let mut i: int = 0
    while (< i (array_length path)) {
        if (or (!= item.tag 8) (or (< item.layout 0) (>= item.layout (array_length s.facts.rows)))) { return (no_value) }
        let row: places.Layout = (at s.facts.rows item.layout)
        let field: int = (at path i)
        if (or (!= row.kind 0) (or (< field 0) (>= field (array_length row.fields)))) { return (no_value) }
        let child: places.Field = (at row.fields field)
        set item (facts.slot child.tag child.nested)
        set i (+ i 1)
    }
    if (or (facts.scalar item.tag) (or (and (== item.tag 5) (== item.layout 4294967295)) (!= item.layout 4294967295))) {
        return (value item 0)
    }
    return (no_value)
}
shadow resolve { assert (not (resolve (empty) 0 []).valid) }

fn owner_place(s: State, local: int, path: array<int>, referent: int, mode: int) -> places.Place {
    return places.Place { present: true, invocation_low: (at s.control 7), invocation_high: (at s.control 8),
        local: local, root_layout: (at s.facts.locals local).layout,
        fields_present: true, fields: path, referent_layout: referent, mode: mode }
}
shadow owner_place {
    let f: facts.Facts = facts.Facts { valid: true, analysis: 1, module_identity: 1, function: 0,
        rows: [], flags: [], locals: [(facts.slot 1 4294967295)], result: (facts.slot 0 4294967295),
        parameters: 0, result_count: 0, result_tag: 0, arrays: [], variants: [], effects: [] }
    assert (== (owner_place (create f 0) 0 [] 4294967295 1).invocation_low 1)
}

pub fn owner_access(s: State, local: int, path: array<int>, write: bool) -> bool {
    if (not (value_local s local)) { return false }
    if (not (at s.live local)) { return false }
    let found: Query = (resolve s local path)
    if (not found.valid) { return false }
    let place: places.Place = (owner_place s local path found.value.layout 1)
    let mut i: int = 0
    while (< i (array_length s.references)) {
        let ref: Reference = (at s.references i)
        if (and ref.live (places.owner_access_conflicts ref.place place write)) { return false }
        set i (+ i 1)
    }
    return true
}
shadow owner_access { assert (not (owner_access (empty) 0 [] false)) }

fn destination(s: State, local: int) -> bool {
    if (not (value_local s local)) { return false }
    if (not (at s.live local)) { return true }
    let item: facts.Slot = (at s.facts.locals local)
    if (== item.tag 10) { return (not (facts.resource_value s.facts item)) }
    return (and (not (facts.resource_value s.facts item)) (owner_access s local [] true))
}
shadow destination { assert (not (destination (empty) 0)) }

pub fn define_scalar(s: State, local: int) -> Transition {
    if (not (destination s local)) { return (refused s) }
    if (not (facts.scalar (at s.facts.locals local).tag)) { return (refused s) }
    let out: State = (clone s)
    (array_set out.live local true)
    return (accepted out)
}
shadow define_scalar { assert (not (define_scalar (empty) 0).valid) }

pub fn define_string(s: State, local: int) -> Transition {
    if (not (destination s local)) { return (refused s) }
    let item: facts.Slot = (at s.facts.locals local)
    if (or (!= item.tag 5) (!= item.layout 4294967295)) { return (refused s) }
    let out: State = (clone s)
    (array_set out.live local true)
    return (accepted out)
}
shadow define_string { assert (not (define_string (empty) 0).valid) }

pub fn record_copyable(s: State, layout: int) -> bool {
    if (or (not s.valid) (or (< layout 0) (>= layout (array_length s.facts.rows)))) { return false }
    let flag: int = (at s.facts.flags layout)
    return (and (== (at s.facts.rows layout).kind 0) (and (facts.complete flag) (not (facts.resource_flag flag))))
}
shadow record_copyable { assert (not (record_copyable (empty) 0)) }

pub fn define_record(s: State, local: int, layout: int) -> Transition {
    if (or (not (record_copyable s layout)) (not (destination s local))) { return (refused s) }
    let item: facts.Slot = (at s.facts.locals local)
    if (or (!= item.tag 8) (!= item.layout layout)) { return (refused s) }
    let out: State = (clone s)
    (array_set out.live local true)
    return (accepted out)
}
shadow define_record { assert (not (define_record (empty) 0 0).valid) }

pub fn define_array(s: State, local: int, element: int) -> Transition {
    let item: facts.Slot = (facts.slot 7 element)
    if (or (not s.valid) (or (not (facts.supported s.facts item)) (facts.resource_value s.facts item))) { return (refused s) }
    if (not (destination s local)) { return (refused s) }
    if (not (facts.same s.facts (at s.facts.locals local) item)) { return (refused s) }
    let out: State = (clone s)
    (array_set out.live local true)
    return (accepted out)
}
shadow define_array { assert (not (define_array (empty) 0 0).valid) }

pub fn define_union(s: State, local: int, layout: int, variant: int) -> Transition {
    if (not (destination s local)) { return (refused s) }
    let item: facts.Slot = (at s.facts.locals local)
    if (or (!= item.layout layout) (or (not (facts.union_value s.facts item)) (facts.resource_value s.facts item))) { return (refused s) }
    if (and (!= variant 65535) (< (facts.variant_index s.facts layout variant) 0)) { return (refused s) }
    let out: State = (clone s)
    (array_set out.live local true)
    (array_set out.variants local variant)
    return (accepted out)
}
shadow define_union { assert (not (define_union (empty) 0 0 0).valid) }

pub fn refine_union(s: State, local: int, variant: int) -> Transition {
    if (not (value_local s local)) { return (refused s) }
    if (not (at s.live local)) { return (refused s) }
    let item: facts.Slot = (at s.facts.locals local)
    if (not (facts.union_value s.facts item)) { return (refused s) }
    let prior: int = (at s.variants local)
    if (and (!= prior 65535) (!= prior variant)) { return (refused s) }
    if (< (facts.variant_index s.facts item.layout variant) 0) { return (refused s) }
    let out: State = (clone s)
    (array_set out.variants local variant)
    return (accepted out)
}
shadow refine_union { assert (not (refine_union (empty) 0 0).valid) }

pub fn union_variant(s: State, local: int) -> Query {
    if (not (value_local s local)) { return (no_value) }
    if (or (not (at s.live local)) (not (facts.union_value s.facts (at s.facts.locals local)))) { return (no_value) }
    let variant: int = (at s.variants local)
    if (== variant 65535) { return (no_value) }
    return (value (at s.facts.locals local) variant)
}
shadow union_variant { assert (not (union_variant (empty) 0).valid) }

pub fn move_local(s: State, source: int, target: int) -> Transition {
    if (or (== source target) (not (destination s target))) { return (refused s) }
    if (not (owner_access s source [] true)) { return (refused s) }
    let item: facts.Slot = (at s.facts.locals source)
    if (not (facts.same s.facts item (at s.facts.locals target))) { return (refused s) }
    let out: State = (clone s)
    (array_set out.live source false)
    (array_set out.live target true)
    if (== item.tag 10) {
        (array_set out.variants target (at s.variants source))
        (array_set out.variants source 65535)
    }
    return (accepted out)
}
shadow move_local { assert (not (move_local (empty) 0 1).valid) }

fn fields_check(s: State, root: int, fields: array<int>, offset: int, count: int, unpack: bool) -> bool {
    let row: places.Layout = (at s.facts.rows (at s.facts.locals root).layout)
    if (and unpack (not (owner_access s root [] true))) { return false }
    if (and (not unpack) (not (destination s root))) { return false }
    let mut i: int = 0
    while (< i count) {
        let local: int = (at fields i)
        if (or (== local root) (not (value_local s local))) { return false }
        let item: facts.Slot = (at s.facts.locals local)
        let field: places.Field = (at row.fields (+ offset i))
        if (not (facts.same s.facts item (facts.slot field.tag field.nested))) { return false }
        let mut j: int = 0
        while (< j i) {
            if (and (== (at fields j) local) (or unpack (facts.resource_value s.facts item))) { return false }
            set j (+ j 1)
        }
        if unpack {
            if (not (destination s local)) { return false }
        } else {
            if (not (owner_access s local [] (facts.resource_value s.facts item))) { return false }
        }
        set i (+ i 1)
    }
    return true
}
shadow fields_check {
    assert (fields_check (sample) 1 [0] 0 1 false)
    assert (not (fields_check (sample) 1 [2] 0 1 false))
}

fn transferred(s: State, root: int, fields: array<int>, unpack: bool, union_transfer: bool, variant: int) -> Transition {
    let out: State = (clone s)
    let mut i: int = 0
    while (< i (array_length fields)) {
        let local: int = (at fields i)
        if unpack {
            (array_set out.live local true)
            (array_set out.variants local 65535)
        } else if (facts.resource_value s.facts (at s.facts.locals local)) {
            (array_set out.live local false)
            (array_set out.variants local 65535)
        }
        set i (+ i 1)
    }
    (array_set out.live root (not unpack))
    if union_transfer { (array_set out.variants root (cond (unpack 65535) (else variant))) }
    return (accepted out)
}
shadow transferred {
    let s: State = (sample)
    let out: Transition = (transferred s 1 [0] false false 0)
    assert out.valid assert (at out.state.live 1) assert (not (at s.live 1))
}

pub fn record_transfer(s: State, root: int, fields: array<int>, unpack: bool) -> Transition {
    if (not (value_local s root)) { return (refused s) }
    let item: facts.Slot = (at s.facts.locals root)
    if (or (!= item.tag 8) (or (< item.layout 0) (>= item.layout (array_length s.facts.rows)))) { return (refused s) }
    let row: places.Layout = (at s.facts.rows item.layout)
    if (or (!= row.kind 0) (!= (array_length fields) (array_length row.fields))) { return (refused s) }
    if (not (fields_check s root fields 0 (array_length fields) unpack)) { return (refused s) }
    return (transferred s root fields unpack false 0)
}
shadow record_transfer { assert (not (record_transfer (empty) 0 [] false).valid) }

pub fn union_transfer(s: State, root: int, variant: int, fields: array<int>, unpack: bool) -> Transition {
    if (not (value_local s root)) { return (refused s) }
    let item: facts.Slot = (at s.facts.locals root)
    if (not (facts.union_value s.facts item)) { return (refused s) }
    let index: int = (facts.variant_index s.facts item.layout variant)
    if (< index 0) { return (refused s) }
    let fact: facts.Variant = (at s.facts.variants index)
    if (!= fact.count (array_length fields)) { return (refused s) }
    if unpack {
        if (or (not (at s.live root)) (!= (at s.variants root) variant)) { return (refused s) }
    }
    if (not (fields_check s root fields fact.offset fact.count unpack)) { return (refused s) }
    return (transferred s root fields unpack true variant)
}
shadow union_transfer { assert (not (union_transfer (empty) 0 0 [] false).valid) }

pub fn region_begin(s: State) -> Transition {
    if (or (not s.valid) (== (at s.control 0) 4294967295)) { return (refused s) }
    let out: State = (clone s)
    (array_set out.control 0 (+ (at s.control 0) 1))
    return (accepted out)
}
shadow region_begin { assert (not (region_begin (empty)).valid) }

pub fn region_end(s: State) -> Transition {
    if (or (not s.valid) (== (at s.control 0) 0)) { return (refused s) }
    let out: State = (clone s)
    let mut i: int = 0
    while (< i (array_length s.references)) {
        let ref: Reference = (at s.references i)
        if (and ref.live (== ref.region (at s.control 0))) {
            let empty_ref: Reference = (empty_reference)
            (array_set out.references i empty_ref)
        }
        set i (+ i 1)
    }
    (array_set out.control 0 (- (at s.control 0) 1))
    return (accepted out)
}
shadow region_end { assert (not (region_end (empty)).valid) }

fn ancestor(s: State, possible: int, child: int) -> bool {
    let mut current: int = child
    let mut count: int = 0
    while (and (< count (array_length s.references)) (!= current 4294967295)) {
        if (== current possible) { return true }
        if (or (< current 0) (>= current (array_length s.references))) { return false }
        set current (at s.references current).parent
        set count (+ count 1)
    }
    return false
}
shadow ancestor { assert (not (ancestor (empty) 0 4294967295)) }

fn authoritative_root(s: State, place: places.Place) -> int {
    if (and (and (== place.invocation_low (at s.control 7)) (== place.invocation_high (at s.control 8)))
        (and (>= place.local 0) (< place.local (array_length s.facts.locals)))) { return (at s.facts.locals place.local).layout }
    let mut i: int = 0
    while (< i (array_length s.origins)) {
        let origin: Origin = (at s.origins i)
        if (and (== origin.low place.invocation_low)
            (and (== origin.high place.invocation_high) (== origin.local place.local))) { return origin.layout }
        set i (+ i 1)
    }
    return 4294967295
}
shadow authoritative_root { assert (== (authoritative_root (empty) (absent_place)) 4294967295) }

fn install(s: State, reference: int, place: places.Place, parent: int) -> Transition {
    if (or (not s.valid) (or (== (at s.control 0) 0)
        (or (< reference 0) (>= reference (array_length s.references))))) { return (refused s) }
    if (at s.references reference).live { return (refused s) }
    let layouts: places.Layouts = places.Layouts { present: true, items_present: true, rows: s.facts.rows }
    if (not (places.valid layouts (authoritative_root s place) place)) { return (refused s) }
    if (not (facts.resource_value s.facts (facts.slot 8 place.referent_layout))) { return (refused s) }
    let mut i: int = 0
    while (< i (array_length s.references)) {
        let ref: Reference = (at s.references i)
        if (and ref.live (and (not (ancestor s i parent)) (places.holds_conflict ref.place place))) { return (refused s) }
        set i (+ i 1)
    }
    let out: State = (clone s)
    let copied: places.Place = (clone_place place)
    (array_set out.references reference Reference { live: true, region: (at s.control 0), parent: parent, place: copied })
    return (accepted out)
}
shadow install { assert (not (install (empty) 0 (absent_place) 4294967295).valid) }

pub fn borrow_local(s: State, reference: int, root: int, path: array<int>, mode: int) -> Transition {
    if (not (value_local s root)) { return (refused s) }
    if (or (not (at s.live root)) (== (at s.facts.locals root).tag 7)) { return (refused s) }
    let found: Query = (resolve s root path)
    if (not found.valid) { return (refused s) }
    return (install s reference (owner_place s root path found.value.layout mode) 4294967295)
}
shadow borrow_local { assert (not (borrow_local (empty) 0 0 [] 1).valid) }

pub fn reborrow(s: State, reference: int, parent: int, mode: int) -> Transition {
    if (or (not s.valid) (or (< parent 0) (>= parent (array_length s.references)))) { return (refused s) }
    let ref: Reference = (at s.references parent)
    if (or (not ref.live) (or (>= ref.region (at s.control 0))
        (and (== mode 2) (!= ref.place.mode 2)))) { return (refused s) }
    let p: places.Place = ref.place
    let place: places.Place = places.Place { present: p.present, invocation_low: p.invocation_low, invocation_high: p.invocation_high,
        local: p.local, root_layout: p.root_layout, fields_present: p.fields_present, fields: p.fields, referent_layout: p.referent_layout, mode: mode }
    return (install s reference place parent)
}
shadow reborrow { assert (not (reborrow (empty) 0 0 1).valid) }

pub fn reference_access(s: State, reference: int, field: int, write: bool) -> bool {
    if (or (not s.valid) (or (< reference 0) (>= reference (array_length s.references)))) { return false }
    let ref: Reference = (at s.references reference)
    if (not ref.live) { return false }
    let row: places.Layout = (at s.facts.rows ref.place.referent_layout)
    if (or (< field 0) (or (>= field (array_length row.fields)) (and write (!= ref.place.mode 2)))) { return false }
    if (not (facts.scalar (at row.fields field).tag)) { return false }
    let mut i: int = 0
    while (< i (array_length s.references)) {
        let child: Reference = (at s.references i)
        if (and (!= i reference) (and child.live
            (and (ancestor s reference i) (or write (== child.place.mode 2))))) { return false }
        set i (+ i 1)
    }
    return true
}
shadow reference_access { assert (not (reference_access (empty) 0 0 false)) }

pub fn reference_field(s: State, reference: int, field: int, write: bool) -> Query {
    if (not (reference_access s reference field write)) { return (no_value) }
    let row: places.Layout = (at s.facts.rows (at s.references reference).place.referent_layout)
    let item: places.Field = (at row.fields field)
    return (value (facts.slot item.tag item.nested) 0)
}
