module nvm2c_module
module "src_nano/nvm2c/container.nano" as wire
module "src_nano/nvm2c/payloads.nano" as payload
module "src_nano/nvm2c/isa_metadata.nano" as isa
module "src_nano/nvm2c/instructions.nano" as instructions
module "src_nano/nvm2c/passive.nano" as passive
module "src_nano/nvm2c/passive_calls.nano" as calls
module "src_nano/nvm2c/ownership.nano" as owned
module "src_nano/nvm2c/routes.nano" as routes
module "src_nano/nvm2c/service_v2.nano" as service_v2
module "src_nano/nvm2c/service_module.nano" as service_module
module "src_nano/nvm2c/service_nominal.nano" as service_nominal

# Status -1 marks a profile I have not implemented, never successful admission.
pub struct ModuleView {
    status: int,
    features: int,
    entry: int,
    isa_version: int,
    code: array<u8>,
    passive: array<u8>,
    ownership: array<u8>,
    services: array<u8>,
    tables: array<payload.PayloadTable>,
    present: array<bool>
}

fn blank(status: int) -> ModuleView {
    let zero: array<u8> = [0, 0, 0, 0]
    let empty: payload.PayloadTable = (payload.decode zero 1)
    let mut tables: array<payload.PayloadTable> = []
    let mut present: array<bool> = []
    let mut i: int = 0
    while (< i 15) {
        set tables (array_push tables empty)
        set present (array_push present false)
        set i (+ i 1)
    }
    let code: array<u8> = []
    return ModuleView { status: status, features: 0, entry: 4294967295, isa_version: 0, code: code, passive: [], ownership: [], services: [], tables: tables, present: present }
}
shadow blank {
    let view: ModuleView = (blank 13)
    assert (== view.status 13)
    assert (== (array_length view.tables) 15)
    assert (== (array_length view.code) 0)
}

fn has_feature(features: int, flag: int) -> bool {
    return (== (% (/ features flag) 2) 1)
}
shadow has_feature {
    assert (has_feature 1023 512)
    assert (not (has_feature 8 32))
}

pub fn table(view: ModuleView, kind: int) -> payload.PayloadTable {
    if (or (< kind 0) (>= kind (array_length view.tables))) {
        let empty: array<u8> = []
        return (payload.decode empty 0)
    }
    return (at view.tables kind)
}
shadow table {
    let view: ModuleView = (blank 0)
    let empty: payload.PayloadTable = (table view 2)
    assert (== empty.status 0)
    let bad: payload.PayloadTable = (table view 15)
    assert (== bad.status 8)
}

fn count(view: ModuleView, kind: int) -> int {
    let section: payload.PayloadTable = (table view kind)
    return (array_length section.starts)
}
shadow count {
    let view: ModuleView = (blank 0)
    assert (== (count view 2) 0)
}

fn field(view: ModuleView, kind: int, row: int, offset: int, width: int) -> int {
    let section: payload.PayloadTable = (table view kind)
    if (or (< row 0) (>= row (array_length section.starts))) { return -1 }
    let position: int = (+ (at section.starts row) offset)
    if (== width 1) {
        if (not (wire.contains section.data position 1)) { return -1 }
        return (at section.data position)
    }
    if (== width 2) { return (wire.read_u16 section.data position) }
    if (== width 4) { return (wire.read_u32 section.data position) }
    if (== width 8) { return (wire.read_offset section.data position) }
    return -1
}
shadow field {
    let view: ModuleView = (blank 0)
    assert (== (field view 5 0 0 4) -1)
}

fn index_ok(index: int, length: int, optional: bool) -> bool {
    if (and optional (== index 4294967295)) { return true }
    return (and (>= index 0) (< index length))
}
shadow index_ok {
    assert (index_ok 4294967295 0 true)
    assert (not (index_ok 4294967295 0 false))
    assert (index_ok 0 1 false)
}

fn text_constant(view: ModuleView, index: int, absolute: bool) -> bool {
    if (not (index_ok index (count view 2) false)) { return false }
    let section: payload.PayloadTable = (table view 2)
    let row: int = (at section.starts index)
    let length: int = (wire.read_u32 section.data (+ row 4))
    if (or (!= (at section.data row) 5) (== length 0)) { return false }
    if absolute {
        if (!= (at section.data (+ row 8)) 47) { return false }
    }
    let mut i: int = 0
    while (< i length) {
        if (== (at section.data (+ (+ row 8) i)) 0) { return false }
        set i (+ i 1)
    }
    return true
}
shadow text_constant {
    let view: ModuleView = (blank 0)
    assert (not (text_constant view 0 false))
}

pub fn file_instructions(code: array<u8>, start: int, length: int) -> bool {
    return (instructions.has_file code start length)
}
shadow file_instructions {
    let operand: array<u8> = [1, 145, 0, 0, 0, 0, 0, 0, 0]
    assert (not (file_instructions operand 0 9))
    let file: array<u8> = [145]
    assert (file_instructions file 0 1)
    let unknown: array<u8> = [255, 145]
    assert (not (file_instructions unknown 0 2))
}

fn callback_scalar(tag: int) -> bool {
    return (or (and (>= tag 1) (<= tag 4)) (== tag 14))
}
shadow callback_scalar {
    assert (callback_scalar 14)
    assert (not (callback_scalar 5))
}

fn callback_shape(view: ModuleView, signature: int) -> bool {
    let signatures: payload.PayloadTable = (table view 3)
    let row: int = (at signatures.starts signature)
    let params: int = (wire.read_u16 signatures.data row)
    let results: int = (wire.read_u16 signatures.data (+ row 2))
    if (or (> params 16) (> results 1)) { return false }
    let mut p: int = 0
    while (< p params) {
        if (not (callback_scalar (at signatures.data (+ (+ row 4) p)))) { return false }
        set p (+ p 1)
    }
    if (== results 1) {
        let result_position: int = (+ (+ row 4) (* (/ (+ params 3) 4) 4))
        if (not (callback_scalar (at signatures.data result_position))) { return false }
    }
    return true
}
shadow callback_shape {
    let zero: array<u8> = [1, 0, 0, 0, 0, 0, 0, 0]
    let mut view: ModuleView = (blank 0)
    (array_set view.tables 3 (payload.decode zero 3))
    assert (callback_shape view 0)
}

fn callbacks(view: ModuleView) -> int {
    let signatures: payload.PayloadTable = (table view 3)
    let mut begin: int = 0
    while (< begin (count view 11)) {
        let owner: int = (field view 11 begin 0 4)
        if (not (index_ok owner (count view 8) false)) { return 13 }
        let import_signature: int = (field view 8 owner 8 4)
        let signature_row: int = (at signatures.starts import_signature)
        let params: int = (wire.read_u16 signatures.data signature_row)
        if (> params 16) { return 13 }
        let mut expected: array<bool> = []
        let mut actual: array<bool> = []
        let mut any: bool = false
        let mut p: int = 0
        while (< p params) {
            let tag: int = (at signatures.data (+ (+ signature_row 4) p))
            let callable: bool = (or (== tag 11) (== tag 15))
            set expected (array_push expected callable)
            set actual (array_push actual false)
            if callable { set any true }
            set p (+ p 1)
        }
        let mut end: int = begin
        while (< end (count view 11)) {
            if (!= (field view 11 end 0 4) owner) { break }
            let adapter: int = (field view 11 end 12 4)
            if (not (index_ok adapter (count view 2) false)) { return 13 }
            if (not (text_constant view adapter false)) { return 8 }
            if (!= (field view 11 end 7 1) (field view 11 begin 7 1)) { return 8 }
            if (!= adapter (field view 11 begin 12 4)) { return 8 }
            let parameter: int = (field view 11 end 4 2)
            let signature: int = (field view 11 end 8 4)
            if (== parameter 65535) {
                if (or any (!= end begin)) { return 13 }
                if (!= signature 4294967295) { return 13 }
            } else {
                if (not (index_ok parameter params false)) { return 13 }
                if (not (at expected parameter)) { return 13 }
                if (not (index_ok signature (count view 3) false)) { return 13 }
                if (not (callback_shape view signature)) { return 8 }
                (array_set actual parameter true)
            }
            set end (+ end 1)
        }
        set p 0
        while (< p params) {
            if (!= (at expected p) (at actual p)) { return 13 }
            set p (+ p 1)
        }
        set begin end
    }
    return 0
}
shadow callbacks {
    let view: ModuleView = (blank 0)
    assert (== (callbacks view) 0)
}

# I adapt structurally decoded tables before general cross-section references.
fn service_view(view: ModuleView) -> service_v2.View {
    let constants: payload.PayloadTable = (table view 2)
    let mut values: array<service_v2.Constant> = []
    let mut i: int = 0
    while (< i (count view 2)) {
        let row: int = (at constants.starts i)
        set values (array_push values service_v2.Constant { tag: (field view 2 i 0 1), bytes: (array_slice constants.data (+ row 8) (field view 2 i 4 4)) })
        set i (+ i 1)
    }
    let signatures: payload.PayloadTable = (table view 3)
    let mut shapes: array<service_v2.Signature> = []
    set i 0
    while (< i (count view 3)) {
        let row: int = (at signatures.starts i)
        let arity: int = (field view 3 i 0 2)
        let results: int = (field view 3 i 2 2)
        let mut params: array<int> = []
        let mut returns: array<int> = []
        let mut j: int = 0
        while (< j arity) {
            set params (array_push params (cast_int (at signatures.data (+ (+ row 4) j))))
            set j (+ j 1)
        }
        let result_start: int = (+ (+ row 4) (+ arity (% (- 4 (% arity 4)) 4)))
        set j 0
        while (< j results) {
            set returns (array_push returns (cast_int (at signatures.data (+ result_start j))))
            set j (+ j 1)
        }
        set shapes (array_push shapes service_v2.Signature { arity: arity, results: results, params: params, returns: returns })
        set i (+ i 1)
    }
    let mut functions: array<service_v2.Function> = []
    set i 0
    while (< i (count view 5)) {
        set functions (array_push functions service_v2.Function { signature: (field view 5 i 4 4), locals: (field view 5 i 24 2), start: (field view 5 i 8 8), length: (field view 5 i 16 8) })
        set i (+ i 1)
    }
    let mut imports: array<service_v2.Import> = []
    set i 0
    while (< i (count view 8)) {
        set imports (array_push imports service_v2.Import { module_name: (field view 8 i 0 4), symbol: (field view 8 i 4 4), signature: (field view 8 i 8 4), kind: (field view 8 i 12 1) })
        set i (+ i 1)
    }
    return service_v2.View { features: view.features, constants: values, signatures: shapes, layouts: (payload.reencode (table view 4)), functions: functions, imports: imports, code: view.code, service: view.services, ownership: view.ownership, links: (count view 9), callbacks: (count view 11) }
}
shadow service_view {
    let view: service_v2.View = (service_view (blank 0))
    assert (== (array_length view.constants) 0)
    assert (== (array_length view.layouts) 4)
    assert (== (service_v2.validate view false) 0)
}

fn references(view: ModuleView) -> int {
    let mut i: int = 0
    while (< i (count view 5)) {
        if (not (index_ok (field view 5 i 0 4) (count view 2) false)) { return 13 }
        if (not (index_ok (field view 5 i 4 4) (count view 3) false)) { return 13 }
        if (not (wire.contains view.code (field view 5 i 8 8) (field view 5 i 16 8))) { return 13 }
        set i (+ i 1)
    }
    set i 0
    while (< i (count view 7)) {
        if (not (index_ok (field view 7 i 0 4) (count view 2) false)) { return 13 }
        if (not (index_ok (field view 7 i 8 4) (count view 2) true)) { return 13 }
        set i (+ i 1)
    }
    set i 0
    while (< i (count view 8)) {
        if (not (index_ok (field view 8 i 0 4) (count view 2) false)) { return 13 }
        if (not (index_ok (field view 8 i 4 4) (count view 2) false)) { return 13 }
        if (not (index_ok (field view 8 i 8 4) (count view 3) false)) { return 13 }
        if (== (field view 8 i 12 1) 2) {
            if (not (text_constant view (field view 8 i 0 4) true)) { return 8 }
        }
        set i (+ i 1)
    }
    let callback_status: int = (callbacks view)
    if (!= callback_status 0) { return callback_status }
    set i 0
    while (< i (count view 9)) {
        if (not (index_ok (field view 9 i 0 4) (count view 2) false)) { return 13 }
        if (not (index_ok (field view 9 i 4 4) (count view 2) true)) { return 13 }
        if (not (index_ok (field view 9 i 8 4) (count view 3) true)) { return 13 }
        set i (+ i 1)
    }
    let layouts: payload.PayloadTable = (table view 4)
    set i 0
    while (< i (count view 4)) {
        let row: int = (at layouts.starts i)
        if (not (index_ok (wire.read_u32 layouts.data (+ row 4)) (count view 2) true)) { return 13 }
        let mut f: int = 0
        while (< f (wire.read_u16 layouts.data (+ row 2))) {
            let position: int = (+ (+ row 8) (* f 12))
            if (not (index_ok (wire.read_u32 layouts.data (+ position 8)) (count view 2) true)) { return 13 }
            if (not (index_ok (wire.read_u32 layouts.data (+ position 4)) (count view 4) true)) { return 13 }
            set f (+ f 1)
        }
        set i (+ i 1)
    }
    set i 0
    while (< i (count view 1)) {
        if (not (index_ok (field view 1 i 0 4) (count view 2) false)) { return 13 }
        if (not (index_ok (field view 1 i 4 4) (count view 2) false)) { return 13 }
        set i (+ i 1)
    }
    if (not (index_ok view.entry (count view 5) true)) { return 13 }
    return 0
}
shadow references {
    let view: ModuleView = (blank 0)
    assert (== (references view) 0)
}

fn features(view: ModuleView) -> int {
    let flags: int = view.features
    if (!= (has_feature flags 32) (> (count view 11) 0)) { return 14 }
    if (and (> (count view 9) 0) (not (has_feature flags 1))) { return 14 }
    if (and (> (count view 8) 0) (not (has_feature flags 2))) { return 14 }
    if (and (at view.present 10) (not (has_feature flags 8))) { return 14 }
    let mut i: int = 0
    while (< i (count view 8)) {
        if (and (== (field view 8 i 12 1) 1) (not (has_feature flags 4))) { return 14 }
        set i (+ i 1)
    }
    set i 0
    while (< i (count view 4)) {
        if (or (!= (field view 4 i 4 4) 4294967295) (> (field view 4 i 2 2) 0)) {
            if (not (has_feature flags 128)) { return 14 }
        }
        set i (+ i 1)
    }
    if (!= (has_feature flags 64) (> (array_length view.passive) 0)) { return 14 }
    if (!= (has_feature flags 256) (> (array_length view.ownership) 0)) { return 14 }
    return 0
}
shadow features {
    let view: ModuleView = (blank 0)
    assert (== (features view) 0)
}

fn same_string(constants: payload.PayloadTable, left: int, right: int) -> bool {
    let a: int = (at constants.starts left)
    let b: int = (at constants.starts right)
    let length: int = (wire.read_u32 constants.data (+ a 4))
    if (!= length (wire.read_u32 constants.data (+ b 4))) { return false }
    let mut i: int = 0
    while (< i length) {
        if (!= (at constants.data (+ (+ a 8) i)) (at constants.data (+ (+ b 8) i))) { return false }
        set i (+ i 1)
    }
    return true
}
shadow same_string {
    let bytes: array<u8> = [2,0,0,0,5,0,0,0,1,0,0,0,65,0,0,0,5,0,0,0,1,0,0,0,65,0,0,0]
    let constants: payload.PayloadTable = (payload.decode bytes 2)
    assert (same_string constants 0 1)
    (array_set bytes 24 66)
    assert (not (same_string constants 0 1))
    assert (same_string constants 1 1)
}

# I preserve conversion, routing, ownership and passive order before publication.
# Core references/features and unsupported-profile selection have already run.
fn convert_claims(view: ModuleView) -> int {
    let constants: payload.PayloadTable = (table view 2)
    let mut i: int = 0
    while (< i (array_length constants.starts)) {
        let row: int = (at constants.starts i)
        if (!= (at constants.data row) 5) { return 8 }
        let mut j: int = 0
        while (< j i) {
            if (same_string constants i j) { return 13 }
            set j (+ j 1)
        }
        set i (+ i 1)
    }
    if (> (array_length view.code) 4294967295) { return 13 }
    let signatures: payload.PayloadTable = (table view 3)
    let mut functions: array<calls.Function> = []
    let mut results_tags: array<int> = []
    let mut names: array<array<u8>> = []
    let mut string_index: int = 0
    while (< string_index (count view 2)) {
        let row: int = (at constants.starts string_index)
        set names (array_push names (array_slice constants.data (+ row 8) (wire.read_u32 constants.data (+ row 4))))
        set string_index (+ string_index 1)
    }
    let mut params: array<array<int>> = []
    set i 0
    while (< i (count view 5)) {
        let row: int = (at signatures.starts (field view 5 i 4 4))
        let arity: int = (wire.read_u16 signatures.data row)
        let results: int = (wire.read_u16 signatures.data (+ row 2))
        let start: int = (field view 5 i 8 8)
        let length: int = (field view 5 i 16 8)
        if (or (< start 0) (or (> start 4294967295) (or (< length 0) (or (> length 4294967295) (> results 255))))) { return 13 }
        let mut tags: array<int> = []
        let mut j: int = 0
        while (< j arity) {
            set tags (array_push tags (cast_int (at signatures.data (+ (+ row 4) j))))
            set j (+ j 1)
        }
        set functions (array_push functions calls.Function {
            start: start, length: length, arity: arity, results: results,
            locals: (field view 5 i 24 2), upvalues: (field view 5 i 26 2) })
        let mut result_tag: int = 0
        if (> results 0) { set result_tag (cast_int (at signatures.data (+ (+ (+ row 4) arity) (% (- 4 (% arity 4)) 4)))) }
        set results_tags (array_push results_tags result_tag)
        set params (array_push params tags)
        set i (+ i 1)
    }
    # Import/callback construction adds no new nonallocation refusal after my
    # core callback checks. Debug offsets must still fit the narrow carrier.
    set i 0
    while (< i (count view 10)) {
        let offset: int = (field view 10 i 0 8)
        if (or (< offset 0) (> offset 4294967295)) { return 13 }
        set i (+ i 1)
    }
    # Canonical layout re-encoding drops permitted table tails. Names, kinds,
    # counts and the public layout DAG were checked before this conversion.
    if (has_feature view.features 128) {
        let mut bytes: int = 4
        set i 0
        while (< i (count view 4)) {
            set bytes (+ bytes (+ 8 (* 12 (field view 4 i 2 2))))
            if (> bytes 4294967295) { return 13 }
            set i (+ i 1)
        }
    }
    let mut retained: array<u8> = []
    if (has_feature view.features 128) { set retained (payload.reencode (table view 4)) }
    let mut records: int = 0
    let mut enums: int = 0
    let mut unions: int = 0
    set i 0
    while (< i (count view 4)) {
        let kind: int = (field view 4 i 0 1)
        if (== kind 0) { set records (+ records 1) }
        if (== kind 3) { set enums (+ enums 1) }
        if (== kind 2) { set unions (+ unions 1) }
        set i (+ i 1)
    }
    let model: owned.Module = owned.Module { layouts: retained, code: view.code, strings: names, functions: functions, params: params, results: results_tags, records: records, enums: enums, unions: unions }
    let rich: service_v2.View = (service_view view)
    let selection: routes.Selection = (routes.classify view.ownership model (> (array_length view.services) 0) false 0)
    if (or (== selection.maps 2) (or (== selection.maps 3) (== selection.owners 2))) { return 13 }
    if (or (== selection.maps 1) (or selection.arrays (or (== selection.owners 1) selection.mixed))) { return -1 }
    if (service_v2.present rich) {
        let imports: array<service_v2.Import> = rich.imports
        let signatures: array<service_v2.Signature> = rich.signatures
        let mut entries: array<service_nominal.Import> = []
        set i 0
        while (< i (array_length imports)) {
            let item: service_v2.Import = (at imports i)
            let shape: service_v2.Signature = (at signatures item.signature)
            let mut result: int = 0
            if (> shape.results 0) { set result (at shape.returns 0) }
            set entries (array_push entries service_nominal.Import { module_name: item.module_name, symbol: item.symbol, kind: item.kind, arity: shape.arity, result: result, params: shape.params })
            set i (+ i 1)
        }
        let service_status: int = (service_module.validate view.services view.ownership model entries (count view 9) (count view 11))
        if (!= service_status 0) { return service_status }
        if (service_module.nominal_version view.services) {
            if (not (passive.validate view.passive view.code functions params)) { return 13 }
            return 0
        }
    }
    let declarations: owned.Declaration = (owned.validate view.ownership model)
    if (!= declarations.status 0) { return declarations.status }
    if (not (passive.validate view.passive view.code functions params)) { return 13 }
    return 0
}
shadow convert_claims {
    let view: ModuleView = (blank 0)
    assert (== (convert_claims view) 0)
    let bytes: array<u8> = [2,0,0,0,5,0,0,0,1,0,0,0,65,0,0,0,5,0,0,0,1,0,0,0,65,0,0,0]
    (array_set view.tables 2 (payload.decode bytes 2))
    assert (== (convert_claims view) 13)
}

# Private array/map layout profiles must not pass through the public decoder.
fn profile_layout(bytes: array<u8>) -> bool {
    let count: int = (wire.read_u32 bytes 0)
    if (or (< count 0) (> count (/ (- (array_length bytes) 4) 8))) { return false }
    let mut i: int = 0
    let mut cursor: int = 4
    while (< i count) {
        if (not (wire.contains bytes cursor 8)) { return false }
        let fields: int = (wire.read_u16 bytes (+ cursor 2))
        set cursor (+ cursor 8)
        if (> fields (/ (- (array_length bytes) cursor) 12)) { return false }
        let mut f: int = 0
        while (< f fields) {
            let tag: int = (at bytes cursor)
            if (or (== tag 7) (== tag 13)) { return true }
            set cursor (+ cursor 12)
            set f (+ f 1)
        }
        set i (+ i 1)
    }
    return false
}
shadow profile_layout {
    let empty: array<u8> = [0, 0, 0, 0]
    assert (not (profile_layout empty))
}

pub fn decode_core(bytes: array<u8>) -> ModuleView {
    let status: int = (wire.validate bytes)
    if (!= status 0) { return (blank status) }
    let base: ModuleView = (blank 0)
    let tables: array<payload.PayloadTable> = base.tables
    let present: array<bool> = base.present
    let mut code: array<u8> = []
    let mut passive_bytes: array<u8> = []
    let sections: int = (wire.read_u32 bytes 24)
    let mut i: int = 0
    let mut ownership_bytes: array<u8> = []
    let mut raw_layouts: array<u8> = []
    let mut layout_present: bool = false
    let mut owned_present: bool = false
    let mut service_bytes: array<u8> = []
    while (< i sections) {
        let entry: int = (+ 40 (* i 24))
        let kind: int = (wire.read_u32 bytes entry)
        let start: int = (wire.read_offset bytes (+ entry 8))
        let length: int = (wire.read_offset bytes (+ entry 16))
        if (== kind 4) { set layout_present true set raw_layouts (array_slice bytes start length) }
        if (== kind 13) { set owned_present true set ownership_bytes (array_slice bytes start length) }
        if (== kind 14) { set service_bytes (array_slice bytes start length) }
        set i (+ i 1)
    }
    let map_route: int = (routes.map_route raw_layouts ownership_bytes layout_present owned_present)
    if (or (== map_route 2) (== map_route 3)) { return (blank 13) }
    if (or (== map_route 1) (profile_layout raw_layouts)) { return (blank -1) }
    set i 0
    while (< i sections) {
        let entry: int = (+ 40 (* i 24))
        let kind: int = (wire.read_u32 bytes entry)
        let start: int = (wire.read_offset bytes (+ entry 8))
        let length: int = (wire.read_offset bytes (+ entry 16))
        let data: array<u8> = (array_slice bytes start length)
        (array_set present kind true)
        if (== kind 6) {
            set code data
        } else if (== kind 14) {
            let fixed: bool = (or (== length 56) (or (== length 120) (== length 128)))
            let multiple: bool = (and (and (>= length 80) (<= length 4112)) (and (== (at data 0) 3) (== (at data 1) 0)))
            if (not (or fixed multiple)) { return (blank 9) }
        } else if (== kind 13) {
            if (or (== length 0) (> length 4294967295)) { return (blank 9) }
        } else if (== kind 12) {
            if (or (== length 0) (> length 4294967295)) { return (blank 9) }
            set passive_bytes data
        } else {
            let decoded: payload.PayloadTable = (payload.decode data kind)
            if (!= decoded.status 0) { return (blank decoded.status) }
            (array_set tables kind decoded)
        }
        set i (+ i 1)
    }
    let view: ModuleView = ModuleView { status: 0, features: (wire.read_u32 bytes 8), entry: (wire.read_u32 bytes 28), isa_version: (wire.read_u16 bytes 6), code: code, passive: passive_bytes, ownership: ownership_bytes, services: service_bytes, tables: tables, present: present }
    let service_status: int = (service_v2.validate (service_view view) false)
    if (!= service_status 0) { return (blank service_status) }
    if (!= (has_feature view.features 512) (> (array_length service_bytes) 0)) { return (blank 14) }
    let reference_status: int = (references view)
    if (!= reference_status 0) { return (blank reference_status) }
    let feature_status: int = (features view)
    if (!= feature_status 0) { return (blank feature_status) }
    if (or (> (array_length service_bytes) 0) (or (> (array_length passive_bytes) 0) (> (array_length ownership_bytes) 0))) {
        let converted: int = (convert_claims view)
        if (!= converted 0) { return (blank converted) }
    }
    return view
}
shadow decode_core {
    let header: array<u8> = [78, 86, 77, 2, 1, 0, 2, 0, 0, 0, 0, 0, 40, 0, 0, 0, 0, 0, 0, 0, 40, 0, 0, 0, 0, 0, 0, 0, 255, 255, 255, 255, 0, 0, 0, 0, 0, 0, 0, 0]
    let view: ModuleView = (decode_core header)
    assert (== view.status 0)
    assert (== (count view 5) 0)
    let empty: array<u8> = []
    let bad: ModuleView = (decode_core empty)
    assert (== bad.status 1)
}
