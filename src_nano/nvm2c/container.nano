module nvm2c_container

# I decode the v2 container. Payload validation and executable admission follow.
pub fn contains(bytes: array<u8>, offset: int, count: int) -> bool {
    if (or (< offset 0) (< count 0)) { return false }
    if (> offset (array_length bytes)) { return false }
    return (<= count (- (array_length bytes) offset))
}

shadow contains {
    let bytes: array<u8> = [1, 2, 3]
    assert (contains bytes 3 0)
    assert (contains bytes 1 2)
    assert (not (contains bytes -1 1))
    assert (not (contains bytes 1 3))
    assert (not (contains bytes 9223372036854775807 1))
}

pub fn read_u16(bytes: array<u8>, offset: int) -> int {
    if (not (contains bytes offset 2)) { return -1 }
    return (+ (at bytes offset) (* (at bytes (+ offset 1)) 256))
}

shadow read_u16 {
    let bytes: array<u8> = [255, 128, 1]
    assert (== (read_u16 bytes 0) 33023)
    assert (== (read_u16 bytes 1) 384)
    assert (== (read_u16 bytes 2) -1)
}

pub fn read_u32(bytes: array<u8>, offset: int) -> int {
    if (not (contains bytes offset 4)) { return -1 }
    return (+ (read_u16 bytes offset) (* (read_u16 bytes (+ offset 2)) 65536))
}

shadow read_u32 {
    let bytes: array<u8> = [255, 255, 255, 255]
    assert (== (read_u32 bytes 0) 4294967295)
    assert (== (read_u32 bytes -1) -1)
}

# I use -1 for unsigned offsets outside my addressable signed-int range.
pub fn read_offset(bytes: array<u8>, offset: int) -> int {
    if (not (contains bytes offset 8)) { return -1 }
    if (>= (at bytes (+ offset 7)) 128) { return -1 }
    return (+ (read_u32 bytes offset) (* (read_u32 bytes (+ offset 4)) 4294967296))
}

shadow read_offset {
    let bytes: array<u8> = [255, 255, 255, 255, 255, 255, 255, 127]
    assert (== (read_offset bytes 0) 9223372036854775807)
    let high: array<u8> = [0, 0, 0, 0, 0, 0, 0, 128]
    assert (== (read_offset high 0) -1)
    assert (== (read_offset bytes 1) -1)
}

# I keep CRC arithmetic in nonnegative 32-bit values without host helpers.
fn xor32(left: int, right: int) -> int {
    let mut a: int = left
    let mut b: int = right
    let mut place: int = 1
    let mut result: int = 0
    while (or (> a 0) (> b 0)) {
        if (!= (% a 2) (% b 2)) { set result (+ result place) }
        set a (/ a 2)
        set b (/ b 2)
        set place (* place 2)
    }
    return result
}

shadow xor32 {
    assert (== (xor32 4294967295 3988292384) 306674911)
    assert (== (xor32 4294967295 4294967295) 0)
    assert (== (xor32 0 255) 255)
}

pub fn crc32(bytes: array<u8>, offset: int, count: int) -> int {
    if (not (contains bytes offset count)) { return -1 }
    let mut crc: int = 4294967295
    let mut i: int = offset
    while (< i (+ offset count)) {
        set crc (xor32 crc (at bytes i))
        let mut bit: int = 0
        while (< bit 8) {
            let low: int = (% crc 2)
            set crc (/ crc 2)
            if (== low 1) { set crc (xor32 crc 3988292384) }
            set bit (+ bit 1)
        }
        set i (+ i 1)
    }
    return (xor32 crc 4294967295)
}

shadow crc32 {
    let bytes: array<u8> = [49, 50, 51, 52, 53, 54, 55, 56, 57]
    assert (== (crc32 bytes 0 9) 3421780262)
    assert (== (crc32 bytes 9 0) 0)
    assert (== (crc32 bytes 9 1) -1)
}

# My result codes match NvmV2Result for this container boundary only.
pub fn validate(bytes: array<u8>) -> int {
    let length: int = (array_length bytes)
    if (< length 40) { return 1 }
    if (or (!= (at bytes 0) 78) (!= (at bytes 1) 86)) { return 2 }
    if (or (!= (at bytes 2) 77) (!= (at bytes 3) 2)) { return 2 }
    if (!= (read_u16 bytes 4) 1) { return 3 }
    if (!= (read_u32 bytes 20) 40) { return 4 }
    if (> (read_u32 bytes 8) 1023) { return 5 }
    if (!= (read_offset bytes 12) length) { return 6 }
    if (!= (read_u32 bytes 32) 0) { return 7 }
    let count: int = (read_u32 bytes 24)
    if (> count (/ (- length 40) 24)) { return 1 }
    let floor: int = (+ 40 (* count 24))
    let mut i: int = 0
    while (< i count) {
        let entry: int = (+ 40 (* i 24))
        let kind: int = (read_u32 bytes entry)
        if (!= (read_u32 bytes (+ entry 4)) 0) { return 7 }
        if (or (< kind 1) (> kind 14)) { return 8 }
        let mut prior: int = 0
        while (< prior i) {
            if (== kind (read_u32 bytes (+ 40 (* prior 24)))) { return 11 }
            set prior (+ prior 1)
        }
        let offset: int = (read_offset bytes (+ entry 8))
        let size: int = (read_offset bytes (+ entry 16))
        if (not (contains bytes offset size)) { return 9 }
        if (and (!= size 0) (< offset floor)) { return 10 }
        set i (+ i 1)
    }
    set i 0
    while (< i count) {
        let entry: int = (+ 40 (* i 24))
        let start: int = (read_offset bytes (+ entry 8))
        let size: int = (read_offset bytes (+ entry 16))
        let mut j: int = (+ i 1)
        while (< j count) {
            let other: int = (+ 40 (* j 24))
            let other_start: int = (read_offset bytes (+ other 8))
            let other_size: int = (read_offset bytes (+ other 16))
            if (and (> size 0) (> other_size 0)) {
                let left: bool = (and (>= start other_start) (>= (- start other_start) other_size))
                let right: bool = (and (>= other_start start) (>= (- other_start start) size))
                if (not (or left right)) { return 10 }
            }
            set j (+ j 1)
        }
        set i (+ i 1)
    }
    if (!= (crc32 bytes 40 (- length 40)) (read_u32 bytes 36)) { return 12 }
    return 0
}

shadow validate {
    let empty: array<u8> = []
    assert (== (validate empty) 1)
    let header: array<u8> = [78, 86, 77, 2, 1, 0, 2, 0, 0, 0, 0, 0, 40, 0, 0, 0, 0, 0, 0, 0, 40, 0, 0, 0, 0, 0, 0, 0, 255, 255, 255, 255, 0, 0, 0, 0, 0, 0, 0, 0]
    assert (== (validate header) 0)
}
