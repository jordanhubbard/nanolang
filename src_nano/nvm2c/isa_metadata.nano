pub fn primary_name(opcode: int) -> string {
    if (or (< opcode 0) (> opcode 255)) { return "UNKNOWN" }
    return (at nvm2c_primary_names opcode)
}

shadow primary_name {
    assert (== (primary_name 1) "PUSH_I64")
    assert (== (primary_name 32) "ADD")
    assert (== (primary_name 192) "I64_ADD")
    assert (== (primary_name 255) "UNKNOWN")
    assert (== (primary_name -1) "UNKNOWN")
}

pub fn primary_width(opcode: int) -> int {
    if (or (< opcode 0) (> opcode 255)) { return 0 }
    return (at nvm2c_primary_widths opcode)
}

shadow primary_width {
    assert (== (primary_width 0) 1)
    assert (== (primary_width 1) 9)
    assert (== (primary_width 255) 0)
    assert (== (primary_width -1) 0)
    assert (== (primary_width 256) 0)
}

pub fn primary_operands(opcode: int) -> int {
    if (or (< opcode 0) (> opcode 255)) { return -1 }
    return (at nvm2c_primary_counts opcode)
}

shadow primary_operands {
    assert (== (primary_operands 0) 0)
    assert (== (primary_operands 15) 2)
    assert (== (primary_operands 255) -1)
    assert (== (primary_operands -1) -1)
}

pub fn primary_pops(opcode: int) -> int {
    if (or (< opcode 0) (> opcode 255)) { return -1 }
    return (at nvm2c_primary_pops opcode)
}

shadow primary_pops {
    assert (== (primary_pops 0) 0)
    assert (== (primary_pops 32) 2)
    assert (== (primary_pops 255) -1)
    assert (== (primary_pops 256) -1)
}

pub fn primary_pushes(opcode: int) -> int {
    if (or (< opcode 0) (> opcode 255)) { return -1 }
    return (at nvm2c_primary_pushes opcode)
}

shadow primary_pushes {
    assert (== (primary_pushes 0) 0)
    assert (== (primary_pushes 1) 1)
    assert (== (primary_pushes 255) -1)
    assert (== (primary_pushes -1) -1)
}

pub fn primary_kind(opcode: int, operand: int) -> int {
    if (or (< operand 0) (>= operand (primary_operands opcode))) { return 0 }
    return (at nvm2c_primary_kinds (+ (* opcode 4) operand))
}

shadow primary_kind {
    assert (== (primary_kind 1 0) 5)
    assert (== (primary_kind 15 1) 2)
    assert (== (primary_kind 1 1) 0)
    assert (== (primary_kind -1 0) 0)
    assert (== (primary_kind 1 -1) 0)
}
