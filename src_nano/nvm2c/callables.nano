pub fn analyze(input: Module) -> Analysis {
    let a: Context = (context input)
    let valid: bool = (execute a)
    let mut error: string = (at a.message 0)
    if (and (not valid) (== error "")) {
        set error (shape.error (graph a))
        if (== error "") { set error "I cannot construct callable constraints" }
    }
    return Analysis { valid: valid, graph: (graph a), callees: a.callees, projections: a.projections, lengths: a.lengths, error: error }
}
