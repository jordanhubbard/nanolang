fn connect_aliases(a: Context) -> int {
    let mut changed: int = 0
    let conversions: array<int> = (at a.flows 0)
    let mut c: int = 0
    while (< c (array_length conversions)) {
        let mut pairs: array<int> = [(at conversions c),(at conversions (+ c 1))] set c (+ c 2)
        let mut cursor: int = 0
        while (and (< cursor (array_length pairs)) (shape.healthy (graph a))) {
            let source: int = (shape.root (graph a) (at pairs cursor))
            let target: int = (shape.root (graph a) (at pairs (+ cursor 1))) set cursor (+ cursor 2)
            if (== source target) { continue }
            let kind: int = (shape.kind (graph a) source)
            if (!= kind (shape.kind (graph a) target)) { continue }
            if (or (== kind 3) (== kind 5)) {
                let mut fields: int = 1 if (== kind 5) { set fields 2 }
                for f in (range 0 fields) {
                    if (not (shape.healthy (graph a))) { break }
                    let origin: int = (field a source f) let to: int = (field a target f)
                    if (!= (shape.root (graph a) origin) (shape.root (graph a) to)) {
                        if (== (accept a (shape.unify (graph a) origin to)) 0) { break }
                        set changed 1
                    }
                }
            } else if (== kind 4) {
                let variants: array<int> = (at a.variants 0)
                for f in (range 0 (+ (at a.counts 1) (array_length variants))) {
                    let mut key: int = f
                    if (>= f (at a.counts 1)) { set key (+ 65536 (at variants (- f (at a.counts 1)))) }
                    let origin: int = (shape.lookup (graph a) source key)
                    let to: int = (shape.lookup (graph a) target key)
                    if (or (== origin 0) (or (== to 0) (== origin to))) { continue }
                    let mut seen: bool = false let mut i: int = 0
                    while (< i (array_length pairs)) {
                        if (and (== (shape.root (graph a) (at pairs i)) origin)
                            (== (shape.root (graph a) (at pairs (+ i 1))) to)) { set seen true break }
                        set i (+ i 2)
                    }
                    if (not seen) { set pairs (array_push pairs origin) set pairs (array_push pairs to) }
                }
            }
        }
        if (not (shape.healthy (graph a))) { return -1 }
    }
    return changed
}
shadow connect_aliases { assert (== (connect_aliases (context (empty_module))) 0) }

fn prepare(a: Context) -> bool {
    let m: Module = a.input
    if (== (array_length m.functions) 0) { return (fail a "I require callable module functions") }
    for f in (range 0 (array_length m.functions)) {
        let entry: Function = (at m.functions f)
        if (or (or (< entry.arity 0) (> entry.arity 65535)) (or (< entry.locals 0) (> entry.locals 65535))) { return false }
        if (or (or (< entry.upvalues 0) (> entry.upvalues 65535)) (or (< entry.results 0) (> entry.results 255))) { return false }
        if (or (> entry.arity entry.locals) (not (wire.contains m.code entry.start entry.length))) { return false }
        if (or (> entry.start 4294967295) (> entry.length 4294967295)) { return false }
        (array_set a.lengths f entry.length)
        (array_set a.callees f (zeros entry.length)) (array_set a.projections f (zeros entry.length))
        (array_set a.results f (fresh a))
        let mut locals: array<int> = [] let mut captures: array<int> = []
        for i in (range 0 entry.locals) { set locals (array_push locals (fresh a)) }
        for i in (range 0 entry.upvalues) { set captures (array_push captures (fresh a)) }
        (array_set a.locals f locals) (array_set a.captures f captures)
        let mut pc: int = 0
        while (< pc entry.length) {
            let item: primary.Instruction = (primary.decode m.code (+ entry.start pc) (- entry.length pc))
            if (== item.length 0) { return false }
            let op: int = item.opcode
            let mut fields: int = 0
            if (== op 251) { set fields (primary.integer item 3) }
            if (== op 252) { set fields (+ (primary.integer item 0) 1) }
            if (> fields (at a.counts 1)) { (array_set a.counts 1 fields) }
            if (and (== op 251) (== (primary.integer item 0) 1)) {
                let variant: int = (primary.integer item 2)
                if (not (contains (at a.variants 0) variant)) { (array_set a.variants 0 (array_push (at a.variants 0) variant)) }
            }
            if (or (== op 18) (== op 19)) {
                let slot: int = (primary.integer item 0)
                if (>= slot 4096) { return false }
                if (>= slot (at a.counts 0)) { (array_set a.counts 0 (+ slot 1)) }
            }
            set pc (+ pc item.length)
        }
    }
    let mut globals: array<int> = []
    for i in (range 0 (at a.counts 0)) { set globals (array_push globals (fresh a)) }
    (array_set a.globals 0 globals)
    let mut functions: array<effects.Function> = []
    for f in (range 0 (array_length m.functions)) {
        let entry: Function = (at m.functions f)
        set functions (array_push functions effects.Function { start: entry.start, length: entry.length, locals: entry.locals })
    }
    let handlers: effects.Collection = (effects.collect m.code functions m.names)
    if (not handlers.valid) { return false }
    (array_set a.handlers 0 handlers.handlers)
    let mut results: array<int> = []
    for i in (range 0 (array_length m.names)) { set results (array_push results (fresh a)) }
    (array_set a.effect_results 0 results)
    return true
}
