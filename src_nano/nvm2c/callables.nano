            if (!= pop 0) { if (not (flow a (at stack base) (at a.results function))) { return false } }
        } else { for i in (range 0 push) { if (not (tags a (at output i) (producer_tags op))) { return false } } }
        if (and (!= push 0) (or (or (== op 80) (== op 88)) (or (== op 86) (== op 77)))) {
