fn execute(a: Context) -> bool {
    if (not (prepare a)) { return false }
    for f in (range 0 (array_length a.input.functions)) { if (not (collect_function a f)) { return false } }
    while true {
        if (== (accept a (shape.solve (graph a))) 0) { return false }
        let alias_changes: int = (connect_aliases a)
        if (< alias_changes 0) { return false }
        let mut changed: bool = (!= alias_changes 0)
        let calls: array<Call> = (at a.calls 0)
        for c in (range 0 (array_length calls)) {
            let call: Call = (at calls c)
            if (!= (shape.kind (graph a) call.callee) 12) { continue }
            let count: int = (shape.function_count (graph a) call.callee)
            let mut linked: array<int> = call.linked
            for i in (range 0 count) {
                let target: shape.Target = (shape.function_target (graph a) call.callee i true)
                if (not target.valid) { return false }
                if (contains linked target.number) { continue }
                if (not (connect_call a target.number call.arguments call.arity call.results call.result)) { return false }
                set linked (array_push linked target.number) set changed true
            }
            (array_set calls c Call { callee: call.callee, result: call.result, arguments: call.arguments,
                linked: linked, arity: call.arity, results: call.results })
        }
        if (not changed) { break }
    }
    return true
}
