        }
        if (and (!= push 0) (or (== op 250) (== op 144))) {
            if (not (tags a (at output 0) 2048)) { return false }
        }
        if (not (shape.healthy (graph a))) { return false }
        let mut after: array<int> = (array_slice stack 0 base)
        for i in (range 0 push) { set after (array_push after (at output i)) }
        if (or (or (== op 61) (== op 163)) (or (== op 51) (== op 168))) { continue }
        if (== op 165) {
