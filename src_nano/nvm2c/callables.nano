pub fn callee(a: Analysis, function: int, offset: int) -> int {
    if (or (!= a.error "") (or (< function 0) (>= function (array_length a.lengths)))) { return 0 }
    if (or (< offset 0) (>= offset (at a.lengths function))) { return 0 }
    let id: int = (at (at a.callees function) offset)
    if (== id 0) { return 0 }
    if (!= (shape.kind a.graph id) 12) { return 0 }
    return id
}
shadow callee { assert (== (callee (analyze (empty_module)) 0 0) 0) }
pub fn projection_tags(a: Analysis, function: int, offset: int) -> int {
    if (or (!= a.error "") (or (< function 0) (>= function (array_length a.lengths)))) { return 32768 }
    if (or (< offset 0) (>= offset (at a.lengths function))) { return 32768 }
    let id: int = (at (at a.projections function) offset)
    if (== id 0) { return 32768 }
    return (shape.tags a.graph id)
}
