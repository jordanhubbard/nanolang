module nvm2c_service_module
module "src_nano/nvm2c/service_nominal.nano" as nominal
module "src_nano/nvm2c/service_wire.nano" as service
module "src_nano/nvm2c/service_catalog.nano" as catalog
module "src_nano/nvm2c/ownership.nano" as owned
module "src_nano/nvm2c/instructions.nano" as instructions

# I validate normal narrow metadata carriers, never execution or host authority.
# My statuses are the existing NvmV2Result values, not nominal-plan statuses.
pub fn present(bytes: array<u8>, imports: array<nominal.Import>) -> bool {
    if (> (array_length bytes) 0) { return true }
    let mut i: int = 0
    while (< i (array_length imports)) {
        if (== (at imports i).kind 3) { return true }
        set i (+ i 1)
    }
    return false
}
shadow present {
    assert (not (present [] []))
    assert (present [0] [])
    assert (present [] [nominal.Import { module_name: 0, symbol: 0, kind: 3, arity: 0, result: 0, params: [] }])
}

pub fn file_instructions(model: owned.Module) -> bool {
    let mut i: int = 0
    while (< i (array_length model.functions)) {
        let entry = (at model.functions i)
        if (instructions.has_file model.code entry.start entry.length) { return true }
        set i (+ i 1)
    }
    return false
}
shadow file_instructions {
    let model: owned.Module = owned.Module { layouts: [], code: [145], strings: [], functions: [], params: [], results: [], records: 0, enums: 0, unions: 0 }
    assert (not (file_instructions model))
}

pub fn nominal_version(bytes: array<u8>) -> bool {
    if (< (array_length bytes) 2) { return false }
    return (and (== (at bytes 1) 0) (or (== (at bytes 0) 2) (== (at bytes 0) 3)))
}
shadow nominal_version {
    assert (nominal_version [2,0]) assert (nominal_version [3,0,255])
    assert (not (nominal_version [2])) assert (not (nominal_version [2,1]))
}

fn name_matches(model: owned.Module, index: int, expected: string) -> bool {
    if (or (< index 0) (>= index (array_length model.strings))) { return false }
    let bytes: array<u8> = (at model.strings index)
    if (!= (array_length bytes) (str_length expected)) { return false }
    let mut i: int = 0
    while (< i (array_length bytes)) {
        if (!= (cast_int (at bytes i)) (char_at expected i)) { return false }
        set i (+ i 1)
    }
    return true
}
shadow name_matches {
    let model: owned.Module = owned.Module { layouts: [], code: [], strings: [[65,0,66]], functions: [], params: [], results: [], records: 0, enums: 0, unions: 0 }
    assert (not (name_matches model 0 "A")) assert (not (name_matches model 1 ""))
}

fn legacy_signature(entry: nominal.Import, ordinal: int) -> bool {
    let count: int = (catalog.number 1 2 ordinal 4 0)
    if (or (<= count 0) (or (!= (- count 1) entry.arity) (or (!= entry.result 10) (< (array_length entry.params) entry.arity)))) { return false }
    let mut i: int = 0
    while (< i entry.arity) {
        let id: string = (catalog.text 1 2 ordinal 6 i)
        let mut tag: int = -1
        if (== id "nsi:core/int") { set tag 1 }
        if (== id "nsi:nanolang/filesystem#File") { set tag 8 }
        if (or (< tag 0) (or (!= (catalog.number 1 2 ordinal 5 i) 0) (!= (at entry.params i) tag))) { return false }
        set i (+ i 1)
    }
    return (== (catalog.number 1 2 ordinal 5 entry.arity) 3)
}
shadow legacy_signature {
    let entry: nominal.Import = nominal.Import { module_name: 0, symbol: 0, kind: 3, arity: 0, result: 10, params: [] }
    assert (legacy_signature entry 0)
    assert (not (legacy_signature entry 1))
}

fn nominal_status(bytes: array<u8>, ownership: array<u8>, model: owned.Module, imports: array<nominal.Import>, refs: int, callbacks: int) -> int {
    let mut profile: int = 2
    if (== (at bytes 0) 3) {
        set profile 5
    } else if (>= (array_length bytes) 4) {
        if (and (== (at bytes 2) 2) (== (at bytes 3) 0)) { set profile 3 }
    }
    let plan: nominal.Plan = (nominal.prepare bytes ownership model imports refs callbacks profile)
    if (== plan.status 0) { return 0 }
    if (== plan.status 2) { return 13 }
    return 8
}
shadow nominal_status {
    let model: owned.Module = owned.Module { layouts: [], code: [], strings: [], functions: [], params: [], results: [], records: 0, enums: 0, unions: 0 }
    assert (== (nominal_status [2,0] [] model [] 0 0) 8)
}

pub fn validate(bytes: array<u8>, ownership: array<u8>, model: owned.Module, imports: array<nominal.Import>, refs: int, callbacks: int) -> int {
    let nominal_claim: bool = (nominal_version bytes)
    if (and (file_instructions model) (not nominal_claim)) { return 8 }
    if (not (present bytes imports)) { return 0 }
    if nominal_claim { return (nominal_status bytes ownership model imports refs callbacks) }
    let bindings: service.Bindings = (service.decode bytes 1)
    if (!= bindings.status 0) { return 8 }
    if (or (!= (array_length imports) 5) (or (!= refs 0) (!= callbacks 0))) { return 14 }
    let instance: service.Instance = (at bindings.instances 0)
    let mut i: int = 0
    while (< i 5) {
        let index: int = (at instance.imports i)
        if (>= index (array_length imports)) { return 13 }
        let entry: nominal.Import = (at imports index)
        if (or (!= entry.kind 3) (or (not (name_matches model entry.module_name (catalog.text 1 0 0 0 0))) (or (not (name_matches model entry.symbol (catalog.text 1 2 i 0 0))) (not (legacy_signature entry i))))) { return 8 }
        set i (+ i 1)
    }
    return 0
}
shadow validate {
    let model: owned.Module = owned.Module { layouts: [], code: [], strings: [], functions: [], params: [], results: [], records: 0, enums: 0, unions: 0 }
    assert (== (validate [] [] model [] 0 0) 0)
    assert (== (validate [1] [] model [] 0 0) 8)
}
