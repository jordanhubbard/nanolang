/* nanoisa_emit — Cut A driver: NanoLang AST → NanoISA assembly text.
 *
 * Usage: nanoisa_emit <file.nano> [--emit-nvm] [-o output]
 * I write .nasm or verified .nvm. My driver is still hosted by the C seed.
 */

import "src_nano/compiler/nanoisa_codegen.nano"
module "modules/nanoisa/nanoisa.nano" as Nanoisa

extern fn get_argc() -> int
extern fn get_argv(index: int) -> string
extern fn file_exists(path: string) -> bool
extern fn file_read(path: string) -> string
extern fn file_write(path: string, content: string) -> int
extern fn file_compare_identity(source: string, candidate: string) -> int

fn show_usage() -> void {
    (println "I lower a pinned integer and string subset to NanoISA assembly.")
    (println "Usage: nanoisa_emit <file.nano> [--emit-nvm] [-o output]")
}

shadow show_usage {
    (show_usage)
    assert true
}

# I check current file identities; I do not lock the filesystem namespace.
fn output_preserves_source(source: string, destination: string) -> bool {
    if (== destination "") { return true }
    let mut identity: int = -1
    unsafe { set identity (file_compare_identity source destination) }
    if (!= identity 0) {
        (println "I cannot publish output that aliases my source or has unresolved identity.")
        return false
    }
    return true
}

shadow output_preserves_source {
    assert (output_preserves_source "" "")
}

fn main() -> int {
    let argc: int = (get_argc)
    let mut input: string = ""
    let mut output: string = ""
    let mut emit_nvm: bool = false
    let mut i: int = 1
    while (< i argc) {
        let arg: string = (get_argv i)
        if (or (== arg "-h") (== arg "--help")) {
            (show_usage)
            return 0
        } else {
            if (== arg "--emit-nvm") {
                set emit_nvm true
            } else {
                if (and (== arg "-o") (< (+ i 1) argc)) {
                    set i (+ i 1)
                    set output (get_argv i)
                } else {
                    if (== input "") {
                        set input arg
                    } else {
                        (show_usage)
                        return 2
                    }
                }
            }
        }
        set i (+ i 1)
    }
    if (or (== input "") (and emit_nvm (== output ""))) {
        (show_usage)
        return 2
    } else {
        if (not (file_exists input)) {
            (println (+ "I cannot read " input))
            return 1
        } else {
            if (not (output_preserves_source input output)) { return 1 }
            let src: string = (file_read input)
            let nasm: string = (nanoisa_emit_nasm src)
            if (== nasm "") {
                (println "I refused that program: it is outside the pinned subset")
                return 1
            } else {
                if emit_nvm {
                    let rc: int = (Nanoisa.assemble_text_save nasm output)
                    if (!= rc 0) {
                        (println (+ "I could not emit the module: " (Nanoisa.last_error)))
                        return 1
                    }
                    return 0
                }
                if (== output "") {
                    (print nasm)
                    return 0
                } else {
                    let rc: int = (file_write output nasm)
                    return rc
                }
            }
        }
    }
}

shadow main {
    assert true
}
