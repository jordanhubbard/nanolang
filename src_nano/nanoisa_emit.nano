/* nanoisa_emit — Cut A driver: NanoLang AST → NanoISA assembly text.
 *
 * Usage: nanoisa_emit <file.nano> [-o out.nasm]
 * I write .nasm. I do not invoke cc. I do not pretty-print C.
 */

import "src_nano/compiler/nanoisa_codegen.nano"

extern fn get_argc() -> int
extern fn get_argv(index: int) -> string
extern fn file_exists(path: string) -> bool
extern fn file_read(path: string) -> string
extern fn file_write(path: string, content: string) -> int

fn show_usage() -> void {
    (println "I lower a pinned integer subset to NanoISA assembly.")
    (println "Usage: nanoisa_emit <file.nano> [-o out.nasm]")
}

shadow show_usage {
    (show_usage)
    assert true
}

fn main() -> int {
    let argc: int = (get_argc)
    let mut input: string = ""
    let mut output: string = ""
    let mut i: int = 1
    while (< i argc) {
        let arg: string = (get_argv i)
        if (or (== arg "-h") (== arg "--help")) {
            (show_usage)
            return 0
        } else {
            if (and (== arg "-o") (< (+ i 1) argc)) {
                set i (+ i 1)
                set output (get_argv i)
            } else {
                if (== input "") {
                    set input arg
                } else {
                    (show_usage)
                    return 2
                }
            }
        }
        set i (+ i 1)
    }
    if (== input "") {
        (show_usage)
        return 2
    } else {
        if (not (file_exists input)) {
            (println (+ "I cannot read " input))
            return 1
        } else {
            let src: string = (file_read input)
            let nasm: string = (nanoisa_emit_nasm src)
            if (== nasm "") {
                (println "I refused that program: it is outside the i64 subset")
                return 1
            } else {
                if (== output "") {
                    (print nasm)
                    return 0
                } else {
                    let rc: int = (file_write output nasm)
                    return rc
                }
            }
        }
    }
}

shadow main {
    assert true
}
