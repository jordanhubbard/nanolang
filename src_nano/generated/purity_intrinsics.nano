pub fn purity_observable(name: string) -> bool {
    if (== name "print") { return true }
    if (== name "println") { return true }
    if (== name "file_read") { return true }
    if (== name "file_read_bytes") { return true }
    if (== name "file_write") { return true }
    if (== name "file_append") { return true }
    if (== name "file_remove") { return true }
    if (== name "file_rename") { return true }
    if (== name "file_exists") { return true }
    if (== name "file_size") { return true }
    if (== name "tmp_dir") { return true }
    if (== name "mktemp") { return true }
    if (== name "mktemp_dir") { return true }
    if (== name "dir_create") { return true }
    if (== name "dir_remove") { return true }
    if (== name "dir_list") { return true }
    if (== name "dir_exists") { return true }
    if (== name "getcwd") { return true }
    if (== name "chdir") { return true }
    if (== name "fs_walkdir") { return true }
    if (== name "path_isfile") { return true }
    if (== name "path_isdir") { return true }
    if (== name "system") { return true }
    if (== name "exit") { return true }
    if (== name "getenv") { return true }
    if (== name "setenv") { return true }
    if (== name "process_run") { return true }
    return false
}
shadow purity_observable {
    assert (purity_observable "getenv")
    assert (not (purity_observable "abs"))
}
