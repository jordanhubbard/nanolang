import "src_nano/compiler/tokenize_result.nano"
import "src_nano/parser.nano"

fn parse_nanoc() -> int {
    let r: ResultTokenList = (tokenize_file_result "src_nano/nanoc_v06.nano")
    match r {
        Ok(v) => {
            let tokens: List<LexerToken> = v.value
            let count: int = (list_LexerToken_length tokens)
            let p: Parser = (parse_program tokens count "src_nano/nanoc_v06.nano")
            if (parser_has_error p) {
                let tok: LexerToken = (parser_current p)
                (print "Parse failed at token #")
                (print (int_to_string (parser_position p)))
                (print ": line ")
                (print (int_to_string tok.line))
                (print ", col ")
                (print (int_to_string tok.column))
                (print ", type ")
                (print (int_to_string tok.token_type))
                (print ", value='")
                (print tok.value)
                (println "'")
                return 1
            } else {
                return 0
            }
        }
        Err(e) => {
            (print "Lex error: ")
            (println e.error)
            return 1
        }
    }
}

shadow parse_nanoc { assert (== 1 1) }

fn main() -> int {
    return (parse_nanoc)
}

shadow main { assert (== 1 1) }
