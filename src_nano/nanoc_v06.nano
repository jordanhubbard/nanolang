struct MergeResult {
    source: string
    files: array<string>
    original_sources: array<string>
    original_parsers: array<ParsedDeclarations>
    file_starts: array<int>
    source_files: array<string>
    source_lines: array<int>
    repo_root: string
    root_line: int
}

# I use merged source positions only to identify the owning input file.
# These are not original-file diagnostic line numbers.
fn merged_file_owner(file_starts: array<int>, line: int) -> int {
    let mut owner: int = (- 0 1)
    let mut i: int = 0
    while (< i (array_length file_starts)) {
        if (<= (at file_starts i) line) { set owner i }
        set i (+ i 1)
    }
    return owner
}

shadow merged_file_owner {
    let starts: array<int> = [1, 8, 8, 20]
    assert (== (merged_file_owner starts 0) (- 0 1))
    assert (== (merged_file_owner starts 7) 0)
    assert (== (merged_file_owner starts 8) 2)
    assert (== (merged_file_owner starts 20) 3)
    assert (== (merged_file_owner [] 1) (- 0 1))
}

fn merged_function_names_valid(parser: Parser, file_starts: array<int>) -> bool {
    let mut i: int = 0
    while (< i (parser_get_function_count parser)) {
        let current: ASTFunction = (parser_get_function parser i)
        if (>= current.line 0) {
            let owner: int = (merged_file_owner file_starts current.line)
            if (< owner 0) { return false }
            let mut j: int = 0
            while (< j i) {
                let previous: ASTFunction = (parser_get_function parser j)
                if (and (or (>= previous.body 0) (>= current.body 0)) (== previous.name current.name)) {
                    if (== (merged_file_owner file_starts previous.line) owner) {
                        (println (+ "I cannot define a function twice in one module: " current.name))
                        return false
                    }
                }
                set j (+ j 1)
            }
        }
        set i (+ i 1)
    }
    return true
}

shadow merged_function_names_valid {
    let source: string = "fn answer() -> int { return 1 }\nfn answer() -> int { return 2 }\n"
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let tokens: List<LexerToken> = (tokenize_string source "owners.nano" diags)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "owners.nano")
    assert (not (parser_has_error parser))
    assert (not (merged_function_names_valid parser [1]))
    assert (merged_function_names_valid parser [1, 2])
}

fn merged_binding_prefix(parser: Parser) -> string {
    let mut prefix: string = "__nano_module_"
    let mut collision: bool = true
    while collision {
        set collision false
        let mut i: int = 0
        while (< i parser.token_count) {
            let tok: LexerToken = (list_LexerToken_get parser.tokens i)
            if (nlc_str_starts_with tok.value prefix) { set collision true }
            set i (+ i 1)
        }
        if collision { set prefix (+ prefix "_") }
    }
    return prefix
}
shadow merged_binding_prefix {
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let tokens: List<LexerToken> = (tokenize_string "fn __nano_module_user() -> int { return 0 }" "prefix.nano" diags)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "prefix.nano")
    assert (== (merged_binding_prefix parser) "__nano_module__")
}

fn merged_path_owner(files: array<string>, path: string) -> int {
    let mut i: int = 0
    while (< i (array_length files)) {
        if (== (at files i) path) { return i }
        set i (+ i 1)
    }
    return (- 0 1)
}
shadow merged_path_owner {
    assert (== (merged_path_owner ["a/x.nano", "b/x.nano"] "b/x.nano") 1)
    assert (== (merged_path_owner ["a/x.nano"] "missing.nano") (- 0 1))
}

fn merged_qualified_calls_valid(parser: Parser) -> bool {
    let mut i: int = 0
    while (< i (list_ASTModuleQualifiedCall_length parser.module_qualified_calls)) {
        let call: ASTModuleQualifiedCall = (parser_get_module_qualified_call parser i)
        let resolved: string = (mb_lookup (mb_owner call.line) call.function_name)
        if (or (== resolved call.function_name) (mb_private_name resolved)) {
            (println (+ "I cannot resolve a qualified function in this module: " call.function_name))
            return false
        }
        set i (+ i 1)
    }
    return true
}
shadow merged_qualified_calls_valid {
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let tokens: List<LexerToken> = (tokenize_string "fn main() -> int { return (lib.answer) }" "qualified.nano" diags)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "qualified.nano")
    (mb_reset [1])
    assert (not (merged_qualified_calls_valid parser))
    (mb_add 0 "lib.answer" "owned_answer")
    assert (merged_qualified_calls_valid parser)
    (mb_reset [])
}

fn merged_function_visibility(parsed: ParsedDeclarations) -> array<int> {
    let parser: Parser = parsed.parser
    if (or parsed.truncated (parser_has_error parser)) { return [] }
    let mut visibility: array<int> = []
    let mut i: int = 0
    while (< i parser.functions_count) {
        set visibility (array_push visibility -1)
        set i (+ i 1)
    }
    set i 0
    while (< i (array_length parsed.definitions)) {
        let declaration: ParsedDefinition = (at parsed.definitions i)
        let index: int = declaration.function_index
        if (>= index 0) {
            if (or (>= index parser.functions_count) (!= (array_length declaration.before) 9)) { return [] }
            if (!= (array_length declaration.after) 9) { return [] }
            if (or (< index (at declaration.before 0)) (>= index (at declaration.after 0))) { return [] }
            if (!= (at visibility index) -1) { return [] }
            if (or (< declaration.first_token 0) (>= declaration.first_token parser.token_count)) { return [] }
            let owner: int = (mb_owner (list_LexerToken_get parser.tokens declaration.first_token).line)
            if (or (< owner 0) (!= owner (mb_owner (parser_get_function parser index).line))) { return [] }
            let mut value: int = 0
            if declaration.is_public { set value 1 }
            (array_set visibility index value)
        }
        set i (+ i 1)
    }
    return visibility
}
shadow merged_function_visibility {
    let tokens: List<LexerToken> = (tokenize_string "pub fn visible() -> int { let callback: fn(int)->int = fn(value: int) -> int { return value } return (callback 1) }\nfn hidden() -> int { return 2 }" "visibility.nano" (list_CompilerDiagnostic_new))
    let parsed: ParsedDeclarations = (parse_program_complete_declarations tokens (list_LexerToken_length tokens) "visibility.nano")
    (mb_reset [1])
    let values: array<int> = (merged_function_visibility parsed)
    assert (== (array_length values) 3)
    assert (== (at values 0) -1)
    assert (== (at values 1) 1)
    assert (== (at values 2) 0)
    (mb_reset [])
}

fn bind_merged_functions(parsed: ParsedDeclarations, merge: MergeResult) -> bool {
    let parser: Parser = parsed.parser
    (mb_reset merge.file_starts)
    (mb_set_sources merge.files)
    let visibility: array<int> = (merged_function_visibility parsed)
    if (or parsed.truncated (parser_has_error parser)) { return false }
    if (!= (array_length visibility) parser.functions_count) { return false }
    let prefix: string = (merged_binding_prefix parser)
    if (not (nb_register parser prefix)) { return false }
    let root_owner: int = (- (array_length merge.files) 1)
    let mut originals: array<string> = []
    let mut owners: array<int> = []
    let mut builtin_fallbacks: array<bool> = []
    let count: int = (parser_get_function_count parser)
    let mut i: int = 0
    while (< i count) {
        let func: ASTFunction = (parser_get_function parser i)
        let owner: int = (mb_owner func.line)
        if (< owner 0) { return false }
        set originals (array_push originals func.name)
        set owners (array_push owners owner)
        set builtin_fallbacks (array_push builtin_fallbacks (tc_has_builtin_fallback func.name))
        let mut name: string = func.name
        if (and (!= owner root_owner) (>= func.body 0)) {
            set name (+ prefix (+ (int_to_string owner) (+ "_" func.name)))
        }
        (mb_add owner func.name name)
        (list_ASTFunction_set parser.functions i (ASTFunction { node_type: func.node_type, line: func.line, column: func.column, name: name, param_start: func.param_start, param_count: func.param_count, return_type: func.return_type, body: func.body, is_pure: func.is_pure }))
        set i (+ i 1)
    }
    if (not (mb_set_function_visibility originals owners builtin_fallbacks prefix)) { return false }
    let mut denied_owners: array<int> = []
    let mut denied_names: array<string> = []
    let mut denied_targets: array<int> = []
    set i 0
    while (< i (parser_get_import_count parser)) {
        let imp: ASTImport = (parser_get_import parser i)
        let owner: int = (mb_owner imp.line)
        if (< owner 0) { return false }
        let mut resolved: string = (resolve_import_path (at merge.files owner) imp.module_path merge.repo_root)
        if (not (nlc_str_starts_with resolved "/")) { set resolved (nl_path_join (getcwd) resolved) }
        let path: string = (canonical resolved)
        let target_owner: int = (merged_path_owner merge.files path)
        if (< target_owner 0) {
            (println (+ "I cannot bind an import outside the merged source set: " path))
            return false
        }
        (nb_import parser imp target_owner)
        let mut f: int = 0
        while (< f count) {
            if (== (at owners f) target_owner) {
                let original: string = (at originals f)
                let target: string = (parser_get_function parser f).name
                if (and imp.is_selective (not imp.is_wildcard)) {
                    let mut s: int = 0
                    while (< s imp.import_symbol_count) {
                        if (== (at imp.import_symbols s) original) {
                            let mut alias: string = original
                            if (< s (array_length imp.import_aliases)) {
                                if (!= (at imp.import_aliases s) "") { set alias (at imp.import_aliases s) }
                            }
                            if (== (at visibility f) 1) {
                                (mb_add_target owner alias target target_owner)
                            } else {
                                set denied_owners (array_push denied_owners owner)
                                set denied_names (array_push denied_names alias)
                                set denied_targets (array_push denied_targets target_owner)
                            }
                        }
                        set s (+ s 1)
                    }
                } else {
                    let mut name: string = original
                    if (!= imp.module_name "") { set name (+ imp.module_name (+ "." original)) }
                    if (== (at visibility f) 1) {
                        (mb_add_target owner name target target_owner)
                    } else {
                        # A wildcard/plain import does not select a private binding.
                        if (!= imp.module_name "") {
                            set denied_owners (array_push denied_owners owner)
                            set denied_names (array_push denied_names name)
                            set denied_targets (array_push denied_targets target_owner)
                        }
                    }
                }
            }
            set f (+ f 1)
        }
        set i (+ i 1)
    }
    # I apply denied fallbacks after every actual local/public binding.
    set i 0
    while (< i (array_length denied_names)) {
        let name: string = (at denied_names i)
        (mb_add_target (at denied_owners i) name (mb_private_target name) (at denied_targets i))
        set i (+ i 1)
    }
    (nb_rewrite parser)
    if (not (nb_valid)) { return false }
    set i 0
    while (< i parser.shadows_count) {
        let sh: ASTShadow = (list_ASTShadow_get parser.shadows i)
        let name: string = (mb_lookup (mb_owner sh.line) sh.target_name)
        (list_ASTShadow_set parser.shadows i (ASTShadow { node_type: sh.node_type, line: sh.line, column: sh.column, target_name: name, body: sh.body }))
        set i (+ i 1)
    }
    return (merged_qualified_calls_valid parser)
}
shadow bind_merged_functions {
    let source: string = "fn answer() -> int { return 1 }\nfn answer() -> int { return 2 }\n"
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let tokens: List<LexerToken> = (tokenize_string source "binding.nano" diags)
    let parsed: ParsedDeclarations = (parse_program_complete_declarations tokens (list_LexerToken_length tokens) "binding.nano")
    let parser: Parser = parsed.parser
    let merge: MergeResult = MergeResult { source: source, files: ["first.nano", "root.nano"], original_sources: ["fn answer() -> int { return 1 }\n", "fn answer() -> int { return 2 }\n"], original_parsers: [], file_starts: [1, 2], source_files: ["first.nano", "root.nano"], source_lines: [1, 1], repo_root: "", root_line: 2 }
    assert (bind_merged_functions parsed merge)
    assert (!= (parser_get_function parser 0).name (parser_get_function parser 1).name)
    assert (== (mb_lookup 1 "answer") "answer")
    (mb_reset [])
}

fn source_location_for_line(files: array<string>, lines: array<int>, merged_line: int, column: int) -> CompilerSourceLocation {
    if (and (> merged_line 0) (<= merged_line (array_length files))) {
        return (Diagnostics.diag_location (at files (- merged_line 1)) (at lines (- merged_line 1)) column)
    } else {
        return (Diagnostics.diag_location "" merged_line column)
    }
}

shadow source_location_for_line {
    let loc: CompilerSourceLocation = (source_location_for_line ["root.nano", "dep.nano"] [3, 8] 2 4)
    assert (== loc.file "dep.nano")
    assert (== loc.line 8)
    assert (== loc.column 4)
}

fn remap_diagnostics(diags: List<CompilerDiagnostic>, files: array<string>, lines: array<int>) -> void {
    let mut i: int = 0
    while (< i (list_CompilerDiagnostic_length diags)) {
        let old: CompilerDiagnostic = (list_CompilerDiagnostic_get diags i)
        let mapped: CompilerSourceLocation = (source_location_for_line files lines old.location.line old.location.column)
        let replacement: CompilerDiagnostic = CompilerDiagnostic {
            phase: old.phase,
            severity: old.severity,
            code: old.code,
            message: old.message,
            location: mapped
        }
        (list_CompilerDiagnostic_set diags i replacement)
        set i (+ i 1)
    }
}

shadow remap_diagnostics {
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let old: CompilerDiagnostic = (Diagnostics.diag_parser_error "P0001" "bad" (Diagnostics.diag_location "merged.nano" 1 2))
    (Diagnostics.diag_list_add diags old)
    (remap_diagnostics diags ["path\\\"quoted.nano"] [7])
    let mapped: CompilerDiagnostic = (list_CompilerDiagnostic_get diags 0)
    assert (== mapped.location.file "path\\\"quoted.nano")
    assert (== mapped.location.line 7)
}

struct ModuleBuildFlags {
    compile_flags: string, link_flags: string, compiler: string,
    runtime_sources: array<string>, objects: array<string>, ok: bool, first_status: int
}
struct NativeProvider {
    source: string, compiler: string, language: string, profile: string, runtime: bool
}
struct NativeProviderSet { rows: array<NativeProvider>, ok: bool }
fn native_build_empty() -> ModuleBuildFlags {
    return ModuleBuildFlags { compile_flags: "", link_flags: "", compiler: "",
        runtime_sources: [], objects: [], ok: false, first_status: 1 }
}
shadow native_build_empty { assert (not (native_build_empty).ok) }
# Every successful append retains its exact count; I do not silently truncate OOM.
fn native_profile_append(a: string, b: string) -> string {
    let an: int = (str_length a)
    let bn: int = (str_length b)
    if (or (> an 1048576) (> bn (- 1048576 an))) { return "" }
    let value: string = (+ a b)
    let size: int = (str_length value)
    if (!= size (+ an bn)) { return "" }
    return value
}
shadow native_profile_append { assert (== (native_profile_append " -DX=1" " -UX") " -DX=1 -UX") }
fn native_provider_add(input: NativeProviderSet, value: NativeProvider) -> NativeProviderSet {
    let mut result: NativeProviderSet = input
    if (not result.ok) { return result }
    if (or (== value.source "") (or (== value.compiler "") (or (== value.language "") (== value.profile "")))) {
        set result (NativeProviderSet { rows: result.rows, ok: false }) return result
    }
    let mut i: int = 0
    while (< i (array_length result.rows)) {
        let old: NativeProvider = (at result.rows i)
        if (== old.source value.source) {
            if (or (!= old.compiler value.compiler) (or (!= old.language value.language) (!= old.profile value.profile))) {
                set result (NativeProviderSet { rows: result.rows, ok: false })
            }
            return result
        }
        set i (+ i 1)
    }
    if (>= (array_length result.rows) 50128) { set result (NativeProviderSet { rows: result.rows, ok: false }) return result }
    set result (NativeProviderSet { rows: (array_push result.rows value), ok: result.ok })
    return result
}
shadow native_provider_add {
    let empty: NativeProviderSet = NativeProviderSet { rows: [], ok: true }
    let value: NativeProvider = NativeProvider { source: "/a/x.c", compiler: "cc", language: "c99", profile: " -DA", runtime: true }
    let first: NativeProviderSet = (native_provider_add empty value)
    let again: NativeProviderSet = (native_provider_add first value)
    assert again.ok
    assert (== (array_length again.rows) 1)
    assert (== (array_length empty.rows) 1)
    let conflict: NativeProviderSet = (native_provider_add again (NativeProvider { source: "/a/x.c", compiler: "cc", language: "c99", profile: " -DB", runtime: false }))
    assert (not conflict.ok)
    # I retain the former native_source_already_linked properties in my actual registry.
    let json: NativeProvider = NativeProvider { source: "/repo/src/cJSON.c", compiler: "cc", language: "c99", profile: " -DA", runtime: true }
    let json_empty: NativeProviderSet = NativeProviderSet { rows: [], ok: true }
    let json_first: NativeProviderSet = (native_provider_add json_empty json)
    let json_again: NativeProviderSet = (native_provider_add json_first json)
    assert json_again.ok
    assert (== (array_length json_again.rows) 1)
    let other: NativeProviderSet = (native_provider_add json_first (NativeProvider { source: "/other/cJSON.c", compiler: "cc", language: "c99", profile: " -DA", runtime: false }))
    assert other.ok
    assert (== (array_length other.rows) 2)
    let absent_empty: NativeProviderSet = NativeProviderSet { rows: [], ok: true }
    let absent: NativeProviderSet = (native_provider_add absent_empty (NativeProvider { source: "", compiler: "cc", language: "c99", profile: " -DA", runtime: false }))
    assert (not absent.ok)
    assert (== (array_length absent.rows) 0)
}
struct NativeRuntimeInputs { sources: array<string>, includes: string }
fn native_runtime_inputs(repo_root: string, files: array<string>) -> NativeRuntimeInputs {
    let relative: array<string> = [
        "src/runtime/list_int.c",
        "src/runtime/list_string.c",
        "src/runtime/list_LexerToken.c",
        "src/runtime/list_token.c",
        "src/runtime/list_CompilerDiagnostic.c",
        "src/runtime/list_CompilerSourceLocation.c",
        "src/runtime/token_helpers.c",
        "src/runtime/gc.c",
        "src/runtime/dyn_array.c",
        "src/runtime/hashmap_bootstrap.c",
        "src/runtime/gc_struct.c",
        "src/runtime/nl_string.c",
        "src/utf8.c",
        "src/runtime/cli.c",
        "src/runtime/regex.c",
        "src/runtime/list_ASTLet.c",
        "src/runtime/list_ASTFunction.c",
        "src/runtime/list_ASTNumber.c",
        "src/runtime/list_ASTFloat.c",
        "src/runtime/list_ASTString.c",
        "src/runtime/list_ASTBool.c",
        "src/runtime/list_ASTIdentifier.c",
        "src/runtime/list_ASTBinaryOp.c",
        "src/runtime/list_ASTCall.c",
        "src/runtime/list_ASTModuleQualifiedCall.c",
        "src/runtime/list_ASTArrayLiteral.c",
        "src/runtime/list_ASTStmtRef.c",
        "src/runtime/list_ASTBlock.c",
        "src/runtime/list_ASTUnsafeBlock.c",
        "src/runtime/list_ASTPrint.c",
        "src/runtime/list_ASTAssert.c",
        "src/runtime/list_ASTFieldAccess.c",
        "src/runtime/list_ASTSet.c",
        "src/runtime/list_ASTIf.c",
        "src/runtime/list_ASTWhile.c",
        "src/runtime/list_ASTFor.c",
        "src/runtime/list_ASTReturn.c",
        "src/runtime/list_ASTShadow.c",
        "src/runtime/list_ASTStruct.c",
        "src/runtime/list_ASTStructLiteral.c",
        "src/runtime/list_ASTEnum.c",
        "src/runtime/list_ASTUnion.c",
        "src/runtime/list_ASTUnionConstruct.c",
        "src/runtime/list_ASTMatch.c",
        "src/runtime/list_ASTImport.c",
        "src/runtime/list_ASTOpaqueType.c",
        "src/runtime/list_ASTServiceDecl.c",
        "src/runtime/list_ASTTupleLiteral.c",
        "src/runtime/list_ASTTupleIndex.c",
        "modules/std/fs.c",
        "modules/std/process.c",
        "modules/std/collections/collections.c",
        "modules/std/json/json.c",
        "src/cJSON.c"
    ]
    let mut sources: array<string> = []
    let mut i: int = 0
    while (< i (array_length relative)) {
        set sources (array_push sources (nl_path_join repo_root (at relative i)))
        set i (+ i 1)
    }
    let mut includes: string = (+ " -I" (native_shell_quote (nl_path_join repo_root "modules/std/collections")))
    set includes (+ includes (+ " -I" (native_shell_quote (nl_path_join repo_root "modules/std/json"))))
    let mut uses_peg2: bool = false
    set i 0
    while (< i (array_length files)) {
        if (> (nlc_str_index_of (at files i) "peg2") -1) { set uses_peg2 true }
        set i (+ i 1)
    }
    if uses_peg2 {
        set sources (array_push sources (nl_path_join repo_root "modules/std/peg2/peg2.c"))
        set includes (+ includes (+ " -I" (native_shell_quote (nl_path_join repo_root "modules/std/peg2"))))
    }
    return NativeRuntimeInputs { sources: sources, includes: includes }
}
