/* =============================================================================
 * CLI ARGUMENT PARSING
 * ============================================================================= */
struct CompileOptions {
    input_file: string,
    output_file: string,
    verbose: bool,
    keep_c: bool,
    show_intermediate_code: bool,
    llm_diags_json_path: string,
    show_help: bool,
    emit_c: bool,
    emit_nvm: bool,
    test_imports: bool,
    allow_temporary_files: bool,
    allow_tcp_connections: bool,
    implicit_module: bool,
    error: string
}

fn default_options() -> CompileOptions {
    return (parse_options [])
}

shadow default_options {
    let opts: CompileOptions = (default_options)
    assert (== opts.output_file "a.nvm")
    assert opts.emit_nvm
    assert (not opts.emit_c)
    assert opts.test_imports
    assert (== opts.error "")
}

# I derive a sibling source filename only when no output was specified.
fn c_source_output_path(input: string) -> string {
    let length: int = (str_length input)
    let mut component_start: int = 0
    let mut extension: int = length
    let mut i: int = 0
    while (< i length) {
        let ch: string = (str_substring input i 1)
        if (== ch "/") { set component_start (+ i 1) set extension length }
        if (and (== ch ".") (> i component_start)) { set extension i }
        set i (+ i 1)
    }
    return (+ (str_substring input 0 extension) ".c")
}

shadow c_source_output_path {
    assert (== (c_source_output_path "dir.name/file.nano") "dir.name/file.c")
    assert (== (c_source_output_path ".hidden") ".hidden.c")
    assert (== (c_source_output_path "plain") "plain.c")
}

fn nvm_source_output_path(input: string) -> string {
    if (== input "") { return "a.nvm" }
    let c_path: string = (c_source_output_path input)
    return (+ (str_substring c_path 0 (- (str_length c_path) 1)) "nvm")
}
shadow nvm_source_output_path {
    assert (== (nvm_source_output_path "file.nano") "file.nvm")
    assert (== (nvm_source_output_path "a.b/file") "a.b/file.nvm")
    assert (== (nvm_source_output_path ".hidden") ".hidden.nvm")
}

# I parse arguments before any source loading or output writes.
fn parse_options(args: array<string>) -> CompileOptions {
    let mut input: string = ""
    let mut output: string = "a.out"
    let mut output_set: bool = false
    let mut verbose: bool = false
    let mut keep_c: bool = false
    let mut show_code: bool = false
    let mut diags: string = ""
    let mut help: bool = false
    let mut emit_c: bool = false
    let mut native_target: bool = false
    let mut emit_nvm: bool = false
    let mut test_imports: bool = true
    let mut allow_temporary_files: bool = false
    let mut allow_tcp_connections: bool = false
    let mut error: string = ""
    let mut positional_only: bool = false
    let count: int = (array_length args)
    let mut i: int = 0
    while (< i count) {
        let arg: string = (at args i)
        if (and (not positional_only) (== arg "--")) {
            set positional_only true
        } else if (and (not positional_only) (or (== arg "-h") (== arg "--help"))) {
            set help true
        } else if (and (not positional_only) (or (== arg "-v") (== arg "--verbose"))) {
            set verbose true
        } else if (and (not positional_only) (or (== arg "-k") (== arg "--keep-c"))) {
            set keep_c true
        } else if (and (not positional_only) (== arg "--emit-nvm")) {
            set emit_nvm true
        } else if (and (not positional_only) (== arg "--allow-tcp-connections")) {
            set allow_tcp_connections true
        } else if (and (not positional_only) (== arg "--allow-temporary-files")) {
            set allow_temporary_files true
        } else if (and (not positional_only) (== arg "--test-imports")) {
            set test_imports true
        } else if (and (not positional_only) (== arg "--root-shadows-only")) {
            set test_imports false
        } else if (and (not positional_only) (== arg "-fshow-intermediate-code")) {
            set show_code true
        } else if (and (not positional_only) (or (or (== arg "-o") (== arg "--target")) (== arg "--llm-diags-json"))) {
            if (>= (+ i 1) count) {
                set error (+ "I need a value after " arg)
                break
            }
            set i (+ i 1)
            let value: string = (at args i)
            if (or (== value "") (nlc_str_starts_with value "-")) {
                set error (+ "I need a value after " arg)
                break
            }
            if (== arg "-o") {
                set output value
                set output_set true
            } else if (== arg "--llm-diags-json") {
                set diags value
            } else {
                if (and (!= value "c") (!= value "native")) {
                    set error (+ "I do not support this target in my self-hosted driver: " value)
                    break
                }
                set emit_c (== value "c")
                set native_target (== value "native")
            }
        } else if (and (not positional_only) (nlc_str_starts_with arg "-")) {
            set error (+ "I do not recognize this option: " arg)
            break
        } else {
            if (== arg "") { set error "I need a nonempty input path" break }
            if (!= input "") { set error "I accept one input file per invocation" break }
            set input arg
        }
        set i (+ i 1)
    }
    if (and emit_c emit_nvm) { set error "I cannot combine --emit-nvm with --target c" }
    if (and emit_nvm (not output_set)) { set error "I require -o for --emit-nvm" }
    if (and emit_c (not output_set)) { set output (c_source_output_path input) }
    if (and emit_nvm native_target) { set error "I cannot combine --emit-nvm with --target native" }
    let implicit_module: bool = (and (not output_set) (and (not emit_nvm) (and (not emit_c) (not native_target))))
    if (and (not output_set) (and (not emit_c) (not native_target))) {
        set emit_nvm true
        set output (nvm_source_output_path input)
    }
    if (and emit_nvm (or keep_c show_code)) { set error "I require a native or C target for generated C options" }
    return CompileOptions {
        input_file: input, output_file: output, verbose: verbose,
        keep_c: keep_c, show_intermediate_code: show_code,
        llm_diags_json_path: diags, show_help: help, emit_c: emit_c, emit_nvm: emit_nvm, test_imports: test_imports, allow_temporary_files: allow_temporary_files, allow_tcp_connections: allow_tcp_connections, implicit_module: implicit_module, error: error
    }
}

shadow parse_options {
    let implicit: CompileOptions = (parse_options ["file.nano"])
    assert implicit.emit_nvm
    assert implicit.implicit_module
    assert (not implicit.allow_tcp_connections)
    assert (parse_options ["net.nano", "--allow-tcp-connections"]).allow_tcp_connections
    assert (not implicit.allow_temporary_files)
    assert (parse_options ["file.nano", "--allow-temporary-files"]).allow_temporary_files
    assert (not (parse_options ["file.nano", "--emit-nvm", "-o", "out.nvm"]).implicit_module)
    assert (== implicit.output_file "file.nvm")
    assert (== implicit.error "")
    assert (not (parse_options ["file.nano", "-o", "program"]).emit_nvm)
    let native: CompileOptions = (parse_options ["file.nano", "--target", "native"])
    assert (not native.emit_nvm)
    assert (== native.output_file "a.out")
    let source: CompileOptions = (parse_options ["file.nano", "--target", "c"])
    assert source.emit_c
    assert (== source.output_file "file.c")
    assert (== source.error "")
    let module_output: CompileOptions = (parse_options ["file.nano", "--emit-nvm", "-o", "file.nvm"])
    assert module_output.emit_nvm
    assert (== module_output.error "")
    assert (!= (parse_options ["file.nano", "--emit-nvm"]).error "")
    assert (!= (parse_options ["file.nano", "--emit-nvm", "--target", "c", "-o", "file.nvm"]).error "")
    let bad: CompileOptions = (parse_options ["file.nano", "--unknown"])
    assert (!= bad.error "")
    let missing: CompileOptions = (parse_options ["-o"])
    assert (!= missing.error "")
    let escaped: CompileOptions = (parse_options ["--", "-file.nano"])
    assert (== escaped.input_file "-file.nano")
    assert (== escaped.error "")
    assert (not (parse_options ["file.nano", "--root-shadows-only"]).test_imports)
    assert (parse_options ["--root-shadows-only", "--test-imports", "file.nano"]).test_imports
}

fn parse_args() -> CompileOptions {
    let count: int = (get_argc)
    let mut args: array<string> = []
    let mut i: int = 1
    while (< i count) {
        set args (array_push args (get_argv i))
        set i (+ i 1)
    }
    return (parse_options args)
}

shadow parse_args {
    let count: int = (get_argc)
    let opts: CompileOptions = (parse_args)
    if (<= count 1) { assert (== opts.input_file "") }
}

