fn resolve_cc_binary() -> string {
    let nano_cc: string = (getenv "NANO_CC")
    if (!= nano_cc "") {
        return nano_cc
    } else {
        let cc_env: string = (getenv "CC")
        if (!= cc_env "") {
            return cc_env
        } else {
            return "cc"
        }
    }
}

shadow resolve_cc_binary {
    let cc: string = (resolve_cc_binary)
    /* Should return a valid string (at minimum "cc") */
    assert (> (str_length cc) 0)
}

fn native_product_cflags(configured: string) -> string {
    if (== configured "") { return "-O1" }
    return configured
}

shadow native_product_cflags {
    assert (== (native_product_cflags "") "-O1")
    assert (== (native_product_cflags "-O0 -g") "-O0 -g")
    assert (== (native_product_cflags "-fsanitize=address") "-fsanitize=address")
}

/* =============================================================================
 * STRING HELPERS
 * ============================================================================= */

fn nlc_str_starts_with(s: string, prefix: string) -> bool {
    let len_s: int = (str_length s)
    let len_p: int = (str_length prefix)
    if (< len_s len_p) {
        return false
    } else {
        let mut i: int = 0
        while (< i len_p) {
            if (!= (char_at s i) (char_at prefix i)) {
                return false
            } else { (print "") }
            set i (+ i 1)
        }
        return true
    }
}

shadow nlc_str_starts_with {
    assert (nlc_str_starts_with "hello world" "hello")
    assert (not (nlc_str_starts_with "hello" "hello world"))
    assert (not (nlc_str_starts_with "world" "hello"))
    assert (nlc_str_starts_with "" "")
    assert (nlc_str_starts_with "a" "")
}

fn nlc_str_ends_with(s: string, suffix: string) -> bool {
    let len_s: int = (str_length s)
    let len_x: int = (str_length suffix)
    if (< len_s len_x) {
        return false
    } else {
        let offset: int = (- len_s len_x)
        let mut i: int = 0
        while (< i len_x) {
            if (!= (char_at s (+ offset i)) (char_at suffix i)) {
                return false
            } else { (print "") }
            set i (+ i 1)
        }
        return true
    }
}

shadow nlc_str_ends_with {
    assert (nlc_str_ends_with "hello world" "world")
    assert (not (nlc_str_ends_with "world" "hello world"))
    assert (not (nlc_str_ends_with "hello" "world"))
    assert (nlc_str_ends_with "" "")
    assert (nlc_str_ends_with "a" "")
}

fn nlc_str_index_of(s: string, needle: string) -> int {
    let len_s: int = (str_length s)
    let len_n: int = (str_length needle)
    if (== len_n 0) {
        return 0
    } else {
        let mut i: int = 0
        while (<= (+ i len_n) len_s) {
            let mut j: int = 0
            let mut found: bool = true
            while (< j len_n) {
                if (!= (char_at s (+ i j)) (char_at needle j)) {
                    set found false
                    set j len_n
                } else {
                    set j (+ j 1)
                }
            }
            if found {
                return i
            } else { (print "") }
            set i (+ i 1)
        }
        return -1
    }
}

shadow nlc_str_index_of {
    assert (== (nlc_str_index_of "hello world" "world") 6)
    assert (== (nlc_str_index_of "hello" "ll") 2)
    assert (== (nlc_str_index_of "test" "xyz") -1)
    assert (== (nlc_str_index_of "test" "") 0)
}

fn nlc_str_last_index_of(s: string, needle: string) -> int {
    let len_s: int = (str_length s)
    let len_n: int = (str_length needle)
    if (== len_n 0) {
        return len_s
    } else {
        let mut i: int = (- len_s len_n)
        while (>= i 0) {
            let mut j: int = 0
            let mut found: bool = true
            while (< j len_n) {
                if (!= (char_at s (+ i j)) (char_at needle j)) {
                    set found false
                    set j len_n
                } else {
                    set j (+ j 1)
                }
            }
            if found {
                return i
            } else { (print "") }
            set i (- i 1)
        }
        return -1
    }
}

shadow nlc_str_last_index_of {
    assert (== (nlc_str_last_index_of "hello world hello" "hello") 12)
    assert (== (nlc_str_last_index_of "test test" "test") 5)
    assert (== (nlc_str_last_index_of "test" "xyz") -1)
    assert (== (nlc_str_last_index_of "test" "") 4)
}

fn nlc_hashset_new_string() -> HashMap<string, int> {
    let s: HashMap<string, int> = (map_new)
    return s
}

shadow nlc_hashset_new_string {
    let s: HashMap<string, int> = (nlc_hashset_new_string)
    assert (not (map_has s "fresh"))
    (map_put s "fresh" 1)
    assert (== (map_get s "fresh") 1)
}

fn nlc_hashset_has_string(hset: HashMap<string, int>, key: string) -> bool {
    return (map_has hset key)
}

shadow nlc_hashset_has_string {
    let s: HashMap<string, int> = (nlc_hashset_new_string)
    assert (not (nlc_hashset_has_string s "test"))
    (map_put s "test" 1)
    assert (nlc_hashset_has_string s "test")
}

fn nlc_hashset_add_string(hset: HashMap<string, int>, key: string) -> HashMap<string, int> {
    if (not (map_has hset key)) {
        (map_put hset key 1)
    } else { (print "") }
    return hset
}

shadow nlc_hashset_add_string {
    let s: HashMap<string, int> = (nlc_hashset_new_string)
    assert (not (nlc_hashset_has_string s "a"))
    let s2: HashMap<string, int> = (nlc_hashset_add_string s "a")
    assert (nlc_hashset_has_string s2 "a")
}

/* =============================================================================
 * IMPORT RESOLUTION (SIMPLIFIED)
 * ============================================================================= */

fn nl_path_dirname(path: string) -> string {
    if (== path "/") { return "/" }
    let mut p: string = path
    if (nlc_str_ends_with p "/") {
        set p (str_substring p 0 (- (str_length p) 1))
    } else { (print "") }

    let idx: int = (nlc_str_last_index_of p "/")
    if (== idx -1) {
        return "."
    } else {
        if (== idx 0) { return "/" } else { return (str_substring p 0 idx) }
    }
}

shadow nl_path_dirname {
    assert (== (nl_path_dirname "/") "/")
    assert (== (nl_path_dirname "/file") "/")
    assert (== (nl_path_dirname "/path/to/file") "/path/to")
    assert (== (nl_path_dirname "file") ".")
    assert (== (nl_path_dirname "/a/b/") "/a")
}

fn nl_path_join(dir: string, rel: string) -> string {
    if (or (== dir "") (== dir ".")) {
        return rel
    } else {
        if (nlc_str_ends_with dir "/") {
            return (+ dir rel)
        } else {
            return (+ (+ dir "/") rel)
        }
    }
}

shadow nl_path_join {
    assert (== (nl_path_join "/path/to" "file") "/path/to/file")
    assert (== (nl_path_join "/path/" "file") "/path/file")
    assert (== (nl_path_join "." "file") "file")
}

fn parse_env_int(name: string, default_val: int) -> int {
    let raw: string = (getenv name)
    if (== raw "") {
        return default_val
    } else {
        let n: int = (string_to_int raw)
        if (<= n 0) {
            return default_val
        } else {
            return n
        }
    }
}

shadow parse_env_int {
    assert (== (parse_env_int "___NANOLANG_TEST_ENV_INT___" 123) 123)
}

fn find_repo_root(start_dir: string) -> string {
    let mut dir: string = start_dir
    let mut i: int = 0
    let trace_env: string = (getenv "NANO_IMPORT_TRACE")
    let trace: bool = (!= trace_env "")
    while (< i 25) {
        if trace {
            (print "[import] find_repo_root: ")
            (println dir)
        } else { (print "") }
        let marker1: string = (nl_path_join dir ".beads/issues.jsonl")
        let marker2: string = (nl_path_join dir "src_nano/nanoc_v06.nano")
        if (or (file_exists marker1) (file_exists marker2)) {
            return dir
        } else {
            let parent: string = (nl_path_dirname dir)
            if (or (== parent dir) (== parent "")) {
                return ""
            } else {
                set dir parent
            }
        }
        set i (+ i 1)
    }
    return ""
}

fn compiler_tool_root() -> string {
    let configured: string = (getenv "NANOLANG_ROOT")
    if (!= configured "") { return configured }
    let mut executable: string = (canonical (get_argv 0))
    if (== executable "") {
        let located: string = (nlc_str_trim (nl_exec_capture (+ "command -v -- " (native_shell_quote (get_argv 0)))))
        if (!= located "") { set executable (canonical located) }
    }
    if (!= executable "") {
        let installed: string = (find_repo_root (nl_path_dirname executable))
        if (!= installed "") { return installed }
    }
    return (find_repo_root (getcwd))
}
shadow compiler_tool_root {
    let root: string = (compiler_tool_root)
    if (== (getenv "NANOLANG_ROOT") "") {
        assert (!= root "")
    } else { assert (== root (getenv "NANOLANG_ROOT")) }
}

fn split_lines(s: string) -> array<string> {
    let len: int = (str_length s)
    let mut out: array<string> = []
    let mut start: int = 0
    let mut i: int = 0

    while (< i len) {
        if (== (str_substring s i 1) "\n") {
            set out (array_push out (str_substring s start (- i start)))
            set start (+ i 1)
        } else { (print "") }
        set i (+ i 1)
    }

    if (<= start len) {
        set out (array_push out (str_substring s start (- len start)))
    } else { (print "") }
    return out
}

shadow split_lines {
    let lines: array<string> = (split_lines "hello")
    assert (== (array_length lines) 1)
    assert (== (at lines 0) "hello")
}

fn parse_import_path_from_line(line: string) -> string {
    /* Handle: import "path", from "path" import ..., module "path" */
    let has_import: bool = (nlc_str_starts_with line "import \"")
    let has_from: bool = (nlc_str_starts_with line "from \"")
    let has_module: bool = (nlc_str_starts_with line "module \"")
    let has_unsafe_module: bool = (nlc_str_starts_with line "unsafe module \"")

    if (or (or has_import has_from) (or has_module has_unsafe_module)) {
        let first_q: int = (nlc_str_index_of line "\"")
        let line_length: int = (str_length line)
        let mut last_q: int = (+ first_q 1)
        while (< last_q line_length) {
            let source_char: int = (char_at line last_q)
            if (== source_char 34) { break }
            if (== source_char 92) { set last_q (+ last_q 1) }
            set last_q (+ last_q 1)
        }
        if (and (< last_q line_length) (and (>= first_q 0) (> last_q first_q))) {
            let result: string = (str_substring line (+ first_q 1) (- last_q (+ first_q 1)))
            return (parser_decode_import_path result)
        } else {
            return ""
        }
    } else {
        return ""
    }
}

shadow parse_import_path_from_line {
    assert (== (parse_import_path_from_line "import \"std/io\"") "std/io")
    assert (== (parse_import_path_from_line "from \"modules/math\" import add") "modules/math")
    assert (== (parse_import_path_from_line "module \"mymod\"") "mymod")
    assert (== (parse_import_path_from_line "fn foo() -> int { return 0 }") "")
    assert (== (parse_import_path_from_line "module \"a\\\"b\\\\n.nano\" # \"comment\"") "a\"b\\n.nano")
    assert (== (parse_import_path_from_line "module \"bad\\0path\"") "")
    assert (== (parse_import_path_from_line "module \"unterminated") "")
}

fn nlc_str_trim(s: string) -> string {
    let len: int = (str_length s)
    let mut start: int = 0
    while (and (< start len) (or (== (char_at s start) 32) (or (== (char_at s start) 9) (== (char_at s start) 10)))) {
        set start (+ start 1)
    }
    let mut end: int = len
    while (and (> end start) (or (== (char_at s (- end 1)) 32) (or (== (char_at s (- end 1)) 9) (== (char_at s (- end 1)) 10)))) {
        set end (- end 1)
    }
    if (>= start end) { return "" } else { (print "") }
    return (str_substring s start (- end start))
}

shadow nlc_str_trim {
    assert (== (nlc_str_trim "  hello  ") "hello")
    assert (== (nlc_str_trim "x") "x")
    assert (== (nlc_str_trim "") "")
}

fn extract_from_aliases(lines: array<string>) -> array<string> {
    let mut result: array<string> = []
    let mut i: int = 0
    while (< i (array_length lines)) {
        let line: string = (at lines i)
        if (nlc_str_starts_with line "from ") {
            let import_kw: int = (nlc_str_index_of line " import ")
            if (>= import_kw 0) {
                let after_import: string = (str_substring line (+ import_kw 8) (- (str_length line) (+ import_kw 8)))
                let alen: int = (str_length after_import)
                let mut pos: int = 0
                while (< pos alen) {
                    while (and (< pos alen) (== (char_at after_import pos) 32)) { set pos (+ pos 1) }
                    let mut end: int = pos
                    while (and (< end alen) (and (!= (char_at after_import end) 44) (!= (char_at after_import end) 32))) { set end (+ end 1) }
                    let sym: string = (str_substring after_import pos (- end pos))
                    set pos end
                    while (and (< pos alen) (== (char_at after_import pos) 32)) { set pos (+ pos 1) }
                    if (and (< (+ pos 2) alen) (== (str_substring after_import pos 3) "as ")) {
                        set pos (+ pos 3)
                        while (and (< pos alen) (== (char_at after_import pos) 32)) { set pos (+ pos 1) }
                        let mut aend: int = pos
                        while (and (< aend alen) (and (!= (char_at after_import aend) 44) (!= (char_at after_import aend) 32))) { set aend (+ aend 1) }
                        let alias: string = (str_substring after_import pos (- aend pos))
                        if (and (> (str_length sym) 0) (> (str_length alias) 0)) {
                            set result (array_push result alias)
                            set result (array_push result sym)
                        } else { (print "") }
                        set pos aend
                    } else { (print "") }
                    while (and (< pos alen) (or (== (char_at after_import pos) 44) (== (char_at after_import pos) 32))) { set pos (+ pos 1) }
                }
            } else { (print "") }
        } else { (print "") }
        set i (+ i 1)
    }
    return result
}

shadow extract_from_aliases {
    assert (== 1 1)
}

fn apply_alias(line: string, alias: string, original: string) -> string {
    let alen: int = (str_length alias)
    let llen: int = (str_length line)
    let mut result: string = ""
    let mut i: int = 0
    while (<= i (- llen alen)) {
        let candidate: string = (str_substring line i alen)
        if (== candidate alias) {
            let before_ok: bool = (or (== i 0) (not (is_ident_char (char_at line (- i 1)))))
            let after_pos: int = (+ i alen)
            let after_ok: bool = (or (>= after_pos llen) (not (is_ident_char (char_at line after_pos))))
            if (and before_ok after_ok) {
                set result (+ result original)
                set i (+ i alen)
            } else {
                set result (+ result (str_substring line i 1))
                set i (+ i 1)
            }
        } else {
            set result (+ result (str_substring line i 1))
            set i (+ i 1)
        }
    }
    while (< i llen) {
        set result (+ result (str_substring line i 1))
        set i (+ i 1)
    }
    return result
}

shadow apply_alias {
    assert (== 1 1)
}

fn is_ident_char(c: int) -> bool {
    if (and (>= c 97) (<= c 122)) { return true } else { (print "") }
    if (and (>= c 65) (<= c 90)) { return true } else { (print "") }
    if (and (>= c 48) (<= c 57)) { return true } else { (print "") }
    if (== c 95) { return true } else { (print "") }
    return false
}

shadow is_ident_char {
    assert (is_ident_char 97)
    assert (not (is_ident_char 32))
}

fn apply_all_aliases(line: string, aliases: array<string>) -> string {
    let mut result: string = line
    let mut i: int = 0
    while (< i (array_length aliases)) {
        let alias: string = (at aliases i)
        let original: string = (at aliases (+ i 1))
        set result (apply_alias result alias original)
        set i (+ i 2)
    }
    return result
}

shadow apply_all_aliases {
    assert (== 1 1)
}

fn strip_pub_decl(line: string) -> string {
    if (nlc_str_starts_with line "pub fn ") {
        return (+ "fn " (str_substring line 7 (- (str_length line) 7)))
    } else {
        if (nlc_str_starts_with line "pub struct ") {
            return (+ "struct " (str_substring line 11 (- (str_length line) 11)))
        } else {
            if (nlc_str_starts_with line "pub enum ") {
                return (+ "enum " (str_substring line 9 (- (str_length line) 9)))
            } else {
                if (nlc_str_starts_with line "pub union ") {
                    return (+ "union " (str_substring line 10 (- (str_length line) 10)))
                } else {
                    return line
                }
            }
        }
    }
}

shadow strip_pub_decl {
    assert (== (strip_pub_decl "pub fn test() -> int") "fn test() -> int")
    assert (== (strip_pub_decl "pub struct Point") "struct Point")
    assert (== (strip_pub_decl "pub enum Color") "enum Color")
    assert (== (strip_pub_decl "let x: int = 5") "let x: int = 5")
}

fn resolve_import_path(current_file: string, import_path: string, repo_root: string) -> string {
    if (== import_path "") {
        return ""
    } else {
        /* Special case for std library - check NANO_MODULE_PATH and modules/ directory */
        if (nlc_str_starts_with import_path "std/") {
            let module_path_env: string = (getenv "NANO_MODULE_PATH")
            if (not (== module_path_env "")) {
                let candidate: string = (nl_path_join module_path_env import_path)
                if (file_exists candidate) {
                    return candidate
                } else { (print "") }
            } else { (print "") }
            let modules_candidate: string = (nl_path_join "modules" import_path)
            if (file_exists modules_candidate) {
                return modules_candidate
            } else { (print "") }
            if (!= repo_root "") {
                let repo_candidate: string = (nl_path_join repo_root (nl_path_join "modules" import_path))
                if (file_exists repo_candidate) {
                    return repo_candidate
                } else { (print "") }
            } else { (print "") }
            return (nl_path_join "modules" import_path)
        } else {
            if (nlc_str_starts_with import_path "/") {
                return import_path
            } else {
                if (or (nlc_str_starts_with import_path "./") (nlc_str_starts_with import_path "../")) {
                    return (nl_path_join (nl_path_dirname current_file) import_path)
                } else {
                    /* I resolve bare paths beside their importer before repository fallback. */
                    let relative: string = (nl_path_join (nl_path_dirname current_file) import_path)
                    if (file_exists relative) { return relative }
                    if (!= repo_root "") {
                        return (nl_path_join repo_root import_path)
                    } else {
                        return import_path
                    }
                }
            }
        }
    }
}

shadow resolve_import_path {
    let p1: string = (resolve_import_path "" "/abs" "")
    assert (== p1 "/abs")
    assert (== (resolve_import_path "/project/tests/main.nano" "./local.nano" "/project") "/project/tests/./local.nano")
    assert (== (resolve_import_path "/project/tests/main.nano" "../local.nano" "/project") "/project/tests/../local.nano")
    assert (== (resolve_import_path "tests/main.nano" "test_modules/metadata_probe.nano" "/missing-root") "tests/test_modules/metadata_probe.nano")
    assert (== (resolve_import_path "tests/main.nano" "missing_probe_211.nano" "/project") "/project/missing_probe_211.nano")
}

struct CollectResult {
    visited: array<string>,
    visited_set: HashMap<string, int>,
    order: array<string>,
    ok: bool,
    lines_scanned: int
}

fn collect_files_dfs(path: string, repo_root: string, visited: array<string>, visited_set: HashMap<string, int>, order: array<string>, ok: bool, max_files: int, max_lines: int, max_lines_per_file: int, lines_scanned: int, trace: bool) -> CollectResult {
    if (not ok) {
        return CollectResult { visited: visited, visited_set: visited_set, order: order, ok: false, lines_scanned: lines_scanned }
    } else { (print "") }

    # I resolve symlinks before deduplication and relative dependency lookup.
    let norm_path: string = (canonical path)
    if (== norm_path "") {
        (println (+ "I cannot resolve a source path: " path))
        return CollectResult { visited: visited, visited_set: visited_set, order: order, ok: false, lines_scanned: lines_scanned }
    }

    if (nlc_hashset_has_string visited_set norm_path) {
        # I distinguish a finished dependency from an edge into the active stack.
        let mut finished: bool = false
        let mut seen: int = 0
        while (< seen (array_length order)) {
            if (== (at order seen) norm_path) { set finished true }
            set seen (+ seen 1)
        }
        if (not finished) { (println (+ "I cannot load a cyclic import graph at " norm_path)) }
        return CollectResult { visited: visited, visited_set: visited_set, order: order, ok: finished, lines_scanned: lines_scanned }
    } else {
        let mut visited2: array<string> = (array_push visited norm_path)
        let mut visited_set2: HashMap<string, int> = visited_set
        set visited_set2 (nlc_hashset_add_string visited_set2 norm_path)
        if (> (array_length visited2) max_files) {
            (print "Error: import scan exceeded max files (")
            (print max_files)
            (print "): ")
            (println path)
            return CollectResult { visited: visited2, visited_set: visited_set2, order: order, ok: false, lines_scanned: lines_scanned }
        } else { (print "") }
        let src: string = (file_read norm_path)
        let lines: array<string> = (split_lines src)

        let mut order2: array<string> = order
        let mut ok2: bool = true
        let mut i: int = 0
        let mut lines_scanned2: int = lines_scanned
        if trace {
            (print "[import] ")
            (println norm_path)
        } else { (print "") }
        while (< i (array_length lines)) {
            set lines_scanned2 (+ lines_scanned2 1)
            if (> lines_scanned2 max_lines) {
                (print "Error: import scan exceeded max lines (")
                (print max_lines)
                (print ") while scanning: ")
                (println norm_path)
                return CollectResult { visited: visited2, visited_set: visited_set2, order: order2, ok: false, lines_scanned: lines_scanned2 }
            } else { (print "") }
            if (>= i max_lines_per_file) {
                (print "Error: import scan exceeded max lines per file (")
                (print max_lines_per_file)
                (print ") while scanning: ")
                (println norm_path)
                return CollectResult { visited: visited2, visited_set: visited_set2, order: order2, ok: false, lines_scanned: lines_scanned2 }
            } else { (print "") }
            if (and trace (== (% lines_scanned2 500) 0)) {
                (print "[import] scanned lines: ")
                (println lines_scanned2)
            } else { (print "") }
            set i (+ i 1)
        }
        let tokens: List<LexerToken> = (tokenize_string src norm_path (list_CompilerDiagnostic_new))
        let parsed: Parser = (parse_program tokens (list_LexerToken_length tokens) norm_path)
        # I retain a malformed source for the merged parser's diagnostic path,
        # which protects already declared companion files before publication.
        set i 0
        while (and ok2 (< i parsed.imports_count)) {
            let imp: string = (parser_get_import parsed i).module_path
            if (!= imp "") {
                let dep: string = (resolve_import_path norm_path imp repo_root)
                if (== dep "") {
                    (print "Error: bad import path in ")
                    (println norm_path)
                    set ok2 false
                } else {
                    if (file_exists dep) {
                        let res: CollectResult = (collect_files_dfs dep repo_root visited2 visited_set2 order2 ok2 max_files max_lines max_lines_per_file lines_scanned2 trace)
                        set visited2 res.visited
                        set visited_set2 res.visited_set
                        set order2 res.order
                        set ok2 res.ok
                        set lines_scanned2 res.lines_scanned
                    } else {
                        (print "Error: import not found: ")
                        (println dep)
                        set ok2 false
                    }
                }
            } else { (print "") }
            set i (+ i 1)
        }

        if ok2 {
            set order2 (array_push order2 norm_path)
        } else { (print "") }
        return CollectResult { visited: visited2, visited_set: visited_set2, order: order2, ok: ok2, lines_scanned: lines_scanned2 }
    }
}

shadow collect_files_dfs {
    let directory: string = (mktemp_dir "nano_collect_sources_")
    assert (!= directory "")
    if (!= directory "") {
        let path: string = (+ directory "/fixture.nano")
        unsafe { assert (== (file_write path "fn value() -> int { return 1 }") 0) }
        let result: CollectResult = (collect_files_dfs path "" [] (nlc_hashset_new_string) [] true 10 100 100 0 false)
        assert result.ok
        assert (== (array_length result.order) 1)
        assert (== (at result.order 0) (canonical path))
        let again: CollectResult = (collect_files_dfs (+ directory "/./fixture.nano") "" result.visited result.visited_set result.order true 10 100 100 0 false)
        assert again.ok
        assert (== (array_length again.order) 1)
        let dependency: string = (+ directory "/dep.nano")
        unsafe {
            assert (== (file_write dependency "module dependency pub fn dep() -> int { return 1 }") 0)
            assert (== (file_write path "  module\n \"dep.nano\" as dep\nfn value() -> int { return 1 }") 0)
        }
        let graph: CollectResult = (collect_files_dfs path "" [] (nlc_hashset_new_string) [] true 10 100 100 0 false)
        assert graph.ok
        assert (== (array_length graph.order) 2)
        assert (== (at graph.order 0) (canonical dependency))
        unsafe { assert (== (file_write dependency "module \"fixture.nano\" as cycle") 0) }
        let cycle: CollectResult = (collect_files_dfs path "" [] (nlc_hashset_new_string) [] true 10 100 100 0 false)
        assert (not cycle.ok)
        unsafe { assert (== (file_delete dependency) 0) assert (== (file_delete path) 0) assert (== (file_delete directory) 0) }
    }
}

struct MergeResult {
    source: string
    files: array<string>
    file_starts: array<int>
    source_files: array<string>
    source_lines: array<int>
    repo_root: string
    root_line: int
}

# I use merged source positions only to identify the owning input file.
# These are not original-file diagnostic line numbers.
fn merged_file_owner(file_starts: array<int>, line: int) -> int {
    let mut owner: int = (- 0 1)
    let mut i: int = 0
    while (< i (array_length file_starts)) {
        if (<= (at file_starts i) line) { set owner i }
        set i (+ i 1)
    }
    return owner
}

shadow merged_file_owner {
    let starts: array<int> = [1, 8, 8, 20]
    assert (== (merged_file_owner starts 0) (- 0 1))
    assert (== (merged_file_owner starts 7) 0)
    assert (== (merged_file_owner starts 8) 2)
    assert (== (merged_file_owner starts 20) 3)
    assert (== (merged_file_owner [] 1) (- 0 1))
}

fn merged_function_names_valid(parser: Parser, file_starts: array<int>) -> bool {
    let mut i: int = 0
    while (< i (parser_get_function_count parser)) {
        let current: ASTFunction = (parser_get_function parser i)
        if (>= current.body 0) {
            let owner: int = (merged_file_owner file_starts current.line)
            if (< owner 0) { return false }
            let mut j: int = 0
            while (< j i) {
                let previous: ASTFunction = (parser_get_function parser j)
                if (and (>= previous.body 0) (== previous.name current.name)) {
                    if (== (merged_file_owner file_starts previous.line) owner) {
                        (println (+ "I cannot define a function twice in one module: " current.name))
                        return false
                    }
                }
                set j (+ j 1)
            }
        }
        set i (+ i 1)
    }
    return true
}

shadow merged_function_names_valid {
    let source: string = "fn answer() -> int { return 1 }\nfn answer() -> int { return 2 }\n"
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let tokens: List<LexerToken> = (tokenize_string source "owners.nano" diags)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "owners.nano")
    assert (not (parser_has_error parser))
    assert (not (merged_function_names_valid parser [1]))
    assert (merged_function_names_valid parser [1, 2])
}

fn merged_binding_prefix(parser: Parser) -> string {
    let mut prefix: string = "__nano_module_"
    let mut collision: bool = true
    while collision {
        set collision false
        let mut i: int = 0
        while (< i parser.token_count) {
            let tok: LexerToken = (list_LexerToken_get parser.tokens i)
            if (nlc_str_starts_with tok.value prefix) { set collision true }
            set i (+ i 1)
        }
        if collision { set prefix (+ prefix "_") }
    }
    return prefix
}
shadow merged_binding_prefix {
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let tokens: List<LexerToken> = (tokenize_string "fn __nano_module_user() -> int { return 0 }" "prefix.nano" diags)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "prefix.nano")
    assert (== (merged_binding_prefix parser) "__nano_module__")
}

fn merged_path_owner(files: array<string>, path: string) -> int {
    let mut i: int = 0
    while (< i (array_length files)) {
        if (== (at files i) path) { return i }
        set i (+ i 1)
    }
    return (- 0 1)
}
shadow merged_path_owner {
    assert (== (merged_path_owner ["a/x.nano", "b/x.nano"] "b/x.nano") 1)
    assert (== (merged_path_owner ["a/x.nano"] "missing.nano") (- 0 1))
}

fn merged_qualified_calls_valid(parser: Parser) -> bool {
    let mut i: int = 0
    while (< i (list_ASTModuleQualifiedCall_length parser.module_qualified_calls)) {
        let call: ASTModuleQualifiedCall = (parser_get_module_qualified_call parser i)
        if (== (mb_lookup (mb_owner call.line) call.function_name) call.function_name) {
            (println (+ "I cannot resolve a qualified function in this module: " call.function_name))
            return false
        }
        set i (+ i 1)
    }
    return true
}
shadow merged_qualified_calls_valid {
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let tokens: List<LexerToken> = (tokenize_string "fn main() -> int { return (lib.answer) }" "qualified.nano" diags)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "qualified.nano")
    (mb_reset [1])
    assert (not (merged_qualified_calls_valid parser))
    (mb_add 0 "lib.answer" "owned_answer")
    assert (merged_qualified_calls_valid parser)
    (mb_reset [])
}

fn bind_header_lines(owner: int, text: string, originals: array<string>, owners: array<int>) -> void {
    let lines: array<string> = (split_lines text)
    let mut i: int = 0
    while (< i (array_length lines)) {
        let line: string = (at lines i)
        let separator: int = (nlc_str_index_of line "=")
        if (> separator 0) {
            let name: string = (str_substring line 0 separator)
            let mut declared: bool = false
            let mut f: int = 0
            while (< f (array_length originals)) {
                if (and (== (at owners f) owner) (== (at originals f) name)) { set declared true }
                set f (+ f 1)
            }
            if (not declared) {
                let value: string = (str_substring line (+ separator 1) (- (str_length line) (+ separator 1)))
                (mb_header_add owner name value)
            }
        }
        set i (+ i 1)
    }
}
shadow bind_header_lines {
    (mb_reset [1, 3])
    (bind_header_lines 0 "VALUE=41\ndeclared=999\n" ["declared"] [0])
    assert (== (mb_header_value "VALUE") "41")
    assert (== (mb_header_value "declared") "")
    (bind_header_lines 1 "VALUE=99\n" [] [])
    assert (== (mb_header_value "VALUE") "41")
    (mb_reset [])
}

fn bind_merged_functions(parser: Parser, merge: MergeResult) -> bool {
    (mb_reset merge.file_starts)
    (mb_set_sources merge.files)
    let prefix: string = (merged_binding_prefix parser)
    if (not (nb_register parser prefix)) { return false }
    let root_owner: int = (- (array_length merge.files) 1)
    let local_lets: array<bool> = (typecheck_local_lets parser)
    let mut global: int = 0
    while (< global (parser_get_let_count parser)) {
        if (not (at local_lets global)) {
            let declaration: ASTLet = (parser_get_let parser global)
            let owner: int = (mb_owner declaration.line)
            let name: string = (+ prefix (+ "global_" (int_to_string global)))
            (mb_add owner declaration.name name)
        }
        set global (+ global 1)
    }
    let mut originals: array<string> = []
    let mut owners: array<int> = []
    let count: int = (parser_get_function_count parser)
    let mut i: int = 0
    while (< i count) {
        let func: ASTFunction = (parser_get_function parser i)
        let owner: int = (mb_owner func.line)
        if (< owner 0) { return false }
        set originals (array_push originals func.name)
        set owners (array_push owners owner)
        let mut name: string = func.name
        if (and (!= owner root_owner) (>= func.body 0)) {
            set name (+ prefix (+ (int_to_string owner) (+ "_" func.name)))
        }
        (mb_add owner func.name name)
        (list_ASTFunction_set parser.functions i (ASTFunction { node_type: func.node_type, line: func.line, column: func.column, name: name, param_start: func.param_start, param_count: func.param_count, return_type: func.return_type, body: func.body, is_pure: func.is_pure }))
        set i (+ i 1)
    }
    set i 0
    while (< i root_owner) {
        (bind_header_lines i (DriverSupport.module_header_constants (at merge.files i)) originals owners)
        set i (+ i 1)
    }
    set i 0
    while (< i (parser_get_import_count parser)) {
        let imp: ASTImport = (parser_get_import parser i)
        let owner: int = (mb_owner imp.line)
        if (< owner 0) { return false }
        let mut resolved: string = (resolve_import_path (at merge.files owner) imp.module_path merge.repo_root)
        if (not (nlc_str_starts_with resolved "/")) { set resolved (nl_path_join (getcwd) resolved) }
        let path: string = (canonical resolved)
        let target_owner: int = (merged_path_owner merge.files path)
        if (< target_owner 0) {
            (println (+ "I cannot bind an import outside the merged source set: " path))
            return false
        }
        (nb_import parser imp target_owner)
        set global 0
        while (< global (parser_get_let_count parser)) {
            let declaration: ASTLet = (parser_get_let parser global)
            let legacy_constant: bool = (and (== imp.module_name "") (and (not imp.is_selective) (not declaration.is_mut)))
            if (and (not (at local_lets global)) (and (or declaration.is_pub legacy_constant) (== (mb_owner declaration.line) target_owner))) {
                let target: string = (mb_lookup target_owner declaration.name)
                if (and imp.is_selective (not imp.is_wildcard)) {
                    let mut selected: int = 0
                    while (< selected imp.import_symbol_count) {
                        if (== (at imp.import_symbols selected) declaration.name) {
                            let mut alias: string = declaration.name
                            if (< selected (array_length imp.import_aliases)) {
                                if (!= (at imp.import_aliases selected) "") { set alias (at imp.import_aliases selected) }
                            }
                            if (not (mb_import_global owner alias target target_owner)) {
                                (println "I cannot bind a conflicting public global import.")
                                return false
                            }
                        }
                        set selected (+ selected 1)
                    }
                } else {
                    let mut name: string = declaration.name
                    if (!= imp.module_name "") { set name (+ imp.module_name (+ "." declaration.name)) }
                    if (not (mb_import_global owner name target target_owner)) {
                        (println "I cannot bind a conflicting public global import.")
                        return false
                    }
                }
            }
            set global (+ global 1)
        }
        let mut f: int = 0
        while (< f count) {
            if (== (at owners f) target_owner) {
                let original: string = (at originals f)
                let target: string = (parser_get_function parser f).name
                if (and imp.is_selective (not imp.is_wildcard)) {
                    let mut s: int = 0
                    while (< s imp.import_symbol_count) {
                        if (== (at imp.import_symbols s) original) {
                            let mut alias: string = original
                            if (< s (array_length imp.import_aliases)) {
                                if (!= (at imp.import_aliases s) "") { set alias (at imp.import_aliases s) }
                            }
                            (mb_add_target owner alias target target_owner)
                        }
                        set s (+ s 1)
                    }
                } else {
                    let mut name: string = original
                    if (!= imp.module_name "") { set name (+ imp.module_name (+ "." original)) }
                    (mb_add_target owner name target target_owner)
                }
            }
            set f (+ f 1)
        }
        set i (+ i 1)
    }
    (nb_rewrite parser)
    set i 0
    while (< i parser.shadows_count) {
        let sh: ASTShadow = (list_ASTShadow_get parser.shadows i)
        let name: string = (mb_lookup (mb_owner sh.line) sh.target_name)
        (list_ASTShadow_set parser.shadows i (ASTShadow { node_type: sh.node_type, line: sh.line, column: sh.column, target_name: name, body: sh.body }))
        set i (+ i 1)
    }
    return (merged_qualified_calls_valid parser)
}
shadow bind_merged_functions {
    let source: string = "fn answer() -> int { return 1 }\nfn answer() -> int { return 2 }\n"
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let tokens: List<LexerToken> = (tokenize_string source "binding.nano" diags)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "binding.nano")
    let merge: MergeResult = MergeResult { source: source, files: ["first.nano", "root.nano"], file_starts: [1, 2], source_files: ["first.nano", "root.nano"], source_lines: [1, 1], repo_root: "", root_line: 2 }
    assert (bind_merged_functions parser merge)
    assert (!= (parser_get_function parser 0).name (parser_get_function parser 1).name)
    assert (== (mb_lookup 1 "answer") "answer")
    (mb_reset [])
}

fn source_location_for_line(files: array<string>, lines: array<int>, merged_line: int, column: int) -> CompilerSourceLocation {
    if (and (> merged_line 0) (<= merged_line (array_length files))) {
        return (Diagnostics.diag_location (at files (- merged_line 1)) (at lines (- merged_line 1)) column)
    } else {
        return (Diagnostics.diag_location "" merged_line column)
    }
}

shadow source_location_for_line {
    let loc: CompilerSourceLocation = (source_location_for_line ["root.nano", "dep.nano"] [3, 8] 2 4)
    assert (== loc.file "dep.nano")
    assert (== loc.line 8)
    assert (== loc.column 4)
}

fn remap_diagnostics(diags: List<CompilerDiagnostic>, files: array<string>, lines: array<int>) -> void {
    let mut i: int = 0
    while (< i (list_CompilerDiagnostic_length diags)) {
        let old: CompilerDiagnostic = (list_CompilerDiagnostic_get diags i)
        let mapped: CompilerSourceLocation = (source_location_for_line files lines old.location.line old.location.column)
        let replacement: CompilerDiagnostic = CompilerDiagnostic {
            phase: old.phase,
            severity: old.severity,
            code: old.code,
            message: old.message,
            location: mapped
        }
        (list_CompilerDiagnostic_set diags i replacement)
        set i (+ i 1)
    }
}

shadow remap_diagnostics {
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    let old: CompilerDiagnostic = (Diagnostics.diag_parser_error "P0001" "bad" (Diagnostics.diag_location "merged.nano" 1 2))
    (Diagnostics.diag_list_add diags old)
    (remap_diagnostics diags ["path\\\"quoted.nano"] [7])
    let mapped: CompilerDiagnostic = (list_CompilerDiagnostic_get diags 0)
    assert (== mapped.location.file "path\\\"quoted.nano")
    assert (== mapped.location.line 7)
}

fn merge_source_parts(parts: array<string>) -> string {
    if (== (array_length parts) 0) { return "" }
    let mut current: array<string> = parts
    while (> (array_length current) 1) {
        let mut next: array<string> = []
        let mut i: int = 0
        while (< i (array_length current)) {
            if (< (+ i 1) (array_length current)) {
                set next (array_push next (+ (at current i) (at current (+ i 1))))
            } else { set next (array_push next (at current i)) }
            set i (+ i 2)
        }
        set current next
    }
    return (at current 0)
}
shadow merge_source_parts {
    assert (== (merge_source_parts []) "")
    assert (== (merge_source_parts ["one"]) "one")
    assert (== (merge_source_parts ["a", "b", "c", "d", "e"]) "abcde")
}

fn merge_with_imports(input_file: string) -> MergeResult {
    (mi_reset)
    let start: string = (canonical input_file)
    if (== start "") { return MergeResult { source: "", files: [], file_starts: [], source_files: [], source_lines: [], repo_root: "", root_line: 0 } }
    let mut repo_root: string = (find_repo_root (nl_path_dirname start))
    if (== repo_root "") { set repo_root (compiler_tool_root) }
    let max_files: int = (parse_env_int "NANO_IMPORT_MAX_FILES" 5000)
    let max_lines: int = (parse_env_int "NANO_IMPORT_MAX_LINES" 50000)
    let max_lines_per_file: int = (parse_env_int "NANO_IMPORT_MAX_LINES_PER_FILE" 20000)
    let trace_env: string = (getenv "NANO_IMPORT_TRACE")
    let trace: bool = (!= trace_env "")
    if trace {
        (print "[import] repo_root: ")
        (println repo_root)
        (print "[import] start: ")
        (println start)
    } else { (print "") }

    let visited0: array<string> = []
    let visited_set0: HashMap<string, int> = (nlc_hashset_new_string)
    let order0: array<string> = []
    let res: CollectResult = (collect_files_dfs start repo_root visited0 visited_set0 order0 true max_files max_lines max_lines_per_file 0 trace)
    let files: array<string> = res.order
    if (not res.ok) {
        return MergeResult { source: "", files: [], file_starts: [], source_files: [], source_lines: [], repo_root: repo_root, root_line: 0 }
    } else { (print "") }
    # I retain source in this invocation; no other compiler can replace it.
    let mut parts: array<string> = []
    let mut source_files: array<string> = []
    let mut source_lines: array<int> = []
    let mut i: int = 0
    let mut merged_lines: int = 0
    let mut root_line: int = 1
    let mut file_starts: array<int> = []
    while (< i (array_length files)) {
        set file_starts (array_push file_starts (+ merged_lines 1))
        if (== i (- (array_length files) 1)) { set root_line (+ merged_lines 1) }
        let src: string = (file_read (at files i))
        if (< i (- (array_length files) 1)) {
            if (not (mi_capture src (at files i))) {
                return MergeResult { source: "", files: [], file_starts: [], source_files: [], source_lines: [], repo_root: repo_root, root_line: 0 }
            }
        }
        let lines: array<string> = (split_lines src)
        let mut j: int = 0
        while (< j (array_length lines)) {
            let line: string = (at lines j)
            # I retain headers, exports and adjacent declarations exactly as parsed.
            set parts (array_push parts (+ line "\n"))
            set merged_lines (+ merged_lines 1)
            set source_files (array_push source_files (at files i))
            set source_lines (array_push source_lines (+ j 1))
            set j (+ j 1)
        }
        set i (+ i 1)
    }
    return MergeResult { source: (merge_source_parts parts), files: files, file_starts: file_starts, source_files: source_files, source_lines: source_lines, repo_root: repo_root, root_line: root_line }
}

shadow merge_with_imports {
    let result: MergeResult = (merge_with_imports "examples/language/nl_hello.nano")
    assert (> (str_length result.source) 0)
    assert (> (array_length result.files) 0)
    assert (== result.root_line 1)
    assert (== (array_length result.file_starts) (array_length result.files))
    assert (== (at result.file_starts 0) 1)
}

fn llm_escape_json(s: string) -> string {
    let mut out: string = ""
    let n: int = (str_length s)
    let q: string = (string_from_char 34)
    let mut i: int = 0
    while (< i n) {
        let c: int = (char_at s i)
        if (== c 92) {
            set out (+ out "\\\\")
        } else {
            if (== c 34) {
                set out (+ out "\\")
                set out (+ out q)
            } else {
                if (== c 10) {
                    set out (+ out "\\n")
                } else {
                    if (== c 13) {
                        set out (+ out "\\r")
                    } else {
                        if (== c 9) {
                            set out (+ out "\\t")
                        } else {
                            set out (+ out (string_from_char c))
                        }
                    }
                }
            }
        }
        set i (+ i 1)
    }
    return out
}

shadow llm_escape_json {
    let result: string = (llm_escape_json "test")
    assert (== result "test")
}

fn llm_write_diags_json(path: string, input_file: string, output_file: string, exit_code: int, diags: List<CompilerDiagnostic>) -> int {
    let mut s: string = ""
    let q: string = (string_from_char 34)
    set s (+ s "{")
    set s (+ s q)
    set s (+ s "tool")
    set s (+ s q)
    set s (+ s ":")
    set s (+ s q)
    set s (+ s "nanoc")
    set s (+ s q)
    set s (+ s ",")
    set s (+ s q)
    set s (+ s "success")
    set s (+ s q)
    set s (+ s ":")
    if (== exit_code 0) { set s (+ s "true") } else { set s (+ s "false") }
    set s (+ s ",")
    set s (+ s q)
    set s (+ s "exit_code")
    set s (+ s q)
    set s (+ s ":")
    set s (+ s (int_to_string exit_code))
    set s (+ s ",")
    set s (+ s q)
    set s (+ s "input_file")
    set s (+ s q)
    set s (+ s ":")
    set s (+ s q)
    set s (+ s (llm_escape_json input_file))
    set s (+ s q)
    set s (+ s ",")
    set s (+ s q)
    set s (+ s "output_file")
    set s (+ s q)
    set s (+ s ":")
    set s (+ s q)
    set s (+ s (llm_escape_json output_file))
    set s (+ s q)
    set s (+ s ",")
    set s (+ s q)
    set s (+ s "diagnostics")
    set s (+ s q)
    set s (+ s ":[")

    let n: int = (list_CompilerDiagnostic_length diags)
    let mut i: int = 0
    while (< i n) {
        let d: CompilerDiagnostic = (list_CompilerDiagnostic_get diags i)
        if (> i 0) { set s (+ s ",") } else { (print "") }
        set s (+ s "{")
        set s (+ s q)
        set s (+ s "code")
        set s (+ s q)
        set s (+ s ":")
        set s (+ s q)
        set s (+ s (llm_escape_json d.code))
        set s (+ s q)
        set s (+ s ",")
        set s (+ s q)
        set s (+ s "message")
        set s (+ s q)
        set s (+ s ":")
        set s (+ s q)
        set s (+ s (llm_escape_json d.message))
        set s (+ s q)
        set s (+ s ",")
        set s (+ s q)
        set s (+ s "phase")
        set s (+ s q)
        set s (+ s ":")
        set s (+ s (int_to_string d.phase))
        set s (+ s ",")
        set s (+ s q)
        set s (+ s "severity")
        set s (+ s q)
        set s (+ s ":")
        set s (+ s (int_to_string d.severity))
        set s (+ s ",")
        set s (+ s q)
        set s (+ s "location")
        set s (+ s q)
        set s (+ s ":{")
        set s (+ s q)
        set s (+ s "file")
        set s (+ s q)
        set s (+ s ":")
        set s (+ s q)
        set s (+ s (llm_escape_json d.location.file))
        set s (+ s q)
        set s (+ s ",")
        set s (+ s q)
        set s (+ s "line")
        set s (+ s q)
        set s (+ s ":")
        set s (+ s (int_to_string d.location.line))
        set s (+ s ",")
        set s (+ s q)
        set s (+ s "column")
        set s (+ s q)
        set s (+ s ":")
        set s (+ s (int_to_string d.location.column))
        set s (+ s "}}")
        set i (+ i 1)
    }
    set s (+ s "]}")
    return (file_write path s)
}

fn native_shell_quote(path: string) -> string {
    let mut result: string = "'"
    let length: int = (str_length path)
    let mut i: int = 0
    while (< i length) {
        let ch: string = (str_substring path i 1)
        if (== ch "'") { set result (+ result "'\\''") }
        else { set result (+ result ch) }
        set i (+ i 1)
    }
    return (+ result "'")
}

shadow native_shell_quote {
    assert (== (native_shell_quote "a b") "'a b'")
    assert (== (native_shell_quote "a'b") "'a'\\''b'")
}

fn native_shadow_start(parser: Parser, root_line: int) -> int {
    let mut i: int = 0
    while (< i parser.shadows_count) {
        let sh: ASTShadow = (list_ASTShadow_get parser.shadows i)
        if (>= sh.line root_line) { return i }
        set i (+ i 1)
    }
    return i
}

shadow native_shadow_start {
    let tokens: List<LexerToken> = (tokenize_string "fn f() -> int { return 1 }\nshadow f { assert false }\nshadow f { assert true }" "selection.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program tokens (list_LexerToken_length tokens) "selection.nano")
    assert (== (native_shadow_start p 3) 1)
    assert (== (native_shadow_start p 4) 2)
}

fn bytecode_shadow_cleanup(directory: string) -> void {
    if (== directory "") { return }
    unsafe {
        (file_delete (+ directory "/shadows.nvm"))
        (file_delete directory)
    }
}
shadow bytecode_shadow_cleanup { (bytecode_shadow_cleanup "") }

fn outputs_preserve_sources(sources: array<string>, output: string, diagnostics: string) -> bool {
    let destinations: array<string> = [output, diagnostics]
    let mut i: int = 0
    while (< i (array_length sources)) {
        let source: string = (at sources i)
        let mut j: int = 0
        while (< j (array_length destinations)) {
            let destination: string = (at destinations j)
            if (!= destination "") {
                let mut identity: int = -1
                unsafe { set identity (file_compare_identity source destination) }
                if (> identity 0) {
                    (println (+ "I will not overwrite a source file: " source))
                    return false
                }
                if (< identity 0) {
                    (println (+ "I cannot check source/output file identity: " source))
                    return false
                }
            }
            set j (+ j 1)
        }
        set i (+ i 1)
    }
    return true
}

fn output_destinations_distinct(output: string, diagnostics: string) -> bool {
    if (== diagnostics "") { return true }
    let mut identity: int = -1
    unsafe { set identity (file_compare_destinations output diagnostics) }
    if (== identity 0) { return true }
    if (> identity 0) {
        (println "I require separate artifact and diagnostic destinations")
    } else {
        (println "I cannot check artifact/diagnostic destination identity")
    }
    return false
}

shadow output_destinations_distinct {
    let directory: string = (mktemp_dir "nano_output_guard_")
    assert (!= directory "")
    if (!= directory "") {
        let output: string = (+ directory "/output")
        let report: string = (+ directory "/report")
        assert (output_destinations_distinct output "")
        assert (output_destinations_distinct output report)
        assert (not (output_destinations_distinct output output))
        unsafe { assert (== (file_write output "prior") 0) }
        assert (output_destinations_distinct output report)
        assert (not (output_destinations_distinct output output))
        unsafe {
            assert (== (file_read output) "prior")
            assert (== (file_delete output) 0)
            assert (== (file_delete directory) 0)
        }
    }
}

shadow outputs_preserve_sources {
    let directory: string = (mktemp_dir "nano_source_guard_")
    assert (!= directory "")
    if (!= directory "") {
        let source: string = (+ directory "/source.nano")
        let output: string = (+ directory "/output")
        unsafe { assert (== (file_write source "source") 0) }
        assert (outputs_preserve_sources [source] output "")
        assert (not (outputs_preserve_sources [source] source ""))
        assert (not (outputs_preserve_sources [source] output source))
        assert (not (outputs_preserve_sources [(+ directory "/missing")] output ""))
        unsafe {
            assert (== (file_read source) "source")
            assert (== (file_delete source) 0)
            assert (== (file_delete directory) 0)
        }
    }
}

fn compile_program_inputs(input_file: string, output_file: string, verbose: bool, keep_c: bool, show_intermediate_code: bool, llm_diags_json_path: string, emit_c: bool, emit_nvm: bool, test_imports: bool, allow_temporary_files: bool, allow_tcp_connections: bool, implicit_module: bool, service_context: NlFileSourceSnapshots) -> int {
    if (== input_file "") { return 1 }
    if verbose {
        (println "")
        (println "╔══════════════════════════════════════════════════════════════╗")
        (println "║  NanoLang v0.6 - Self-Hosted Compiler                       ║")
        (println "╚══════════════════════════════════════════════════════════════╝")
        (println "")
        (print "Input:  ")
        (println input_file)
        (print "Output: ")
        (println output_file)
        (println "")
    } else {
        (print "")
    }
    
    /* Step 0: Merge imports into single source */
    /* Find repository root for absolute paths to runtime sources  */
    /* Start search from current working directory, not input file location */
    let mut repo_root: string = (compiler_tool_root)
    if (== repo_root "") {
        /* Fallback: use current working directory */
        set repo_root (getcwd)
    } else {
        (print "")
    }

    if verbose {
        (println "[0/5] Resolving imports...")
    } else {
        (print "")
    }

    let merge_result: MergeResult = (merge_with_imports input_file)
    let merged_source: string = merge_result.source
    let merged_files: array<string> = merge_result.files
    let source_files: array<string> = merge_result.source_files
    let source_lines: array<int> = merge_result.source_lines
    let source_to_compile: string = input_file

    # I reject aliases before parsing can write diagnostics or shadows can run.
    if (not (outputs_preserve_sources merged_files output_file llm_diags_json_path)) { return 1 }
    if (not (output_destinations_distinct output_file llm_diags_json_path)) { return 1 }
    
    if (== merged_source "") {
        (println "Error: import resolution failed")
        return 1
    } else {
        # I lex the merged text without publishing a temporary source file.
        if verbose {
            (print "  ✓ Merged source: ")
            (print (int_to_string (str_length merged_source)))
            (println " bytes")
        } else {
            (print "")
        }
    }
    
    /* Step 1: Lexer - Tokenize source file */
    if verbose {
        (println "[1/5] Lexing...")
    } else {
        (print "")
    }
    
    /* Diagnostics list (start with lexer diags; may be replaced by later phase outputs) */
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    
    let tokens: List<LexerToken> = (tokenize_string merged_source source_to_compile diags)
    let token_count: int = (list_LexerToken_length tokens)
    (remap_diagnostics diags source_files source_lines)
    
    if (== token_count 0) {
        (println "Error: Failed to tokenize input file")
        if (not (== llm_diags_json_path "")) {
            (llm_write_diags_json llm_diags_json_path input_file output_file 1 diags)
        } else { (print "") }
        return 1
    } else {
        (print "")
            
            if verbose {
                (print "  ✓ Tokenized ")
                (print (int_to_string token_count))
                (println " tokens")
            } else {
                (print "")
            }
            
            /* Step 2: Parser - Build AST */
            if verbose {
                (println "[2/5] Parsing...")
            } else {
                (print "")
            }
            
            let parser: Parser = (parse_program tokens token_count input_file)
            # I protect retained companion declarations before publishing parse-error diagnostics.
            let service_origins: ServiceOrigins = (bind_service_origins parser merged_files source_files source_lines)
            if (not service_origins.ok) {
                (println "I cannot retain the original sources of my File service declarations.")
                return 1
            }

            let service_inputs: ServiceInputs = (acquire_service_inputs parser merged_files service_origins service_context)
            if (not service_inputs.ok) {
                (println "I cannot acquire the immutable companions of my File service declarations.")
                return 1
            }
            if (not (outputs_preserve_sources service_inputs.paths output_file llm_diags_json_path)) { return 1 }

            if (parser_has_error parser) {
                let tok: LexerToken = (parser_current parser)
                let parse_loc: CompilerSourceLocation = (source_location_for_line source_files source_lines tok.line tok.column)
                let mut parse_message: string = (+ "unexpected token '" (+ tok.value "'"))
                let mut json_parse_message: string = (+ "unexpected token " tok.value)
                if (> (Diagnostics.diag_list_count parser.diagnostics) 0) {
                    let parser_diag: CompilerDiagnostic = (Diagnostics.diag_list_get parser.diagnostics 0)
                    set parse_message parser_diag.message
                    set json_parse_message parser_diag.message
                } else { (print "") }
                (print "Parse error at ")
                (print parse_loc.file)
                (print ":")
                (print (int_to_string parse_loc.line))
                (print ", column ")
                (print (int_to_string parse_loc.column))
                (print ": ")
                (println parse_message)
                if (not (== llm_diags_json_path "")) {
                    let msg: string = (+ "Parse error: " json_parse_message)
                    let diag: CompilerDiagnostic = (Diagnostics.diag_parser_error "P0001" msg parse_loc)
                    (Diagnostics.diag_list_add diags diag)
                    (llm_write_diags_json llm_diags_json_path input_file output_file 1 diags)
                } else { (print "") }
                return 1
            } else {
                (print "")
            }
            
            let func_count: int = (parser_get_function_count parser)
            if verbose {
                (print "  ✓ Parsed ")
                (print (int_to_string func_count))
                (println " functions")
            } else {
                (print "")
            }
            
            if (not (merged_function_names_valid parser merge_result.file_starts)) {
                if (!= llm_diags_json_path "") {
                    (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "M0001" "I require unique function declarations within each module" (Diagnostics.diag_location input_file 0 0)))
                    (llm_write_diags_json llm_diags_json_path input_file output_file 1 diags)
                }
                return 1
            }

            let mut service_targets: array<int> = []
            if (> parser.services_count 0) {
                let mut i: int = 0
                while (< i parser.imports_count) {
                    let imp: ASTImport = (parser_get_import parser i)
                    let owner: int = (sn_owner merged_files source_files imp.line)
                    if (< owner 0) { return 1 }
                    let path: string = (canonical (resolve_import_path (at merged_files owner) imp.module_path merge_result.repo_root))
                    set service_targets (array_push service_targets (service_origin_file merged_files path))
                    set i (+ i 1)
                }
            }
            let service_namespace: ServiceNamespace = (resolve_service_namespace parser merged_files source_files service_targets service_origins service_inputs service_context)
            if (!= service_namespace.status 0) {
                (println "I cannot resolve the complete File service namespace.")
                return 1
            }

            let service_annotations: ServiceAnnotationFacts = (bind_service_annotations parser merged_files source_files service_namespace)
            if (not service_annotations.ok) {
                (println "I cannot retain nominal File type annotations.")
                return 1
            }

            let service_bodies: ServiceBodyCheck = (check_service_bodies parser merged_files source_files service_namespace)
            if (or (== service_bodies.status 1) (== service_bodies.status 3)) {
                (println (+ "I cannot type-check File service bodies: " service_bodies.diagnostic))
                return 1
            }
            if (> parser.services_count 0) {
                let ownership: ServiceOwnershipCheck = (check_service_ownership parser merged_files source_files service_namespace service_bodies)
                if (or (== ownership.status 1) (== ownership.status 3)) {
                    (println (+ "I cannot verify File service ownership: " ownership.diagnostic))
                    return 1
                }
                if (or (!= service_bodies.status 0) (!= ownership.status 0)) {
                    (println "I have not resolved File service declarations for this consumer.")
                    return 1
                }
                if (or emit_c (or keep_c (or show_intermediate_code (!= llm_diags_json_path "")))) {
                    (println "I do not support these output options for File source.")
                    return 1
                }
                let mut product_output: string = output_file
                if implicit_module { set product_output "a.out" }
                if (not (outputs_preserve_sources merged_files product_output "")) { return 1 }
                if (not (outputs_preserve_sources service_inputs.paths product_output "")) { return 1 }
                let mut first_service_shadow: int = 0
                if (not test_imports) { set first_service_shadow (native_shadow_start parser merge_result.root_line) }
                return (publish_service_source parser merged_files source_files service_namespace service_bodies ownership
                    first_service_shadow product_output merge_result.repo_root (and emit_nvm (not implicit_module)) allow_temporary_files allow_tcp_connections)
            }

            if (not (bind_merged_functions parser merge_result)) {
                if (!= llm_diags_json_path "") {
                    (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "M0002" "I cannot resolve module function bindings" (Diagnostics.diag_location input_file 0 0)))
                    (llm_write_diags_json llm_diags_json_path input_file output_file 1 diags)
                }
                return 1
            }

            /* I already parsed the transitive source set. Imports now describe
             * bindings; loading them again would duplicate declarations. */
            if verbose {
                (println "[2.5/5] Processing imports...")
            } else {
                (print "")
            }
            
            let cache: ModuleCache = (module_cache_new)
            let import_count: int = 0
            let mut imported_symbols: array<Symbol> = []
            if (> import_count 0) {
                set imported_symbols (process_imports_recursive parser [] cache source_to_compile diags)
            } else {
                (print "")
            }
            let imported_count: int = (array_length imported_symbols)
            
            if verbose {
                (print "  ✓ Loaded ")
                (print (int_to_string imported_count))
                (println " type symbols from imports")
            } else {
                (print "")
            }
            
            /* Step 3: Typechecker - Verify semantics */
            if verbose {
                (println "[3/5] NSType checking...")
            } else {
                (print "")
            }
            
            let mut first_shadow: int = 0
            if (not test_imports) { set first_shadow (native_shadow_start parser merge_result.root_line) }
            let has_shadows: bool = (< first_shadow parser.shadows_count)
            let tc: TypecheckPhaseOutput = (typecheck_phase_with_shadows parser source_to_compile imported_symbols first_shadow)
            if tc.had_error {
                (remap_diagnostics tc.diagnostics source_files source_lines)
                (println "NSType checking failed")
                (println "Diagnostics:")
                let diag_count: int = (Diagnostics.diag_list_count tc.diagnostics)
                let mut diag_i: int = 0
                while (< diag_i diag_count) {
                    let diag: CompilerDiagnostic = (Diagnostics.diag_list_get tc.diagnostics diag_i)
                    (print "  [")
                    (print diag.code)
                    (print "] ")
                    (print diag.message)
                    (print " (")
                    (print diag.location.file)
                    (print ":")
                    (print (int_to_string diag.location.line))
                    (print ":")
                    (print (int_to_string diag.location.column))
                    (println ")")
                    set diag_i (+ diag_i 1)
                }
                if (not (== llm_diags_json_path "")) {
                    (llm_write_diags_json llm_diags_json_path input_file output_file 1 tc.diagnostics)
                } else { (print "") }
                return 1
            } else { (print "") }
            
            if verbose {
                (println "  ✓ NSType checking passed")
            } else {
                (print "")
            }
            
            /* Step 3.5: Merge module union definitions into main parser */
            if (> import_count 0) {
                let unions_merged: int = (merge_module_unions parser source_to_compile diags)
                if (and verbose (> unions_merged 0)) {
                    (print "  ✓ Merged ")
                    (print (int_to_string unions_merged))
                    (println " union definitions from modules")
                } else { (print "") }
            } else { (print "") }

            # I lower once, check selected shadows, then publish the requested product.
                let assembly: string = (nanoisa_emit_program_nasm parser)
                if (== assembly "") {
                    (println (+ "I cannot lower this checked program: " (nanoisa_last_lowering_error)))
                    return 1
                }
                if (and has_shadows (not emit_c)) {
                    let shadow_assembly: string = (nanoisa_emit_shadows_nasm parser first_shadow)
                    if (== shadow_assembly "") {
                        (println (+ "I cannot lower the selected shadows: " (nanoisa_last_lowering_error)))
                        return 1
                    }
                    let directory: string = (mktemp_dir "nano_bytecode_shadows_")
                    if (== directory "") {
                        (println "I could not create bytecode shadow storage")
                        return 1
                    }
                    let shadow_file: string = (+ directory "/shadows.nvm")
                    let staged: int = (Nanoisa.assemble_text_save shadow_assembly shadow_file)
                    if (!= staged 0) {
                        (println (+ "I could not verify the shadow module: " (Nanoisa.last_error)))
                        (bytecode_shadow_cleanup directory)
                        return 1
                    }
                    let mut vm: string = (getenv "NANO_VM")
                    if (== vm "") { set vm (nl_path_join repo_root "bin/nano_vm") }
                    let command: string = (+ (native_shell_quote vm) (+ " --check-shadows " (native_shell_quote shadow_file)))
                    let checked: int = (nl_exec_shell command)
                    (bytecode_shadow_cleanup directory)
                    if (!= checked 0) {
                        (println "I will not publish bytecode after failed shadows")
                        return 1
                    }
                }
                let mut status: int = 0
                if emit_nvm {
                    set status (Nanoisa.assemble_text_save assembly output_file)
                } else {
                    let directory: string = (mktemp_dir "nano_bytecode_product_")
                    if (== directory "") { (println "I could not stage the verified module") return 1 }
                    let module_file: string = (+ directory "/program.nvm")
                    set status (Nanoisa.assemble_text_save assembly module_file)
                    if (== status 0) {
                        set status (publish_native_module module_file output_file repo_root
                            (resolve_cc_binary) (native_product_cflags (getenv "NANO_CFLAGS"))
                            (native_product_ldflags (getenv "NANO_LDFLAGS") (getenv "LDFLAGS")) emit_c keep_c show_intermediate_code verbose)
                    }
                    unsafe { (file_delete module_file) (file_delete directory) }
                }
                if (!= status 0) {
                    (println (+ "I could not publish the requested product: " (Nanoisa.last_error)))
                    return 1
                }
                if (!= llm_diags_json_path "") {
                    (llm_write_diags_json llm_diags_json_path input_file output_file 0 diags)
                }
                return 0
    }
}

/* =============================================================================
 * MAIN ENTRY POINT
 * ============================================================================= */

fn compile_program(input_file: string, output_file: string, verbose: bool, keep_c: bool, show_intermediate_code: bool, llm_diags_json_path: string, emit_c: bool, emit_nvm: bool, test_imports: bool, allow_temporary_files: bool, allow_tcp_connections: bool, implicit_module: bool) -> int {
    unsafe {
        let context: NlFileSourceSnapshots = (nl_source_inputs_new)
        if (== (nl_source_inputs_valid context) 0) {
            (println "I cannot allocate my compiler-input snapshot context.")
            return 1
        }
        let status: int = (compile_program_inputs input_file output_file verbose keep_c show_intermediate_code llm_diags_json_path emit_c emit_nvm test_imports allow_temporary_files allow_tcp_connections implicit_module context)
        (nl_source_inputs_free context)
        return status
    }
}

shadow compile_program_inputs {
    unsafe {
        let context: NlFileSourceSnapshots = (nl_source_inputs_new)
        assert (== (nl_source_inputs_valid context) 1)
        assert (== (compile_program_inputs "" "" false false false "" false false true false false false context) 1)
        assert (== (nl_source_inputs_count context) 0)
        (nl_source_inputs_free context)
    }
}

shadow compile_program {
    assert (== (compile_program "" "" false false false "" false false true false false false) 1)
}

fn show_usage() -> int {
    (println "")
    (println "╔══════════════════════════════════════════════════════════════╗")
    (println "║  NanoLang v0.6 - Self-Hosted Compiler                       ║")
    (println "╚══════════════════════════════════════════════════════════════╝")
    (println "")
    (println "Usage: nanoc <input.nano> [-o output] [options]")
    (println "")
    (println "Options:")
    (println "  -o <file>        Explicit native output; --emit-nvm selects module output")
    (println "  -v, --verbose    Verbose compilation output")
    (println "  -k, --keep-c     Keep generated C file")
    (println "  --target <t>    native or c; unqualified compilation publishes input.nvm")
    (println "  --emit-nvm     I publish verified NanoISA after VM shadow checks; requires -o")
    (println "  --test-imports  I run dependency shadows before root shadows (default)")
    (println "  --root-shadows-only  I run only root-file shadows")
    (println "  --allow-tcp-connections I grant selected TCP shadows outbound connections")
    (println "  --allow-temporary-files  I grant selected File shadows temporary-file access")
    (println "  File graphs default to native output (a.out without -o); runtime grants are separate")
    (println "  --              End options; the remaining argument is my input path")
    (println "  -fshow-intermediate-code  Print generated C to stdout")
    (println "  -h, --help       Show this help")
    (println "  --llm-diags-json <p>  Write machine-readable diagnostics JSON (agent-only)")
    (println "")
    (println "This compiler is 100% written in NanoLang!")
    (println "Pipeline: Lex → Parse → Typecheck → NanoISA → optional native translation")
    (println "")
    return 0
}

shadow show_usage {
    let result: int = (show_usage)
    assert (== result 0)  /* show_usage always returns 0 */
}

fn native_product_ldflags(configured: string, fallback: string) -> string {
    if (!= configured "") { return configured }
    return fallback
}
shadow native_product_ldflags {
    assert (== (native_product_ldflags "" "--coverage") "--coverage")
    assert (== (native_product_ldflags "-lchosen" "-lignored") "-lchosen")
    assert (== (native_product_ldflags "" "") "")
}

fn main() -> int {
    let opts: CompileOptions = (parse_args)
    if (!= opts.error "") {
        (println opts.error)
        return 1
    }
    
    if opts.show_help {
        return (show_usage)
    } else {
        (print "")
    }
    
    if (== opts.input_file "") {
        (println "Error: No input file specified")
        (println "Try 'nanoc --help' for usage information")
        return 1
    } else {
        (print "")
    }
    
    if (not (file_exists opts.input_file)) {
        (print "Error: Input file not found: ")
        (println opts.input_file)
        return 1
    } else {
        (print "")
    }
    
    return (compile_program opts.input_file opts.output_file opts.verbose opts.keep_c opts.show_intermediate_code opts.llm_diags_json_path opts.emit_c opts.emit_nvm opts.test_imports opts.allow_temporary_files opts.allow_tcp_connections opts.implicit_module)
}

shadow main {
    /* Basic sanity check */
    assert (== 1 1)
}
