fn resolve_cc_binary() -> string {
    let nano_cc: string = (getenv "NANO_CC")
    if (!= nano_cc "") {
        return nano_cc
    } else {
        let cc_env: string = (getenv "CC")
        if (!= cc_env "") {
            return cc_env
        } else {
            return "cc"
        }
    }
}

shadow resolve_cc_binary {
    let cc: string = (resolve_cc_binary)
    /* Should return a valid string (at minimum "cc") */
    assert (> (str_length cc) 0)
}

fn native_product_cflags(configured: string) -> string {
    if (== configured "") { return "-O1" }
    return configured
}

shadow native_product_cflags {
    assert (== (native_product_cflags "") "-O1")
    assert (== (native_product_cflags "-O0 -g") "-O0 -g")
    assert (== (native_product_cflags "-fsanitize=address") "-fsanitize=address")
}

/* =============================================================================
 * STRING HELPERS
 * ============================================================================= */

fn nlc_str_starts_with(s: string, prefix: string) -> bool {
    let len_s: int = (str_length s)
    let len_p: int = (str_length prefix)
    if (< len_s len_p) {
        return false
    } else {
        if (== len_p 0) { return true }
        # I retain the legacy byte-index boundary for longer interpreter strings.
        if (<= len_s 67108864) {
            return (== (str_substring s 0 len_p) prefix)
        }
        let mut i: int = 0
        while (< i len_p) {
            if (!= (char_at s i) (char_at prefix i)) {
                return false
            } else { (print "") }
            set i (+ i 1)
        }
        return true
    }
}

shadow nlc_str_starts_with {
    assert (nlc_str_starts_with "hello world" "hello")
    assert (not (nlc_str_starts_with "hello" "hello world"))
    assert (not (nlc_str_starts_with "world" "hello"))
    assert (nlc_str_starts_with "" "")
    assert (nlc_str_starts_with "a" "")
    assert (nlc_str_starts_with "same" "same")
    assert (not (nlc_str_starts_with "abc" "abd"))
    assert (not (nlc_str_starts_with "" "a"))
    assert (nlc_str_starts_with "éclair" "é")
    let partial_utf8: string = (str_substring "é" 0 1)
    assert (nlc_str_starts_with "éclair" partial_utf8)
    assert (not (nlc_str_starts_with "èclair" "é"))
}

fn nlc_str_ends_with(s: string, suffix: string) -> bool {
    let len_s: int = (str_length s)
    let len_x: int = (str_length suffix)
    if (< len_s len_x) {
        return false
    } else {
        let offset: int = (- len_s len_x)
        let mut i: int = 0
        while (< i len_x) {
            if (!= (char_at s (+ offset i)) (char_at suffix i)) {
                return false
            } else { (print "") }
            set i (+ i 1)
        }
        return true
    }
}

shadow nlc_str_ends_with {
    assert (nlc_str_ends_with "hello world" "world")
    assert (not (nlc_str_ends_with "world" "hello world"))
    assert (not (nlc_str_ends_with "hello" "world"))
    assert (nlc_str_ends_with "" "")
    assert (nlc_str_ends_with "a" "")
}

fn nlc_str_index_of(s: string, needle: string) -> int {
    let len_s: int = (str_length s)
    let len_n: int = (str_length needle)
    if (== len_n 0) {
        return 0
    } else {
        let mut i: int = 0
        while (<= (+ i len_n) len_s) {
            let mut j: int = 0
            let mut found: bool = true
            while (< j len_n) {
                if (!= (char_at s (+ i j)) (char_at needle j)) {
                    set found false
                    set j len_n
                } else {
                    set j (+ j 1)
                }
            }
            if found {
                return i
            } else { (print "") }
            set i (+ i 1)
        }
        return -1
    }
}

shadow nlc_str_index_of {
    assert (== (nlc_str_index_of "hello world" "world") 6)
    assert (== (nlc_str_index_of "hello" "ll") 2)
    assert (== (nlc_str_index_of "test" "xyz") -1)
    assert (== (nlc_str_index_of "test" "") 0)
}

fn nlc_str_last_index_of(s: string, needle: string) -> int {
    let len_s: int = (str_length s)
    let len_n: int = (str_length needle)
    if (== len_n 0) {
        return len_s
    } else {
        let mut i: int = (- len_s len_n)
        while (>= i 0) {
            let mut j: int = 0
            let mut found: bool = true
            while (< j len_n) {
                if (!= (char_at s (+ i j)) (char_at needle j)) {
                    set found false
                    set j len_n
                } else {
                    set j (+ j 1)
                }
            }
            if found {
                return i
            } else { (print "") }
            set i (- i 1)
        }
        return -1
    }
}

shadow nlc_str_last_index_of {
    assert (== (nlc_str_last_index_of "hello world hello" "hello") 12)
    assert (== (nlc_str_last_index_of "test test" "test") 5)
    assert (== (nlc_str_last_index_of "test" "xyz") -1)
    assert (== (nlc_str_last_index_of "test" "") 4)
}

fn nlc_hashset_new_string() -> HashMap<string, int> {
    let s: HashMap<string, int> = (map_new)
    return s
}

shadow nlc_hashset_new_string {
    let s: HashMap<string, int> = (nlc_hashset_new_string)
    assert (not (map_has s "fresh"))
    (map_put s "fresh" 1)
    assert (== (map_get s "fresh") 1)
}

fn nlc_hashset_has_string(hset: HashMap<string, int>, key: string) -> bool {
    return (map_has hset key)
}

shadow nlc_hashset_has_string {
    let s: HashMap<string, int> = (nlc_hashset_new_string)
    assert (not (nlc_hashset_has_string s "test"))
    (map_put s "test" 1)
    assert (nlc_hashset_has_string s "test")
}

fn nlc_hashset_add_string(hset: HashMap<string, int>, key: string) -> HashMap<string, int> {
    if (not (map_has hset key)) {
        (map_put hset key 1)
    } else { (print "") }
    return hset
}

shadow nlc_hashset_add_string {
    let s: HashMap<string, int> = (nlc_hashset_new_string)
    assert (not (nlc_hashset_has_string s "a"))
    let s2: HashMap<string, int> = (nlc_hashset_add_string s "a")
    assert (nlc_hashset_has_string s2 "a")
}

/* =============================================================================
 * IMPORT RESOLUTION (SIMPLIFIED)
 * ============================================================================= */

fn nl_path_dirname(path: string) -> string {
    if (== path "/") { return "/" }
    let mut p: string = path
    if (nlc_str_ends_with p "/") {
        set p (str_substring p 0 (- (str_length p) 1))
    } else { (print "") }

    let idx: int = (nlc_str_last_index_of p "/")
    if (== idx -1) {
        return "."
    } else {
        if (== idx 0) { return "/" } else { return (str_substring p 0 idx) }
    }
}

shadow nl_path_dirname {
    assert (== (nl_path_dirname "/") "/")
    assert (== (nl_path_dirname "/file") "/")
    assert (== (nl_path_dirname "/path/to/file") "/path/to")
    assert (== (nl_path_dirname "file") ".")
    assert (== (nl_path_dirname "/a/b/") "/a")
}

fn nl_path_join(dir: string, rel: string) -> string {
    if (or (== dir "") (== dir ".")) {
        return rel
    } else {
        if (nlc_str_ends_with dir "/") {
            return (+ dir rel)
        } else {
            return (+ (+ dir "/") rel)
        }
    }
}

shadow nl_path_join {
    assert (== (nl_path_join "/path/to" "file") "/path/to/file")
    assert (== (nl_path_join "/path/" "file") "/path/file")
    assert (== (nl_path_join "." "file") "file")
}

fn parse_env_int(name: string, default_val: int) -> int {
    let raw: string = (getenv name)
    if (== raw "") {
        return default_val
    } else {
        let n: int = (string_to_int raw)
        if (<= n 0) {
            return default_val
        } else {
            return n
        }
    }
}

shadow parse_env_int {
    assert (== (parse_env_int "___NANOLANG_TEST_ENV_INT___" 123) 123)
}

fn find_repo_root(start_dir: string) -> string {
    let mut dir: string = start_dir
    let mut i: int = 0
    let trace_env: string = (getenv "NANO_IMPORT_TRACE")
    let trace: bool = (!= trace_env "")
    while (< i 25) {
        if trace {
            (print "[import] find_repo_root: ")
            (println dir)
        } else { (print "") }
        let marker1: string = (nl_path_join dir ".beads/issues.jsonl")
        let marker2: string = (nl_path_join dir "src_nano/nanoc_v06.nano")
        if (or (file_exists marker1) (file_exists marker2)) {
            return dir
        } else {
            let parent: string = (nl_path_dirname dir)
            if (or (== parent dir) (== parent "")) {
                return ""
            } else {
                set dir parent
            }
        }
        set i (+ i 1)
    }
    return ""
}

fn split_lines(s: string) -> array<string> {
    let len: int = (str_length s)
    if (== len 0) { return [""] }
    # I retain the legacy larger-input substring boundary.
    if (<= len 67108864) { return (str_split s "\n") }
    let mut out: array<string> = []
    let mut start: int = 0
    let mut i: int = 0

    # I use unsigned byte indexing only within its existing interpreter bound.
    let byte_indexed: bool = (<= len 67108864)
    while (< i len) {
        let mut newline: bool = false
        if byte_indexed {
            set newline (== (char_at s i) 10)
        } else {
            set newline (== (str_substring s i 1) "\n")
        }
        if newline {
            set out (array_push out (str_substring s start (- i start)))
            set start (+ i 1)
        } else { (print "") }
        set i (+ i 1)
    }

    if (<= start len) {
        set out (array_push out (str_substring s start (- len start)))
    } else { (print "") }
    return out
}

shadow split_lines {
    let lines: array<string> = (split_lines "hello")
    assert (== (array_length lines) 1)
    assert (== (at lines 0) "hello")
    let empty: array<string> = (split_lines "")
    assert (== (array_length empty) 1)
    assert (== (at empty 0) "")
    let boundary: array<string> = (split_lines "\né\n\nend\n")
    assert (== (array_length boundary) 5)
    assert (== (at boundary 0) "")
    assert (== (at boundary 1) "é")
    assert (== (at boundary 2) "")
    assert (== (at boundary 3) "end")
    assert (== (at boundary 4) "")
    let crlf: array<string> = (split_lines "a\r\nb")
    assert (== (array_length crlf) 2)
    assert (== (at crlf 0) "a\r")
    assert (== (at crlf 1) "b")
    let delimiter: array<string> = (split_lines "\n")
    assert (== (array_length delimiter) 2)
    assert (== (at delimiter 0) "")
    assert (== (at delimiter 1) "")
    let carriage: array<string> = (split_lines "a\rb")
    assert (== (array_length carriage) 1)
    assert (== (at carriage 0) "a\rb")
}

fn parse_import_path_from_line(line: string) -> string {
    /* Handle: import "path", from "path" import ..., module "path" */
    let line_length: int = (str_length line)
    if (== line_length 0) { return "" }
    let leading: int = (char_at line 0)
    let mut recognized: bool = false
    if (== leading 112) { set recognized (nlc_str_starts_with line "pub use \"") }
    else if (== leading 105) { set recognized (nlc_str_starts_with line "import \"") }
    else if (== leading 102) { set recognized (nlc_str_starts_with line "from \"") }
    else if (== leading 109) { set recognized (nlc_str_starts_with line "module \"") }
    else if (== leading 117) { set recognized (nlc_str_starts_with line "unsafe module \"") }

    if recognized {
        let first_q: int = (nlc_str_index_of line "\"")
        let mut last_q: int = (+ first_q 1)
        while (< last_q line_length) {
            let source_char: int = (char_at line last_q)
            if (== source_char 34) { break }
            if (== source_char 92) { set last_q (+ last_q 1) }
            set last_q (+ last_q 1)
        }
        if (and (< last_q line_length) (and (>= first_q 0) (> last_q first_q))) {
            let result: string = (str_substring line (+ first_q 1) (- last_q (+ first_q 1)))
            return (parser_decode_import_path result)
        } else {
            return ""
        }
    } else {
        return ""
    }
}

shadow parse_import_path_from_line {
    assert (== (parse_import_path_from_line "unsafe module \"unsafe.nano\"") "unsafe.nano")
    assert (== (parse_import_path_from_line "") "")
    assert (== (parse_import_path_from_line "p") "")
    assert (== (parse_import_path_from_line "i") "")
    assert (== (parse_import_path_from_line "f") "")
    assert (== (parse_import_path_from_line "m") "")
    assert (== (parse_import_path_from_line "u") "")
    assert (== (parse_import_path_from_line "public use \"x\"") "")
    assert (== (parse_import_path_from_line "imports \"x\"") "")
    assert (== (parse_import_path_from_line "fromage \"x\"") "")
    assert (== (parse_import_path_from_line "modules \"x\"") "")
    assert (== (parse_import_path_from_line "unsafe import \"x\"") "")
    assert (== (parse_import_path_from_line "xmodule \"x\"") "")
    assert (== (parse_import_path_from_line " module \"x\"") "")
    assert (== (parse_import_path_from_line "\timport \"x\"") "")
    assert (== (parse_import_path_from_line "éimport \"x\"") "")
    assert (== (parse_import_path_from_line "# import \"x\"") "")
    assert (== (parse_import_path_from_line "pub use \"dep.nano\" as dep") "dep.nano")
    assert (== (parse_import_path_from_line "import \"std/io\"") "std/io")
    assert (== (parse_import_path_from_line "from \"modules/math\" import add") "modules/math")
    assert (== (parse_import_path_from_line "module \"mymod\"") "mymod")
    assert (== (parse_import_path_from_line "fn foo() -> int { return 0 }") "")
    assert (== (parse_import_path_from_line "module \"a\\\"b\\\\n.nano\" # \"comment\"") "a\"b\\n.nano")
    assert (== (parse_import_path_from_line "module \"bad\\0path\"") "")
    assert (== (parse_import_path_from_line "module \"unterminated") "")
}

fn nlc_str_trim(s: string) -> string {
    let len: int = (str_length s)
    let mut start: int = 0
    while (and (< start len) (or (== (char_at s start) 32) (or (== (char_at s start) 9) (== (char_at s start) 10)))) {
        set start (+ start 1)
    }
    let mut end: int = len
    while (and (> end start) (or (== (char_at s (- end 1)) 32) (or (== (char_at s (- end 1)) 9) (== (char_at s (- end 1)) 10)))) {
        set end (- end 1)
    }
    if (>= start end) { return "" } else { (print "") }
    return (str_substring s start (- end start))
}

shadow nlc_str_trim {
    assert (== (nlc_str_trim "  hello  ") "hello")
    assert (== (nlc_str_trim "x") "x")
    assert (== (nlc_str_trim "") "")
}

fn extract_from_aliases(lines: array<string>) -> array<string> {
    let mut result: array<string> = []
    let mut i: int = 0
    while (< i (array_length lines)) {
        let line: string = (at lines i)
        if (nlc_str_starts_with line "from ") {
            let import_kw: int = (nlc_str_index_of line " import ")
            if (>= import_kw 0) {
                let after_import: string = (str_substring line (+ import_kw 8) (- (str_length line) (+ import_kw 8)))
                let alen: int = (str_length after_import)
                let mut pos: int = 0
                while (< pos alen) {
                    while (and (< pos alen) (== (char_at after_import pos) 32)) { set pos (+ pos 1) }
                    let mut end: int = pos
                    while (and (< end alen) (and (!= (char_at after_import end) 44) (!= (char_at after_import end) 32))) { set end (+ end 1) }
                    let sym: string = (str_substring after_import pos (- end pos))
                    set pos end
                    while (and (< pos alen) (== (char_at after_import pos) 32)) { set pos (+ pos 1) }
                    if (and (< (+ pos 2) alen) (== (str_substring after_import pos 3) "as ")) {
                        set pos (+ pos 3)
                        while (and (< pos alen) (== (char_at after_import pos) 32)) { set pos (+ pos 1) }
                        let mut aend: int = pos
                        while (and (< aend alen) (and (!= (char_at after_import aend) 44) (!= (char_at after_import aend) 32))) { set aend (+ aend 1) }
                        let alias: string = (str_substring after_import pos (- aend pos))
                        if (and (> (str_length sym) 0) (> (str_length alias) 0)) {
                            set result (array_push result alias)
                            set result (array_push result sym)
                        } else { (print "") }
                        set pos aend
                    } else { (print "") }
                    while (and (< pos alen) (or (== (char_at after_import pos) 44) (== (char_at after_import pos) 32))) { set pos (+ pos 1) }
                }
            } else { (print "") }
        } else { (print "") }
        set i (+ i 1)
    }
    return result
}

shadow extract_from_aliases {
    assert (== 1 1)
}

fn apply_alias(line: string, alias: string, original: string) -> string {
    let alen: int = (str_length alias)
    let llen: int = (str_length line)
    let mut result: string = ""
    let mut i: int = 0
    while (<= i (- llen alen)) {
        let candidate: string = (str_substring line i alen)
        if (== candidate alias) {
            let before_ok: bool = (or (== i 0) (not (is_ident_char (char_at line (- i 1)))))
            let after_pos: int = (+ i alen)
            let after_ok: bool = (or (>= after_pos llen) (not (is_ident_char (char_at line after_pos))))
            if (and before_ok after_ok) {
                set result (+ result original)
                set i (+ i alen)
            } else {
                set result (+ result (str_substring line i 1))
                set i (+ i 1)
            }
        } else {
            set result (+ result (str_substring line i 1))
            set i (+ i 1)
        }
    }
    while (< i llen) {
        set result (+ result (str_substring line i 1))
        set i (+ i 1)
    }
    return result
}

shadow apply_alias {
    assert (== 1 1)
}

fn is_ident_char(c: int) -> bool {
    if (and (>= c 97) (<= c 122)) { return true } else { (print "") }
    if (and (>= c 65) (<= c 90)) { return true } else { (print "") }
    if (and (>= c 48) (<= c 57)) { return true } else { (print "") }
    if (== c 95) { return true } else { (print "") }
    return false
}

shadow is_ident_char {
    assert (is_ident_char 97)
    assert (not (is_ident_char 32))
}

fn apply_all_aliases(line: string, aliases: array<string>) -> string {
    let mut result: string = line
    let mut i: int = 0
    while (< i (array_length aliases)) {
        let alias: string = (at aliases i)
        let original: string = (at aliases (+ i 1))
        set result (apply_alias result alias original)
        set i (+ i 2)
    }
    return result
}

shadow apply_all_aliases {
    assert (== 1 1)
}

fn strip_pub_decl(line: string) -> string {
    if (nlc_str_starts_with line "pub fn ") {
        return (+ "fn " (str_substring line 7 (- (str_length line) 7)))
    } else {
        if (nlc_str_starts_with line "pub struct ") {
            return (+ "struct " (str_substring line 11 (- (str_length line) 11)))
        } else {
            if (nlc_str_starts_with line "pub enum ") {
                return (+ "enum " (str_substring line 9 (- (str_length line) 9)))
            } else {
                if (nlc_str_starts_with line "pub union ") {
                    return (+ "union " (str_substring line 10 (- (str_length line) 10)))
                } else {
                    return line
                }
            }
        }
    }
}

shadow strip_pub_decl {
    assert (== (strip_pub_decl "pub fn test() -> int") "fn test() -> int")
    assert (== (strip_pub_decl "pub struct Point") "struct Point")
    assert (== (strip_pub_decl "pub enum Color") "enum Color")
    assert (== (strip_pub_decl "let x: int = 5") "let x: int = 5")
}

fn native_sdk_import_candidate(import_path: string) -> string {
    let root: string = (NativeSdk.runtime_root)
    if (== root "") { return "" }
    let prefixes: array<string> = ["stdlib/", "modules/", ""]
    let mut i: int = 0
    while (< i (array_length prefixes)) {
        let candidate: string = (nl_path_join root (+ (at prefixes i) import_path))
        if (file_exists candidate) { return candidate }
        set i (+ i 1)
    }
    return ""
}
shadow native_sdk_import_candidate {
    assert (== (native_sdk_import_candidate "__missing_sdk_input_719389.nano") "")
}

fn resolve_import_path(current_file: string, import_path: string, repo_root: string) -> string {
    if (== import_path "") {
        return ""
    } else {
        /* Special case for std library - check NANO_MODULE_PATH and modules/ directory */
        if (nlc_str_starts_with import_path "std/") {
            let module_path_env: string = (getenv "NANO_MODULE_PATH")
            if (not (== module_path_env "")) {
                let candidate: string = (nl_path_join module_path_env import_path)
                if (file_exists candidate) {
                    return candidate
                } else { (print "") }
            } else { (print "") }
            let modules_candidate: string = (nl_path_join "modules" import_path)
            if (file_exists modules_candidate) {
                return modules_candidate
            } else { (print "") }
            if (!= repo_root "") {
                let repo_candidate: string = (nl_path_join repo_root (nl_path_join "modules" import_path))
                if (file_exists repo_candidate) {
                    return repo_candidate
                } else { (print "") }
            } else { (print "") }
            let sdk_candidate: string = (native_sdk_import_candidate import_path)
            if (!= sdk_candidate "") { return sdk_candidate }
            return (nl_path_join "modules" import_path)
        } else {
            if (nlc_str_starts_with import_path "/") {
                return import_path
            } else {
                if (or (nlc_str_starts_with import_path "./") (nlc_str_starts_with import_path "../")) {
                    return (nl_path_join (nl_path_dirname current_file) import_path)
                } else {
                    /* I resolve bare paths beside their importer before repository fallback. */
                    let relative: string = (nl_path_join (nl_path_dirname current_file) import_path)
                    if (file_exists relative) { return relative }
                    if (!= repo_root "") {
                        let project_candidate: string = (nl_path_join repo_root import_path)
                        if (file_exists project_candidate) { return project_candidate }
                    }
                    let sdk_candidate: string = (native_sdk_import_candidate import_path)
                    if (!= sdk_candidate "") { return sdk_candidate }
                    if (!= repo_root "") {
                        return (nl_path_join repo_root import_path)
                    } else {
                        return import_path
                    }
                }
            }
        }
    }
}

shadow resolve_import_path {
    let p1: string = (resolve_import_path "" "/abs" "")
    assert (== p1 "/abs")
    assert (== (resolve_import_path "/project/tests/main.nano" "./local.nano" "/project") "/project/tests/./local.nano")
    assert (== (resolve_import_path "/project/tests/main.nano" "../local.nano" "/project") "/project/tests/../local.nano")
    assert (== (resolve_import_path "tests/main.nano" "test_modules/metadata_probe.nano" "/missing-root") "tests/test_modules/metadata_probe.nano")
    assert (== (resolve_import_path "tests/main.nano" "missing_probe_211.nano" "/project") "/project/missing_probe_211.nano")
}

struct CollectResult {
    visited: array<string>,
    visited_set: HashMap<string, int>,
    order: array<string>,
    sources: array<string>,
    parsed: array<ParsedDeclarations>,
    ok: bool,
    lines_scanned: int,
    input_bytes: int, edges: int
}

fn collect_files_dfs(path: string, repo_root: string, visited: array<string>, visited_set: HashMap<string, int>, order: array<string>, sources: array<string>, ok: bool, max_files: int, max_lines: int, max_lines_per_file: int, lines_scanned: int, trace: bool) -> CollectResult {
    if (or (not ok) (!= (array_length order) (array_length sources))) {
        return CollectResult { visited: visited, visited_set: visited_set, order: order, sources: sources, parsed: [], ok: false, lines_scanned: lines_scanned, input_bytes: 0, edges: 0 }
    } else { (print "") }

    # I resolve symlinks before deduplication and relative dependency lookup.
    let norm_path: string = (canonical path)
    if (== norm_path "") {
        (println (+ "I cannot resolve a source path: " path))
        return CollectResult { visited: visited, visited_set: visited_set, order: order, sources: sources, parsed: [], ok: false, lines_scanned: lines_scanned, input_bytes: 0, edges: 0 }
    }

    if (nlc_hashset_has_string visited_set norm_path) {
        return CollectResult { visited: visited, visited_set: visited_set, order: order, sources: sources, parsed: [], ok: true, lines_scanned: lines_scanned, input_bytes: 0, edges: 0 }
    } else {
        let mut visited2: array<string> = (array_push visited norm_path)
        let mut visited_set2: HashMap<string, int> = visited_set
        set visited_set2 (nlc_hashset_add_string visited_set2 norm_path)
        if (> (array_length visited2) max_files) {
            (print "Error: import scan exceeded max files (")
            (print max_files)
            (print "): ")
            (println path)
            return CollectResult { visited: visited2, visited_set: visited_set2, order: order, sources: sources, parsed: [], ok: false, lines_scanned: lines_scanned, input_bytes: 0, edges: 0 }
        } else { (print "") }
        let mut src: string = ""
        set src (file_read norm_path)
        let lines: array<string> = (split_lines src)

        let mut order2: array<string> = order
        let mut sources2: array<string> = sources
        let mut ok2: bool = true
        let mut i: int = 0
        let mut lines_scanned2: int = lines_scanned
        if trace {
            (print "[import] ")
            (println norm_path)
        } else { (print "") }
        while (< i (array_length lines)) {
            set lines_scanned2 (+ lines_scanned2 1)
            if (> lines_scanned2 max_lines) {
                (print "Error: import scan exceeded max lines (")
                (print max_lines)
                (print ") while scanning: ")
                (println norm_path)
                return CollectResult { visited: visited2, visited_set: visited_set2, order: order2, sources: sources2, parsed: [], ok: false, lines_scanned: lines_scanned2, input_bytes: 0, edges: 0 }
            } else { (print "") }
            if (> i max_lines_per_file) {
                (print "Error: import scan exceeded max lines per file (")
                (print max_lines_per_file)
                (print ") while scanning: ")
                (println norm_path)
                return CollectResult { visited: visited2, visited_set: visited_set2, order: order2, sources: sources2, parsed: [], ok: false, lines_scanned: lines_scanned2, input_bytes: 0, edges: 0 }
            } else { (print "") }
            if (and trace (== (% lines_scanned2 500) 0)) {
                (print "[import] scanned lines: ")
                (println lines_scanned2)
            } else { (print "") }
            let imp: string = (parse_import_path_from_line (at lines i))
            let import_line: string = (at lines i)
            let quoted_import: bool = (or (nlc_str_starts_with import_line "pub use \"") (or (or (nlc_str_starts_with import_line "module \"") (nlc_str_starts_with import_line "unsafe module \"")) (or (nlc_str_starts_with import_line "import \"") (nlc_str_starts_with import_line "from \""))))
            if (and quoted_import (== imp "")) {
                (println "I cannot use an empty, unterminated or NUL-containing import path.")
                return CollectResult { visited: visited2, visited_set: visited_set2, order: order2, sources: sources2, parsed: [], ok: false, lines_scanned: lines_scanned2, input_bytes: 0, edges: 0 }
            }
            if (!= imp "") {
                let dep: string = (resolve_import_path norm_path imp repo_root)
                if (== dep "") {
                    (print "Error: bad import path in ")
                    (println norm_path)
                    set ok2 false
                } else {
                    if (file_exists dep) {
                        let res: CollectResult = (collect_files_dfs dep repo_root visited2 visited_set2 order2 sources2 ok2 max_files max_lines max_lines_per_file lines_scanned2 trace)
                        set visited2 res.visited
                        set visited_set2 res.visited_set
                        set order2 res.order
                        set sources2 res.sources
                        set ok2 res.ok
                        set lines_scanned2 res.lines_scanned
                    } else {
                        (print "Error: import not found: ")
                        (println dep)
                        set ok2 false
                    }
                }
            } else { (print "") }
            set i (+ i 1)
        }

        if ok2 {
            set order2 (array_push order2 norm_path)
            set sources2 (array_push sources2 src)
        } else { (print "") }
        return CollectResult { visited: visited2, visited_set: visited_set2, order: order2, sources: sources2, parsed: [], ok: ok2, lines_scanned: lines_scanned2, input_bytes: 0, edges: 0 }
    }
}

# I use my actual parser's import nodes only in the opted-in preparation path.
fn collect_files_ast(path: string, repo_root: string, input: CollectResult,
    max_files: int, max_lines: int, max_file_lines: int, trace: bool) -> CollectResult {
    let mut result: CollectResult = input
    if (not result.ok) { return result }
    if (or (!= (array_length result.order) (array_length result.sources))
        (!= (array_length result.order) (array_length result.parsed))) {
        set result (CollectResult { visited: result.visited, visited_set: result.visited_set, order: result.order, sources: result.sources, parsed: result.parsed, ok: false, lines_scanned: result.lines_scanned, input_bytes: result.input_bytes, edges: result.edges }) return result
    }
    let norm_path: string = (canonical path)
    let path_bytes: int = (str_length norm_path)
    if (or (<= path_bytes 0) (> path_bytes 4095)) { set result (CollectResult { visited: result.visited, visited_set: result.visited_set, order: result.order, sources: result.sources, parsed: result.parsed, ok: false, lines_scanned: result.lines_scanned, input_bytes: result.input_bytes, edges: result.edges }) return result }
    if (nlc_hashset_has_string result.visited_set norm_path) {
        # Only a completed first parse can be reused; active cycles refuse.
        let mut i: int = 0
        while (< i (array_length result.order)) {
            if (== (at result.order i) norm_path) { return result }
            set i (+ i 1)
        }
        set result (CollectResult { visited: result.visited, visited_set: result.visited_set, order: result.order, sources: result.sources, parsed: result.parsed, ok: false, lines_scanned: result.lines_scanned, input_bytes: result.input_bytes, edges: result.edges }) return result
    }
    if (or (>= (array_length result.visited) max_files) (>= result.input_bytes 67108864)) {
        set result (CollectResult { visited: result.visited, visited_set: result.visited_set, order: result.order, sources: result.sources, parsed: result.parsed, ok: false, lines_scanned: result.lines_scanned, input_bytes: result.input_bytes, edges: result.edges }) return result
    }
    set result (CollectResult { visited: (array_push result.visited norm_path), visited_set: result.visited_set, order: result.order, sources: result.sources, parsed: result.parsed, ok: result.ok, lines_scanned: result.lines_scanned, input_bytes: result.input_bytes, edges: result.edges })
    set result (CollectResult { visited: result.visited, visited_set: (nlc_hashset_add_string result.visited_set norm_path), order: result.order, sources: result.sources, parsed: result.parsed, ok: result.ok, lines_scanned: result.lines_scanned, input_bytes: result.input_bytes, edges: result.edges })
    let copied: SourceCompanion.SourceInput = (SourceCompanion.source norm_path (- 67108864 result.input_bytes))
    if (!= copied.status 0) { set result (CollectResult { visited: result.visited, visited_set: result.visited_set, order: result.order, sources: result.sources, parsed: result.parsed, ok: false, lines_scanned: result.lines_scanned, input_bytes: result.input_bytes, edges: result.edges }) return result }
    set result (CollectResult { visited: result.visited, visited_set: result.visited_set, order: result.order, sources: result.sources, parsed: result.parsed, ok: result.ok, lines_scanned: result.lines_scanned, input_bytes: (+ result.input_bytes (+ copied.size 1)), edges: result.edges })
    let line_count: int = copied.lines
    if (or (> line_count max_file_lines) (> line_count (- max_lines result.lines_scanned))) {
        set result (CollectResult { visited: result.visited, visited_set: result.visited_set, order: result.order, sources: result.sources, parsed: result.parsed, ok: false, lines_scanned: result.lines_scanned, input_bytes: result.input_bytes, edges: result.edges }) return result
    }
    set result (CollectResult { visited: result.visited, visited_set: result.visited_set, order: result.order, sources: result.sources, parsed: result.parsed, ok: result.ok, lines_scanned: (+ result.lines_scanned line_count), input_bytes: result.input_bytes, edges: result.edges })
    if trace { (println (+ "[import-ast] " norm_path)) }
    let tokens: List<LexerToken> = (tokenize_string copied.source norm_path (list_CompilerDiagnostic_new))
    let parsed: ParsedDeclarations = (parse_program_declarations tokens (list_LexerToken_length tokens) norm_path)
    if (parser_has_error parsed.parser) { set result (CollectResult { visited: result.visited, visited_set: result.visited_set, order: result.order, sources: result.sources, parsed: result.parsed, ok: false, lines_scanned: result.lines_scanned, input_bytes: result.input_bytes, edges: result.edges }) return result }
    let mut i: int = 0
    while (< i (parser_get_import_count parsed.parser)) {
        if (>= result.edges 50000) { set result (CollectResult { visited: result.visited, visited_set: result.visited_set, order: result.order, sources: result.sources, parsed: result.parsed, ok: false, lines_scanned: result.lines_scanned, input_bytes: result.input_bytes, edges: result.edges }) return result }
        set result (CollectResult { visited: result.visited, visited_set: result.visited_set, order: result.order, sources: result.sources, parsed: result.parsed, ok: result.ok, lines_scanned: result.lines_scanned, input_bytes: result.input_bytes, edges: (+ result.edges 1) })
        let imported: ASTImport = (parser_get_import parsed.parser i)
        let dep: string = (resolve_import_path norm_path imported.module_path repo_root)
        if (== dep "") { set result (CollectResult { visited: result.visited, visited_set: result.visited_set, order: result.order, sources: result.sources, parsed: result.parsed, ok: false, lines_scanned: result.lines_scanned, input_bytes: result.input_bytes, edges: result.edges }) return result }
        set result (collect_files_ast dep repo_root result max_files max_lines max_file_lines trace)
        if (not result.ok) { return result }
        set i (+ i 1)
    }
    set result (CollectResult { visited: result.visited, visited_set: result.visited_set, order: (array_push result.order norm_path), sources: result.sources, parsed: result.parsed, ok: result.ok, lines_scanned: result.lines_scanned, input_bytes: result.input_bytes, edges: result.edges })
    set result (CollectResult { visited: result.visited, visited_set: result.visited_set, order: result.order, sources: (array_push result.sources copied.source), parsed: result.parsed, ok: result.ok, lines_scanned: result.lines_scanned, input_bytes: result.input_bytes, edges: result.edges })
    set result (CollectResult { visited: result.visited, visited_set: result.visited_set, order: result.order, sources: result.sources, parsed: (array_push result.parsed parsed), ok: result.ok, lines_scanned: result.lines_scanned, input_bytes: result.input_bytes, edges: result.edges })
    return result
}
shadow collect_files_ast {
    let empty: CollectResult = CollectResult { visited: [], visited_set: (nlc_hashset_new_string),
        order: [], sources: [], parsed: [], ok: true, lines_scanned: 0, input_bytes: 0, edges: 0 }
    let invalid: CollectResult = (collect_files_ast "" "" empty 10 100 100 false)
    assert (not invalid.ok)
    assert (== (array_length invalid.order) 0)
}

