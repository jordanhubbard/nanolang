    assert (== (array_length peg.sources) (+ (array_length ordinary.sources) 1))
    assert (== (at peg.sources (- (array_length peg.sources) 1)) "/repo/modules/std/peg2/peg2.c")
}


fn json_extract_string_array(text: string, key: string) -> array<string> {
    let mut result: array<string> = []
    let search: string = (+ "\"" (+ key "\""))
    let idx: int = (nlc_str_index_of text search)
    if (< idx 0) { return result } else { (print "") }
    let after_key: int = (+ idx (str_length search))
    let tlen: int = (str_length text)
    let mut pos: int = after_key
    while (and (< pos tlen) (!= (char_at text pos) 91)) { set pos (+ pos 1) }
    if (>= pos tlen) { return result } else { (print "") }
    set pos (+ pos 1)
    while (< pos tlen) {
        let ch: int = (char_at text pos)
        if (== ch 93) { return result } else { (print "") }
        if (== ch 34) {
            set pos (+ pos 1)
            let mut end: int = pos
            while (and (< end tlen) (!= (char_at text end) 34)) { set end (+ end 1) }
            if (< end tlen) {
                let val: string = (str_substring text pos (- end pos))
                set result (array_push result val)
                set pos (+ end 1)
            } else { set pos end }
        } else { set pos (+ pos 1) }
    }
    return result
}

shadow json_extract_string_array {
    let json: string = "{\"pkg_config\": [\"sdl2\", \"SDL2_mixer\"], \"name\": \"test\"}"
    let pkgs: array<string> = (json_extract_string_array json "pkg_config")
    assert (== (array_length pkgs) 2)
    assert (== (at pkgs 0) "sdl2")
    assert (== (at pkgs 1) "SDL2_mixer")
    let empty: array<string> = (json_extract_string_array json "missing")
    assert (== (array_length empty) 0)
}

fn json_extract_string(text: string, key: string) -> string {
    let search: string = (+ "\"" (+ key "\""))
    let idx: int = (nlc_str_index_of text search)
    if (< idx 0) { return "" } else { (print "") }
    let after_key: int = (+ idx (str_length search))
    let tlen: int = (str_length text)
    let mut pos: int = after_key
    while (and (< pos tlen) (!= (char_at text pos) 34)) { set pos (+ pos 1) }
    if (>= pos tlen) { return "" } else { (print "") }
    set pos (+ pos 1)
    let mut end: int = pos
    while (and (< end tlen) (!= (char_at text end) 34)) { set end (+ end 1) }
    if (>= end tlen) { return "" } else { (print "") }
    return (str_substring text pos (- end pos))
}

shadow json_extract_string {
    let json: string = "{\"c_compiler\": \"c++\", \"name\": \"bullet\"}"
    assert (== (json_extract_string json "c_compiler") "c++")
    assert (== (json_extract_string json "missing") "")
}

fn nlc_path_basename(path: string) -> string {
    let len: int = (str_length path)
    let mut i: int = (- len 1)
    while (and (>= i 0) (!= (char_at path i) 47)) { set i (- i 1) }
    return (str_substring path (+ i 1) (- len (+ i 1)))
}

shadow nlc_path_basename {
    assert (== (nlc_path_basename "/foo/bar.c") "bar.c")
    assert (== (nlc_path_basename "test.c") "test.c")
}

fn native_module_origin(path: string, project_root: string, runtime_root: string) -> string {
    if (nlc_str_starts_with path (+ runtime_root "/modules/")) { return runtime_root }
    return project_root
}
shadow native_module_origin {
    assert (== (native_module_origin "/sdk/modules/a/a.nano" "/project" "/sdk") "/sdk")
    assert (== (native_module_origin "/project/modules/a/a.nano" "/project" "/sdk") "/project")
    assert (== (native_module_origin "/sdk-other/modules/a/a.nano" "/project" "/sdk") "/project")
}

fn collect_module_dirs(files: array<string>, repo_root: string, runtime_root: string) -> array<string> {
    let mut dirs: array<string> = []
    let mut seen: array<string> = []
    let mut i: int = 0
    while (< i (array_length files)) {
        let f: string = (at files i)
        let origin: string = (native_module_origin f repo_root runtime_root)
        let modules_prefix: string = (+ origin "/modules/")
        let std_prefix: string = (+ origin "/modules/std/")
        if (and (nlc_str_starts_with f modules_prefix) (not (nlc_str_starts_with f std_prefix))) {
            let dir: string = (nl_path_dirname f)
            let mut dup: bool = false
            let mut j: int = 0
            while (< j (array_length seen)) {
                if (== (at seen j) dir) { set dup true } else { (print "") }
                set j (+ j 1)
            }
            if (not dup) {
                set dirs (array_push dirs dir)
                set seen (array_push seen dir)
            } else { (print "") }
        } else { (print "") }
        set i (+ i 1)
    }
    return dirs
}

shadow collect_module_dirs {
    let dirs: array<string> = (collect_module_dirs ["/project/modules/a/a.nano", "/sdk/modules/b/b.nano", "/project/modules/a/other.nano", "/sdk/modules/std/fs.nano"] "/project" "/sdk")
    assert (== (array_length dirs) 2)
    assert (== (at dirs 0) "/project/modules/a")
    assert (== (at dirs 1) "/sdk/modules/b")
}

struct NativeCapturedFlags { value: string, ok: bool }
fn native_decode_flags(output: string) -> NativeCapturedFlags {
    let marker: string = "\n__NANO_PROVIDER_FLAGS_OK__"
    let size: int = (str_length output)
    let marker_size: int = (str_length marker)
    if (or (< size marker_size) (>= size 65535)) { return NativeCapturedFlags { value: "", ok: false } }
    if (!= (str_substring output (- size marker_size) marker_size) marker) {
        return NativeCapturedFlags { value: "", ok: false }
    }
    return NativeCapturedFlags { value: (nlc_str_trim (str_substring output 0 (- size marker_size))), ok: true }
}
shadow native_decode_flags {
    let empty: NativeCapturedFlags = (native_decode_flags "\n__NANO_PROVIDER_FLAGS_OK__")
    assert empty.ok assert (== empty.value "")
    assert (not (native_decode_flags "-DMISSING").ok)
}
fn native_capture_flags(command: string) -> NativeCapturedFlags {
    if (or (== command "") (> (str_length command) 1048000)) { return NativeCapturedFlags { value: "", ok: false } }
    let checked: string = (+ command " && printf '\\n__NANO_PROVIDER_FLAGS_OK__'")
    return (native_decode_flags (nl_exec_capture checked))
}
shadow native_capture_flags { assert (not (native_capture_flags "").ok) }

fn collect_module_build_flags(files: array<string>, repo_root: string, runtime_root: string, native_dir: string, verbose: bool) -> ModuleBuildFlags {
    if (== native_dir "") { return (native_build_empty) }
    let mut module_dirs: array<string> = (collect_module_dirs files repo_root runtime_root)
    let mut cflags: string = ""
    let mut ldflags: string = ""
    if (> (array_length module_dirs) 5000) { return (native_build_empty) }
    let selected_compiler: string = (resolve_cc_binary)
    if (or (== selected_compiler "") (> (str_length selected_compiler) 1048576)) { return (native_build_empty) }
    let mut requests: array<NativeProvider> = []
    let mut processed_pkgs: array<string> = []

    let mut i: int = 0
    while (< i (array_length module_dirs)) {
        let dir: string = (at module_dirs i)
        let metadata_root: string = (native_module_origin (+ dir "/") repo_root runtime_root)
        let json_path: string = (nl_path_join dir "module.json")
        if (file_exists json_path) {
            let json_text: string = (file_read json_path)
            if (> (str_length json_text) 1048576) { return (native_build_empty) }
            let mod_name: string = (json_extract_string json_text "name")
            if verbose {
                (print "  [module] ")
                (print mod_name)
                (print " (")
                (print dir)
                (println ")")
            } else { (print "") }

            /* pkg-config: collect compile and link flags */
            let pkgs: array<string> = (json_extract_string_array json_text "pkg_config")
            let mut pi: int = 0
            while (< pi (array_length pkgs)) {
                let pkg: string = (at pkgs pi)
                let mut already: bool = false
                let mut ai: int = 0
                while (< ai (array_length processed_pkgs)) {
                    if (== (at processed_pkgs ai) pkg) { set already true } else { (print "") }
                    set ai (+ ai 1)
                }
                if (not already) {
                    set processed_pkgs (array_push processed_pkgs pkg)
                    let cflags_cmd: string = (+ "pkg-config --cflags " (native_shell_quote pkg))
                    let captured_cflags: NativeCapturedFlags = (native_capture_flags cflags_cmd)
                    if (not captured_cflags.ok) { return (native_build_empty) }
                    let pkg_cflags: string = captured_cflags.value
                    if (> (str_length pkg_cflags) 0) {
                        set cflags (native_profile_append cflags (+ " " pkg_cflags))
                        if (== cflags "") { return (native_build_empty) }
                        if verbose {
                            (print "    pkg-config --cflags ")
                            (print pkg)
                            (print " -> ")
                            (println pkg_cflags)
                        } else { (print "") }
                    } else { (print "") }
                    let ldflags_cmd: string = (+ "pkg-config --libs " (native_shell_quote pkg))
                    let captured_ldflags: NativeCapturedFlags = (native_capture_flags ldflags_cmd)
                    if (not captured_ldflags.ok) { return (native_build_empty) }
                    let pkg_ldflags: string = captured_ldflags.value
                    if (> (str_length pkg_ldflags) 0) {
                        set ldflags (native_profile_append ldflags (+ " " pkg_ldflags))
                        if (== ldflags "") { return (native_build_empty) }
                        if verbose {
                            (print "    pkg-config --libs ")
                            (print pkg)
                            (print " -> ")
                            (println pkg_ldflags)
                        } else { (print "") }
                    } else { (print "") }
                } else { (print "") }
                set pi (+ pi 1)
            }

            /* Direct ldflags from module.json */
            let mod_ldflags: array<string> = (json_extract_string_array json_text "ldflags")
            let mut li: int = 0
            while (< li (array_length mod_ldflags)) {
                set ldflags (native_profile_append ldflags (+ " " (at mod_ldflags li)))
                if (== ldflags "") { return (native_build_empty) }
                set li (+ li 1)
            }

            /* system_libs -> -l flags */
            let sys_libs: array<string> = (json_extract_string_array json_text "system_libs")
            let mut si: int = 0
            while (< si (array_length sys_libs)) {
                set ldflags (native_profile_append ldflags (+ " -l" (at sys_libs si)))
                if (== ldflags "") { return (native_build_empty) }
                set si (+ si 1)
            }

            /* frameworks (macOS) */
            let frameworks: array<string> = (json_extract_string_array json_text "frameworks")
            let mut fi: int = 0
            while (< fi (array_length frameworks)) {
                set ldflags (native_profile_append ldflags (+ " -framework " (at frameworks fi)))
                if (== ldflags "") { return (native_build_empty) }
                set fi (+ fi 1)
            }

            /* cflags from module.json */
            let mod_cflags: array<string> = (json_extract_string_array json_text "cflags")
            let mut ci: int = 0
            while (< ci (array_length mod_cflags)) {
                let flag: string = (at mod_cflags ci)
                if (nlc_str_starts_with flag "-I") {
                    let rel_path: string = (str_substring flag 2 (- (str_length flag) 2))
                    set cflags (native_profile_append cflags (+ " -I" (native_shell_quote (nl_path_join metadata_root rel_path))))
                    if (== cflags "") { return (native_build_empty) }
                } else {
                    set cflags (native_profile_append cflags (+ " " flag))
                    if (== cflags "") { return (native_build_empty) }
                }
                set ci (+ ci 1)
            }

            /* include_dirs */
            let inc_dirs: array<string> = (json_extract_string_array json_text "include_dirs")
            let mut ii: int = 0
            while (< ii (array_length inc_dirs)) {
                set cflags (native_profile_append cflags (+ " -I" (native_shell_quote (nl_path_join metadata_root (at inc_dirs ii)))))
                if (== cflags "") { return (native_build_empty) }
                set ii (+ ii 1)
            }

            /* Always add the module dir itself as an include path */
            set cflags (native_profile_append cflags (+ " -I" (native_shell_quote dir)))
            if (== cflags "") { return (native_build_empty) }

            # I retain requests now; every compilation waits for the final profile.
            let mut c_sources: array<string> = (json_extract_string_array json_text "c_sources")
            let shared_sources: array<string> = (json_extract_string_array json_text "shared_c_sources")
            if (> (+ (array_length c_sources) (array_length shared_sources)) (- 50000 (array_length requests))) { return (native_build_empty) }
            let mut shared_index: int = 0
            while (< shared_index (array_length shared_sources)) {
                set c_sources (array_push c_sources (at shared_sources shared_index))
                set shared_index (+ shared_index 1)
            }
            let c_compiler: string = (json_extract_string json_text "c_compiler")
            if (and (!= c_compiler "") (!= c_compiler "c++")) { return (native_build_empty) }
            let mut compiler: string = selected_compiler
            let mut language: string = "c99"
            if (== c_compiler "c++") { set compiler "c++" set language "c++11" }
            let mut csi: int = 0
            while (< csi (array_length c_sources)) {
                if (>= (array_length requests) 50000) { return (native_build_empty) }
                let source: string = (canonical (nl_path_join dir (at c_sources csi)))
                if (== source "") { return (native_build_empty) }
                set requests (array_push requests (NativeProvider { source: source, compiler: compiler,
                    language: language, profile: "", runtime: false }))
                set csi (+ csi 1)
            }

            # Missing dependency modules join the queue immediately after this
            # owner, in manifest order; already selected modules retain their order.
            let deps: array<string> = (json_extract_string_array json_text "dependencies")
            let mut pending: array<string> = []
            let mut di: int = 0
            while (< di (array_length deps)) {
                let dep_dir: string = (canonical (nl_path_join metadata_root (+ "modules/" (at deps di))))
                if (or (== dep_dir "") (not (file_exists (nl_path_join dep_dir "module.json")))) { return (native_build_empty) }
                let mut seen: bool = false
                let mut j: int = 0
                while (< j (array_length module_dirs)) {
                    if (== (at module_dirs j) dep_dir) { set seen true }
                    set j (+ j 1)
                }
                set j 0
                while (< j (array_length pending)) {
                    if (== (at pending j) dep_dir) { set seen true }
                    set j (+ j 1)
                }
                if (not seen) {
                    if (>= (+ (array_length module_dirs) (array_length pending)) 5000) { return (native_build_empty) }
                    set pending (array_push pending dep_dir)
                }
                set di (+ di 1)
            }
            if (> (array_length pending) 0) {
                let mut extended: array<string> = []
                let mut j: int = 0
                while (<= j i) { set extended (array_push extended (at module_dirs j)) set j (+ j 1) }
                let mut k: int = 0
                while (< k (array_length pending)) { set extended (array_push extended (at pending k)) set k (+ k 1) }
                while (< j (array_length module_dirs)) { set extended (array_push extended (at module_dirs j)) set j (+ j 1) }
                set module_dirs extended
            }
        } else { (print "") }
        set i (+ i 1)
    }
    let runtime: NativeRuntimeInputs = (native_runtime_inputs runtime_root files)
    let base: string = (+ " -I" (+ (native_shell_quote (nl_path_join runtime_root "src"))
        (+ " -I" (native_shell_quote (nl_path_join runtime_root "modules/std")))))
    let mut profile: string = (native_profile_append base cflags)
    if (== profile "") { return (native_build_empty) }
    let extra: string = (native_product_cflags (getenv "NANO_CFLAGS"))
    if (!= extra "") {
        set profile (native_profile_append profile (+ " " extra))
        if (== profile "") { return (native_build_empty) }
    }
    set profile (native_profile_append profile runtime.includes)
    if (== profile "") { return (native_build_empty) }
    let mut result: ModuleBuildFlags = (native_build_empty)
    set result (ModuleBuildFlags { compile_flags: result.compile_flags, link_flags: result.link_flags, compiler: selected_compiler, runtime_sources: result.runtime_sources, objects: result.objects, ok: result.ok, first_status: result.first_status })
    set result (ModuleBuildFlags { compile_flags: profile, link_flags: result.link_flags, compiler: result.compiler, runtime_sources: result.runtime_sources, objects: result.objects, ok: result.ok, first_status: result.first_status })
    let mut registry: NativeProviderSet = NativeProviderSet { rows: [], ok: true }
    set i 0
    while (< i (array_length runtime.sources)) {
        let source: string = (canonical (at runtime.sources i))
        if (== source "") { return result }
        let prior_count: int = (array_length registry.rows)
        set registry (native_provider_add registry (NativeProvider { source: source, compiler: selected_compiler,
            language: "c99", profile: profile, runtime: true }))
        if (not registry.ok) { return result }
        if (> (array_length registry.rows) prior_count) {
            set result (ModuleBuildFlags { compile_flags: result.compile_flags, link_flags: result.link_flags, compiler: result.compiler, runtime_sources: (array_push result.runtime_sources source), objects: result.objects, ok: result.ok, first_status: result.first_status })
        }
        set i (+ i 1)
    }
    set i 0
    while (< i (array_length requests)) {
        let request: NativeProvider = (at requests i)
        set registry (native_provider_add registry (NativeProvider { source: request.source, compiler: request.compiler,
            language: request.language, profile: profile, runtime: false }))
        if (not registry.ok) { (println "I cannot share conflicting native provider requests.") return result }
        set i (+ i 1)
    }
    let mut objects: string = ""
    set i 0
    while (< i (array_length registry.rows)) {
        let provider: NativeProvider = (at registry.rows i)
        if (not provider.runtime) {
            let index_text: string = (int_to_string i)
            if (== index_text "") { return result }
            let name: string = (native_profile_append "/provider_" index_text)
            if (== name "") { return result }
            let suffix: string = (native_profile_append name ".o")
            if (== suffix "") { return result }
            let object: string = (native_profile_append native_dir suffix)
            if (== object "") { return result }
            # I own partial output before starting its compiler.
            set result (ModuleBuildFlags { compile_flags: result.compile_flags, link_flags: result.link_flags, compiler: result.compiler, runtime_sources: result.runtime_sources, objects: (array_push result.objects object), ok: result.ok, first_status: result.first_status })
            let mut command: string = (native_profile_append provider.compiler (+ " -c -std=" provider.language))
            if (== command "") { return result }
            set command (native_profile_append command provider.profile)
            if (== command "") { return result }
            set command (native_profile_append command (+ " " (native_shell_quote provider.source)))
            if (== command "") { return result }
            set command (native_profile_append command (+ " -o " (+ (native_shell_quote object) " 2>&1")))
            if (== command "") { return result }
            if verbose { (println (+ "    Provider command: " command)) }
            let status: int = (nl_exec_shell command)
            if (!= status 0) {
                set result (ModuleBuildFlags { compile_flags: result.compile_flags, link_flags: result.link_flags, compiler: result.compiler, runtime_sources: result.runtime_sources, objects: result.objects, ok: result.ok, first_status: status })
                (println (+ "I could not compile required native provider: " provider.source))
                return result
            }
            if (not (file_exists object)) { return result }
            set objects (native_profile_append objects (+ " " (native_shell_quote object)))
            if (== objects "") { return result }
        }
        set i (+ i 1)
    }
    set result (ModuleBuildFlags { compile_flags: result.compile_flags, link_flags: (native_profile_append objects ldflags), compiler: result.compiler, runtime_sources: result.runtime_sources, objects: result.objects, ok: result.ok, first_status: result.first_status })
    if (and (== result.link_flags "") (or (!= objects "") (!= ldflags ""))) { return result }
    set result (ModuleBuildFlags { compile_flags: result.compile_flags, link_flags: result.link_flags, compiler: result.compiler, runtime_sources: result.runtime_sources, objects: result.objects, ok: true, first_status: result.first_status }) set result (ModuleBuildFlags { compile_flags: result.compile_flags, link_flags: result.link_flags, compiler: result.compiler, runtime_sources: result.runtime_sources, objects: result.objects, ok: result.ok, first_status: 0 })
    return result
}

shadow collect_module_build_flags {
    let refused: ModuleBuildFlags = (collect_module_build_flags [] "" "" "" false)
    assert (not refused.ok)
    assert (== (array_length refused.objects) 0)
}

fn nlc_join_source(parts: array<string>) -> string {
    if (== (array_length parts) 0) { return "" }
    let mut current: array<string> = parts
    while (> (array_length current) 1) {
        let mut next: array<string> = []
        let mut index: int = 0
        while (< index (array_length current)) {
            if (< (+ index 1) (array_length current)) {
                set next (array_push next (+ (at current index) (at current (+ index 1))))
            } else { set next (array_push next (at current index)) }
            set index (+ index 2)
        }
        set current next
    }
    return (at current 0)
}
shadow nlc_join_source {
    assert (== (nlc_join_source []) "")
    assert (== (nlc_join_source ["a"]) "a")
    assert (== (nlc_join_source ["a", "b", "c", "d", "e"]) "abcde")
}

fn merge_with_imports_mode(input_file: string, strict_source: bool) -> MergeResult {
    let start: string = (canonical input_file)
    if (== start "") { return MergeResult { source: "", files: [], original_sources: [], original_parsers: [], file_starts: [], source_files: [], source_lines: [], repo_root: "", root_line: 0 } }
    let repo_root: string = (find_repo_root (nl_path_dirname start))
    let mut max_files: int = (parse_env_int "NANO_IMPORT_MAX_FILES" 5000)
    let mut max_lines: int = (parse_env_int "NANO_IMPORT_MAX_LINES" 50000)
    let mut max_lines_per_file: int = (parse_env_int "NANO_IMPORT_MAX_LINES_PER_FILE" 20000)
    if strict_source {
        if (> max_files 5000) { set max_files 5000 }
        if (> max_lines 50000) { set max_lines 50000 }
        if (> max_lines_per_file 20000) { set max_lines_per_file 20000 }
    }
    let trace_env: string = (getenv "NANO_IMPORT_TRACE")
    let trace: bool = (!= trace_env "")
    if trace {
        (print "[import] repo_root: ")
        (println repo_root)
        (print "[import] start: ")
        (println start)
    } else { (print "") }

    let visited0: array<string> = []
    let visited_set0: HashMap<string, int> = (nlc_hashset_new_string)
    let order0: array<string> = []
    let mut res: CollectResult = CollectResult { visited: [], visited_set: visited_set0, order: [], sources: [], parsed: [], ok: true, lines_scanned: 0, input_bytes: 0, edges: 0 }
    if strict_source {
        set res (collect_files_ast start repo_root res max_files max_lines max_lines_per_file trace)
    } else {
        set res (collect_files_dfs start repo_root visited0 visited_set0 order0 [] true max_files max_lines max_lines_per_file 0 trace)
    }
    let files: array<string> = res.order
    if (not res.ok) {
        return MergeResult { source: "", files: [], original_sources: [], original_parsers: [], file_starts: [], source_files: [], source_lines: [], repo_root: repo_root, root_line: 0 }
    } else { (print "") }
    # I retain source in this invocation; no other compiler can replace it.
    let mut parts: array<string> = []
    let mut source_files: array<string> = []
    let mut source_lines: array<int> = []
    let mut i: int = 0
    let mut merged_lines: int = 0
    let mut root_line: int = 1
    let mut file_starts: array<int> = []
    while (< i (array_length files)) {
        set file_starts (array_push file_starts (+ merged_lines 1))
        if (== i (- (array_length files) 1)) { set root_line (+ merged_lines 1) }
        let src: string = (at res.sources i)
        let lines: array<string> = (split_lines src)
        let mut j: int = 0
        while (< j (array_length lines)) {
            let line: string = (at lines j)
            let imp: string = (parse_import_path_from_line line)
            let is_module_decl: bool = (nlc_str_starts_with line "module ")
            let is_unsafe_module_decl: bool = (nlc_str_starts_with line "unsafe module ")
            if (or (!= imp "") (and (not is_module_decl) (not is_unsafe_module_decl))) {
                let resolved_line: string = line
                set parts (cg_append parts (+ resolved_line "\n"))
                set merged_lines (+ merged_lines 1)
                set source_files (array_push source_files (at files i))
                set source_lines (array_push source_lines (+ j 1))
            } else {
                (print "")
            }
            set j (+ j 1)
        }
        set i (+ i 1)
    }
    return MergeResult { source: (cg_build parts), files: files, original_sources: res.sources, original_parsers: res.parsed, file_starts: file_starts, source_files: source_files, source_lines: source_lines, repo_root: repo_root, root_line: root_line }
}

shadow merge_with_imports_mode {
    let invalid: MergeResult = (merge_with_imports_mode "" true)
    assert (== (array_length invalid.files) 0)
    let json_path: string = (canonical "modules/std/json/json.nano")
    let merged: MergeResult = (merge_with_imports_mode json_path false)
    let tokens: List<LexerToken> = (tokenize_string merged.source json_path (list_CompilerDiagnostic_new))
    let parsed: Parser = (parse_program tokens (list_LexerToken_length tokens) json_path)
    assert (not (parser_has_error parsed))
    assert (== parsed.opaque_types_count 1)
    let declaration: ASTOpaqueType = (list_ASTOpaqueType_get parsed.opaque_types 0)
    assert (== declaration.type_name "Json")
    let owner: int = (merged_file_owner merged.file_starts declaration.line)
    assert (>= owner 0)
    assert (== (at merged.files owner) json_path)
    assert (== (at merged.source_files (- declaration.line 1)) json_path)
}
fn merge_with_imports(input_file: string) -> MergeResult { return (merge_with_imports_mode input_file false) }

shadow merge_with_imports {
    let invalid: MergeResult = (merge_with_imports "")
    assert (== (array_length invalid.files) 0)
    let json_path: string = (canonical "modules/std/json/json.nano")
    let merged: MergeResult = (merge_with_imports json_path)
    let tokens: List<LexerToken> = (tokenize_string merged.source json_path (list_CompilerDiagnostic_new))
    let parsed: Parser = (parse_program tokens (list_LexerToken_length tokens) json_path)
    assert (not (parser_has_error parsed))
    assert (== parsed.opaque_types_count 1)
    let declaration: ASTOpaqueType = (list_ASTOpaqueType_get parsed.opaque_types 0)
    assert (== declaration.type_name "Json")
    let owner: int = (merged_file_owner merged.file_starts declaration.line)
    assert (>= owner 0)
    assert (== (at merged.files owner) json_path)
    assert (== (at merged.source_files (- declaration.line 1)) json_path)

    let result: MergeResult = (merge_with_imports "examples/language/nl_hello.nano")
    assert (> (str_length result.source) 0)
    assert (> (array_length result.files) 0)
    assert (== result.root_line 1)
    assert (== (array_length result.file_starts) (array_length result.files))
    assert (== (array_length result.original_sources) (array_length result.files))
    assert (== (at result.file_starts 0) 1)
}

/* =============================================================================
 * COMPILATION PIPELINE
 * ============================================================================= */

struct IntrospectionOutput { ok: bool, code: string }

fn collect_native_introspection(files: array<string>, repo_root: string) -> IntrospectionOutput {
    let mut unsafe_paths: array<string> = []
    let mut i: int = 0
    while (< i (array_length files)) {
        let path: string = (at files i)
        let info: ModuleIntrospection = (mi_scan (file_read path) path "entry")
        let mut j: int = 0
        while (< j (array_length info.unsafe_imports)) {
            let target: string = (resolve_import_path path (at info.unsafe_imports j) repo_root)
            set unsafe_paths (mi_unique unsafe_paths (canonical target))
            set j (+ j 1)
        }
        set i (+ i 1)
    }
    let mut names: array<string> = []
    let mut parts: array<string> = []
    set i 0
    # The final DFS entry is the program itself, not an imported module.
    while (< i (- (array_length files) 1)) {
        let path: string = (at files i)
        let base: string = (compiler_fs.basename path)
        let dot: int = (last_dot_index base)
        let mut fallback: string = base
        if (> dot 0) { set fallback (str_substring base 0 dot) }
        let raw: ModuleIntrospection = (mi_scan (file_read path) path fallback)
        let mut j: int = 0
        while (< j (array_length names)) {
            if (== (at names j) raw.name) {
                (println (+ "I reject ambiguous module introspection identity: " raw.name))
                return IntrospectionOutput { ok: false, code: "" }
            }
            set j (+ j 1)
        }
        if (not raw.ok) {
            (println (+ "I cannot derive valid module introspection for: " path))
            return IntrospectionOutput { ok: false, code: "" }
        }
        let mut is_unsafe: bool = raw.is_unsafe
        set j 0
        while (< j (array_length unsafe_paths)) {
            if (== (at unsafe_paths j) (compiler_fs.normalize path)) { set is_unsafe true }
            set j (+ j 1)
        }
        let info: ModuleIntrospection = ModuleIntrospection {
            name: raw.name, path: raw.path, functions: raw.functions, structs: raw.structs,
            unsafe_imports: raw.unsafe_imports, is_unsafe: is_unsafe, has_ffi: raw.has_ffi, ok: raw.ok
        }
        set names (array_push names info.name)
        set parts (cg_append parts (mi_emit info))
        set i (+ i 1)
    }
    return IntrospectionOutput { ok: true, code: (cg_build parts) }
}

shadow collect_native_introspection {
    let empty: array<string> = []
    let result: IntrospectionOutput = (collect_native_introspection empty "")
    assert result.ok
    assert (== result.code "")
}

struct ModuleFactsOutput { ok: bool, facts: array<ModuleIntrospection> }

fn collect_introspection(files: array<string>, repo_root: string) -> ModuleFactsOutput {
    let mut unsafe_paths: array<string> = []
    let mut i: int = 0
    while (< i (array_length files)) {
        let path: string = (at files i)
        let info: ModuleIntrospection = (mi_scan (file_read path) path "entry")
        let mut j: int = 0
        while (< j (array_length info.unsafe_imports)) {
            let target: string = (resolve_import_path path (at info.unsafe_imports j) repo_root)
            set unsafe_paths (mi_unique unsafe_paths (canonical target))
            set j (+ j 1)
        }
        set i (+ i 1)
    }
    let mut names: array<string> = []
    let mut facts: array<ModuleIntrospection> = []
    set i 0
    # The final DFS entry is the program itself, not an imported module.
    while (< i (- (array_length files) 1)) {
        let path: string = (at files i)
        let base: string = (compiler_fs.basename path)
        let dot: int = (nlc_str_last_index_of base ".")
        let mut fallback: string = base
        if (> dot 0) { set fallback (str_substring base 0 dot) }
        let raw: ModuleIntrospection = (mi_scan (file_read path) path fallback)
        let mut j: int = 0
        while (< j (array_length names)) {
            if (== (at names j) raw.name) {
                (println (+ "I reject ambiguous module introspection identity: " raw.name))
                return ModuleFactsOutput { ok: false, facts: [] }
            }
            set j (+ j 1)
        }
        if (not raw.ok) {
            (println (+ "I cannot derive valid module introspection for: " path))
            return ModuleFactsOutput { ok: false, facts: [] }
        }
        let mut is_unsafe: bool = raw.is_unsafe
        set j 0
        while (< j (array_length unsafe_paths)) {
            if (== (at unsafe_paths j) (compiler_fs.normalize path)) { set is_unsafe true }
            set j (+ j 1)
        }
        let info: ModuleIntrospection = ModuleIntrospection {
            name: raw.name, path: raw.path, functions: raw.functions, structs: raw.structs,
            unsafe_imports: raw.unsafe_imports, is_unsafe: is_unsafe, has_ffi: raw.has_ffi, ok: raw.ok
        }
        set names (array_push names info.name)
        set facts (array_push facts info)
        set i (+ i 1)
    }
    return ModuleFactsOutput { ok: true, facts: facts }
}

shadow collect_introspection {
    let empty: array<string> = []
    let result: ModuleFactsOutput = (collect_introspection empty "")
    assert result.ok
    assert (== (array_length result.facts) 0)
}

fn llm_escape_json(s: string) -> string {
    let mut out: string = ""
    let n: int = (str_length s)
    let q: string = (string_from_char 34)
    let mut i: int = 0
    while (< i n) {
        let c: int = (char_at s i)
        if (== c 92) {
            set out (+ out "\\\\")
        } else {
            if (== c 34) {
                set out (+ out "\\")
                set out (+ out q)
            } else {
                if (== c 10) {
                    set out (+ out "\\n")
                } else {
                    if (== c 13) {
                        set out (+ out "\\r")
                    } else {
                        if (== c 9) {
                            set out (+ out "\\t")
                        } else {
                            set out (+ out (string_from_char c))
                        }
                    }
                }
            }
        }
        set i (+ i 1)
    }
    return out
}

shadow llm_escape_json {
    let result: string = (llm_escape_json "test")
    assert (== result "test")
}

fn llm_write_diags_json(path: string, input_file: string, output_file: string, exit_code: int, diags: List<CompilerDiagnostic>) -> int {
    let mut s: string = ""
    let q: string = (string_from_char 34)
    set s (+ s "{")
    set s (+ s q)
    set s (+ s "tool")
    set s (+ s q)
    set s (+ s ":")
    set s (+ s q)
    set s (+ s "nanoc")
    set s (+ s q)
    set s (+ s ",")
    set s (+ s q)
    set s (+ s "success")
    set s (+ s q)
    set s (+ s ":")
    if (== exit_code 0) { set s (+ s "true") } else { set s (+ s "false") }
    set s (+ s ",")
    set s (+ s q)
    set s (+ s "exit_code")
    set s (+ s q)
    set s (+ s ":")
    set s (+ s (int_to_string exit_code))
    set s (+ s ",")
    set s (+ s q)
    set s (+ s "input_file")
    set s (+ s q)
    set s (+ s ":")
    set s (+ s q)
    set s (+ s (llm_escape_json input_file))
    set s (+ s q)
    set s (+ s ",")
    set s (+ s q)
    set s (+ s "output_file")
    set s (+ s q)
    set s (+ s ":")
    set s (+ s q)
    set s (+ s (llm_escape_json output_file))
    set s (+ s q)
    set s (+ s ",")
    set s (+ s q)
    set s (+ s "diagnostics")
    set s (+ s q)
    set s (+ s ":[")

    let n: int = (list_CompilerDiagnostic_length diags)
    let mut i: int = 0
    while (< i n) {
        let d: CompilerDiagnostic = (list_CompilerDiagnostic_get diags i)
        if (> i 0) { set s (+ s ",") } else { (print "") }
        set s (+ s "{")
        set s (+ s q)
        set s (+ s "code")
        set s (+ s q)
        set s (+ s ":")
        set s (+ s q)
        set s (+ s (llm_escape_json d.code))
        set s (+ s q)
        set s (+ s ",")
        set s (+ s q)
        set s (+ s "message")
        set s (+ s q)
        set s (+ s ":")
        set s (+ s q)
        set s (+ s (llm_escape_json d.message))
        set s (+ s q)
        set s (+ s ",")
        set s (+ s q)
        set s (+ s "phase")
        set s (+ s q)
        set s (+ s ":")
        set s (+ s (int_to_string d.phase))
        set s (+ s ",")
        set s (+ s q)
        set s (+ s "severity")
        set s (+ s q)
        set s (+ s ":")
        set s (+ s (int_to_string d.severity))
        set s (+ s ",")
        set s (+ s q)
        set s (+ s "location")
        set s (+ s q)
        set s (+ s ":{")
        set s (+ s q)
        set s (+ s "file")
        set s (+ s q)
        set s (+ s ":")
        set s (+ s q)
        set s (+ s (llm_escape_json d.location.file))
        set s (+ s q)
        set s (+ s ",")
        set s (+ s q)
        set s (+ s "line")
        set s (+ s q)
        set s (+ s ":")
        set s (+ s (int_to_string d.location.line))
        set s (+ s ",")
        set s (+ s q)
        set s (+ s "column")
        set s (+ s q)
        set s (+ s ":")
        set s (+ s (int_to_string d.location.column))
        set s (+ s "}}")
        set i (+ i 1)
    }
    set s (+ s "]}")
    return (file_write path s)
}

fn native_shell_quote(path: string) -> string {
    let mut result: string = "'"
    let length: int = (str_length path)
    let mut i: int = 0
    while (< i length) {
        let ch: string = (str_substring path i 1)
        if (== ch "'") { set result (+ result "'\\''") }
        else { set result (+ result ch) }
        set i (+ i 1)
    }
    return (+ result "'")
}

shadow native_shell_quote {
    assert (== (native_shell_quote "a b") "'a b'")
    assert (== (native_shell_quote "a'b") "'a'\\''b'")
}

fn native_shadow_start(parser: Parser, root_line: int) -> int {
    let mut i: int = 0
    while (< i parser.shadows_count) {
        let sh: ASTShadow = (list_ASTShadow_get parser.shadows i)
        if (>= sh.line root_line) { return i }
        set i (+ i 1)
    }
    return i
}

shadow native_shadow_start {
    let tokens: List<LexerToken> = (tokenize_string "fn f() -> int { return 1 }\nshadow f { assert false }\nshadow f { assert true }" "selection.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program tokens (list_LexerToken_length tokens) "selection.nano")
    assert (== (native_shadow_start p 3) 1)
    assert (== (native_shadow_start p 4) 2)
}

fn bytecode_shadow_cleanup(directory: string) -> void {
    if (== directory "") { return }
    unsafe {
        (file_delete (+ directory "/shadows.nvm"))
        (file_delete directory)
    }
}
shadow bytecode_shadow_cleanup { (bytecode_shadow_cleanup "") }

# My paths were created only beneath this invocation's owned private directory.
fn native_provider_cleanup(flags: ModuleBuildFlags) -> bool {
    let mut ok: bool = true
    let mut i: int = 0
    while (< i (array_length flags.objects)) {
        let path: string = (at flags.objects i)
        if (file_exists path) {
            let mut status: int = 0
            unsafe { set status (file_delete path) }
            if (!= status 0) { set ok false (println (+ "I could not remove my native provider object: " path)) }
        }
        set i (+ i 1)
    }
    return ok
}
shadow native_provider_cleanup { assert (native_provider_cleanup (native_build_empty)) }

fn native_operand_path(path: string) -> string {
    if (nlc_str_starts_with path "/") { return path }
    return (+ "./" path)
}
shadow native_operand_path {
    assert (== (native_operand_path "-output") "./-output")
    assert (== (native_operand_path "a b/output") "./a b/output")
    assert (== (native_operand_path "/tmp/output") "/tmp/output")
}

fn native_cleanup(directory: string, keep_c: bool) -> void {
    if (== directory "") { return }
    unsafe {
        (file_delete (+ directory "/shadows"))
        (file_delete (+ directory "/program.nvm"))
        (file_delete (+ directory "/program"))
    }
    if keep_c { (println (+ "I kept generated C in " (+ directory "/program.c"))) }
    else {
        unsafe {
            (file_delete (+ directory "/program.c"))
            (file_delete directory)
        }
    }
}

shadow native_cleanup { (native_cleanup "" false) }

fn outputs_preserve_sources(sources: array<string>, output: string, diagnostics: string) -> bool {
    let destinations: array<string> = [output, diagnostics]
    let mut i: int = 0
    while (< i (array_length sources)) {
        let source: string = (at sources i)
        let mut j: int = 0
        while (< j (array_length destinations)) {
            let destination: string = (at destinations j)
            if (!= destination "") {
                let mut identity: int = -1
                unsafe { set identity (file_compare_identity source destination) }
                if (> identity 0) {
                    (println (+ "I will not overwrite a source file: " source))
                    return false
                }
                if (< identity 0) {
                    (println (+ "I cannot check source/output file identity: " source))
                    return false
                }
            }
            set j (+ j 1)
        }
        set i (+ i 1)
    }
    return true
}

fn output_destinations_distinct(output: string, diagnostics: string) -> bool {
    if (== diagnostics "") { return true }
    let mut identity: int = -1
    unsafe { set identity (file_compare_destinations output diagnostics) }
    if (== identity 0) { return true }
    if (> identity 0) {
        (println "I require separate artifact and diagnostic destinations")
    } else {
        (println "I cannot check artifact/diagnostic destination identity")
    }
    return false
}

shadow output_destinations_distinct {
    let directory: string = (mktemp_dir "nano_output_guard_")
    assert (!= directory "")
    if (!= directory "") {
        let output: string = (+ directory "/output")
        let report: string = (+ directory "/report")
        assert (output_destinations_distinct output "")
        assert (output_destinations_distinct output report)
        assert (not (output_destinations_distinct output output))
        unsafe { assert (== (file_write output "prior") 0) }
        assert (output_destinations_distinct output report)
        assert (not (output_destinations_distinct output output))
        unsafe {
            assert (== (file_read output) "prior")
            assert (== (file_delete output) 0)
            assert (== (file_delete directory) 0)
        }
    }
}

shadow outputs_preserve_sources {
    let directory: string = (mktemp_dir "nano_source_guard_")
    assert (!= directory "")
    if (!= directory "") {
        let source: string = (+ directory "/source.nano")
        let output: string = (+ directory "/output")
        unsafe { assert (== (file_write source "source") 0) }
        assert (outputs_preserve_sources [source] output "")
        assert (not (outputs_preserve_sources [source] source ""))
        assert (not (outputs_preserve_sources [source] output source))
        assert (not (outputs_preserve_sources [(+ directory "/missing")] output ""))
        unsafe {
            assert (== (file_read source) "source")
            assert (== (file_delete source) 0)
            assert (== (file_delete directory) 0)
        }
    }
}

fn compile_program_mode(input_file: string, output_file: string, verbose: bool, keep_c: bool, show_intermediate_code: bool, llm_diags_json_path: string, emit_c: bool, emit_nvm: bool, test_imports: bool, allow_temporary_files: bool, source_native: bool) -> int {
    if (== input_file "") { return 1 }
    if verbose {
        (println "")
        (println "╔══════════════════════════════════════════════════════════════╗")
        (println "║  NanoLang v0.6 - Self-Hosted Compiler                       ║")
        (println "╚══════════════════════════════════════════════════════════════╝")
        (println "")
        (print "Input:  ")
        (println input_file)
        (print "Output: ")
        (println output_file)
        (println "")
    } else {
        (print "")
    }
    
    /* Step 0: Merge imports into single source */
    /* Find repository root for absolute paths to runtime sources  */
    /* Start search from current working directory, not input file location */
    let repo_root: string = (NativeSdk.runtime_root)
    if (== repo_root "") {
        (println "I require a complete compatible native SDK or source root")
        return 1
    }

    if verbose {
        (println "[0/5] Resolving imports...")
    } else {
        (print "")
    }

    let merge_result: MergeResult = (merge_with_imports_mode input_file allow_temporary_files)
    let merged_source: string = merge_result.source
    let merged_files: array<string> = merge_result.files
    let source_files: array<string> = merge_result.source_files
    let source_lines: array<int> = merge_result.source_lines
    let merge_repo_root: string = merge_result.repo_root
    let source_to_compile: string = input_file

    # I reject aliases before parsing can write diagnostics or shadows can run.
    if (not (outputs_preserve_sources merged_files output_file llm_diags_json_path)) { return 1 }
    if (not (output_destinations_distinct output_file llm_diags_json_path)) { return 1 }
    
    if (== merged_source "") {
        (println "Error: import resolution failed")
        return 1
    } else {
        # I lex the merged text without publishing a temporary source file.
        if verbose {
            (print "  ✓ Merged source: ")
            (print (int_to_string (str_length merged_source)))
            (println " bytes")
        } else {
            (print "")
        }
    }
    
    if allow_temporary_files {
        let prepared: FileResolution = (file_resolution_prepare merge_result.files merge_result.original_sources merge_result.original_parsers merge_result.repo_root resolve_import_path)
        if (!= prepared.status 0) {
            if (== prepared.status 1) { (println "I prepared File source declarations; source lowering is not admitted.") }
            else { (println (+ "I cannot prepare complete File source declarations: " (int_to_string prepared.status))) }
            return 1
        }
    }

    /* Step 1: Lexer - Tokenize source file */
    if verbose {
        (println "[1/5] Lexing...")
    } else {
        (print "")
    }
    
    /* Diagnostics list (start with lexer diags; may be replaced by later phase outputs) */
    let diags: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    
    let tokens: List<LexerToken> = (tokenize_string merged_source source_to_compile diags)
    let token_count: int = (list_LexerToken_length tokens)
    (remap_diagnostics diags source_files source_lines)
    
    if (== token_count 0) {
        (println "Error: Failed to tokenize input file")
        if (not (== llm_diags_json_path "")) {
            (llm_write_diags_json llm_diags_json_path input_file output_file 1 diags)
        } else { (print "") }
        return 1
    } else {
        (print "")
            
            if verbose {
                (print "  ✓ Tokenized ")
                (print (int_to_string token_count))
                (println " tokens")
            } else {
                (print "")
            }
            
            /* Step 2: Parser - Build AST */
            if verbose {
                (println "[2/5] Parsing...")
            } else {
                (print "")
            }
            
            let parsed: ParsedDeclarations = (parse_program_complete_declarations tokens token_count input_file)
            let parser: Parser = parsed.parser
            if (parser_has_error parser) {
                let tok: LexerToken = (parser_current parser)
                let parse_loc: CompilerSourceLocation = (source_location_for_line source_files source_lines tok.line tok.column)
                let mut parse_message: string = (+ "unexpected token '" (+ tok.value "'"))
                let mut json_parse_message: string = (+ "unexpected token " tok.value)
                if (> (Diagnostics.diag_list_count parser.diagnostics) 0) {
                    let parser_diag: CompilerDiagnostic = (Diagnostics.diag_list_get parser.diagnostics 0)
                    set parse_message parser_diag.message
                    set json_parse_message parser_diag.message
                } else { (print "") }
                (print "Parse error at ")
                (print parse_loc.file)
                (print ":")
                (print (int_to_string parse_loc.line))
                (print ", column ")
                (print (int_to_string parse_loc.column))
                (print ": ")
                (println parse_message)
                if (not (== llm_diags_json_path "")) {
                    let msg: string = (+ "Parse error: " json_parse_message)
                    let diag: CompilerDiagnostic = (Diagnostics.diag_parser_error "P0001" msg parse_loc)
                    (Diagnostics.diag_list_add diags diag)
                    (llm_write_diags_json llm_diags_json_path input_file output_file 1 diags)
                } else { (print "") }
                return 1
            } else {
                (print "")
            }
            
            let func_count: int = (parser_get_function_count parser)
            if verbose {
                (print "  ✓ Parsed ")
                (print (int_to_string func_count))
                (println " functions")
            } else {
                (print "")
            }
            
            if (not (merged_function_names_valid parser merge_result.file_starts)) {
                if (!= llm_diags_json_path "") {
                    (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "M0001" "I require unique function declarations within each module" (Diagnostics.diag_location input_file 0 0)))
                    (llm_write_diags_json llm_diags_json_path input_file output_file 1 diags)
                }
                return 1
            }

            if (not (bind_merged_functions parsed merge_result)) {
                if (!= llm_diags_json_path "") {
                    (Diagnostics.diag_list_add diags (Diagnostics.diag_typecheck_error "M0002" "I cannot resolve module function bindings" (Diagnostics.diag_location input_file 0 0)))
                    (llm_write_diags_json llm_diags_json_path input_file output_file 1 diags)
                }
                return 1
            }

            /* I already parsed the transitive source set. Imports now describe
             * bindings; loading them again would duplicate declarations. */
            if verbose {
                (println "[2.5/5] Processing imports...")
            } else {
                (print "")
            }
            
            let cache: ModuleCache = (module_cache_new)
            let import_count: int = 0
            let mut imported_symbols: array<Symbol> = []
            if (> import_count 0) {
                set imported_symbols (process_imports_recursive parser [] cache source_to_compile diags)
            } else {
                (print "")
            }
            let imported_count: int = (array_length imported_symbols)
            
            if verbose {
                (print "  ✓ Loaded ")
                (print (int_to_string imported_count))
                (println " type symbols from imports")
            } else {
                (print "")
            }
            
            /* Step 3: Typechecker - Verify semantics */
            if verbose {
                (println "[3/5] NSType checking...")
            } else {
                (print "")
            }
            
            let mut first_shadow: int = 0
            if (not test_imports) { set first_shadow (native_shadow_start parser merge_result.root_line) }
            let has_shadows: bool = (< first_shadow parser.shadows_count)
            let tc: TypecheckPhaseOutput = (typecheck_phase_with_shadows parser source_to_compile imported_symbols first_shadow)
            if tc.had_error {
                (remap_diagnostics tc.diagnostics source_files source_lines)
                (println "NSType checking failed")
                (println "Diagnostics:")
                let diag_count: int = (Diagnostics.diag_list_count tc.diagnostics)
                let mut diag_i: int = 0
                while (< diag_i diag_count) {
                    let diag: CompilerDiagnostic = (Diagnostics.diag_list_get tc.diagnostics diag_i)
                    (print "  [")
                    (print diag.code)
                    (print "] ")
                    (print diag.message)
                    (print " (")
                    (print diag.location.file)
                    (print ":")
                    (print (int_to_string diag.location.line))
                    (print ":")
                    (print (int_to_string diag.location.column))
                    (println ")")
                    set diag_i (+ diag_i 1)
                }
                if (not (== llm_diags_json_path "")) {
                    (llm_write_diags_json llm_diags_json_path input_file output_file 1 tc.diagnostics)
                } else { (print "") }
                return 1
            } else { (print "") }
            
            if verbose {
                (println "  ✓ NSType checking passed")
            } else {
                (print "")
            }
            
            /* Step 3.5: Merge module union definitions into main parser */
            if (> import_count 0) {
                let unions_merged: int = (merge_module_unions parser source_to_compile diags)
                if (and verbose (> unions_merged 0)) {
                    (print "  ✓ Merged ")
                    (print (int_to_string unions_merged))
                    (println " union definitions from modules")
                } else { (print "") }
            } else { (print "") }

            if (not source_native) {
            let introspection: ModuleFactsOutput = (collect_introspection merged_files merge_result.repo_root)
            if (not introspection.ok) { return 1 }
            # I lower one checked program and retained module facts for every route.
            let assembly: string = (nanoisa_emit_program_with_facts parser introspection.facts)
            if (== assembly "") {
                (println (+ "I cannot lower this checked program: " (nanoisa_last_lowering_error)))
                return 1
            }
            if (and has_shadows (not emit_c)) {
                let shadow_assembly: string = (nanoisa_emit_shadows_with_facts parser first_shadow introspection.facts)
                if (== shadow_assembly "") {
                    (println (+ "I cannot lower the selected shadows: " (nanoisa_last_lowering_error)))
                    return 1
                }
                let directory: string = (mktemp_dir "nano_bytecode_shadows_")
                if (== directory "") { (println "I could not create bytecode shadow storage") return 1 }
                let shadow_file: string = (+ directory "/shadows.nvm")
                if (!= (Nanoisa.assemble_text_save shadow_assembly shadow_file) 0) {
                    (println (+ "I could not verify the shadow module: " (Nanoisa.last_error)))
                    (bytecode_shadow_cleanup directory)
                    return 1
                }
                let mut vm: string = (getenv "NANO_VM")
                if (== vm "") { set vm (nl_path_join repo_root "bin/nano_vm") }
                let checked: int = (nl_exec_shell (+ (native_shell_quote vm) (+ " --check-shadows " (native_shell_quote shadow_file))))
                (bytecode_shadow_cleanup directory)
                if (!= checked 0) { (println "I will not publish output after failed shadows") return 1 }
            }
            if emit_nvm {
                if (!= (Nanoisa.assemble_text_save assembly output_file) 0) {
                    (println (+ "I could not publish the NanoISA module: " (Nanoisa.last_error)))
                    return 1
                }
            } else {
                # I stage beside the destination so final publication is a rename.
                let pattern: string = (native_operand_path (nl_path_join (nl_path_dirname output_file) ".nano-product.XXXXXX"))
                let native_dir: string = (nlc_str_trim (nl_exec_capture (+ "mktemp -d " (native_shell_quote pattern))))
                if (== native_dir "") { (println "I could not create native product staging") return 1 }
                let module_file: string = (+ native_dir "/program.nvm")
                let c_file: string = (+ native_dir "/program.c")
                let executable: string = (+ native_dir "/program")
                if (!= (Nanoisa.assemble_text_save assembly module_file) 0) {
                    (println (+ "I could not verify the product module: " (Nanoisa.last_error)))
                    (native_cleanup native_dir false)
                    return 1
                }
                let mut translator: string = (getenv "NANO_NVM2C")
                if (== translator "") { set translator (nl_path_join repo_root "bin/nvm2c") }
                let translate: string = (+ (native_shell_quote translator) (+ " " (+ (native_shell_quote module_file) (+ " -o " (native_shell_quote c_file)))))
                if (!= (nl_exec_shell translate) 0) {
                    (println "I could not translate the verified NanoISA product to C")
                    (native_cleanup native_dir keep_c)
                    return 1
                }
                if show_intermediate_code { (print (file_read c_file)) }
                let mut staged_product: string = c_file
                if (not emit_c) {
                    let mut module_root: string = merge_repo_root
                    if (== module_root "") { set module_root repo_root }
                    let mod_flags: ModuleBuildFlags = (collect_module_build_flags merged_files module_root repo_root native_dir verbose)
                    if (not mod_flags.ok) {
                        (println (+ "I stopped native provider preparation with status " (int_to_string mod_flags.first_status)))
                        (native_provider_cleanup mod_flags)
                        (native_cleanup native_dir keep_c)
                        return 1
                    }
                    let mut runtime: string = (getenv "NANO_AOT_RUNTIME")
                    if (== runtime "") { set runtime (nl_path_join repo_root "bin/nano_aot_runtime.o") }
                    if (not (file_exists runtime)) {
                        (println (+ "I require the native artifact runtime: " runtime))
                        (native_provider_cleanup mod_flags)
                        (native_cleanup native_dir keep_c)
                        return 1
                    }
                    let platform: string = (nlc_str_trim (nl_exec_capture "uname -s"))
                    if (== platform "") {
                        (native_provider_cleanup mod_flags)
                        (native_cleanup native_dir keep_c)
                        return 1
                    }
                    let mut command: string = (native_profile_append mod_flags.compiler " -std=c11")
                    set command (native_profile_append command mod_flags.compile_flags)
                    set command (+ command (+ " " (+ (native_shell_quote c_file) (+ " " (native_shell_quote runtime)))))
                    set command (+ command (+ " -lm" (native_array_abi_link_flags platform)))
                    if (> (str_length mod_flags.link_flags) 0) {
                        set command (native_profile_append command mod_flags.link_flags)
                    } else { (print "") }
                    let ldflags: string = (getenv "NANO_LDFLAGS")
                    if (!= ldflags "") { set command (+ command (+ " " ldflags)) }
                    set command (+ command (+ " -o " (native_shell_quote executable)))
                    if (== command "") {
                        (native_provider_cleanup mod_flags)
                        (native_cleanup native_dir keep_c)
                        return 1
                    }
                    if verbose { (println command) }
                    let compile_status: int = (nl_exec_shell command)
                    let provider_clean: bool = (native_provider_cleanup mod_flags)
                    if (or (!= compile_status 0) (not provider_clean)) {
                        (println "I could not compile the native NanoISA product")
                        (native_cleanup native_dir keep_c)
                        return 1
                    }
                    set staged_product executable
                }
                let publish: string = (+ "mv -f " (+ (native_shell_quote (native_operand_path staged_product)) (+ " " (native_shell_quote (native_operand_path output_file)))))
                if (!= (nl_exec_shell publish) 0) {
                    (println "I could not publish the staged product")
                    (native_cleanup native_dir keep_c)
                    return 1
                }
                (native_cleanup native_dir (and keep_c (not emit_c)))
                if (and emit_c has_shadows) { (println "I emitted C source without executing shadows; native and bytecode compilation run them.") }
            }
            if (!= llm_diags_json_path "") {
                (llm_write_diags_json llm_diags_json_path input_file output_file 0 diags)
            }
            return 0
            }
            /* Step 4: Transpiler - Generate C code */
            if verbose {
                (println "[4/5] Generating C code...")
            } else {
                (print "")
            }

            let introspection: IntrospectionOutput = (collect_native_introspection merged_files merge_repo_root)
            if (not introspection.ok) { return 1 }
            let emitted: string = (transpile_parser parser)
            if (== emitted "") { (println (transpile_last_error)) return 1 }
            let c_code: string = (+ emitted introspection.code)
            
            if verbose {
                (print "  ✓ Generated ")
                (print (int_to_string (str_length c_code)))
                (println " bytes of C code")
            } else {
                (print "")
            }

            if show_intermediate_code {
                (print c_code)
            } else { (print "") }

            # I publish C source without invoking the native toolchain.
            if emit_c {
                let status: int = (file_write output_file c_code)
                if (!= status 0) {
                    (println "I could not write the requested C source file")
                    return 1
                }
                if (!= llm_diags_json_path "") {
                    (llm_write_diags_json llm_diags_json_path input_file output_file 0 diags)
                }
                if has_shadows { (println "I emitted C source without executing shadows; native compilation runs them.") }
                return 0
            }
            
            /* Write C code to temporary file */
            let native_dir: string = (mktemp_dir "nano_native_")
            if (== native_dir "") { (println "I could not create native compilation staging") return 1 }
            let c_file: string = (+ native_dir "/program.c")
            let mut staged_code: string = c_code
            if has_shadows {
                let shadow_code: string = (transpile_parser_shadows parser first_shadow)
                if (== shadow_code "") {
                    (println (transpile_last_error))
                    (native_cleanup native_dir false)
                    return 1
                }
                set staged_code (+ shadow_code introspection.code)
            }
            let write_result: int = (file_write c_file staged_code)
            if (!= write_result 0) {
                (native_cleanup native_dir false)
                (println "Error: Failed to write C file")
                if (not (== llm_diags_json_path "")) {
                    let msg: string = "Failed to write temporary C file"
                    let loc: CompilerSourceLocation = (Diagnostics.diag_location source_to_compile 0 0)
                    let diag: CompilerDiagnostic = (Diagnostics.diag_lowering_error "C0001" msg loc)
                    (Diagnostics.diag_list_add diags diag)
                    (llm_write_diags_json llm_diags_json_path input_file output_file 1 diags)
                } else { (print "") }
                return 1
            } else {
                (print "")
            }
            
            /* Step 5: C Compiler - Compile to executable */
            /* Step 4.5: Collect module build flags (pkg-config, ldflags, etc.) */
            if verbose {
                (println "[4.5/5] Collecting module build flags...")
            } else { (print "") }
            let mut module_root: string = merge_repo_root
            if (== module_root "") { set module_root repo_root }
            let mod_flags: ModuleBuildFlags = (collect_module_build_flags merged_files module_root repo_root native_dir verbose)
            if (not mod_flags.ok) {
                (println (+ "I stopped native provider preparation with status " (int_to_string mod_flags.first_status)))
                (native_provider_cleanup mod_flags)
                (native_cleanup native_dir keep_c)
                return 1
            }

            if verbose {
                (println "[5/5] Compiling C to executable...")
            } else {
                (print "")
            }
            
            /* Build C compiler command with runtime library files
             * The transpiler generates calls to runtime functions (dyn_array_*, gc_*, etc.)
             * We must link with the runtime C sources to provide these implementations.
             * This matches what the C compiler does in src/main.c line 461.
             */
            let mut cc_cmd: string = (native_profile_append mod_flags.compiler " -std=c99")
            if (== cc_cmd "") {
                (native_provider_cleanup mod_flags)
                (native_cleanup native_dir keep_c)
                return 1
            }
            set cc_cmd (native_profile_append cc_cmd mod_flags.compile_flags)
            if (== cc_cmd "") {
                (native_provider_cleanup mod_flags)
                (native_cleanup native_dir keep_c)
                return 1
            }
            set cc_cmd (native_profile_append cc_cmd (+ " " (native_shell_quote c_file)))
            if (== cc_cmd "") {
                (native_provider_cleanup mod_flags)
                (native_cleanup native_dir keep_c)
                return 1
            }
            let mut runtime_index: int = 0
            while (< runtime_index (array_length mod_flags.runtime_sources)) {
                set cc_cmd (native_profile_append cc_cmd (+ " " (native_shell_quote (at mod_flags.runtime_sources runtime_index))))
                if (== cc_cmd "") {
                    (native_provider_cleanup mod_flags)
                    (native_cleanup native_dir keep_c)
                    return 1
                }
                set runtime_index (+ runtime_index 1)
            }
            set cc_cmd (native_profile_append cc_cmd " -lm")
            if (== cc_cmd "") {
                (native_provider_cleanup mod_flags)
                (native_cleanup native_dir keep_c)
                return 1
            }
            let abi_platform: string = (nlc_str_trim (nl_exec_capture "uname -s"))
            if (== abi_platform "") {
                (println "I could not identify the host for native array ABI linking")
                (native_provider_cleanup mod_flags)
                (native_cleanup native_dir keep_c)
                return 1
            }
            set cc_cmd (native_profile_append cc_cmd (native_array_abi_link_flags abi_platform))
            if (== cc_cmd "") {
                (native_provider_cleanup mod_flags)
                (native_cleanup native_dir keep_c)
                return 1
            }
            /* Module link flags (pkg-config --libs, -l, -framework, .o files) */
            if (> (str_length mod_flags.link_flags) 0) {
                set cc_cmd (native_profile_append cc_cmd mod_flags.link_flags)
                if (== cc_cmd "") {
                    (native_provider_cleanup mod_flags)
                    (native_cleanup native_dir keep_c)
                    return 1
                }
            } else { (print "") }
            let extra_ldflags: string = (getenv "NANO_LDFLAGS")
            if (!= extra_ldflags "") {
                set cc_cmd (native_profile_append cc_cmd " ")
                if (== cc_cmd "") {
                    (native_provider_cleanup mod_flags)
                    (native_cleanup native_dir keep_c)
                    return 1
                }
                set cc_cmd (native_profile_append cc_cmd extra_ldflags)
                if (== cc_cmd "") {
                    (native_provider_cleanup mod_flags)
                    (native_cleanup native_dir keep_c)
                    return 1
                }
            } else {
                (print "")
            }
            if has_shadows {
                let test_file: string = (+ native_dir "/shadows")
                let test_cmd: string = (native_profile_append cc_cmd (+ " -o " (+ (native_shell_quote test_file) " 2>&1")))
                if (== test_cmd "") {
                    (native_provider_cleanup mod_flags)
                    (native_cleanup native_dir keep_c)
                    return 1
                }
                if (!= (nl_exec_shell test_cmd) 0) {
                    (println "I could not compile native shadows")
                    (native_provider_cleanup mod_flags)
                    (native_cleanup native_dir keep_c)
                    return 1
                }
                if (!= (nl_exec_shell (native_shell_quote test_file)) 0) {
                    (println "I will not publish native output after failed shadows")
                    (native_provider_cleanup mod_flags)
                    (native_cleanup native_dir keep_c)
                    return 1
                }
                if (!= (file_write c_file c_code) 0) {
                    (println "I could not stage production C after checking shadows")
                    (native_provider_cleanup mod_flags)
                    (native_cleanup native_dir keep_c)
                    return 1
                }
            }
            set cc_cmd (native_profile_append cc_cmd (+ " -o " (+ (native_shell_quote output_file) " 2>&1")))
            if (== cc_cmd "") {
                (native_provider_cleanup mod_flags)
                (native_cleanup native_dir keep_c)
                return 1
            }
            
            if verbose {
                (print "  Command: ")
                (println cc_cmd)
            } else {
                (print "")
            }
            
            let cc_result: int = (nl_exec_shell cc_cmd)
            if (!= cc_result 0) {
                (println "Error: C compilation failed")
                (native_provider_cleanup mod_flags)
                (native_cleanup native_dir keep_c)
                return 1
            } else {
                (print "")
            }
            
            if verbose {
                (println "  ✓ Executable created")
                (println "")
                (println "╔══════════════════════════════════════════════════════════════╗")
                (println "║  ✅ COMPILATION SUCCESSFUL (100% NanoLang Pipeline)         ║")
                (println "╚══════════════════════════════════════════════════════════════╝")
                (println "")
            } else {
                (print "")
            }
            
            let provider_clean: bool = (native_provider_cleanup mod_flags)
            (native_cleanup native_dir keep_c)
            if (not provider_clean) { return 1 }
            
            if (not (== llm_diags_json_path "")) {
                (llm_write_diags_json llm_diags_json_path input_file output_file 0 diags)
            } else { (print "") }

            return 0
    }
}

shadow compile_program_mode {
    assert (== (compile_program_mode "" "" false false false "" false false true false false) 1)
}

fn compile_program(input_file: string, output_file: string, verbose: bool, keep_c: bool, show_intermediate_code: bool, llm_diags_json_path: string, emit_c: bool, emit_nvm: bool, test_imports: bool, allow_temporary_files: bool) -> int {
    return (compile_program_mode input_file output_file verbose keep_c show_intermediate_code llm_diags_json_path emit_c emit_nvm test_imports allow_temporary_files false)
}

# I retain source-native qualification internally; my public products remain canonical.
fn compile_program_source_native(input_file: string, output_file: string, verbose: bool, keep_c: bool, show_intermediate_code: bool, llm_diags_json_path: string, emit_c: bool, emit_nvm: bool, test_imports: bool, allow_temporary_files: bool) -> int {
    if emit_nvm { return 1 }
    return (compile_program_mode input_file output_file verbose keep_c show_intermediate_code llm_diags_json_path emit_c emit_nvm test_imports allow_temporary_files true)
}
shadow compile_program_source_native {
    assert (== (compile_program_source_native "" "" false false false "" false false true false) 1)
}

/* =============================================================================
 * MAIN ENTRY POINT
 * ============================================================================= */

shadow compile_program {
    assert (== (compile_program "" "" false false false "" false false true false) 1)
}

fn show_usage() -> int {
    (println "")
    (println "╔══════════════════════════════════════════════════════════════╗")
    (println "║  NanoLang v0.6 - Self-Hosted Compiler                       ║")
    (println "╚══════════════════════════════════════════════════════════════╝")
    (println "")
    (println "Usage: nanoc <input.nano> [-o output] [options]")
    (println "")
    (println "Without an output or target, I publish a sibling .nvm file.")
    (println "Options:")
    (println "  -o <file>        I publish a native executable unless --emit-nvm or --target c is selected")
    (println "  -v, --verbose    Verbose compilation output")
    (println "  -k, --keep-c     Keep generated C file")
    (println "  --target <t>    native (default) or c (NanoISA C11 source, no native compilation)")
    (println "  --emit-nvm     I publish verified NanoISA (default output: sibling .nvm)")
    (println "  --allow-temporary-files  I prepare source facts only; service execution remains held")
    (println "  --test-imports  I run dependency shadows before root shadows (default)")
    (println "  --root-shadows-only  I run only root-file shadows")
    (println "  --              End options; the remaining argument is my input path")
    (println "  -fshow-intermediate-code  Print generated C to stdout")
    (println "  -h, --help       Show this help")
    (println "  --llm-diags-json <p>  Write machine-readable diagnostics JSON (agent-only)")
    (println "")
    (println "This compiler is 100% written in NanoLang!")
    (println "Pipeline: Lex → Parse → Typecheck → NanoISA → Product")
    (println "")
    return 0
}

shadow show_usage {
    let result: int = (show_usage)
    assert (== result 0)  /* show_usage always returns 0 */
}

fn native_array_abi_link_flags(platform: string) -> string {
    if (== platform "Linux") { return " -rdynamic -ldl" }
    if (== platform "FreeBSD") { return " -Wl,-E" }
    return ""
}

shadow native_array_abi_link_flags {
    assert (== (native_array_abi_link_flags "Linux") " -rdynamic -ldl")
    assert (== (native_array_abi_link_flags "FreeBSD") " -Wl,-E")
    assert (== (native_array_abi_link_flags "Darwin") "")
}

fn main() -> int {
    if (== (get_argc) 2) {
        if (== (get_argv 1) "--native-array-abi") {
            (println (int_to_string (NativeSdk.native_array_abi)))
            return 0
        }
    }
    let opts: CompileOptions = (parse_args)
    if (!= opts.error "") {
        (println opts.error)
        return 1
    }
    
    if opts.show_help {
        return (show_usage)
    } else {
        (print "")
    }
    
    if (== opts.input_file "") {
        (println "Error: No input file specified")
        (println "Try 'nanoc --help' for usage information")
        return 1
    } else {
        (print "")
    }
    
    if (not (file_exists opts.input_file)) {
        (print "Error: Input file not found: ")
        (println opts.input_file)
        return 1
    } else {
        (print "")
    }
    
    return (compile_program opts.input_file opts.output_file opts.verbose opts.keep_c opts.show_intermediate_code opts.llm_diags_json_path opts.emit_c opts.emit_nvm opts.test_imports opts.allow_temporary_files)
}

shadow main {
    /* Basic sanity check */
    assert (== 1 1)
}
