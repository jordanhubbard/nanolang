/* Generate C code for an expression node (RECURSIVE)
 * 
 * Args:
 *   parser: Parser containing AST nodes
 *   node_id: Index of node in appropriate list
 *   node_type: 0=number, 1=identifier, 2=binary_op, 3=call
 * 
 * Returns: C code string for the expression
 */
/* I preserve identifier selection and retain exact unbound call array results. */
fn legacy_array_operand_type(parser: Parser, node_id: int, node_type: int, env: GenEnv) -> string {
    if (== node_type ParseNodeType.PNODE_IDENTIFIER) {
        let id: ASTIdentifier = (parser_get_identifier parser node_id)
        return (genenv_get env id.name)
    }
    if (!= node_type ParseNodeType.PNODE_CALL) { return "" }
    let call: ASTCall = (parser_get_call parser node_id)
    if (!= call.function_type ParseNodeType.PNODE_IDENTIFIER) { return "" }
    let callee: ASTIdentifier = (parser_get_identifier parser call.function)
    let mut i: int = 0
    while (< i (array_length env.names)) {
        if (== (at env.names i) callee.name) { return "" }
        set i (+ i 1)
    }
    let result: string = (lookup_func_return_type_in_parser parser (mb_resolve callee.name callee.line env.names))
    if (or (== result "array<int>") (== result "array<float>")) { return result }
    return ""
}
shadow legacy_array_operand_type {
    let tokens: List<LexerToken> = (tokenize_string "fn probe() -> array<float> { return (source) } fn source() -> array<float> { return [1.0] }" "array-call.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "array-call.nano")
    let ret: ASTReturn = (parser_get_return parser 0)
    let env: GenEnv = (genenv_new "test")
    assert (== (legacy_array_operand_type parser ret.value ret.value_type env) "array<float>")
    let bound: GenEnv = (genenv_put env "source" "fn()->float" false)
    assert (== (legacy_array_operand_type parser ret.value ret.value_type bound) "")
    let unknown: GenEnv = (genenv_put env "source" "" false)
    assert (== (legacy_array_operand_type parser ret.value ret.value_type unknown) "")
}

# I copy exact opaque-bearing values through the existing width-aware carrier.
fn native_array_exact(element: string) -> bool {
    if (or (is_tuple_type element) (is_fn_type element)) {
        set native_array_derived_required true
        return true
    }
    return (and (not (is_array_type element)) (!= (native_opaque_key element) ""))
}
