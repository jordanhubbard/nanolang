    set native_array_derived_required saved_required
    set native_tuple_annotations saved_tuples
    set fn_type_originals saved_functions
    set fn_type_names saved_names
}

fn generate_expression(parser: Parser, node_id: int, node_type: int, env: GenEnv, expected_type: string) -> string {
    if (== node_type ParseNodeType.PNODE_NUMBER) {
        /* Number literal */
        let num: ASTNumber = (parser_get_number parser node_id)
        /* INT64_MIN (-9223372036854775808) cannot be expressed as a C literal directly;
           the constant 9223372036854775808 overflows int64_t before negation is applied.
           Emit INT64_MIN (from <stdint.h>) instead. */
        if (== num.value "-9223372036854775808") {
            return "INT64_MIN"
        } else {
            return num.value
        }
    } else {
        if (== node_type ParseNodeType.PNODE_FLOAT) {
            let f: ASTFloat = (parser_get_float parser node_id)
            return f.value
        } else {
        if (== node_type ParseNodeType.PNODE_STRING) {
            let s: ASTString = (parser_get_string parser node_id)
            # My lexer already expands f-strings. Ordinary strings stay literal.
            return (gen_string s.value)
        } else {
        if (== node_type ParseNodeType.PNODE_BOOL) {
            let b: ASTBool = (parser_get_bool parser node_id)
            if b.value {
                return "1"
            } else {
                return "0"
            }
        } else {
        if (== node_type ParseNodeType.PNODE_IDENTIFIER) {
            /* Identifier — guarded globals use NL_GUARDED_READ for thread-safe reads */
            let id: ASTIdentifier = (parser_get_identifier parser node_id)
            let resolved_name: string = (mb_resolve id.name id.line env.names)
            if (and (native_array_operation resolved_name) (and (has_function_named parser resolved_name) (not (is_extern_function parser resolved_name)))) {
                let mut bound: bool = false
                let mut i: int = 0
                while (< i (array_length env.names)) {
                    if (== (at env.names i) id.name) { set bound true }
                    set i (+ i 1)
                }
                if (not bound) { return (c_func_name_for_definition resolved_name) }
            }

            if (and (== (genenv_get env id.name) "") (is_extern_function parser resolved_name)) {
                let mut foreign_name: string = resolved_name
                let mapped: string = (map_builtin_func_name resolved_name)
                if (!= mapped "") { set foreign_name mapped }
                return (guard_native_array_reference parser resolved_name foreign_name)
            }
            let c_var: string = (genenv_c_name env (mb_resolve id.name id.line env.names))
            if (transp_str_starts_with (genenv_get env id.name) "&") { return (+ "(*" (+ c_var ")")) }
            if (and (genenv_get_global env id.name) (is_guarded_primitive (genenv_get env id.name))) {
                let c_type: string = (type_to_c (genenv_get env id.name))
                let mut rd: array<string> = []
                set rd (cg_append rd "NL_GUARDED_READ(")
                set rd (cg_append rd c_var)
                set rd (cg_append rd ", ")
                set rd (cg_append rd c_type)
                set rd (cg_append rd ")")
                return (cg_build rd)
            } else {
                return c_var
            }
        } else {
            if (== node_type ParseNodeType.PNODE_BINARY_OP) {
                /* Binary operation - RECURSIVE! */
                let binop: ASTBinaryOp = (parser_get_binary_op parser node_id)
                if binop.is_unary {
                    let operand: string = (generate_expression parser binop.right binop.right_type env expected_type)
                    return (+ "(-(" (+ operand "))"))
                }
                
                /* For comparison operators, don't propagate expected_type to operands.
                   The return type (bool) differs from operand types. */
                let is_comparison: bool = (or (or (== binop.op LexerTokenType.TOKEN_EQ) (== binop.op LexerTokenType.TOKEN_NE))
                                          (or (or (== binop.op LexerTokenType.TOKEN_LT) (== binop.op LexerTokenType.TOKEN_GT))
                                              (or (== binop.op LexerTokenType.TOKEN_LE) (== binop.op LexerTokenType.TOKEN_GE))))
                let mut operand_expected: string = expected_type
                if is_comparison { set operand_expected "" } else { (print "") }
                let left_code: string = (generate_expression parser binop.left binop.left_type env operand_expected)
                let right_code: string = (generate_expression parser binop.right binop.right_type env operand_expected)

                /* I retain declared numeric array results as well as identifiers. */
                let left_arr_t: string = (legacy_array_operand_type parser binop.left binop.left_type env)
                let right_arr_t: string = (legacy_array_operand_type parser binop.right binop.right_type env)

                let left_is_arr: bool = (is_array_type left_arr_t)
                let right_is_arr: bool = (is_array_type right_arr_t)
                let is_arith: bool = (or (or (== binop.op LexerTokenType.TOKEN_PLUS) (== binop.op LexerTokenType.TOKEN_MINUS))
                                      (or (or (== binop.op LexerTokenType.TOKEN_STAR) (== binop.op LexerTokenType.TOKEN_SLASH))
                                          (== binop.op LexerTokenType.TOKEN_PERCENT)))

                if (and is_arith (or left_is_arr right_is_arr)) {
                    let mut elem_t: string = "int"
                    if left_is_arr {
                        let inferred: string = (array_elem_type_from_array_type left_arr_t)
                        if (!= inferred "") { set elem_t inferred } else { (print "") }
                    } else {
                        if right_is_arr {
                            let inferred: string = (array_elem_type_from_array_type right_arr_t)
                            if (!= inferred "") { set elem_t inferred } else { (print "") }
                        } else { (print "") }
                    }

                    let elem_enum: string = (elem_enum_from_elem_type elem_t)
                    let get_fn: string = (get_fn_from_elem_type elem_t)
                    let push_fn: string = (push_fn_from_elem_type elem_t)
                    let c_elem: string = (c_type_from_elem_type elem_t)
                    let op_str2: string = (operator_to_string binop.op)

                    let is_plus: bool = (== binop.op LexerTokenType.TOKEN_PLUS)
                    let is_string: bool = (== elem_t "string")
                    return (build_array_binop_expr left_code right_code elem_enum get_fn push_fn c_elem op_str2 left_is_arr right_is_arr is_plus is_string)
                } else {
                    (print "")
                }
                
                /* Special case: + for string concatenation */
                if (== binop.op LexerTokenType.TOKEN_PLUS) {
                    # I classify values from source types, not generated C substrings.
                    let left_is_str: bool = (== (infer_expr_type parser binop.left binop.left_type env) "string")
                    let right_is_str: bool = (== (infer_expr_type parser binop.right binop.right_type env) "string")
                    /* Check struct field access for string type */
                    let mut left_is_str_field: bool = false
                    let mut right_is_str_field: bool = false
                    if (== binop.left_type ParseNodeType.PNODE_FIELD_ACCESS) {
                        let lfa: ASTFieldAccess = (parser_get_field_access parser binop.left)
                        let mut lowner_type: string = ""
                        if (== lfa.object_type ParseNodeType.PNODE_IDENTIFIER) {
                            let lowner_id: ASTIdentifier = (parser_get_identifier parser lfa.object)
                            set lowner_type (genenv_get env lowner_id.name)
                        } else { (print "") }
                        if (!= lowner_type "") {
                            let lft: string = (lookup_struct_field_type parser lowner_type lfa.field_name)
                            if (== lft "string") { set left_is_str_field true } else { (print "") }
                        } else { (print "") }
                    } else { (print "") }
                    if (== binop.right_type ParseNodeType.PNODE_FIELD_ACCESS) {
                        let rfa: ASTFieldAccess = (parser_get_field_access parser binop.right)
                        let mut rowner_type: string = ""
                        if (== rfa.object_type ParseNodeType.PNODE_IDENTIFIER) {
                            let rowner_id: ASTIdentifier = (parser_get_identifier parser rfa.object)
                            set rowner_type (genenv_get env rowner_id.name)
                        } else { (print "") }
                        if (!= rowner_type "") {
                            let rft: string = (lookup_struct_field_type parser rowner_type rfa.field_name)
                            if (== rft "string") { set right_is_str_field true } else { (print "") }
                        } else { (print "") }
                    } else { (print "") }

                    let either_is_str: bool = (or (or left_is_str right_is_str) (or left_is_str_field right_is_str_field))
                    if either_is_str {
                        let mut parts: array<string> = []
                        set parts (cg_append parts "nl_str_concat(")
                        set parts (cg_append parts left_code)
                        set parts (cg_append parts ", ")
                        set parts (cg_append parts right_code)
                        set parts (cg_append parts ")")
                        return (cg_build parts)
                    } else {
                        (print "")
                    }
                } else {
                    (print "")
                }

                /* String equality/inequality: use strcmp instead of pointer comparison */
                if (or (== binop.op LexerTokenType.TOKEN_EQ) (== binop.op LexerTokenType.TOKEN_NE)) {
                    let left_is_lit: bool = (and (> (str_length left_code) 0) (== (char_at left_code 0) 34))
                    let right_is_lit: bool = (and (> (str_length right_code) 0) (== (char_at right_code 0) 34))
                    let mut left_is_str_var2: bool = false
                    let mut right_is_str_var2: bool = false
                    if (== binop.left_type ParseNodeType.PNODE_IDENTIFIER) {
                        let lid2: ASTIdentifier = (parser_get_identifier parser binop.left)
                        let lt2: string = (genenv_get env lid2.name)
                        if (== lt2 "string") { set left_is_str_var2 true } else { (print "") }
                    } else { (print "") }
                    if (== binop.right_type ParseNodeType.PNODE_IDENTIFIER) {
                        let rid2: ASTIdentifier = (parser_get_identifier parser binop.right)
                        let rt2: string = (genenv_get env rid2.name)
                        if (== rt2 "string") { set right_is_str_var2 true } else { (print "") }
                    } else { (print "") }
                    let mut left_is_str_field: bool = false
                    let mut right_is_str_field: bool = false
                    if (== binop.left_type ParseNodeType.PNODE_FIELD_ACCESS) {
                        let lfa: ASTFieldAccess = (parser_get_field_access parser binop.left)
                        let mut lowner_type: string = ""
                        if (== lfa.object_type ParseNodeType.PNODE_IDENTIFIER) {
                            let lowner_id: ASTIdentifier = (parser_get_identifier parser lfa.object)
                            set lowner_type (genenv_get env lowner_id.name)
                        } else { (print "") }
                        if (!= lowner_type "") {
                            let lft: string = (lookup_struct_field_type parser lowner_type lfa.field_name)
                            if (== lft "string") { set left_is_str_field true } else { (print "") }
                        } else { (print "") }
                    } else { (print "") }
                    if (== binop.right_type ParseNodeType.PNODE_FIELD_ACCESS) {
                        let rfa: ASTFieldAccess = (parser_get_field_access parser binop.right)
                        let mut rowner_type: string = ""
                        if (== rfa.object_type ParseNodeType.PNODE_IDENTIFIER) {
                            let rowner_id: ASTIdentifier = (parser_get_identifier parser rfa.object)
                            set rowner_type (genenv_get env rowner_id.name)
                        } else { (print "") }
                        if (!= rowner_type "") {
                            let rft: string = (lookup_struct_field_type parser rowner_type rfa.field_name)
                            if (== rft "string") { set right_is_str_field true } else { (print "") }
                        } else { (print "") }
                    } else { (print "") }
                    let has_literal: bool = (or left_is_lit right_is_lit)
                    let any_str_var: bool = (or left_is_str_var2 right_is_str_var2)
                    let any_str_field: bool = (or left_is_str_field right_is_str_field)
                    let left_semantic: string = (infer_expr_type parser binop.left binop.left_type env)
                    let right_semantic: string = (infer_expr_type parser binop.right binop.right_type env)
                    let string_call: bool = (or (== left_semantic "string") (== right_semantic "string"))
                    let use_strcmp: bool = (or string_call (or has_literal (or any_str_var any_str_field)))
                    if use_strcmp {
                        let mut parts: array<string> = []
                        set parts (cg_append parts "(strcmp(")
                        set parts (cg_append parts left_code)
                        set parts (cg_append parts ", ")
                        set parts (cg_append parts right_code)
                        if (== binop.op LexerTokenType.TOKEN_EQ) {
                            set parts (cg_append parts ") == 0)")
                        } else {
                            set parts (cg_append parts ") != 0)")
                        }
                        return (cg_build parts)
                    } else {
                        (print "")
                    }
                } else {
                    (print "")
                }
                
                # I snapshot both exact float operands before one policy operation.
                let left_scalar: string = (infer_expr_type parser binop.left binop.left_type env)
                let right_scalar: string = (infer_expr_type parser binop.right binop.right_type env)
                if (and (and (== left_scalar "float") (== right_scalar "float"))
                        (or (or (== binop.op LexerTokenType.TOKEN_PLUS) (== binop.op LexerTokenType.TOKEN_MINUS))
                            (or (== binop.op LexerTokenType.TOKEN_STAR) (== binop.op LexerTokenType.TOKEN_SLASH)))) {
                    let mut helper: string = "nano_rt_f64_add"
                    if (== binop.op LexerTokenType.TOKEN_MINUS) { set helper "nano_rt_f64_sub" }
                    if (== binop.op LexerTokenType.TOKEN_STAR) { set helper "nano_rt_f64_mul" }
                    if (== binop.op LexerTokenType.TOKEN_SLASH) { set helper "nano_rt_f64_div" }
                    return (+ "({ double nano_rt_f64_left = " (+ left_code (+ "; double nano_rt_f64_right = " (+ right_code (+ "; " (+ helper "(nano_rt_f64_left, nano_rt_f64_right); })"))))))
                }

                /* Get operator string */
                let op_str: string = (operator_to_string binop.op)
                
                # I preserve each operand's AST grouping, including comparisons.
                return (gen_binary_op op_str left_code right_code)
            } else {
                if (== node_type ParseNodeType.PNODE_CALL) {
                    /* Function call */
                    let call: ASTCall = (parser_get_call parser node_id)
                    if (> call.borrow_mode 0) {
                        let place: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
                        return (+ "(&(" (+ (generate_expression parser place.node_id place.node_type env "") "))"))
                    }

                    if (!= call.function_type ParseNodeType.PNODE_IDENTIFIER) {
                        let callee_code: string = (generate_expression parser call.function call.function_type env "")
                        let callee_signature: string = (infer_expr_type parser call.function call.function_type env)
                        let suffix: string = (int_to_string node_id)
                        let fn_temp: string = (+ "_nl_call_fn_" suffix)
                        let mut parts: array<string> = []
                        set parts (cg_append parts "({ __auto_type ")
                        set parts (cg_append parts fn_temp)
                        set parts (cg_append parts " = ")
                        set parts (cg_append parts callee_code)
                        set parts (cg_append parts "; ")
                        let mut i: int = 0
                        while (< i call.arg_count) {
                            let aref: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start i))
                            let arg_expected: string = (function_value_argument_type callee_signature i)
                            let arg_code: string = (generate_expression parser aref.node_id aref.node_type env arg_expected)
                            let arg_temp: string = (+ "_nl_call_arg_" (+ suffix (+ "_" (int_to_string i))))
                            set parts (cg_append parts "__auto_type ")
                            set parts (cg_append parts arg_temp)
                            set parts (cg_append parts " = ")
                            set parts (cg_append parts arg_code)
                            set parts (cg_append parts "; ")
                            set i (+ i 1)
                        }
                        set parts (cg_append parts fn_temp)
                        set parts (cg_append parts "(")
                        set i 0
                        while (< i call.arg_count) {
                            if (> i 0) { set parts (cg_append parts ", ") } else { (print "") }
                            set parts (cg_append parts (+ "_nl_call_arg_" (+ suffix (+ "_" (int_to_string i)))))
                            set i (+ i 1)
                        }
                        set parts (cg_append parts "); })")
                        return (cg_build parts)
                    } else { (print "") }
                    
                    /* Get function name from identifier */
                    let func_id: ASTIdentifier = (parser_get_identifier parser call.function)
                    let func_name: string = (mb_resolve func_id.name func_id.line env.names)
                    if (and (native_array_operation func_id.name) (not (native_array_builtin parser func_id env))) {
                        return (generate_bound_push parser call func_id env node_id)
                    }


                    let exact_array: string = (generate_native_opaque_array_call parser call func_name node_id env expected_type)
                    if (!= exact_array "") { return exact_array }

                    /* Special-case: unary not is represented as a call */
                    if (== func_name "not") {
                        if (== call.arg_count 1) {
                            let a0: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
                            let a0_code: string = (generate_expression parser a0.node_id a0.node_type env "")
                            let arg_is_binop: bool = (== a0.node_type ParseNodeType.PNODE_BINARY_OP)
                            let mut parts: array<string> = []
                            set parts (cg_append parts "(!")
                            if arg_is_binop {
                                set parts (cg_append parts "(")
                            } else { (print "") }
                            set parts (cg_append parts a0_code)
                            if arg_is_binop {
                                set parts (cg_append parts ")")
                            } else { (print "") }
                            set parts (cg_append parts ")")
                            return (cg_build parts)
                        } else {
                            return "(!0)"
                        }
                    } else {
                        (print "")
                    }

                    /* __try__: x? desugars to (__try__ x).
                     * Extracts the Ok value or early-returns the Err. */
                    if (== func_name "__try__") {
                        if (== call.arg_count 1) {
                            let try_a0: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
                            let try_a0_code: string = (generate_expression parser try_a0.node_id try_a0.node_type env "")
                            let mut try_union_type: string = ""
                            if (== try_a0.node_type ParseNodeType.PNODE_IDENTIFIER) {
                                let try_id0: ASTIdentifier = (parser_get_identifier parser try_a0.node_id)
                                set try_union_type (genenv_get env try_id0.name)
                            } else { (print "") }
                            if (== try_union_type "") { set try_union_type "Result" } else { (print "") }
                            let try_c_type: string = (+ "nl_" try_union_type)
                            let try_err_tag: string = (+ (+ (+ "nl_" try_union_type) "_TAG_") "Err")
                            let try_tmp: string = "_nl_try_r"
                            let mut tp: array<string> = []
                            set tp (cg_append tp "({ ")
                            set tp (cg_append tp try_c_type)
                            set tp (cg_append tp " ")
                            set tp (cg_append tp try_tmp)
                            set tp (cg_append tp " = ")
                            set tp (cg_append tp try_a0_code)
                            set tp (cg_append tp "; if (")
                            set tp (cg_append tp try_tmp)
                            set tp (cg_append tp ".tag == ")
                            set tp (cg_append tp try_err_tag)
                            set tp (cg_append tp ") return ")
                            set tp (cg_append tp try_tmp)
                            /* Extract the inner Ok value: .data.Ok.fieldname (or .data.Ok for struct) */
                            let try_ok_field: string = (get_variant_first_field_access parser try_union_type "Ok")
                            set tp (cg_append tp "; ")
                            set tp (cg_append tp try_tmp)
                            set tp (cg_append tp ".data.Ok")
                            set tp (cg_append tp try_ok_field)
                            set tp (cg_append tp "; })")
                            return (cg_build tp)
                        } else {
                            return "0"
                        }
                    } else {
                        (print "")
                    }

                    /* to_string: polymorphic conversion used by f-string interpolation.
                     * Wraps int/float/bool with nl_*_to_string; passes string through unchanged. */
                    if (== func_name "to_string") {
                        if (== call.arg_count 1) {
                            let ts_a0: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
                            let ts_code: string = (generate_expression parser ts_a0.node_id ts_a0.node_type env "")
                            let ts_type: string = (infer_expr_type parser ts_a0.node_id ts_a0.node_type env)
                            if (== ts_type "int") {
                                return (+ (+ "nl_int_to_string(" ts_code) ")")
                            } else { if (== ts_type "float") {
                                return (+ (+ "nl_float_to_string(" ts_code) ")")
                            } else { if (== ts_type "bool") {
                                return (+ (+ "nl_bool_to_string(" ts_code) ")")
                            } else {
                                return ts_code
                            } } }
                        } else {
                            return "\"\""
                        }
                    } else {
                        (print "")
                    }

                    /* Array builtins map directly to DynArray runtime */
                    if (== func_name "array_length") {
                        if (== call.arg_count 1) {
                            let a0: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
                            let a0_code: string = (generate_expression parser a0.node_id a0.node_type env "")
                            let mut parts: array<string> = []
                            set parts (cg_append parts "dyn_array_length(")
                            set parts (cg_append parts a0_code)
                            set parts (cg_append parts ")")
                            return (cg_build parts)
                        } else {
                            return "0"
                        }
                    } else {
                        (print "")
                    }

                    if (== func_name "array_remove_at") {
                        if (== call.arg_count 2) {
                            let a0: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
                            let a1: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
                            let a0_code: string = (generate_expression parser a0.node_id a0.node_type env "")
                            let a1_code: string = (generate_expression parser a1.node_id a1.node_type env "")
                            let mut parts: array<string> = []
                            set parts (cg_append parts "dyn_array_remove_at(")
                            set parts (cg_append parts a0_code)
                            set parts (cg_append parts ", ")
                            set parts (cg_append parts a1_code)
                            set parts (cg_append parts ")")
                            return (cg_build parts)
                        } else {
                            return "0"
                        }
                    } else {
                        (print "")
                    }

                    if (== func_name "array_new") {
                        if (== call.arg_count 2) {
                            let a0: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
                            let a1: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
                            let size_code: string = (generate_expression parser a0.node_id a0.node_type env "")
                            let def_code: string = (generate_expression parser a1.node_id a1.node_type env "")

                            let mut elem_t: string = "int"
                            if (is_array_type expected_type) {
                                let inferred: string = (array_elem_type_from_array_type expected_type)
                                if (!= inferred "") { set elem_t inferred } else { (print "") }
                                if (and (== elem_t "array") (str_contains expected_type "array<")) {
                                    let inner_t: string = (array_elem_type_from_array_type expected_type)
                                    if (type_is_struct inner_t) {
                                        set elem_t ""
                                    } else { (print "") }
                                } else { (print "") }
                            } else {
                                (print "")
                            }

                            let elem_enum: string = (elem_enum_from_elem_type elem_t)
                            let push_fn: string = (push_fn_from_elem_type elem_t)

                            let mut parts: array<string> = []
                            set parts (cg_append parts "({ DynArray* _arr = dyn_array_new(")
                            set parts (cg_append parts elem_enum)
                            set parts (cg_append parts "); int64_t _n = ")
                            set parts (cg_append parts size_code)
                            set parts (cg_append parts "; for (int64_t _i = 0; _i < _n; _i++) { ")
                            if (type_is_struct elem_t) {
                                set parts (cg_append parts "dyn_array_push_int(_arr, ")
                                set parts (cg_append parts (box_struct_expr elem_t def_code))
                                set parts (cg_append parts "); ")
                            } else {
                                set parts (cg_append parts push_fn)
                                set parts (cg_append parts "(_arr, ")
                                set parts (cg_append parts def_code)
                                set parts (cg_append parts "); ")
                            }
                            set parts (cg_append parts "} _arr; })")
                            return (cg_build parts)
                        } else {
                            return "0"
                        }
                    } else {
                        (print "")
                    }

                    if (== func_name "array_push") {
                        if (== call.arg_count 2) {
                            let a0: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
                            let a1: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
                            let mut arr_t: string = ""
                            if (is_array_type expected_type) {
                                set arr_t expected_type
                            } else {
                                if (== a0.node_type ParseNodeType.PNODE_IDENTIFIER) {
                                    let id0: ASTIdentifier = (parser_get_identifier parser a0.node_id)
                                    set arr_t (genenv_get env id0.name)
                                } else { (print "") }
                            }

                            let mut elem_t: string = (array_elem_type_from_array_type arr_t)
                            if (== elem_t "") { set elem_t "int" } else { (print "") }
                            if (== elem_t "int") {
                                if (== a1.node_type ParseNodeType.PNODE_STRUCT_LITERAL) {
                                    let sl: ASTStructLiteral = (parser_get_struct_literal parser a1.node_id)
                                    set elem_t sl.struct_name
                                } else {
                                    if (== a1.node_type ParseNodeType.PNODE_IDENTIFIER) {
                                        let id1: ASTIdentifier = (parser_get_identifier parser a1.node_id)
                                        let inferred_t: string = (genenv_get env id1.name)
                                        if (type_is_struct inferred_t) {
                                            set elem_t inferred_t
                                        } else { (print "") }
                                    } else { (print "") }
                                }
                            } else { (print "") }
                            let arr_code: string = (generate_expression parser a0.node_id a0.node_type env (+ "array<" (+ elem_t ">")))
                            let val_code: string = (generate_expression parser a1.node_id a1.node_type env elem_t)
                            let push_fn: string = (push_fn_from_elem_type elem_t)

                            let mut parts: array<string> = []
                            set parts (cg_append parts push_fn)
                            set parts (cg_append parts "(")
                            set parts (cg_append parts arr_code)
                            if (type_is_struct elem_t) {
                                set parts (cg_append parts ", ")
                                set parts (cg_append parts (box_struct_expr elem_t val_code))
                            } else {
                                set parts (cg_append parts ", ")
                                set parts (cg_append parts val_code)
                            }
                            set parts (cg_append parts ")")
                            return (cg_build parts)
                        } else {
                            return "0"
                        }
                    } else {
                        (print "")
                    }

                    if (== func_name "array_set") {
                        if (== call.arg_count 3) {
                            let a0: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
                            let a1: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
                            let a2: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 2))
                            let arr_type: string = (infer_expr_type parser a0.node_id a0.node_type env)
                            let mut elem_t: string = (array_elem_type_from_array_type arr_type)
                            if (== elem_t "") { set elem_t "int" }
                            let arr_code: string = (generate_expression parser a0.node_id a0.node_type env arr_type)
                            let idx_code: string = (generate_expression parser a1.node_id a1.node_type env "int")

                            if (== elem_t "int") {
                                if (== a2.node_type ParseNodeType.PNODE_STRUCT_LITERAL) {
                                    let sl2: ASTStructLiteral = (parser_get_struct_literal parser a2.node_id)
                                    set elem_t sl2.struct_name
                                } else {
                                    if (== a2.node_type ParseNodeType.PNODE_IDENTIFIER) {
                                        let id2: ASTIdentifier = (parser_get_identifier parser a2.node_id)
                                        let inferred_t2: string = (genenv_get env id2.name)
                                        if (type_is_struct inferred_t2) {
                                            set elem_t inferred_t2
                                        } else { (print "") }
                                    } else { (print "") }
                                }
                            } else { (print "") }

                            let val_code: string = (generate_expression parser a2.node_id a2.node_type env elem_t)
                            let set_fn: string = (set_fn_from_elem_type elem_t)
                            let mut parts: array<string> = []

                            set parts (cg_append parts set_fn)
                            set parts (cg_append parts "(")
                            set parts (cg_append parts arr_code)
                            set parts (cg_append parts ", ")
                            set parts (cg_append parts idx_code)
                            if (type_is_struct elem_t) {
                                set parts (cg_append parts ", ")
                                set parts (cg_append parts (box_struct_expr elem_t val_code))
                            } else {
                                set parts (cg_append parts ", ")
                                set parts (cg_append parts val_code)
                            }
                            set parts (cg_append parts ")")
                            return (cg_build parts)
                        } else {
                            return "0"
                        }
                    } else {
                        (print "")
                    }

                    if (or (== func_name "at") (== func_name "array_get")) {
                        if (== call.arg_count 2) {
                            let a0: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
                            let a1: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
                            let a0_code: string = (generate_expression parser a0.node_id a0.node_type env "")
                            let a1_code: string = (generate_expression parser a1.node_id a1.node_type env "")

                            let mut elem_t: string = (array_elem_type_from_array_type (infer_expr_type parser a0.node_id a0.node_type env))
                            if (== elem_t "") {
                            if (is_array_type expected_type) {
                                set elem_t "array"
                            } else {
                                set elem_t expected_type
                            }
                            }

                            if (== elem_t "") {
                                if (== a0.node_type ParseNodeType.PNODE_IDENTIFIER) {
                                    let id0: ASTIdentifier = (parser_get_identifier parser a0.node_id)
                                    let arr_t: string = (genenv_get env id0.name)
                                    let inferred: string = (array_elem_type_from_array_type arr_t)
                                    if (!= inferred "") { set elem_t inferred } else { set elem_t "int" }
                                } else {
                                    if (== a0.node_type ParseNodeType.PNODE_CALL) {
                                        let nested_arr_t: string = (infer_expr_type parser a0.node_id a0.node_type env)
                                        let nested_inferred: string = (array_elem_type_from_array_type nested_arr_t)
                                        if (!= nested_inferred "") { set elem_t nested_inferred } else { set elem_t "int" }
                                    } else {
                                    if (== a0.node_type ParseNodeType.PNODE_FIELD_ACCESS) {
                                        let fa0: ASTFieldAccess = (parser_get_field_access parser a0.node_id)
                                        let mut owner_type: string = ""
                                        if (== fa0.object_type ParseNodeType.PNODE_IDENTIFIER) {
                                            let owner_id: ASTIdentifier = (parser_get_identifier parser fa0.object)
                                            set owner_type (genenv_get env owner_id.name)
                                        } else { (print "") }
                                        if (!= owner_type "") {
                                            let field_t: string = (lookup_struct_field_type parser owner_type fa0.field_name)
                                            let fa_inferred: string = (array_elem_type_from_array_type field_t)
                                            if (!= fa_inferred "") { set elem_t fa_inferred } else { set elem_t "int" }
                                        } else {
                                            set elem_t "int"
                                        }
                                    } else {
                                        set elem_t "int"
                                    }
                                    }
                                }
                            } else {
                                (print "")
                            }

                            let get_fn: string = (get_fn_from_elem_type elem_t)
                            let mut parts: array<string> = []
                            if (type_is_struct elem_t) {
                                let mut elem_struct: string = (+ "nl_" (mangle_type_name elem_t))
                                if (!= (native_opaque_key elem_t) "") { set elem_struct (type_to_c elem_t) }
                                set parts (cg_append parts "*(")
                                set parts (cg_append parts elem_struct)
                                set parts (cg_append parts "*)((void*)")
                                set parts (cg_append parts get_fn)
                                set parts (cg_append parts "(")
                                set parts (cg_append parts a0_code)
                                set parts (cg_append parts ", ")
                                set parts (cg_append parts a1_code)
                                set parts (cg_append parts "))")
                            } else {
                                set parts (cg_append parts get_fn)
                                set parts (cg_append parts "(")
                                set parts (cg_append parts a0_code)
                                set parts (cg_append parts ", ")
                                set parts (cg_append parts a1_code)
                                set parts (cg_append parts ")")
                            }
                            return (cg_build parts)
                        } else {
                            return "0"
                        }
                    } else {
                        (print "")
                    }
                    
                    if (and (or (== func_name "map") (== func_name "array_map")) (== call.arg_count 2)) {
                        let mapped: string = (generate_scalar_map parser call env)
                        if (!= mapped "") { return mapped }
                    }
                    /* array_map: (array_map arr fn) -> mapped array */
                    if (== func_name "array_map") {
                        if (== call.arg_count 2) {
                            let am_a0: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
                            let am_a1: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
                            let am_a0_code: string = (generate_expression parser am_a0.node_id am_a0.node_type env "")
                            let am_a1_code: string = (generate_expression parser am_a1.node_id am_a1.node_type env "")
                            let mut am_elem_t: string = ""
                            if (== am_a0.node_type ParseNodeType.PNODE_IDENTIFIER) {
                                let am_id0: ASTIdentifier = (parser_get_identifier parser am_a0.node_id)
                                let am_arr_t: string = (genenv_get env am_id0.name)
                                let am_inferred: string = (array_elem_type_from_array_type am_arr_t)
                                if (!= am_inferred "") { set am_elem_t am_inferred } else { set am_elem_t "int" }
                            } else { set am_elem_t "int" }
                            let mut am_helper: string = "nl_map"
                            if (== am_elem_t "string") { set am_helper "nl_map_str" } else {
                                if (== am_elem_t "float") { set am_helper "nl_map_float" } else { (print "") }
                            }
                            let mut am_parts: array<string> = []
                            set am_parts (cg_append am_parts am_helper)
                            set am_parts (cg_append am_parts "(")
                            set am_parts (cg_append am_parts am_a0_code)
                            set am_parts (cg_append am_parts ", ")
                            set am_parts (cg_append am_parts am_a1_code)
                            set am_parts (cg_append am_parts ")")
                            return (cg_build am_parts)
                        } else { (print "") }
                    } else { (print "") }

                    /* array_filter: (array_filter arr pred) -> filtered array */
                    if (or (== func_name "array_filter") (== func_name "filter")) {
                        if (== call.arg_count 2) {
                            let af_a0: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
                            let af_a1: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
                            let mut af_elem_t: string = (array_elem_type_from_array_type (infer_expr_type parser af_a0.node_id af_a0.node_type env))
                            if (or (== af_elem_t "") (== af_elem_t "unknown")) {
                                set af_elem_t (array_elem_type_from_array_type expected_type)
                            }
                            if (or (== af_elem_t "") (== af_elem_t "unknown")) { set af_elem_t "int" }
                            let af_a0_code: string = (generate_expression parser af_a0.node_id af_a0.node_type env (+ "array<" (+ af_elem_t ">")))
                            let af_a1_code: string = (generate_expression parser af_a1.node_id af_a1.node_type env "")
                            let mut af_helper: string = "nl_filter"
                            if (== af_elem_t "string") { set af_helper "nl_filter_str" } else {
                                if (== af_elem_t "float") { set af_helper "nl_filter_float" } else {
                                    if (== af_elem_t "bool") { set af_helper "nl_filter_bool" }
                                }
                            }
                            let mut af_parts: array<string> = []
                            set af_parts (cg_append af_parts af_helper)
                            set af_parts (cg_append af_parts "(")
                            set af_parts (cg_append af_parts af_a0_code)
                            set af_parts (cg_append af_parts ", ")
                            set af_parts (cg_append af_parts af_a1_code)
                            set af_parts (cg_append af_parts ")")
                            return (cg_build af_parts)
                        } else { (print "") }
                    } else { (print "") }

                    if (legacy_reduce_builtin parser func_id env) {
                        return (generate_scalar_reduce parser call env)
                    }

                    /* HashMap<string,string> type-aware dispatch */
                    /* map_new: use expected_type to pick constructor */
                    if (== func_name "map_new") {
                        if (or (== expected_type "HashMap<string,string>") (== expected_type "HashMap<string, string>")) {
                            return "nl_hm_new()"
                        } else {
                            return "nl_map_new()"
                        }
                    } else { (print "") }

                    /* map_put/map_set: 3 args (map, key, val) */
                    if (or (== func_name "map_put") (== func_name "map_set")) {
                        if (== call.arg_count 3) {
                            let mp_a0: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
                            let mp_a1: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
                            let mp_a2: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 2))
                            let mp_a0_code: string = (generate_expression parser mp_a0.node_id mp_a0.node_type env "")
                            let mp_a1_code: string = (generate_expression parser mp_a1.node_id mp_a1.node_type env "")
                            let mp_a2_code: string = (generate_expression parser mp_a2.node_id mp_a2.node_type env "")
                            let mut mp_map_type: string = ""
                            if (== mp_a0.node_type ParseNodeType.PNODE_IDENTIFIER) {
                                let mp_id0: ASTIdentifier = (parser_get_identifier parser mp_a0.node_id)
                                set mp_map_type (genenv_get env mp_id0.name)
                            } else { (print "") }
                            let mut mp_parts: array<string> = []
                            if (or (== mp_map_type "HashMap<string,string>") (== mp_map_type "HashMap<string, string>")) {
                                set mp_parts (cg_append mp_parts "nl_hm_put(")
                            } else {
                                set mp_parts (cg_append mp_parts "nl_map_put(")
                            }
                            set mp_parts (cg_append mp_parts mp_a0_code)
                            set mp_parts (cg_append mp_parts ", ")
                            set mp_parts (cg_append mp_parts mp_a1_code)
                            set mp_parts (cg_append mp_parts ", ")
                            set mp_parts (cg_append mp_parts mp_a2_code)
                            set mp_parts (cg_append mp_parts ")")
                            return (cg_build mp_parts)
                        } else { (print "") }
                    } else { (print "") }

                    /* map_has: 2 args (map, key) -> bool */
                    if (== func_name "map_has") {
                        if (== call.arg_count 2) {
                            let mh_a0: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
                            let mh_a1: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
                            let mh_a0_code: string = (generate_expression parser mh_a0.node_id mh_a0.node_type env "")
                            let mh_a1_code: string = (generate_expression parser mh_a1.node_id mh_a1.node_type env "")
                            let mut mh_map_type: string = ""
                            if (== mh_a0.node_type ParseNodeType.PNODE_IDENTIFIER) {
                                let mh_id0: ASTIdentifier = (parser_get_identifier parser mh_a0.node_id)
                                set mh_map_type (genenv_get env mh_id0.name)
                            } else { (print "") }
                            let mut mh_parts: array<string> = []
                            if (or (== mh_map_type "HashMap<string,string>") (== mh_map_type "HashMap<string, string>")) {
                                set mh_parts (cg_append mh_parts "nl_hm_has(")
                            } else {
                                set mh_parts (cg_append mh_parts "nl_map_has(")
                            }
                            set mh_parts (cg_append mh_parts mh_a0_code)
                            set mh_parts (cg_append mh_parts ", ")
                            set mh_parts (cg_append mh_parts mh_a1_code)
                            set mh_parts (cg_append mh_parts ")")
                            return (cg_build mh_parts)
                        } else { (print "") }
                    } else { (print "") }

                    /* map_get: 2 args (map, key) -> value */
                    if (== func_name "map_get") {
                        if (== call.arg_count 2) {
                            let mg_a0: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
                            let mg_a1: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
                            let mg_a0_code: string = (generate_expression parser mg_a0.node_id mg_a0.node_type env "")
                            let mg_a1_code: string = (generate_expression parser mg_a1.node_id mg_a1.node_type env "")
                            let mut mg_map_type: string = ""
                            if (== mg_a0.node_type ParseNodeType.PNODE_IDENTIFIER) {
                                let mg_id0: ASTIdentifier = (parser_get_identifier parser mg_a0.node_id)
                                set mg_map_type (genenv_get env mg_id0.name)
                            } else { (print "") }
                            let mut mg_parts: array<string> = []
                            if (or (== mg_map_type "HashMap<string,string>") (== mg_map_type "HashMap<string, string>")) {
                                set mg_parts (cg_append mg_parts "nl_hm_get(")
                            } else {
                                set mg_parts (cg_append mg_parts "nl_map_get(")
                            }
                            set mg_parts (cg_append mg_parts mg_a0_code)
                            set mg_parts (cg_append mg_parts ", ")
                            set mg_parts (cg_append mg_parts mg_a1_code)
                            set mg_parts (cg_append mg_parts ")")
                            return (cg_build mg_parts)
                        } else { (print "") }
                    } else { (print "") }

                    /* map_length/map_size: 1 arg (map) -> int */
                    if (or (== func_name "map_length") (== func_name "map_size")) {
                        if (== call.arg_count 1) {
                            let ml_a0: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
                            let ml_a0_code: string = (generate_expression parser ml_a0.node_id ml_a0.node_type env "")
                            let mut ml_map_type: string = ""
                            if (== ml_a0.node_type ParseNodeType.PNODE_IDENTIFIER) {
                                let ml_id0: ASTIdentifier = (parser_get_identifier parser ml_a0.node_id)
                                set ml_map_type (genenv_get env ml_id0.name)
                            } else { (print "") }
                            let mut ml_parts: array<string> = []
                            if (or (== ml_map_type "HashMap<string,string>") (== ml_map_type "HashMap<string, string>")) {
                                set ml_parts (cg_append ml_parts "nl_hm_size(")
                            } else {
                                set ml_parts (cg_append ml_parts "nl_map_size(")
                            }
                            set ml_parts (cg_append ml_parts ml_a0_code)
                            set ml_parts (cg_append ml_parts ")")
                            return (cg_build ml_parts)
                        } else { (print "") }
                    } else { (print "") }

                    /* Build call: proper function name (handles list runtime).
                     * Check builtin map first - this lets extern fn calls be routed through
                     * nl_ wrappers (e.g. nl_path_normalize for const char*→char* cast). */
                    let mut c_func_name: string = func_name
                    let mut extern_builtin_map: string = (map_builtin_func_name func_name)
                    if (and (or (== func_name "reduce") (== func_name "array_fold")) (not (legacy_reduce_builtin parser func_id env))) { set extern_builtin_map "" }
                    if (and (== func_name "cast_int") (> call.arg_count 0)) {
                        let cast_arg: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
                        let cast_arg_type: string = (infer_expr_type parser cast_arg.node_id cast_arg.node_type env)
                        if (or (== cast_arg_type "int") (or (== cast_arg_type "u8") (== cast_arg_type "bool"))) {
                            set extern_builtin_map "nl_cast_int_from_int"
                        } else { (print "") }
                    } else { (print "") }
                    if (and (== func_name "cast_bool") (> call.arg_count 0)) {
                        let bool_arg: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
                        let bool_arg_type: string = (infer_expr_type parser bool_arg.node_id bool_arg.node_type env)
                        if (== bool_arg_type "float") {
                            set extern_builtin_map "nl_cast_bool_from_float"
                        } else { (print "") }
                    } else { (print "") }
                    if (!= extern_builtin_map "") {
                        set c_func_name extern_builtin_map
                    } else {
                        if (is_extern_function parser func_name) {
                            (print "")
                        } else {
                            set c_func_name (c_func_name_for_call func_name)
                        }
                    }

                    let mut parts: array<string> = []
                    if (== (genenv_get env func_id.name) "") {
                        set c_func_name (guard_native_array_reference parser func_name c_func_name)
                    } else {
                        set c_func_name (genenv_c_name env func_name)
                    }
                    set parts (cg_append parts c_func_name)
                    set parts (cg_append parts "(")

                    /* Generate arguments */
                    let mut i: int = 0
                    while (< i call.arg_count) {
                        if (> i 0) {
                            set parts (cg_append parts ", ")
                        } else {
                            (print "")
                        }

                        let aref: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start i))
                        let mut arg_expected: string = (declared_call_argument_type parser func_name i)
                        let function_value_type: string = (genenv_get env func_id.name)
                        if (is_fn_type function_value_type) { set arg_expected (function_value_argument_type function_value_type i) }
                        if (or (== func_name "print") (== func_name "println")) {
                            set arg_expected "string"
                        } else { (print "") }
                        let mut arg_code: string = (generate_expression parser aref.node_id aref.node_type env arg_expected)
                        if (or (== func_name "print") (== func_name "println")) {
                            if (== aref.node_type ParseNodeType.PNODE_IDENTIFIER) {
                                let arg_id: ASTIdentifier = (parser_get_identifier parser aref.node_id)
                                let arg_t: string = (genenv_get env arg_id.name)
                                if (type_is_float arg_t) {
                                    set arg_code (+ "nl_float_to_string(" (+ arg_code ")"))
                                } else { (print "") }
                                if (and (and (!= arg_t "") (!= arg_t "string")) (not (type_is_float arg_t))) {
                                    set arg_code (+ "nl_int_to_string(" (+ arg_code ")"))
                                } else { (print "") }
                            } else {
                                if (== aref.node_type ParseNodeType.PNODE_CALL) {
                                    let arg_call: ASTCall = (parser_get_call parser aref.node_id)
                                    if (!= arg_call.function_type ParseNodeType.PNODE_IDENTIFIER) {
                                        let result_type: string = (infer_expr_type parser aref.node_id aref.node_type env)
                                        if (type_is_float result_type) {
                                            set arg_code (+ "nl_float_to_string(" (+ arg_code ")"))
                                        } else {
                                            if (== result_type "int") {
                                                set arg_code (+ "nl_int_to_string(" (+ arg_code ")"))
                                            } else {
                                                if (== result_type "bool") {
                                                    set arg_code (+ "nl_bool_to_string(" (+ arg_code ")"))
                                                }
                                            }
                                        }
                                    } else {
                                    let arg_call_id: ASTIdentifier = (parser_get_identifier parser arg_call.function)
                                    let call_ret_t: string = (lookup_func_return_type_in_parser parser (mb_resolve arg_call_id.name arg_call_id.line env.names))
                                    if (or (func_returns_float arg_call_id.name) (== call_ret_t "float")) {
                                        set arg_code (+ "nl_float_to_string(" (+ arg_code ")"))
                                    } else {
                                        if (== call_ret_t "int") {
                                            set arg_code (+ "nl_int_to_string(" (+ arg_code ")"))
                                        } else {
                                            if (== call_ret_t "bool") {
                                                set arg_code (+ "nl_bool_to_string(" (+ arg_code ")"))
                                            } else {
                                                /* Polymorphic builtins (abs, min, max): check first arg type */
                                                if (or (== arg_call_id.name "abs") (or (== arg_call_id.name "min") (== arg_call_id.name "max"))) {
                                                    let mut is_float_call: bool = false
                                                    if (> arg_call.arg_count 0) {
                                                        let first_arg: ASTStmtRef = (parser_get_call_arg parser arg_call.arg_start)
                                                        if (== first_arg.node_type ParseNodeType.PNODE_FLOAT) {
                                                            set is_float_call true
                                                        } else { (print "") }
                                                    } else { (print "") }
                                                    if is_float_call {
                                                        set arg_code (+ "nl_float_to_string(" (+ arg_code ")"))
                                                    } else {
                                                        set arg_code (+ "nl_int_to_string(" (+ arg_code ")"))
                                                    }
                                                } else {
                                                    /* Known int-returning builtins (including list_*_length) */
                                                    let is_known_int_fn: bool = (or (== arg_call_id.name "array_length") (or (== arg_call_id.name "str_length") (or (== arg_call_id.name "char_at") (or (== arg_call_id.name "string_to_int") (or (== arg_call_id.name "digit_value") (== arg_call_id.name "cast_int"))))))
                                                    let is_list_length: bool = (and (transp_str_starts_with arg_call_id.name "list_") (str_contains arg_call_id.name "_length"))
                                                    if (or is_known_int_fn is_list_length) {
                                                        set arg_code (+ "nl_int_to_string(" (+ arg_code ")"))
                                                    } else {
                                                        /* Known string-returning builtins */
                                                        if (or (== arg_call_id.name "int_to_string") (or (== arg_call_id.name "float_to_string") (or (== arg_call_id.name "bool_to_string") (or (== arg_call_id.name "str_substring") (== arg_call_id.name "string_from_char"))))) {
                                                            (print "")
                                                        } else {
                                                            /* Known bool-returning builtins */
                                                            if (or (== arg_call_id.name "str_contains") (or (== arg_call_id.name "str_equals") (or (== arg_call_id.name "is_digit") (or (== arg_call_id.name "is_alpha") (== arg_call_id.name "is_whitespace"))))) {
                                                                set arg_code (+ "nl_bool_to_string(" (+ arg_code ")"))
                                                            } else { (print "") }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    }
                                } else {
                                    if (== aref.node_type ParseNodeType.PNODE_NUMBER) {
                                        set arg_code (+ "nl_int_to_string(" (+ arg_code ")"))
                                    } else {
                                        if (== aref.node_type ParseNodeType.PNODE_FLOAT) {
                                            set arg_code (+ "nl_float_to_string(" (+ arg_code ")"))
                                        } else {
                                            if (== aref.node_type ParseNodeType.PNODE_BINARY_OP) {
                                                let binop: ASTBinaryOp = (parser_get_binary_op parser aref.node_id)
                                                let op: int = binop.op
                                                /* Wrap arithmetic ops with int_to_string (including + when it's not string concat) */
                                                let is_arith_op: bool = (or (== op LexerTokenType.TOKEN_MINUS) (or (== op LexerTokenType.TOKEN_STAR) (or (== op LexerTokenType.TOKEN_SLASH) (== op LexerTokenType.TOKEN_PERCENT))))
                                                /* + is int arithmetic if result doesn't look like str_concat */
                                                let is_plus_int: bool = (and (== op LexerTokenType.TOKEN_PLUS) (not (str_contains arg_code "nl_str_concat")))
                                                if (or is_arith_op is_plus_int) {
                                                    set arg_code (+ "nl_int_to_string(" (+ arg_code ")"))
                                                } else { (print "") }
                                            } else {
                                            if (== aref.node_type ParseNodeType.PNODE_FIELD_ACCESS) {
                                                /* Struct field access in print - look up actual field type */
                                                let fa_arg: ASTFieldAccess = (parser_get_field_access parser aref.node_id)
                                                let mut fa_owner_type: string = ""
                                                if (== fa_arg.object_type ParseNodeType.PNODE_IDENTIFIER) {
                                                    let fa_owner_id: ASTIdentifier = (parser_get_identifier parser fa_arg.object)
                                                    set fa_owner_type (genenv_get env fa_owner_id.name)
                                                } else {
                                                    /* Handle nested field access: obj.inner.field */
                                                    if (== fa_arg.object_type ParseNodeType.PNODE_FIELD_ACCESS) {
                                                        let inner_fa: ASTFieldAccess = (parser_get_field_access parser fa_arg.object)
                                                        if (== inner_fa.object_type ParseNodeType.PNODE_IDENTIFIER) {
                                                            let inner_id: ASTIdentifier = (parser_get_identifier parser inner_fa.object)
                                                            let inner_owner: string = (genenv_get env inner_id.name)
                                                            set fa_owner_type (lookup_struct_field_type parser inner_owner inner_fa.field_name)
                                                        } else { (print "") }
                                                    } else { (print "") }
                                                }
                                                let fa_field_type: string = (lookup_struct_field_type parser fa_owner_type fa_arg.field_name)
                                                if (== fa_field_type "int") {
                                                    set arg_code (+ "nl_int_to_string(" (+ arg_code ")"))
                                                } else {
                                                if (== fa_field_type "float") {
                                                    set arg_code (+ "nl_float_to_string(" (+ arg_code ")"))
                                                } else {
                                                if (== fa_field_type "bool") {
                                                    set arg_code (+ "nl_bool_to_string(" (+ arg_code ")"))
                                                } else {
                                                    /* string or unknown - no wrapping needed */
                                                    (print "")
                                                } } }
                                            } else { (print "") }
                                            }
                                        }
                                    }
                                }
                            }
                        } else { (print "") }
                        set parts (cg_append parts arg_code)
                        set i (+ i 1)
                    }
                    
                    set parts (cg_append parts ")")
                    return (cg_build parts)
                } else {
                    if (== node_type ParseNodeType.PNODE_MODULE_QUALIFIED_CALL) {
                        /* Module-qualified function call: Module.function(args...) */
                        let mqc: ASTModuleQualifiedCall = (parser_get_module_qualified_call parser node_id)
                        
                        /* Use function_name which contains full qualified name */
                        let qualified_name: string = (mb_lookup (mb_owner mqc.line) mqc.function_name)
                        let mut c_func_name: string = (c_name_for_qualified_function qualified_name)
                        if (!= qualified_name mqc.function_name) {
                            set c_func_name (c_func_name_for_call qualified_name)
                            if (is_extern_function parser qualified_name) {
                                set c_func_name qualified_name
                                let mapped: string = (map_builtin_func_name qualified_name)
                                if (!= mapped "") { set c_func_name mapped }
                            }
                        }
                        
                        let mut parts: array<string> = []
                        set parts (cg_append parts (guard_native_array_reference parser qualified_name c_func_name))
                        set parts (cg_append parts "(")
                        
                        /* Generate arguments */
                        let mut i: int = 0
                        while (< i mqc.arg_count) {
                            if (> i 0) {
                                set parts (cg_append parts ", ")
                            } else {
                                (print "")
                            }
                            
                            let aref: ASTStmtRef = (parser_get_call_arg parser (+ mqc.arg_start i))
                            let arg_expected: string = (declared_call_argument_type parser qualified_name i)
                            let arg_code: string = (generate_expression parser aref.node_id aref.node_type env arg_expected)
                            set parts (cg_append parts arg_code)
                            set i (+ i 1)
                        }
                        
                        set parts (cg_append parts ")")
                        return (cg_build parts)
                    } else {
                        if (== node_type ParseNodeType.PNODE_FIELD_ACCESS) {
                        /* Field access */
                        let fa: ASTFieldAccess = (parser_get_field_access parser node_id)
                        /* If the object is an enum identifier (e.g. DiagnosticSeverity.DIAG_ERROR),
                         * emit a C enum constant rather than a struct field access. */
                        if (== fa.object_type ParseNodeType.PNODE_IDENTIFIER) {
                            let ident: ASTIdentifier = (parser_get_identifier parser fa.object)
                            /* Self-hosted MVP: recognize schema enums by name. */
                            if (or (== ident.name "DiagnosticSeverity") (== ident.name "CompilerPhase")) {
                                let mut parts: array<string> = []
                                set parts (cg_append parts ident.name)
                                set parts (cg_append parts "_")
                                set parts (cg_append parts (mangle_name fa.field_name))
                                return (cg_build parts)
                            } else {
                                if (or (== ident.name "TokenType") (or (== ident.name "ParseNodeType") (or (== ident.name "LexerTokenType") (== ident.name "TypeKind")))) {
                                    return (mangle_name fa.field_name)
                                } else {
                                    /* Check if this is a user-defined enum */
                                    let mut ei: int = 0
                                    let enum_count: int = (parser_get_enum_count parser)
                                    let mut found_enum: bool = false
                                    while (< ei enum_count) {
                                        let e: ASTEnum = (parser_get_enum parser ei)
                                        if (== e.name ident.name) {
                                            set found_enum true
                                        } else { (print "") }
                                        set ei (+ ei 1)
                                    }
                                    if found_enum {
                                        let mut eparts: array<string> = []
                                        set eparts (cg_append eparts "nl_")
                                        set eparts (cg_append eparts ident.name)
                                        set eparts (cg_append eparts "_")
                                        set eparts (cg_append eparts fa.field_name)
                                        return (cg_build eparts)
                                    } else { (print "") }
                                }
                            }
                        } else { (print "") }

                        let obj_code: string = (generate_expression parser fa.object fa.object_type env "")
                        let mut parts: array<string> = []
                        /* Add (char*) cast when accessing string fields of extern structs.
                         * The schema defines string fields as const char*, but NanoLang string = char*.
                         * The cast avoids -Wdiscarded-qualifiers warnings during bootstrap. */
                        let mut fa_field_is_string: bool = false
                        if (== fa.object_type ParseNodeType.PNODE_IDENTIFIER) {
                            let fa_id: ASTIdentifier = (parser_get_identifier parser fa.object)
                            let fa_owner_type: string = (genenv_get env fa_id.name)
                            if (!= fa_owner_type "") {
                                let fa_ft: string = (lookup_struct_field_type parser fa_owner_type fa.field_name)
                                if (== fa_ft "string") {
                                    set fa_field_is_string true
                                } else { (print "") }
                            } else { (print "") }
                        } else {
                            /* Handle nested field access: obj.inner.field */
                            if (== fa.object_type ParseNodeType.PNODE_FIELD_ACCESS) {
                                let inner_fa: ASTFieldAccess = (parser_get_field_access parser fa.object)
                                if (== inner_fa.object_type ParseNodeType.PNODE_IDENTIFIER) {
                                    let inner_id: ASTIdentifier = (parser_get_identifier parser inner_fa.object)
                                    let inner_owner: string = (genenv_get env inner_id.name)
                                    if (!= inner_owner "") {
                                        let inner_ft: string = (lookup_struct_field_type parser inner_owner inner_fa.field_name)
                                        if (!= inner_ft "") {
                                            let nested_ft: string = (lookup_struct_field_type parser inner_ft fa.field_name)
                                            if (== nested_ft "string") {
                                                set fa_field_is_string true
                                            } else { (print "") }
                                        } else { (print "") }
                                    } else { (print "") }
                                } else { (print "") }
                            } else { (print "") }
                        }
                        if fa_field_is_string {
                            set parts (cg_append parts "(char*)((")
                            set parts (cg_append parts obj_code)
                            set parts (cg_append parts ").")
                            set parts (cg_append parts (mangle_name fa.field_name))
                            set parts (cg_append parts ")")
                        } else {
                            set parts (cg_append parts "(")
                            set parts (cg_append parts obj_code)
                            set parts (cg_append parts ").")
                            set parts (cg_append parts (mangle_name fa.field_name))
                        }
                        return (cg_build parts)
                    } else {
                        if (== node_type ParseNodeType.PNODE_ARRAY_LITERAL) {
                            /* Array literal -> DynArray* */
                            let arr: ASTArrayLiteral = (parser_get_array_literal parser node_id)

                            /* I retain the declared element type for nonempty literals too. */
                            let mut elem_t: string = arr.element_type
                            let mut child_type: string = arr.element_type
                            if (== child_type "") { set child_type (full_array_element_type expected_type) }
                            if (is_array_type elem_t) { set elem_t "array" }
                            if (== elem_t "") {
                                if (is_array_type expected_type) {
                                    set elem_t (array_elem_type_from_array_type expected_type)
                                } else { (print "") }
                            } else { (print "") }

                            if (and (== elem_t "") (> arr.element_count 0)) {
                                let inferred: string = (full_array_element_type (infer_expr_type parser node_id node_type env))
                                if (native_array_exact inferred) { set elem_t inferred set child_type inferred }
                            }

                            let mut elem_enum: string = "ELEM_INT"
                            let mut push_fn: string = "dyn_array_push_int"

                            if (!= elem_t "") {
                                set elem_enum (elem_enum_from_elem_type elem_t)
                                set push_fn (push_fn_from_elem_type elem_t)
                            } else {
                                /* Infer element type from first element expression kind (fallback to int) */
                                let mut elem_type: int = 0
                                if (> arr.element_count 0) {
                                    let first: ASTStmtRef = (parser_get_array_element parser arr.element_start)
                                    set elem_type first.node_type
                                } else { (print "") }

                                if (== elem_type ParseNodeType.PNODE_FLOAT) {
                                    set elem_enum "ELEM_FLOAT"
                                    set push_fn "dyn_array_push_float"
                                    set elem_t "float"
                                } else {
                                    if (== elem_type ParseNodeType.PNODE_STRING) {
                                        set elem_enum "ELEM_STRING"
                                        set push_fn "dyn_array_push_string"
                                        set elem_t "string"
                                    } else {
                                        if (== elem_type ParseNodeType.PNODE_BOOL) {
                                            set elem_enum "ELEM_BOOL"
                                            set push_fn "dyn_array_push_bool"
                                            set elem_t "bool"
                                        } else {
                                            if (== elem_type ParseNodeType.PNODE_ARRAY_LITERAL) {
                                                set elem_enum "ELEM_ARRAY"
                                                set push_fn "dyn_array_push_array"
                                                set elem_t "array"
                                            } else {
                                                set elem_t "int"
                                            }
                                        }
                                    }
                                }
                            }

                            if (native_array_exact elem_t) {
                                # Empty literals must collect their value alias before definitions.
                                let exact_type: string = (type_to_c elem_t)
                                let prefix: string = (+ (nb_emission_prefix) (+ "array_literal_" (+ (int_to_string node_id) "_")))
                                let mut exact: string = "({ "
                                let mut item: int = 0
                                while (< item arr.element_count) {
                                    let reference: ASTStmtRef = (parser_get_array_element parser (+ arr.element_start item))
                                    let value: string = (generate_expression parser reference.node_id reference.node_type env elem_t)
                                    set exact (+ exact (+ exact_type (+ " " (+ prefix (+ (int_to_string item) (+ " = " (+ value "; ")))))))
                                    set item (+ item 1)
                                }
                                set exact (+ exact "DynArray* _oa = dyn_array_new(ELEM_STRUCT); ")
                                set item 0
                                while (< item arr.element_count) {
                                    set exact (+ exact (native_array_push_code elem_t "_oa" (+ prefix (int_to_string item))))
                                    set item (+ item 1)
                                }
                                return (+ exact "_oa; })")
                            }

                            let mut arr_parts: array<string> = []
                            set arr_parts (cg_append arr_parts "({ DynArray* _arr = dyn_array_new(")
                            set arr_parts (cg_append arr_parts elem_enum)
                            set arr_parts (cg_append arr_parts "); ")

                            let mut i: int = 0
                            while (< i arr.element_count) {
                                let eref: ASTStmtRef = (parser_get_array_element parser (+ arr.element_start i))
                                let ecode: string = (generate_expression parser eref.node_id eref.node_type env child_type)

                                if (type_is_struct elem_t) {
                                    set arr_parts (cg_append arr_parts "dyn_array_push_int(_arr, ")
                                    set arr_parts (cg_append arr_parts (box_struct_expr elem_t ecode))
                                } else {
                                    set arr_parts (cg_append arr_parts push_fn)
                                    set arr_parts (cg_append arr_parts "(_arr, ")
                                    set arr_parts (cg_append arr_parts ecode)
                                    (print "")
                                }
                                set arr_parts (cg_append arr_parts "); ")
                                set i (+ i 1)
                            }

                            set arr_parts (cg_append arr_parts "_arr; })")
                            return (cg_build arr_parts)
                        } else {
                            if (== node_type ParseNodeType.PNODE_STRUCT_LITERAL) {
                                /* Struct literal -> compound literal */
                                let sl: ASTStructLiteral = (parser_get_struct_literal parser node_id)
                                
                                let mut c_type_parts: array<string> = []
                                set c_type_parts (cg_append c_type_parts "nl_")
                                set c_type_parts (cg_append c_type_parts (mangle_name sl.struct_name))
                                let c_type: string = (cg_build c_type_parts)
                                
                                let mut struct_parts: array<string> = []
                                set struct_parts (cg_append struct_parts "((")
                                set struct_parts (cg_append struct_parts c_type)
                                set struct_parts (cg_append struct_parts "){ ")

                                let mut i: int = 0
                                while (< i sl.field_count) {
                                    if (> i 0) {
                                        set struct_parts (cg_append struct_parts ", ")
                                    } else { (print "") }

                                    let fname: string = (at sl.field_names i)
                                    let vid: int = (at sl.field_value_ids i)
                                    let vty: int = (at sl.field_value_types i)
                                    let field_expected: string = (lookup_struct_field_type parser sl.struct_name fname)
                                    let vcode: string = (generate_expression parser vid vty env field_expected)

                                    set struct_parts (cg_append struct_parts ".")
                                    set struct_parts (cg_append struct_parts (mangle_name fname))
                                    set struct_parts (cg_append struct_parts " = ")
                                    set struct_parts (cg_append struct_parts vcode)

                                    set i (+ i 1)
                                }

                                set struct_parts (cg_append struct_parts " })")
                                return (cg_build struct_parts)
                            } else {
                                if (== node_type ParseNodeType.PNODE_UNION_CONSTRUCT) {
                                    /* Union construction -> compound literal */
                                    let uc: ASTUnionConstruct = (parser_get_union_construct parser node_id)

                                    /* Derive monomorphized union name from expected_type for generics */
                                    let mut actual_union_name: string = uc.union_name
                                    if (and (!= expected_type "") (is_generic_type expected_type)) {
                                        set actual_union_name (monomorphize_type_name expected_type)
                                    } else { (print "") }

                                    let mut union_parts: array<string> = []
                                    set union_parts (cg_append union_parts "nl_")
                                    set union_parts (cg_append union_parts (mangle_name actual_union_name))
                                    let union_c: string = (cg_build union_parts)

                                    let mut tag_parts: array<string> = []
                                    set tag_parts (cg_append tag_parts "nl_")
                                    set tag_parts (cg_append tag_parts (mangle_name actual_union_name))
                                    set tag_parts (cg_append tag_parts "_TAG_")
                                    set tag_parts (cg_append tag_parts uc.variant_name)
                                    let tag_name: string = (cg_build tag_parts)

                                    let mut union_construct_parts: array<string> = []
                                    set union_construct_parts (cg_append union_construct_parts "((")
                                    set union_construct_parts (cg_append union_construct_parts union_c)
                                    set union_construct_parts (cg_append union_construct_parts "){ .tag = ")
                                    set union_construct_parts (cg_append union_construct_parts tag_name)
                                    set union_construct_parts (cg_append union_construct_parts ", .data.")
                                    set union_construct_parts (cg_append union_construct_parts uc.variant_name)
                                    set union_construct_parts (cg_append union_construct_parts " = ")

                                    if (== uc.field_count 0) {
                                        set union_construct_parts (cg_append union_construct_parts "{0}")
                                    } else {
                                        set union_construct_parts (cg_append union_construct_parts "{")
                                        let mut i: int = 0
                                        while (< i uc.field_count) {
                                            if (> i 0) {
                                                set union_construct_parts (cg_append union_construct_parts ", ")
                                            } else { (print "") }

                                            let fname: string = (at uc.field_names i)
                                            let vid: int = (at uc.field_value_ids i)
                                            let vty: int = (at uc.field_value_types i)
                                            let field_expected: string = (lookup_union_payload_type parser uc.union_name uc.variant_name fname expected_type)
                                            let vcode: string = (generate_expression parser vid vty env field_expected)

                                            set union_construct_parts (cg_append union_construct_parts ".")
                                            set union_construct_parts (cg_append union_construct_parts (mangle_name fname))
                                            set union_construct_parts (cg_append union_construct_parts " = ")
                                            set union_construct_parts (cg_append union_construct_parts vcode)
                                            set i (+ i 1)
                                        }
                                        set union_construct_parts (cg_append union_construct_parts "}")
                                    }

                                    set union_construct_parts (cg_append union_construct_parts " })")
                                    return (cg_build union_construct_parts)
                                } else {
                                    if (== node_type ParseNodeType.PNODE_MATCH) {
                                        let m: ASTMatch = (parser_get_match parser node_id)
                                        return (generate_match_expr parser m env expected_type)
                                    } else {
                                        if (== node_type ParseNodeType.PNODE_TUPLE_LITERAL) {
                                            let tl: ASTTupleLiteral = (parser_get_tuple_literal parser node_id)
                                            let tuple_t: string = expected_type
                                            let mut tuple_name: string = "Tuple"
                                            if (is_tuple_type tuple_t) {
                                                set tuple_name (tuple_typedef_name tuple_t)
                                            } else {
                                                (print "")
                                            }

                                            let elem_expected: array<string> = (tuple_split_types tuple_t)

                                            let mut tuple_parts: array<string> = []
                                            set tuple_parts (cg_append tuple_parts "((")
                                            set tuple_parts (cg_append tuple_parts tuple_name)
                                            set tuple_parts (cg_append tuple_parts "){ ")

                                            let mut i: int = 0
                                            while (< i tl.element_count) {
                                                if (> i 0) {
                                                    set tuple_parts (cg_append tuple_parts ", ")
                                                } else { (print "") }

                                                let vid: int = (at tl.element_ids i)
                                                let vty: int = (at tl.element_types i)
                                                let mut exp_i: string = ""
                                                if (< i (array_length elem_expected)) {
                                                    set exp_i (at elem_expected i)
                                                } else { (print "") }

                                                let vcode: string = (generate_expression parser vid vty env exp_i)
                                                set tuple_parts (cg_append tuple_parts "._")
                                                set tuple_parts (cg_append tuple_parts (int_to_string i))
                                                set tuple_parts (cg_append tuple_parts " = ")
                                                set tuple_parts (cg_append tuple_parts vcode)
                                                set i (+ i 1)
                                            }

                                            set tuple_parts (cg_append tuple_parts " })")
                                            return (cg_build tuple_parts)
                                        } else {
                                            if (== node_type ParseNodeType.PNODE_TUPLE_INDEX) {
                                                let ti: ASTTupleIndex = (parser_get_tuple_index parser node_id)
                                                let tcode: string = (generate_expression parser ti.tuple ti.tuple_type env "")
                                                let mut tuple_index_parts: array<string> = []
                                                set tuple_index_parts (cg_append tuple_index_parts "((")
                                                set tuple_index_parts (cg_append tuple_index_parts tcode)
                                                set tuple_index_parts (cg_append tuple_index_parts ")._")
                                                set tuple_index_parts (cg_append tuple_index_parts (int_to_string ti.index))
                                                set tuple_index_parts (cg_append tuple_index_parts ")")
                                                return (cg_build tuple_index_parts)
                                            } else {
                                            if (== node_type ParseNodeType.PNODE_IF) {
                                                /* If-expression: generate C ternary (cond ? then : else) */
                                                let if_expr: ASTIf = (parser_get_if parser node_id)
                                                let cond_code: string = (generate_expression parser if_expr.condition if_expr.condition_type env "bool")
                                                /* Extract then value from single-statement then block */
                                                let then_blk: ASTBlock = (parser_get_block parser if_expr.then_body)
                                                let then_len: int = (list_ASTStmtRef_length then_blk.statements)
                                                let mut then_code: string = "0"
                                                if (> then_len 0) {
                                                    let then_s: ASTStmtRef = (list_ASTStmtRef_get then_blk.statements (- then_len 1))
                                                    set then_code (generate_expression parser then_s.node_id then_s.node_type env expected_type)
                                                } else { (print "") }
                                                /* Extract else value from single-statement else block */
                                                let else_blk: ASTBlock = (parser_get_block parser if_expr.else_body)
                                                let else_len: int = (list_ASTStmtRef_length else_blk.statements)
                                                let mut else_code: string = "0"
                                                if (> else_len 0) {
                                                    let else_s: ASTStmtRef = (list_ASTStmtRef_get else_blk.statements (- else_len 1))
                                                    set else_code (generate_expression parser else_s.node_id else_s.node_type env expected_type)
                                                } else { (print "") }
                                                let mut tern_parts: array<string> = []
                                                set tern_parts (cg_append tern_parts "(")
                                                set tern_parts (cg_append tern_parts cond_code)
                                                set tern_parts (cg_append tern_parts " ? ")
                                                set tern_parts (cg_append tern_parts then_code)
                                                set tern_parts (cg_append tern_parts " : ")
                                                set tern_parts (cg_append tern_parts else_code)
                                                set tern_parts (cg_append tern_parts ")")
                                                return (cg_build tern_parts)
                                            } else {
                                                /* Unknown type - return 0 */
                                                return "0"
                                            }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        }
        }
        }
    }
}

}

shadow generate_expression {
    let filter_types: array<string> = ["int", "float", "bool", "string"]
    let filter_values: array<string> = ["1", "1.5", "true", "\"text\""]
    let filter_helpers: array<string> = ["nl_filter(", "nl_filter_float(", "nl_filter_bool(", "nl_filter_str("]
    let mut filter_index: int = 0
    while (< filter_index 4) {
        let filter_type: string = (+ "array<" (+ (at filter_types filter_index) ">"))
        let filter_text: string = (+ "fn probe() -> " (+ filter_type (+ " { return (filter [" (+ (at filter_values filter_index) "] predicate) }"))))
        let filter_tokens: List<LexerToken> = (tokenize_string filter_text "filter.nano" (list_CompilerDiagnostic_new))
        let filter_parser: Parser = (parse_program filter_tokens (list_LexerToken_length filter_tokens) "filter.nano")
        let filter_return: ASTReturn = (parser_get_return filter_parser 0)
        let filter_code: string = (generate_expression filter_parser filter_return.value filter_return.value_type (genenv_new "test") filter_type)
        assert (str_contains filter_code (at filter_helpers filter_index))
        set filter_index (+ filter_index 1)
    }
    let nested_tokens: List<LexerToken> = (tokenize_string "fn nested() -> array<array<float>> { return [[], [1.5]] }" "arrays.nano" (list_CompilerDiagnostic_new))
    let nested_parser: Parser = (parse_program nested_tokens (list_LexerToken_length nested_tokens) "arrays.nano")
    let nested_return: ASTReturn = (parser_get_return nested_parser 0)
    let nested_code: string = (generate_expression nested_parser nested_return.value nested_return.value_type (genenv_new "test") "array<array<float>>")
    assert (str_contains nested_code "dyn_array_new(ELEM_ARRAY)")
    assert (str_contains nested_code "dyn_array_new(ELEM_FLOAT)")
    assert (not (str_contains nested_code "dyn_array_new(ELEM_INT)"))
    let source: string = (+ "f" "n main() -> int { return 42 }")
    let toks: List<LexerToken> = (tokenize_string source "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let ret: ASTReturn = (parser_get_return p 0)
    let env: GenEnv = (genenv_new "test")
    let code: string = (generate_expression p ret.value ret.value_type env "int")
    assert (== code "42")
}

/* Generate C code for a return statement
 * 
 * Args:
 *   parser: Parser containing AST nodes
 *   ret: Return statement node (contains value and value_type)
 *   indent: Indentation level
 * 
 * Returns: C code for return statement with indentation
 */
fn generate_return_stmt(parser: Parser, ret: ASTReturn, indent: int, env: GenEnv, expected_type: string) -> string {
    let mut parts: array<string> = []
    set parts (cg_append parts (gen_indent indent))
    set parts (cg_append parts "return")
    
    if (< ret.value 0) {
        /* No return value - void return */
        (print "")
    } else {
        /* Has return value - generate expression */
        set parts (cg_append parts " ")
        let expr_code: string = (generate_expression parser ret.value ret.value_type env expected_type)
        set parts (cg_append parts expr_code)
    }
    
    set parts (cg_append parts ";\n")
    return (cg_build parts)
}

shadow generate_return_stmt {
    let source: string = (+ "f" "n main() -> int { return 42 }")
    let toks: List<LexerToken> = (tokenize_string source "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let ret: ASTReturn = (parser_get_return p 0)
    let env: GenEnv = (genenv_new "test")
    let code: string = (generate_return_stmt p ret 0 env "int")
    assert (== code "return 42;\n")
}

/* Generate C code for a let statement
 * 
 * Args:
 *   parser: Parser containing AST nodes
 *   let_stmt: Let statement node
 *   indent: Indentation level
 * 
 * Returns: C code for variable declaration with initialization
 */
/* Map a NanoLang type to its NlGuarded_* C struct name */
fn guarded_type_name(nano_type: string) -> string {
    if (== nano_type "int") { return "NlGuarded_int" } else { (print "") }
    if (== nano_type "float") { return "NlGuarded_float" } else { (print "") }
    if (== nano_type "bool") { return "NlGuarded_bool" } else { (print "") }
    if (== nano_type "string") { return "NlGuarded_str" } else { (print "") }
    /* Struct/opaque: NlGuarded_<mangled_typename> */
    let mut parts: array<string> = []
    set parts (cg_append parts "NlGuarded_")
    set parts (cg_append parts (mangle_name nano_type))
    return (cg_build parts)
}

shadow guarded_type_name {
    assert (== (guarded_type_name "int") "NlGuarded_int")
    assert (== (guarded_type_name "float") "NlGuarded_float")
    assert (== (guarded_type_name "bool") "NlGuarded_bool")
    assert (== (guarded_type_name "string") "NlGuarded_str")
    assert (== (guarded_type_name "MyStruct") "NlGuarded_MyStruct")
}

/* Returns true for NanoLang primitive types that map to a predefined NlGuarded_* struct.
 * Only these types get dispatch-wrapped at module scope; complex types (arrays,
 * user structs) remain plain C variables. */
fn is_guarded_primitive(t: string) -> bool {
    if (== t "int") { return true } else { (print "") }
    if (== t "float") { return true } else { (print "") }
    if (== t "bool") { return true } else { (print "") }
    if (== t "string") { return true } else { (print "") }
    return false
}

shadow is_guarded_primitive {
    assert (== (is_guarded_primitive "int") true)
    assert (== (is_guarded_primitive "float") true)
    assert (== (is_guarded_primitive "bool") true)
    assert (== (is_guarded_primitive "string") true)
    assert (== (is_guarded_primitive "array<int>") false)
    assert (== (is_guarded_primitive "MyStruct") false)
}

fn generate_let_stmt(parser: Parser, let_stmt: ASTLet, indent: int, env: GenEnv) -> string {
    # A checked empty pattern over a name has no fields or runtime work.
    if (and let_stmt.is_destructure (and (== (array_length let_stmt.destructure_names) 0) (== let_stmt.value_type ParseNodeType.PNODE_IDENTIFIER))) {
        return (+ (gen_indent indent) "(void)0;\n")
    }
    let mut parts: array<string> = []
    set parts (cg_append parts (gen_indent indent))

    # I capture a checked payload once, retaining its concrete native layout.
    let c_type: string = (cond (let_stmt.is_destructure "__auto_type") (else (type_to_c let_stmt.var_type)))
    set parts (cg_append parts c_type)
    set parts (cg_append parts " ")
    let c_name: string = (cond ((== let_stmt.name "_") (+ "__nl_underscore_" (int_to_string (array_length env.names)))) (else (genenv_c_name env let_stmt.name)))
    set parts (cg_append parts c_name)
    set parts (cg_append parts " = ")
    if (< let_stmt.value 0) {
        set parts (cg_append parts "0")
    } else {
        let expr_code: string = (generate_expression parser let_stmt.value let_stmt.value_type env let_stmt.var_type)
        set parts (cg_append parts expr_code)
    }
    set parts (cg_append parts ";\n")
    return (cg_build parts)
}

shadow generate_let_stmt {
    let source: string = (+ "f" "n main() -> int { let x: int = 1 return x }")
    let toks: List<LexerToken> = (tokenize_string source "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let l: ASTLet = (parser_get_let p 0)
    let env: GenEnv = (genenv_new "test")
    let code: string = (generate_let_stmt p l 0 env)
    assert (== code "int64_t nl_x = 1;\n")
    let pattern_tokens: List<LexerToken> = (tokenize_string "fn unpack(payload: Box.Some) -> int { let Box.Some { value } = payload return value }" "pattern.nano" (list_CompilerDiagnostic_new))
    let pattern: Parser = (parse_program pattern_tokens (list_LexerToken_length pattern_tokens) "pattern.nano")
    let captured: string = (generate_let_stmt pattern (parser_get_let pattern 1) 0 env)
    assert (transp_str_starts_with captured "__auto_type nl_")
}

fn generate_assert_stmt(parser: Parser, a: ASTAssert, indent: int, env: GenEnv) -> string {
    let mut parts: array<string> = []
    set parts (cg_append parts (gen_indent indent))
    let cond_code: string = (generate_expression parser a.condition a.condition_type env "bool")
    set parts (cg_append parts "assert(")
    set parts (cg_append parts cond_code)
    set parts (cg_append parts ");\n")
    return (cg_build parts)
}

shadow generate_assert_stmt {
    let source: string = (+ "f" "n main() -> int { assert true return 0 }")
    let toks: List<LexerToken> = (tokenize_string source "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let a: ASTAssert = (parser_get_assert p 0)
    let env: GenEnv = (genenv_new "test")
    let code: string = (generate_assert_stmt p a 0 env)
    assert (== code "assert(1);\n")
}

# I emit statements in order; only a final expression assigns the arm value.
fn generate_match_arm_value(parser: Parser, body_id: int, body_type: int, env: GenEnv, expected_type: string) -> string {
    if (!= body_type ParseNodeType.PNODE_BLOCK) {
        return (+ "_out = " (+ (generate_expression parser body_id body_type env expected_type) "; "))
    }
    let block: ASTBlock = (parser_get_block parser body_id)
    let count: int = (list_ASTStmtRef_length block.statements)
    let mut env_cur: GenEnv = env
    let mut parts: array<string> = []
    let return_type: string = (lookup_func_return_type_in_parser parser env.scope)
    let mut i: int = 0
    while (< i count) {
        let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements i)
        if (and (== i (- count 1)) (parser_is_value_expression stmt.node_type)) {
            set parts (cg_append parts "_out = ")
            set parts (cg_append parts (generate_expression parser stmt.node_id stmt.node_type env_cur expected_type))
            set parts (cg_append parts "; ")
        } else {
            let generated: StmtGenResult = (generate_statement parser stmt 0 env_cur return_type)
            set parts (cg_append parts generated.code)
            set env_cur generated.env
        }
        set i (+ i 1)
    }
    return (cg_build parts)
}

shadow generate_match_arm_value {
    let toks: List<LexerToken> = (tokenize_string "fn value() -> void { let n: int = 7 n }" "t.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program toks (list_LexerToken_length toks) "block.nano")
    let func: ASTFunction = (parser_get_function parser 0)
    let code: string = (generate_match_arm_value parser func.body ParseNodeType.PNODE_BLOCK (genenv_new "value") "int")
    assert (str_contains code "n = 7")
    assert (str_contains code "_out = nl_n;")
}

fn generate_match_ordered(parser: Parser, m: ASTMatch, env: GenEnv, expected_type: string, indent: int, value: bool) -> string {
    let scr_code: string = (generate_expression parser m.scrutinee m.scrutinee_type env "")

    /* Infer union name from scrutinee identifier type in env (common case). */
    let mut union_name: string = ""
    if (== m.scrutinee_type ParseNodeType.PNODE_IDENTIFIER) {
        let sid: ASTIdentifier = (parser_get_identifier parser m.scrutinee)
        set union_name (genenv_get env sid.name)
    } else {
        if (== m.scrutinee_type ParseNodeType.PNODE_UNION_CONSTRUCT) {
            let uc: ASTUnionConstruct = (parser_get_union_construct parser m.scrutinee)
            set union_name uc.union_name
        } else {
            (print "")
        }
    }

    if (== union_name "") {
        set union_name (infer_expr_type parser m.scrutinee m.scrutinee_type env)
    } else { (print "") }
    if (== union_name "") {
        set union_name "UNKNOWN"
    } else { (print "") }

    /* Monomorphize generic union names */
    if (is_generic_type union_name) {
        set union_name (monomorphize_type_name union_name)
    } else { (print "") }

    let mut union_parts: array<string> = []
    set union_parts (cg_append union_parts "nl_")
    set union_parts (cg_append union_parts union_name)
    let union_c: string = (cg_build union_parts)
    let mut out_c: string = "int64_t"
    if (!= expected_type "") {
        set out_c (type_to_c expected_type)
    } else { (print "") }

    # My actual scrutinee type also identifies wildcard-only integer matches.
    let is_int_match: bool = (== union_name "int")
    let mut parts: array<string> = []
    if value { set parts (cg_append parts "({ ") }
    else { set parts (cg_append parts (gen_indent indent)) set parts (cg_append parts "{\n") }
    if is_int_match { set parts (cg_append parts "int64_t _m = ") }
    else { set parts (cg_append parts union_c) set parts (cg_append parts " _m = ") }
    set parts (cg_append parts scr_code)
    set parts (cg_append parts "; ")
    if value {
        set parts (cg_append parts out_c)
        set parts (cg_append parts " _out = {0}; ")
    }
    set parts (cg_append parts "int _matched = 0; ")
    let mut all_returns: bool = (> m.arm_count 0)
    let mut i: int = 0
    while (< i m.arm_count) {
        let variant: string = (at m.arm_variants i)
        let binding: string = (at m.arm_bindings i)
        let mut env_arm: GenEnv = env
        set parts (cg_append parts "if (!_matched && (")
        if (== variant "_") { set parts (cg_append parts "1") }
        else {
            if (transp_str_starts_with variant "INT:") {
                set parts (cg_append parts (+ "_m == " (str_substring variant 4 (- (str_length variant) 4))))
            } else { set parts (cg_append parts (+ "_m.tag == nl_" (+ union_name (+ "_TAG_" variant)))) }
        }
        set parts (cg_append parts ")) { ")
        if (and (not is_int_match) (!= variant "_")) {
            set parts (cg_append parts (gen_match_variant_binding parser union_name variant binding ""))
            if (and (!= binding "_") (!= binding "")) {
                set env_arm (genenv_put env binding (get_variant_field_type parser union_name variant) false)
            }
        }
        let guard_id: int = (at m.arm_guard_ids i)
        if (>= guard_id 0) {
            set parts (cg_append parts "if (")
            set parts (cg_append parts (generate_expression parser guard_id (at m.arm_guard_types i) env_arm "bool"))
            set parts (cg_append parts ") { ")
        }
        set parts (cg_append parts "_matched = 1;\n")
        let body_id: int = (at m.arm_body_ids i)
        let body_type: int = (at m.arm_body_types i)
        if (not (parser_always_returns parser body_id body_type)) { set all_returns false }
        if value {
            set parts (cg_append parts (generate_match_arm_value parser body_id body_type env_arm expected_type))
        } else {
            if (== body_type ParseNodeType.PNODE_BLOCK) {
                set parts (cg_append parts (generate_block parser body_id (+ indent 1) env_arm expected_type))
            } else {
                set parts (cg_append parts (generate_expression parser body_id body_type env_arm ""))
                set parts (cg_append parts "; ")
            }
        }
        if (>= guard_id 0) { set parts (cg_append parts "} ") }
        set parts (cg_append parts "} ")
        set i (+ i 1)
    }
    # I never publish the initialization value after an unmatched checked input.
    if (or value (not all_returns)) { set parts (cg_append parts "if (!_matched) ") }
    set parts (cg_append parts "{ fprintf(stderr, \"I reached no successful checked match arm\\n\"); abort(); } ")
    if value { set parts (cg_append parts "_out; })") }
    else { set parts (cg_append parts "}\n") }
    return (cg_build parts)
}

shadow generate_match_ordered {
    let tokens: List<LexerToken> = (tokenize_string "fn main() -> int { return match 1 { _ if false => 4 1 if true => 7 _ => 9 } }" "ordered.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "ordered.nano")
    let matched: ASTMatch = (parser_get_match parser 0)
    let expr: string = (generate_match_ordered parser matched (genenv_new "main") "int" 0 true)
    assert (str_contains expr "int64_t _m = 1;")
    assert (str_contains expr "if (!_matched && (1)) { if (0)")
    assert (str_contains expr "_m == 1")
    assert (str_contains expr "if (!_matched) { fprintf")
    assert (not (str_contains expr "switch"))
    let stmt: string = (generate_match_ordered parser matched (genenv_new "main") "int" 0 false)
    assert (not (str_contains stmt "_out"))
    assert (str_contains stmt "abort();")
    let exits: List<LexerToken> = (tokenize_string "fn f() -> int { match 1 { 1 if false => { return 2 } _ => { return 3 } } } fn g() -> int { while true { match 1 { 1 if true => { break } _ => { continue } } } return 0 }" "exits.nano" (list_CompilerDiagnostic_new))
    let parsed: Parser = (parse_program exits (list_LexerToken_length exits) "exits.nano")
    let returning: string = (generate_match_ordered parsed (parser_get_match parsed 0) (genenv_new "f") "int" 0 false)
    assert (str_contains returning "return 2;")
    assert (str_contains returning "_matched = 1;\n#line ")
    assert (not (str_contains returning "if (!_matched) { fprintf"))
    let looping: string = (generate_match_ordered parsed (parser_get_match parsed 1) (genenv_new "g") "int" 0 false)
    assert (str_contains looping "break;")
    assert (str_contains looping "continue;")
    assert (not (str_contains looping "switch"))
}

fn generate_match_expr(parser: Parser, m: ASTMatch, env: GenEnv, expected_type: string) -> string {
    return (generate_match_ordered parser m env expected_type 0 true)
}

shadow generate_match_expr {
    let source: string = (+ "f" "n main() -> int { let x: Option = 0 match x { Some(y) => y } return 0 }")
    let toks: List<LexerToken> = (tokenize_string source "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let m: ASTMatch = (parser_get_match p 0)
    let env0: GenEnv = (genenv_put (genenv_new "test") "x" "Option" false)
    let code: string = (generate_match_expr p m env0 "int")
    assert (str_contains code "int64_t _out = {0};")
    let aggregate: string = (generate_match_expr p m env0 "Option")
    assert (str_contains aggregate "nl_Option _out = {0};")
    let int_tokens: List<LexerToken> = (tokenize_string "fn main() -> int { return match 1 { 1 => 7, _ => 8 } }" "int.nano" (list_CompilerDiagnostic_new))
    let int_parser: Parser = (parse_program int_tokens (list_LexerToken_length int_tokens) "int.nano")
    let int_match: ASTMatch = (parser_get_match int_parser 0)
    let int_code: string = (generate_match_expr int_parser int_match (genenv_new "main") "int")
    assert (str_contains int_code "int64_t _out = {0}; int _matched = 0;")
    assert (str_contains int_code "abort();")
}

/* Get the NanoLang type of the first field of a union variant (for env registration).
 * Returns "string", "int", "bool" etc. for single-field variants,
 * or "union_name.variant" (the old format) if not found or multi-field. */
fn get_variant_field_type(parser: Parser, union_name: string, variant: string) -> string {
    let ucount: int = (parser_get_union_count parser)
    let mut ui: int = 0
    while (< ui ucount) {
        let u: ASTUnion = (parser_get_union parser ui)
        if (== u.name union_name) {
            let mut vi: int = 0
            let mut variant_idx: int = -1
            while (< vi u.variant_count) {
                let vname: string = (at u.variant_names vi)
                if (== vname variant) { set variant_idx vi } else { (print "") }
                set vi (+ vi 1)
            }
            if (== variant_idx -1) {
                return (str_concat (str_concat union_name ".") variant)
            } else { (print "") }
            let mut field_offset: int = 0
            set vi 0
            while (< vi variant_idx) {
                set field_offset (+ field_offset (at u.variant_field_counts vi))
                set vi (+ vi 1)
            }
            let fcount: int = (at u.variant_field_counts variant_idx)
            if (== fcount 1) {
                let fname: string = (at u.variant_field_names field_offset)
                /* Only extract inner type for positional/anonymous fields (_0).
                 * Named fields keep the struct binding type so callers use s.fieldname. */
                if (== fname "_0") {
                    return (at u.variant_field_types field_offset)
                } else { (print "") }
            } else { (print "") }
            return (str_concat (str_concat union_name ".") variant)
        } else { (print "") }
        set ui (+ ui 1)
    }
    return (str_concat (str_concat union_name ".") variant)
}

shadow get_variant_field_type {
    let source: string = "union Color { Red {}, Green {}, Blue { val: int } } fn main() -> int { return 0 }"
    let toks: List<LexerToken> = (tokenize_string source "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (not (parser_has_error p))
    /* Unit variant — returns "Color.Red" */
    let t1: string = (get_variant_field_type p "Color" "Red")
    assert (== t1 "Color.Red")
    /* Single-field variant with named field — not positional, returns "Color.Blue" */
    let t2: string = (get_variant_field_type p "Color" "Blue")
    assert (!= t2 "")
    /* Unknown union — returns "Unknown.Var" */
    let t3: string = (get_variant_field_type p "Unknown" "Var")
    assert (== t3 "Unknown.Var")
}

/* Get the C field access suffix for the first field of a union variant.
 * Returns ".fieldname" for single-field variants (e.g., ".val" for Ok { val: int }).
 * Returns "" for unit variants or if union not found (caller appends nothing).
 * Used by the ? operator to extract the inner value from the success variant. */
fn get_variant_first_field_access(parser: Parser, union_name: string, variant: string) -> string {
    let ucount: int = (parser_get_union_count parser)
    let mut ui: int = 0
    while (< ui ucount) {
        let u: ASTUnion = (parser_get_union parser ui)
        if (== u.name union_name) {
            /* Find variant index and field_offset */
            let mut vi: int = 0
            let mut variant_idx: int = -1
            while (< vi u.variant_count) {
                let vname: string = (at u.variant_names vi)
                if (== vname variant) { set variant_idx vi } else { (print "") }
                set vi (+ vi 1)
            }
            if (== variant_idx -1) { return "" } else { (print "") }
            /* Compute field_offset */
            let mut field_offset: int = 0
            set vi 0
            while (< vi variant_idx) {
                set field_offset (+ field_offset (at u.variant_field_counts vi))
                set vi (+ vi 1)
            }
            let fcount: int = (at u.variant_field_counts variant_idx)
            if (== fcount 0) { return "" } else { (print "") }
            let fname: string = (at u.variant_field_names field_offset)
            return (str_concat "." (mangle_name fname))
        } else { (print "") }
        set ui (+ ui 1)
    }
    return ""
}

shadow get_variant_first_field_access {
    let source: string = "union Result { Ok { _0: int }, Err {} } fn main() -> int { return 0 }"
    let toks: List<LexerToken> = (tokenize_string source "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (not (parser_has_error p))
    /* Unit variant — no field access */
    let a1: string = (get_variant_first_field_access p "Result" "Err")
    assert (== a1 "")
    /* Positional _0 field — returns ".fieldname" */
    let a2: string = (get_variant_first_field_access p "Result" "Ok")
    assert (== a2 "._0")
    /* Unknown union — returns "" */
    let a3: string = (get_variant_first_field_access p "NoSuchUnion" "X")
    assert (== a3 "")
}

/* Look up a union's variant field info for match binding generation.
 * Returns the C-level declaration and value expression for binding a variable
 * to a union variant's inner value:
 *   - If variant has 1 field: "c_type nl_VAR = _m.data.VARIANT.FIELD;\n"
 *   - If variant has 0 fields: "" (no binding needed)
 *   - If variant has >1 fields: struct declaration (old behaviour)
 * Caller provides indentation string. */
fn gen_match_variant_binding(parser: Parser, union_name: string, variant: string, binding: string, indent_str: string) -> string {
    if (== binding "_") { return "" }
    /* Search for the union definition */
    let ucount: int = (parser_get_union_count parser)
    let mut ui: int = 0
    let mut found_u: ASTUnion = ASTUnion { node_type: 0, line: 0, column: 0, name: "", variant_count: 0, variant_names: [], variant_field_counts: [], variant_field_names: [], variant_field_types: [], generic_params: [], generic_param_count: 0 }
    let mut found: bool = false
    while (< ui ucount) {
        let u: ASTUnion = (parser_get_union parser ui)
        if (== u.name union_name) {
            set found_u u
            set found true
        } else { (print "") }
        set ui (+ ui 1)
    }

    if (and (== binding "") (not found)) {
        if (== reduce_emission_error "") { set reduce_emission_error "I require an exact zero-field variant for an empty match binding." }
        return ""
    }
    if (not found) {
        /* Fallback: old struct behaviour */
        let mut parts: array<string> = []
        set parts (cg_append parts indent_str)
        set parts (cg_append parts "nl_")
        set parts (cg_append parts union_name)
        set parts (cg_append parts "_")
        set parts (cg_append parts variant)
        set parts (cg_append parts " nl_")
        set parts (cg_append parts (mangle_name binding))
        set parts (cg_append parts " = _m.data.")
        set parts (cg_append parts variant)
        set parts (cg_append parts ";\n")
        return (cg_build parts)
    } else { (print "") }

    /* Find the variant index */
    let mut vi: int = 0
    let mut variant_idx: int = -1
    while (< vi found_u.variant_count) {
        let vname: string = (at found_u.variant_names vi)
        if (== vname variant) {
            set variant_idx vi
        } else { (print "") }
        set vi (+ vi 1)
    }
    /* Compute field_offset by summing field counts of variants before variant_idx */
    let mut field_offset: int = 0
    set vi 0
    while (< vi variant_idx) {
        set field_offset (+ field_offset (at found_u.variant_field_counts vi))
        set vi (+ vi 1)
    }

    if (and (== binding "") (== variant_idx -1)) {
        if (== reduce_emission_error "") { set reduce_emission_error "I require an exact zero-field variant for an empty match binding." }
        return ""
    }
    if (== variant_idx -1) {
        /* Variant not found — fallback */
        let mut parts: array<string> = []
        set parts (cg_append parts indent_str)
        set parts (cg_append parts "nl_")
        set parts (cg_append parts union_name)
        set parts (cg_append parts "_")
        set parts (cg_append parts variant)
        set parts (cg_append parts " nl_")
        set parts (cg_append parts (mangle_name binding))
        set parts (cg_append parts " = _m.data.")
        set parts (cg_append parts variant)
        set parts (cg_append parts ";\n")
        return (cg_build parts)
    } else { (print "") }

    let fcount: int = (at found_u.variant_field_counts variant_idx)
    if (and (== binding "") (!= fcount 0)) {
        if (== reduce_emission_error "") { set reduce_emission_error "I require an exact zero-field variant for an empty match binding." }
        return ""
    }

    if (== fcount 0) {
        /* Unit variant — no binding */
        return ""
    } else { (print "") }

    if (== fcount 1) {
        let fname: string = (at found_u.variant_field_names field_offset)
        /* Only extract the inner value for positional/anonymous fields (_0).
         * Named fields keep the struct binding so callers can use s.fieldname. */
        if (== fname "_0") {
            let ftype: string = (at found_u.variant_field_types field_offset)
            let c_type: string = (type_to_c ftype)
            let mut parts: array<string> = []
            set parts (cg_append parts indent_str)
            set parts (cg_append parts c_type)
            set parts (cg_append parts " nl_")
            set parts (cg_append parts (mangle_name binding))
            set parts (cg_append parts " = _m.data.")
            set parts (cg_append parts variant)
            set parts (cg_append parts ".")
            set parts (cg_append parts (mangle_name fname))
            set parts (cg_append parts ";\n")
            return (cg_build parts)
        } else { (print "") }
        /* Named single-field variant — fall through to struct binding */
    } else { (print "") }

    /* Multi-field variant — use struct type (keep old behaviour) */
    let mut parts: array<string> = []
    set parts (cg_append parts indent_str)
    set parts (cg_append parts "nl_")
    set parts (cg_append parts union_name)
    set parts (cg_append parts "_")
    set parts (cg_append parts variant)
    set parts (cg_append parts " nl_")
    set parts (cg_append parts (mangle_name binding))
    set parts (cg_append parts " = _m.data.")
    set parts (cg_append parts variant)
    set parts (cg_append parts ";\n")
    return (cg_build parts)
}

shadow gen_match_variant_binding {
    let source: string = "union Opt { Some { _0: int }, None {} } fn main() -> int { return 0 }"
    let toks: List<LexerToken> = (tokenize_string source "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (not (parser_has_error p))
    /* Unit variant — no binding needed */
    let b1: string = (gen_match_variant_binding p "Opt" "None" "x" "  ")
    assert (== b1 "")
    /* Single positional _0 field — generates C binding */
    assert (== (gen_match_variant_binding p "Opt" "Some" "_" "  ") "")
    let b2: string = (gen_match_variant_binding p "Opt" "Some" "val" "  ")
    assert (str_contains b2 "nl_val")
    /* Unknown union — generates fallback struct binding */
    let b3: string = (gen_match_variant_binding p "NoSuch" "Var" "v" "  ")
    assert (str_contains b3 "nl_v")
}

fn generate_match_stmt(parser: Parser, m: ASTMatch, indent: int, env: GenEnv, return_type: string) -> string {
    return (generate_match_ordered parser m env return_type indent false)
}

shadow generate_match_stmt {
    let source: string = (+ "f" "n main() -> int { let x: Option = 0 match x { Some(y) => y } return 0 }")
    let toks: List<LexerToken> = (tokenize_string source "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let m: ASTMatch = (parser_get_match p 0)
    let env0: GenEnv = (genenv_put (genenv_new "test") "x" "Option" false)
    let code: string = (generate_match_stmt p m 0 env0 "int")
    assert (str_contains code "if (!_matched")
    assert (not (str_contains code "switch"))
}

struct StmtGenResult {
    code: string,
    env: GenEnv
}

/* Extract the source line number from a statement reference.
 * Dispatches on node_type to retrieve .line from the actual AST node.
 * Returns 0 if the node type is unknown or has no line info. */
fn get_stmt_line(parser: Parser, stmt: ASTStmtRef) -> int {
    if (== stmt.node_type ParseNodeType.PNODE_LET) {
        let n: ASTLet = (parser_get_let parser stmt.node_id)
        return n.line
    } else {
    if (== stmt.node_type ParseNodeType.PNODE_SET) {
        let n: ASTSet = (parser_get_set parser stmt.node_id)
        return n.line
    } else {
    if (== stmt.node_type ParseNodeType.PNODE_RETURN) {
        let n: ASTReturn = (parser_get_return parser stmt.node_id)
        return n.line
    } else {
    if (== stmt.node_type ParseNodeType.PNODE_IF) {
        let n: ASTIf = (parser_get_if parser stmt.node_id)
        return n.line
    } else {
    if (== stmt.node_type ParseNodeType.PNODE_WHILE) {
        let n: ASTWhile = (parser_get_while parser stmt.node_id)
        return n.line
    } else {
    if (== stmt.node_type ParseNodeType.PNODE_FOR) {
        let n: ASTFor = (parser_get_for parser stmt.node_id)
        return n.line
    } else {
    if (== stmt.node_type ParseNodeType.PNODE_ASSERT) {
        let n: ASTAssert = (parser_get_assert parser stmt.node_id)
        return n.line
    } else {
    if (== stmt.node_type ParseNodeType.PNODE_MATCH) {
        let n: ASTMatch = (parser_get_match parser stmt.node_id)
        return n.line
    } else {
    if (== stmt.node_type ParseNodeType.PNODE_CALL) {
        let n: ASTCall = (parser_get_call parser stmt.node_id)
        return n.line
    } else {
    if (== stmt.node_type ParseNodeType.PNODE_MODULE_QUALIFIED_CALL) {
        let n: ASTModuleQualifiedCall = (parser_get_module_qualified_call parser stmt.node_id)
        return n.line
    } else {
        return 0
    }
    }
    }
    }
    }
    }
    }
    }
    }
    }
}

shadow get_stmt_line {
    let source: string = (+ "f" "n main() -> int { let x: int = 1 return x }")
    let toks: List<LexerToken> = (tokenize_string source "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt0: ASTStmtRef = (list_ASTStmtRef_get block.statements 0)
    let stmt1: ASTStmtRef = (list_ASTStmtRef_get block.statements 1)
    let line0: int = (get_stmt_line p stmt0)
    let line1: int = (get_stmt_line p stmt1)
    assert (> line0 0)
    assert (> line1 0)
}

fn generate_statement(parser: Parser, stmt: ASTStmtRef, indent: int, env: GenEnv, return_type: string) -> StmtGenResult {
    if (== stmt.node_type ParseNodeType.PNODE_BLOCK) {
        let block: ASTBlock = (parser_get_block parser stmt.node_id)
        if (or block.is_par block.is_flow) {
            let mut code: string = ""
            let mut current: GenEnv = env
            let order: array<int> = (passive_order parser block)
            if (or (== (array_length order) 0) (!= (array_length order) (list_ASTStmtRef_length block.statements))) {
                return StmtGenResult { code: "\n#error I cannot establish my passive execution order\n", env: env }
            }
            let mut i: int = 0
            while (< i (array_length order)) {
                let result: StmtGenResult = (generate_statement parser (list_ASTStmtRef_get block.statements (at order i)) indent current return_type)
                set code (+ code result.code)
                set current result.env
                set i (+ i 1)
            }
            return StmtGenResult { code: code, env: current }
        }
    }
    if (== stmt.node_type ParseNodeType.PNODE_LET) {
        let let_stmt: ASTLet = (parser_get_let parser stmt.node_id)
        let code: string = (generate_let_stmt parser let_stmt indent env)
        let mut env2: GenEnv = (genenv_put env let_stmt.name let_stmt.var_type let_stmt.is_mut)
        if (== let_stmt.name "_") {
            set env2 (genenv_with_underscore env2 (+ "__nl_underscore_" (int_to_string (array_length env.names))))
        }
        return StmtGenResult { code: code, env: env2 }
    } else {
        if (== stmt.node_type ParseNodeType.PNODE_SET) {
            let set_stmt: ASTSet = (parser_get_set parser stmt.node_id)
            let code: string = (generate_set_stmt parser set_stmt indent env)
            return StmtGenResult { code: code, env: env }
        } else {
            if (== stmt.node_type ParseNodeType.PNODE_RETURN) {
                let ret: ASTReturn = (parser_get_return parser stmt.node_id)
                let code: string = (generate_return_stmt parser ret indent env return_type)
                return StmtGenResult { code: code, env: env }
            } else {
                if (== stmt.node_type ParseNodeType.PNODE_IF) {
                    let if_stmt: ASTIf = (parser_get_if parser stmt.node_id)
                    let code: string = (generate_if_stmt parser if_stmt indent env return_type)
                    return StmtGenResult { code: code, env: env }
                } else {
                    if (== stmt.node_type ParseNodeType.PNODE_WHILE) {
                        let while_stmt: ASTWhile = (parser_get_while parser stmt.node_id)
                        let code: string = (generate_while_stmt parser while_stmt indent env return_type)
                        return StmtGenResult { code: code, env: env }
                    } else {
                    if (== stmt.node_type ParseNodeType.PNODE_FOR) {
                        let for_stmt: ASTFor = (parser_get_for parser stmt.node_id)
                        let code: string = (generate_for_stmt parser for_stmt indent env return_type)
                        return StmtGenResult { code: code, env: env }
                    } else {
                        if (== stmt.node_type ParseNodeType.PNODE_ASSERT) {
                            let a: ASTAssert = (parser_get_assert parser stmt.node_id)
                            let code: string = (generate_assert_stmt parser a indent env)
                            return StmtGenResult { code: code, env: env }
                        } else {
                            if (== stmt.node_type ParseNodeType.PNODE_MATCH) {
                                let m: ASTMatch = (parser_get_match parser stmt.node_id)
                                let code: string = (generate_match_stmt parser m indent env return_type)
                                return StmtGenResult { code: code, env: env }
                            } else {
                            if (== stmt.node_type ParseNodeType.PNODE_UNSAFE_BLOCK) {
                                let ub: ASTUnsafeBlock = (parser_get_unsafe_block parser stmt.node_id)
                                let mut ub_parts: array<string> = []
                                set ub_parts (cg_append ub_parts (+ (gen_indent indent) "{\n"))
                                let mut ub_env: GenEnv = (genenv_copy env)
                                let mut ub_i: int = 0
                                let ub_count: int = (list_ASTStmtRef_length ub.statements)
                                while (< ub_i ub_count) {
                                    let ub_stmt: ASTStmtRef = (list_ASTStmtRef_get ub.statements ub_i)
                                    let ub_res: StmtGenResult = (generate_statement parser ub_stmt (+ indent 1) ub_env return_type)
                                    set ub_parts (cg_append ub_parts ub_res.code)
                                    set ub_env ub_res.env
                                    set ub_i (+ ub_i 1)
                                }
                                set ub_parts (cg_append ub_parts (+ (gen_indent indent) "}\n"))
                                return StmtGenResult { code: (cg_build ub_parts), env: env }
                            } else {
                            if (== stmt.node_type ParseNodeType.PNODE_BREAK) {
                                let mut break_parts: array<string> = []
                                set break_parts (cg_append break_parts (gen_indent indent))
                                set break_parts (cg_append break_parts "break;\n")
                                return StmtGenResult { code: (cg_build break_parts), env: env }
                            } else {
                            if (== stmt.node_type ParseNodeType.PNODE_CONTINUE) {
                                let mut cont_parts: array<string> = []
                                set cont_parts (cg_append cont_parts (gen_indent indent))
                                set cont_parts (cg_append cont_parts "continue;\n")
                                return StmtGenResult { code: (cg_build cont_parts), env: env }
                            } else {
                            /* Expression statement (e.g. call) */
                            if (or (== stmt.node_type ParseNodeType.PNODE_CALL) (== stmt.node_type ParseNodeType.PNODE_MODULE_QUALIFIED_CALL)) {
                                let expr_code: string = (generate_expression parser stmt.node_id stmt.node_type env "")
                                let mut parts: array<string> = []
                                set parts (cg_append parts (gen_indent indent))
                                set parts (cg_append parts expr_code)
                                set parts (cg_append parts ";\n")
                                return StmtGenResult { code: (cg_build parts), env: env }
                            } else {
                                let mut parts: array<string> = []
                                set parts (cg_append parts (gen_indent indent))
                                set parts (cg_append parts "/* unsupported stmt: ")
                                set parts (cg_append parts (int_to_string stmt.node_type))
                                set parts (cg_append parts " */\n")
                                return StmtGenResult { code: (cg_build parts), env: env }
                            }
                            }
                            }
                            }
                            }
                        }
                    }
                    }
                }
            }
        }
    }
}

shadow generate_statement {
    let source: string = (+ "f" "n main() -> int { let x: int = 1 return x }")
    let toks: List<LexerToken> = (tokenize_string source "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 0)
    let env: GenEnv = (genenv_new "test")
    let res: StmtGenResult = (generate_statement p stmt 0 env "int")
    assert (str_contains res.code "nl_x")
    assert (== (genenv_get res.env "x") "int")
}

fn generate_block(parser: Parser, block_id: int, indent: int, env: GenEnv, return_type: string) -> string {
    if (< block_id 0) {
        return ""
    } else {
        let block: ASTBlock = (parser_get_block parser block_id)
        let mut parts: array<string> = []
        let mut env_cur: GenEnv = env
        let mut i: int = 0
        let stmt_count: int = (list_ASTStmtRef_length block.statements)
        while (< i stmt_count) {
            let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements i)
            let line_num: int = (get_stmt_line parser stmt)
            if (> line_num 0) {
                let line_dir: string = (str_concat "#line " (str_concat (int_to_string line_num) (str_concat " \"" (str_concat parser.file_name "\"\n"))))
                set parts (cg_append parts line_dir)
            } else { (print "") }
            let res: StmtGenResult = (generate_statement parser stmt indent env_cur return_type)
            set parts (cg_append parts res.code)
            set env_cur res.env
            set i (+ i 1)
        }
        return (cg_build parts)
    }
}

shadow generate_block {
    let source: string = (+ "f" "n main() -> int { let x: int = 1 return x }")
    let toks: List<LexerToken> = (tokenize_string source "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let env: GenEnv = (genenv_new "test")
    let code: string = (generate_block p func.body 0 env "int")
    assert (str_contains code "return")
}

/* Generate C code for a set statement (assignment)
 * 
 * Args:
 *   parser: Parser containing AST nodes
 *   set_stmt: Set statement node
 *   indent: Indentation level
 * 
 * Returns: C code for assignment statement
 */
fn generate_set_stmt(parser: Parser, set_stmt: ASTSet, indent: int, env: GenEnv) -> string {
    let mut parts: array<string> = []
    set parts (cg_append parts (gen_indent indent))

    let target_t: string = (genenv_get env set_stmt.target)
    let c_var: string = (genenv_c_name env set_stmt.target)
    if (!= set_stmt.field_name "") {
        let value: string = (generate_expression parser set_stmt.value set_stmt.value_type env (lookup_struct_field_type parser (str_substring target_t 5 (str_length target_t)) set_stmt.field_name))
        return (+ (gen_indent indent) (+ c_var (+ "->" (+ (mangle_name set_stmt.field_name) (+ " = " (+ value ";\n"))))))
    }

    /* Module-scope mutable primitives use NL_GUARDED_WRITE for thread-safe writes */
    if (and (genenv_get_global env set_stmt.target) (is_guarded_primitive target_t)) {
        let set_expr_code: string = (generate_expression parser set_stmt.value set_stmt.value_type env target_t)
        set parts (cg_append parts "NL_GUARDED_WRITE(")
        set parts (cg_append parts c_var)
        set parts (cg_append parts ", ")
        set parts (cg_append parts set_expr_code)
        set parts (cg_append parts ");\n")
    } else {
        /* Direct assignment for local variables */
        set parts (cg_append parts c_var)
        set parts (cg_append parts " = ")
        let set_expr_code: string = (generate_expression parser set_stmt.value set_stmt.value_type env target_t)
        set parts (cg_append parts set_expr_code)
        set parts (cg_append parts ";\n")
    }
    return (cg_build parts)
}

shadow generate_set_stmt {
    let source: string = (+ "f" "n main() -> int { let mut x: int = 1 set x 2 return x }")
    let toks: List<LexerToken> = (tokenize_string source "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let s: ASTSet = (parser_get_set p 0)
    /* Non-mut local x: expect direct assignment */
    let env: GenEnv = (genenv_put (genenv_new "test") "x" "int" false)
    let code: string = (generate_set_stmt p s 0 env)
    assert (== code "nl_x = 2;\n")
    /* Mut local x: expect same direct assignment */
    let env_mut: GenEnv = (genenv_put (genenv_new "test") "x" "int" true)
    let code_mut: string = (generate_set_stmt p s 0 env_mut)
    assert (== code_mut "nl_x = 2;\n")
    /* Mut global x: expect NL_GUARDED_WRITE */
    let env_global: GenEnv = (genenv_put_global (genenv_new "test") "x" "int" true)
    let code_global: string = (generate_set_stmt p s 0 env_global)
    assert (== code_global "NL_GUARDED_WRITE(nl_x, 2);\n")
}

/* Generate C code for an if statement
 * 
 * Args:
 *   parser: Parser containing AST nodes
 *   if_stmt: If statement node  
 *   indent: Indentation level
 * 
 * Returns: C code for if/else statement
 */
fn generate_if_stmt(parser: Parser, if_stmt: ASTIf, indent: int, env: GenEnv, return_type: string) -> string {
    let mut parts: array<string> = []
    set parts (cg_append parts (gen_indent indent))
    set parts (cg_append parts "if (")
    
    /* Generate condition expression */
    let cond_code: string = (generate_expression parser if_stmt.condition if_stmt.condition_type env "bool")
    set parts (cg_append parts cond_code)
    set parts (cg_append parts ") {\n")

    set parts (cg_append parts (generate_block parser if_stmt.then_body (+ indent 1) env return_type))
    
    set parts (cg_append parts (gen_indent indent))
    set parts (cg_append parts "}")
    
    /* Generate else if present */
    if (< if_stmt.else_body 0) {
        set parts (cg_append parts "\n")
    } else {
        set parts (cg_append parts " else {\n")
        set parts (cg_append parts (generate_block parser if_stmt.else_body (+ indent 1) env return_type))
        set parts (cg_append parts (gen_indent indent))
        set parts (cg_append parts "}\n")
    }
    
    return (cg_build parts)
}

shadow generate_if_stmt {
    let source: string = (+ "f" "n main() -> int { if true { return 1 } else { return 0 } }")
    let toks: List<LexerToken> = (tokenize_string source "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let if_stmt: ASTIf = (parser_get_if p 0)
    let env: GenEnv = (genenv_new "test")
    let code: string = (generate_if_stmt p if_stmt 0 env "int")
    assert (str_contains code "if (1)")
    assert (str_contains code "else")
}

fn generate_for_stmt(parser: Parser, for_stmt: ASTFor, indent: int, env: GenEnv, return_type: string) -> string {
    let mut parts: array<string> = []
    /* Check if iterable is (range start end) call */
    if (== for_stmt.iterable_type ParseNodeType.PNODE_CALL) {
        let call: ASTCall = (parser_get_call parser for_stmt.iterable)
        let mut is_range: bool = false
        if (== call.function_type ParseNodeType.PNODE_IDENTIFIER) {
            let func_id: ASTIdentifier = (parser_get_identifier parser call.function)
            set is_range (and (== func_id.name "range") (== call.arg_count 2))
        } else { (print "") }
        if is_range {
            let start_arg: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
            let end_arg: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
            let start_code: string = (generate_expression parser start_arg.node_id start_arg.node_type env "int")
            let end_code: string = (generate_expression parser end_arg.node_id end_arg.node_type env "int")
            let c_var: string = (+ "nl_" (mangle_name for_stmt.var_name))
            set parts (cg_append parts (gen_indent indent))
            # My source locals carry nl_; these scoped snapshots cannot capture them.
            set parts (cg_append parts "{ int64_t __nl_range_start = ")
            set parts (cg_append parts start_code)
            set parts (cg_append parts "; int64_t __nl_range_end = ")
            set parts (cg_append parts end_code)
            set parts (cg_append parts ";\n")
            set parts (cg_append parts (gen_indent (+ indent 1)))
            set parts (cg_append parts "for (int64_t ")
            set parts (cg_append parts c_var)
            set parts (cg_append parts " = __nl_range_start")
            set parts (cg_append parts "; ")
            set parts (cg_append parts c_var)
            set parts (cg_append parts " < __nl_range_end")
            set parts (cg_append parts "; ")
            set parts (cg_append parts c_var)
            set parts (cg_append parts "++) {\n")
            let body_env: GenEnv = (genenv_put env for_stmt.var_name "int" false)
            set parts (cg_append parts (generate_block parser for_stmt.body (+ indent 2) body_env return_type))
            set parts (cg_append parts (gen_indent indent))
            set parts (cg_append parts "} }\n")
        } else {
            set parts (cg_append parts (gen_indent indent))
            set parts (cg_append parts "/* unsupported for-in call */;\n")
        }
    } else {
        if (== for_stmt.iterable_type ParseNodeType.PNODE_IDENTIFIER) {
            let id: ASTIdentifier = (parser_get_identifier parser for_stmt.iterable)
            let arr_type: string = (genenv_get env id.name)

            /* for x in array_var — dyn_array iteration */
            if (is_array_type arr_type) {
                let elem_type: string = (array_elem_type_from_array_type arr_type)
                let c_elem_type: string = (c_type_from_elem_type elem_type)
                let get_fn: string = (get_fn_from_elem_type elem_type)
                let c_var: string = (+ "nl_" (mangle_name for_stmt.var_name))
                let arr_c_name: string = (genenv_c_name env id.name)
                set parts (cg_append parts (gen_indent indent))
                set parts (cg_append parts "{\n")
                set parts (cg_append parts (gen_indent (+ indent 1)))
                set parts (cg_append parts "int64_t __nl_len = dyn_array_length(")
                set parts (cg_append parts arr_c_name)
                set parts (cg_append parts ");\n")
                set parts (cg_append parts (gen_indent (+ indent 1)))
                set parts (cg_append parts "for (int64_t __nl_idx = 0; __nl_idx < __nl_len; __nl_idx++) {\n")
                set parts (cg_append parts (gen_indent (+ indent 2)))
                if (native_array_exact elem_type) {
                    set parts (cg_append parts (native_array_load_code elem_type arr_c_name "__nl_idx" c_var))
                    set parts (cg_append parts "\n")
                } else {
                set parts (cg_append parts c_elem_type)
                set parts (cg_append parts " ")
                set parts (cg_append parts c_var)
                set parts (cg_append parts " = ")
                set parts (cg_append parts get_fn)
                set parts (cg_append parts "(")
                set parts (cg_append parts arr_c_name)
                set parts (cg_append parts ", __nl_idx);\n")
                }
                let body_env: GenEnv = (genenv_put env for_stmt.var_name elem_type false)
                set parts (cg_append parts (generate_block parser for_stmt.body (+ indent 2) body_env return_type))
                set parts (cg_append parts (gen_indent (+ indent 1)))
                set parts (cg_append parts "}\n")
                set parts (cg_append parts (gen_indent indent))
                set parts (cg_append parts "}\n")
            } else {

            /* for x in list_var — list iteration using typed List_* API */
            let list_type: string = arr_type
            /* Extract element type name from "List<ElemType>" */
            let elem_name: string = (transp_extract_list_element_type list_type)
            let c_var: string = (+ "nl_" (mangle_name for_stmt.var_name))
            let list_c_name: string = (genenv_c_name env id.name)
            set parts (cg_append parts (gen_indent indent))
            set parts (cg_append parts "{\n")
            set parts (cg_append parts (gen_indent (+ indent 1)))
            /* Emit typed list pointer and length */
            if (or (== elem_name "int") (== elem_name "")) {
                set parts (cg_append parts "List_int* __nl_lst = ")
                set parts (cg_append parts list_c_name)
                set parts (cg_append parts ";\n")
                set parts (cg_append parts (gen_indent (+ indent 1)))
                set parts (cg_append parts "int64_t __nl_len = list_int_length(__nl_lst);\n")
                set parts (cg_append parts (gen_indent (+ indent 1)))
                set parts (cg_append parts "for (int64_t __nl_idx = 0; __nl_idx < __nl_len; __nl_idx++) {\n")
                set parts (cg_append parts (gen_indent (+ indent 2)))
                set parts (cg_append parts "int64_t ")
                set parts (cg_append parts c_var)
                set parts (cg_append parts " = list_int_get(__nl_lst, __nl_idx);\n")
            } else {
            if (== elem_name "string") {
                set parts (cg_append parts "List_string* __nl_lst = ")
                set parts (cg_append parts list_c_name)
                set parts (cg_append parts ";\n")
                set parts (cg_append parts (gen_indent (+ indent 1)))
                set parts (cg_append parts "int64_t __nl_len = list_string_length(__nl_lst);\n")
                set parts (cg_append parts (gen_indent (+ indent 1)))
                set parts (cg_append parts "for (int64_t __nl_idx = 0; __nl_idx < __nl_len; __nl_idx++) {\n")
                set parts (cg_append parts (gen_indent (+ indent 2)))
                set parts (cg_append parts "const char* ")
                set parts (cg_append parts c_var)
                set parts (cg_append parts " = list_string_get(__nl_lst, __nl_idx);\n")
            } else {
                /* Struct element type: use List_StructName* API */
                let list_struct_c: string = (+ "List_" (mangle_name elem_name))
                let elem_c_type: string = (+ "nl_" (mangle_name elem_name))
                set parts (cg_append parts list_struct_c)
                set parts (cg_append parts "* __nl_lst = ")
                set parts (cg_append parts list_c_name)
                set parts (cg_append parts ";\n")
                set parts (cg_append parts (gen_indent (+ indent 1)))
                set parts (cg_append parts "int64_t __nl_len = ")
                set parts (cg_append parts list_struct_c)
                set parts (cg_append parts "_length(__nl_lst);\n")
                set parts (cg_append parts (gen_indent (+ indent 1)))
                set parts (cg_append parts "for (int64_t __nl_idx = 0; __nl_idx < __nl_len; __nl_idx++) {\n")
                set parts (cg_append parts (gen_indent (+ indent 2)))
                set parts (cg_append parts elem_c_type)
                set parts (cg_append parts " ")
                set parts (cg_append parts c_var)
                set parts (cg_append parts " = *")
                set parts (cg_append parts list_struct_c)
                set parts (cg_append parts "_get(__nl_lst, __nl_idx);\n")
            }
            }
            let body_env: GenEnv = (genenv_put env for_stmt.var_name elem_name false)
            set parts (cg_append parts (generate_block parser for_stmt.body (+ indent 2) body_env return_type))
            set parts (cg_append parts (gen_indent (+ indent 1)))
            set parts (cg_append parts "}\n")
            set parts (cg_append parts (gen_indent indent))
            set parts (cg_append parts "}\n")
            } /* end else (list iteration) */
        } else {
            set parts (cg_append parts (gen_indent indent))
            set parts (cg_append parts "/* unsupported for-in pattern */;\n")
        }
    }
    return (cg_build parts)
}

shadow generate_for_stmt {
    let source: string = "fn main() -> int { for value in (range 1 3) { assert (> value 0) } return 0 }"
    let tokens: List<LexerToken> = (tokenize_string source "range.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "range.nano")
    let loop: ASTFor = (parser_get_for parser 0)
    let code: string = (generate_for_stmt parser loop 0 (genenv_new "test") "int")
    assert (str_contains code "int64_t __nl_range_start = 1;")
    assert (str_contains code "int64_t __nl_range_end = 3;")
    assert (str_contains code "nl_value < __nl_range_end")
}

/* Generate C code for a while loop
 *
 * Args:
 *   parser: Parser containing AST nodes
 *   while_stmt: While statement node
 *   indent: Indentation level
 *
 * Returns: C code for while loop
 */
fn generate_while_stmt(parser: Parser, while_stmt: ASTWhile, indent: int, env: GenEnv, return_type: string) -> string {
    let mut parts: array<string> = []
    set parts (cg_append parts (gen_indent indent))
    set parts (cg_append parts "while (")
    
    /* Generate condition expression */
    let cond_code: string = (generate_expression parser while_stmt.condition while_stmt.condition_type env "bool")
    set parts (cg_append parts cond_code)
    set parts (cg_append parts ") {\n")

    set parts (cg_append parts (generate_block parser while_stmt.body (+ indent 1) env return_type))
    
    set parts (cg_append parts (gen_indent indent))
    set parts (cg_append parts "}\n")
    
    return (cg_build parts)
}

shadow generate_while_stmt {
    let source: string = (+ "f" "n main() -> int { while true { return 1 } return 0 }")
    let toks: List<LexerToken> = (tokenize_string source "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let w: ASTWhile = (parser_get_while p 0)
    let env: GenEnv = (genenv_new "test")
    let code: string = (generate_while_stmt p w 0 env "int")
    assert (str_contains code "while (1)")
}

/* Returns true if a ParseNodeType integer represents a value-producing expression */
fn is_expr_pnode(node_type: int) -> bool {
    if (== node_type ParseNodeType.PNODE_NUMBER) { return true } else { (print "") }
    if (== node_type ParseNodeType.PNODE_FLOAT) { return true } else { (print "") }
    if (== node_type ParseNodeType.PNODE_STRING) { return true } else { (print "") }
    if (== node_type ParseNodeType.PNODE_BOOL) { return true } else { (print "") }
    if (== node_type ParseNodeType.PNODE_IDENTIFIER) { return true } else { (print "") }
    if (== node_type ParseNodeType.PNODE_BINARY_OP) { return true } else { (print "") }
    if (== node_type ParseNodeType.PNODE_CALL) { return true } else { (print "") }
    if (== node_type ParseNodeType.PNODE_MODULE_QUALIFIED_CALL) { return true } else { (print "") }
    if (== node_type ParseNodeType.PNODE_ARRAY_LITERAL) { return true } else { (print "") }
    if (== node_type ParseNodeType.PNODE_COND) { return true } else { (print "") }
    if (== node_type ParseNodeType.PNODE_STRUCT_LITERAL) { return true } else { (print "") }
    if (== node_type ParseNodeType.PNODE_FIELD_ACCESS) { return true } else { (print "") }
    if (== node_type ParseNodeType.PNODE_UNION_CONSTRUCT) { return true } else { (print "") }
    /* PNODE_MATCH excluded: match arm bodies need the full TypeChecker context for
     * proper return-statement type checking; wrapping match in implicit return breaks this. */
    if (== node_type ParseNodeType.PNODE_TUPLE_LITERAL) { return true } else { (print "") }
    if (== node_type ParseNodeType.PNODE_TUPLE_INDEX) { return true } else { (print "") }
    return false
}

shadow is_expr_pnode {
    assert (is_expr_pnode ParseNodeType.PNODE_CALL)
    assert (is_expr_pnode ParseNodeType.PNODE_NUMBER)
    assert (not (is_expr_pnode ParseNodeType.PNODE_LET))
    assert (not (is_expr_pnode ParseNodeType.PNODE_RETURN))
    assert (not (is_expr_pnode ParseNodeType.PNODE_IF))
}

/* Generate a block treating the last statement as an implicit return when appropriate.
 * Handles: bare expressions, tail-position if/else with both branches present.
 * Recurses into if/else branches for nested tail positions.
 */
fn generate_block_tail_return(parser: Parser, block_id: int, indent: int, env: GenEnv, return_type: string) -> string {
    if (< block_id 0) {
        return ""
    } else {
        let block: ASTBlock = (parser_get_block parser block_id)
        let stmt_count: int = (list_ASTStmtRef_length block.statements)
        if (<= stmt_count 0) {
            return ""
        } else {
            let last_stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements (- stmt_count 1))
            /* If last stmt already has an explicit return, generate block normally */
            if (== last_stmt.node_type ParseNodeType.PNODE_RETURN) {
                return (generate_block parser block_id indent env return_type)
            } else {
                /* Generate all statements before the last one */
                let mut parts: array<string> = []
                let mut env_cur: GenEnv = env
                let mut i: int = 0
                while (< i (- stmt_count 1)) {
                    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements i)
                    let res: StmtGenResult = (generate_statement parser stmt indent env_cur return_type)
                    set parts (cg_append parts res.code)
                    set env_cur res.env
                    set i (+ i 1)
                }
                /* Case: last stmt is a value-producing expression → implicit return */
                if (is_expr_pnode last_stmt.node_type) {
                    let expr_code: string = (generate_expression parser last_stmt.node_id last_stmt.node_type env_cur return_type)
                    set parts (cg_append parts (gen_indent indent))
                    set parts (cg_append parts "return ")
                    set parts (cg_append parts expr_code)
                    set parts (cg_append parts ";\n")
                    return (cg_build parts)
                } else {
                    /* Case: last stmt is if/else with both branches present → recurse */
                    if (== last_stmt.node_type ParseNodeType.PNODE_IF) {
                        let if_s: ASTIf = (parser_get_if parser last_stmt.node_id)
                        if (>= if_s.else_body 0) {
                            set parts (cg_append parts (gen_indent indent))
                            set parts (cg_append parts "if (")
                            let cond_code: string = (generate_expression parser if_s.condition if_s.condition_type env_cur "bool")
                            set parts (cg_append parts cond_code)
                            set parts (cg_append parts ") {\n")
                            set parts (cg_append parts (generate_block_tail_return parser if_s.then_body (+ indent 1) env_cur return_type))
                            set parts (cg_append parts (gen_indent indent))
                            set parts (cg_append parts "} else {\n")
                            set parts (cg_append parts (generate_block_tail_return parser if_s.else_body (+ indent 1) env_cur return_type))
                            set parts (cg_append parts (gen_indent indent))
                            set parts (cg_append parts "}\n")
                            return (cg_build parts)
                        } else {
                            /* if without else - cannot be implicit return, generate normally */
                            let res: StmtGenResult = (generate_statement parser last_stmt indent env_cur return_type)
                            set parts (cg_append parts res.code)
                            return (cg_build parts)
                        }
                    } else {
                        /* Other statement types: generate normally, no implicit return */
                        let res: StmtGenResult = (generate_statement parser last_stmt indent env_cur return_type)
                        set parts (cg_append parts res.code)
                        return (cg_build parts)
                    }
                }
            }
        }
    }
}

shadow generate_block_tail_return {
    /* Test: expression tail return */
    let src: string = (+ "f" "n f(x: int) -> int { (* x 2) }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let env: GenEnv = (genenv_put (genenv_new "test") "x" "int" false)
    let code: string = (generate_block_tail_return p func.body 1 env "int")
    assert (str_contains code "return")
}

fn generate_function_body(parser: Parser, body_id: int, env: GenEnv, return_type: string) -> string {
    /* For void functions or missing body, no implicit return needed */
    if (or (== return_type "") (== return_type "void")) {
        return (generate_block parser body_id 1 env return_type)
    } else {
        return (generate_block_tail_return parser body_id 1 env return_type)
    }
}

