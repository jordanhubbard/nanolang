    assert (not (native_array_exact "int"))
    assert (not (native_array_exact "array<int>"))
    let saved: bool = native_array_derived_required
    assert (native_array_exact "(int, bool)")
    assert (native_array_exact "fn(int) -> int")
    assert native_array_derived_required
    set native_array_derived_required saved
}
# I collect complete array leaf aliases even when no element expression exists.
fn native_collect_array_type(annotation: string) -> bool {
    if (not (is_array_type annotation)) { return false }
    let mut element: string = annotation
    let mut depth: int = 0
    while (is_array_type element) {
        if (>= depth 128) {
            (reduce_emission_fail "I cannot collect this deeply nested array annotation.")
            return false
        }
        set element (full_array_element_type element)
        set depth (+ depth 1)
    }
    if (not (native_array_exact element)) { return false }
    (type_to_c element)
    return true
}
