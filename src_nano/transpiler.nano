    let saved: bool = native_array_derived_required
    let tuples: array<string> = native_tuple_annotations
    set native_tuple_annotations []
    assert (native_collect_array_type "array<array<(int,bool)>>")
    assert (== (array_length native_tuple_annotations) 1)
    assert (not (native_collect_array_type "array<int>"))
    set native_tuple_annotations tuples
    set native_array_derived_required saved
}

fn native_array_shape_code(element: string, array_name: string) -> string {
    let width: string = (+ "sizeof(" (+ (type_to_c element) ")"))
    return (+ "assert(" (+ array_name (+ "->elem_type == ELEM_STRUCT); assert(" (+ array_name (+ "->elem_size == " (+ width (+ " || (" (+ array_name (+ "->elem_size == 0 && " (+ array_name (+ "->length == 0 && " (+ array_name "->data == NULL)); "))))))))))))
}
shadow native_array_shape_code {
    let code: string = (native_array_shape_code "int" "carrier")
    assert (str_contains code "carrier->elem_size == sizeof(int64_t)")
    assert (str_contains code "carrier->length == 0 && carrier->data == NULL")
}
fn native_array_load_code(element: string, array_name: string, index_name: string, value_name: string) -> string {
    let ctype: string = (c_type_from_elem_type element)
    if (native_array_exact element) {
        let mut code: string = (native_array_shape_code element array_name)
        set code (+ code (+ ctype (+ " " (+ value_name " = ({ const void* _oa_slot = dyn_array_get_struct("))))
        set code (+ code (+ array_name (+ ", " (+ index_name "); "))))
        set code (+ code "if (_oa_slot == NULL) { fputs(\"I cannot load an absent array element\\n\", stderr); abort(); } ")
        set code (+ code (+ ctype " _oa_loaded; memcpy(&_oa_loaded, _oa_slot, sizeof(_oa_loaded)); _oa_loaded; }); "))
        return code
    }
    let access: string = (+ (get_fn_from_elem_type element) (+ "(" (+ array_name (+ ", " (+ index_name ")")))))
    if (type_is_struct element) {
        return (+ ctype (+ " " (+ value_name (+ " = *((" (+ ctype (+ "*)(intptr_t)" (+ access "); ")))))))
    }
    return (+ ctype (+ " " (+ value_name (+ " = " (+ access "; ")))))
}
shadow native_array_load_code {
    assert (== (native_array_load_code "int" "xs" "i" "value") "int64_t value = dyn_array_get_int(xs, i); ")
    assert (str_contains (native_array_load_code "Point" "xs" "i" "value") "*((nl_Point*)(intptr_t)dyn_array_get_int(xs, i))")
}
fn native_array_push_code(element: string, array_name: string, value_name: string) -> string {
    if (native_array_exact element) {
        return (+ "dyn_array_push_struct(" (+ array_name (+ ", &" (+ value_name (+ ", sizeof(" (+ value_name ")); "))))))
    }
    let mut value: string = value_name
    if (type_is_struct element) { set value (box_struct_expr element value_name) }
    return (+ (push_fn_from_elem_type element) (+ "(" (+ array_name (+ ", " (+ value "); ")))))
}
