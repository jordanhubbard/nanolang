    (reset_module_aliases)
    let r: int = (add_module_alias "io" "std_io")
    assert (== r 0)
    assert (== (array_length module_aliases) 1)
    (reset_module_aliases)
}

fn add_func_alias(alias: string, target: string) -> int {
    set func_aliases (array_push func_aliases alias)
    set func_alias_targets (array_push func_alias_targets target)
    return 0
}

shadow add_func_alias {
    (reset_func_aliases)
    let r: int = (add_func_alias "greet" "hello_mod.greet")
    assert (== r 0)
    assert (== (array_length func_aliases) 1)
    (reset_func_aliases)
}

fn resolve_module_alias(name: string) -> string {
    let mut i: int = 0
    let n: int = (array_length module_aliases)
    while (< i n) {
        if (== (at module_aliases i) name) {
            return (at module_alias_targets i)
        } else { (print "") }
        set i (+ i 1)
    }
    return name
}

shadow resolve_module_alias {
    (reset_module_aliases)
    (add_module_alias "io" "std/io")
    assert (== (resolve_module_alias "io") "std/io")
    assert (== (resolve_module_alias "unknown") "unknown")
}

fn resolve_func_alias(name: string) -> string {
    let mut i: int = 0
    let n: int = (array_length func_aliases)
    while (< i n) {
        if (== (at func_aliases i) name) {
            return (at func_alias_targets i)
        } else { (print "") }
        set i (+ i 1)
    }
    return ""
}

shadow resolve_func_alias {
    (reset_func_aliases)
    (add_func_alias "f" "module::func")
    assert (== (resolve_func_alias "f") "module::func")
    assert (== (resolve_func_alias "unknown") "")
}

fn reset_fn_types() -> int {
    set fn_type_originals []
    set fn_type_names []
    return 0
}

shadow reset_fn_types {
    (reset_fn_types)
    assert (== (array_length fn_type_originals) 0)
    assert (== (array_length fn_type_names) 0)
}

fn is_fn_type(t: string) -> bool {
    return (transp_str_starts_with t "fn(")
}

fn register_fn_type(t: string) -> string {
    /* Check if already registered */
    let semantic_key: string = (native_annotation_key t false)
    let mut i: int = 0
    let n: int = (array_length fn_type_originals)
    while (< i n) {
        if (== (at fn_type_originals i) t) { return (at fn_type_names i) }
        if (== (native_annotation_key (at fn_type_originals i) false) semantic_key) {
            return (at fn_type_names i)
        } else { (print "") }
        set i (+ i 1)
    }
    # I define nested function-pointer dependencies before their users.
    let params: array<string> = (parse_fn_type_params t)
    let mut param_index: int = 0
    while (< param_index (array_length params)) {
        let param: string = (at params param_index)
        if (is_fn_type param) { (register_fn_type param) }
        set param_index (+ param_index 1)
    }
    let result: string = (parse_fn_type_return t)
    if (is_fn_type result) { (register_fn_type result) }
    /* Register new function type */
    let idx: int = (array_length fn_type_originals)
    let mut name_parts: array<string> = []
    set name_parts (cg_append name_parts "nl_FnPtr_")
    set name_parts (cg_append name_parts (int_to_string idx))
    let mut name: string = (cg_build name_parts)
    let opaque_key: string = (native_opaque_key t)
    if (!= opaque_key "") { set name (native_opaque_name opaque_key) }
    set fn_type_originals (array_push fn_type_originals t)
    set fn_type_names (array_push fn_type_names name)
    return name
}

shadow register_fn_type {
    (reset_fn_types)
    let name1: string = (register_fn_type "fn(int)->int")
    assert (== name1 "nl_FnPtr_0")
    let name2: string = (register_fn_type "fn(int)->int")
    assert (== name2 "nl_FnPtr_0")
    let name3: string = (register_fn_type "fn(string)->bool")
    assert (== name3 "nl_FnPtr_1")
    (reset_fn_types)
}

fn parse_fn_type_params(t: string) -> array<string> {
    /* Parse fn(int,int)->int to get parameter types */
    /* Opening paren is at index 2, scan from index 3 for closing paren */
    let len: int = (str_length t)
    let mut depth: int = 0
    let mut close: int = -1
    let mut i: int = 3
    while (< i len) {
        let ch: string = (str_substring t i 1)
        if (== ch "(") {
            set depth (+ depth 1)
        } else {
        if (== ch ")") {
            if (== depth 0) {
                set close i
                set i len
            } else {
                set depth (- depth 1)
            }
        } else { (print "") }
        }
        set i (+ i 1)
    }
    if (< close 0) {
        let empty: array<string> = []
        return empty
    } else { (print "") }
    let params_str: string = (str_substring t 3 (- close 3))
    if (== (str_length params_str) 0) {
        let empty: array<string> = []
        return empty
    } else { (print "") }
    /* Split by comma (simple - no nested generics for now) */
    let mut result: array<string> = []
    let mut start: int = 0
    let plen: int = (str_length params_str)
    set i 0
    set depth 0
    while (< i plen) {
        let ch: string = (str_substring params_str i 1)
        if (and (> i 0) (and (== ch ">") (== (str_substring params_str (- i 1) 1) "-"))) {
            set i (+ i 1)
            continue
        }
        if (or (== ch "(") (== ch "<")) {
            set depth (+ depth 1)
        } else {
        if (or (== ch ")") (== ch ">")) {
            set depth (- depth 1)
        } else {
        if (and (== ch ",") (== depth 0)) {
            let param: string = (str_substring params_str start (- i start))
            set result (array_push result (str_trim param))
            set start (+ i 1)
        } else { (print "") }
        } }
        set i (+ i 1)
    }
    if (< start plen) {
        let param: string = (str_substring params_str start (- plen start))
        set result (array_push result (str_trim param))
    } else { (print "") }
    return result
}

shadow parse_fn_type_params {
    let params1: array<string> = (parse_fn_type_params "fn(int,string)->bool")
    assert (== (array_length params1) 2)
    assert (== (at params1 0) "int")
    assert (== (at params1 1) "string")
    let params2: array<string> = (parse_fn_type_params "fn()->void")
    assert (== (array_length params2) 0)
    let nested: array<string> = (parse_fn_type_params "fn(fn(int)->int,string)->bool")
    assert (== (array_length nested) 2)
    assert (== (at nested 0) "fn(int)->int")
    assert (== (at nested 1) "string")
}

fn parse_fn_type_return(t: string) -> string {
    /* Parse fn(...)->RetType to get return type */
    let len: int = (str_length t)
    let mut i: int = 3
    let mut depth: int = 0
    let mut close: int = -1
    while (< i len) {
        let ch: string = (str_substring t i 1)
        if (== ch "(") {
            set depth (+ depth 1)
        } else {
        if (== ch ")") {
            if (== depth 0) {
                set close i
                set i len
            } else {
                set depth (- depth 1)
            }
        } else { (print "") }
        }
        set i (+ i 1)
    }
    if (< close 0) {
        return "void"
    } else { (print "") }
    /* After close paren, expect "->RetType" or " -> RetType" */
    let after: string = (str_substring t (+ close 1) (- len (+ close 1)))
    /* Find "->" */
    let alen: int = (str_length after)
    set i 0
    while (< i (- alen 1)) {
        let ch: string = (str_substring after i 1)
        let ch2: string = (str_substring after (+ i 1) 1)
        if (and (== ch "-") (== ch2 ">")) {
            /* Return type starts after "->" possibly with spaces */
            let mut rstart: int = (+ i 2)
            while (< rstart alen) {
                let rch: string = (str_substring after rstart 1)
                if (== rch " ") {
                    set rstart (+ rstart 1)
                } else {
                    set i alen
                    let ret: string = (str_substring after rstart (- alen rstart))
                    return (str_trim ret)
                }
            }
        } else { (print "") }
        set i (+ i 1)
    }
    return "void"
}

shadow parse_fn_type_return {
    assert (== (parse_fn_type_return "fn(int,int)->int") "int")
    assert (== (parse_fn_type_return "fn()->string") "string")
    assert (== (parse_fn_type_return "fn()->void") "void")
}

fn native_fn_typedef(t: string, name: string) -> string {
    let params: array<string> = (parse_fn_type_params t)
    let mut out: string = (+ "typedef " (+ (type_to_c (parse_fn_type_return t)) (+ " (*" (+ name ")("))))
    let mut i: int = 0
    while (< i (array_length params)) {
        if (> i 0) { set out (+ out ", ") }
        set out (+ out (type_to_c (at params i)))
        set i (+ i 1)
    }
    if (== i 0) { set out (+ out "void") }
    return (+ out ");\n")
}
shadow native_fn_typedef {
    assert (== (native_fn_typedef "fn(int)->bool" "Callback") "typedef bool (*Callback)(int64_t);\n")
}

fn generate_fn_type_typedefs() -> string {
    let mut out: string = ""
    let mut i: int = 0
    while (< i (array_length fn_type_originals)) {
        let name: string = (at fn_type_names i)
        if (not (native_name_in native_derived_emitted_names name)) {
            set out (+ out (native_fn_typedef (at fn_type_originals i) name))
        }
        set i (+ i 1)
    }
    if (== out "") { return "" }
    return (+ "/* Function pointer typedefs */\n" (+ out "\n"))
}

shadow generate_fn_type_typedefs {
    (reset_fn_types)
    let empty: string = (generate_fn_type_typedefs)
    assert (== empty "")
    (register_fn_type "fn(int)->int")
    let result: string = (generate_fn_type_typedefs)
    assert (> (str_length result) 0)
    (reset_fn_types)
    (register_fn_type "fn(fn(int)->int,int)->int")
    let nested: string = (generate_fn_type_typedefs)
    assert (str_contains nested "typedef int64_t (*nl_FnPtr_0)(int64_t);")
    assert (str_contains nested "typedef int64_t (*nl_FnPtr_1)(nl_FnPtr_0, int64_t);")
    (reset_fn_types)
}

shadow is_fn_type {
    assert (is_fn_type "fn(int,int)->int")
    assert (is_fn_type "fn()->void")
    assert (not (is_fn_type "int"))
    assert (not (is_fn_type "string"))
}

fn codegen_new() -> CodeGenState {
    return CodeGenState {
        indent_level: 0,
        temp_var_counter: 0,
        has_error: false
    }
}

shadow codegen_new {
    let state: CodeGenState = (codegen_new)
    assert (== state.indent_level 0)
}

/* =============================================================================
 * CODE GENERATION HELPERS
 * ============================================================================= */

/* Generate indentation */
fn gen_indent(level: int) -> string {
    if (<= level 0) {
        return ""
    } else {
        return (+ "    " (gen_indent (- level 1)))
    }
}

shadow gen_indent {
    assert (== (gen_indent 0) "")
    assert (== (gen_indent 1) "    ")
}

/* =============================================================================
 * STRINGBUILDER - O(n) string accumulation instead of O(n²) concatenation
 * ============================================================================= */

/* StringBuilder: Array-based string accumulator for O(n) performance
 * Instead of: set result (+ result "text")  // O(n²) - copies entire string each time
 * Use: set parts (cg_append parts "text")    // Preserve the returned array
 */
fn cg_append(parts: array<string>, text: string) -> array<string> {
    return (array_push parts text)
}

fn cg_build(parts: array<string>) -> string {
    let count: int = (array_length parts)
    if (== count 0) {
        return ""
    } else {
        if (== count 1) {
            return (at parts 0)
        } else {
            let mut current: array<string> = parts
            while (> (array_length current) 1) {
                let mut next: array<string> = []
                let mut i: int = 0
                let n: int = (array_length current)
                while (< i n) {
                    if (< (+ i 1) n) {
                        let left: string = (at current i)
                        let right: string = (at current (+ i 1))
                        set next (array_push next (+ left right))
                    } else {
                        set next (array_push next (at current i))
                    }
                    set i (+ i 2)
                }
                set current next
            }
            return (at current 0)
        }
    }
}

shadow cg_append {
    let mut parts: array<string> = []
    set parts (cg_append parts "hello")
    set parts (cg_append parts " ")
    set parts (cg_append parts "world")
    assert (== (array_length parts) 3)
    assert (== (at parts 0) "hello")
    assert (== (at parts 1) " ")
    assert (== (at parts 2) "world")
}

shadow cg_build {
    let mut parts: array<string> = []
    set parts (cg_append parts "hello")
    set parts (cg_append parts " ")
    set parts (cg_append parts "world")
    let result: string = (cg_build parts)
    assert (== result "hello world")
}

/* Generate a fresh temporary variable name */
fn gen_temp_var(state: CodeGenState) -> string {
    let counter_str: string = (int_to_string state.temp_var_counter)
    return (+ "_t" counter_str)
}

shadow gen_temp_var {
    let state: CodeGenState = (codegen_new)
    let name: string = (gen_temp_var state)
    assert (== name "_t0")
}

/* Increment temp counter */
fn codegen_next_temp(state: CodeGenState) -> CodeGenState {
    return CodeGenState {
        indent_level: state.indent_level,
        temp_var_counter: (+ state.temp_var_counter 1),
        has_error: state.has_error
    }
}

shadow codegen_next_temp {
    let state: CodeGenState = (codegen_new)
    let state2: CodeGenState = (codegen_next_temp state)
    assert (== state2.temp_var_counter 1)
}

/* Mangle qualified names (e.g. "std::math::sin") into valid C identifiers.
 * Replaces separators like "::" and "." with "_".
 */
fn mangle_name(name: string) -> string {
    let mut out: string = ""
    let len: int = (str_length name)
    let mut i: int = 0

    while (< i len) {
        let ch: string = (str_substring name i 1)

        if (and (== ch ":") (< (+ i 1) len)) {
            let ch2: string = (str_substring name (+ i 1) 1)
            if (== ch2 ":") {
                set out (+ out "_")
                set i (+ i 2)
            } else {
                set out (+ out "_")
                set i (+ i 1)
            }
        } else {
            if (or (or (== ch ".") (== ch "<"))
                    (or (== ch ">") (== ch ","))) {
                set out (+ out "_")
            } else {
                set out (+ out ch)
            }
            set i (+ i 1)
        }
    }

    return out
}

shadow mangle_name {
    assert (== (mangle_name "std::math::sin") "std_math_sin")
}

/* String utility functions for transpiler */
fn transp_str_starts_with(s: string, prefix: string) -> bool {
    let ls: int = (str_length s)
    let lp: int = (str_length prefix)
    if (< ls lp) {
        return false
    } else {
        let mut i: int = 0
        while (< i lp) {
            if (!= (char_at s i) (char_at prefix i)) {
                return false
            } else { (print "") }
            set i (+ i 1)
        }
        return true
    }
}

shadow transp_str_starts_with {
    assert (transp_str_starts_with "array<int>" "array")
    assert (not (transp_str_starts_with "int" "array"))
}

fn transp_str_index_of(s: string, ch: string) -> int {
    let len: int = (str_length s)
    let needle_length: int = (str_length ch)
    let mut i: int = 0
    
    while (<= i (- len needle_length)) {
        let char_at: string = (str_substring s i needle_length)
        if (== char_at ch) {
            return i
        } else {
            (print "")
        }
        set i (+ i 1)
    }
    
    return -1
}

shadow transp_str_index_of {
    assert (== (transp_str_index_of "array<int>" "<") 5)
    assert (== (transp_str_index_of "test" "e") 1)
    assert (== (transp_str_index_of "test" "z") -1)
    assert (== (transp_str_index_of "array<Point>" "array<") 0)
    assert (== (transp_str_index_of "ababa" "aba") 0)
    assert (== (transp_str_index_of "a" "ab") -1)
    assert (== (transp_str_index_of "" "") 0)
}

fn transp_extract_list_element_type(s: string) -> string {
    /* "List<Point>" -> "Point" */
    let start: int = (+ (transp_str_index_of s "<") 1)
    let end: int = (transp_str_index_of s ">")
    if (and (> start 0) (> end start)) {
        return (str_substring s start (- end start))
    } else {
        return ""
    }
}

shadow transp_extract_list_element_type {
    assert (== (transp_extract_list_element_type "List<Point>") "Point")
    assert (== (transp_extract_list_element_type "List<int>") "int")
    assert (== (transp_extract_list_element_type "invalid") "")
}

/* Check if a type string is a generic type (contains '<') */
fn is_generic_type(type_str: string) -> bool {
    return (str_contains type_str "<")
}

shadow is_generic_type {
    assert (is_generic_type "Result<int,string>")
    assert (not (is_generic_type "int"))
    assert (is_generic_type "List<Point>")
}

/* Extract base type name from a generic type string */
fn extract_base_type_name(type_str: string) -> string {
    let idx: int = (transp_str_index_of type_str "<")
    if (< idx 0) {
        return type_str
    } else {
        return (str_substring type_str 0 idx)
    }
}

shadow extract_base_type_name {
    assert (== (extract_base_type_name "Result<int,string>") "Result")
    assert (== (extract_base_type_name "List<Point>") "List")
    assert (== (extract_base_type_name "int") "int")
}

/* Extract type arguments from a generic type string */
fn extract_type_args(type_str: string) -> array<string> {
    let lt: int = (transp_str_index_of type_str "<")
    if (< lt 0) {
        return []
    } else {
        let len: int = (str_length type_str)
        /* inner = everything between < and > */
        let inner: string = (str_substring type_str (+ lt 1) (- (- len lt) 2))
        let inner_len: int = (str_length inner)
        let mut args: array<string> = []
        let mut cur: string = ""
        let mut i: int = 0
        let mut depth: int = 0
        let mut parentheses: int = 0
        while (< i inner_len) {
            let ch: string = (str_substring inner i 1)
            if (== ch "(") { set parentheses (+ parentheses 1) }
            if (== ch ")") { set parentheses (- parentheses 1) }
            let mut arrow_end: bool = false
            if (> i 0) { set arrow_end (== (str_substring inner (- i 1) 1) "-") }
            if (== ch "<") {
                set depth (+ depth 1)
                set cur (+ cur ch)
            } else {
                if (and (== ch ">") (not arrow_end)) {
                    set depth (- depth 1)
                    set cur (+ cur ch)
                } else {
                    if (and (== ch ",") (and (== depth 0) (== parentheses 0))) {
                        /* Trim leading spaces from cur */
                        let mut trimmed: string = cur
                        while (and (> (str_length trimmed) 0) (== (str_substring trimmed 0 1) " ")) {
                            set trimmed (str_substring trimmed 1 (- (str_length trimmed) 1))
                        }
                        set args (array_push args trimmed)
                        set cur ""
                    } else {
                        set cur (+ cur ch)
                    }
                }
            }
            set i (+ i 1)
        }
        /* Push last arg */
        let mut trimmed_last: string = cur
        while (and (> (str_length trimmed_last) 0) (== (str_substring trimmed_last 0 1) " ")) {
            set trimmed_last (str_substring trimmed_last 1 (- (str_length trimmed_last) 1))
        }
        if (> (str_length trimmed_last) 0) {
            set args (array_push args trimmed_last)
        } else { (print "") }
        return args
    }
}

shadow extract_type_args {
    let args1: array<string> = (extract_type_args "Result<int,string>")
    assert (== (array_length args1) 2)
    assert (== (at args1 0) "int")
    assert (== (at args1 1) "string")
    let args2: array<string> = (extract_type_args "List<Point>")
    assert (== (array_length args2) 1)
    assert (== (at args2 0) "Point")
    let nested: array<string> = (extract_type_args "Box<(int,string),fn(int,string)->Option<int>>")
    assert (== (array_length nested) 2)
    assert (== (at nested 0) "(int,string)")
    assert (== (at nested 1) "fn(int,string)->Option<int>")
}

# I frame the actual annotation token stream, including all punctuation and
# declaration identities. I do not flatten argument boundaries into underscores.
let mut native_opaque_keys: array<string> = []
let mut native_opaque_names: array<string> = []

fn native_annotation_key(annotation: string, require_opaque: bool) -> string {
    if (and require_opaque (not (mb_active))) { return "" }
    let tokens: List<LexerToken> = (tokenize_string annotation "<native-type>" (list_CompilerDiagnostic_new))
    let mut key: string = "type:"
    let mut found: bool = false
    let mut i: int = 0
    while (< i (list_LexerToken_length tokens)) {
        let token: LexerToken = (list_LexerToken_get tokens i)
        if (!= token.token_type LexerTokenType.TOKEN_EOF) {
            let original: string = (nb_opaque_original token.value)
            if (!= original "") {
                let origin: string = (nb_opaque_origin token.value)
                set key (+ key (+ "O" (+ (int_to_string (str_length origin)) (+ ":" origin))))
                set key (+ key (+ (int_to_string (str_length original)) (+ ":" original)))
                set found true
            } else {
                set key (+ key (+ "T" (+ (int_to_string token.token_type) ":")))
                set key (+ key (+ (int_to_string (str_length token.value)) (+ ":" token.value)))
            }
        }
        set i (+ i 1)
    }
    if (or found (not require_opaque)) { return key }
    return ""
}
shadow native_annotation_key {
    assert (== (native_annotation_key "(int,fn(int)->bool)" false) (native_annotation_key "( int , fn( int ) -> bool )" false))
    assert (!= (native_annotation_key "(int,bool)" false) (native_annotation_key "(bool,int)" false))
}
fn native_opaque_key(annotation: string) -> string {
    return (native_annotation_key annotation true)
}

shadow native_opaque_key {
    (mb_reset [1])
    (mb_set_sources ["/native-opaque.nano"])
    let tokens: List<LexerToken> = (tokenize_string "opaque type Handle" "native-opaque.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "native-opaque.nano")
    assert (nb_register parser "__native_test_")
    let opaque_annotation: string = (nb_type "Handle" 1)
    let first: string = (native_opaque_key (+ "Box<A_B,C," (+ opaque_annotation ">")))
    let second: string = (native_opaque_key (+ "Box<A,B_C," (+ opaque_annotation ">")))
    assert (!= first "")
    assert (!= first second)
    assert (== first (native_opaque_key (+ "Box< A_B, C, " (+ opaque_annotation " >"))))
    assert (!= (native_opaque_key (+ "Outer<Box<" (+ opaque_annotation ">>"))) "")
    assert (== (native_opaque_key "Box<int,string>") "")
    (mb_reset [])
}

fn native_opaque_name(key: string) -> string {
    let mut i: int = 0
    while (< i (array_length native_opaque_keys)) {
        if (== key (at native_opaque_keys i)) { return (at native_opaque_names i) }
        set i (+ i 1)
    }
    let name: string = (+ (nb_emission_prefix) (+ "opaque_type_" (int_to_string i)))
    set native_opaque_keys (array_push native_opaque_keys key)
    set native_opaque_names (array_push native_opaque_names name)
    return name
}
shadow native_opaque_name {
    set native_opaque_keys []
    set native_opaque_names []
    let first: string = (native_opaque_name "first")
    assert (== first (native_opaque_name "first"))
    assert (!= first (native_opaque_name "second"))
    set native_opaque_keys []
    set native_opaque_names []
}

/* Convert a generic type string to a monomorphized name.
 * "Result<int,string>" -> "Result_int_string"
 */
fn monomorphize_type_name(type_str: string) -> string {
    let opaque_key: string = (native_opaque_key type_str)
    if (!= opaque_key "") { return (native_opaque_name opaque_key) }
    let base: string = (extract_base_type_name type_str)
    let args: array<string> = (extract_type_args type_str)
    let mut result: string = base
    let mut i: int = 0
    let n: int = (array_length args)
    while (< i n) {
        set result (+ result "_")
        let arg: string = (at args i)
        /* Recursively monomorphize nested generic args */
        if (str_contains arg "<") {
            set result (+ result (monomorphize_type_name arg))
        } else {
            set result (+ result arg)
        }
        set i (+ i 1)
    }
    return result
}

shadow monomorphize_type_name {
    assert (== (monomorphize_type_name "Result<int,string>") "Result_int_string")
    assert (== (monomorphize_type_name "List<Point>") "List_Point")
    assert (== (monomorphize_type_name "Option<int>") "Option_int")
}

fn hashset_new_string() -> HashMap<string, int> {
    let s: HashMap<string, int> = (map_new)
    return s
}

shadow hashset_new_string {
    let s: HashMap<string, int> = (hashset_new_string)
    assert (not (hashset_has_string s "test"))
    (map_put s "test" 1)
    assert (hashset_has_string s "test")
}

fn hashset_has_string(map: HashMap<string, int>, key: string) -> bool {
    return (map_has map key)
}

shadow hashset_has_string {
    let m: HashMap<string, int> = (hashset_new_string)
    assert (not (hashset_has_string m "a"))
    (map_put m "a" 1)
    assert (hashset_has_string m "a")
}

fn hashset_add_string(map: HashMap<string, int>, key: string) -> HashMap<string, int> {
    if (not (map_has map key)) {
        (map_put map key 1)
    } else { (print "") }
    return map
}

shadow hashset_add_string {
    let m: HashMap<string, int> = (hashset_new_string)
    let m2: HashMap<string, int> = (hashset_add_string m "a")
    assert (hashset_has_string m2 "a")
    let m3: HashMap<string, int> = (hashset_add_string m2 "a")
    assert (hashset_has_string m3 "a")
}

pub fn transp_str_ends_with(s: string, suffix: string) -> bool {
    let ls: int = (str_length s)
    let lf: int = (str_length suffix)
    if (< ls lf) {
        return false
    } else {
        return (== (str_substring s (- ls lf) lf) suffix)
    }
}

shadow transp_str_ends_with {
    assert (transp_str_ends_with "hello.nano" ".nano")
    assert (not (transp_str_ends_with "test.c" ".nano"))
}

fn last_double_colon_index(s: string) -> int {
    let len: int = (str_length s)
    let mut i: int = 0
    let mut last: int = -1
    while (< (+ i 1) len) {
        let c1: string = (str_substring s i 1)
        let c2: string = (str_substring s (+ i 1) 1)
        if (and (== c1 ":") (== c2 ":")) {
            set last i
            set i (+ i 2)
        } else {
            set i (+ i 1)
        }
    }
    return last
}

shadow last_double_colon_index {
    assert (== (last_double_colon_index "module::function") 6)
    assert (== (last_double_colon_index "a::b::c") 4)
    assert (== (last_double_colon_index "test") -1)
}

fn last_dot_index(s: string) -> int {
    let len: int = (str_length s)
    let mut i: int = 0
    let mut last: int = -1
    while (< i len) {
        if (== (str_substring s i 1) ".") {
            set last i
        } else { (print "") }
        set i (+ i 1)
    }
    return last
}

shadow last_dot_index {
    assert (== (last_dot_index "file.nano") 4)
    assert (== (last_dot_index "a.b.c") 3)
    assert (== (last_dot_index "test") -1)
}

fn last_slash_index(s: string) -> int {
    let len: int = (str_length s)
    let mut i: int = 0
    let mut last: int = -1
    while (< i len) {
        if (== (str_substring s i 1) "/") {
            set last i
        } else { (print "") }
        set i (+ i 1)
    }
    return last
}

shadow last_slash_index {
    assert (== (last_slash_index "/path/to/file.nano") 8)
    assert (== (last_slash_index "dir/file") 3)
    assert (== (last_slash_index "test") -1)
}

fn module_name_from_path(path: string) -> string {
    let last_slash: int = (last_slash_index path)
    let last_dot: int = (last_dot_index path)
    let mut start: int = 0
    if (>= last_slash 0) {
        set start (+ last_slash 1)
    } else {
        (print "")
    }
    let mut end: int = (str_length path)
    if (>= last_dot 0) {
        set end last_dot
    } else {
        (print "")
    }
    let len: int = (- end start)
    if (<= len 0) {
        return path
    } else {
        return (str_substring path start len)
    }
}

shadow module_name_from_path {
    assert (== (module_name_from_path "src/lexer.nano") "lexer")
    assert (== (module_name_from_path "file.nano") "file")
    assert (== (module_name_from_path "test") "test")
}

fn build_module_alias_map(parser: Parser) -> int {
    (reset_module_aliases)
    (reset_func_aliases)
    if (mb_active) { return 0 }
    let import_count: int = (parser_get_import_count parser)
    let mut i: int = 0
    while (< i import_count) {
        let imp: ASTImport = (parser_get_import parser i)
        if (> (str_length imp.module_name) 0) {
            let module_name: string = (module_name_from_path imp.module_path)
            (add_module_alias imp.module_name module_name)
        } else { (print "") }
        if (and imp.is_selective (not imp.is_wildcard)) {
            if (> imp.import_symbol_count 0) {
                let module_name: string = (module_name_from_path imp.module_path)
                let mut si: int = 0
                while (< si imp.import_symbol_count) {
                    let sym: string = (at imp.import_symbols si)
                    let mut alias_name: string = ""
                    if (< si (array_length imp.import_aliases)) {
                        set alias_name (at imp.import_aliases si)
                    } else { (print "") }
                    if (== (str_length alias_name) 0) {
                        set alias_name sym
                    } else { (print "") }
                    if (> (str_length alias_name) 0) {
                        let mut target_parts: array<string> = []
                        set target_parts (cg_append target_parts module_name)
                        set target_parts (cg_append target_parts ".")
                        set target_parts (cg_append target_parts sym)
                        let target: string = (cg_build target_parts)
                        (add_func_alias alias_name target)
                    } else { (print "") }
                    set si (+ si 1)
                }
            } else { (print "") }
        } else { (print "") }
        set i (+ i 1)
    }
    return 0
}

shadow build_module_alias_map {
    let toks: List<LexerToken> = (tokenize_string "fn main() -> int { return 0 }" "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let r: int = (build_module_alias_map p)
    assert (== r 0)
}

fn mangle_module_ident(name: string) -> string {
    let mut out: string = ""
    let len: int = (str_length name)
    let mut i: int = 0

    while (< i len) {
        let ch: string = (str_substring name i 1)

        if (and (== ch ":") (< (+ i 1) len)) {
            let ch2: string = (str_substring name (+ i 1) 1)
            if (== ch2 ":") {
                set out (+ out "__")
                set i (+ i 2)
            } else {
                set out (+ out "_")
                set i (+ i 1)
            }
        } else {
            if (== ch ".") {
                set out (+ out "__")
            } else {
                if (or (or (== ch "<") (== ch ">"))
                        (or (== ch ",") (== ch "("))) {
                    set out (+ out "_")
                } else {
                    if (== ch ")") {
                        set out (+ out "_")
                    } else {
                        set out (+ out ch)
                    }
                }
            }
            set i (+ i 1)
        }
    }

    return out
}

shadow mangle_module_ident {
    assert (== (mangle_module_ident "module::function") "module__function")
    assert (== (mangle_module_ident "std.io") "std__io")
    assert (== (mangle_module_ident "List<int>") "List_int_")
}

fn is_unprefixed_list_runtime_fn(name: string) -> bool {
    if (transp_str_starts_with name "list_int_") { return true } else { (print "") }
    if (transp_str_starts_with name "list_string_") { return true } else { (print "") }
    if (transp_str_starts_with name "list_token_") { return true } else { (print "") }
    return false
}

shadow is_unprefixed_list_runtime_fn {
    assert (is_unprefixed_list_runtime_fn "list_int_new")
    assert (is_unprefixed_list_runtime_fn "list_string_push")
    assert (not (is_unprefixed_list_runtime_fn "list_Point_new"))
    assert (not (is_unprefixed_list_runtime_fn "list_LexerToken_get"))
}

fn is_generic_list_runtime_fn(name: string) -> bool {
    return (and (transp_str_starts_with name "list_") (not (is_unprefixed_list_runtime_fn name)))
}

shadow is_generic_list_runtime_fn {
    assert (is_generic_list_runtime_fn "list_Point_new")
    assert (not (is_generic_list_runtime_fn "list_int_new"))
    assert (not (is_generic_list_runtime_fn "some_other_fn"))
}

fn c_name_for_qualified_function(func_name: string) -> string {
    let len: int = (str_length func_name)
    let dc: int = (last_double_colon_index func_name)
    if (>= dc 0) {
        let mod_part: string = (str_substring func_name 0 dc)
        let base: string = (str_substring func_name (+ dc 2) (- len (+ dc 2)))
        let resolved: string = (resolve_module_alias mod_part)
        let mm: string = (mangle_module_ident resolved)
        let mut parts: array<string> = []
        set parts (cg_append parts mm)
        set parts (cg_append parts "__")
        set parts (cg_append parts (mangle_name base))
        return (cg_build parts)
    } else {
        let dot: int = (last_dot_index func_name)
        if (>= dot 0) {
            let mod_part: string = (str_substring func_name 0 dot)
            let base: string = (str_substring func_name (+ dot 1) (- len (+ dot 1)))
            let resolved: string = (resolve_module_alias mod_part)
            if (== resolved mod_part) {
                /* Module alias not found - module was merged, treat as local call */
                return (+ "nl_" (mangle_name base))
            } else { (print "") }
            let mm: string = (mangle_module_ident resolved)
            let mut parts: array<string> = []
            set parts (cg_append parts mm)
            set parts (cg_append parts "__")
            set parts (cg_append parts (mangle_name base))
            return (cg_build parts)
        } else {
            return func_name
        }
    }
}

shadow c_name_for_qualified_function {
    (reset_module_aliases)
    assert (== (c_name_for_qualified_function "std::io::print") "std__io__print")
    assert (== (c_name_for_qualified_function "file.read") "nl_read")
    (add_module_alias "file" "std_fs")
    assert (== (c_name_for_qualified_function "file.read") "std_fs__read")
    (reset_module_aliases)
}

/* Map builtin function names to their C implementation names */
fn map_builtin_func_name(func_name: string) -> string {
    if (== func_name "float_from_bits") { return "nl_float_from_bits" }
    if (== func_name "float_to_bits") { return "nl_float_to_bits" }
    if (== func_name "cast_int") { return "nl_cast_int" }
    if (== func_name "cast_bool") { return "nl_cast_bool" }
    /* Math builtins that need nl_ prefix */
    if (== func_name "abs") { return "nl_abs" } else { (print "") }
    if (== func_name "min") { return "nl_min" } else { (print "") }
    if (== func_name "max") { return "nl_max" } else { (print "") }
    
    /* C math library functions (no prefix) */
    if (== func_name "sqrt") { return "nl_sqrt" } else { (print "") }
    if (== func_name "pow") { return "nl_pow" } else { (print "") }
    if (== func_name "floor") { return "nl_floor" } else { (print "") }
    if (== func_name "ceil") { return "nl_ceil" } else { (print "") }
    if (== func_name "round") { return "nl_round" } else { (print "") }
    if (== func_name "sin") { return "nl_sin" } else { (print "") }
    if (== func_name "cos") { return "nl_cos" } else { (print "") }
    if (== func_name "tan") { return "nl_tan" } else { (print "") }
    if (== func_name "atan2") { return "nl_atan2" } else { (print "") }
    
    /* String builtins */
    if (== func_name "str_length") { return "strlen" } else { (print "") }
    if (== func_name "str_len") { return "strlen" } else { (print "") }
    if (== func_name "str_slice") { return "nl_str_slice" } else { (print "") }
    if (== func_name "str_concat") { return "nl_str_concat" } else { (print "") }
    if (== func_name "str_substring") { return "nl_str_substring" } else { (print "") }
    if (== func_name "str_starts_with") { return "nl_str_starts_with" } else { (print "") }
    if (== func_name "str_contains") { return "nl_str_contains" } else { (print "") }
    if (== func_name "str_equals") { return "nl_str_equals" } else { (print "") }
    if (== func_name "bytes_from_string") { return "nl_bytes_from_string" } else { (print "") }
    if (== func_name "string_from_bytes") { return "nl_string_from_bytes" } else { (print "") }
    
    /* Character/string conversion builtins (runtime functions with nl_ prefix) */
    if (== func_name "char_at") { return "nl_char_at" } else { (print "") }
    if (== func_name "string_from_char") { return "nl_string_from_char" } else { (print "") }
    if (== func_name "int_to_string") { return "nl_int_to_string" } else { (print "") }
    if (== func_name "string_to_int") { return "nl_string_to_int" } else { (print "") }
    if (== func_name "float_to_string") { return "nl_float_to_string" } else { (print "") }
    if (== func_name "string_to_float") { return "nl_string_to_float" } else { (print "") }
    if (== func_name "bool_to_string") { return "nl_bool_to_string" } else { (print "") }
    
    /* Character classification builtins (runtime functions with nl_ prefix) */
    if (== func_name "is_digit") { return "nl_is_digit" } else { (print "") }
    if (== func_name "is_alpha") { return "nl_is_alpha" } else { (print "") }
    if (== func_name "is_alnum") { return "nl_is_alnum" } else { (print "") }
    if (== func_name "is_whitespace") { return "nl_is_whitespace" } else { (print "") }
    if (== func_name "is_upper") { return "nl_is_upper" } else { (print "") }
    if (== func_name "is_lower") { return "nl_is_lower" } else { (print "") }
    if (== func_name "digit_value") { return "nl_digit_value" } else { (print "") }
    if (== func_name "char_to_lower") { return "nl_char_to_lower" } else { (print "") }
    if (== func_name "char_to_upper") { return "nl_char_to_upper" } else { (print "") }
    
    /* OS/system builtins from runtime/cli.c (nl_os_* prefix) */
    if (== func_name "getenv") { return "nl_getenv" } else { (print "") }
    if (== func_name "env_get") { return "nl_env_get" } else { (print "") }
    if (== func_name "setenv") { return "nl_os_setenv" } else { (print "") }
    if (== func_name "system") { return "nl_os_system" } else { (print "") }
    if (== func_name "exit") { return "nl_os_exit" } else { (print "") }
    if (== func_name "getcwd") { return "nl_os_getcwd" } else { (print "") }
    if (== func_name "chdir") { return "nl_os_chdir" } else { (print "") }
    
    /* File/path builtins from modules/std/fs.c (unprefixed).
     * file_read, path_* functions return const char* in C but string in NanoLang;
     * route them through nl_ wrappers (defined in gen_c_runtime) that cast to char*. */
    if (== func_name "file_read") { return "nl_file_read" } else { (print "") }
    if (== func_name "file_write") { return "file_write" } else { (print "") }
    if (== func_name "file_append") { return "file_append" } else { (print "") }
    if (== func_name "file_exists") { return "file_exists" } else { (print "") }
    if (== func_name "file_remove") { return "file_delete" } else { (print "") }
    if (== func_name "file_size") { return "nl_os_file_size" } else { (print "") }
    if (== func_name "path_join") { return "nl_path_join" } else { (print "") }
    if (== func_name "path_basename") { return "nl_path_basename" } else { (print "") }
    if (== func_name "path_dirname") { return "nl_path_dirname" } else { (print "") }
    if (== func_name "path_normalize") { return "nl_path_normalize" } else { (print "") }
    if (== func_name "path_isfile") { return "nl_os_path_isfile" } else { (print "") }
    if (== func_name "path_isdir") { return "nl_os_path_isdir" } else { (print "") }
    if (== func_name "fs_walkdir") { return "fs_walkdir" } else { (print "") }
    if (== func_name "dir_create") { return "nl_os_dir_create" } else { (print "") }
    if (== func_name "dir_remove") { return "nl_os_dir_remove" } else { (print "") }
    if (== func_name "dir_list") { return "nl_os_dir_list" } else { (print "") }
    if (== func_name "dir_exists") { return "nl_os_dir_exists" } else { (print "") }
    if (== func_name "tmp_dir") { return "nl_os_tmp_dir" } else { (print "") }
    if (== func_name "mktemp") { return "nl_os_mktemp" } else { (print "") }
    if (== func_name "mktemp_dir") { return "nl_os_mktemp_dir" } else { (print "") }
    if (== func_name "path_relpath") { return "nl_path_relpath" } else { (print "") }
    if (== func_name "fs_mkdir_p") { return "nl_fs_mkdir_p" } else { (print "") }
    if (== func_name "file_copy") { return "nl_file_copy" } else { (print "") }
    if (== func_name "dir_copy") { return "nl_dir_copy" } else { (print "") }
    if (== func_name "process_run") { return "nl_os_process_run" } else { (print "") }
    if (== func_name "process_spawn") { return "nl_os_process_spawn" } else { (print "") }
    if (== func_name "process_is_running") { return "nl_os_process_is_running" } else { (print "") }
    if (== func_name "process_wait") { return "nl_os_process_wait" } else { (print "") }
    if (== func_name "unsetenv") { return "nl_os_unsetenv" } else { (print "") }

    /* HashMap/map builtins (self-hosted runtime provides nl_map_*) */
    if (== func_name "map_set") { return "nl_map_put" } else { (print "") }
    if (== func_name "map_length") { return "nl_map_size" } else { (print "") }
    
    /* CLI argument access (from runtime/cli.c) */
    if (== func_name "get_argc") { return "get_argc" } else { (print "") }
    if (== func_name "get_argv") { return "nl_get_argv" } else { (print "") }
    
    /* cast_string/to_string have no nl_ prefix in runtime */
    if (== func_name "cast_string") { return "cast_string" } else { (print "") }
    if (== func_name "to_string") { return "to_string" } else { (print "") }
    if (== func_name "null_opaque") { return "nl_null_opaque" } else { (print "") }
    
    /* Additional math builtins not yet covered */
    if (== func_name "asin") { return "asin" } else { (print "") }
    if (== func_name "acos") { return "acos" } else { (print "") }
    if (== func_name "atan") { return "atan" } else { (print "") }
    if (== func_name "log") { return "log" } else { (print "") }
    if (== func_name "log2") { return "log2" } else { (print "") }
    if (== func_name "log10") { return "log10" } else { (print "") }
    if (== func_name "exp") { return "exp" } else { (print "") }
    if (== func_name "fmod") { return "fmod" } else { (print "") }
    
    /* No mapping found - return empty string */
    return ""
}

shadow map_builtin_func_name {
    assert (== (map_builtin_func_name "float_from_bits") "nl_float_from_bits")
    assert (== (map_builtin_func_name "float_to_bits") "nl_float_to_bits")
    assert (== (map_builtin_func_name "cast_int") "nl_cast_int")
    assert (== (map_builtin_func_name "cast_bool") "nl_cast_bool")
    assert (== (map_builtin_func_name "abs") "nl_abs")
    assert (== (map_builtin_func_name "sqrt") "nl_sqrt")
    assert (== (map_builtin_func_name "str_length") "strlen")
    assert (== (map_builtin_func_name "bytes_from_string") "nl_bytes_from_string")
    assert (== (map_builtin_func_name "string_from_bytes") "nl_string_from_bytes")
    assert (== (map_builtin_func_name "int_to_string") "nl_int_to_string")
    assert (== (map_builtin_func_name "is_digit") "nl_is_digit")
    assert (== (map_builtin_func_name "getenv") "nl_getenv")
    assert (== (map_builtin_func_name "file_read") "nl_file_read")
    assert (== (map_builtin_func_name "path_join") "nl_path_join")
    assert (== (map_builtin_func_name "map_set") "nl_map_put")
    assert (== (map_builtin_func_name "unknown_func") "")
}

fn c_func_name_for_call(func_name: string) -> string {
    /* Check for builtin function mapping first */
    let builtin_mapped: string = (map_builtin_func_name func_name)
    if (!= builtin_mapped "") {
        return builtin_mapped
    } else { (print "") }
    
    let alias_target: string = (resolve_func_alias func_name)
    if (> (str_length alias_target) 0) {
        return (c_name_for_qualified_function alias_target)
    } else { (print "") }
    if (is_unprefixed_list_runtime_fn func_name) {
        return func_name
    } else {
        if (is_generic_list_runtime_fn func_name) {
            return (+ "nl_" func_name)
        } else {
            if (or (str_contains func_name "::") (str_contains func_name ".")) {
                return (c_name_for_qualified_function func_name)
            } else {
                if (would_collide_with_extern func_name) {
                    return (+ "nl_wrap_" (mangle_name func_name))
                } else {
                    return (+ "nl_" (mangle_name func_name))
                }
            }
        }
    }
}

shadow c_func_name_for_call {
    set extern_func_names []
    let r: string = (c_func_name_for_call "my_func")
    assert (== r "nl_my_func")
}

fn c_func_name_for_definition(func_name: string) -> string {
    if (native_array_operation func_name) { return (+ "__nl_declared_" func_name) }
    if (or (str_contains func_name "::") (str_contains func_name ".")) {
        return (c_name_for_qualified_function func_name)
    } else {
        if (would_collide_with_extern func_name) {
            return (+ "nl_wrap_" (mangle_name func_name))
        } else {
            return (+ "nl_" (mangle_name func_name))
        }
    }
}

shadow c_func_name_for_definition {
    set extern_func_names []
    assert (== (c_func_name_for_definition "my_func") "nl_my_func")
    assert (== (c_func_name_for_definition "add") "nl_add")
    assert (== (c_func_name_for_definition "array_push") "__nl_declared_array_push")
    assert (!= (c_func_name_for_definition "__nl_declared_array_push") "__nl_declared_array_push")
}

/* =============================================================================
 * TYPE ENV (minimal) - track variable types for array lowering
 * ============================================================================= */

struct GenEnv {
    names: array<string>,
    types: array<string>,
    mut_flags: array<bool>,
    global_flags: array<bool>,
    underscore_name: string,
    scope: string
}

fn type_is_float(t: string) -> bool {
    return (== t "float")
}

shadow type_is_float {
    assert (type_is_float "float")
    assert (not (type_is_float "int"))
}

fn func_returns_float(name: string) -> bool {
    if (== name "float_from_bits") { return true }
    if (== name "sqrt") { return true } else { (print "") }
    if (== name "pow") { return true } else { (print "") }
    if (== name "floor") { return true } else { (print "") }
    if (== name "ceil") { return true } else { (print "") }
    if (== name "round") { return true } else { (print "") }
    if (== name "sin") { return true } else { (print "") }
    if (== name "cos") { return true } else { (print "") }
    if (== name "tan") { return true } else { (print "") }
    if (== name "atan2") { return true } else { (print "") }
    if (== name "cast_float") { return true } else { (print "") }
    if (== name "float_to_string") { return false } else { (print "") }
    if (== name "int_to_float") { return true } else { (print "") }
    return false
}

fn func_returns_string(name: string) -> bool {
    if (== name "int_to_string") { return true } else { (print "") }
    if (== name "float_to_string") { return true } else { (print "") }
    if (== name "bool_to_string") { return true } else { (print "") }
    if (== name "to_string") { return true } else { (print "") }
    if (== name "str_substring") { return true } else { (print "") }
    if (== name "str_slice") { return true } else { (print "") }
    if (== name "str_concat") { return true } else { (print "") }
    if (== name "str_trim") { return true } else { (print "") }
    if (== name "string_from_char") { return true } else { (print "") }
    return false
}

fn infer_binary_expr_type(op: int, left_type: string, right_type: string) -> string {
    let is_comparison: bool = (or (or (== op LexerTokenType.TOKEN_EQ) (== op LexerTokenType.TOKEN_NE))
                                  (or (or (== op LexerTokenType.TOKEN_LT) (== op LexerTokenType.TOKEN_GT))
                                      (or (== op LexerTokenType.TOKEN_LE) (== op LexerTokenType.TOKEN_GE))))
    if is_comparison { return "bool" } else { (print "") }
    if (or (== op LexerTokenType.TOKEN_AND) (== op LexerTokenType.TOKEN_OR)) {
        return "bool"
    } else { (print "") }
    if (and (== op LexerTokenType.TOKEN_PLUS)
            (or (== left_type "string") (== right_type "string"))) {
        return "string"
    } else { (print "") }
    if (or (== left_type "float") (== right_type "float")) {
        return "float"
    } else { (print "") }
    return "int"
}

shadow infer_binary_expr_type {
    assert (== (infer_binary_expr_type LexerTokenType.TOKEN_PLUS "int" "int") "int")
    assert (== (infer_binary_expr_type LexerTokenType.TOKEN_STAR "float" "int") "float")
    assert (== (infer_binary_expr_type LexerTokenType.TOKEN_PLUS "string" "int") "string")
    assert (== (infer_binary_expr_type LexerTokenType.TOKEN_EQ "int" "int") "bool")
    assert (== (infer_binary_expr_type LexerTokenType.TOKEN_AND "bool" "bool") "bool")
}

/* Infer the NanoLang type of a parsed expression node for interpolation.
   Returns "int", "float", "bool", "string", or "" (unknown). */
fn infer_expr_type(parser: Parser, node_id: int, node_type: int, env: GenEnv) -> string {
    if (== node_type ParseNodeType.PNODE_TUPLE_LITERAL) {
        let tuple: ASTTupleLiteral = (parser_get_tuple_literal parser node_id)
        let mut annotation: string = "("
        let mut i: int = 0
        while (< i tuple.element_count) {
            let reference: ASTStmtRef = ASTStmtRef { node_id: (at tuple.element_ids i), node_type: (at tuple.element_types i) }
            let mut child: string = (infer_expr_type parser reference.node_id reference.node_type env)
            if (== child "") { set child (native_array_callback_type parser reference env) }
            if (== child "") { return "" }
            if (> i 0) { set annotation (+ annotation ",") }
            set annotation (+ annotation child)
            set i (+ i 1)
        }
        return (+ annotation ")")
    }
    if (== node_type ParseNodeType.PNODE_ARRAY_LITERAL) {
        let literal: ASTArrayLiteral = (parser_get_array_literal parser node_id)
        if (!= literal.element_type "") { return (+ "array<" (+ literal.element_type ">")) }
        if (> literal.element_count 0) {
            let first: ASTStmtRef = (parser_get_array_element parser literal.element_start)
            let mut element: string = (infer_expr_type parser first.node_id first.node_type env)
            if (== element "") { set element (native_array_callback_type parser first env) }
            return (+ "array<" (+ element ">"))
        }
        return "array<unknown>"
    }
    if (== node_type ParseNodeType.PNODE_IDENTIFIER) {
        let id: ASTIdentifier = (parser_get_identifier parser node_id)
        let annotation: string = (genenv_get env id.name)
        if (transp_str_starts_with annotation "&mut ") { return (str_substring annotation 5 (str_length annotation)) }
        if (transp_str_starts_with annotation "&") { return (str_substring annotation 1 (str_length annotation)) }
        return annotation
    } else { (print "") }
    if (== node_type ParseNodeType.PNODE_FIELD_ACCESS) {
        let field: ASTFieldAccess = (parser_get_field_access parser node_id)
        let owner: string = (infer_expr_type parser field.object field.object_type env)
        return (lookup_struct_field_type parser owner field.field_name)
    }
    if (== node_type ParseNodeType.PNODE_NUMBER) { return "int" } else { (print "") }
    if (== node_type ParseNodeType.PNODE_FLOAT) { return "float" } else { (print "") }
    if (== node_type ParseNodeType.PNODE_STRING) { return "string" } else { (print "") }
    if (== node_type ParseNodeType.PNODE_BOOL) { return "bool" } else { (print "") }
    if (== node_type ParseNodeType.PNODE_BINARY_OP) {
        let ib: ASTBinaryOp = (parser_get_binary_op parser node_id)
        let left_type: string = (infer_expr_type parser ib.left ib.left_type env)
        let right_type: string = (infer_expr_type parser ib.right ib.right_type env)
        return (infer_binary_expr_type ib.op left_type right_type)
    } else { (print "") }
    if (== node_type ParseNodeType.PNODE_CALL) {
        let ic: ASTCall = (parser_get_call parser node_id)
        if (!= ic.function_type ParseNodeType.PNODE_IDENTIFIER) {
            let callee_type: string = (infer_expr_type parser ic.function ic.function_type env)
            if (transp_str_starts_with callee_type "fn(") {
                return (parse_fn_type_return callee_type)
            } else { return "" }
        } else { (print "") }
        let if_id: ASTIdentifier = (parser_get_identifier parser ic.function)
        let bound: string = (genenv_get env if_id.name)
        if (and (native_array_operation if_id.name) (is_fn_type bound)) { return (parse_fn_type_return bound) }
        let declared: string = (lookup_func_return_type_in_parser parser (mb_resolve if_id.name if_id.line env.names))
        if (!= declared "") { return declared }
        if (and (native_array_operation if_id.name) (not (native_array_builtin parser if_id env))) { return "" }
        if (and (or (== if_id.name "at") (== if_id.name "array_get")) (== ic.arg_count 2)) {
            let source: ASTStmtRef = (parser_get_call_arg parser ic.arg_start)
            return (full_array_element_type (infer_expr_type parser source.node_id source.node_type env))
        }
        if (and (== if_id.name "array_new") (== ic.arg_count 2)) {
            let initial: ASTStmtRef = (parser_get_call_arg parser (+ ic.arg_start 1))
            let mut element: string = (infer_expr_type parser initial.node_id initial.node_type env)
            if (== element "") { set element (native_array_callback_type parser initial env) }
            return (+ "array<" (+ element ">"))
        }
        if (and (or (== if_id.name "array_push") (or (== if_id.name "filter") (== if_id.name "array_filter"))) (== ic.arg_count 2)) {
            let source: ASTStmtRef = (parser_get_call_arg parser ic.arg_start)
            return (infer_expr_type parser source.node_id source.node_type env)
        }
        if (or (and (== if_id.name "array_slice") (== ic.arg_count 3))
               (and (== if_id.name "array_remove_at") (== ic.arg_count 2))) {
            let source: ASTStmtRef = (parser_get_call_arg parser ic.arg_start)
            return (infer_expr_type parser source.node_id source.node_type env)
        }
        if (and (== if_id.name "array_pop") (== ic.arg_count 1)) {
            let source: ASTStmtRef = (parser_get_call_arg parser ic.arg_start)
            return (full_array_element_type (infer_expr_type parser source.node_id source.node_type env))
        }
        if (and (or (== if_id.name "map") (== if_id.name "array_map")) (== ic.arg_count 2)) {
            let callback: ASTStmtRef = (parser_get_call_arg parser (+ ic.arg_start 1))
            let signature: string = (native_array_callback_type parser callback env)
            if (!= signature "") { return (+ "array<" (+ (parse_fn_type_return signature) ">")) }
        }
        if (and (legacy_reduce_builtin parser if_id env) (== ic.arg_count 3)) {
            let initial: ASTStmtRef = (parser_get_call_arg parser (+ ic.arg_start 1))
            return (infer_expr_type parser initial.node_id initial.node_type env)
        }
        if (func_returns_string if_id.name) { return "string" } else { (print "") }
        if (func_returns_float if_id.name) { return "float" } else { (print "") }
        return "int"
    } else { (print "") }
    return ""
}

shadow infer_expr_type {
    let field_tokens: List<LexerToken> = (tokenize_string "struct Box { flags: array<bool> } struct Outer { inner: Box } fn probe() -> int { return outer.inner.flags }" "field-types.nano" (list_CompilerDiagnostic_new))
    let field_parser: Parser = (parse_program field_tokens (list_LexerToken_length field_tokens) "field-types.nano")
    let field_env: GenEnv = (genenv_put (genenv_new "test") "outer" "Outer" false)
    let field_return: ASTReturn = (parser_get_return field_parser 0)
    assert (== (infer_expr_type field_parser field_return.value field_return.value_type field_env) "array<bool>")
    let tokens: List<LexerToken> = (tokenize_string "fn probe() -> int { return (at (at (at deep 0) 0) 0) }" "types.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "types.nano")
    let typed: GenEnv = (genenv_put (genenv_new "test") "deep" "array<array<array<float>>>" false)
    let ret: ASTReturn = (parser_get_return parser 0)
    assert (== (infer_expr_type parser ret.value ret.value_type typed) "float")
    let env: GenEnv = (genenv_new "test")
    let env2: GenEnv = (genenv_put env "x" "int" false)
    let env3: GenEnv = (genenv_put env2 "name" "string" false)
    /* Can't call parser_get_identifier without a real parser, so just verify it compiles */
    assert (== (genenv_get env2 "x") "int")
    assert (== (genenv_get env3 "name") "string")
    let tuple_tokens: List<LexerToken> = (tokenize_string "fn probe()->int { return [(1, cb)] }" "tuple-types.nano" (list_CompilerDiagnostic_new))
    let tuple_parser: Parser = (parse_program tuple_tokens (list_LexerToken_length tuple_tokens) "tuple-types.nano")
    let tuple_env: GenEnv = (genenv_put (genenv_new "test") "cb" "fn(int)->int" false)
    let tuple_return: ASTReturn = (parser_get_return tuple_parser 0)
    assert (== (infer_expr_type tuple_parser tuple_return.value tuple_return.value_type tuple_env) "array<(int,fn(int)->int)>")
    let slice_tokens: List<LexerToken> = (tokenize_string "fn probe()->int { return (array_pop (array_slice xs 0 1)) }" "slice-types.nano" (list_CompilerDiagnostic_new))
    let slice_parser: Parser = (parse_program slice_tokens (list_LexerToken_length slice_tokens) "slice-types.nano")
    let slice_env: GenEnv = (genenv_put (genenv_new "test") "xs" "array<(int,bool)>" false)
    let slice_return: ASTReturn = (parser_get_return slice_parser 0)
    assert (== (infer_expr_type slice_parser slice_return.value slice_return.value_type slice_env) "(int,bool)")
}

shadow func_returns_string {
    assert (func_returns_string "str_trim")
    assert (func_returns_string "string_from_char")
    assert (not (func_returns_string "str_ends_with"))
    assert (func_returns_string "int_to_string")
    assert (func_returns_string "str_substring")
    assert (not (func_returns_string "print"))
    assert (not (func_returns_string "sqrt"))
}

shadow func_returns_float {
    assert (func_returns_float "float_from_bits")
    assert (not (func_returns_float "float_to_bits"))
    assert (func_returns_float "sqrt")
    assert (func_returns_float "sin")
    assert (not (func_returns_float "print"))
}

struct TypeCParseResult {
    ok: bool,
    c_type: string,
    next_pos: int
}

fn is_schema_struct_name(name: string) -> bool {
    if (== name "Parser") { return true } else { (print "") }
    if (== name "NSType") { return true } else { (print "") }
    if (== name "OptionType") { return true } else { (print "") }
    if (== name "CompilerSourceLocation") { return true } else { (print "") }
    if (== name "CompilerDiagnostic") { return true } else { (print "") }
    if (== name "LexPhaseOutput") { return true } else { (print "") }
    if (== name "TypeEnvironment") { return true } else { (print "") }
    if (== name "TypecheckPhaseOutput") { return true } else { (print "") }
    if (== name "TranspilePhaseOutput") { return true } else { (print "") }
    return false
}

shadow is_schema_struct_name {
    assert (is_schema_struct_name "Parser")
    assert (not (is_schema_struct_name "NameParseResult"))
}

fn parse_type_c_from_tokens(parser: Parser, start_pos: int) -> TypeCParseResult {
    let n: int = parser.token_count
    if (or (< start_pos 0) (>= start_pos n)) {
        return TypeCParseResult { ok: false, c_type: "", next_pos: start_pos }
    } else { (print "") }

    let t0: LexerToken = (list_LexerToken_get parser.tokens start_pos)

    if (== t0.token_type LexerTokenType.TOKEN_TYPE_INT) { return TypeCParseResult { ok: true, c_type: "int64_t", next_pos: (+ start_pos 1) } } else { (print "") }
    if (== t0.token_type LexerTokenType.TOKEN_TYPE_U8) { return TypeCParseResult { ok: true, c_type: "uint8_t", next_pos: (+ start_pos 1) } } else { (print "") }
    if (== t0.token_type LexerTokenType.TOKEN_TYPE_FLOAT) { return TypeCParseResult { ok: true, c_type: "double", next_pos: (+ start_pos 1) } } else { (print "") }
    if (== t0.token_type LexerTokenType.TOKEN_TYPE_BOOL) { return TypeCParseResult { ok: true, c_type: "bool", next_pos: (+ start_pos 1) } } else { (print "") }
    if (== t0.token_type LexerTokenType.TOKEN_TYPE_STRING) { return TypeCParseResult { ok: true, c_type: "const char*", next_pos: (+ start_pos 1) } } else { (print "") }

    /* array<T> */
    if (== t0.token_type LexerTokenType.TOKEN_ARRAY) {
        return TypeCParseResult { ok: true, c_type: "DynArray*", next_pos: (+ start_pos 1) }
    } else { (print "") }

    if (== t0.token_type LexerTokenType.TOKEN_IDENTIFIER) {
        let mut spelling: string = t0.value
        let mut name_end: int = (+ start_pos 1)
        let mut qualified: bool = true
        while (and qualified (< name_end n)) {
            let separator: LexerToken = (list_LexerToken_get parser.tokens name_end)
            if (== separator.token_type LexerTokenType.TOKEN_DOT) {
                if (>= (+ name_end 1) n) { return TypeCParseResult { ok: false, c_type: "", next_pos: start_pos } }
                let member: LexerToken = (list_LexerToken_get parser.tokens (+ name_end 1))
                if (!= member.token_type LexerTokenType.TOKEN_IDENTIFIER) { return TypeCParseResult { ok: false, c_type: "", next_pos: start_pos } }
                set spelling (+ spelling (+ "." member.value))
                set name_end (+ name_end 2)
            } else { set qualified false }
        }
        let name: string = (nb_type spelling t0.line)

        /* List<T> */
        if (== name "List") {
            if (< (+ start_pos 3) n) {
                let t1: LexerToken = (list_LexerToken_get parser.tokens (+ start_pos 1))
                let t2: LexerToken = (list_LexerToken_get parser.tokens (+ start_pos 2))
                let t3: LexerToken = (list_LexerToken_get parser.tokens (+ start_pos 3))
                # I preserve my primitive runtime typedefs as well as named lists.
                let named_element: bool = (== t2.token_type LexerTokenType.TOKEN_IDENTIFIER)
                let primitive_element: bool = (or (== t2.token_type LexerTokenType.TOKEN_TYPE_INT) (== t2.token_type LexerTokenType.TOKEN_TYPE_STRING))
                if (and (== t1.token_type LexerTokenType.TOKEN_LT) (and (or named_element primitive_element) (== t3.token_type LexerTokenType.TOKEN_GT))) {
                    let elem: string = (nb_type t2.value t2.line)
                    if (== elem "LexerToken") { return TypeCParseResult { ok: true, c_type: "List_LexerToken*", next_pos: (+ start_pos 4) } } else { (print "") }
                    if (== elem "CompilerDiagnostic") { return TypeCParseResult { ok: true, c_type: "List_CompilerDiagnostic*", next_pos: (+ start_pos 4) } } else { (print "") }
                    let mut list_parts: array<string> = []
                    set list_parts (cg_append list_parts "List_")
                    set list_parts (cg_append list_parts (mangle_type_name elem))
                    set list_parts (cg_append list_parts "*")
                    return TypeCParseResult { ok: true, c_type: (cg_build list_parts), next_pos: (+ start_pos 4) }
                } else { (print "") }
            } else { (print "") }
        } else { (print "") }

        # I consume the complete concrete nominal field annotation.
        if (and (!= name "List") (!= name "HashMap")) {
            if (< name_end n) {
                let next: LexerToken = (list_LexerToken_get parser.tokens name_end)
                if (== next.token_type LexerTokenType.TOKEN_LT) {
                    let mut concrete_spelling: string = spelling
                    let mut cursor: int = name_end
                    let mut depth: int = 0
                    while (< cursor n) {
                        let part: LexerToken = (list_LexerToken_get parser.tokens cursor)
                        let mut text: string = part.value
                        if (== part.token_type LexerTokenType.TOKEN_LT) { set depth (+ depth 1) set text "<" }
                        if (== part.token_type LexerTokenType.TOKEN_GT) { set depth (- depth 1) set text ">" }
                        if (== part.token_type LexerTokenType.TOKEN_COMMA) { set text "," }
                        if (== part.token_type LexerTokenType.TOKEN_DOT) { set text "." }
                        if (== part.token_type LexerTokenType.TOKEN_LPAREN) { set text "(" }
                        if (== part.token_type LexerTokenType.TOKEN_RPAREN) { set text ")" }
                        if (== part.token_type LexerTokenType.TOKEN_ARROW) { set text "->" }
                        set concrete_spelling (+ concrete_spelling text)
                        set cursor (+ cursor 1)
                        if (== depth 0) {
                            return TypeCParseResult { ok: true, c_type: (type_to_c (nb_type concrete_spelling t0.line)), next_pos: cursor }
                        }
                    }
                    return TypeCParseResult { ok: false, c_type: "", next_pos: start_pos }
                }
            }
        }

        /* Direct schema / built-in types */
        if (is_schema_struct_name name) {
            return TypeCParseResult { ok: true, c_type: name, next_pos: name_end }
        } else { (print "") }

        /* Opaque types map directly to C types without nl_ prefix */
        if (is_opaque_type name) {
            return TypeCParseResult { ok: true, c_type: (opaque_c_type name), next_pos: name_end }
        } else { (print "") }

        /* Fallback: treat as user-defined struct */
        let mut struct_parts: array<string> = []
        set struct_parts (cg_append struct_parts "nl_")
        set struct_parts (cg_append struct_parts (mangle_name name))
        return TypeCParseResult { ok: true, c_type: (cg_build struct_parts), next_pos: name_end }
    } else { (print "") }

    return TypeCParseResult { ok: false, c_type: "", next_pos: start_pos }
}

shadow parse_type_c_from_tokens {
    /* Minimal sanity: require a token stream with `int` at position 0. */
    let toks: List<LexerToken> = (tokenize_string "int" "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parser_new toks (list_LexerToken_length toks) "t.nano")
    let r: TypeCParseResult = (parse_type_c_from_tokens p 0)
    assert r.ok
    assert (== r.c_type "int64_t")
    let list_tokens: List<LexerToken> = (tokenize_string "List<int> List<string> List<LexerToken>" "t.nano" (list_CompilerDiagnostic_new))
    let lists: Parser = (parser_new list_tokens (list_LexerToken_length list_tokens) "t.nano")
    let integers: TypeCParseResult = (parse_type_c_from_tokens lists 0)
    assert integers.ok
    assert (== integers.c_type "List_int*")
    assert (== integers.next_pos 4)
    let strings: TypeCParseResult = (parse_type_c_from_tokens lists integers.next_pos)
    assert strings.ok
    assert (== strings.c_type "List_string*")
    assert (== strings.next_pos 8)
    let records: TypeCParseResult = (parse_type_c_from_tokens lists strings.next_pos)
    assert records.ok
    assert (== records.c_type "List_LexerToken*")
    assert (== records.next_pos 12)
    let generic_tokens: List<LexerToken> = (tokenize_string "Box<Box<int>>" "t.nano" (list_CompilerDiagnostic_new))
    let generic_parser: Parser = (parser_new generic_tokens (list_LexerToken_length generic_tokens) "t.nano")
    let concrete: TypeCParseResult = (parse_type_c_from_tokens generic_parser 0)
    assert concrete.ok
    assert (== concrete.c_type "nl_Box_Box_int")
    assert (== concrete.next_pos 7)

    let owner_tokens: List<LexerToken> = (tokenize_string "opaque type Handle\nmodule \"owner.nano\" as Lib\n" "qualified-token.nano" (list_CompilerDiagnostic_new))
    let owners: Parser = (parse_program owner_tokens (list_LexerToken_length owner_tokens) "qualified-token.nano")
    (mb_reset [1, 2])
    (mb_set_sources ["/owner.nano", "/root.nano"])
    assert (nb_register owners "__late_token_")
    (nb_import owners (parser_get_import owners 0) 0)
    let qualified_tokens: List<LexerToken> = (tokenize_string "\nLib.Handle" "qualified-token.nano" (list_CompilerDiagnostic_new))
    let qualified_parser: Parser = (parser_new qualified_tokens (list_LexerToken_length qualified_tokens) "qualified-token.nano")
    let qualified_result: TypeCParseResult = (parse_type_c_from_tokens qualified_parser 0)
    assert qualified_result.ok
    assert (== qualified_result.c_type "void*")
    assert (== qualified_result.next_pos 3)
    (mb_reset [])

}

/* Generate C enum typedefs and variant #defines by scanning tokens */
fn generate_enum_definitions_from_tokens(parser: Parser) -> string {
    let mut out: string = ""
    let n: int = parser.token_count
    let mut i: int = 0
    let mut emitted_enums: array<string> = []

    while (< i n) {
        let tok: LexerToken = (list_LexerToken_get parser.tokens i)

        if (== tok.token_type LexerTokenType.TOKEN_ENUM) {
            if (>= (+ i 2) n) { return out } else { (print "") }

            let name_tok: LexerToken = (list_LexerToken_get parser.tokens (+ i 1))
            let brace_tok: LexerToken = (list_LexerToken_get parser.tokens (+ i 2))
            if (and (== name_tok.token_type LexerTokenType.TOKEN_IDENTIFIER) (== brace_tok.token_type LexerTokenType.TOKEN_LBRACE)) {
                let ename: string = name_tok.value
                let mut enum_already: bool = false
                let mut eai: int = 0
                while (< eai (array_length emitted_enums)) {
                    if (== (at emitted_enums eai) ename) { set enum_already true } else { (print "") }
                    set eai (+ eai 1)
                }
                if (not enum_already) {
                set emitted_enums (array_push emitted_enums ename)
                let c_name: string = (+ "nl_" (mangle_name ename))

                /* Emit typedef */
                set out (+ out "typedef int64_t ")
                set out (+ out c_name)
                set out (+ out ";\n")

                /* Parse variants and emit #defines */
                let mut j: int = (+ i 3)
                let mut ordinal: int = 0
                let mut enum_done: bool = false
                while (and (< j n) (not enum_done)) {
                    let tcur: LexerToken = (list_LexerToken_get parser.tokens j)
                    if (== tcur.token_type LexerTokenType.TOKEN_RBRACE) {
                        set enum_done true
                    } else { (print "") }
                    if (not enum_done) {

                    if (== tcur.token_type LexerTokenType.TOKEN_IDENTIFIER) {
                        let vname: string = tcur.value
                        /* Check for = value */
                        let mut explicit_val: int = ordinal
                        if (< (+ j 1) n) {
                            let tnext: LexerToken = (list_LexerToken_get parser.tokens (+ j 1))
                            if (== tnext.token_type LexerTokenType.TOKEN_ASSIGN) {
                                if (< (+ j 2) n) {
                                    let tval: LexerToken = (list_LexerToken_get parser.tokens (+ j 2))
                                    if (== tval.token_type LexerTokenType.TOKEN_NUMBER) {
                                        set explicit_val (string_to_int tval.value)
                                        set j (+ j 2)  /* skip = and number */
                                    } else { (print "") }
                                } else { (print "") }
                            } else { (print "") }
                        } else { (print "") }

                        set out (+ out "#define ")
                        set out (+ out c_name)
                        set out (+ out "_")
                        set out (+ out vname)
                        set out (+ out " ")
                        set out (+ out (int_to_string explicit_val))
                        set out (+ out "\n")
                        set ordinal (+ explicit_val 1)
                    } else { (print "") }

                    set j (+ j 1)
                    } else { (print "") }
                }

                set i j
                } else { (print "") }
            } else { (print "") }
        } else { (print "") }

        set i (+ i 1)
    }

    return out
}

shadow generate_enum_definitions_from_tokens {
    assert (== 1 1)
}

fn native_nominal_field_type(c_type: string) -> string {
    if (or (== c_type "List_int*") (== c_type "List_string*")) { return c_type } else { (print "") }
    if (and (transp_str_starts_with c_type "List_") (== (str_substring c_type (- (str_length c_type) 1) 1) "*")) {
        return (+ "struct " c_type)
    } else { (print "") }
    return c_type
}

shadow native_nominal_field_type {
    assert (== (native_nominal_field_type "List_Node*") "struct List_Node*")
    assert (== (native_nominal_field_type "nl_Node") "nl_Node")
    assert (== (native_nominal_field_type "List_int*") "List_int*")
    assert (== (native_nominal_field_type "List_string*") "List_string*")
}

struct NativeNominalDefinition {
    c_name: string,
    code: string,
    field_types: array<string>
}

fn collect_native_structs(parser: Parser) -> array<NativeNominalDefinition> {
    let mut definitions: array<NativeNominalDefinition> = []
    let mut emitted: array<string> = []
    let mut i: int = 0
    while (< i (parser_get_struct_def_count parser)) {
        let declaration: ASTStruct = (parser_get_struct_def parser i)
        let name: string = declaration.name
        if (and (not declaration.is_extern) (and (not (is_schema_struct_name name)) (not (native_name_in emitted name)))) {
            let cname: string = (+ "nl_" (mangle_name name))
            let mut code: string = (+ "\n/* Struct definition: " (+ name " */\n"))
            if native_derived_forward_mode { set code (+ code "struct ") }
            else { set code (+ code "typedef struct ") }
            set code (+ code (+ cname " {\n"))
            let mut dependencies: array<string> = []
            let mut field: int = 0
            while (< field declaration.field_count) {
                let annotation: string = (at declaration.field_types field)
                let mut ctype: string = (type_to_c annotation)
                if (is_schema_struct_name annotation) { set ctype annotation }
                set dependencies (array_push dependencies ctype)
                set code (+ code (+ "    " (+ (native_nominal_field_type ctype) (+ " " (+ (mangle_name (at declaration.field_names field)) ";\n")))))
                set field (+ field 1)
            }
            set code (+ code "}")
            if (not native_derived_forward_mode) { set code (+ code (+ " " cname)) }
            set code (+ code ";\n")
            let definition: NativeNominalDefinition = NativeNominalDefinition { c_name: cname, code: code, field_types: dependencies }
            set definitions (array_push definitions definition)
            set emitted (array_push emitted name)
        }
        set i (+ i 1)
    }
    return definitions
}

shadow collect_native_structs {
    let toks: List<LexerToken> = (tokenize_string "struct Point { x: int }" "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let definitions: array<NativeNominalDefinition> = (collect_native_structs p)
    assert (== (array_length definitions) 1)
}

fn generate_struct_definitions_from_tokens(parser: Parser) -> string {
    let definitions: array<NativeNominalDefinition> = (collect_native_structs parser)
    let mut out: string = ""
    let mut i: int = 0
    while (< i (array_length definitions)) {
        let definition: NativeNominalDefinition = (at definitions i)
        set out (+ out definition.code)
        set i (+ i 1)
    }
    return out
}

shadow generate_struct_definitions_from_tokens {
    let src: string = "struct Foo { x: int, y: bool }"
    let toks: List<LexerToken> = (tokenize_string src "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let c: string = (generate_struct_definitions_from_tokens p)
    assert (> (str_length c) 0)
}

fn has_function_named(parser: Parser, name: string) -> bool {
    let n: int = (parser_get_function_count parser)
    let mut i: int = 0
    while (< i n) {
        let f: ASTFunction = (parser_get_function parser i)
        if (== f.name name) { return true } else { (print "") }
        set i (+ i 1)
    }
    return false
}

shadow has_function_named {
    let toks: List<LexerToken> = (tokenize_string "fn main() -> int { return 0 }" "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "test.nano")
    assert (has_function_named p "main")
}

fn is_runtime_declared_extern(name: string) -> bool {
    /* Module-specific introspection functions need their own declarations. */
    /* Prefix-based: json module functions */
    if (transp_str_starts_with name "nl_json_") { return true } else { (print "") }
    /* Prefix-based: runtime list functions (included via headers) */
    if (transp_str_starts_with name "list_int_") { return true } else { (print "") }
    if (transp_str_starts_with name "list_string_") { return true } else { (print "") }
    if (transp_str_starts_with name "list_token_") { return true } else { (print "") }
    if (transp_str_starts_with name "list_LexerToken_") { return true } else { (print "") }
    if (transp_str_starts_with name "list_AST") { return true } else { (print "") }
    if (transp_str_starts_with name "list_Compiler") { return true } else { (print "") }
    /* Prefix-based: collections.h (nl_sb_, nl_hm_, nl_set_) */
    if (transp_str_starts_with name "nl_sb_") { return true } else { (print "") }
    if (transp_str_starts_with name "nl_hm_") { return true } else { (print "") }
    if (transp_str_starts_with name "nl_set_") { return true } else { (print "") }
    /* Prefix-based: nl_os_ functions from cli.c */
    if (transp_str_starts_with name "nl_os_") { return true } else { (print "") }
    /* Prefix-based: fs/path/file functions from fs.c */
    if (transp_str_starts_with name "fs_") { return true } else { (print "") }
    if (transp_str_starts_with name "path_") { return true } else { (print "") }
    if (transp_str_starts_with name "file_") { return true } else { (print "") }
    if (transp_str_starts_with name "dir_") { return true } else { (print "") }
    /* gen_c_runtime declared: CLI functions */
    if (== name "get_argc") { return true } else { (print "") }
    if (== name "get_argv") { return true } else { (print "") }
    /* eval is a user-provided extern, not runtime — needs forward declaration */
    if (== name "nl_exec_shell") { return true } else { (print "") }
    if (== name "nl_exec_capture") { return true } else { (print "") }
    if (== name "nl_get_time_ms") { return true } else { (print "") }
    if (== name "nl_env_get") { return true } else { (print "") }
    if (== name "nl_getenv") { return true } else { (print "") }
    /* C standard library: <ctype.h> */
    if (== name "isalpha") { return true } else { (print "") }
    if (== name "isdigit") { return true } else { (print "") }
    if (== name "isalnum") { return true } else { (print "") }
    if (== name "isspace") { return true } else { (print "") }
    if (== name "isupper") { return true } else { (print "") }
    if (== name "islower") { return true } else { (print "") }
    if (== name "isprint") { return true } else { (print "") }
    if (== name "ispunct") { return true } else { (print "") }
    if (== name "toupper") { return true } else { (print "") }
    if (== name "tolower") { return true } else { (print "") }
    /* C standard library: <string.h> */
    if (== name "strlen") { return true } else { (print "") }
    if (== name "strcmp") { return true } else { (print "") }
    if (== name "strncmp") { return true } else { (print "") }
    if (== name "strcpy") { return true } else { (print "") }
    if (== name "strcat") { return true } else { (print "") }
    if (== name "memcpy") { return true } else { (print "") }
    if (== name "memset") { return true } else { (print "") }
    if (== name "strdup") { return true } else { (print "") }
    if (== name "strndup") { return true } else { (print "") }
    if (== name "strchr") { return true } else { (print "") }
    if (== name "strrchr") { return true } else { (print "") }
    if (== name "strstr") { return true } else { (print "") }
    if (== name "strtol") { return true } else { (print "") }
    if (== name "strtod") { return true } else { (print "") }
    if (== name "strtok") { return true } else { (print "") }
    /* C standard library: <math.h> + <stdlib.h> */
    if (== name "abs") { return true } else { (print "") }
    if (== name "sqrt") { return true } else { (print "") }
    if (== name "sin") { return true } else { (print "") }
    if (== name "cos") { return true } else { (print "") }
    if (== name "tan") { return true } else { (print "") }
    if (== name "floor") { return true } else { (print "") }
    if (== name "ceil") { return true } else { (print "") }
    if (== name "round") { return true } else { (print "") }
    if (== name "pow") { return true } else { (print "") }
    if (== name "fmod") { return true } else { (print "") }
    if (== name "atan") { return true } else { (print "") }
    if (== name "log") { return true } else { (print "") }
    if (== name "log2") { return true } else { (print "") }
    if (== name "log10") { return true } else { (print "") }
    if (== name "exp") { return true } else { (print "") }
    if (== name "exp2") { return true } else { (print "") }
    if (== name "asin") { return true } else { (print "") }
    if (== name "acos") { return true } else { (print "") }
    if (== name "atan2") { return true } else { (print "") }
    if (== name "cbrt") { return true } else { (print "") }
    if (== name "hypot") { return true } else { (print "") }
    if (== name "trunc") { return true } else { (print "") }
    if (== name "rint") { return true } else { (print "") }
    if (== name "nearbyint") { return true } else { (print "") }
    if (== name "remainder") { return true } else { (print "") }
    if (== name "rand") { return true } else { (print "") }
    if (== name "srand") { return true } else { (print "") }
    if (== name "exit") { return true } else { (print "") }
    if (== name "atoi") { return true } else { (print "") }
    if (== name "atof") { return true } else { (print "") }
    if (== name "malloc") { return true } else { (print "") }
    if (== name "calloc") { return true } else { (print "") }
    if (== name "realloc") { return true } else { (print "") }
    if (== name "free") { return true } else { (print "") }
    /* C standard library: <stdio.h> */
    if (== name "printf") { return true } else { (print "") }
    if (== name "fprintf") { return true } else { (print "") }
    if (== name "sprintf") { return true } else { (print "") }
    if (== name "snprintf") { return true } else { (print "") }
    if (== name "sscanf") { return true } else { (print "") }
    if (== name "getchar") { return true } else { (print "") }
    if (== name "putchar") { return true } else { (print "") }
    if (== name "puts") { return true } else { (print "") }
    if (== name "fopen") { return true } else { (print "") }
    if (== name "fclose") { return true } else { (print "") }
    if (== name "fread") { return true } else { (print "") }
    if (== name "fwrite") { return true } else { (print "") }
    /* C standard library: <time.h> */
    if (== name "time") { return true } else { (print "") }
    if (== name "clock") { return true } else { (print "") }
    /* C standard library: <unistd.h> */
    if (== name "sleep") { return true } else { (print "") }
    if (== name "usleep") { return true } else { (print "") }
    return false
}

shadow is_runtime_declared_extern {
    assert (is_runtime_declared_extern "printf")
    assert (is_runtime_declared_extern "malloc")
    assert (is_runtime_declared_extern "nl_sb_new")
    assert (is_runtime_declared_extern "list_int_new")
    assert (not (is_runtime_declared_extern "my_custom_func"))
    assert (not (is_runtime_declared_extern "nl_fs_list_files_ci"))
    assert (not (is_runtime_declared_extern "my_list_int_hook"))
    assert (not (is_runtime_declared_extern "___module_function_count_probe"))
}

fn generate_function_prototypes(parser: Parser) -> string {
    let mut sb: array<string> = []
    set sb (cg_append sb "\n/* Extern function declarations (not covered by headers) */\n")
    let n: int = (parser_get_function_count parser)
    let mut i: int = 0
    let mut emitted_fns: array<string> = []

    while (< i n) {
        let f: ASTFunction = (parser_get_function parser i)
        if (< f.body 0) {
            if (not (is_runtime_declared_extern f.name)) {
                let mut fn_dup: bool = false
                let mut fdi: int = 0
                while (< fdi (array_length emitted_fns)) {
                    if (== (at emitted_fns fdi) f.name) { set fn_dup true } else { (print "") }
                    set fdi (+ fdi 1)
                }
                if (not fn_dup) {
                set emitted_fns (array_push emitted_fns f.name)
                let mut names: array<string> = []
                let mut ctypes: array<string> = []
                let mut j: int = 0
                while (< j f.param_count) {
                    let let_node: ASTLet = (parser_get_let parser (+ f.param_start j))
                    set names (array_push names let_node.name)
                    set ctypes (array_push ctypes (type_to_c let_node.var_type))
                    set j (+ j 1)
                }
                let c_ret: string = (type_to_c f.return_type)
                set sb (cg_append sb "extern ")
                set sb (cg_append sb c_ret)
                set sb (cg_append sb " ")
                set sb (cg_append sb f.name)
                set sb (cg_append sb "(")
                let mut k: int = 0
                while (< k (array_length names)) {
                    if (> k 0) {
                        set sb (cg_append sb ", ")
                    } else { (print "") }
                    set sb (cg_append sb (at ctypes k))
                    set sb (cg_append sb " ")
                    set sb (cg_append sb (at names k))
                    set k (+ k 1)
                }
                if (== (array_length names) 0) {
                    set sb (cg_append sb "void")
                } else { (print "") }
                set sb (cg_append sb ");\n")
                } else { (print "") }
            } else { (print "") }
        } else { (print "") }
        set i (+ i 1)
    }

    set sb (cg_append sb "\n/* Function prototypes */\n")
    set i 0

    while (< i n) {
        let f: ASTFunction = (parser_get_function parser i)

        if (< f.body 0) {
            set i (+ i 1)
        } else {
        let mut fn_dup2: bool = false
        let mut fdi2: int = 0
        while (< fdi2 (array_length emitted_fns)) {
            if (== (at emitted_fns fdi2) f.name) { set fn_dup2 true } else { (print "") }
            set fdi2 (+ fdi2 1)
        }
        if (not fn_dup2) {
        set emitted_fns (array_push emitted_fns f.name)
        let mut names: array<string> = []
        let mut ctypes: array<string> = []

        let mut j: int = 0
        while (< j f.param_count) {
            let let_node: ASTLet = (parser_get_let parser (+ f.param_start j))
            set names (array_push names let_node.name)
            set ctypes (array_push ctypes (type_to_c let_node.var_type))
            set j (+ j 1)
        }

        let sig: string = (gen_function_signature f.name names ctypes f.return_type)
        set sb (cg_append sb sig)
        set sb (cg_append sb ";\n")
        } else { (print "") }

        set i (+ i 1)
        }
    }

    set sb (cg_append sb "\n")
    return (cg_build sb)
}

shadow generate_function_prototypes {
    let toks: List<LexerToken> = (tokenize_string "fn f(x: int) -> int { return x }" "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let c: string = (generate_function_prototypes p)
    assert (> (str_length c) 0)
}

fn lookup_struct_field_type(parser: Parser, struct_name: string, field_name: string) -> string {
    let sc: int = (parser_get_struct_def_count parser)
    let mut si: int = 0
    while (< si sc) {
        let s: ASTStruct = (parser_get_struct_def parser si)
        if (== s.name struct_name) {
            let fc: int = (array_length s.field_names)
            let mut fi: int = 0
            while (< fi fc) {
                if (== (at s.field_names fi) field_name) {
                    return (at s.field_types fi)
                } else { (print "") }
                set fi (+ fi 1)
            }
        } else { (print "") }
        set si (+ si 1)
    }
    return ""
}

shadow lookup_struct_field_type {
    let src: string = "struct Point { x: int, y: bool } fn main() -> int { return 0 }"
    let toks: List<LexerToken> = (tokenize_string src "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let t: string = (lookup_struct_field_type p "Point" "x")
    assert (== t "int")
    let t2: string = (lookup_struct_field_type p "Point" "z")
    assert (== t2 "")
}

# I retain the concrete field annotation when a literal is nested in a union.
fn lookup_union_payload_type(parser: Parser, union_name: string, variant: string, field_name: string, concrete: string) -> string {
    let mut ui: int = 0
    while (< ui (parser_get_union_count parser)) {
        let definition: ASTUnion = (parser_get_union parser ui)
        if (== definition.name union_name) {
            let mut offset: int = 0
            let mut vi: int = 0
            while (< vi definition.variant_count) {
                let count: int = (at definition.variant_field_counts vi)
                if (== (at definition.variant_names vi) variant) {
                    let mut fi: int = 0
                    while (< fi count) {
                        if (== (at definition.variant_field_names (+ offset fi)) field_name) {
                            return (substitute_type_parameters (at definition.variant_field_types (+ offset fi)) definition.generic_params (extract_type_args concrete))
                        }
                        set fi (+ fi 1)
                    }
                }
                set offset (+ offset count)
                set vi (+ vi 1)
            }
        }
        set ui (+ ui 1)
    }
    return ""
}
shadow lookup_union_payload_type {
    let source: string = "union Box<T> { None {}, Some { values: array<T> } }"
    let tokens: List<LexerToken> = (tokenize_string source "payload.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "payload.nano")
    assert (== (lookup_union_payload_type parser "Box" "Some" "values" "Box<Plain>") "array<Plain>")
    assert (== (lookup_union_payload_type parser "Box" "Some" "values" "Box<array<int>>") "array<array<int>>")
    assert (== (lookup_union_payload_type parser "Box" "None" "values" "Box<int>") "")
}

fn function_value_argument_type(signature: string, index: int) -> string {
    if (not (is_fn_type signature)) { return "" }
    let parameters: array<string> = (parse_fn_type_params signature)
    if (or (< index 0) (>= index (array_length parameters))) { return "" }
    return (at parameters index)
}
shadow function_value_argument_type {
    assert (== (function_value_argument_type "fn(Box<int>,Choice)->int" 0) "Box<int>")
    assert (== (function_value_argument_type "fn(Box<int>,Choice)->int" 1) "Choice")
    assert (== (function_value_argument_type "int" 0) "")
    assert (== (function_value_argument_type "fn()->int" 0) "")
}

fn declared_call_argument_type(parser: Parser, name: string, index: int) -> string {
    let mut i: int = 0
    while (< i (parser_get_function_count parser)) {
        let func: ASTFunction = (parser_get_function parser i)
        if (and (== func.name name) (and (>= index 0) (< index func.param_count))) {
            return (parser_get_let parser (+ func.param_start index)).var_type
        }
        set i (+ i 1)
    }
    return ""
}

shadow declared_call_argument_type {
    let tokens: List<LexerToken> = (tokenize_string "fn names(xs: array<string>) -> int { return (array_length xs) }" "args.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "args.nano")
    assert (== (declared_call_argument_type parser "names" 0) "array<string>")
    assert (== (declared_call_argument_type parser "names" 1) "")
    assert (== (declared_call_argument_type parser "missing" 0) "")
}

let mut reduce_emission_error: string = ""

fn reduce_emission_fail(message: string) -> string {
    if (== reduce_emission_error "") { set reduce_emission_error message }
    return "0"
}
shadow reduce_emission_fail {
    let saved: string = reduce_emission_error
    set reduce_emission_error ""
    let first: string = (reduce_emission_fail "first")
    let second: string = (reduce_emission_fail "second")
    assert (== first "0")
    assert (== second "0")
    assert (== reduce_emission_error "first")
    set reduce_emission_error saved
}

pub fn transpile_last_error() -> string { return reduce_emission_error }
shadow transpile_last_error {
    let saved: string = reduce_emission_error
    set reduce_emission_error "I require the exact reduce ABI."
    assert (== (transpile_last_error) "I require the exact reduce ABI.")
    set reduce_emission_error saved
}

# I use actual lexical and declaration ownership before array intrinsic spelling.
fn native_array_operation(name: string) -> bool {
    let names: array<string> = ["array_new", "array_push", "array_set", "array_get", "at", "array_pop", "map", "array_map", "filter", "array_filter", "reduce", "array_fold", "array_slice", "array_remove_at"]
    let mut i: int = 0
    while (< i (array_length names)) {
        if (== name (at names i)) { return true }
        set i (+ i 1)
    }
    return false
}
shadow native_array_operation {
    assert (native_array_operation "array_new")
    assert (native_array_operation "map")
    assert (not (native_array_operation "module.map"))
}
fn native_array_builtin(parser: Parser, identifier: ASTIdentifier, env: GenEnv) -> bool {
    let mut i: int = 0
    while (< i (array_length env.names)) {
        if (== (at env.names i) identifier.name) { return false }
        set i (+ i 1)
    }
    let name: string = (mb_resolve identifier.name identifier.line env.names)
    return (and (native_array_operation name) (not (or (has_function_named parser name) (is_extern_function parser name))))
}
shadow native_array_builtin {
    let tokens: List<LexerToken> = (tokenize_string "fn map(x: (int,bool))->(int,bool){return x} fn main()->int{return 0}" "array-owner.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "array-owner.nano")
    let identifier: ASTIdentifier = ASTIdentifier { node_type: ParseNodeType.PNODE_IDENTIFIER, name: "map", line: 1, column: 1 }
    assert (not (native_array_builtin parser identifier (genenv_new "main")))
    let local: GenEnv = (genenv_put (genenv_new "main") "map" "fn((int,bool))->bool" false)
    assert (not (native_array_builtin parser identifier local))
    let call_tokens: List<LexerToken> = (tokenize_string "fn filter(x: (int,bool))->(int,bool){return x} fn main()->int{return (filter pair)}" "array-call.nano" (list_CompilerDiagnostic_new))
    let calls: Parser = (parse_program call_tokens (list_LexerToken_length call_tokens) "array-call.nano")
    let call: ASTCall = (parser_get_call calls 0)
    let chosen: ASTIdentifier = (parser_get_identifier calls call.function)
    let values: GenEnv = (genenv_put (genenv_new "main") "pair" "(int,bool)" false)
    assert (== (infer_expr_type calls 0 ParseNodeType.PNODE_CALL values) "(int,bool)")
    assert (str_contains (generate_bound_push calls call chosen values 0) "__nl_declared_filter")
    let bound: GenEnv = (genenv_put values "filter" "fn((int,bool))->bool" false)
    assert (== (infer_expr_type calls 0 ParseNodeType.PNODE_CALL bound) "bool")
    assert (str_contains (generate_bound_push calls call chosen bound 0) " = nl_filter;")
}

# I select only the unbound push spelling as a builtin.
fn legacy_push_builtin(parser: Parser, identifier: ASTIdentifier, env: GenEnv) -> bool {
    let mut i: int = 0
    while (< i (array_length env.names)) {
        if (== (at env.names i) identifier.name) { return false }
        set i (+ i 1)
    }
    let name: string = (mb_resolve identifier.name identifier.line env.names)
    if (!= name "array_push") { return false }
    return (not (has_function_named parser name))
}
