fn generate_native_opaque_array_call(parser: Parser, call: ASTCall, name: string, node_id: int, env: GenEnv, expected: string) -> string {
    if (!= call.function_type ParseNodeType.PNODE_IDENTIFIER) { return "" }
    if (not (native_array_builtin parser (parser_get_identifier parser call.function) env)) { return "" }
    let make: bool = (== name "array_new")
    let push: bool = (== name "array_push")
    let replace: bool = (== name "array_set")
    let get: bool = (or (== name "at") (== name "array_get"))
    let pop: bool = (== name "array_pop")
    let mapping: bool = (or (== name "map") (== name "array_map"))
    let filtering: bool = (or (== name "filter") (== name "array_filter"))
    if (not (or (or make push) (or (or replace get) (or pop (or mapping filtering))))) { return "" }
    let mut count: int = 2
    if replace { set count 3 }
    if pop { set count 1 }
    if (!= call.arg_count count) { return "" }
    let first: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
    let mut element: string = (full_array_element_type (infer_expr_type parser first.node_id first.node_type env))
    if make {
        set element (full_array_element_type expected)
        if (or (== element "") (== element "unknown")) {
            let initial: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
            set element (infer_expr_type parser initial.node_id initial.node_type env)
            if (== element "") { set element (native_array_callback_type parser initial env) }
        }
    }
    if (and push (or (== element "") (== element "unknown"))) {
        let value: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
        set element (infer_expr_type parser value.node_id value.node_type env)
    }
    if (or (== element "") (== element "unknown")) {
        if (or get pop) { set element expected }
        else { set element (full_array_element_type expected) }
    }
    let mut output: string = element
    let mut callback_type: string = ""
    if (or mapping filtering) {
        set callback_type (native_array_callback_type parser (parser_get_call_arg parser (+ call.arg_start 1)) env)
        if (or (== element "") (== element "unknown")) {
            let parameters: array<string> = (parse_fn_type_params callback_type)
            if (== (array_length parameters) 1) { set element (at parameters 0) }
        }
        set output element
        if mapping { set output (parse_fn_type_return callback_type) }
    }
    if (not (or (native_array_exact element) (native_array_exact output))) { return "" }
    if (or mapping filtering) {
        let parameters: array<string> = (parse_fn_type_params callback_type)
        let mut valid: bool = (== (array_length parameters) 1)
        if valid { set valid (native_array_same_type element (at parameters 0)) }
        if filtering { set valid (and valid (== (parse_fn_type_return callback_type) "bool")) }
        if (not valid) { return (reduce_emission_fail "I require the same complete element annotation in this callback.") }
    }
    let prefix: string = (+ (nb_emission_prefix) (+ "array_arg_" (+ (int_to_string node_id) "_")))
    let mut code: string = "({ "
    let mut i: int = 0
    while (< i count) {
        let reference: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start i))
        let mut annotation: string = ""
        let mut ctype: string = "__auto_type"
        if (or (and (or make push) (== i 1)) (and replace (== i 2))) {
            set annotation element
            set ctype (type_to_c element)
        }
        if (and (not make) (== i 0)) { set annotation (+ "array<" (+ element ">")) set ctype "DynArray*" }
        let value: string = (generate_expression parser reference.node_id reference.node_type env annotation)
        set code (+ code (+ ctype (+ " " (+ prefix (+ (int_to_string i) (+ " = " (+ value "; ")))))))
        set i (+ i 1)
    }
    if make {
        set code (+ code (+ "if (" (+ prefix (+ "0 < 0) { fputs(\"I require a non-negative array count\\n\", stderr); abort(); } DynArray* _oa = dyn_array_new(ELEM_STRUCT); for (int64_t _oi = 0; _oi < " (+ prefix "0; ++_oi) { ")))))
        set code (+ code (native_array_push_code element "_oa" (+ prefix "1")))
        return (+ code "} _oa; })")
    }
    set code (+ code (+ "DynArray* _oa = " (+ prefix "0; ")))
    if (native_array_exact element) { set code (+ code (native_array_shape_code element "_oa")) }
    if push { return (+ code (+ (native_array_push_code element "_oa" (+ prefix "1")) "_oa; })")) }
    if replace { return (+ code (+ "dyn_array_set_struct(_oa, " (+ prefix (+ "1, &" (+ prefix (+ "2, sizeof(" (+ prefix "2)); })"))))))) }
    if get { return (+ code (+ (native_array_load_code element "_oa" (+ prefix "1") "_ov") "_ov; })")) }
    if pop {
        return (+ code (+ (type_to_c element) " _ov = {0}; if (_oa->length != 0) { bool _ok; dyn_array_pop_struct(_oa, &_ov, sizeof(_ov), &_ok); assert(_ok); } _ov; })"))
    }
    let mut tag: string = (elem_enum_from_elem_type output)
    if (native_array_exact output) { set tag "ELEM_STRUCT" }
    set code (+ code (+ "__auto_type _of = " (+ prefix (+ "1; DynArray* _out = dyn_array_new(" (+ tag "); int64_t _on = dyn_array_length(_oa); for (int64_t _oi = 0; _oi < _on; ++_oi) { ")))))
    set code (+ code (native_array_load_code element "_oa" "_oi" "_ov"))
    if filtering {
        set code (+ code "if (_of(_ov)) { ")
        set code (+ code (native_array_push_code element "_out" "_ov"))
        set code (+ code "} ")
    } else {
        set code (+ code (+ (type_to_c output) " _mapped = _of(_ov); "))
        set code (+ code (native_array_push_code output "_out" "_mapped"))
    }
    return (+ code "} _out; })")
}
