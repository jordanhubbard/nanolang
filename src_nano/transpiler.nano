fn native_array_callback_type(parser: Parser, reference: ASTStmtRef, env: GenEnv) -> string {
    let inferred: string = (infer_expr_type parser reference.node_id reference.node_type env)
    if (is_fn_type inferred) { return inferred }
    if (!= reference.node_type ParseNodeType.PNODE_IDENTIFIER) { return "" }
    let identifier: ASTIdentifier = (parser_get_identifier parser reference.node_id)
    if (!= (genenv_get env identifier.name) "") { return "" }
    let name: string = (mb_resolve identifier.name identifier.line env.names)
    let mut i: int = 0
    while (< i (parser_get_function_count parser)) {
        let declaration: ASTFunction = (parser_get_function parser i)
        if (== declaration.name name) {
            let mut signature: string = "fn("
            let mut parameter: int = 0
            while (< parameter declaration.param_count) {
                if (> parameter 0) { set signature (+ signature ",") }
                set signature (+ signature (parser_get_let parser (+ declaration.param_start parameter)).var_type)
                set parameter (+ parameter 1)
            }
            return (+ signature (+ ")->" declaration.return_type))
        }
        set i (+ i 1)
    }
    return ""
}
