    assert (not (legacy_push_builtin parser identifier (genenv_put env "array_push" "" false)))
    let declared_tokens: List<LexerToken> = (tokenize_string "fn array_push(a: int, b: int) -> int { return (+ a b) } fn main() -> int { return (array_push 2 3) }" "push-declared.nano" (list_CompilerDiagnostic_new))
    let declared: Parser = (parse_program declared_tokens (list_LexerToken_length declared_tokens) "push-declared.nano")
    assert (not (legacy_push_builtin declared identifier env))
}

# I capture the selected callee and each argument before invoking it.
fn generate_bound_push(parser: Parser, call: ASTCall, identifier: ASTIdentifier, env: GenEnv, node_id: int) -> string {
    let name: string = (mb_resolve identifier.name identifier.line env.names)
    let signature: string = (genenv_get env identifier.name)
    let mut callee: string = (c_func_name_for_call name)
    if (has_function_named parser name) { set callee (c_func_name_for_definition name) }
    if (is_extern_function parser name) { set callee name }
    let mut j: int = 0
    while (< j (array_length env.names)) {
        if (== (at env.names j) identifier.name) { set callee (genenv_c_name env identifier.name) }
        set j (+ j 1)
    }
    let suffix: string = (int_to_string node_id)
    let fn_temp: string = (+ "_nl_push_fn_" suffix)
    let mut parts: array<string> = []
    set parts (cg_append parts (+ "({ __auto_type " (+ fn_temp (+ " = " (+ callee "; ")))))
    let mut i: int = 0
    while (< i call.arg_count) {
        let arg: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start i))
        let mut expected: string = (declared_call_argument_type parser name i)
        if (is_fn_type signature) { set expected (function_value_argument_type signature i) }
        let value: string = (generate_expression parser arg.node_id arg.node_type env expected)
        let temporary: string = (+ "_nl_push_arg_" (+ suffix (+ "_" (int_to_string i))))
        set parts (cg_append parts (+ "__auto_type " (+ temporary (+ " = " (+ value "; ")))))
        set i (+ i 1)
    }
    set parts (cg_append parts (+ fn_temp "("))
    set i 0
    while (< i call.arg_count) {
        if (> i 0) { set parts (cg_append parts ", ") }
        set parts (cg_append parts (+ "_nl_push_arg_" (+ suffix (+ "_" (int_to_string i)))))
        set i (+ i 1)
    }
    set parts (cg_append parts "); })")
    return (cg_build parts)
}
shadow generate_bound_push {
    let tokens: List<LexerToken> = (tokenize_string "fn array_push(a: int, b: int) -> int { return (+ a b) } fn main() -> int { return (array_push 2 3) }" "push-code.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "push-code.nano")
    let call: ASTCall = (parser_get_call parser 0)
    let identifier: ASTIdentifier = (parser_get_identifier parser call.function)
    let env: GenEnv = (genenv_new "main")
    let code: string = (generate_bound_push parser call identifier env 17)
    assert (str_contains code "__auto_type _nl_push_fn_17 = __nl_declared_array_push;")
    assert (str_contains code "__auto_type _nl_push_arg_17_0 = 2; __auto_type _nl_push_arg_17_1 = 3;")
    assert (str_contains code "_nl_push_fn_17(_nl_push_arg_17_0, _nl_push_arg_17_1); })")
    assert (== (generate_expression parser call.function call.function_type env "") "__nl_declared_array_push")
    let local: GenEnv = (genenv_put env "array_push" "fn(int,int)->float" false)
    assert (== (infer_expr_type parser 0 ParseNodeType.PNODE_CALL local) "float")
    assert (== (generate_expression parser call.function call.function_type local "") "nl_array_push")
}

