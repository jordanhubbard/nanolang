fn is_extern_function(parser: Parser, name: string) -> bool {
    let n: int = (parser_get_function_count parser)
    let mut i: int = 0
    while (< i n) {
        let f: ASTFunction = (parser_get_function parser i)
        if (and (== f.name name) (< f.body 0)) { return true } else { (print "") }
        set i (+ i 1)
    }
    return false
}

shadow is_extern_function {
    let toks: List<LexerToken> = (tokenize_string "extern fn foo() -> int" "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (is_extern_function p "foo")
}

fn extern_has_native_array(parser: Parser, name: string) -> bool {
    let mut i: int = 0
    while (< i (parser_get_function_count parser)) {
        let f: ASTFunction = (parser_get_function parser i)
        if (and (== f.name name) (< f.body 0)) {
            if (transp_str_starts_with f.return_type "array<") { return true }
            let mut p: int = 0
            while (< p f.param_count) {
                let param: ASTLet = (parser_get_let parser (+ f.param_start p))
                if (transp_str_starts_with param.var_type "array<") { return true }
                set p (+ p 1)
            }
        }
        set i (+ i 1)
    }
    return false
}

shadow extern_has_native_array {
    let tokens: List<LexerToken> = (tokenize_string "extern fn values() -> array<int> extern fn consume(a: array<string>) -> int extern fn scalar() -> int fn local(a: array<int>) -> int { return 0 }" "abi.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program tokens (list_LexerToken_length tokens) "abi.nano")
    assert (extern_has_native_array p "values")
    assert (extern_has_native_array p "consume")
    assert (not (extern_has_native_array p "scalar"))
    assert (not (extern_has_native_array p "local"))
    assert (not (extern_has_native_array p "missing"))
}

fn guard_native_array_reference(parser: Parser, name: string, c_name: string) -> string {
    if (not (extern_has_native_array parser name)) { return c_name }
    let mut parts: array<string> = []
    set parts (cg_append parts "(nano_require_native_array_abi((void*)")
    set parts (cg_append parts c_name)
    set parts (cg_append parts ", \"")
    set parts (cg_append parts c_name)
    set parts (cg_append parts "__nano_array_abi\", NANO_DYN_ARRAY_ABI_VERSION, \"")
    set parts (cg_append parts c_name)
    set parts (cg_append parts "\"), ")
    set parts (cg_append parts c_name)
    set parts (cg_append parts ")")
    return (cg_build parts)
}

shadow guard_native_array_reference {
    let tokens: List<LexerToken> = (tokenize_string "extern fn values() -> array<int>" "abi.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program tokens (list_LexerToken_length tokens) "abi.nano")
    assert (== (guard_native_array_reference p "values" "values") "(nano_require_native_array_abi((void*)values, \"values__nano_array_abi\", NANO_DYN_ARRAY_ABI_VERSION, \"values\"), values)")
    assert (== (guard_native_array_reference p "missing" "nl_missing") "nl_missing")
}

fn genenv_new(scope: string) -> GenEnv {
    return GenEnv { names: [], types: [], mut_flags: [], global_flags: [], underscore_name: "nl__", scope: scope }
}

shadow genenv_new {
    let env: GenEnv = (genenv_new "main")
    assert (== (array_length env.names) 0)
    assert (== (array_length env.types) 0)
    assert (== (array_length env.mut_flags) 0)
    assert (== (array_length env.global_flags) 0)
    assert (== env.scope "main")
}

fn genenv_copy(env: GenEnv) -> GenEnv {
    let mut names: array<string> = []
    let mut types: array<string> = []
    let mut flags: array<bool> = []
    let mut globals: array<bool> = []
    let mut i: int = 0
    while (< i (array_length env.names)) {
        set names (array_push names (at env.names i))
        set types (array_push types (at env.types i))
        set flags (array_push flags (at env.mut_flags i))
        set globals (array_push globals (at env.global_flags i))
        set i (+ i 1)
    }
    return GenEnv { names: names, types: types, mut_flags: flags, global_flags: globals, underscore_name: env.underscore_name, scope: env.scope }
}
shadow genenv_copy {
    let outer: GenEnv = (genenv_put (genenv_new "outer") "selected" "fn() -> int" false)
    let copy: GenEnv = (genenv_copy outer)
    let extended: array<string> = (array_push copy.names "inner")
    assert (== (array_length outer.names) 1)
    assert (== (array_length extended) 2)
    assert (== (at copy.types 0) "fn() -> int")
    let inner: GenEnv = (genenv_put outer "selected" "int" true)
    assert (== (genenv_get inner "selected") "int")
    assert (== (genenv_get outer "selected") "fn() -> int")
    assert (== (array_length outer.names) 1)
}

fn genenv_put(env: GenEnv, name: string, t: string, is_mut: bool) -> GenEnv {
    let copy: GenEnv = (genenv_copy env)
    let new_names: array<string> = (array_push copy.names name)
    let new_types: array<string> = (array_push copy.types t)
    let new_flags: array<bool> = (array_push copy.mut_flags is_mut)
    let new_globals: array<bool> = (array_push copy.global_flags false)
    return GenEnv { names: new_names, types: new_types, mut_flags: new_flags, global_flags: new_globals, underscore_name: (cond ((== name "_") "nl__") (else env.underscore_name)), scope: env.scope }
}

shadow genenv_put {
    let env: GenEnv = (genenv_new "test")
    let env2: GenEnv = (genenv_put env "x" "int" false)
    assert (== (array_length env2.names) 1)
    assert (== (at env2.names 0) "x")
    assert (== (at env2.types 0) "int")
    assert (== (at env2.mut_flags 0) false)
    assert (== (at env2.global_flags 0) false)
    let env3: GenEnv = (genenv_put env2 "y" "int" true)
    assert (== (array_length env2.names) 1)
    assert (== (at env3.mut_flags 1) true)
    assert (== (at env3.global_flags 1) false)
}

fn genenv_put_global(env: GenEnv, name: string, t: string, is_mut: bool) -> GenEnv {
    let copy: GenEnv = (genenv_copy env)
    let new_names: array<string> = (array_push copy.names name)
    let new_types: array<string> = (array_push copy.types t)
    let new_flags: array<bool> = (array_push copy.mut_flags is_mut)
    let new_globals: array<bool> = (array_push copy.global_flags true)
    return GenEnv { names: new_names, types: new_types, mut_flags: new_flags, global_flags: new_globals, underscore_name: (cond ((== name "_") "nl__") (else env.underscore_name)), scope: env.scope }
}

shadow genenv_put_global {
    let env: GenEnv = (genenv_new "test")
    let env2: GenEnv = (genenv_put_global env "counter" "int" true)
    assert (== (at env2.global_flags 0) true)
    assert (== (at env2.mut_flags 0) true)
    assert (== (at env2.types 0) "int")
}

fn genenv_with_underscore(env: GenEnv, name: string) -> GenEnv {
    return GenEnv { names: env.names, types: env.types, mut_flags: env.mut_flags,
        global_flags: env.global_flags, underscore_name: name, scope: env.scope }
}

shadow genenv_with_underscore {
    let outer: GenEnv = (genenv_new "main")
    let inner: GenEnv = (genenv_with_underscore outer "__nl_underscore_1")
    assert (== outer.underscore_name "nl__")
    assert (== inner.underscore_name "__nl_underscore_1")
    assert (== inner.scope "main")
}

# I keep source identities while assigning each underscore local its own C name.
fn genenv_c_name(env: GenEnv, name: string) -> string {
    if (== name "_") { return env.underscore_name }
    return (+ "nl_" (mangle_name name))
}

shadow genenv_c_name {
    let mut env: GenEnv = (genenv_new "main")
    assert (== (genenv_c_name env "_") "nl__")
    set env (genenv_with_underscore env "__nl_underscore_4")
    assert (== (genenv_c_name env "_") "__nl_underscore_4")
    assert (== (genenv_c_name env "value") "nl_value")
    let inner: GenEnv = (genenv_copy env)
    assert (== (genenv_c_name inner "_") "__nl_underscore_4")
    assert (== (genenv_c_name (genenv_put env "_" "int" false) "_") "nl__")
}

fn genenv_get(env: GenEnv, name: string) -> string {
    let mut i: int = (- (array_length env.names) 1)
    while (>= i 0) {
        if (== (at env.names i) name) {
            return (at env.types i)
        } else {
            set i (- i 1)
        }
    }
    return ""
}

shadow genenv_get {
    let env: GenEnv = (genenv_new "test")
    let env2: GenEnv = (genenv_put env "x" "int" false)
    let env3: GenEnv = (genenv_put env2 "y" "bool" false)
    assert (== (genenv_get env3 "x") "int")
    assert (== (genenv_get env3 "y") "bool")
    assert (== (genenv_get env3 "unknown") "")
}

fn genenv_get_mut(env: GenEnv, name: string) -> bool {
    let mut i: int = (- (array_length env.names) 1)
    while (>= i 0) {
        if (== (at env.names i) name) {
            return (at env.mut_flags i)
        } else {
            set i (- i 1)
        }
    }
    return false
}

shadow genenv_get_mut {
    let env: GenEnv = (genenv_new "test")
    let env2: GenEnv = (genenv_put env "x" "int" false)
    let env3: GenEnv = (genenv_put env2 "counter" "int" true)
    assert (== (genenv_get_mut env3 "counter") true)
    assert (== (genenv_get_mut env3 "x") false)
    assert (== (genenv_get_mut env3 "unknown") false)
}

fn genenv_get_global(env: GenEnv, name: string) -> bool {
    let mut i: int = (- (array_length env.names) 1)
    while (>= i 0) {
        if (== (at env.names i) name) {
            return (at env.global_flags i)
        } else {
            set i (- i 1)
        }
    }
    return false
}

shadow genenv_get_global {
    let env: GenEnv = (genenv_new "test")
    let env2: GenEnv = (genenv_put env "local_x" "int" false)
    let env3: GenEnv = (genenv_put_global env2 "global_counter" "int" true)
    assert (== (genenv_get_global env3 "global_counter") true)
    assert (== (genenv_get_global env3 "local_x") false)
    assert (== (genenv_get_global env3 "unknown") false)
}

/* --- String interpolation helpers --- */

fn transp_is_ident_start_str(c: string) -> bool {
    return (str_contains "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_" c)
}

shadow transp_is_ident_start_str {
    assert (transp_is_ident_start_str "a")
    assert (transp_is_ident_start_str "Z")
    assert (transp_is_ident_start_str "_")
    assert (not (transp_is_ident_start_str "0"))
    assert (not (transp_is_ident_start_str " "))
    assert (not (transp_is_ident_start_str "+"))
}

fn transp_is_ident_char_str(c: string) -> bool {
    return (str_contains "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789" c)
}

shadow transp_is_ident_char_str {
    assert (transp_is_ident_char_str "a")
    assert (transp_is_ident_char_str "Z")
    assert (transp_is_ident_char_str "_")
    assert (transp_is_ident_char_str "0")
    assert (transp_is_ident_char_str "9")
    assert (not (transp_is_ident_char_str " "))
    assert (not (transp_is_ident_char_str "+"))
}

/* Given an identifier and its type, emit the C expression that converts it to const char*.
   Uses nl_int_to_string / nl_float_to_string as emitted by gen_c_runtime. */
fn interp_to_str_expr(ident: string, type_str: string, env: GenEnv) -> string {
    let c_name: string = (genenv_c_name env ident)
    if (== type_str "int") {
        return (+ (+ "nl_int_to_string(" c_name) ")")
    } else { if (== type_str "float") {
        return (+ (+ "nl_float_to_string(" c_name) ")")
    } else { if (== type_str "bool") {
        return (+ (+ "nl_int_to_string(" c_name) ")")
    } else {
        /* string or unknown - use directly */
        return c_name
    } } }
}

shadow interp_to_str_expr {
    assert (== (interp_to_str_expr "_" "int" (genenv_with_underscore (genenv_new "test") "__nl_underscore_1")) "nl_int_to_string(__nl_underscore_1)")
    assert (== (interp_to_str_expr "x" "int" (genenv_new "test")) "nl_int_to_string(nl_x)")
    assert (== (interp_to_str_expr "val" "float" (genenv_new "test")) "nl_float_to_string(nl_val)")
    assert (== (interp_to_str_expr "msg" "string" (genenv_new "test")) "nl_msg")
    assert (== (interp_to_str_expr "flag" "bool" (genenv_new "test")) "nl_int_to_string(nl_flag)")
}

/* Expand "Hello, {name}!" into nl_str_concat(...) chain if interpolation present.
   Returns C expression. raw is the string content (no surrounding quotes). */
fn expand_string_interp(raw: string, env: GenEnv) -> string {
    let len: int = (str_length raw)
    let mut i: int = 0
    let mut current_lit: string = ""
    let mut parts: array<string> = []

    while (< i len) {
        let ch: string = (str_substring raw i 1)
        if (== ch "{") {
            if (< (+ i 1) len) {
                let next_ch: string = (str_substring raw (+ i 1) 1)
                if (== (transp_is_ident_start_str next_ch) true) {
                    /* Scan the identifier */
                    let mut j: int = (+ i 1)
                    while (and (< j len) (== (transp_is_ident_char_str (str_substring raw j 1)) true)) {
                        set j (+ j 1)
                    }
                    if (and (< j len) (== (str_substring raw j 1) "}")) {
                        /* Valid {ident} — emit literal so far, then conversion */
                        let ident: string = (str_substring raw (+ i 1) (- j (+ i 1)))
                        if (!= current_lit "") {
                            set parts (array_push parts (+ (+ "\"" current_lit) "\""))
                            set current_lit ""
                        }
                        let type_str: string = (genenv_get env ident)
                        set parts (array_push parts (interp_to_str_expr ident type_str env))
                        set i (+ j 1)
                    } else {
                        set current_lit (+ current_lit ch)
                        set i (+ i 1)
                    }
                } else {
                    set current_lit (+ current_lit ch)
                    set i (+ i 1)
                }
            } else {
                set current_lit (+ current_lit ch)
                set i (+ i 1)
            }
        } else {
            set current_lit (+ current_lit ch)
            set i (+ i 1)
        }
    }

    if (!= current_lit "") {
        set parts (array_push parts (+ (+ "\"" current_lit) "\""))
    }

    let parts_len: int = (array_length parts)
    if (== parts_len 0) {
        return "\"\""
    } else { if (== parts_len 1) {
        return (at parts 0)
    } else {
        /* Build nested nl_str_concat calls */
        let mut result: string = (at parts 0)
        let mut k: int = 1
        while (< k parts_len) {
            set result (+ (+ (+ "nl_str_concat(" result) ", ") (+ (at parts k) ")"))
            set k (+ k 1)
        }
        return result
    } }
}

shadow expand_string_interp {
    let env: GenEnv = (genenv_new "test")
    let env2: GenEnv = (genenv_put env "name" "string" false)
    let env3: GenEnv = (genenv_put env2 "n" "int" false)
    /* No interpolation - plain string */
    assert (== (expand_string_interp "hello" env3) "\"hello\"")
    /* Simple string ident */
    assert (== (expand_string_interp "Hello, {name}!" env3) "nl_str_concat(nl_str_concat(\"Hello, \", nl_name), \"!\")")
    /* Int ident */
    assert (== (expand_string_interp "count: {n}" env3) "nl_str_concat(\"count: \", nl_int_to_string(nl_n))")
}

fn is_array_type(t: string) -> bool {
    return (str_contains t "array<")
}

shadow is_array_type {
    assert (is_array_type "array<int>")
    assert (is_array_type "array<Point>")
    assert (not (is_array_type "int"))
    assert (not (is_array_type "List<int>"))
}

fn full_array_element_type(t: string) -> string {
    let length: int = (str_length t)
    if (and (transp_str_starts_with t "array<") (and (> length 7) (== (str_substring t (- length 1) 1) ">"))) {
        return (str_substring t 6 (- length 7))
    }
    return ""
}

shadow full_array_element_type {
    assert (== (full_array_element_type "array<array<float>>") "array<float>")
    assert (== (full_array_element_type "array<fn(array<int>)->int>") "fn(array<int>)->int")
    assert (== (full_array_element_type "Box<array<int>>") "")
}

fn array_elem_type_from_array_type(t: string) -> string {
    return (full_array_element_type t)
}

shadow array_elem_type_from_array_type {
    assert (== (array_elem_type_from_array_type "array<int>") "int")
    assert (== (array_elem_type_from_array_type "array<float>") "float")
    assert (== (array_elem_type_from_array_type "array<string>") "string")
    assert (== (array_elem_type_from_array_type "array<bool>") "bool")
    assert (== (array_elem_type_from_array_type "array<array<int>>") "array<int>")
    assert (== (array_elem_type_from_array_type "array<array<array<int>>>") "array<array<int>>")
    assert (== (array_elem_type_from_array_type "array<Point>") "Point")
}

fn elem_enum_from_elem_type(elem_type: string) -> string {
    if (== elem_type "float") { return "ELEM_FLOAT" }
    else { if (== elem_type "string") { return "ELEM_STRING" }
    else { if (== elem_type "bool") { return "ELEM_BOOL" }
    else { if (or (== elem_type "array") (is_array_type elem_type)) { return "ELEM_ARRAY" }
    else { if (type_is_struct elem_type) { return "ELEM_INT" }
    else { return "ELEM_INT" } } } } }
}

shadow elem_enum_from_elem_type {
    assert (== (elem_enum_from_elem_type "array<array<int>>") "ELEM_ARRAY")
    assert (== (elem_enum_from_elem_type "float") "ELEM_FLOAT")
    assert (== (elem_enum_from_elem_type "string") "ELEM_STRING")
    assert (== (elem_enum_from_elem_type "bool") "ELEM_BOOL")
    assert (== (elem_enum_from_elem_type "array") "ELEM_ARRAY")
    assert (== (elem_enum_from_elem_type "int") "ELEM_INT")
    assert (== (elem_enum_from_elem_type "Point") "ELEM_INT")
}

fn get_fn_from_elem_type(elem_type: string) -> string {
    if (== elem_type "float") { return "dyn_array_get_float" }
    else { if (== elem_type "string") { return "dyn_array_get_string" }
    else { if (== elem_type "bool") { return "dyn_array_get_bool" }
    else { if (or (== elem_type "array") (is_array_type elem_type)) { return "dyn_array_get_array" }
    else { if (type_is_struct elem_type) { return "dyn_array_get_int" }
    else { return "dyn_array_get_int" } } } } }
}

shadow get_fn_from_elem_type {
    assert (== (get_fn_from_elem_type "float") "dyn_array_get_float")
    assert (== (get_fn_from_elem_type "string") "dyn_array_get_string")
    assert (== (get_fn_from_elem_type "int") "dyn_array_get_int")
    assert (== (get_fn_from_elem_type "array<array<int>>") "dyn_array_get_array")
    assert (== (get_fn_from_elem_type "Point") "dyn_array_get_int")
}

fn push_fn_from_elem_type(elem_type: string) -> string {
    if (== elem_type "float") { return "dyn_array_push_float" }
    else { if (== elem_type "string") { return "dyn_array_push_string" }
    else { if (== elem_type "bool") { return "dyn_array_push_bool" }
    else { if (or (== elem_type "array") (is_array_type elem_type)) { return "dyn_array_push_array" }
    else { if (type_is_struct elem_type) { return "dyn_array_push_int" }
    else { return "dyn_array_push_int" } } } } }
}

fn is_array_of_struct(t: string) -> bool {
    if (and (str_contains t "array<") (str_contains t ">")) {
        let elem_t: string = (array_elem_type_from_array_type t)
        if (!= elem_t "") {
            return (type_is_struct elem_t)
        } else {
            return false
        }
    } else {
        return false
    }
}

shadow is_array_of_struct {
    assert (is_array_of_struct "array<Point>")
    assert (not (is_array_of_struct "array<int>"))
    assert (not (is_array_of_struct "int"))
    assert (not (is_array_of_struct "string"))
}

shadow push_fn_from_elem_type {
    assert (== (push_fn_from_elem_type "array<float>") "dyn_array_push_array")
    assert (== (push_fn_from_elem_type "float") "dyn_array_push_float")
    assert (== (push_fn_from_elem_type "bool") "dyn_array_push_bool")
    assert (== (push_fn_from_elem_type "int") "dyn_array_push_int")
    assert (== (push_fn_from_elem_type "Point") "dyn_array_push_int")
}

fn set_fn_from_elem_type(elem_type: string) -> string {
    if (== elem_type "float") { return "dyn_array_set_float" }
    else { if (== elem_type "string") { return "dyn_array_set_string" }
    else { if (== elem_type "bool") { return "dyn_array_set_bool" }
    else { if (or (== elem_type "array") (is_array_type elem_type)) { return "dyn_array_set_array" }
    else { if (type_is_struct elem_type) { return "dyn_array_set_int" }
    else { return "dyn_array_set_int" } } } } }
}

shadow set_fn_from_elem_type {
    assert (== (set_fn_from_elem_type "array<int>") "dyn_array_set_array")
    assert (== (set_fn_from_elem_type "string") "dyn_array_set_string")
    assert (== (set_fn_from_elem_type "array") "dyn_array_set_array")
    assert (== (set_fn_from_elem_type "int") "dyn_array_set_int")
    assert (== (set_fn_from_elem_type "Point") "dyn_array_set_int")
}

fn type_is_struct(t: string) -> bool {
    if (is_opaque_type t) {
        return false
    } else {
        (print "")
    }
    if (or (is_array_type t) (str_contains t "List<")) {
        return false
    } else {
        (print "")
    }
    if (or (transp_str_starts_with t "fn(") (is_tuple_type t)) {
        return false
    } else {
        (print "")
    }
    if (or (== t "")
           (or (== t "int")
               (or (== t "u8")
                   (or (== t "float")
                       (or (== t "string")
                           (or (== t "bool")
                               (or (== t "array")
                                   (or (== t "unknown") (== t "void"))))))))) {
        return false
    } else {
        return true
    }
}

fn box_struct_expr(elem_type: string, value_expr: string) -> string {
    let mut c_struct: string = (+ "nl_" (mangle_type_name elem_type))
    if (!= (native_opaque_key elem_type) "") { set c_struct (type_to_c elem_type) }
    let mut parts: array<string> = []
    set parts (cg_append parts "({ ")
    set parts (cg_append parts c_struct)
    set parts (cg_append parts "* _box = malloc(sizeof(")
    set parts (cg_append parts c_struct)
    set parts (cg_append parts ")); *_box = ")
    set parts (cg_append parts value_expr)
    set parts (cg_append parts "; (int64_t)_box; })")
    return (cg_build parts)
}

shadow box_struct_expr {
    let result: string = (box_struct_expr "Point" "my_val")
    assert (str_contains result "nl_Point")
    assert (str_contains result "my_val")
    assert (str_contains result "malloc")
}

shadow type_is_struct {
    assert (type_is_struct "Point")
    assert (not (type_is_struct "int"))
    assert (not (type_is_struct "u8"))
    assert (not (type_is_struct "Mix_Music"))
}

fn c_type_from_elem_type(elem_type: string) -> string {
    if (or (is_tuple_type elem_type) (is_fn_type elem_type)) { return (type_to_c elem_type) }
    if (!= (native_opaque_key elem_type) "") { return (type_to_c elem_type) }
    if (== elem_type "float") { return "double" }
    else { if (== elem_type "string") { return "const char*" }
    else { if (== elem_type "bool") { return "bool" }
    else { if (or (== elem_type "array") (is_array_type elem_type)) { return "DynArray*" }
    else { if (== elem_type "int") { return "int64_t" }
    else { if (is_opaque_type elem_type) { return (opaque_c_type elem_type) }
    else { if (type_is_struct elem_type) { return (+ "nl_" (mangle_type_name elem_type)) }
    else { return "int64_t" } } } } } } }
}

shadow c_type_from_elem_type {
    assert (== (c_type_from_elem_type "array<array<int>>") "DynArray*")
    assert (== (c_type_from_elem_type "float") "double")
    assert (== (c_type_from_elem_type "string") "const char*")
    assert (== (c_type_from_elem_type "bool") "bool")
    assert (== (c_type_from_elem_type "int") "int64_t")
    assert (== (c_type_from_elem_type "Mix_Music") "Mix_Music")
    assert (== (c_type_from_elem_type "Point") "nl_Point")
}

/* Helper: convert nanolang type to C type */
fn is_tuple_type(nano_type: string) -> bool {
    let len: int = (str_length nano_type)
    if (< len 2) {
        return false
    } else {
        let first: string = (str_substring nano_type 0 1)
        let last: string = (str_substring nano_type (- len 1) 1)
        return (and (== first "(") (== last ")"))
    }
}

shadow is_tuple_type {
    assert (is_tuple_type "(int, string)")
    assert (is_tuple_type "()")
    assert (not (is_tuple_type "int"))
    assert (not (is_tuple_type "("))
}

fn mangle_type_name(name: string) -> string {
    let mut out: string = ""
    let len: int = (str_length name)
    let mut i: int = 0

    while (< i len) {
        let ch: string = (str_substring name i 1)

        if (and (== ch ":") (< (+ i 1) len)) {
            let ch2: string = (str_substring name (+ i 1) 1)
            if (== ch2 ":") {
                set out (+ out "_")
                set i (+ i 2)
            } else {
                set out (+ out "_")
                set i (+ i 1)
            }
        } else {
            if (or (== ch ".")
                    (or (== ch "<")
                        (or (== ch ">")
                            (or (== ch ",")
                                (or (== ch "(")
                                    (or (== ch ")")
                                        (== ch " "))))))) {
                set out (+ out "_")
            } else {
                set out (+ out ch)
            }
            set i (+ i 1)
        }
    }

    return out
}

shadow mangle_type_name {
    assert (== (mangle_type_name "List<Point>") "List_Point_")
    assert (== (mangle_type_name "Option::Some") "Option_Some")
    assert (== (mangle_type_name "(int, string)") "_int__string_")
}

fn tuple_typedef_name(tuple_type: string) -> string {
    if (not (native_name_in native_tuple_annotations tuple_type)) {
        set native_tuple_annotations (array_push native_tuple_annotations tuple_type)
    }
    let opaque_key: string = (native_opaque_key tuple_type)
    if (!= opaque_key "") { return (native_opaque_name opaque_key) }
    let len: int = (str_length tuple_type)
    if (< len 2) {
        return "Tuple"
    } else {
        let inner: string = (str_substring tuple_type 1 (- len 2))
        /* Strip spaces to normalize "(int, int)" and "(int,int)" to same name */
        let mut stripped: string = ""
        let slen: int = (str_length inner)
        let mut si: int = 0
        while (< si slen) {
            let ch: string = (str_substring inner si 1)
            if (!= ch " ") {
                set stripped (+ stripped ch)
            } else { (print "") }
            set si (+ si 1)
        }
        return (+ "Tuple_" (mangle_type_name stripped))
    }
}

shadow tuple_typedef_name {
    assert (== (tuple_typedef_name "(int,string)") "Tuple_int_string")
    assert (== (tuple_typedef_name "(int, string)") "Tuple_int_string")
}

fn type_to_c(nano_type: string) -> string {
    let trimmed: string = (str_trim nano_type)
    if (!= trimmed nano_type) { return (type_to_c trimmed) }
    if (transp_str_starts_with nano_type "&mut ") {
        return (+ (type_to_c (str_substring nano_type 5 (str_length nano_type))) "*")
    }
    if (transp_str_starts_with nano_type "&") {
        return (+ "const " (+ (type_to_c (str_substring nano_type 1 (str_length nano_type))) "*"))
    }
    /* Function pointer types: fn(int,int)->int */
    if (is_fn_type nano_type) {
        return (register_fn_type nano_type)
    } else { (print "") }
    /* HashMap opaque types */
    if (== nano_type "HashMap<string,int>") { return "HashMap_string_int*" } else { (print "") }
    if (== nano_type "HashMap<string, int>") { return "HashMap_string_int*" } else { (print "") }
    if (== nano_type "HashMap<string,string>") { return "HashMap_string_string*" } else { (print "") }
    if (== nano_type "HashMap<string, string>") { return "HashMap_string_string*" } else { (print "") }
    if (== nano_type "int") {
        return "int64_t"
    } else {
    if (== nano_type "u8") {
        return "uint8_t"
    } else {
    if (== nano_type "int64_t") {
        return "int64_t"
    } else {
        if (== nano_type "float") {
            return "double"
        } else {
            if (== nano_type "bool") {
                return "bool"
            } else {
                if (== nano_type "string") {
                    return "const char*"
                } else {
                    if (== nano_type "void") {
                        return "void"
                    } else {
                        /* Schema enums are not nl_-prefixed in generated/compiler_schema.h */
                        if (== nano_type "DiagnosticSeverity") { return "DiagnosticSeverity" } else { (print "") }
                        if (== nano_type "CompilerPhase") { return "CompilerPhase" } else { (print "") }
                        if (== nano_type "ParseNodeType") { return "ParseNodeType" } else { (print "") }
                        /* Token enum is named TokenType in C schema; Nano uses LexerTokenType in places */
                        if (or (== nano_type "LexerTokenType") (== nano_type "TokenType")) { return "TokenType" } else { (print "") }

                        if (transp_str_starts_with nano_type "List<") {
                            let elem: string = (str_substring nano_type 5 (- (str_length nano_type) 6))
                            if (== elem "int") {
                                return "List_int*"
                            } else {
                                if (== elem "string") {
                                    return "List_string*"
                                } else {
                                    if (== elem "LexerToken") {
                                        return "List_LexerToken*"
                                    } else {
                                        if (or (== elem "token") (== elem "Token")) {
                                            return "List_Token*"
                                        } else {
                                            let mut list_parts: array<string> = []
                                            set list_parts (cg_append list_parts "List_")
                                            set list_parts (cg_append list_parts (mangle_type_name elem))
                                            set list_parts (cg_append list_parts "*")
                                            return (cg_build list_parts)
                                        }
                                    }
                                }
                            }
                        } else {
                        if (transp_str_starts_with nano_type "array<") {
                            return "DynArray*"
                        } else {
                            if (is_tuple_type nano_type) {
                                return (tuple_typedef_name nano_type)
                            } else {
                                if (is_opaque_type nano_type) {
                                    return (opaque_c_type nano_type)
                                } else {
                                if (is_generic_type nano_type) {
                                    return (+ "nl_" (monomorphize_type_name nano_type))
                                } else {
                                    return (+ "nl_" (mangle_name nano_type))
                                }
                                }
                            }
                        }
                        }
                    }
                }
            }
        }
    }
    }
    }
}

shadow type_to_c {
    assert (== (type_to_c "int") "int64_t")
    assert (== (type_to_c "u8") "uint8_t")
    assert (== (type_to_c "bool") "bool")
    assert (== (type_to_c "MyStruct") "nl_MyStruct")
    assert (== (type_to_c "Result<int,string>") "nl_Result_int_string")
}

fn tuple_split_types(tuple_type: string) -> array<string> {
    let len: int = (str_length tuple_type)
    if (< len 2) {
        return []
    } else {
        let inner: string = (str_substring tuple_type 1 (- len 2))
        if (== (str_length inner) 0) { return [] }
        let mut parts: array<string> = []
        let mut cur: string = ""

        let mut i: int = 0
        let inner_len: int = (str_length inner)
        let mut depth_angle: int = 0
        let mut depth_paren: int = 0

        while (< i inner_len) {
            let ch: string = (str_substring inner i 1)
            let mut is_sep: bool = false
            if (== ch "<") {
                set depth_angle (+ depth_angle 1)
            } else {
                if (== ch ">") {
                    let mut arrow: bool = false
                    if (> i 0) { set arrow (== (str_substring inner (- i 1) 1) "-") }
                    if (not arrow) { set depth_angle (- depth_angle 1) }
                } else {
                    if (== ch "(") {
                        set depth_paren (+ depth_paren 1)
                    } else {
                        if (== ch ")") {
                            set depth_paren (- depth_paren 1)
                        } else {
                            if (and (== ch ",") (and (== depth_angle 0) (== depth_paren 0))) {
                                set parts (array_push parts (str_trim cur))
                                set cur ""
                                set is_sep true
                            } else {
                                (print "")
                            }
                        }
                    }
                }
            }

            if (not is_sep) {
                set cur (+ cur ch)
            } else { (print "") }
            set i (+ i 1)
        }

        set parts (array_push parts (str_trim cur))
        return parts
    }
}

shadow tuple_split_types {
    let parts: array<string> = (tuple_split_types "(int,string)")
    assert (== (array_length parts) 2)
    assert (== (at parts 0) "int")
    assert (== (at parts 1) "string")
    let nested: array<string> = (tuple_split_types "(fn(int)->bool,Box<int,string>)")
    assert (== (array_length nested) 2)
    assert (== (at nested 0) "fn(int)->bool")
    assert (== (at nested 1) "Box<int,string>")
    assert (== (array_length (tuple_split_types "()")) 0)
}

fn collect_tuple_types_from_type(t: string, acc: array<string>, seen: HashMap<string, int>) -> array<string> {
    if (not (is_tuple_type t)) {
        return acc
    } else {
        let elems: array<string> = (tuple_split_types t)
        let mut acc2: array<string> = acc

        let mut i: int = 0
        while (< i (array_length elems)) {
            set acc2 (collect_tuple_types_from_type (at elems i) acc2 seen)
            set i (+ i 1)
        }

        if (map_has seen t) {
            return acc2
        } else {
            (map_put seen t 1)
            return (array_push acc2 t)
        }
    }
}

shadow collect_tuple_types_from_type {
    let acc: array<string> = []
    let seen: HashMap<string, int> = (hashset_new_string)
    let out: array<string> = (collect_tuple_types_from_type "(int,string)" acc seen)
    assert (== (array_length out) 1)
    assert (== (at out 0) "(int,string)")
}

fn gen_tuple_typedef(tuple_type: string) -> string {
    let name: string = (tuple_typedef_name tuple_type)
    let elems: array<string> = (tuple_split_types tuple_type)
    let mut out: string = "typedef struct { "
    if native_derived_forward_mode { set out (+ "struct " (+ name " { ")) }

    let mut i: int = 0
    while (< i (array_length elems)) {
        if (> i 0) {
            set out (+ out "; ")
        } else { (print "") }

        let ct: string = (type_to_c (at elems i))
        set out (+ out ct)
        set out (+ out " _")
        set out (+ out (int_to_string i))
        set i (+ i 1)
    }

    if (== i 0) { set out (+ out "int _placeholder") }
    set out (+ out "; }")
    if (not native_derived_forward_mode) { set out (+ out " ") set out (+ out name) }
    set out (+ out ";\n")
    return out
}

shadow gen_tuple_typedef {
    let code: string = (gen_tuple_typedef "(int,string)")
    assert (str_contains code "Tuple_int_string")
    assert (str_contains code "int64_t _0")
}

fn gen_tuple_typedefs(parser: Parser) -> string {
    let mut tuple_types: array<string> = []
    let tuple_seen: HashMap<string, int> = (hashset_new_string)

    /* Walk all lets (params and locals) */
    let let_count: int = (parser_get_let_count parser)
    let mut i: int = 0
    while (< i let_count) {
        let l: ASTLet = (parser_get_let parser i)
        set tuple_types (collect_tuple_types_from_type l.var_type tuple_types tuple_seen)
        set i (+ i 1)
    }

    /* Walk function return types */
    let fn_count: int = (parser_get_function_count parser)
    let mut j: int = 0
    while (< j fn_count) {
        let f: ASTFunction = (parser_get_function parser j)
        set tuple_types (collect_tuple_types_from_type f.return_type tuple_types tuple_seen)
        set j (+ j 1)
    }

    let mut out: string = ""
    let mut k: int = 0
    while (< k (array_length tuple_types)) {
        let tuple_type: string = (at tuple_types k)
        if (not (native_name_in native_derived_emitted_names (tuple_typedef_name tuple_type))) {
            set out (+ out (gen_tuple_typedef tuple_type))
        }
        set k (+ k 1)
    }

    if (== out "") {
        return ""
    } else {
        return (+ "/* Tuple typedefs */\n" out)
    }
}

shadow gen_tuple_typedefs {
    let source: string = (+ "f" "n main() -> (int,int) { return (1, 2) }")
    let toks: List<LexerToken> = (tokenize_string source "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let code: string = (gen_tuple_typedefs p)
    assert (str_contains code "Tuple_int_int")
}

/* Note: For Phase 1, we avoid complex array<string> type inference issues */
/* Parameter types will be converted at a higher level before calling gen_function_signature */

/* =============================================================================
 * EXPRESSION CODE GENERATION
 * ============================================================================= */

/* Generate code for a number literal */
fn gen_number(value: string) -> string {
    return value
}

shadow gen_number {
    assert (== (gen_number "42") "42")
}

/* Generate code for a string literal */
fn gen_string(value: string) -> string {
    # I retain source escape spellings and escape physical line breaks for C.
    let mut parts: array<string> = []
    set parts (cg_append parts "\"")
    let mut start: int = 0
    let mut i: int = 0
    while (< i (str_length value)) {
        let c: int = (char_at value i)
        if (or (== c 10) (== c 13)) {
            set parts (cg_append parts (str_substring value start (- i start)))
            if (== c 10) { set parts (cg_append parts "\\n") }
            else { set parts (cg_append parts "\\r") }
            set start (+ i 1)
        }
        set i (+ i 1)
    }
    set parts (cg_append parts (str_substring value start (- i start)))
    set parts (cg_append parts "\"")
    return (cg_build parts)
}

shadow gen_string {
    let code: string = (gen_string "hello")
    assert (== code "\"hello\"")
    assert (== (gen_string "a\nb\rc") "\"a\\nb\\rc\"")
    assert (== (gen_string "a\\nb") "\"a\\nb\"")
}

/* Generate code for a boolean literal */
fn gen_bool(value: bool) -> string {
    if value {
        return "1"
    } else {
        return "0"
    }
}

shadow gen_bool {
    assert (== (gen_bool true) "1")
    assert (== (gen_bool false) "0")
}

/* Generate code for an identifier */
fn gen_identifier(name: string) -> string {
    /* Add nl_ prefix for namespacing */
    return (+ "nl_" (mangle_name name))
}

shadow gen_identifier {
    assert (== (gen_identifier "x") "nl_x")
}

/* Generate code for a binary operation.
   Only arithmetic (+,-,*,/,%) and logical (&&,||) ops get outer parens
   to preserve precedence. Comparisons (==,!=,<,>,<=,>=) are left bare
   so that if(cond) doesn't produce if((a == b)) which triggers
   -Wparentheses-equality in Clang. */
fn gen_binary_op(op: string, left: string, right: string) -> string {
    /* Convert nanolang operators to C operators */
    let mut c_op: string = op
    
    if (== op "and") {
        set c_op "&&"
    } else {
        if (== op "or") {
            set c_op "||"
        } else {
            set c_op op
        }
    }
    
    let needs_parens: bool = (or (or (or (== op "+") (== op "-")) (or (== op "*") (== op "/"))) (or (== op "%") (or (== op "and") (== op "or"))))
    
    let mut parts: array<string> = []
    if needs_parens {
        set parts (cg_append parts "(")
    } else { (print "") }
    set parts (cg_append parts "(")
    set parts (cg_append parts left)
    set parts (cg_append parts ")")
    set parts (cg_append parts " ")
    set parts (cg_append parts c_op)
    set parts (cg_append parts " ")
    set parts (cg_append parts "(")
    set parts (cg_append parts right)
    set parts (cg_append parts ")")
    if needs_parens {
        set parts (cg_append parts ")")
    } else { (print "") }
    
    return (cg_build parts)
}

shadow gen_binary_op {
    assert (== (gen_binary_op "==" "a" "b == c") "(a) == (b == c)")
    assert (== (gen_binary_op "<" "a == b" "c") "(a == b) < (c)")
    assert (== (gen_binary_op "+" "a" "b * c") "((a) + (b * c))")
}

/* Generate code for a function call */
fn gen_call(func_name: string, args: array<string>) -> string {
    let mut parts: array<string> = []
    set parts (cg_append parts "nl_")
    set parts (cg_append parts (mangle_name func_name))
    set parts (cg_append parts "(")
    
    /* Add arguments */
    let arg_count: int = (array_length args)
    let mut i: int = 0
    
    while (< i arg_count) {
        if (> i 0) {
            set parts (cg_append parts ", ")
        } else {
            (print "")
        }
        
        /* Directly use (at args i) to avoid type inference issue */
        set parts (cg_append parts (at args i))
        set i (+ i 1)
    }
    
    set parts (cg_append parts ")")
    return (cg_build parts)
}

shadow gen_call {
    let args: array<string> = []
    let code1: string = (gen_call "foo" args)
    
    let mut args2: array<string> = []
    set args2 (array_push args2 "1")
    set args2 (array_push args2 "2")
    let code2: string = (gen_call "add" args2)
    /* Just verify it doesn't crash */
    assert (== 1 1)
}

/* =============================================================================
 * STATEMENT CODE GENERATION
 * ============================================================================= */

/* Generate code for a let statement */
fn gen_let(name: string, type_name: string, value_expr: string, indent: int) -> string {
    let mut parts: array<string> = []
    set parts (cg_append parts (gen_indent indent))
    
    /* Convert nanolang type to C type using helper */
    let c_type: string = (type_to_c type_name)
    
    set parts (cg_append parts c_type)
    set parts (cg_append parts " nl_")
    set parts (cg_append parts name)
    set parts (cg_append parts " = ")
    set parts (cg_append parts value_expr)
    set parts (cg_append parts ";\n")
    
    return (cg_build parts)
}

shadow gen_let {
    let code: string = (gen_let "x" "int" "42" 0)
    /* Just verify it doesn't crash */
    assert (== 1 1)
}

/* Generate code for an if statement */
fn gen_if(condition: string, then_body: string, else_body: string, indent: int) -> string {
    let mut parts: array<string> = []
    set parts (cg_append parts (gen_indent indent))
    set parts (cg_append parts "if (")
    set parts (cg_append parts condition)
    set parts (cg_append parts ") {\n")
    set parts (cg_append parts then_body)
    set parts (cg_append parts (gen_indent indent))
    set parts (cg_append parts "}")
    
    /* Add else clause if present */
    if (!= else_body "") {
        set parts (cg_append parts " else {\n")
        set parts (cg_append parts else_body)
        set parts (cg_append parts (gen_indent indent))
        set parts (cg_append parts "}")
    } else {
        (print "")
    }
    
    set parts (cg_append parts "\n")
    return (cg_build parts)
}

shadow gen_if {
    let code: string = (gen_if "x > 0" "    return 1;\n" "" 0)
    /* Just verify it doesn't crash */
    assert (== 1 1)
}

/* Generate code for a while loop */
fn gen_while(condition: string, body: string, indent: int) -> string {
    let mut parts: array<string> = []
    set parts (cg_append parts (gen_indent indent))
    set parts (cg_append parts "while (")
    set parts (cg_append parts condition)
    set parts (cg_append parts ") {\n")
    set parts (cg_append parts body)
    set parts (cg_append parts (gen_indent indent))
    set parts (cg_append parts "}\n")
    
    return (cg_build parts)
}

shadow gen_while {
    let code: string = (gen_while "i < 10" "    i++;\n" 0)
    /* Just verify it doesn't crash */
    assert (== 1 1)
}

/* Generate code for a return statement */
fn gen_return(value_expr: string, indent: int) -> string {
    let mut parts: array<string> = []
    set parts (cg_append parts (gen_indent indent))
    set parts (cg_append parts "return ")
    set parts (cg_append parts value_expr)
    set parts (cg_append parts ";\n")
    
    return (cg_build parts)
}

shadow gen_return {
    let code: string = (gen_return "42" 1)
    /* Just verify it doesn't crash */
    assert (== 1 1)
}

/* =============================================================================
 * FUNCTION DEFINITION GENERATION
 * ============================================================================= */

/* Generate function signature */
fn gen_function_signature(name: string, params: array<string>, param_types: array<string>, return_type: string) -> string {
    let mut parts: array<string> = []
    
    /* Convert return type using helper */
    let c_ret_type: string = (type_to_c return_type)
    
    set parts (cg_append parts c_ret_type)
    set parts (cg_append parts " ")
    set parts (cg_append parts (c_func_name_for_definition name))
    set parts (cg_append parts "(")
    
    /* Add parameters */
    let param_count: int = (array_length params)
    let mut i: int = 0
    
    while (< i param_count) {
        if (> i 0) {
            set parts (cg_append parts ", ")
        } else {
            (print "")
        }
        
        /* Use param type directly - caller should pre-convert to C types */
        /* This avoids array<string> type inference issues */
        set parts (cg_append parts (at param_types i))
        set parts (cg_append parts " nl_")
        /* Use param name directly */
        set parts (cg_append parts (mangle_name (at params i)))
        
        set i (+ i 1)
    }
    
    set parts (cg_append parts ")")
    return (cg_build parts)
}

shadow gen_function_signature {
    let params: array<string> = []
    let mut types: array<string> = []
    /* Note: types should be pre-converted to C types */
    set types (array_push types "int64_t")
    set types (array_push types "int")
    let sig: string = (gen_function_signature "add" params types "int")
    /* Just verify it generates something */
    assert (== 1 1)
}

/* Generate complete function definition */
fn gen_function(name: string, params: array<string>, param_types: array<string>, return_type: string, body: string) -> string {
    let mut parts: array<string> = []
    set parts (cg_append parts (gen_function_signature name params param_types return_type))
    set parts (cg_append parts " {\n")
    set parts (cg_append parts body)
    set parts (cg_append parts "}\n\n")
    
    return (cg_build parts)
}

shadow gen_function {
    let params: array<string> = []
    let types: array<string> = []
    let func: string = (gen_function "main" params types "int" "    return 0;\n")
    /* Just verify it doesn't crash */
    assert (== 1 1)
}

/* =============================================================================
 * C RUNTIME / STANDARD LIBRARY
 * ============================================================================= */

/* Generate C includes and runtime support */
fn gen_c_includes() -> string {
    let mut parts: array<string> = []
    set parts (cg_append parts "/* Generated by nanolang self-hosted compiler */\n")
    set parts (cg_append parts "#ifndef _DARWIN_C_SOURCE\n#define _DARWIN_C_SOURCE 1\n#endif\n")
    set parts (cg_append parts "#ifndef _GNU_SOURCE\n")
    set parts (cg_append parts "#define _GNU_SOURCE\n")
    set parts (cg_append parts "#endif\n")
    set parts (cg_append parts "#include <stdio.h>\n")
    set parts (cg_append parts "#include <stdlib.h>\n")
    set parts (cg_append parts "#include <stdint.h>\n")
    set parts (cg_append parts "#include <stdbool.h>\n")
    set parts (cg_append parts "#include <string.h>\n")
    set parts (cg_append parts "#include <math.h>\n")
    set parts (cg_append parts "#include <assert.h>\n")
    set parts (cg_append parts "#include <time.h>\n")
    set parts (cg_append parts "#include <ctype.h>\n")
    set parts (cg_append parts "#include <sys/time.h>\n")
    set parts (cg_append parts "#ifdef __MACH__\n")
    set parts (cg_append parts "#include <mach/mach_time.h>\n")
    set parts (cg_append parts "#endif\n")
    set parts (cg_append parts "#include \"nanolang.h\"\n")
    set parts (cg_append parts "#include \"runtime/string_edges.h\"\n")
    set parts (cg_append parts "#include \"collections/collections.h\"\n")
    set parts (cg_append parts "#include \"json/json.h\"\n")
    set parts (cg_append parts "#include \"runtime/hashmap_bootstrap.h\"\n")
    set parts (cg_append parts "#include \"runtime/dyn_array.h\"\n")
    set parts (cg_append parts "#include \"runtime/native_array_abi.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_int.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_string.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_token.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_LexerToken.h\"\n")
    /* Backward-compat aliases: old generated C used unprefixed list_LexerToken_* names.
     * Map them to the canonical nl_list_LexerToken_* symbols from the header. */
    set parts (cg_append parts "/* list_LexerToken compat aliases (unprefixed -> nl_ prefixed) */\n")
    set parts (cg_append parts "#ifndef list_LexerToken_new\n")
    set parts (cg_append parts "#define list_LexerToken_new  nl_list_LexerToken_new\n")
    set parts (cg_append parts "#define list_LexerToken_push nl_list_LexerToken_push\n")
    set parts (cg_append parts "#define list_LexerToken_get  nl_list_LexerToken_get\n")
    set parts (cg_append parts "#define list_LexerToken_length nl_list_LexerToken_length\n")
    set parts (cg_append parts "#endif\n")
    set parts (cg_append parts "#include \"runtime/list_CompilerDiagnostic.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_CompilerSourceLocation.h\"\n")
    set parts (cg_append parts "#include \"runtime/token_helpers.h\"\n")
    /* Include all AST list type headers for compiler support */
    set parts (cg_append parts "#include \"runtime/list_ASTLet.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTFunction.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTNumber.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTFloat.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTString.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTBool.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTIdentifier.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTBinaryOp.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTCall.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTArrayLiteral.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTSet.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTIf.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTWhile.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTFor.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTReturn.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTStmtRef.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTBlock.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTUnsafeBlock.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTPrint.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTAssert.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTShadow.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTStruct.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTStructLiteral.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTFieldAccess.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTEnum.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTUnion.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTUnionConstruct.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTMatch.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTImport.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTOpaqueType.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTServiceDecl.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTTupleLiteral.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTModuleQualifiedCall.h\"\n")
    set parts (cg_append parts "#include \"runtime/list_ASTTupleIndex.h\"\n")
    set parts (cg_append parts "\n")
    /* Forward declarations for opaque types (module-provided, pointer-sized) */
    set parts (cg_append parts "/* Opaque type forward declarations */\n")
    set parts (cg_append parts "#ifndef NL_OPAQUE_TYPES_DECLARED\n")
    set parts (cg_append parts "#define NL_OPAQUE_TYPES_DECLARED\n")
    set parts (cg_append parts "typedef void* NLStringBuilder;\n")
    set parts (cg_append parts "typedef void* NLStringSet;\n")
    set parts (cg_append parts "typedef void* NLHashMap;\n")
    set parts (cg_append parts "typedef void* NlPeg;\n")
    set parts (cg_append parts "typedef void* Peg2Grammar;\n")
    set parts (cg_append parts "typedef void* Json;\n")
    set parts (cg_append parts "typedef void* Regex;\n")
    set parts (cg_append parts "typedef void* DateTime;\n")
    set parts (cg_append parts "typedef void* HttpResponse;\n")
    set parts (cg_append parts "typedef void* HttpServer;\n")
    set parts (cg_append parts "typedef void* HttpRequest;\n")
    set parts (cg_append parts "typedef void* NlQueue;\n")
    set parts (cg_append parts "typedef void* NlQueueGroup;\n")
    /* SDL opaque type forward declarations (guarded against SDL header conflicts) */
    set parts (cg_append parts "#ifndef SDL_h_\n")
    set parts (cg_append parts "typedef void* SDL_Window;\n")
    set parts (cg_append parts "typedef void* SDL_Renderer;\n")
    set parts (cg_append parts "typedef void* SDL_Texture;\n")
    set parts (cg_append parts "typedef void* SDL_Surface;\n")
    set parts (cg_append parts "typedef void* SDL_GLContext;\n")
    set parts (cg_append parts "#endif\n")
    set parts (cg_append parts "#ifndef SDL_TTF_H_\n")
    set parts (cg_append parts "typedef void* TTF_Font;\n")
    set parts (cg_append parts "#endif\n")
    set parts (cg_append parts "#ifndef SDL_MIXER_H_\n")
    set parts (cg_append parts "typedef void* Mix_Chunk;\n")
    set parts (cg_append parts "typedef void* Mix_Music;\n")
    set parts (cg_append parts "#endif\n")
    set parts (cg_append parts "#endif\n\n")
    /* Module standard library helpers are forward-declared here so generated C
     * does not depend on module include paths when a program does not import them. */
    set parts (cg_append parts "DynArray* fs_walkdir(const char* root);\n")
    set parts (cg_append parts "const char* path_normalize(const char* path);\n")
    set parts (cg_append parts "const char* path_canonical(const char* path);\n")
    set parts (cg_append parts "int64_t file_compare_identity(const char* source, const char* candidate);\n")
    set parts (cg_append parts "int64_t file_compare_destinations(const char* first, const char* second);\n")
    set parts (cg_append parts "const char* path_join(const char* a, const char* b);\n")
    set parts (cg_append parts "const char* path_basename(const char* path);\n")
    set parts (cg_append parts "const char* path_dirname(const char* path);\n")
    set parts (cg_append parts "const char* path_relpath(const char* target, const char* base);\n")
    set parts (cg_append parts "const char* file_read(const char* path);\n")
    set parts (cg_append parts "int64_t  file_write(const char* path, const char* content);\n")
    set parts (cg_append parts "int64_t  file_append(const char* path, const char* content);\n")
    set parts (cg_append parts "bool     file_exists(const char* path);\n")
    set parts (cg_append parts "int64_t  file_delete(const char* path);\n")
    set parts (cg_append parts "int64_t  fs_mkdir_p(const char* path);\n")
    set parts (cg_append parts "int64_t  file_copy(const char* src, const char* dst);\n")
    set parts (cg_append parts "int64_t  dir_copy(const char* src, const char* dst);\n")
    set parts (cg_append parts "int64_t  nl_os_process_spawn(const char* command);\n")
    set parts (cg_append parts "int64_t  nl_os_process_is_running(int64_t pid);\n")
    set parts (cg_append parts "int64_t  nl_os_process_wait(int64_t pid);\n")
    set parts (cg_append parts "DynArray* nl_os_process_spawn_with_pipes(const char* command);\n")
    set parts (cg_append parts "const char* nl_os_fd_read_available(int64_t fd);\n")
    set parts (cg_append parts "int64_t  nl_os_fd_close(int64_t fd);\n")
    /* Auto-concurrency: guarded mutable variables use libdispatch */
    /* Forward declarations for cli.c functions not covered by a header */
    set parts (cg_append parts "extern int64_t nl_os_unsetenv(const char* name);\n")
    set parts (cg_append parts "\n")

    return (cg_build parts)
}

shadow gen_c_includes {
    let includes: string = (gen_c_includes)
    /* Just verify it generates something */
    assert (== 1 1)
}

/* Generate runtime helper functions */
fn gen_c_runtime() -> string {
    let mut sb: array<string> = []
    set sb (cg_append sb (gen_binary64_arithmetic_runtime))
    set sb (cg_append sb (gen_binary64_format_runtime))
    
    set sb (cg_append sb "/* ========== Math and Utility Built-in Functions ========== */\n\n")
    
    /* Math macros (abs, min, max) - use _Generic for type safety */
    set sb (cg_append sb "#define nl_abs(x) _Generic((x), \\\n")
    set sb (cg_append sb "    double: (double)((x) < 0.0 ? -(x) : (x)), \\\n")
    set sb (cg_append sb "    default: (int64_t)((x) < 0 ? -(x) : (x)))\n\n")
    
    set sb (cg_append sb "#define nl_min(a, b) _Generic((a), \\\n")
    set sb (cg_append sb "    double: (double)((a) < (b) ? (a) : (b)), \\\n")
    set sb (cg_append sb "    default: (int64_t)((a) < (b) ? (a) : (b)))\n\n")
    
    set sb (cg_append sb "#define nl_max(a, b) _Generic((a), \\\n")
    set sb (cg_append sb "    double: (double)((a) > (b) ? (a) : (b)), \\\n")
    set sb (cg_append sb "    default: (int64_t)((a) > (b) ? (a) : (b)))\n\n")
    
    # I retain the C-seed start/length slice helper and shallow element policy.
    set sb (cg_append sb "static DynArray* nl_array_slice(DynArray* arr, int64_t start, int64_t length) {\n")
    set sb (cg_append sb "    if (!arr) return dyn_array_new(ELEM_INT);\n")
    set sb (cg_append sb "    if (start < 0) start = 0;\n")
    set sb (cg_append sb "    if (length < 0) length = 0;\n")
    set sb (cg_append sb "    int64_t len = dyn_array_length(arr);\n")
    set sb (cg_append sb "    if (start > len) start = len;\n")
    set sb (cg_append sb "    if (length > len - start) length = len - start;\n")
    set sb (cg_append sb "    int64_t end = start + length;\n")
    set sb (cg_append sb "    if (end > len) end = len;\n")
    set sb (cg_append sb "    ElementType t = dyn_array_get_elem_type(arr);\n")
    set sb (cg_append sb "    DynArray* out = dyn_array_new(t);\n")
    set sb (cg_append sb "    if (!out) return NULL;\n")
    set sb (cg_append sb "    for (int64_t i = start; i < end; i++) {\n")
    set sb (cg_append sb "        switch (t) {\n")
    set sb (cg_append sb "            case ELEM_U8: dyn_array_push_u8(out, dyn_array_get_u8(arr, i)); break;\n")
    set sb (cg_append sb "            case ELEM_INT: dyn_array_push_int(out, dyn_array_get_int(arr, i)); break;\n")
    set sb (cg_append sb "            case ELEM_FLOAT: dyn_array_push_float(out, dyn_array_get_float(arr, i)); break;\n")
    set sb (cg_append sb "            case ELEM_BOOL: dyn_array_push_bool(out, dyn_array_get_bool(arr, i)); break;\n")
    set sb (cg_append sb "            case ELEM_STRING: dyn_array_push_string(out, dyn_array_get_string(arr, i)); break;\n")
    set sb (cg_append sb "            case ELEM_ARRAY: dyn_array_push_array(out, dyn_array_get_array(arr, i)); break;\n")
    set sb (cg_append sb "            case ELEM_STRUCT: dyn_array_push_struct(out, dyn_array_get_struct(arr, i), (size_t)arr->elem_size); break;\n")
    set sb (cg_append sb "            default: assert(false && \"nl_array_slice: unsupported element type\");\n")
    set sb (cg_append sb "        }\n")
    set sb (cg_append sb "    }\n")
    set sb (cg_append sb "    return out;\n")
    set sb (cg_append sb "}\n\n")

    /* Math functions */
    set sb (cg_append sb "/* Math functions */\n")
    set sb (cg_append sb "double nl_sqrt(double x) { return sqrt(x); }\n")
    set sb (cg_append sb "double nl_pow(double base, double exp) { return pow(base, exp); }\n")
    set sb (cg_append sb "double nl_floor(double x) { return floor(x); }\n")
    set sb (cg_append sb "double nl_ceil(double x) { return ceil(x); }\n")
    set sb (cg_append sb "double nl_round(double x) { return round(x); }\n")
    set sb (cg_append sb "double nl_sin(double x) { return sin(x); }\n")
    set sb (cg_append sb "double nl_cos(double x) { return cos(x); }\n")
    set sb (cg_append sb "double nl_tan(double x) { return tan(x); }\n")
    set sb (cg_append sb "double nl_atan2(double y, double x) { return atan2(y, x); }\n\n")

    /* Print functions */
    set sb (cg_append sb "/* Print functions */\n")
    set sb (cg_append sb "void nl_print(const char* s) {\n")
    set sb (cg_append sb "    printf(\"%s\", s);\n")
    set sb (cg_append sb "}\n\n")
    
    set sb (cg_append sb "void nl_println(const char* s) {\n")
    set sb (cg_append sb "    printf(\"%s\\n\", s);\n")
    set sb (cg_append sb "}\n\n")

    set sb (cg_append sb "void nl_print_float(double v) {\n")
    set sb (cg_append sb "    nano_rt_f64_print(stdout, v);\n")
    set sb (cg_append sb "}\n\n")

    set sb (cg_append sb "void nl_println_float(double v) {\n")
    set sb (cg_append sb "    nano_rt_f64_print(stdout, v); fputc('\\n', stdout);\n")
    set sb (cg_append sb "}\n\n")
    
    /* Type conversion functions */
    set sb (cg_append sb "/* Type conversions */\n")
    set sb (cg_append sb "char* nl_int_to_string(int64_t n) {\n")
    set sb (cg_append sb "    char* buffer = malloc(32);\n")
    set sb (cg_append sb "    if (!buffer) return \"\";\n")
    set sb (cg_append sb "    snprintf(buffer, 32, \"%lld\", (long long)n);\n")
    set sb (cg_append sb "    return buffer;\n")
    set sb (cg_append sb "}\n\n")
    
    set sb (cg_append sb "#ifndef NL_HAS_USER_FLOAT_TO_STRING\n")
    set sb (cg_append sb "char* nl_float_to_string(double x) {\n")
    set sb (cg_append sb "    char* buffer = malloc(64);\n")
    set sb (cg_append sb "    if (!buffer) return \"\";\n")
    set sb (cg_append sb "    nano_rt_f64_format(buffer, 64, x);\n")
    set sb (cg_append sb "    if (!strchr(buffer, '.') && !strchr(buffer, 'e') && !strchr(buffer, 'n') && !strchr(buffer, 'i')) {\n")
    set sb (cg_append sb "        size_t len = strlen(buffer);\n")
    set sb (cg_append sb "        if (len + 2 < 64) { buffer[len] = '.'; buffer[len + 1] = '0'; buffer[len + 2] = '\\0'; }\n")
    set sb (cg_append sb "    }\n")
    set sb (cg_append sb "    return buffer;\n")
    set sb (cg_append sb "}\n")
    set sb (cg_append sb "#endif\n\n")

    
    set sb (cg_append sb "char* nl_bool_to_string(bool b) {\n")
    set sb (cg_append sb "    return b ? \"true\" : \"false\";\n")
    set sb (cg_append sb "}\n\n")
    
    set sb (cg_append sb "int64_t nl_string_to_int(const char* s) {\n")
    set sb (cg_append sb "    return strtoll(s, NULL, 10);\n")
    set sb (cg_append sb "}\n\n")
    
    set sb (cg_append sb "#include \"runtime/binary64_parse.h\"\n")
    set sb (cg_append sb "double nl_string_to_float(const char* s) {\n")
    set sb (cg_append sb "    return nl_binary64_prefix(s);\n")
    set sb (cg_append sb "}\n\n")

    set sb (cg_append sb "double nl_float_from_bits(int64_t value) { uint64_t bits = (uint64_t)value; double result; _Static_assert(sizeof(result) == sizeof(bits), \"I require binary64 storage.\"); memcpy(&result, &bits, sizeof(result)); return result; }\n")
    set sb (cg_append sb "int64_t nl_float_to_bits(double value) { uint64_t bits; _Static_assert(sizeof(value) == sizeof(bits), \"I require binary64 storage.\"); memcpy(&bits, &value, sizeof(bits)); return bits <= INT64_MAX ? (int64_t)bits : -1 - (int64_t)(UINT64_MAX - bits); }\n")
    set sb (cg_append sb "double nl_cast_float(int64_t x) { return (double)x; }\n")
    set sb (cg_append sb "double nl_cast_float_from_float(double x) { return x; }\n")
    set sb (cg_append sb "int64_t nl_cast_int(double x) { if (!(x >= -0x1p63 && x < 0x1p63)) { fputs(\"I cannot convert this float to int: I require a finite value in [-2^63, 2^63).\\n\", stderr); exit(EXIT_FAILURE); } return (int64_t)x; }\n")
    set sb (cg_append sb "int64_t nl_cast_int_from_int(int64_t x) { return x; }\n")
    set sb (cg_append sb "bool nl_cast_bool(int64_t x) { return x != 0; }\n")
    set sb (cg_append sb "bool nl_cast_bool_from_float(double x) { return x != 0.0; }\n\n")
    
    /* String operations */
    set sb (cg_append sb "/* String operations */\n")
    set sb (cg_append sb "char* nl_str_concat(const char* a, const char* b) {\n")
    set sb (cg_append sb "    size_t la = strlen(a);\n")
    set sb (cg_append sb "    size_t lb = strlen(b);\n")
    set sb (cg_append sb "    char* out = (char*)malloc(la + lb + 1);\n")
    set sb (cg_append sb "    if (!out) return \"\";\n")
    set sb (cg_append sb "    memcpy(out, a, la);\n")
    set sb (cg_append sb "    memcpy(out + la, b, lb);\n")
    set sb (cg_append sb "    out[la + lb] = 0;\n")
    set sb (cg_append sb "    return out;\n")
    set sb (cg_append sb "}\n\n")
    
    set sb (cg_append sb "char* nl_str_substring(const char* s, int64_t start, int64_t len) {\n")
    set sb (cg_append sb "    if (!s) return \"\";\n")
    set sb (cg_append sb "    int64_t n = (int64_t)strlen(s);\n")
    set sb (cg_append sb "    if (start < 0) start = 0;\n")
    set sb (cg_append sb "    if (len < 0) len = 0;\n")
    set sb (cg_append sb "    if (start > n) start = n;\n")
    set sb (cg_append sb "    if (start + len > n) len = n - start;\n")
    set sb (cg_append sb "    char* out = (char*)malloc((size_t)len + 1);\n")
    set sb (cg_append sb "    if (!out) return \"\";\n")
    set sb (cg_append sb "    memcpy(out, s + start, (size_t)len);\n")
    set sb (cg_append sb "    out[len] = 0;\n")
    set sb (cg_append sb "    return out;\n")
    set sb (cg_append sb "}\n\n")
    
    set sb (cg_append sb "bool nl_str_starts_with(const char* str, const char* prefix) {\n")
    set sb (cg_append sb "    if (!str || !prefix) return false;\n")
    set sb (cg_append sb "    while (*prefix) { if (*str++ != *prefix++) return false; }\n")
    set sb (cg_append sb "    return true;\n")
    set sb (cg_append sb "}\n\n")
    set sb (cg_append sb "bool nl_str_contains(const char* str, const char* substr) {\n")
    set sb (cg_append sb "    return strstr(str, substr) != NULL;\n")
    set sb (cg_append sb "}\n\n")
    set sb (cg_append sb "#include \"runtime/string_search.h\"\n")
    /* nl_str_slice(str, start, end) - slice from start to end (end-exclusive) */
    set sb (cg_append sb "char* nl_str_slice(const char* s, int64_t start, int64_t end_pos) {\n")
    set sb (cg_append sb "    if (!s) return \"\";\n")
    set sb (cg_append sb "    int64_t len = end_pos - start;\n")
    set sb (cg_append sb "    return nl_str_substring(s, start, len > 0 ? len : 0);\n")
    set sb (cg_append sb "}\n\n")
    
    set sb (cg_append sb "bool nl_str_equals(const char* s1, const char* s2) {\n")
    set sb (cg_append sb "    return strcmp(s1, s2) == 0;\n")
    set sb (cg_append sb "}\n\n")

    /* Bytes (array<u8>) helpers. I keep this contract byte-oriented: I copy
     * every non-NUL byte and require ELEM_U8 on the return trip. */
    set sb (cg_append sb "static DynArray* nl_bytes_from_string(const char* s) {\n")
    set sb (cg_append sb "    DynArray* out = dyn_array_new(ELEM_U8);\n")
    set sb (cg_append sb "    if (!out) return NULL;\n")
    set sb (cg_append sb "    if (!s) return out;\n")
    set sb (cg_append sb "    size_t len = strnlen(s, 64*1024*1024);\n")
    set sb (cg_append sb "    for (size_t i = 0; i < len; i++) {\n")
    set sb (cg_append sb "        dyn_array_push_u8(out, (uint8_t)(unsigned char)s[i]);\n")
    set sb (cg_append sb "    }\n")
    set sb (cg_append sb "    return out;\n")
    set sb (cg_append sb "}\n\n")

    set sb (cg_append sb "static const char* nl_string_from_bytes(DynArray* bytes) {\n")
    set sb (cg_append sb "    if (!bytes) return \"\";\n")
    set sb (cg_append sb "    if (dyn_array_get_elem_type(bytes) != ELEM_U8) return \"\";\n")
    set sb (cg_append sb "    int64_t len = dyn_array_length(bytes);\n")
    set sb (cg_append sb "    if (len < 0) return \"\";\n")
    set sb (cg_append sb "    char* out = gc_alloc_string((size_t)len);\n")
    set sb (cg_append sb "    if (!out) return \"\";\n")
    set sb (cg_append sb "    for (int64_t i = 0; i < len; i++) {\n")
    set sb (cg_append sb "        out[i] = (char)dyn_array_get_u8(bytes, i);\n")
    set sb (cg_append sb "    }\n")
    set sb (cg_append sb "    out[len] = '\\0';\n")
    set sb (cg_append sb "    return out;\n")
    set sb (cg_append sb "}\n\n")
    
    /* Character operations */
    set sb (cg_append sb "/* Character operations */\n")
    set sb (cg_append sb "int64_t nl_char_at(const char* s, int64_t i) {\n")
    set sb (cg_append sb "    return (int64_t)((unsigned char)s[i]);\n")
    set sb (cg_append sb "}\n\n")
    
    set sb (cg_append sb "char* nl_string_from_char(int64_t c) {\n")
    set sb (cg_append sb "    char* buffer = malloc(2);\n")
    set sb (cg_append sb "    if (!buffer) return \"\";\n")
    set sb (cg_append sb "    buffer[0] = (char)c;\n")
    set sb (cg_append sb "    buffer[1] = 0;\n")
    set sb (cg_append sb "    return buffer;\n")
    set sb (cg_append sb "}\n\n")
    
    /* Character classification */
    set sb (cg_append sb "/* Character classification */\n")
    set sb (cg_append sb "bool nl_is_digit(int64_t c) {\n")
    set sb (cg_append sb "    return c >= '0' && c <= '9';\n")
    set sb (cg_append sb "}\n\n")
    
    set sb (cg_append sb "bool nl_is_alpha(int64_t c) {\n")
    set sb (cg_append sb "    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');\n")
    set sb (cg_append sb "}\n\n")
    
    set sb (cg_append sb "bool nl_is_alnum(int64_t c) {\n")
    set sb (cg_append sb "    return nl_is_digit(c) || nl_is_alpha(c);\n")
    set sb (cg_append sb "}\n\n")
    
    set sb (cg_append sb "bool nl_is_whitespace(int64_t c) {\n")
    set sb (cg_append sb "    return c == ' ' || c == '\\t' || c == '\\n' || c == '\\r';\n")
    set sb (cg_append sb "}\n\n")
    
    set sb (cg_append sb "bool nl_is_upper(int64_t c) {\n")
    set sb (cg_append sb "    return c >= 'A' && c <= 'Z';\n")
    set sb (cg_append sb "}\n\n")
    
    set sb (cg_append sb "bool nl_is_lower(int64_t c) {\n")
    set sb (cg_append sb "    return c >= 'a' && c <= 'z';\n")
    set sb (cg_append sb "}\n\n")
    
    set sb (cg_append sb "int64_t nl_digit_value(int64_t c) {\n")
    set sb (cg_append sb "    if (c >= '0' && c <= '9') {\n")
    set sb (cg_append sb "        return c - '0';\n")
    set sb (cg_append sb "    }\n")
    set sb (cg_append sb "    return -1;\n")
    set sb (cg_append sb "}\n\n")
    
    set sb (cg_append sb "int64_t nl_char_to_lower(int64_t c) {\n")
    set sb (cg_append sb "    if (c >= 'A' && c <= 'Z') {\n")
    set sb (cg_append sb "        return c + 32;\n")
    set sb (cg_append sb "    }\n")
    set sb (cg_append sb "    return c;\n")
    set sb (cg_append sb "}\n\n")
    
    set sb (cg_append sb "int64_t nl_char_to_upper(int64_t c) {\n")
    set sb (cg_append sb "    if (c >= 'a' && c <= 'z') {\n")
    set sb (cg_append sb "        return c - 32;\n")
    set sb (cg_append sb "    }\n")
    set sb (cg_append sb "    return c;\n")
    set sb (cg_append sb "}\n\n")
    
    /* fs.h returns const char* for path/file functions; NanoLang string type is char*.
     * Provide nl_ wrappers that cast const char* to char* so user code can assign
     * to string variables without -Wdiscarded-qualifiers warnings. */
    set sb (cg_append sb "/* fs wrappers */\n")
    set sb (cg_append sb "static const char* nl_path_normalize(const char* p) { return path_normalize(p); }\n")
    set sb (cg_append sb "static const char* nl_path_join(const char* a, const char* b) { return path_join(a, b); }\n")
    set sb (cg_append sb "static const char* nl_path_basename(const char* p) { return path_basename(p); }\n")
    set sb (cg_append sb "static const char* nl_path_dirname(const char* p) { return path_dirname(p); }\n")
    set sb (cg_append sb "static const char* nl_path_relpath(const char* t, const char* b) { return path_relpath(t, b); }\n")
    set sb (cg_append sb "static const char* nl_file_read(const char* p) { return file_read(p); }\n\n")
    set sb (cg_append sb "static int64_t nl_fs_mkdir_p(const char* p) { return fs_mkdir_p(p); }\n")
    set sb (cg_append sb "static int64_t nl_file_copy(const char* s, const char* d) { return file_copy(s, d); }\n")
    set sb (cg_append sb "static int64_t nl_dir_copy(const char* s, const char* d) { return dir_copy(s, d); }\n\n")

    /* nl_os_process_run is declared by #include "process.h" in gen_c_includes().
     * No redundant extern needed here — that caused a duplicate-decl warning. */

    set sb (cg_append sb "/* CLI and OS functions (defined in runtime/cli.c) */\n")
    set sb (cg_append sb "int g_argc = 0;\n")
    set sb (cg_append sb "char **g_argv = NULL;\n")
    set sb (cg_append sb "extern int64_t get_argc(void);\n")
    set sb (cg_append sb "extern const char* get_argv(int64_t index);\n")
    set sb (cg_append sb "extern const char* nl_os_getenv(const char* name);\n")
    set sb (cg_append sb "static const char* nl_get_argv(int64_t idx) { return get_argv(idx); }\n")
    set sb (cg_append sb "static const char* nl_getenv(const char* name) { return nl_os_getenv(name); }\n")
    set sb (cg_append sb "static const char* nl_env_get(const char* name) { return nl_os_getenv(name); }\n")
    set sb (cg_append sb "extern int64_t nl_os_setenv(const char* name, const char* value, int64_t overwrite);\n")
    set sb (cg_append sb "extern int64_t nl_os_system(const char* command);\n")
    set sb (cg_append sb "static int64_t nl_exec_shell(const char* cmd) { return (int64_t)system(cmd); }\n\n")
    set sb (cg_append sb "/* Capture stdout from a shell command (up to 65535 bytes) */\n")
    set sb (cg_append sb "static const char* nl_exec_capture(const char* cmd) {\n")
    set sb (cg_append sb "    FILE* pipe = popen(cmd, \"r\");\n")
    set sb (cg_append sb "    if (!pipe) return \"\";\n")
    set sb (cg_append sb "    char* out = (char*)malloc(65536);\n")
    set sb (cg_append sb "    if (!out) { pclose(pipe); return \"\"; }\n")
    set sb (cg_append sb "    size_t total = 0;\n")
    set sb (cg_append sb "    char buf[1024];\n")
    set sb (cg_append sb "    while (fgets(buf, sizeof(buf), pipe) && total < 65534) {\n")
    set sb (cg_append sb "        size_t n = strlen(buf);\n")
    set sb (cg_append sb "        if (total + n > 65534) n = 65534 - total;\n")
    set sb (cg_append sb "        memcpy(out + total, buf, n);\n")
    set sb (cg_append sb "        total += n;\n")
    set sb (cg_append sb "    }\n")
    set sb (cg_append sb "    out[total] = '\\0';\n")
    set sb (cg_append sb "    pclose(pipe);\n")
    set sb (cg_append sb "    return out;\n")
    set sb (cg_append sb "}\n\n")
    
    set sb (cg_append sb "/* OS functions not in cli.c - static implementations */\n")
    set sb (cg_append sb "#include <unistd.h>\n")
    set sb (cg_append sb "#include <sys/types.h>\n")
    set sb (cg_append sb "#include <sys/stat.h>\n")
    set sb (cg_append sb "static char* nl_os_getcwd(void) {\n")
    set sb (cg_append sb "    char buf[4096];\n")
    set sb (cg_append sb "    if (getcwd(buf, sizeof(buf))) {\n")
    set sb (cg_append sb "        char* out = malloc(strlen(buf) + 1);\n")
    set sb (cg_append sb "        if (out) { strcpy(out, buf); return out; }\n")
    set sb (cg_append sb "    }\n")
    set sb (cg_append sb "    return \"\";\n")
    set sb (cg_append sb "}\n\n")
    
    set sb (cg_append sb "static void nl_os_exit(int64_t code) { exit((int)code); }\n\n")
    
    set sb (cg_append sb "static int64_t nl_os_chdir(const char* path) { return (int64_t)chdir(path); }\n\n")

    set sb (cg_append sb "static bool nl_os_file_exists(const char* path) {\n")
    set sb (cg_append sb "    struct stat st;\n")
    set sb (cg_append sb "    return stat(path, &st) == 0;\n")
    set sb (cg_append sb "}\n\n")

    set sb (cg_append sb "static char* nl_os_tmp_dir(void) {\n")
    set sb (cg_append sb "    const char* tmp = getenv(\"TMPDIR\");\n")
    set sb (cg_append sb "    if (!tmp || tmp[0] == '\\0') tmp = \"/tmp\";\n")
    set sb (cg_append sb "    size_t len = strlen(tmp);\n")
    set sb (cg_append sb "    char* out = gc_alloc_string(len);\n")
    set sb (cg_append sb "    if (!out) return gc_alloc_string(0);\n")
    set sb (cg_append sb "    memcpy(out, tmp, len);\n")
    set sb (cg_append sb "    out[len] = '\\0';\n")
    set sb (cg_append sb "    return out;\n")
    set sb (cg_append sb "}\n\n")

    set sb (cg_append sb "static char* nl_os_mktemp(const char* prefix) {\n")
    set sb (cg_append sb "    const char* tmp = getenv(\"TMPDIR\");\n")
    set sb (cg_append sb "    if (!tmp || tmp[0] == '\\0') tmp = \"/tmp\";\n")
    set sb (cg_append sb "    const char* p = (prefix && prefix[0]) ? prefix : \"nanolang_\";\n")
    set sb (cg_append sb "    char templ[1024];\n")
    set sb (cg_append sb "    snprintf(templ, sizeof(templ), \"%s/%sXXXXXX\", tmp, p);\n")
    set sb (cg_append sb "    int fd = mkstemp(templ);\n")
    set sb (cg_append sb "    if (fd < 0) return gc_alloc_string(0);\n")
    set sb (cg_append sb "    close(fd);\n")
    set sb (cg_append sb "    size_t len = strlen(templ);\n")
    set sb (cg_append sb "    char* out = gc_alloc_string(len);\n")
    set sb (cg_append sb "    if (!out) return gc_alloc_string(0);\n")
    set sb (cg_append sb "    memcpy(out, templ, len);\n")
    set sb (cg_append sb "    out[len] = '\\0';\n")
    set sb (cg_append sb "    return out;\n")
    set sb (cg_append sb "}\n\n")

    set sb (cg_append sb "static char* nl_os_mktemp_dir(const char* prefix) {\n")
    set sb (cg_append sb "    const char* tmp = getenv(\"TMPDIR\");\n")
    set sb (cg_append sb "    if (!tmp || tmp[0] == '\\0') tmp = \"/tmp\";\n")
    set sb (cg_append sb "    const char* p = (prefix && prefix[0]) ? prefix : \"nanolang_dir_\";\n")
    set sb (cg_append sb "    char path[1024];\n")
    set sb (cg_append sb "    for (int i = 0; i < 100; i++) {\n")
    set sb (cg_append sb "        snprintf(path, sizeof(path), \"%s/%s%lld_%d\", tmp, p, (long long)time(NULL), i);\n")
    set sb (cg_append sb "        if (mkdir(path, 0700) == 0) {\n")
    set sb (cg_append sb "            size_t len = strlen(path);\n")
    set sb (cg_append sb "            char* out = gc_alloc_string(len);\n")
    set sb (cg_append sb "            if (!out) return gc_alloc_string(0);\n")
    set sb (cg_append sb "            memcpy(out, path, len);\n")
    set sb (cg_append sb "            out[len] = '\\0';\n")
    set sb (cg_append sb "            return out;\n")
    set sb (cg_append sb "        }\n")
    set sb (cg_append sb "    }\n")
    set sb (cg_append sb "    return gc_alloc_string(0);\n")
    set sb (cg_append sb "}\n\n")
    
    set sb (cg_append sb "static const char* cast_string(int64_t v) { return nl_int_to_string(v); }\n")
    set sb (cg_append sb "static const char* to_string(int64_t v) { return nl_int_to_string(v); }\n\n")

    /* Higher-order array functions (map, reduce, filter) */
    set sb (cg_append sb "/* Higher-order array functions */\n")
    set sb (cg_append sb "static DynArray* nl_map(DynArray* arr, int64_t (*fn)(int64_t)) {\n")
    set sb (cg_append sb "    DynArray* result = dyn_array_new(ELEM_INT);\n")
    set sb (cg_append sb "    int64_t len = dyn_array_length(arr);\n")
    set sb (cg_append sb "    for (int64_t i = 0; i < len; i++) {\n")
    set sb (cg_append sb "        dyn_array_push_int(result, fn(dyn_array_get_int(arr, i)));\n")
    set sb (cg_append sb "    }\n")
    set sb (cg_append sb "    return result;\n")
    set sb (cg_append sb "}\n\n")
    set sb (cg_append sb "static int64_t nano_rt_reduce_int(DynArray* arr, int64_t initial, int64_t (*fn)(int64_t, int64_t)) {\n")
    set sb (cg_append sb "    int64_t acc = initial;\n")
    set sb (cg_append sb "    int64_t len = dyn_array_length(arr);\n")
    set sb (cg_append sb "    for (int64_t i = 0; i < len; i++) {\n")
    set sb (cg_append sb "        acc = fn(acc, dyn_array_get_int(arr, i));\n")
    set sb (cg_append sb "    }\n")
    set sb (cg_append sb "    return acc;\n")
    set sb (cg_append sb "}\n\n")
    set sb (cg_append sb "static DynArray* nl_filter(DynArray* arr, bool (*fn)(int64_t)) {\n")
    set sb (cg_append sb "    DynArray* result = dyn_array_new(ELEM_INT);\n")
    set sb (cg_append sb "    int64_t len = dyn_array_length(arr);\n")
    set sb (cg_append sb "    for (int64_t i = 0; i < len; i++) {\n")
    set sb (cg_append sb "        int64_t val = dyn_array_get_int(arr, i);\n")
    set sb (cg_append sb "        if (fn(val)) dyn_array_push_int(result, val);\n")
    set sb (cg_append sb "    }\n")
    set sb (cg_append sb "    return result;\n")
    set sb (cg_append sb "}\n\n")

    /* String variants */
    set sb (cg_append sb "static DynArray* nl_map_str(DynArray* arr, const char* (*fn)(const char*)) {\n")
    set sb (cg_append sb "    DynArray* result = dyn_array_new(ELEM_STRING);\n")
    set sb (cg_append sb "    int64_t len = dyn_array_length(arr);\n")
    set sb (cg_append sb "    for (int64_t i = 0; i < len; i++) {\n")
    set sb (cg_append sb "        dyn_array_push_string(result, fn(dyn_array_get_string(arr, i)));\n")
    set sb (cg_append sb "    }\n")
    set sb (cg_append sb "    return result;\n")
    set sb (cg_append sb "}\n\n")
    set sb (cg_append sb "static const char* nano_rt_reduce_str(DynArray* arr, const char* initial, const char* (*fn)(const char*, const char*)) {\n")
    set sb (cg_append sb "    const char* acc = initial;\n")
    set sb (cg_append sb "    int64_t len = dyn_array_length(arr);\n")
    set sb (cg_append sb "    for (int64_t i = 0; i < len; i++) {\n")
    set sb (cg_append sb "        acc = fn(acc, dyn_array_get_string(arr, i));\n")
    set sb (cg_append sb "    }\n")
    set sb (cg_append sb "    return acc;\n")
    set sb (cg_append sb "}\n\n")
    set sb (cg_append sb "static DynArray* nl_filter_str(DynArray* arr, bool (*fn)(const char*)) {\n")
    set sb (cg_append sb "    DynArray* result = dyn_array_new(ELEM_STRING);\n")
    set sb (cg_append sb "    int64_t len = dyn_array_length(arr);\n")
    set sb (cg_append sb "    for (int64_t i = 0; i < len; i++) {\n")
    set sb (cg_append sb "        const char* val = dyn_array_get_string(arr, i);\n")
    set sb (cg_append sb "        if (fn(val)) dyn_array_push_string(result, val);\n")
    set sb (cg_append sb "    }\n")
    set sb (cg_append sb "    return result;\n")
    set sb (cg_append sb "}\n\n")

    /* Float variants */
    set sb (cg_append sb "static DynArray* nl_map_float(DynArray* arr, double (*fn)(double)) {\n")
    set sb (cg_append sb "    DynArray* result = dyn_array_new(ELEM_FLOAT);\n")
    set sb (cg_append sb "    int64_t len = dyn_array_length(arr);\n")
    set sb (cg_append sb "    for (int64_t i = 0; i < len; i++) {\n")
    set sb (cg_append sb "        dyn_array_push_float(result, fn(dyn_array_get_float(arr, i)));\n")
    set sb (cg_append sb "    }\n")
    set sb (cg_append sb "    return result;\n")
    set sb (cg_append sb "}\n\n")
    set sb (cg_append sb "static double nano_rt_reduce_float(DynArray* arr, double initial, double (*fn)(double, double)) {\n")
    set sb (cg_append sb "    double acc = initial;\n")
    set sb (cg_append sb "    int64_t len = dyn_array_length(arr);\n")
    set sb (cg_append sb "    for (int64_t i = 0; i < len; i++) {\n")
    set sb (cg_append sb "        acc = fn(acc, dyn_array_get_float(arr, i));\n")
    set sb (cg_append sb "    }\n")
    set sb (cg_append sb "    return acc;\n")
    set sb (cg_append sb "}\n\n")
    set sb (cg_append sb "static DynArray* nl_filter_float(DynArray* arr, bool (*fn)(double)) {\n")
    set sb (cg_append sb "    DynArray* result = dyn_array_new(ELEM_FLOAT);\n")
    set sb (cg_append sb "    int64_t len = dyn_array_length(arr);\n")
    set sb (cg_append sb "    for (int64_t i = 0; i < len; i++) {\n")
    set sb (cg_append sb "        double val = dyn_array_get_float(arr, i);\n")
    set sb (cg_append sb "        if (fn(val)) dyn_array_push_float(result, val);\n")
    set sb (cg_append sb "    }\n")
    set sb (cg_append sb "    return result;\n")
    set sb (cg_append sb "}\n\n")

    set sb (cg_append sb "static DynArray* nl_filter_bool(DynArray* arr, bool (*fn)(bool)) {\n")
    set sb (cg_append sb "    DynArray* result = dyn_array_new(ELEM_BOOL);\n")
    set sb (cg_append sb "    int64_t len = dyn_array_length(arr);\n")
    set sb (cg_append sb "    for (int64_t i = 0; i < len; i++) {\n")
    set sb (cg_append sb "        bool val = dyn_array_get_bool(arr, i);\n")
    set sb (cg_append sb "        if (fn(val)) dyn_array_push_bool(result, val);\n")
    set sb (cg_append sb "    }\n")
    set sb (cg_append sb "    return result;\n")
    set sb (cg_append sb "}\n\n")

    /* HashMap wrappers (generic API over type-specific implementations) */
    /* nl_map_* operate on HashMap_string_int (int-valued maps)             */
    /* nl_hm_*  operate on HashMap_string_string (string-valued maps)       */
    set sb (cg_append sb "/* HashMap wrappers */\n")
    set sb (cg_append sb "static inline HashMap_string_int* nl_map_new(void) { return nl_hashmap_string_int_alloc(16); }\n")
    set sb (cg_append sb "static inline void nl_map_put(HashMap_string_int* hm, const char* key, int64_t val) { nl_hashmap_string_int_put(hm, key, val); }\n")
    set sb (cg_append sb "static inline int64_t nl_map_get(HashMap_string_int* hm, const char* key) { return nl_hashmap_string_int_get(hm, key); }\n")
    set sb (cg_append sb "static inline int nl_map_has(HashMap_string_int* hm, const char* key) { return nl_hashmap_string_int_has(hm, key); }\n")
    set sb (cg_append sb "static inline int64_t nl_map_size(HashMap_string_int* hm) { return hm->size; }\n\n")
    /* nl_hm_* for HashMap<string,string> are declared by collections/collections.h
     * (included via gen_c_includes) as void*-based functions.  Do NOT redefine
     * them here with concrete HashMap_string_string* types — that causes
     * -Wint-conversion conflicting-type errors when both declarations are visible.
     * collections.h void* signatures are ABI-compatible at every call site. */

    /* Timing utilities */
    set sb (cg_append sb "/* Timing utilities */\n")
    set sb (cg_append sb "static int64_t nl_timing_get_microseconds(void) {\n")
    set sb (cg_append sb "#ifdef CLOCK_REALTIME\n")
    set sb (cg_append sb "    struct timespec ts;\n")
    set sb (cg_append sb "    clock_gettime(CLOCK_REALTIME, &ts);\n")
    set sb (cg_append sb "    return ((int64_t)ts.tv_sec * 1000000LL) + (int64_t)(ts.tv_nsec / 1000);\n")
    set sb (cg_append sb "#else\n")
    set sb (cg_append sb "    struct timeval tv;\n")
    set sb (cg_append sb "    gettimeofday(&tv, NULL);\n")
    set sb (cg_append sb "    return ((int64_t)tv.tv_sec * 1000000LL) + (int64_t)tv.tv_usec;\n")
    set sb (cg_append sb "#endif\n")
    set sb (cg_append sb "}\n\n")

    set sb (cg_append sb "static int64_t nl_timing_get_nanoseconds(void) {\n")
    set sb (cg_append sb "#ifdef __MACH__\n")
    set sb (cg_append sb "    static mach_timebase_info_data_t timebase;\n")
    set sb (cg_append sb "    static int initialized = 0;\n")
    set sb (cg_append sb "    if (!initialized) {\n")
    set sb (cg_append sb "        mach_timebase_info(&timebase);\n")
    set sb (cg_append sb "        initialized = 1;\n")
    set sb (cg_append sb "    }\n")
    set sb (cg_append sb "    uint64_t mach_time = mach_absolute_time();\n")
    set sb (cg_append sb "    return (int64_t)((mach_time * timebase.numer) / timebase.denom);\n")
    set sb (cg_append sb "#elif defined(CLOCK_MONOTONIC)\n")
    set sb (cg_append sb "    struct timespec ts;\n")
    set sb (cg_append sb "    clock_gettime(CLOCK_MONOTONIC, &ts);\n")
    set sb (cg_append sb "    return ((int64_t)ts.tv_sec * 1000000000LL) + (int64_t)ts.tv_nsec;\n")
    set sb (cg_append sb "#else\n")
    set sb (cg_append sb "    return nl_timing_get_microseconds() * 1000LL;\n")
    set sb (cg_append sb "#endif\n")
    set sb (cg_append sb "}\n\n")

    set sb (cg_append sb "/* Convenience: current time in milliseconds */\n")
    set sb (cg_append sb "static int64_t nl_get_time_ms(void) { return nl_timing_get_microseconds() / 1000LL; }\n\n")
    set sb (cg_append sb "/* ========== End Math and Utility Built-in Functions ========== */\n\n")

    return (cg_build sb)
}

shadow gen_c_runtime {
    let runtime: string = (gen_c_runtime)
    assert (str_contains runtime "bool nl_cast_bool(int64_t x) { return x != 0; }")
    assert (str_contains runtime "bool nl_cast_bool_from_float(double x) { return x != 0.0; }")
    assert (str_contains runtime "#include \"runtime/binary64_parse.h\"")
    assert (str_contains runtime "return nl_binary64_prefix(s);")
    assert (str_contains runtime "#include \"runtime/string_search.h\"")
    assert (str_contains runtime "nl_filter_bool(DynArray* arr, bool (*fn)(bool))")
    assert (str_contains runtime "bool val = dyn_array_get_bool(arr, i)")
    assert (str_contains runtime "if (fn(val)) dyn_array_push_bool(result, val)")
    assert (str_contains runtime "static DynArray* nl_array_slice(DynArray* arr, int64_t start, int64_t length)")
    assert (str_contains runtime "if (length > len - start) length = len - start;")
    assert (str_contains runtime "case ELEM_ARRAY: dyn_array_push_array(out, dyn_array_get_array(arr, i)); break;")
    assert (str_contains runtime "static DynArray* nl_bytes_from_string(const char* s)")
    assert (str_contains runtime "DynArray* out = dyn_array_new(ELEM_U8);")
    assert (str_contains runtime "static const char* nl_string_from_bytes(DynArray* bytes)")
    assert (str_contains runtime "if (dyn_array_get_elem_type(bytes) != ELEM_U8) return \"\";")
    assert (str_contains runtime "char* out = gc_alloc_string((size_t)len);")
}

/*
    return sorted
}
*/

/* Generate forward declarations for imported module functions
 * 
 * Uses module_generate_forward_declarations() to get forward declarations
 * from the module cache for each imported module.
 * Emits declarations in topologically sorted order (dependencies first).
 * 
 * Args:
 *   parser: The parsed AST containing import statements
 * 
 * Returns: C code string with forward declarations
 */
fn generate_module_forward_declarations(parser: Parser) -> string {
    /* Module forward declarations with dependency ordering
     * 
     * Note: Full module dependency resolution and topological sorting requires
     * the complete module.c infrastructure. For self-hosted compilation, the
     * C reference compiler already handles this in the final linking stage.
     * 
     * This placeholder allows self-hosted components to compile without the
     * full module system while maintaining compatibility with import statements.
     */
    let import_count: int = (parser_get_import_count parser)
    if (> import_count 0) {
        return "/* Module forward declarations: handled by C reference compiler */\n"
    } else {
        return ""
    }
}

shadow generate_module_forward_declarations {
    let source: string = (+ "from \"modules/std/fs.nano\" import walkdir\nf" "n main() -> int { return 0 }")
    let toks: List<LexerToken> = (tokenize_string source "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let code: string = (generate_module_forward_declarations p)
    assert (str_contains code "Module forward declarations")
}

/* Generate complete C program */
fn gen_c_program(functions: string) -> string {
    let mut parts: array<string> = []
    set parts (cg_append parts (gen_c_includes))
    set parts (cg_append parts (gen_c_runtime))
    set parts (cg_append parts "/* User functions */\n")
    set parts (cg_append parts functions)
    
    return (cg_build parts)
}

/* Returns true if the program has any module-scope mutable primitive that
 * requires nano_dispatch.h (NlGuarded_* + libdispatch). */
fn parser_has_guarded_globals(parser: Parser) -> bool {
    let local_lets: array<bool> = (declaration_local_lets parser)
    let total: int = (parser_get_let_count parser)
    let mut i: int = 0
    while (< i total) {
        let l: ASTLet = (parser_get_let parser i)
        if (not (at local_lets i)) {
            if (and l.is_mut (is_guarded_primitive l.var_type)) {
                return true
            } else { (print "") }
        } else { (print "") }
        set i (+ i 1)
    }
    return false
}

shadow parser_has_guarded_globals {
    let src: string = "fn main() -> int { return 0 }"
    let toks: List<LexerToken> = (tokenize_string src "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (== (parser_has_guarded_globals p) false)
}

/* Generate complete C program with module forward declarations */
fn gen_c_program_with_modules(parser: Parser, functions: string) -> string {
    if (> parser.services_count 0) { set reduce_emission_error "I have not resolved File service declarations for this consumer." return "" }
    let mut sb: array<string> = []

    set sb (cg_append sb (gen_c_includes))
    /* Conditionally include nano_dispatch.h only when guarded globals exist,
     * so programs without module-scope let mut don't require clang + libdispatch. */
    if (parser_has_guarded_globals parser) {
        set sb (cg_append sb "#include \"runtime/nano_dispatch.h\"\n")
    } else { (print "") }
    /* Check if user defines builtin names to avoid redefinition */
    if (has_function_named parser "float_to_string") {
        set sb (cg_append sb "#define NL_HAS_USER_FLOAT_TO_STRING 1\n")
    } else { (print "") }
    set sb (cg_append sb (gen_c_runtime))
    set sb (cg_append sb (generate_module_forward_declarations parser))
    
    /* Generate enum definitions */
    set sb (cg_append sb (generate_enum_definitions_from_tokens parser))

    /* I discover complete annotations before ordering any layout bodies. */
    let mut array_let: int = 0
    while (< array_let (parser_get_let_count parser)) {
        (native_collect_array_type (parser_get_let parser array_let).var_type)
        set array_let (+ array_let 1)
    }
    let mut array_function: int = 0
    while (< array_function (parser_get_function_count parser)) {
        (native_collect_array_type (parser_get_function parser array_function).return_type)
        set array_function (+ array_function 1)
    }
    let protos: string = (generate_function_prototypes parser)
    let globals: string = (generate_global_constants parser)
    let tuple_discovery: string = (gen_tuple_typedefs parser)
    /* I order mixed nominal definitions by complete-value dependencies. */
    set sb (cg_append sb (generate_native_nominal_definitions parser))

    /* Generate List<T> specializations (after struct defs so types are available) */
    set sb (cg_append sb (generate_list_specializations parser))
    
    /* Tuple typedefs must come before function prototypes that reference them */
    if (== (array_length native_derived_emitted_names) 0) {
        set sb (cg_append sb tuple_discovery)
    } else {
        set sb (cg_append sb (gen_tuple_typedefs parser))
    }

    /* Forward declarations for all functions (avoid implicit declarations in C99) */
    /* Emit function pointer typedefs before prototypes (collected during type_to_c calls) */
    set sb (cg_append sb (generate_fn_type_typedefs))
    set sb (cg_append sb protos)

    /* Emit top-level constant declarations */
    set sb (cg_append sb globals)

    set sb (cg_append sb "/* User functions */\n")
    set sb (cg_append sb functions)

    /* If module has no Nano main(), provide a stub so the C wrapper can link. */
    if (not (has_function_named parser "main")) {
        set sb (cg_append sb "\nint64_t nl_main() { return 0; }\n")
    } else { (print "") }
    
    /* Add C main() wrapper that calls nl_main() */
    set sb (cg_append sb "\n/* C main() entry point - calls nanolang main */\n")
    set sb (cg_append sb "int main(int argc, char **argv) {\n")
    set sb (cg_append sb "    g_argc = argc;\n")
    set sb (cg_append sb "    g_argv = argv;\n")
    set sb (cg_append sb "    return (int)nl_main();\n")
    set sb (cg_append sb "}\n")
    
    return (cg_build sb)
}

shadow gen_c_program_with_modules {
    let source: string = (+ "from \"modules/std/fs.nano\" import walkdir\nf" "n helper() -> int { return 0 }")
    let toks: List<LexerToken> = (tokenize_string source "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let code: string = (gen_c_program_with_modules p "int64_t nl_helper() { return 0; }\n")
    assert (str_contains code "Module forward declarations")
    assert (str_contains code "int main(")
    assert (str_contains code "nl_main")
}

shadow gen_c_program {
    let prog: string = (gen_c_program "int64_t nl_main() { return 0; }\n")
    /* Just verify it generates something */
    assert (== 1 1)
}

/* AST and Parser IR types are provided by src_nano/compiler/ir.nano */

/* =============================================================================
 * GENERIC LIST SPECIALIZATION
 * ============================================================================= */

/* Detect List<T> usage in the program by scanning variable declarations
 * Returns: Array of unique element type names (e.g., ["Point", "int", "string"])
 */
fn detect_list_types(parser: Parser) -> array<string> {
    let mut list_types: array<string> = []
    let list_seen: HashMap<string, int> = (hashset_new_string)
    let func_count: int = (parser_get_function_count parser)
    
    let mut i: int = 0
    while (< i func_count) {
        let func: ASTFunction = (parser_get_function parser i)
        
        /* Scan function body for let statements with List<T> types */
        if (>= func.body 0) {
            set list_types (scan_block_for_lists parser func.body list_types list_seen)
        }
        
        set i (+ i 1)
    }
    
    return list_types
}

shadow detect_list_types {
    let source: string = (+ "f" "n main() -> int { let xs: List<Point> = [] return 0 }")
    let toks: List<LexerToken> = (tokenize_string source "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let types: array<string> = (detect_list_types p)
    assert (== (array_length types) 1)
    assert (== (at types 0) "Point")
}

/* Recursively scan a block for List<T> declarations */
fn scan_block_for_lists(parser: Parser, block_id: int, list_types: array<string>, list_seen: HashMap<string, int>) -> array<string> {
    let block: ASTBlock = (parser_get_block parser block_id)
    let mut result: array<string> = list_types
    
    let mut i: int = 0
    let stmt_count: int = (list_ASTStmtRef_length block.statements)
    while (< i stmt_count) {
        let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements i)
        
        if (== stmt.node_type ParseNodeType.PNODE_LET) {
            let let_node: ASTLet = (parser_get_let parser stmt.node_id)
            
            /* Check if type is List<T> */
            if (str_contains let_node.var_type "List<") {
                let elem_type: string = (transp_extract_list_element_type let_node.var_type)
                
                /* Add to list if not already present */
                if (not (map_has list_seen elem_type)) {
                    (map_put list_seen elem_type 1)
                    set result (array_push result elem_type)
                } else {
                    (print "")
                }
            } else {
                (print "")
            }
        } else {
            /* Recursively scan nested blocks (if, while) */
            if (== stmt.node_type ParseNodeType.PNODE_IF) {
                let if_node: ASTIf = (parser_get_if parser stmt.node_id)
                if (>= if_node.then_body 0) {
                    set result (scan_block_for_lists parser if_node.then_body result list_seen)
                } else { (print "") }
                if (>= if_node.else_body 0) {
                    set result (scan_block_for_lists parser if_node.else_body result list_seen)
                } else { (print "") }
            } else {
                if (== stmt.node_type ParseNodeType.PNODE_WHILE) {
                    let while_node: ASTWhile = (parser_get_while parser stmt.node_id)
                    if (>= while_node.body 0) {
                        set result (scan_block_for_lists parser while_node.body result list_seen)
                    } else { (print "") }
                } else {
                    (print "")
                }
            }
        }
        
        set i (+ i 1)
    }
    
    return result
}

shadow scan_block_for_lists {
    let source: string = (+ "f" "n main() -> int { let xs: List<Point> = [] return 0 }")
    let toks: List<LexerToken> = (tokenize_string source "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let seen: HashMap<string, int> = (hashset_new_string)
    let types: array<string> = (scan_block_for_lists p func.body [] seen)
    assert (== (array_length types) 1)
    assert (== (at types 0) "Point")
}

/* Generate List<T> specializations for all detected types */
fn generate_list_specializations(parser: Parser) -> string {
    let list_types: array<string> = (detect_list_types parser)
    let type_count: int = (array_length list_types)
    
    if (<= type_count 0) {
        return ""
    } else {
        let mut parts: array<string> = []
        set parts (cg_append parts "\n/* ========== Generic List Specializations ========== */\n\n")
        
        let mut i: int = 0
        while (< i type_count) {
            let elem_type: string = (at list_types i)
            
            /* Skip types that already have C runtime implementations */
            let skip: bool = (or (== elem_type "int") (or (== elem_type "string") (== elem_type "LexerToken")))
            let skip2: bool = (or skip (or (transp_str_starts_with elem_type "AST") (transp_str_starts_with elem_type "Compiler")))
            if skip2 {
                (print "")
            } else {
                set parts (cg_append parts (generate_list_for_type elem_type))
                set parts (cg_append parts "\n")
            }
            
            set i (+ i 1)
        }
        
        set parts (cg_append parts "/* ========== End Generic List Specializations ========== */\n\n")
        return (cg_build parts)
    }
}

shadow generate_list_specializations {
    let source: string = (+ "f" "n main() -> int { let xs: List<Point> = [] return 0 }")
    let toks: List<LexerToken> = (tokenize_string source "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let code: string = (generate_list_specializations p)
    assert (str_contains code "List_Point")
}

/* Generate List<T> struct and functions for a specific type T */
fn generate_list_for_type(elem_type: string) -> string {
    let c_elem_type: string = (type_to_c elem_type)
    let list_name: string = (+ "List_" elem_type)
    
    let mut sb: array<string> = []
    
    /* Struct definition */
    set sb (cg_append sb "typedef struct ")
    set sb (cg_append sb list_name)
    set sb (cg_append sb " {\n")
    set sb (cg_append sb "    ")
    set sb (cg_append sb c_elem_type)
    set sb (cg_append sb " *data;\n")
    set sb (cg_append sb "    int count;\n")
    set sb (cg_append sb "    int capacity;\n")
    set sb (cg_append sb "} ")
    set sb (cg_append sb list_name)
    set sb (cg_append sb ";\n\n")
    
    /* Constructor: nl_list_T_new() */
    set sb (cg_append sb list_name)
    set sb (cg_append sb "* nl_list_")
    set sb (cg_append sb elem_type)
    set sb (cg_append sb "_new() {\n")
    set sb (cg_append sb "    ")
    set sb (cg_append sb list_name)
    set sb (cg_append sb " *list = malloc(sizeof(")
    set sb (cg_append sb list_name)
    set sb (cg_append sb "));\n")
    set sb (cg_append sb "    if (!list) return NULL;\n")
    set sb (cg_append sb "    list->data = malloc(sizeof(")
    set sb (cg_append sb c_elem_type)
    set sb (cg_append sb ") * 4);\n")
    set sb (cg_append sb "    if (!list->data) { free(list); return NULL; }\n")
    set sb (cg_append sb "    list->count = 0;\n")
    set sb (cg_append sb "    list->capacity = 4;\n")
    set sb (cg_append sb "    return list;\n")
    set sb (cg_append sb "}\n\n")
    
    /* Push: nl_list_T_push(list, value) */
    set sb (cg_append sb "void nl_list_")
    set sb (cg_append sb elem_type)
    set sb (cg_append sb "_push(")
    set sb (cg_append sb list_name)
    set sb (cg_append sb " *list, ")
    set sb (cg_append sb c_elem_type)
    set sb (cg_append sb " value) {\n")
    set sb (cg_append sb "    if (list->count >= list->capacity) {\n")
    set sb (cg_append sb "        list->capacity *= 2;\n")
    set sb (cg_append sb "        ")
    set sb (cg_append sb c_elem_type)
    set sb (cg_append sb " *new_data = realloc(list->data, sizeof(")
    set sb (cg_append sb c_elem_type)
    set sb (cg_append sb ") * list->capacity);\n")
    set sb (cg_append sb "        if (!new_data) return;\n")
    set sb (cg_append sb "        list->data = new_data;\n")
    set sb (cg_append sb "    }\n")
    set sb (cg_append sb "    list->data[list->count++] = value;\n")
    set sb (cg_append sb "}\n\n")
    
    /* Get: nl_list_T_get(list, index) */
    set sb (cg_append sb c_elem_type)
    set sb (cg_append sb " nl_list_")
    set sb (cg_append sb elem_type)
    set sb (cg_append sb "_get(")
    set sb (cg_append sb list_name)
    set sb (cg_append sb " *list, int index) {\n")
    set sb (cg_append sb "    return list->data[index];\n")
    set sb (cg_append sb "}\n\n")
    
    /* Length: nl_list_T_length(list) */
    set sb (cg_append sb "int nl_list_")
    set sb (cg_append sb elem_type)
    set sb (cg_append sb "_length(")
    set sb (cg_append sb list_name)
    set sb (cg_append sb " *list) {\n")
    set sb (cg_append sb "    return list->count;\n")
    set sb (cg_append sb "}\n")
    
    return (cg_build sb)
}

shadow generate_list_for_type {
    let code: string = (generate_list_for_type "Point")
    assert (str_contains code "List_Point")
}

/* =============================================================================
 * UNION TYPE DEFINITIONS
 * ============================================================================= */

# I substitute complete type-name tokens before choosing native storage.
fn substitute_union_field_type(field_type: string, generic_params: array<string>, type_args: array<string>) -> string {
    return (type_to_c (substitute_type_parameters field_type generic_params type_args))
}

shadow substitute_union_field_type {
    let params: array<string> = (array_push (array_push [] "T") "E")
    let args: array<string> = (array_push (array_push [] "int") "string")
    assert (== (substitute_union_field_type "T" params args) "int64_t")
    assert (== (substitute_union_field_type "E" params args) "const char*")
    assert (== (substitute_union_field_type "bool" params args) "bool")
    assert (== (substitute_union_field_type "Box<T>" params args) "nl_Box_int")
    assert (== (substitute_union_field_type "Pair<T,Box<E>>" params args) "nl_Pair_int_Box_string")
    assert (== (substitute_union_field_type "Tree" params args) "nl_Tree")
}

# I visit complete type nodes, so an outer Box is never a Result instance.
fn collect_native_union_instances(type_name: string, base_name: string, seen: HashMap<string, int>, initial: array<string>) -> array<string> {
    let mut results: array<string> = initial
    let mut pending: array<string> = [type_name]
    let mut i: int = 0
    while (< i (array_length pending)) {
        let current: string = (at pending i)
        let mut args: array<string> = []
        if (and (not (is_tuple_type current)) (not (is_fn_type current))) { set args (extract_type_args current) }
        if (is_tuple_type current) {
            let elements: array<string> = (tuple_split_types current)
            let mut element_index: int = 0
            while (< element_index (array_length elements)) {
                set pending (array_push pending (at elements element_index))
                set element_index (+ element_index 1)
            }
        }
        if (is_fn_type current) {
            let parameters: array<string> = (parse_fn_type_params current)
            let mut parameter_index: int = 0
            while (< parameter_index (array_length parameters)) {
                set pending (array_push pending (at parameters parameter_index))
                set parameter_index (+ parameter_index 1)
            }
            set pending (array_push pending (parse_fn_type_return current))
        }
        if (and (> (array_length args) 0) (== (extract_base_type_name current) base_name)) {
            if (not (map_has seen current)) {
                (map_put seen current 1)
                set results (array_push results current)
            }
        }
        let mut j: int = 0
        while (< j (array_length args)) {
            set pending (array_push pending (at args j))
            set j (+ j 1)
        }
        set i (+ i 1)
    }
    return results
}
shadow collect_native_union_instances {
    let seen: HashMap<string, int> = (map_new)
    let results: array<string> = (collect_native_union_instances "Box<Result<int,string>>" "Result" seen [])
    assert (== (array_length results) 1)
    assert (== (at results 0) "Result<int,string>")
    assert (== (array_length (collect_native_union_instances "Box<Result<int,string>>" "Result" seen results)) 1)
    let callback: array<string> = (collect_native_union_instances "fn((Box<int>,int))->Box<string>" "Box" (map_new) [])
    assert (== (array_length callback) 2)
    assert (native_name_in callback "Box<int>")
    assert (native_name_in callback "Box<string>")
}

/* Find all unique instantiations of a generic union in the codebase */
# I expand actual concrete payload annotations as well as their type arguments.
fn native_expand_union_type(parser: Parser, annotation: string, base_name: string, seen: HashMap<string, int>, expanded: HashMap<string, int>, initial: array<string>, depth: int) -> array<string> {
    if (map_has expanded annotation) { return initial }
    if (> depth 128) {
        set reduce_emission_error "I cannot retain a native type expansion deeper than 128 edges."
        return initial
    }
    (map_put expanded annotation 1)
    let mut results: array<string> = initial
    let mut children: array<string> = []
    if (is_tuple_type annotation) { set children (tuple_split_types annotation) }
    else {
        if (is_fn_type annotation) {
            set children (parse_fn_type_params annotation)
            set children (array_push children (parse_fn_type_return annotation))
        } else {
            let args: array<string> = (extract_type_args annotation)
            set children args
            if (> (array_length args) 0) {
                let base: string = (extract_base_type_name annotation)
                if (and (== base base_name) (not (map_has seen annotation))) {
                    (map_put seen annotation 1)
                    set results (array_push results annotation)
                }
                let mut uindex: int = 0
                while (< uindex (parser_get_union_count parser)) {
                    let declaration: ASTUnion = (parser_get_union parser uindex)
                    if (and (== declaration.name base) (== declaration.generic_param_count (array_length args))) {
                        let mut field: int = 0
                        while (< field (array_length declaration.variant_field_types)) {
                            set children (array_push children (substitute_type_parameters (at declaration.variant_field_types field) declaration.generic_params args))
                            set field (+ field 1)
                        }
                    }
                    set uindex (+ uindex 1)
                }
            }
        }
    }
    let mut i: int = 0
    while (< i (array_length children)) {
        set results (native_expand_union_type parser (at children i) base_name seen expanded results (+ depth 1))
        set i (+ i 1)
    }
    return results
}
shadow native_expand_union_type {
    let tokens: List<LexerToken> = (tokenize_string "union Box<T> { Some { value: T } } union Outer<T> { Some { value: (Box<T>,fn()->Box<T>) } }" "t.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "t.nano")
    let rows: array<string> = (native_expand_union_type parser "Outer<int>" "Box" (map_new) (map_new) [] 0)
    assert (== (array_length rows) 1)
    assert (== (at rows 0) "Box<int>")
}

fn find_union_instantiations(parser: Parser, base_name: string) -> array<string> {
    let mut seen: HashMap<string, int> = (map_new)
    let mut results: array<string> = []
    let expanded: HashMap<string, int> = (map_new)

    /* Scan let statements */
    let let_count: int = (parser_get_let_count parser)
    let mut i: int = 0
    while (< i let_count) {
        let l: ASTLet = (parser_get_let parser i)
        set results (native_expand_union_type parser l.var_type base_name seen expanded results 0)
        set i (+ i 1)
    }

    # A concrete instance can occur only in a retained record field.
    let mut record: int = 0
    while (< record (parser_get_struct_def_count parser)) {
        let definition: ASTStruct = (parser_get_struct_def parser record)
        let mut field: int = 0
        while (< field (array_length definition.field_types)) {
            set results (native_expand_union_type parser (at definition.field_types field) base_name seen expanded results 0)
            set field (+ field 1)
        }
        set record (+ record 1)
    }

    let mut union_index: int = 0
    while (< union_index (parser_get_union_count parser)) {
        let declaration: ASTUnion = (parser_get_union parser union_index)
        if (== declaration.generic_param_count 0) {
            let mut field: int = 0
            while (< field (array_length declaration.variant_field_types)) {
                set results (native_expand_union_type parser (at declaration.variant_field_types field) base_name seen expanded results 0)
                set field (+ field 1)
            }
        }
        set union_index (+ union_index 1)
    }

    /* Scan function return types and parameter types */
    let func_count: int = (parser_get_function_count parser)
    set i 0
    while (< i func_count) {
        let f: ASTFunction = (parser_get_function parser i)
        set results (native_expand_union_type parser f.return_type base_name seen expanded results 0)
        /* Scan parameter types */
        let mut j: int = 0
        while (< j f.param_count) {
            let param: ASTLet = (parser_get_let parser (+ f.param_start j))
            set results (native_expand_union_type parser param.var_type base_name seen expanded results 0)
            set j (+ j 1)
        }
        set i (+ i 1)
    }

    return results
}

shadow find_union_instantiations {
    let parser: Parser = (parser_new (list_LexerToken_new) 0 "t.nano")
    let results: array<string> = (find_union_instantiations parser "Result")
    assert (== (array_length results) 0)
    let tokens: List<LexerToken> = (tokenize_string "struct Outer { boxed: Box<int> } union Box<T> { Some { value: T }, None {} }" "t.nano" (list_CompilerDiagnostic_new))
    let parsed: Parser = (parse_program tokens (list_LexerToken_length tokens) "t.nano")
    let fields: array<string> = (find_union_instantiations parsed "Box")
    assert (== (array_length fields) 1)
    assert (== (at fields 0) "Box<int>")

}

/* Emit C typedefs for one union instantiation (or non-generic union) */
fn emit_union_typedefs(u: ASTUnion, mono_name: string, generic_params: array<string>, type_args: array<string>) -> string {
    let mut sb: array<string> = []
    let c_prefix: string = (+ "nl_" mono_name)

    /* Emit variant structs */
    let mut vi: int = 0
    let mut field_offset: int = 0
    while (< vi u.variant_count) {
        let vname: string = (at u.variant_names vi)
        let fcount: int = (at u.variant_field_counts vi)

        set sb (cg_append sb "typedef struct { ")
        if (== fcount 0) {
            set sb (cg_append sb "int _placeholder; ")
        } else {
            let mut fi: int = 0
            while (< fi fcount) {
                let fname: string = (at u.variant_field_names (+ field_offset fi))
                let ftype: string = (at u.variant_field_types (+ field_offset fi))
                let c_ftype: string = (substitute_union_field_type ftype generic_params type_args)
                set sb (cg_append sb (native_nominal_field_type c_ftype))
                set sb (cg_append sb " ")
                set sb (cg_append sb (mangle_name fname))
                set sb (cg_append sb "; ")
                set fi (+ fi 1)
            }
        }
        set sb (cg_append sb "} ")
        set sb (cg_append sb c_prefix)
        set sb (cg_append sb "_")
        set sb (cg_append sb vname)
        set sb (cg_append sb ";\n")

        set field_offset (+ field_offset fcount)
        set vi (+ vi 1)
    }

    /* Emit tag enum */
    set sb (cg_append sb "typedef enum { ")
    set vi 0
    while (< vi u.variant_count) {
        if (> vi 0) {
            set sb (cg_append sb ", ")
        } else { (print "") }
        let vname2: string = (at u.variant_names vi)
        set sb (cg_append sb c_prefix)
        set sb (cg_append sb "_TAG_")
        set sb (cg_append sb vname2)
        set sb (cg_append sb " = ")
        set sb (cg_append sb (int_to_string vi))
        set vi (+ vi 1)
    }
    set sb (cg_append sb " } ")
    set sb (cg_append sb c_prefix)
    set sb (cg_append sb "_Tag;\n")

    /* Emit main union struct */
    if native_derived_forward_mode { set sb (cg_append sb "struct ") }
    else { set sb (cg_append sb "typedef struct ") }
    set sb (cg_append sb c_prefix)
    set sb (cg_append sb " { ")
    set sb (cg_append sb c_prefix)
    set sb (cg_append sb "_Tag tag; union { ")
    set vi 0
    while (< vi u.variant_count) {
        let vname3: string = (at u.variant_names vi)
        set sb (cg_append sb c_prefix)
        set sb (cg_append sb "_")
        set sb (cg_append sb vname3)
        set sb (cg_append sb " ")
        set sb (cg_append sb vname3)
        set sb (cg_append sb "; ")
        set vi (+ vi 1)
    }
    set sb (cg_append sb "} data; }")
    if (not native_derived_forward_mode) {
        set sb (cg_append sb " ")
        set sb (cg_append sb c_prefix)
    }
    set sb (cg_append sb ";\n")

    return (cg_build sb)
}

shadow emit_union_typedefs {
    assert (== 1 1)
}

/* I keep exact emitted field types, so pointer-backed collections do not
 * introduce by-value layout dependencies. */
fn native_union_definition(u: ASTUnion, name: string, args: array<string>) -> NativeNominalDefinition {
    if (!= (array_length args) u.generic_param_count) {
        return NativeNominalDefinition { c_name: (+ "nl_" name), code: "\n#error I require the declared generic union argument count\n", field_types: [] }
    }
    let mut fields: array<string> = []
    let mut i: int = 0
    while (< i (array_length u.variant_field_types)) {
        set fields (array_push fields (substitute_union_field_type (at u.variant_field_types i) u.generic_params args))
        set i (+ i 1)
    }
    return NativeNominalDefinition { c_name: (+ "nl_" name), code: (emit_union_typedefs u name u.generic_params args), field_types: fields }
}

shadow native_union_definition {
    let toks: List<LexerToken> = (tokenize_string "union Choice { Some { value: int } }" "t.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let u: ASTUnion = (parser_get_union parser 0)
    let definition: NativeNominalDefinition = (native_union_definition u u.name [])
    assert (== definition.c_name "nl_Choice")
    assert (== (at definition.field_types 0) "int64_t")
}

fn collect_native_nominal_definitions(parser: Parser) -> array<NativeNominalDefinition> {
    let mut definitions: array<NativeNominalDefinition> = (collect_native_structs parser)
    let mut ui: int = 0
    while (< ui (parser_get_union_count parser)) {
        let u: ASTUnion = (parser_get_union parser ui)
        if (== u.generic_param_count 0) {
            let definition: NativeNominalDefinition = (native_union_definition u u.name [])
            set definitions (array_push definitions definition)
        } else {
            let instances: array<string> = (find_union_instantiations parser u.name)
            let mut ii: int = 0
            while (< ii (array_length instances)) {
                let instance: string = (at instances ii)
                let definition: NativeNominalDefinition = (native_union_definition u (monomorphize_type_name instance) (extract_type_args instance))
                set definitions (array_push definitions definition)
                set ii (+ ii 1)
            }
        }
        set ui (+ ui 1)
    }
    return definitions
}
shadow collect_native_nominal_definitions {
    let toks: List<LexerToken> = (tokenize_string "struct Point { x: int }" "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (== (array_length (collect_native_nominal_definitions p)) 1)
}

fn order_native_definitions(definitions: array<NativeNominalDefinition>) -> string {
    let mut done: array<string> = []
    let mut out: string = ""
    let mut remaining: int = (array_length definitions)
    while (> remaining 0) {
        let mut progress: bool = false
        let mut i: int = 0
        while (< i (array_length definitions)) {
            let definition: NativeNominalDefinition = (at definitions i)
            let mut emitted: bool = false
            let mut d: int = 0
            while (< d (array_length done)) {
                if (== (at done d) definition.c_name) { set emitted true } else { (print "") }
                set d (+ d 1)
            }
            if (not emitted) {
                let mut ready: bool = true
                let mut f: int = 0
                while (< f (array_length definition.field_types)) {
                    let field: string = (at definition.field_types f)
                    let mut target: int = 0
                    while (< target (array_length definitions)) {
                        let dependency: NativeNominalDefinition = (at definitions target)
                        if (== field dependency.c_name) {
                            let mut resolved: bool = false
                            set d 0
                            while (< d (array_length done)) {
                                if (== (at done d) field) { set resolved true } else { (print "") }
                                set d (+ d 1)
                            }
                            if (not resolved) { set ready false } else { (print "") }
                        } else { (print "") }
                        set target (+ target 1)
                    }
                    set f (+ f 1)
                }
                if ready {
                    set out (+ out definition.code)
                    set done (array_push done definition.c_name)
                    set progress true
                } else { (print "") }
            } else { (print "") }
            set i (+ i 1)
        }
        if (not progress) {
            return (+ out "\n#error I cannot lay out cyclic by-value record and union definitions\n")
        } else { (print "") }
        set remaining 0
        set i 0
        while (< i (array_length definitions)) {
            let definition: NativeNominalDefinition = (at definitions i)
            let mut emitted: bool = false
            let mut d: int = 0
            while (< d (array_length done)) {
                if (== (at done d) definition.c_name) { set emitted true } else { (print "") }
                set d (+ d 1)
            }
            if (not emitted) { set remaining (+ remaining 1) } else { (print "") }
            set i (+ i 1)
        }
    }
    return out
}

shadow order_native_definitions {
    let leaf: NativeNominalDefinition = NativeNominalDefinition { c_name: "Leaf", code: "leaf;", field_types: [] }
    let parent: NativeNominalDefinition = NativeNominalDefinition { c_name: "Parent", code: "parent;", field_types: ["Leaf"] }
    assert (== (order_native_definitions [parent, leaf]) "leaf;parent;")
    let cycle: NativeNominalDefinition = NativeNominalDefinition { c_name: "Cycle", code: "cycle;", field_types: ["Cycle"] }
    assert (str_contains (order_native_definitions [cycle]) "#error")
}

# Callback parameters/results need declarations of records and tuples, but
# nested callback aliases must already be defined. I retain these two edges.
fn native_fn_dependencies(annotation: string) -> array<string> {
    let mut children: array<string> = (parse_fn_type_params annotation)
    set children (array_push children (parse_fn_type_return annotation))
    let mut dependencies: array<string> = []
    let mut i: int = 0
    while (< i (array_length children)) {
        let child: string = (at children i)
        let cname: string = (type_to_c child)
        if (is_fn_type child) { set dependencies (array_push dependencies cname) }
        set i (+ i 1)
    }
    return dependencies
}
shadow native_fn_dependencies {
    (reset_fn_types)
    assert (== (array_length (native_fn_dependencies "fn(Node)->Node")) 0)
    assert (== (array_length (native_fn_dependencies "fn()->fn(int)->int")) 1)
    (reset_fn_types)
}

fn native_opaque_derived_needed() -> bool {
    if native_array_derived_required { return true }
    let mut i: int = 0
    while (< i (array_length native_tuple_annotations)) {
        if (!= (native_opaque_key (at native_tuple_annotations i)) "") { return true }
        set i (+ i 1)
    }
    set i 0
    while (< i (array_length fn_type_originals)) {
        if (!= (native_opaque_key (at fn_type_originals i)) "") { return true }
        set i (+ i 1)
    }
    return false
}
shadow native_opaque_derived_needed {
    (reset_fn_types)
    set native_tuple_annotations []
    assert (not (native_opaque_derived_needed))
}

fn generate_native_nominal_definitions(parser: Parser) -> string {
    let initial: array<NativeNominalDefinition> = (collect_native_nominal_definitions parser)
    if (not (native_opaque_derived_needed)) { return (order_native_definitions initial) }
    set native_derived_forward_mode true
    let mut definitions: array<NativeNominalDefinition> = (collect_native_nominal_definitions parser)
    let mut names: array<string> = []
    let mut i: int = 0
    while (< i (array_length definitions)) {
        let definition: NativeNominalDefinition = (at definitions i)
        set names (array_push names definition.c_name)
        set i (+ i 1)
    }
    let mut tuple_index: int = 0
    let mut function_index: int = 0
    while (or (< tuple_index (array_length native_tuple_annotations)) (< function_index (array_length fn_type_originals))) {
        while (< tuple_index (array_length native_tuple_annotations)) {
            let annotation: string = (at native_tuple_annotations tuple_index)
            let name: string = (tuple_typedef_name annotation)
            if (not (native_name_in names name)) {
                let elements: array<string> = (tuple_split_types annotation)
                let mut dependencies: array<string> = []
                let mut child_index: int = 0
                while (< child_index (array_length elements)) {
                    set dependencies (array_push dependencies (type_to_c (at elements child_index)))
                    set child_index (+ child_index 1)
                }
                let definition: NativeNominalDefinition = NativeNominalDefinition { c_name: name, code: (gen_tuple_typedef annotation), field_types: dependencies }
                set definitions (array_push definitions definition)
                set names (array_push names name)
            }
            set tuple_index (+ tuple_index 1)
        }
        while (< function_index (array_length fn_type_originals)) {
            let annotation: string = (at fn_type_originals function_index)
            let name: string = (at fn_type_names function_index)
            if (not (native_name_in names name)) {
                let dependencies: array<string> = (native_fn_dependencies annotation)
                let definition: NativeNominalDefinition = NativeNominalDefinition { c_name: name, code: (native_fn_typedef annotation name), field_types: dependencies }
                set definitions (array_push definitions definition)
                set names (array_push names name)
            }
            set function_index (+ function_index 1)
        }
    }
    let mut forwards: string = ""
    set i 0
    while (< i (array_length definitions)) {
        let definition: NativeNominalDefinition = (at definitions i)
        if (not (native_name_in fn_type_names definition.c_name)) {
            set forwards (+ forwards (+ "typedef struct " (+ definition.c_name (+ " " (+ definition.c_name ";\n")))))
        }
        set i (+ i 1)
    }
    let result: string = (+ forwards (order_native_definitions definitions))
    set native_derived_emitted_names names
    set native_derived_forward_mode false
    return result
}

shadow generate_native_nominal_definitions {
    let toks: List<LexerToken> = (tokenize_string "struct Point { x: int } union Choice { Some { value: Point } }" "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let code: string = (generate_native_nominal_definitions p)
    assert (str_contains code "nl_Point")
    assert (str_contains code "nl_Choice")
    assert (not (str_contains code "#error"))

    # I test this source helper with retained canonical opaque annotations.
    (mb_reset [1])
    (mb_set_sources ["/derived-layout.nano"])
    let declarations: List<LexerToken> = (tokenize_string "opaque type Handle" "derived-layout.nano" (list_CompilerDiagnostic_new))
    let owner: Parser = (parse_program declarations (list_LexerToken_length declarations) "derived-layout.nano")
    assert (nb_register owner "__derived_test_")
    let opaque_annotation: string = (nb_type "Handle" 1)
    (reset_fn_types)
    set native_tuple_annotations []
    set native_derived_emitted_names []
    set native_opaque_keys []
    set native_opaque_names []
    let callback: string = (+ "fn(Node," (+ opaque_annotation ")->Node"))
    let tuple: string = (+ "(" (+ opaque_annotation (+ "," (+ callback ")"))))
    let source: string = (+ "struct Node { visit: " (+ callback (+ ", pair: " (+ tuple " }"))))
    let derived_tokens: List<LexerToken> = (tokenize_string source "derived-layout.nano" (list_CompilerDiagnostic_new))
    let derived_parser: Parser = (parse_program derived_tokens (list_LexerToken_length derived_tokens) "derived-layout.nano")
    let derived: string = (generate_native_nominal_definitions derived_parser)
    assert (not (str_contains derived "#error"))
    assert (str_contains derived "typedef struct nl_Node nl_Node;")
    assert (str_contains derived "struct nl_Node {")
    assert (str_contains derived (+ (register_fn_type callback) " visit;"))
    assert (str_contains derived (+ (tuple_typedef_name tuple) " pair;"))
    assert (== (generate_fn_type_typedefs) "")
    assert (== native_derived_forward_mode false)
    set native_tuple_annotations []
    set native_derived_emitted_names []
    (reset_fn_types)
    (mb_reset [])
}

/* Generate union definitions from AST */
fn generate_union_definitions(parser: Parser) -> string {
    let union_count: int = (parser_get_union_count parser)
    if (== union_count 0) {
        return ""
    } else { (print "") }

    let mut sb: array<string> = []
    set sb (cg_append sb "/* Union definitions */\n")
    let mut emitted_unions: array<string> = []

    let mut ui: int = 0
    while (< ui union_count) {
        let u: ASTUnion = (parser_get_union parser ui)
        let mut union_dup: bool = false
        let mut udi: int = 0
        while (< udi (array_length emitted_unions)) {
            if (== (at emitted_unions udi) u.name) { set union_dup true } else { (print "") }
            set udi (+ udi 1)
        }
        if (not union_dup) {
        set emitted_unions (array_push emitted_unions u.name)
        if (== u.generic_param_count 0) {
            /* Non-generic union: emit directly */
            let code: string = (emit_union_typedefs u u.name u.generic_params [])
            set sb (cg_append sb code)
        } else {
            /* Generic union: find and emit all instantiations */
            let instantiations: array<string> = (find_union_instantiations parser u.name)
            let mut ii: int = 0
            while (< ii (array_length instantiations)) {
                let inst_type: string = (at instantiations ii)
                let mono_name: string = (monomorphize_type_name inst_type)
                let inst_args: array<string> = (extract_type_args inst_type)
                let code: string = (emit_union_typedefs u mono_name u.generic_params inst_args)
                set sb (cg_append sb code)
                set ii (+ ii 1)
            }
        }
        } else { (print "") }
        set ui (+ ui 1)
    }

    set sb (cg_append sb "\n")
    return (cg_build sb)
}

shadow generate_union_definitions {
    let parser: Parser = (parser_new (list_LexerToken_new) 0 "t.nano")
    let code: string = (generate_union_definitions parser)
    assert (== code "")
}

/* Module System Integration
 * 
 * The self-hosted transpiler can process import statements and generate
 * appropriate forward declarations. Full module resolution, dependency
 * ordering, and linking is handled by the C reference compiler's module.c.
 * 
 * This design allows the self-hosted components to remain lightweight while
 * still supporting the complete module system through the compilation pipeline.
 */

/* Parser accessor functions are now available by importing src_nano/parser.nano */

/* =============================================================================
 * EXPRESSION CODE GENERATION
 * ============================================================================= */

/* Map operator token type to C operator string
 * 
 * Args:
 *   op: LexerToken type of operator
 * 
 * Returns: C operator string
 */
fn operator_to_string(op: int) -> string {
    if (== op LexerTokenType.TOKEN_PLUS) { return "+" }
    else { if (== op LexerTokenType.TOKEN_MINUS) { return "-" }
    else { if (== op LexerTokenType.TOKEN_STAR) { return "*" }
    else { if (== op LexerTokenType.TOKEN_SLASH) { return "/" }
    else { if (== op LexerTokenType.TOKEN_PERCENT) { return "%" }
    else { if (== op LexerTokenType.TOKEN_EQ) { return "==" }
    else { if (== op LexerTokenType.TOKEN_NE) { return "!=" }
    else { if (== op LexerTokenType.TOKEN_LT) { return "<" }
    else { if (== op LexerTokenType.TOKEN_LE) { return "<=" }
    else { if (== op LexerTokenType.TOKEN_GT) { return ">" }
    else { if (== op LexerTokenType.TOKEN_GE) { return ">=" }
    else { if (== op LexerTokenType.TOKEN_AND) { return "&&" }
    else { if (== op LexerTokenType.TOKEN_OR) { return "||" }
    else { return "+" }
    }}}}}}}}}}}}
}

shadow operator_to_string {
    assert (== (operator_to_string LexerTokenType.TOKEN_PLUS) "+")
    assert (== (operator_to_string LexerTokenType.TOKEN_MINUS) "-")
    assert (== (operator_to_string LexerTokenType.TOKEN_EQ) "==")
    assert (== (operator_to_string LexerTokenType.TOKEN_AND) "&&")
}

/* Helper to build array binary operation expressions using StringBuilder */
/* I apply my scalar policy only to an already resolved floating element. */
fn legacy_array_element_operation(left: string, right: string, c_elem: string, op: string) -> string {
    if (== c_elem "double") {
        let mut helper: string = ""
        if (== op "+") { set helper "nano_rt_f64_add" }
        if (== op "-") { set helper "nano_rt_f64_sub" }
        if (== op "*") { set helper "nano_rt_f64_mul" }
        if (== op "/") { set helper "nano_rt_f64_div" }
        if (!= helper "") { return (+ helper (+ "(" (+ left (+ ", " (+ right ")"))))) }
    }
    return (+ "(" (+ left (+ " " (+ op (+ " " (+ right ")"))))))
}
shadow legacy_array_element_operation {
    assert (== (legacy_array_element_operation "x" "y" "double" "/") "nano_rt_f64_div(x, y)")
    assert (== (legacy_array_element_operation "x" "y" "int64_t" "+") "(x + y)")
    assert (== (legacy_array_element_operation "s" "x" "double" "-") "nano_rt_f64_sub(s, x)")
}

fn build_array_binop_expr(left_code: string, right_code: string, elem_enum: string, get_fn: string, push_fn: string, c_elem: string, op_str2: string, left_is_arr: bool, right_is_arr: bool, is_plus: bool, is_string: bool) -> string {
    let mut sb: array<string> = []
    
    if (and left_is_arr right_is_arr) {
        set sb (cg_append sb "({ DynArray* _a = ")
        set sb (cg_append sb left_code)
        set sb (cg_append sb "; DynArray* _b = ")
        set sb (cg_append sb right_code)
        set sb (cg_append sb "; assert(dyn_array_length(_a) == dyn_array_length(_b)); DynArray* _out = dyn_array_new(")
        set sb (cg_append sb elem_enum)
        set sb (cg_append sb "); int64_t _len = dyn_array_length(_a); for (int64_t _i = 0; _i < _len; _i++) { ")
        set sb (cg_append sb c_elem)
        set sb (cg_append sb " _x = ")
        set sb (cg_append sb get_fn)
        set sb (cg_append sb "(_a, _i); ")
        set sb (cg_append sb c_elem)
        set sb (cg_append sb " _y = ")
        set sb (cg_append sb get_fn)
        set sb (cg_append sb "(_b, _i); ")
        set sb (cg_append sb push_fn)
        set sb (cg_append sb "(_out, ")
        
        if is_string {
            if is_plus {
                set sb (cg_append sb "nl_str_concat(_x, _y)")
            } else {
                set sb (cg_append sb "0")
            }
        } else {
            set sb (cg_append sb (legacy_array_element_operation "_x" "_y" c_elem op_str2))
        }
        
        set sb (cg_append sb "); } _out; })")
        return (cg_build sb)
    } else {
        if (and left_is_arr (not right_is_arr)) {
            set sb (cg_append sb "({ DynArray* _a = ")
            set sb (cg_append sb left_code)
            set sb (cg_append sb "; ")
            set sb (cg_append sb c_elem)
            set sb (cg_append sb " _s = ")
            set sb (cg_append sb right_code)
            set sb (cg_append sb "; DynArray* _out = dyn_array_new(")
            set sb (cg_append sb elem_enum)
            set sb (cg_append sb "); int64_t _len = dyn_array_length(_a); for (int64_t _i = 0; _i < _len; _i++) { ")
            set sb (cg_append sb c_elem)
            set sb (cg_append sb " _x = ")
            set sb (cg_append sb get_fn)
            set sb (cg_append sb "(_a, _i); ")
            set sb (cg_append sb push_fn)
            set sb (cg_append sb "(_out, ")
            if is_string {
                if is_plus {
                    set sb (cg_append sb "nl_str_concat(_x, _s)")
                } else {
                    set sb (cg_append sb "0")
                }
            } else {
                set sb (cg_append sb (legacy_array_element_operation "_x" "_s" c_elem op_str2))
            }
            set sb (cg_append sb "); } _out; })")
            return (cg_build sb)
        } else {
            if (and (not left_is_arr) right_is_arr) {
                set sb (cg_append sb "({ ")
                set sb (cg_append sb c_elem)
                set sb (cg_append sb " _s = ")
                set sb (cg_append sb left_code)
                set sb (cg_append sb "; DynArray* _a = ")
                set sb (cg_append sb right_code)
                set sb (cg_append sb "; DynArray* _out = dyn_array_new(")
                set sb (cg_append sb elem_enum)
                set sb (cg_append sb "); int64_t _len = dyn_array_length(_a); for (int64_t _i = 0; _i < _len; _i++) { ")
                set sb (cg_append sb c_elem)
                set sb (cg_append sb " _x = ")
                set sb (cg_append sb get_fn)
                set sb (cg_append sb "(_a, _i); ")
                set sb (cg_append sb push_fn)
                set sb (cg_append sb "(_out, ")
                if is_string {
                    if is_plus {
                        set sb (cg_append sb "nl_str_concat(_s, _x)")
                    } else {
                        set sb (cg_append sb "0")
                    }
                } else {
                    set sb (cg_append sb (legacy_array_element_operation "_s" "_x" c_elem op_str2))
                }
                set sb (cg_append sb "); } _out; })")
                return (cg_build sb)
            } else {
                return ""
            }
        }
    }
}

