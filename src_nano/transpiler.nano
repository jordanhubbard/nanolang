    let tokens: List<LexerToken> = (tokenize_string "fn main() -> int { return (array_push [1] 2) }" "push.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "push.nano")
    let call: ASTCall = (parser_get_call parser 0)
    let identifier: ASTIdentifier = (parser_get_identifier parser call.function)
