    if (!= (genenv_get env identifier.name) "") { return false }
    let name: string = (mb_resolve identifier.name identifier.line env.names)
    if (not (or (== name "reduce") (== name "array_fold"))) { return false }
    return (== (lookup_func_return_type_in_parser parser name) "")
}
