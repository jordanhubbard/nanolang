fn generate_scalar_reduce(parser: Parser, call: ASTCall, env: GenEnv) -> string {
    if (!= call.arg_count 3) { return (reduce_emission_fail "I require three operands for legacy reduce.") }
    let source: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
    let initial: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
    let callback: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 2))
    let accumulator: string = (infer_expr_type parser initial.node_id initial.node_type env)
    let container: string = (+ "array<" (+ accumulator ">"))
    let source_type: string = (infer_expr_type parser source.node_id source.node_type env)
    let mut source_matches: bool = (== source_type container)
    if (== source.node_type ParseNodeType.PNODE_ARRAY_LITERAL) {
        if (== (parser_get_array_literal parser source.node_id).element_count 0) {
            set source_matches (or source_matches (== source_type "array<unknown>"))
        }
    }
    let signature: string = (infer_expr_type parser callback.node_id callback.node_type env)
    let mut parameters: array<string> = []
    let mut result: string = ""
    if (is_fn_type signature) {
        set parameters (parse_fn_type_params signature)
        set result (parse_fn_type_return signature)
    } else {
        if (== callback.node_type ParseNodeType.PNODE_IDENTIFIER) {
            let identifier: ASTIdentifier = (parser_get_identifier parser callback.node_id)
            if (== (genenv_get env identifier.name) "") {
                let name: string = (mb_resolve identifier.name identifier.line env.names)
                let mut i: int = 0
                while (< i (parser_get_function_count parser)) {
                    let function: ASTFunction = (parser_get_function parser i)
                    if (== function.name name) {
                        let mut parameter_index: int = 0
                        while (< parameter_index function.param_count) {
                            set parameters (array_push parameters (parser_get_let parser (+ function.param_start parameter_index)).var_type)
                            set parameter_index (+ parameter_index 1)
                        }
                        set result function.return_type
                    }
                    set i (+ i 1)
                }
            }
        }
    }
    let mut exact: bool = (and source_matches (== (array_length parameters) 2))
    if exact {
        set exact (and (== result accumulator) (and (== (at parameters 0) accumulator) (== (at parameters 1) accumulator)))
    }
    let mut helper: string = ""
    if (== accumulator "int") { set helper "nano_rt_reduce_int" }
    if (== accumulator "float") { set helper "nano_rt_reduce_float" }
    if (== accumulator "string") { set helper "nano_rt_reduce_str" }
    if (or (not exact) (== helper "")) { return (reduce_emission_fail "I require a supported exact homogeneous int, float or string callback ABI for legacy reduce.") }
    let source_code: string = (generate_expression parser source.node_id source.node_type env container)
    let initial_code: string = (generate_expression parser initial.node_id initial.node_type env accumulator)
    let callback_code: string = (generate_expression parser callback.node_id callback.node_type env "")
    let mut parts: array<string> = []
    set parts (cg_append parts (+ "({ DynArray* nano_rt_reduce_source = " (+ source_code "; ")))
    set parts (cg_append parts (+ (type_to_c accumulator) (+ " nano_rt_reduce_initial = " (+ initial_code "; "))))
    set parts (cg_append parts (+ "__auto_type nano_rt_reduce_callback = " (+ callback_code "; ")))
    set parts (cg_append parts (+ helper "(nano_rt_reduce_source, nano_rt_reduce_initial, nano_rt_reduce_callback); })"))
    return (cg_build parts)
}
shadow generate_scalar_reduce {
    let tokens: List<LexerToken> = (tokenize_string "fn combine(a:float,b:float)->float{return (+ a b)} fn main()->int{let value:float=(reduce xs 0.0 combine) return 0}" "reduce.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "reduce.nano")
    let env: GenEnv = (genenv_put (genenv_new "main") "xs" "array<float>" false)
    let code: string = (generate_scalar_reduce parser (parser_get_call parser (- parser.calls_count 1)) env)
    assert (str_contains code "nano_rt_reduce_float(")
    assert (str_contains code "nano_rt_reduce_source = ")
}

fn generate_scalar_map(parser: Parser, call: ASTCall, env: GenEnv) -> string {
    let source: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
    let transform: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
    let signature: string = (infer_expr_type parser transform.node_id transform.node_type env)
    let mut input_type: string = ""
    let mut result_type: string = ""
    if (is_fn_type signature) {
        let parameters: array<string> = (parse_fn_type_params signature)
        if (== (array_length parameters) 1) {
            set input_type (at parameters 0)
            set result_type (parse_fn_type_return signature)
        }
    } else {
        if (== transform.node_type ParseNodeType.PNODE_IDENTIFIER) {
            let identifier: ASTIdentifier = (parser_get_identifier parser transform.node_id)
            let name: string = (mb_resolve identifier.name identifier.line env.names)
            set input_type (declared_call_argument_type parser name 0)
            set result_type (lookup_func_return_type_in_parser parser name)
        }
    }
    let scalar_inputs: bool = (or (or (== input_type "int") (== input_type "float")) (or (== input_type "bool") (== input_type "string")))
    let scalar_results: bool = (or (or (== result_type "int") (== result_type "float")) (or (== result_type "bool") (== result_type "string")))
    if (not (and scalar_inputs scalar_results)) { return "" }
    let source_code: string = (generate_expression parser source.node_id source.node_type env (+ "array<" (+ input_type ">")))
    let transform_code: string = (generate_expression parser transform.node_id transform.node_type env "")
    let mut parts: array<string> = []
    set parts (cg_append parts (+ "({ DynArray* _nano_map_source = " (+ source_code "; ")))
    set parts (cg_append parts (+ "__auto_type _nano_map_transform = " (+ transform_code "; ")))
    set parts (cg_append parts (+ "DynArray* _nano_map_result = dyn_array_new(" (+ (elem_enum_from_elem_type result_type) "); ")))
    set parts (cg_append parts "int64_t _nano_map_length = dyn_array_length(_nano_map_source); ")
    set parts (cg_append parts "for (int64_t _nano_map_index = 0; _nano_map_index < _nano_map_length; ++_nano_map_index) { ")
    set parts (cg_append parts (+ (push_fn_from_elem_type result_type) "(_nano_map_result, _nano_map_transform("))
    set parts (cg_append parts (+ (get_fn_from_elem_type input_type) "(_nano_map_source, _nano_map_index))); } _nano_map_result; })"))
    return (cg_build parts)
}

