    let text: string = "fn convert(n: int) -> float { return 1.5 } fn main() -> int { let xs: array<int> = [] let ys: array<float> = (map xs convert) return 0 }"
    let tokens: List<LexerToken> = (tokenize_string text "map.nano" (list_CompilerDiagnostic_new))
