    let code2: string = (generate_function_body p2 func2.body env2 "int")
    assert (str_contains code2 "return")
}

/* =============================================================================
 * TRANSPILER WRAPPER - Top-level entry point for transpiling a program
 * ============================================================================= */

/* Transpile a parsed and type-checked program to C code from actual AST
 * 
 * This version walks through the actual Parser AST and generates:
 * 1. C includes and runtime helpers
 * 2. Function definitions from AST
 * 3. Complete compilable C program
 * 
 * Args:
 *   parser: The parsed AST from the parser
 * 
 * Returns: Generated C code as a string
 */
/* Check if a let index is referenced by a block (or its nested blocks) */
fn is_let_in_block(parser: Parser, block_id: int, let_idx: int) -> bool {
    if (< block_id 0) {
        return false
    } else {
        let block: ASTBlock = (parser_get_block parser block_id)
        let stmt_count: int = (list_ASTStmtRef_length block.statements)
        let mut i: int = 0
        while (< i stmt_count) {
            let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements i)
            if (and (== stmt.node_type ParseNodeType.PNODE_LET) (== stmt.node_id let_idx)) {
                return true
            } else { (print "") }
            if (== stmt.node_type ParseNodeType.PNODE_IF) {
                let if_stmt: ASTIf = (parser_get_if parser stmt.node_id)
                if (is_let_in_block parser if_stmt.then_body let_idx) {
                    return true
                } else { (print "") }
                if (is_let_in_block parser if_stmt.else_body let_idx) {
                    return true
                } else { (print "") }
            } else { (print "") }
            if (== stmt.node_type ParseNodeType.PNODE_WHILE) {
                let while_stmt: ASTWhile = (parser_get_while parser stmt.node_id)
                if (is_let_in_block parser while_stmt.body let_idx) {
                    return true
                } else { (print "") }
            } else { (print "") }
            if (== stmt.node_type ParseNodeType.PNODE_FOR) {
                let for_stmt: ASTFor = (parser_get_for parser stmt.node_id)
                if (is_let_in_block parser for_stmt.body let_idx) {
                    return true
                } else { (print "") }
            } else { (print "") }
            if (== stmt.node_type ParseNodeType.PNODE_MATCH) {
                let match_stmt: ASTMatch = (parser_get_match parser stmt.node_id)
                let mut ai: int = 0
                while (< ai match_stmt.arm_count) {
                    let arm_body_id: int = (at match_stmt.arm_body_ids ai)
                    if (is_let_in_block parser arm_body_id let_idx) {
                        return true
                    } else { (print "") }
                    set ai (+ ai 1)
                }
            } else { (print "") }
            if (== stmt.node_type ParseNodeType.PNODE_BLOCK) {
                if (is_let_in_block parser stmt.node_id let_idx) {
                    return true
                } else { (print "") }
            } else { (print "") }
            set i (+ i 1)
        }
        return false
    }
}

shadow is_let_in_block {
    let src: string = "fn main() -> int { let x: int = 1 return x }"
    let toks: List<LexerToken> = (tokenize_string src "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (not (is_let_in_block p -1 0))
}

/* Check if a let is a function parameter, inside a function body, or inside a shadow block */
fn is_let_in_function(parser: Parser, let_idx: int) -> bool {
    let mut block_index: int = 0
    while (< block_index (list_ASTBlock_length parser.blocks)) {
        let block: ASTBlock = (parser_get_block parser block_index)
        let mut statement: int = 0
        while (< statement (list_ASTStmtRef_length block.statements)) {
            let item: ASTStmtRef = (list_ASTStmtRef_get block.statements statement)
            if (and (== item.node_type ParseNodeType.PNODE_LET) (== item.node_id let_idx)) { return true }
            set statement (+ statement 1)
        }
        set block_index (+ block_index 1)
    }
    # Every unsafe block is lexical, never a top-level declaration container.
    let mut unsafe_index: int = 0
    while (< unsafe_index (list_ASTUnsafeBlock_length parser.unsafe_blocks)) {
        let block: ASTUnsafeBlock = (parser_get_unsafe_block parser unsafe_index)
        let mut statement: int = 0
        while (< statement (list_ASTStmtRef_length block.statements)) {
            let item: ASTStmtRef = (list_ASTStmtRef_get block.statements statement)
            if (and (== item.node_type ParseNodeType.PNODE_LET) (== item.node_id let_idx)) { return true }
            set statement (+ statement 1)
        }
        set unsafe_index (+ unsafe_index 1)
    }
    let func_count: int = (parser_get_function_count parser)
    let mut fi: int = 0
    while (< fi func_count) {
        let func: ASTFunction = (parser_get_function parser fi)
        if (and (>= let_idx func.param_start) (< let_idx (+ func.param_start func.param_count))) {
            return true
        } else { (print "") }
        set fi (+ fi 1)
    }
    return false
}

shadow is_let_in_function {
    let src: string = "let global: int = 9 fn main() -> int { let x: int = 1 unsafe { let y: int = 2 if true { let z: int = 3 } } return x } shadow main { unsafe { let s: int = 4 } }"
    let toks: List<LexerToken> = (tokenize_string src "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (not (is_let_in_function p 0))
    assert (is_let_in_function p 1)
    assert (is_let_in_function p 2)
    assert (is_let_in_function p 3)
    assert (is_let_in_function p 4)
    let flags: array<bool> = (declaration_local_lets p)
    let mut i: int = 0
    while (< i (array_length flags)) {
        assert (== (at flags i) (is_let_in_function p i))
        set i (+ i 1)
    }
}

/* Extract a C literal string for a global let's initial value.
 * Used by both the plain declaration and the NL_GUARDED_INIT constructor. */
fn global_init_literal(parser: Parser, let_node: ASTLet) -> string {
    if (== let_node.value_type ParseNodeType.PNODE_NUMBER) {
        let num: ASTNumber = (parser_get_number parser let_node.value)
        if (== num.value "-9223372036854775808") {
            return "INT64_MIN"
        } else {
            return num.value
        }
    } else {
        if (== let_node.value_type ParseNodeType.PNODE_FLOAT) {
            let flt: ASTFloat = (parser_get_float parser let_node.value)
            return flt.value
        } else {
            if (== let_node.value_type ParseNodeType.PNODE_STRING) {
                let str_node: ASTString = (parser_get_string parser let_node.value)
                return (gen_string str_node.value)
            } else {
                if (== let_node.value_type ParseNodeType.PNODE_BOOL) {
                    let bool_node: ASTBool = (parser_get_bool parser let_node.value)
                    if bool_node.value {
                        return "true"
                    } else {
                        return "false"
                    }
                } else {
                    return "0"
                }
            }
        }
    }
}

shadow global_init_literal {
    let src: string = "let banner: string = \"a\nb\""
    let toks: List<LexerToken> = (tokenize_string src "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (== (global_init_literal p (parser_get_let p 0)) "\"a\\nb\"")
}

# I admit only the exact bit intrinsics to this additional startup path.
fn global_bit_initializer(parser: Parser, item: ASTLet) -> bool {
    if (!= item.value_type ParseNodeType.PNODE_CALL) { return false }
    let call: ASTCall = (parser_get_call parser item.value)
    if (or (!= call.function_type ParseNodeType.PNODE_IDENTIFIER) (!= call.arg_count 1)) { return false }
    let name: string = (parser_get_identifier parser call.function).name
    return (or (and (== name "float_from_bits") (== item.var_type "float")) (and (== name "float_to_bits") (== item.var_type "int")))
}
shadow global_bit_initializer {
    let tokens: List<LexerToken> = (tokenize_string "let bits: float = (float_from_bits 1) let plain: int = 1" "t.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "t.nano")
    assert (global_bit_initializer parser (parser_get_let parser 0))
    assert (not (global_bit_initializer parser (parser_get_let parser 1)))
}

# I move only exact FLOAT arithmetic roots into ordered startup.
fn global_float_arithmetic_initializer(parser: Parser, item: ASTLet, env: GenEnv) -> bool {
    if (or (!= item.var_type "float") (!= item.value_type ParseNodeType.PNODE_BINARY_OP)) { return false }
    let operation: ASTBinaryOp = (parser_get_binary_op parser item.value)
    if operation.is_unary { return (== (infer_expr_type parser operation.right operation.right_type env) "float") }
    if (not (or (or (== operation.op LexerTokenType.TOKEN_PLUS) (== operation.op LexerTokenType.TOKEN_MINUS))
                (or (== operation.op LexerTokenType.TOKEN_STAR) (== operation.op LexerTokenType.TOKEN_SLASH)))) { return false }
    return (and (== (infer_expr_type parser operation.left operation.left_type env) "float")
                (== (infer_expr_type parser operation.right operation.right_type env) "float"))
}
shadow global_float_arithmetic_initializer {
    let tokens: List<LexerToken> = (tokenize_string "let a: float = (+ 1.0 2.0) let b: int = (+ 1 2)" "t.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "t.nano")
    let env: GenEnv = (genenv_new "global")
    assert (global_float_arithmetic_initializer parser (parser_get_let parser 0) env)
    assert (not (global_float_arithmetic_initializer parser (parser_get_let parser 1) env))
}

/* Generate global constant declarations for top-level let statements.
 * Immutable globals and complex mutable globals: plain C declarations.
 * Mutable primitive globals (int/float/bool/string): NlGuarded_* with constructor. */
# I reserve static initialization for direct scalar literals only.
fn global_requires_runtime_initializer(item: ASTLet) -> bool {
    if (== item.value_type ParseNodeType.PNODE_NUMBER) { return false }
    if (== item.value_type ParseNodeType.PNODE_FLOAT) { return false }
    if (== item.value_type ParseNodeType.PNODE_STRING) { return false }
    if (== item.value_type ParseNodeType.PNODE_BOOL) { return false }
    return true
}
shadow global_requires_runtime_initializer {
    let source: string = "let literal: int = 7 let referenced: int = literal let called: int = (answer) let values: array<int> = [1] let flag: bool = true let message: string = \"text\" let number: float = 1.5"
    let tokens: List<LexerToken> = (tokenize_string source "global-init.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "global-init.nano")
    assert (not (global_requires_runtime_initializer (parser_get_let parser 0)))
    assert (global_requires_runtime_initializer (parser_get_let parser 1))
    assert (global_requires_runtime_initializer (parser_get_let parser 2))
    assert (global_requires_runtime_initializer (parser_get_let parser 3))
    assert (not (global_requires_runtime_initializer (parser_get_let parser 4)))
    assert (not (global_requires_runtime_initializer (parser_get_let parser 5)))
    assert (not (global_requires_runtime_initializer (parser_get_let parser 6)))
}

fn generate_global_constants(parser: Parser) -> string {
    let local_lets: array<bool> = (declaration_local_lets parser)
    let total_lets: int = (parser_get_let_count parser)
    let mut sb: array<string> = []
    let mut has_plain: bool = false
    let mut has_guarded: bool = false
    let mut emitted_globals: array<string> = []
    # I preserve initializer order across guarded scalars and union values.
    let mut startup: array<string> = []
    let mut global_env: GenEnv = (genenv_new "global")

    let mut li: int = 0
    while (< li total_lets) {
        let let_node: ASTLet = (parser_get_let parser li)
        if (not (at local_lets li)) {
            let mut glob_dup: bool = false
            let mut gdi: int = 0
            while (< gdi (array_length emitted_globals)) {
                if (== (at emitted_globals gdi) let_node.name) { set glob_dup true } else { (print "") }
                set gdi (+ gdi 1)
            }
            if (not glob_dup) {
            set emitted_globals (array_push emitted_globals let_node.name)
            let guarded: bool = (and let_node.is_mut (is_guarded_primitive let_node.var_type))
            if guarded {
                set global_env (genenv_put_global global_env let_node.name let_node.var_type let_node.is_mut)
            } else {
                set global_env (genenv_put global_env let_node.name let_node.var_type let_node.is_mut)
            }
            # I still discover exact array aliases before layout emission.
            (native_collect_array_type let_node.var_type)
            let runtime_initializer: bool = (global_requires_runtime_initializer let_node)
            if (and let_node.is_mut (is_guarded_primitive let_node.var_type)) {
                /* Guarded mutable primitive: declare NlGuarded_* struct, init in ctor */
                if (not has_guarded) {
                    set sb (cg_append sb "/* Module-scope mutable primitives (thread-safe via libdispatch) */\n")
                    set has_guarded true
                } else { (print "") }
                set sb (cg_append sb (guarded_type_name let_node.var_type))
                set sb (cg_append sb " nl_")
                set sb (cg_append sb (mangle_name let_node.name))
                set sb (cg_append sb ";\n")
                let mut initial_value: string = (global_init_literal parser let_node)
                if runtime_initializer { set initial_value (generate_expression parser let_node.value let_node.value_type global_env let_node.var_type) }
                let init: string = (+ (+ (+ (+ (+ "    NL_GUARDED_INIT(nl_" (mangle_name let_node.name)) ", \"nano.") let_node.name) "\", ") initial_value)
                set startup (array_push startup (+ init ");\n"))
            } else {
                /* Plain declaration: immutable global or mutable complex type */
                if (not has_plain) {
                    set sb (cg_append sb "/* Global constants */\n")
                    set has_plain true
                } else { (print "") }
                let c_type: string = (type_to_c let_node.var_type)
                set sb (cg_append sb c_type)
                set sb (cg_append sb " nl_")
                set sb (cg_append sb (mangle_name let_node.name))
                if runtime_initializer {
                    set sb (cg_append sb ";\n")
                    let initial: string = (generate_expression parser let_node.value let_node.value_type global_env let_node.var_type)
                    set startup (array_push startup (+ (+ (+ (+ "    nl_" (mangle_name let_node.name)) " = ") initial) ";\n"))
                } else {
                    set sb (cg_append sb " = ")
                    set sb (cg_append sb (global_init_literal parser let_node))
                    set sb (cg_append sb ";\n")
                }
            }
            } else { (print "") }
        } else { (print "") }
        set li (+ li 1)
    }
    # I evaluate nonliteral globals in source order after declarations/prototypes.
    if (> (array_length startup) 0) {
        set sb (cg_append sb "\n__attribute__((constructor)) static void nl_init_guarded_globals(void) {\n")
        let mut ci: int = 0
        while (< ci (array_length startup)) {
            set sb (cg_append sb (at startup ci))
            set ci (+ ci 1)
        }
        set sb (cg_append sb "}\n")
    }
    if (or has_plain has_guarded) {
        set sb (cg_append sb "\n")
    } else { (print "") }
    return (cg_build sb)
}

shadow generate_global_constants {
    let src: string = "fn main() -> int { return 0 }"
    let toks: List<LexerToken> = (tokenize_string src "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let c: string = (generate_global_constants p)
    assert (== (str_length c) 0)
    let union_source: string = "union Box<T> { Value { value: T } } let box: Box<int> = Box.Value { value: 7 }"
    let union_tokens: List<LexerToken> = (tokenize_string union_source "t.nano" (list_CompilerDiagnostic_new))
    let unions: Parser = (parse_program union_tokens (list_LexerToken_length union_tokens) "t.nano")
    let globals: string = (generate_global_constants unions)
    assert (str_contains globals "nl_Box_int nl_box;")
    assert (str_contains globals "nl_box = ((nl_Box_int)")
    assert (str_contains globals "nl_Box_int_TAG_Value")
    let saved_required: bool = native_array_derived_required
    let saved_tuples: array<string> = native_tuple_annotations
    let saved_functions: array<string> = fn_type_originals
    let saved_names: array<string> = fn_type_names
    let saved_emitted: array<string> = native_derived_emitted_names
    set native_array_derived_required false
    set native_tuple_annotations []
    set fn_type_originals []
    set fn_type_names []
    set native_derived_emitted_names []
    let array_tokens: List<LexerToken> = (tokenize_string "let pairs: array<(int,bool)> = [] let callbacks: array<fn(int)->int> = []" "global-array.nano" (list_CompilerDiagnostic_new))
    let arrays: Parser = (parse_program array_tokens (list_LexerToken_length array_tokens) "global-array.nano")
    let product: string = (gen_c_program_with_modules arrays "")
    assert (str_contains product "nl_pairs = ({")
    assert (str_contains product "nl_callbacks = ({")
    let tuple_position: int = (transp_str_index_of product "struct Tuple_int_bool {")
    let callback_position: int = (transp_str_index_of product "typedef int64_t (*nl_FnPtr_0)(int64_t);")
    let globals_position: int = (transp_str_index_of product "/* Global constants */")
    assert (>= tuple_position 0)
    assert (>= callback_position 0)
    assert (< tuple_position globals_position)
    assert (< callback_position globals_position)
    # I retain the qualified callable-global ordering control without replacing
    # the stronger mixed graph and exact-array controls above.
    set native_array_derived_required false
    set native_tuple_annotations []
    set native_derived_emitted_names []
    (reset_fn_types)
    let callback_source: string = "fn increment(x: int) -> int { return (+ x 1) } let callback: fn(int) -> int = increment"
    let callback_tokens: List<LexerToken> = (tokenize_string callback_source "t.nano" (list_CompilerDiagnostic_new))
    let callback_parser: Parser = (parse_program callback_tokens (list_LexerToken_length callback_tokens) "t.nano")
    let callback_code: string = (gen_c_program_with_modules callback_parser "")
    let typedef_at: int = (transp_str_index_of callback_code "typedef int64_t (*nl_FnPtr_0)(int64_t);")
    let global_at: int = (transp_str_index_of callback_code "nl_FnPtr_0 nl_callback;")
    assert (>= typedef_at 0)
    assert (> global_at typedef_at)
    assert (str_contains callback_code "nl_callback = nl_increment;")
    set native_array_derived_required saved_required
    set native_tuple_annotations saved_tuples
    set fn_type_originals saved_functions
    set fn_type_names saved_names
    set native_derived_emitted_names saved_emitted
}

fn lookup_func_return_type_in_parser(parser: Parser, name: string) -> string {
    let func_count: int = (parser_get_function_count parser)
    let mut i: int = 0
    while (< i func_count) {
        let func: ASTFunction = (parser_get_function parser i)
        if (== func.name name) {
            return func.return_type
        } else { (print "") }
        set i (+ i 1)
    }
    return ""
}

shadow lookup_func_return_type_in_parser {
    let src: string = "fn add(a: int, b: int) -> int { return 0 }"
    let toks: List<LexerToken> = (tokenize_string src "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (== (lookup_func_return_type_in_parser p "add") "int")
    assert (== (lookup_func_return_type_in_parser p "nonexistent") "")
}

/* Check if any grammar literal (peg2_compile call) was used in the parsed AST.
 * Returns 1 if found, 0 otherwise. */
fn parser_uses_grammar_literal(parser: Parser) -> int {
    let call_count: int = (parser_get_call_count parser)
    let mut i: int = 0
    while (< i call_count) {
        let call: ASTCall = (parser_get_call parser i)
        if (== call.function_type ParseNodeType.PNODE_IDENTIFIER) {
            let call_fn_id: ASTIdentifier = (parser_get_identifier parser call.function)
            if (== call_fn_id.name "peg2_compile") { return 1 } else { (print "") }
        } else { (print "") }
        set i (+ i 1)
    }
    return 0
}

shadow parser_uses_grammar_literal {
    let empty_tokens: List<LexerToken> = (list_LexerToken_new)
    let p: Parser = (parser_new empty_tokens 0 "t.nano")
    assert (== (parser_uses_grammar_literal p) 0)
}

/* Check if the peg2 module is already imported.
 * Checks both import statements (original source) and merged extern function
 * declarations (stage1 merged source where imports have been inlined). */
fn parser_has_peg2_import(parser: Parser) -> int {
    /* Check explicit import statements */
    let import_count: int = (parser_get_import_count parser)
    let mut i: int = 0
    while (< i import_count) {
        let imp: ASTImport = (parser_get_import parser i)
        if (str_contains imp.module_path "peg2") {
            return 1
        } else {
            (print "")
        }
        set i (+ i 1)
    }
    /* Also check if peg2_compile is defined as a function (merged source case) */
    let fn_count: int = (parser_get_function_count parser)
    let mut fi: int = 0
    while (< fi fn_count) {
        let f: ASTFunction = (parser_get_function parser fi)
        if (== (transp_str_starts_with f.name "peg2_") true) {
            return 1
        } else { (print "") }
        set fi (+ fi 1)
    }
    return 0
}

shadow parser_has_peg2_import {
    let empty_tokens: List<LexerToken> = (list_LexerToken_new)
    let p: Parser = (parser_new empty_tokens 0 "t.nano")
    assert (== (parser_has_peg2_import p) 0)
}

fn transpile_parser_mode(parser: Parser, first_shadow: int) -> string {
    set native_opaque_keys []
    set native_opaque_names []
    set native_tuple_annotations []
    set native_derived_emitted_names []
    set native_derived_forward_mode false
    set native_array_derived_required false
    set reduce_emission_error ""
    if (> parser.services_count 0) { set reduce_emission_error "I have not resolved File service declarations for this consumer." return "" }
    (build_module_alias_map parser)
    (reset_fn_types)

    /* C3: Grammar literal auto-import check.
     * If grammar { } was used but peg2 is not imported, emit a helpful diagnostic. */
    if (== (parser_uses_grammar_literal parser) 1) {
        if (== (parser_has_peg2_import parser) 0) {
            (println "error: grammar { } literal used without importing std/peg2.")
            (println "  Add: import \"modules/std/peg2/peg2.nano\"")
        } else {
            (print "")
        }
    } else {
        (print "")
    }
    
    /* Get function count using accessor */
    let func_count: int = (parser_get_function_count parser)

    let _reg: int = (register_extern_names parser)
    
    /* Precompute top-level env once (not per function).
     * Guarded primitives (module-scope let mut int/float/bool/string) are registered
     * with genenv_put_global so that identifier reads and set statements emit
     * NL_GUARDED_READ / NL_GUARDED_WRITE when accessed from inside functions. */
    let mut global_env: GenEnv = (genenv_new "global")
    let all_lets: int = (parser_get_let_count parser)
    let local_lets: array<bool> = (declaration_local_lets parser)
    let mut gi: int = 0
    while (< gi all_lets) {
        let glet: ASTLet = (parser_get_let parser gi)
        if (not (at local_lets gi)) {
            if (and glet.is_mut (is_guarded_primitive glet.var_type)) {
                set global_env (genenv_put_global global_env glet.name glet.var_type glet.is_mut)
            } else {
                set global_env (genenv_put global_env glet.name glet.var_type glet.is_mut)
            }
        } else { (print "") }
        set gi (+ gi 1)
    }

    /* Generate all functions using sb for O(n) concatenation */
    let mut sb: array<string> = []
    let mut emitted_bodies: array<string> = []
    let mut i: int = 0
    while (< i func_count) {
        let func: ASTFunction = (parser_get_function parser i)

        /* Deduplicate function bodies (merged source may have duplicates) */
        let mut body_dup: bool = false
        let mut bdi: int = 0
        while (< bdi (array_length emitted_bodies)) {
            if (== (at emitted_bodies bdi) func.name) { set body_dup true } else { (print "") }
            set bdi (+ bdi 1)
        }

        if (not body_dup) {
        /* Collect params (stored as lets) */
        let mut params: array<string> = []
        let mut types: array<string> = []
        let mut j: int = 0
        while (< j func.param_count) {
            let param: ASTLet = (parser_get_let parser (+ func.param_start j))
            set params (array_push params param.name)
            set types (array_push types (type_to_c param.var_type))
            set j (+ j 1)
        }

        if (< func.body 0) {
            /* Extern function - prototypes emitted by generate_function_prototypes */
            (print "")
        } else {
            set emitted_bodies (array_push emitted_bodies func.name)
            let mut env0: GenEnv = GenEnv { names: global_env.names, types: global_env.types, mut_flags: global_env.mut_flags, global_flags: global_env.global_flags, underscore_name: global_env.underscore_name, scope: func.name }
            /* Seed env with parameters */
            let mut k: int = 0
            while (< k func.param_count) {
                let plet: ASTLet = (parser_get_let parser (+ func.param_start k))
                set env0 (genenv_put env0 plet.name plet.var_type false)
                set k (+ k 1)
            }

            let body: string = (generate_function_body parser func.body env0 func.return_type)
            let func_code: string = (gen_function func.name params types func.return_type body)
            set sb (cg_append sb func_code)
            set sb (cg_append sb "\n")
        }
        } else { (print "") }

        set i (+ i 1)
    }
    let all_functions: string = (cg_build sb)

    let product: string = (gen_c_program_with_modules parser all_functions)
    if (!= reduce_emission_error "") { return "" }
    if (< first_shadow 0) { return product }

    # I keep NanoLang main callable; only the C process entry is renamed.
    let mut tests: array<string> = []
    set tests (cg_append tests "#undef NDEBUG\n#define main __nano_product_entry\n")
    set tests (cg_append tests product)
    set tests (cg_append tests "\n#undef main\n#include \"runtime/shadow_runner.h\"\n")
    let mut si: int = first_shadow
    while (< si parser.shadows_count) {
        let sh: ASTShadow = (list_ASTShadow_get parser.shadows si)
        let scope: string = (+ "__nano_shadow_" (int_to_string si))
        let env: GenEnv = GenEnv { names: global_env.names, types: global_env.types, mut_flags: global_env.mut_flags, global_flags: global_env.global_flags, underscore_name: global_env.underscore_name, scope: scope }
        set tests (cg_append tests (+ "static void " (+ scope "(void) {\n")))
        set tests (cg_append tests (generate_block parser sh.body 1 env "void"))
        set tests (cg_append tests "}\n")
        set si (+ si 1)
    }
    set tests (cg_append tests "static int __nano_shadow_entry(void) {\n")
    set si first_shadow
    while (< si parser.shadows_count) {
        let label: string = (gen_string (+ "I am testing shadow " (+ (list_ASTShadow_get parser.shadows si).target_name "\n")))
        set tests (cg_append tests (+ "    if (getenv(\"NANO_SHADOW_TRACE\")) fputs(" (+ label ", stderr);\n")))
        set tests (cg_append tests (+ "    __nano_shadow_" (+ (int_to_string si) "();\n")))
        set si (+ si 1)
    }
    set tests (cg_append tests "    return 0;\n}\n")
    set tests (cg_append tests "int main(int argc, char **argv) {\n    g_argc = argc;\n    g_argv = argv;\n    return nl_run_shadow_entry(__nano_shadow_entry, 10);\n}\n")
    if (!= reduce_emission_error "") { return "" }
    return (cg_build tests)
}

shadow transpile_parser_mode {
    let toks: List<LexerToken> = (tokenize_string "fn main() -> int { return 7 } shadow main { assert (== (main) 7) }" "shadow.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "shadow.nano")
    assert (not (str_contains (transpile_parser_mode p -1) "__nano_shadow_"))
    assert (str_contains (transpile_parser_mode p 0) "__nano_shadow_0();")
    assert (== (transpile_last_error) "")
    let bad_tokens: List<LexerToken> = (tokenize_string "fn both(a:bool,b:bool)->bool{return (and a b)} fn main()->int{let value:bool=(reduce [true] true both) return 0}" "reduce-refusal.nano" (list_CompilerDiagnostic_new))
    let bad: Parser = (parse_program bad_tokens (list_LexerToken_length bad_tokens) "reduce-refusal.nano")
    assert (== (transpile_parser_mode bad -1) "")
    assert (str_contains (transpile_last_error) "exact homogeneous")
    assert (!= (transpile_parser_mode p -1) "")
    assert (== (transpile_last_error) "")
    let shadow_tokens: List<LexerToken> = (tokenize_string "fn both(a:bool,b:bool)->bool{return (and a b)} fn main()->int{return 0} shadow main{let value:bool=(reduce [true] true both) assert value}" "reduce-shadow-refusal.nano" (list_CompilerDiagnostic_new))
    let shadow_parser: Parser = (parse_program shadow_tokens (list_LexerToken_length shadow_tokens) "reduce-shadow-refusal.nano")
    assert (!= (transpile_parser_mode shadow_parser -1) "")
    assert (== (transpile_parser_mode shadow_parser 0) "")
    assert (str_contains (transpile_last_error) "exact homogeneous")
    assert (!= (transpile_parser_mode p 0) "")
    assert (== (transpile_last_error) "")
}

pub fn transpile_parser(parser: Parser) -> string {
    return (transpile_parser_mode parser -1)
}

# I accept an explicit suffix of shadows; the driver owns root/import policy.
# An invalid selection fails without emitting a misleading empty test program.
pub fn transpile_parser_shadows(parser: Parser, first_shadow: int) -> string {
    if (or (< first_shadow 0) (> first_shadow parser.shadows_count)) {
        set reduce_emission_error "I require a valid shadow selection."
        return ""
    }
    return (transpile_parser_mode parser first_shadow)
}

shadow transpile_parser_shadows {
    let toks: List<LexerToken> = (tokenize_string "fn f() -> int { return 1 } shadow f { assert false } shadow f { assert true }" "shadow.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "shadow.nano")
    let code: string = (transpile_parser_shadows p 1)
    assert (not (str_contains code "__nano_shadow_0"))
    assert (str_contains code "__nano_shadow_1();")
    assert (== (transpile_parser_shadows p -1) "")
    assert (== (transpile_parser_shadows p 3) "")
}

shadow transpile_parser {
    let source: string = (+ "f" "n main() -> int { return 0 }")
    let toks: List<LexerToken> = (tokenize_string source "t.nano" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let code: string = (transpile_parser p)
    assert (str_contains code "int main(")
}

pub fn transpile_phase(parser: Parser, output_path: string, file_name: string) -> TranspilePhaseOutput {
    let c_source: string = (transpile_parser parser)
    let diagnostics: List<CompilerDiagnostic> = (list_CompilerDiagnostic_new)
    
    # Check if parser has errors before proceeding
    let had_err: bool = (or (parser_has_error parser) (!= (transpile_last_error) ""))
    if (!= (transpile_last_error) "") {
        (Diagnostics.diag_list_add diagnostics (Diagnostics.diag_transpiler_error "TR0002" (transpile_last_error) (Diagnostics.diag_location file_name 0 0)))
    } else {
        if had_err {
            let diag: CompilerDiagnostic = (Diagnostics.diag_transpiler_error "TR0001" "Cannot transpile: parser has errors" (Diagnostics.diag_location file_name 0 0))
            (Diagnostics.diag_list_add diagnostics diag)
        }
    }
    return TranspilePhaseOutput {
        c_source: c_source,
        diagnostics: diagnostics,
        had_error: had_err,
        output_path: output_path
    }
}

shadow transpile_phase {
    let parser: Parser = (parser_new (list_LexerToken_new) 0 "t.nano")
    let output: TranspilePhaseOutput = (transpile_phase parser "a.out.c" "t.nano")
    assert (== output.had_error false)
}

/* Simplified transpile for count-based code generation */
fn transpile_with_count(func_count: int) -> string {
    (println "=== Code Generation ===")
    (print "Generating C code for ")
    (print (int_to_string func_count))
    (println " functions")
    
    /* Generate main function that demonstrates successful compilation */
    let mut body: string = ""
    set body (+ body (gen_indent 1))
    set body (+ body "nl_println(\"========================================\");\n")
    set body (+ body (gen_indent 1))
    set body (+ body "nl_println(\"  nanolang Self-Hosted Compiler\");\n")
    set body (+ body (gen_indent 1))
    set body (+ body "nl_println(\"  Successfully compiled and generated!\");\n")
    set body (+ body (gen_indent 1))
    set body (+ body "nl_println(\"========================================\");\n")
    set body (+ body (gen_indent 1))
    set body (+ body "nl_println(\"\");\n")
    set body (+ body (gen_indent 1))
    
    /* Show compilation stats */
    set body (+ body "nl_print(\"Functions parsed: \");\n")
    set body (+ body (gen_indent 1))
    set body (+ body "nl_print(nl_int_to_string(")
    set body (+ body (int_to_string func_count))
    set body (+ body "));\n")
    set body (+ body (gen_indent 1))
    set body (+ body "nl_println(\"\");\n")
    set body (+ body (gen_indent 1))
    set body (+ body "nl_println(\"NSType checking: PASSED\");\n")
    set body (+ body (gen_indent 1))
    set body (+ body "nl_println(\"Code generation: COMPLETE\");\n")
    set body (+ body (gen_indent 1))
    set body (+ body "nl_println(\"\");\n")
    
    set body (+ body (gen_return "0" 1))
    
    let params: array<string> = []
    let types: array<string> = []
    let main_func: string = (gen_function "main" params types "int" body)
    return (gen_c_program main_func)
}

shadow transpile_with_count {
    let code: string = (transpile_with_count 2)
    assert (str_contains code "Functions parsed:")
}

/* Wrapper for integration (no parser argument) */
fn transpile() -> string {
    /* Simplified version - generates code for one function */
    return (transpile_with_count 1)
}

shadow transpile {
    let c_code: string = (transpile)
    /* Just verify it generates something */
    assert (!= c_code "")
}

/* =============================================================================
 * MAIN ENTRY POINT (For Testing) - REMOVED for library usage
 * ============================================================================= */

/* main() removed to allow importing as a module
 * Use transpile_parser() as the public API */
