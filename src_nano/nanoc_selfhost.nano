/* =============================================================================
 * Legacy Compiler Delegation Wrapper
 * =============================================================================
 * This program delegates compilation to bin/nanoc. It is not a self-hosted
 * compiler and does not parse, type-check, or generate code itself.
 * 
 * Usage:
 *   Stage 0: bin/nanoc src_nano/nanoc_selfhost.nano -o bin/nanoc_sh
 *   Stage 1: bin/nanoc_sh hello.nano -o hello
 *   Result: A NanoLang program compiled by a NanoLang compiler!
 */

/* CLI argument access */
from "modules/std/fs.nano" import exists
from "modules/std/process.nano" import exec

extern fn get_argc() -> int
extern fn get_argv(index: int) -> string

fn show_usage() -> int {
    (println "nanoc_sh - legacy compiler delegation wrapper")
    (println "")
    (println "I delegate compilation to bin/nanoc.")
    (println "")
    (println "Usage: nanoc_sh <input.nano> [options]")
    (println "")
    (println "Options:")
    (println "  -o <file>    Output file (default: a.out)")
    (println "  --help       Show this help")
    return 0
}

/* Simple file check */
fn check_file_exists(filename: string) -> bool {
    return (exists filename)
}

shadow check_file_exists {
    assert (not (check_file_exists "/tmp/nanolang-file-that-does-not-exist"))
}

/* Compile a NanoLang file */
fn compile_file(input: string, output: string) -> int {
    (print "nanoc_sh: Compiling ")
    (print input)
    (print " -> ")
    (println output)
    (println "")
    
    if (not (check_file_exists input)) {
        (println "nanoc_sh: input file does not exist")
        return 1
    }

    (println "Delegating to bin/nanoc...")

    let cmd: string = "bin/nanoc "
    let cmd2: string = (+ cmd input)
    let cmd3: string = (+ cmd2 " -o ")
    let cmd4: string = (+ cmd3 output)
    
    let result: int = (exec cmd4)
    
    if (== result 0) {
        (println "")
        (println "Compilation successful")
        (print "   Output: ")
        (println output)
        return 0
    } else {
        (println "")
        (println "Compilation failed")
        return 1
    }
}

/* Main entry point */
fn main() -> int {
    let argc: int = (get_argc)

    if (< argc 2) {
        return (show_usage)
    } else {
        let input: string = (get_argv 1)
        let mut output: string = "a.out"
        if (>= argc 4) {
            let flag: string = (get_argv 2)
            if (== flag "-o") {
                set output (get_argv 3)
            } else { (print "") }
        } else { (print "") }

        return (compile_file input output)
    }
}

shadow show_usage {
    let result: int = (show_usage)
    assert (== result 0)
}

shadow compile_file {
    assert (== (compile_file "/tmp/nanolang-file-that-does-not-exist" "/tmp/nanolang-unused-output") 1)
}

shadow main {
    assert (>= (get_argc) 0)
}
