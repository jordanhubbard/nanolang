# I retain nominal service identities in checker facts, separately from NSType.
import "src_nano/compiler/service_namespace.nano"
import "src_nano/parser.nano"
from "src_nano/compiler/lexer.nano" import tokenize_string
module "modules/file_source_catalog/file_source_catalog.nano" as TypeCatalog

# Kinds: invalid, int, bool, void, File, scalar record, Result, callable, string.
struct ServiceType {
    kind: int, declaration: int, owner: int, ordinal: int, category: int
}
struct ServiceMethodType {
    ok: bool, declaration: int, owner: int, ordinal: int, input_mode: int,
    parameters: array<ServiceType>, result: ServiceType
}

fn st_scalar(kind: int) -> ServiceType {
    return ServiceType { kind: kind, declaration: 0, owner: -1, ordinal: -1, category: 0 }
}
shadow st_scalar {
    assert (== (st_scalar 1).declaration 0)
    assert (== (st_scalar 0).kind 0)
}

pub fn service_types_equal(left: ServiceType, right: ServiceType) -> bool {
    if (or (== left.kind 0) (!= left.kind right.kind)) { return false }
    return (and (== left.declaration right.declaration) (and (== left.owner right.owner)
        (and (== left.ordinal right.ordinal) (== left.category right.category))))
}
shadow service_types_equal {
    assert (service_types_equal (st_scalar 1) (st_scalar 1))
    assert (not (service_types_equal (st_scalar 1) (st_scalar 2)))
    assert (not (service_types_equal (st_scalar 0) (st_scalar 0)))
}

fn st_catalog_type(space: ServiceNamespace, owner: int, ordinal: int) -> ServiceType {
    let identity: int = (service_namespace_catalog space owner)
    if (or (== identity 0) (or (< ordinal 0) (>= ordinal (TypeCatalog.count identity 1)))) { return (st_scalar 0) }
    let mut i: int = 0
    while (< i (array_length space.names)) {
        let row: ServiceName = (at space.names i)
        if (and (== row.owner owner) (and (== row.kind 8) (and (== row.ordinal ordinal) (== row.id row.target)))) {
            if (or (<= row.id 0) (or (!= row.target_owner owner) (!= row.name (TypeCatalog.catalog_text identity 1 ordinal 1 0)))) { return (st_scalar 0) }
            let mut kind: int = 6
            let mut category: int = 4
            if (== ordinal 0) { set kind 4 set category 1 }
            else if (or (< ordinal 3) (and (== identity 2) (== ordinal 8))) { set kind 5 set category 3 }
            else if (== ordinal 3) { set category 2 }
            return ServiceType { kind: kind, declaration: row.target, owner: owner, ordinal: ordinal, category: category }
        }
        set i (+ i 1)
    }
    return (st_scalar 0)
}
shadow st_catalog_type {
    let empty: ServiceNamespace = ServiceNamespace { status: 0, names: [], plan: FileSourcePlan { status: 0, rows: [], logical_bytes: 0 }, text_bytes: 0, ordinary_count: 0, alias_count: 0 }
    assert (== (st_catalog_type empty 0 0).kind 0)
}

pub fn service_named_type(space: ServiceNamespace, owner: int, name: string) -> ServiceType {
    let found: int = (service_namespace_lookup space owner name)
    if (< found 0) { return (st_scalar 0) }
    let row: ServiceName = (at space.names found)
    if (!= row.kind 8) { return (st_scalar 0) }
    let result: ServiceType = (st_catalog_type space row.target_owner row.ordinal)
    if (!= result.declaration row.target) { return (st_scalar 0) }
    return result
}
shadow service_named_type {
    let empty: ServiceNamespace = ServiceNamespace { status: 0, names: [], plan: FileSourcePlan { status: 0, rows: [], logical_bytes: 0 }, text_bytes: 0, ordinary_count: 0, alias_count: 0 }
    assert (== (service_named_type empty 0 "File").kind 0)
}

fn st_value_type(space: ServiceNamespace, owner: int, id: string) -> ServiceType {
    if (== id "") { return (st_scalar 3) }
    if (== id "nsi:core/int") { return (st_scalar 1) }
    if (== id "nsi:core/bool") { return (st_scalar 2) }
    let identity: int = (service_namespace_catalog space owner)
    let mut ordinal: int = 0
    while (< ordinal (TypeCatalog.count identity 1)) {
        if (== id (TypeCatalog.catalog_text identity 1 ordinal 0 0)) { return (st_catalog_type space owner ordinal) }
        set ordinal (+ ordinal 1)
    }
    return (st_scalar 0)
}
shadow st_value_type {
    let empty: ServiceNamespace = ServiceNamespace { status: 0, names: [], plan: FileSourcePlan { status: 0, rows: [], logical_bytes: 0 }, text_bytes: 0, ordinary_count: 0, alias_count: 0 }
    assert (== (st_value_type empty 0 "").kind 3)
    assert (== (st_value_type empty 0 "nsi:core/bool").kind 2)
    assert (== (st_value_type empty 0 "File").kind 0)
}

pub fn service_member_type(space: ServiceNamespace, owner: ServiceType, name: string) -> ServiceType {
    let expected: ServiceType = (st_catalog_type space owner.owner owner.ordinal)
    if (not (service_types_equal owner expected)) { return (st_scalar 0) }
    let identity: int = (service_namespace_catalog space owner.owner)
    let count: int = (TypeCatalog.catalog_number identity 1 owner.ordinal 1 0)
    let mut i: int = 0
    while (< i count) {
        if (== name (TypeCatalog.catalog_text identity 1 owner.ordinal 3 i)) {
            return (st_value_type space owner.owner (TypeCatalog.catalog_text identity 1 owner.ordinal 4 i))
        }
        set i (+ i 1)
    }
    return (st_scalar 0)
}
shadow service_member_type {
    let empty: ServiceNamespace = ServiceNamespace { status: 0, names: [], plan: FileSourcePlan { status: 0, rows: [], logical_bytes: 0 }, text_bytes: 0, ordinary_count: 0, alias_count: 0 }
    assert (== (service_member_type empty (st_scalar 1) "value").kind 0)
}

pub fn service_method_type(space: ServiceNamespace, owner: int, name: string) -> ServiceMethodType {
    let failure: ServiceMethodType = ServiceMethodType { ok: false, declaration: 0, owner: -1, ordinal: -1, input_mode: 0, parameters: [], result: (st_scalar 0) }
    if (!= space.status 0) { return failure }
    let found: int = (service_namespace_lookup space owner name)
    if (< found 0) { return failure }
    let row: ServiceName = (at space.names found)
    if (or (!= row.kind 9) (or (< row.ordinal 0) (>= row.ordinal 5))) { return failure }
    let identity: int = (service_namespace_catalog space row.target_owner)
    if (== identity 0) { return failure }
    let count: int = (TypeCatalog.catalog_number identity 2 row.ordinal 4 0)
    if (or (< count 1) (> count 3)) { return failure }
    let mut parameters: array<ServiceType> = []
    let mut result: ServiceType = (st_scalar 0)
    let mut i: int = 0
    while (< i count) {
        let item: ServiceType = (st_value_type space row.target_owner (TypeCatalog.catalog_text identity 2 row.ordinal 6 i))
        if (== item.kind 0) { return failure }
        if (== i (- count 1)) { set result item }
        else { set parameters (array_push parameters item) }
        set i (+ i 1)
    }
    return ServiceMethodType { ok: true, declaration: row.target, owner: row.target_owner,
        ordinal: row.ordinal, input_mode: (TypeCatalog.catalog_number identity 2 row.ordinal 3 0),
        parameters: parameters, result: result }
}
shadow service_method_type {
    let empty: ServiceNamespace = ServiceNamespace { status: 0, names: [], plan: FileSourcePlan { status: 0, rows: [], logical_bytes: 0 }, text_bytes: 0, ordinary_count: 0, alias_count: 0 }
    assert (not (service_method_type empty 0 "temp").ok)
}


# I attach each nominal leaf to its original parsed annotation and token extent.
# Containers and callback signatures keep their complete parser spelling.
struct ServiceTypeLeaf { first_token: int, last_token: int, type: ServiceType }
struct ServiceAnnotation {
    node_kind: int, node_id: int, field: int, owner: int, spelling: string,
    leaves: array<ServiceTypeLeaf>
}
struct ServiceAnnotationFacts { ok: bool, annotations: array<ServiceAnnotation> }

pub fn service_annotation_leaves(space: ServiceNamespace, owner: int, spelling: string, formals: array<string>) -> array<ServiceTypeLeaf> {
    let tokens: List<LexerToken> = (tokenize_string spelling "<type>" (list_CompilerDiagnostic_new))
    let mut leaves: array<ServiceTypeLeaf> = []
    let mut i: int = 0
    while (< i (list_LexerToken_length tokens)) {
        let start: int = i
        let token: LexerToken = (list_LexerToken_get tokens i)
        if (== token.token_type LexerTokenType.TOKEN_IDENTIFIER) {
            let mut name: string = token.value
            let mut more: bool = true
            while (and more (< (+ i 2) (list_LexerToken_length tokens))) {
                if (and (== (list_LexerToken_get tokens (+ i 1)).token_type LexerTokenType.TOKEN_DOT)
                        (== (list_LexerToken_get tokens (+ i 2)).token_type LexerTokenType.TOKEN_IDENTIFIER)) {
                    set name (+ name (+ "." (list_LexerToken_get tokens (+ i 2)).value))
                    set i (+ i 2)
                } else { set more false }
            }
            let mut formal: bool = false
            let mut j: int = 0
            while (< j (array_length formals)) {
                if (== name (at formals j)) { set formal true }
                set j (+ j 1)
            }
            # I do not interpret an open-record field label as a type reference.
            let mut label: bool = false
            if (< (+ i 1) (list_LexerToken_length tokens)) {
                set label (== (list_LexerToken_get tokens (+ i 1)).token_type LexerTokenType.TOKEN_COLON)
            }
            if (and (not formal) (not label)) {
                let typ: ServiceType = (service_named_type space owner name)
                if (!= typ.kind 0) {
                    set leaves (array_push leaves ServiceTypeLeaf { first_token: start, last_token: i, type: typ })
                }
            }
        }
        set i (+ i 1)
    }
    return leaves
}
shadow service_annotation_leaves {
    let empty: ServiceNamespace = ServiceNamespace { status: 0, names: [], plan: FileSourcePlan { status: 0, rows: [], logical_bytes: 0 }, text_bytes: 0, ordinary_count: 0, alias_count: 0 }
    assert (== (array_length (service_annotation_leaves empty 0 "fn(int)->array<bool>" [])) 0)
}

pub fn bind_service_annotations(parser: Parser, files: array<string>, sources: array<string>, space: ServiceNamespace) -> ServiceAnnotationFacts {
    let failure: ServiceAnnotationFacts = ServiceAnnotationFacts { ok: false, annotations: [] }
    if (!= space.status 0) { return failure }
    if (== parser.services_count 0) { return ServiceAnnotationFacts { ok: true, annotations: [] } }
    let mut annotations: array<ServiceAnnotation> = []
    let mut kind: int = 1
    let mut leaves: int = 0
    while (<= kind 4) {
        let mut count: int = parser.functions_count
        if (== kind 2) { set count parser.lets_count }
        if (== kind 3) { set count parser.structs_count }
        if (== kind 4) { set count parser.unions_count }
        let mut i: int = 0
        while (< i count) {
            let mut line: int = 0
            let mut fields: array<string> = []
            let mut formals: array<string> = []
            if (== kind 1) { let node: ASTFunction = (parser_get_function parser i) set line node.line set fields [node.return_type] }
            if (== kind 2) { let node: ASTLet = (parser_get_let parser i) set line node.line set fields [node.var_type] }
            if (== kind 3) { let node: ASTStruct = (parser_get_struct_def parser i) set line node.line set fields node.field_types }
            if (== kind 4) { let node: ASTUnion = (parser_get_union parser i) set line node.line set fields node.variant_field_types set formals node.generic_params }
            let owner: int = (sn_owner files sources line)
            if (< owner 0) { return failure }
            let mut field: int = 0
            while (< field (array_length fields)) {
                let spelling: string = (at fields field)
                let types: array<ServiceTypeLeaf> = (service_annotation_leaves space owner spelling formals)
                set leaves (+ leaves (array_length types))
                if (> leaves 16384) { return failure }
                if (> (array_length types) 0) {
                    set annotations (array_push annotations ServiceAnnotation { node_kind: kind, node_id: i,
                        field: field, owner: owner, spelling: spelling, leaves: types })
                }
                set field (+ field 1)
            }
            set i (+ i 1)
        }
        set kind (+ kind 1)
    }
    return ServiceAnnotationFacts { ok: true, annotations: annotations }
}
shadow bind_service_annotations {
    let tokens: List<LexerToken> = (tokenize_string "" "/empty" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "/empty")
    let empty: ServiceNamespace = ServiceNamespace { status: 0, names: [], plan: FileSourcePlan { status: 0, rows: [], logical_bytes: 0 }, text_bytes: 0, ordinary_count: 0, alias_count: 0 }
    assert (bind_service_annotations parser [] [] empty).ok
}
