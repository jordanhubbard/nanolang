# I share one invocation's function bindings between checking and C emission.
# Like the bootstrap compiler's other phase state, this is sequential, not reentrant.
let mut mb_enabled: bool = false
let mut mb_file_starts: array<int> = []
let mut mb_owners: array<int> = []
let mut mb_names: array<string> = []
let mut mb_targets: array<string> = []
let mut mb_definition_owners: array<int> = []
let mut mb_source_paths: array<string> = []
let mut mb_function_names: array<string> = []
let mut mb_function_owners: array<int> = []
let mut mb_function_builtins: array<bool> = []
let mut mb_private_prefix: string = ""

pub fn mb_set_function_visibility(names: array<string>, owners: array<int>, builtins: array<bool>, prefix: string) -> bool {
    if (or (!= (array_length names) (array_length owners)) (== prefix "")) { return false }
    if (!= (array_length names) (array_length builtins)) { return false }
    set mb_function_names names
    set mb_function_owners owners
    set mb_function_builtins builtins
    set mb_private_prefix (+ prefix "private_")
    return true
}
shadow mb_set_function_visibility {
    (mb_reset [1, 8])
    assert (mb_set_function_visibility ["answer"] [0] [false] "reserved_")
    assert (not (mb_set_function_visibility ["other"] [] [false] "different_"))
    assert (== (mb_lookup 1 "answer") "reserved_private_answer")
    (mb_add_target 1 "answer" "exported_answer" 0)
    assert (== (mb_lookup 1 "answer") "exported_answer")
    assert (mb_set_function_visibility ["intrinsic"] [0] [true] "reserved_")
    assert (== (mb_lookup 1 "intrinsic") "intrinsic")
    (mb_add_target 1 "Explicit.intrinsic" (mb_private_target "intrinsic") 0)
    assert (mb_private_name (mb_lookup 1 "Explicit.intrinsic"))
    (mb_add_target 1 "intrinsic" (mb_private_target "intrinsic") 0)
    assert (mb_private_name (mb_lookup 1 "intrinsic"))
    (mb_reset [])
}

pub fn mb_private_target(name: string) -> string {
    return (+ mb_private_prefix name)
}
shadow mb_private_target {
    (mb_reset [1])
    assert (mb_set_function_visibility [] [] [] "reserved_")
    assert (== (mb_private_target "answer") "reserved_private_answer")
    (mb_reset [])
}

pub fn mb_private_name(name: string) -> bool {
    return (and (!= mb_private_prefix "") (str_starts_with name mb_private_prefix))
}
shadow mb_private_name {
    (mb_reset [1])
    assert (mb_set_function_visibility [] [] [] "reserved_")
    assert (mb_private_name (mb_private_target "answer"))
    assert (not (mb_private_name "answer"))
    (mb_reset [])
    assert (not (mb_private_name "answer"))
}

pub fn mb_active() -> bool {
    return mb_enabled
}
shadow mb_active {
    (mb_reset [])
    assert (not (mb_active))
    (mb_reset [1])
    assert (mb_active)
    (mb_reset [])
}

pub fn mb_reset(starts: array<int>) -> void {
    set mb_file_starts starts
    set mb_owners []
    set mb_names []
    set mb_targets []
    set mb_definition_owners []
    set mb_source_paths []
    set mb_function_names []
    set mb_function_owners []
    set mb_function_builtins []
    set mb_private_prefix ""
    set mb_enabled (> (array_length starts) 0)
}
shadow mb_reset {
    (mb_reset [1])
    assert (== (array_length mb_file_starts) 1)
    assert (== (array_length mb_names) 0)
    (mb_reset [])
}

pub fn mb_owner(line: int) -> int {
    if (not (mb_active)) { return (- 0 1) }
    let mut owner: int = (- 0 1)
    let mut i: int = 0
    while (< i (array_length mb_file_starts)) {
        if (<= (at mb_file_starts i) line) { set owner i }
        set i (+ i 1)
    }
    return owner
}
shadow mb_owner {
    (mb_reset [1, 8, 8])
    assert (== (mb_owner 0) (- 0 1))
    assert (== (mb_owner 7) 0)
    assert (== (mb_owner 8) 2)
    (mb_reset [])
    assert (== (mb_owner 1) (- 0 1))
}

pub fn mb_add_target(owner: int, name: string, target: string, definition_owner: int) -> void {
    if (not (mb_active)) { return }
    # I install local declarations before imports, so local definitions win.
    let mut i: int = 0
    while (< i (array_length mb_names)) {
        if (and (== (at mb_owners i) owner) (== (at mb_names i) name)) { return }
        set i (+ i 1)
    }
    set mb_owners (array_push mb_owners owner)
    set mb_names (array_push mb_names name)
    set mb_targets (array_push mb_targets target)
    set mb_definition_owners (array_push mb_definition_owners definition_owner)
}
shadow mb_add_target {
    (mb_reset [1, 8])
    (mb_add_target 1 "external" "symbol" 0)
    assert (== (at mb_definition_owners 0) 0)
    (mb_add_target 1 "external" "other" 1)
    assert (== (at mb_definition_owners 0) 0)
    (mb_reset [])
}

pub fn mb_add(owner: int, name: string, target: string) -> void {
    (mb_add_target owner name target owner)
}
shadow mb_add {
    (mb_reset [1])
    (mb_add 0 "answer" "local_answer")
    (mb_add 0 "answer" "imported_answer")
    assert (== (array_length mb_names) 1)
    assert (== (at mb_targets 0) "local_answer")
    (mb_reset [])
}

pub fn mb_lookup(owner: int, name: string) -> string {
    if (not (mb_active)) { return name }
    let mut i: int = 0
    while (< i (array_length mb_names)) {
        if (and (== (at mb_owners i) owner) (== (at mb_names i) name)) {
            return (at mb_targets i)
        }
        set i (+ i 1)
    }
    # I preserve an existing builtin only when no explicit binding selected it.
    # Other missing names cannot acquire an unrelated foreign declaration.
    set i 0
    while (< i (array_length mb_function_names)) {
        if (and (== name (at mb_function_names i)) (!= owner (at mb_function_owners i))) {
            if (at mb_function_builtins i) { return name }
            return (mb_private_target name)
        }
        set i (+ i 1)
    }
    return name
}
shadow mb_lookup {
    (mb_reset [1, 8])
    (mb_add 0 "lib.answer" "first")
    (mb_add 1 "lib.answer" "second")
    assert (== (mb_lookup 0 "lib.answer") "first")
    assert (== (mb_lookup 1 "lib.answer") "second")
    assert (== (mb_lookup 0 "unknown") "unknown")
    (mb_reset [])
    assert (== (mb_lookup 0 "lib.answer") "lib.answer")
}

pub fn mb_resolve(name: string, line: int, locals: array<string>) -> string {
    let mut i: int = 0
    while (< i (array_length locals)) {
        if (== (at locals i) name) { return name }
        set i (+ i 1)
    }
    return (mb_lookup (mb_owner line) name)
}
shadow mb_resolve {
    (mb_reset [1])
    (mb_add 0 "answer" "module_answer")
    assert (== (mb_resolve "answer" 1 []) "module_answer")
    assert (== (mb_resolve "answer" 1 ["answer"]) "answer")
    (mb_reset [])
}

# I retain import provenance separately from the C-linkage spelling.
pub fn mb_target_owner(owner: int, name: string) -> int {
    if (not (mb_active)) { return -1 }
    let mut i: int = 0
    while (< i (array_length mb_names)) {
        if (and (== (at mb_owners i) owner) (== (at mb_names i) name)) {
            return (at mb_definition_owners i)
        }
        set i (+ i 1)
    }
    return owner
}
shadow mb_target_owner {
    (mb_reset [1, 8])
    (mb_add_target 1 "alias" "external" 0)
    assert (== (mb_target_owner 1 "alias") 0)
    assert (== (mb_target_owner 1 "local") 1)
    (mb_reset [])
    assert (== (mb_target_owner 1 "alias") -1)
}

pub fn mb_set_sources(paths: array<string>) -> void {
    set mb_source_paths paths
}
shadow mb_set_sources {
    (mb_set_sources ["one.nano", "two.nano"])
    assert (== (array_length mb_source_paths) 2)
    (mb_reset [])
    assert (== (array_length mb_source_paths) 0)
}

pub fn mb_source(owner: int) -> string {
    if (or (< owner 0) (>= owner (array_length mb_source_paths))) { return "" }
    return (at mb_source_paths owner)
}
shadow mb_source {
    (mb_set_sources ["one.nano"])
    assert (== (mb_source 0) "one.nano")
    assert (== (mb_source 1) "")
    assert (== (mb_source -1) "")
    (mb_reset [])
}
