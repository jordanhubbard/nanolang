    if (!= count function.param_count) { return (sb_fail 1 "I require the helper argument count.") }
    if (and sb_pure (not function.is_pure)) { return (sb_fail 1 "I require a pure helper in a pure function.") }
    let mut i: int = 0
    while (< i count) {
        let parameter: ASTLet = (parser_get_let parser (+ function.param_start i))
        let argument: ASTStmtRef = (parser_get_call_arg parser (+ start i))
        let expected: ServiceBodyValue = (sb_annotation space row.target_owner parameter.var_type)
        let _: ServiceBodyValue = (sb_require (sb_expression parser space argument.node_type argument.node_id) expected)
        set i (+ i 1)
    }
    return (sb_remember kind id (sb_annotation space row.target_owner function.return_type) row.target)
}
