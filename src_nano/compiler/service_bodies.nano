        let mut i: int = 0
        while (< i count) {
            let argument: ASTStmtRef = (parser_get_call_arg parser (+ start i))
            let _: ServiceBodyValue = (sb_require (sb_expression parser space argument.node_type argument.node_id) (at signature.parameters i))
            set i (+ i 1)
        }
        return (sb_remember kind id signature.result 0)
    }
    let found: int = (service_namespace_lookup space sb_owner name)
    if (and (< found 0) (== name "not")) {
        if (!= count 1) { return (sb_fail 1 "I require the operator argument count.") }
        let argument: ASTStmtRef = (parser_get_call_arg parser start)
        let _: ServiceBodyValue = (sb_require (sb_expression parser space argument.node_type argument.node_id) (sb_value 2))
        return (sb_value 2)
    }
    if (< found 0) { return (sb_fail 1 "I require a declared service or helper call.") }
    let row: ServiceName = (at space.names found)
    if (== row.kind 9) {
