        let mut callee: ServiceBodyValue = (sb_value 0)
        if (>= binding 0) { set callee (sb_expression parser space node.function_type node.function) }
        else { set callee (sb_expression parser space node.function_type node.function) }
        if (or (!= callee.type.kind 7) (or (!= callee.borrow_mode 0) (or (< callee.type.ordinal 0) (>= callee.type.ordinal (array_length sb_signatures))))) { return (sb_fail 1 "I require a callable value with a complete signature.") }
        if sb_pure { return (sb_fail 1 "I cannot infer purity from an ordinary callable type.") }
