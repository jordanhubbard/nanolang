        } else {
            let first: ServiceBodyValue = (sb_expression parser space op.left_type op.left)
            if (and (or (== op.op LexerTokenType.TOKEN_EQ) (== op.op LexerTokenType.TOKEN_NE)) (== first.type.kind 2)) { set expected 2 }
            let _: ServiceBodyValue = (sb_require first (sb_value expected))
            let second: ServiceBodyValue = (sb_require (sb_expression parser space op.right_type op.right) (sb_value expected))
            set returned first.returns
            if (not (or (== op.op LexerTokenType.TOKEN_AND) (== op.op LexerTokenType.TOKEN_OR))) { set returned (or returned second.returns) }
        }
        if (or logical compare) { return (sb_returned (sb_value 2) returned) } return (sb_returned (sb_value 1) returned)
    }
    if (== kind ParseNodeType.PNODE_FIELD_ACCESS) {
        let node: ASTFieldAccess = (parser_get_field_access parser id)
        if (== node.object_type ParseNodeType.PNODE_IDENTIFIER) {
            let root: string = (parser_get_identifier parser node.object).name
            if (< (sb_local root) 0) {
                let found: int = (service_namespace_lookup space sb_owner (+ root (+ "." node.field_name)))
                if (>= found 0) { let row: ServiceName = (at space.names found) return (sb_remember kind id (sb_callable parser space row) row.target) }
            }
        }
        let object: ServiceBodyValue = (sb_expression parser space node.object_type node.object)
        if (== object.type.kind 0) { return object }
        let field: ServiceType = (service_member_type space object.type node.field_name)
        if (or (!= object.borrow_mode 0) (or (!= object.type.category 3) (== field.kind 0))) { return (sb_fail 1 "I require a declared catalog record field.") }
        return ServiceBodyValue { type: field, borrow_mode: 0, returns: false }
    }
    if (== kind ParseNodeType.PNODE_LET) {
        let node: ASTLet = (parser_get_let parser id)
        let actual: ServiceBodyValue = (sb_expression parser space node.value_type node.value)
        let declared: ServiceBodyValue = (sb_annotation space sb_owner node.var_type)
        let _: ServiceBodyValue = (sb_require actual declared)
        if (!= actual.borrow_mode 0) { return (sb_fail 1 "I cannot store a call-scoped service borrow.") }
        let _: bool = (sb_bind node.name actual node.is_mut)
        let _: ServiceBodyValue = (sb_remember kind id actual 0) return (sb_value 3)
    }
    if (== kind ParseNodeType.PNODE_SET) {
        let node: ASTSet = (parser_get_set parser id)
        let index: int = (sb_local node.target)
        if (< index 0) { return (sb_fail 1 "I require a mutable assignment target.") }
        if (not (at sb_locals index).mutable) { return (sb_fail 1 "I require a mutable assignment target.") }
        if (!= node.field_name "") { return (sb_fail 2 "I have not checked service field assignment.") }
        let _: ServiceBodyValue = (sb_require (sb_expression parser space node.value_type node.value) (at sb_locals index).value)
        return (sb_value 3)
    }
    if (== kind ParseNodeType.PNODE_RETURN) {
        let node: ASTReturn = (parser_get_return parser id)
        let mut actual: ServiceBodyValue = (sb_expression parser space node.value_type node.value)
        let _: ServiceBodyValue = (sb_require actual sb_expected)
        return (sb_returned actual true)
    }
    if (== kind ParseNodeType.PNODE_ASSERT) {
        let node: ASTAssert = (parser_get_assert parser id)
        let _: ServiceBodyValue = (sb_require (sb_expression parser space node.condition_type node.condition) (sb_value 2)) return (sb_value 3)
    }
    if (== kind ParseNodeType.PNODE_BLOCK) {
        let node: ASTBlock = (parser_get_block parser id)
        let saved: int = sb_count let mut last: ServiceBodyValue = (sb_value 3)
        let mut returned: bool = false let mut i: int = 0
        while (< i (list_ASTStmtRef_length node.statements)) {
            let item: ASTStmtRef = (list_ASTStmtRef_get node.statements i)
            set last (sb_expression parser space item.node_type item.node_id)
            set returned (or returned last.returns) set i (+ i 1)
        }
        set sb_count saved return (sb_returned last returned)
    }
    if (== kind ParseNodeType.PNODE_IF) {
        let node: ASTIf = (parser_get_if parser id)
        let _: ServiceBodyValue = (sb_require (sb_expression parser space node.condition_type node.condition) (sb_value 2))
        let yes: ServiceBodyValue = (sb_expression parser space ParseNodeType.PNODE_BLOCK node.then_body)
        let no: ServiceBodyValue = (sb_expression parser space ParseNodeType.PNODE_BLOCK node.else_body)
        return (sb_returned (sb_value 3) (and yes.returns no.returns))
    }
    if (== kind ParseNodeType.PNODE_WHILE) {
        let node: ASTWhile = (parser_get_while parser id)
        let _: ServiceBodyValue = (sb_require (sb_expression parser space node.condition_type node.condition) (sb_value 2))
        let _: ServiceBodyValue = (sb_expression parser space ParseNodeType.PNODE_BLOCK node.body) return (sb_value 3)
    }
    if (== kind ParseNodeType.PNODE_MATCH) { return (sb_match parser space id) }
    if (or (== kind ParseNodeType.PNODE_STRUCT_LITERAL) (== kind ParseNodeType.PNODE_UNION_CONSTRUCT)) {
        let mut name: string = ""
        if (== kind ParseNodeType.PNODE_STRUCT_LITERAL) { set name (parser_get_struct_literal parser id).struct_name }
        else { set name (parser_get_union_construct parser id).union_name }
        let typ: ServiceType = (service_named_type space sb_owner name)
        if (or (== typ.category 1) (== typ.category 2)) { return (sb_fail 1 "I cannot fabricate an owned catalog value.") }
        if (and (== kind ParseNodeType.PNODE_STRUCT_LITERAL) (and (== typ.ordinal 8) (== (service_namespace_catalog space typ.owner) 2))) {
            let node: ASTStructLiteral = (parser_get_struct_literal parser id)
            if (or (!= node.field_count 7) (or (!= (array_length node.field_names) 7) (or (!= (array_length node.field_value_ids) 7) (!= (array_length node.field_value_types) 7)))) {
                return (sb_fail 1 "I require all seven Endpoint fields exactly once.")
            }
            let mut returned: bool = false
            let mut i: int = 0
            while (< i node.field_count) {
                let field: string = (at node.field_names i)
                let expected: ServiceType = (service_member_type space typ field)
                if (== expected.kind 0) { return (sb_fail 1 "I require a declared Endpoint field.") }
                let mut j: int = 0
                while (< j i) {
                    if (== field (at node.field_names j)) { return (sb_fail 1 "I require distinct Endpoint fields.") }
                    set j (+ j 1)
                }
                let actual: ServiceBodyValue = (sb_require (sb_expression parser space (at node.field_value_types i) (at node.field_value_ids i)) ServiceBodyValue { type: expected, borrow_mode: 0, returns: false })
                set returned (or returned actual.returns)
                set i (+ i 1)
            }
            return ServiceBodyValue { type: typ, borrow_mode: 0, returns: returned }
        }
        return (sb_fail 2 "I have not checked this ordinary constructor in my service body path.")
    }
    return (sb_fail 2 "I have not checked this source form in my service body path.")
}
shadow sb_expression_impl {
    let tokens: List<LexerToken> = (tokenize_string "" "test" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program tokens (list_LexerToken_length tokens) "test")
    assert (== (sb_expression_impl p (sb_empty) ParseNodeType.PNODE_NUMBER 0).type.kind 1)
    set sb_status 0 let _: ServiceBodyValue = (sb_expression_impl p (sb_empty) -100 0) assert (== sb_status 2)
    set sb_status 0 set sb_diagnostic ""
}
fn sb_expression(parser: Parser, space: ServiceNamespace, kind: int, id: int) -> ServiceBodyValue {
    if (< id 0) { return (sb_value 3) }
    if (== sb_depth 128) { return (sb_fail 3 "I exceeded my service body nesting bound.") }
    set sb_depth (+ sb_depth 1)
    let result: ServiceBodyValue = (sb_expression_impl parser space kind id)
    set sb_depth (- sb_depth 1)
    if (> (array_length sb_facts) 0) {
        let last: ServiceBodyFact = (at sb_facts (- (array_length sb_facts) 1))
        if (and (== last.node_kind kind) (== last.node_id id)) { return result }
    }
    return (sb_remember kind id result 0)
}
shadow sb_expression {
    let tokens: List<LexerToken> = (tokenize_string "" "test" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program tokens (list_LexerToken_length tokens) "test")
    assert (== (sb_expression p (sb_empty) 17 -1).type.kind 3)
}

pub fn check_service_bodies(parser: Parser, files: array<string>, sources: array<string>, space: ServiceNamespace) -> ServiceBodyCheck {
    set sb_status 0 set sb_diagnostic "" set sb_count 0 set sb_locals [] set sb_facts [] set sb_depth 0 set sb_signatures [] set sb_type_depth 0
    let mut functions: int = 0 let mut shadows: int = 0
    if (> parser.services_count 0) {
        if (!= space.status 0) { let _: ServiceBodyValue = (sb_fail 1 "I require a complete service namespace.") }
        if (or (> parser.structs_count 0) (or (> parser.unions_count 0) (or (> parser.enums_count 0) (> parser.opaque_types_count 0)))) {
            let _: ServiceBodyValue = (sb_fail 2 "I have not checked this declaration beside service bodies.")
        }
        let mut declaration: int = 0
        while (< declaration (array_length space.names)) {
            if (== (at space.names declaration).kind 6) { let _: ServiceBodyValue = (sb_fail 2 "I have not checked this declaration beside service bodies.") }
            set declaration (+ declaration 1)
        }
        let mut group: int = 0
        while (< group 2) {
            let mut count: int = parser.functions_count if (== group 1) { set count parser.shadows_count }
            let mut i: int = 0
            while (< i count) {
                set sb_count 0 set sb_depth 0 set sb_pure false set sb_expected (sb_value 3)
                let mut body: int = -1 let mut line: int = 0
                if (== group 0) {
                    let function: ASTFunction = (parser_get_function parser i)
                    set line function.line set body function.body set sb_pure function.is_pure set functions (+ functions 1)
                    if (== function.node_type ParseNodeType.PNODE_LAMBDA) { set body -1 }
                    set sb_owner (sn_owner files sources line)
                    set sb_expected (sb_annotation space sb_owner function.return_type)
                    let mut j: int = 0
                    while (< j function.param_count) {
                        let parameter: ASTLet = (parser_get_let parser (+ function.param_start j))
                        if (>= (sb_local parameter.name) 0) { let _: ServiceBodyValue = (sb_fail 1 "I require distinct parameter names.") }
                        let _: bool = (sb_bind parameter.name (sb_annotation space sb_owner parameter.var_type) false)
                        set j (+ j 1)
                    }
                } else {
                    let item: ASTShadow = (list_ASTShadow_get parser.shadows i)
                    set line item.line set body item.body set shadows (+ shadows 1)
                    set sb_owner (sn_owner files sources line)
                }
                if (< sb_owner 0) { let _: ServiceBodyValue = (sb_fail 1 "I require the original service body source.") }
                if (< body 0) { let _: ServiceBodyValue = (sb_fail 2 "I have not checked this callable in my service body path.") }
                else {
                    let result: ServiceBodyValue = (sb_expression parser space ParseNodeType.PNODE_BLOCK body)
                    if (and (== group 0) (and (!= sb_expected.type.kind 0) (and (!= sb_expected.type.kind 3) (not result.returns)))) {
                        let _: ServiceBodyValue = (sb_fail 1 "I require a return on every service helper path.")
                    }
                }
                set i (+ i 1)
            }
            set group (+ group 1)
        }
    }
    return ServiceBodyCheck { status: sb_status, diagnostic: sb_diagnostic, facts: sb_facts, functions: functions, shadows: shadows }
}
shadow check_service_bodies {
    let tokens: List<LexerToken> = (tokenize_string "fn main()->int { return 0 }" "test" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program tokens (list_LexerToken_length tokens) "test")
    assert (== (check_service_bodies p [] [] (sb_empty)).status 0)
}
