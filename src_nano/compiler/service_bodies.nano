# I check nominal service bodies independently of the C checker.
# Status zero describes types only; it grants neither ownership nor execution.
import "src_nano/compiler/service_types.nano"
import "src_nano/compiler/service_namespace.nano"
import "src_nano/parser.nano"
from "src_nano/compiler/lexer.nano" import tokenize_string

struct ServiceBodyValue { type: ServiceType, borrow_mode: int, returns: bool }
struct ServiceBodyLocal { name: string, value: ServiceBodyValue, mutable: bool }
struct ServiceBodyFact { node_kind: int, node_id: int, type: ServiceType, borrow_mode: int, declaration: int }
struct ServiceBodyCheck { status: int, diagnostic: string, facts: array<ServiceBodyFact>, functions: int, shadows: int }
struct ServiceBodySignature { parameters: array<ServiceBodyValue>, result: ServiceBodyValue }
let mut sb_signatures: array<ServiceBodySignature> = []
let mut sb_type_depth: int = 0
let mut sb_status: int = 0
let mut sb_diagnostic: string = ""
let mut sb_locals: array<ServiceBodyLocal> = []
let mut sb_count: int = 0
let mut sb_facts: array<ServiceBodyFact> = []
let mut sb_owner: int = -1
let mut sb_depth: int = 0
let mut sb_pure: bool = false
let mut sb_expected: ServiceBodyValue = ServiceBodyValue { type: ServiceType { kind: 3, declaration: 0, owner: -1, ordinal: -1, category: 0 }, borrow_mode: 0, returns: false }

fn sb_empty() -> ServiceNamespace {
    return ServiceNamespace { status: 0, names: [], plan: FileSourcePlan { status: 0, rows: [], logical_bytes: 0 }, text_bytes: 0, ordinary_count: 0, alias_count: 0 }
}
shadow sb_empty { assert (== (array_length (sb_empty).names) 0) }
fn sb_value(kind: int) -> ServiceBodyValue {
    return ServiceBodyValue { type: ServiceType { kind: kind, declaration: 0, owner: -1, ordinal: -1, category: 0 }, borrow_mode: 0, returns: false }
}
shadow sb_value { assert (== (sb_value 1).type.kind 1) assert (== (sb_value 2).borrow_mode 0) }
fn sb_returned(value: ServiceBodyValue, returns: bool) -> ServiceBodyValue {
    return ServiceBodyValue { type: value.type, borrow_mode: value.borrow_mode, returns: returns }
}
shadow sb_returned { assert (sb_returned (sb_value 1) true).returns assert (== (sb_returned (sb_value 1) true).type.kind 1) }
fn sb_mode(value: ServiceBodyValue, mode: int) -> ServiceBodyValue {
    return ServiceBodyValue { type: value.type, borrow_mode: mode, returns: value.returns }
}
shadow sb_mode { assert (== (sb_mode (sb_value 1) 2).borrow_mode 2) }
fn sb_fail(status: int, why: string) -> ServiceBodyValue {
    if (or (== sb_status 0) (and (== sb_status 2) (!= status 2))) { set sb_status status set sb_diagnostic why }
    return (sb_value 0)
}
shadow sb_fail {
    set sb_status 0 let _: ServiceBodyValue = (sb_fail 2 "unsupported")
    let _: ServiceBodyValue = (sb_fail 1 "invalid") assert (== sb_diagnostic "invalid")
    set sb_status 0 set sb_diagnostic ""
}
fn sb_equal(a: ServiceBodyValue, b: ServiceBodyValue) -> bool {
    return (and (== a.borrow_mode b.borrow_mode) (service_types_equal a.type b.type))
}
shadow sb_equal { assert (sb_equal (sb_value 1) (sb_value 1)) assert (not (sb_equal (sb_value 0) (sb_value 0))) }
fn sb_require(actual: ServiceBodyValue, expected: ServiceBodyValue) -> ServiceBodyValue {
    if actual.returns { return actual }
    if (and (!= actual.type.kind 0) (and (!= expected.type.kind 0) (not (sb_equal actual expected)))) {
        return (sb_fail 1 "I require the exact nominal type and borrow mode.")
    }
    return actual
}
shadow sb_require {
    set sb_status 0 let _: ServiceBodyValue = (sb_require (sb_value 1) (sb_value 2)) assert (== sb_status 1)
    set sb_status 0 set sb_diagnostic ""
    let terminal: ServiceBodyValue = (sb_require (sb_returned (sb_value 3) true) (sb_value 1))
    assert terminal.returns assert (== sb_status 0)
}
fn sb_signature(parameters: array<ServiceBodyValue>, result: ServiceBodyValue) -> ServiceBodyValue {
    let mut i: int = 0
    while (< i (array_length sb_signatures)) {
        let prior: ServiceBodySignature = (at sb_signatures i)
        let mut same: bool = (and (== (array_length prior.parameters) (array_length parameters)) (sb_equal prior.result result))
        let mut j: int = 0
        while (and same (< j (array_length parameters))) { set same (sb_equal (at prior.parameters j) (at parameters j)) set j (+ j 1) }
        if same { return ServiceBodyValue { type: ServiceType { kind: 7, declaration: 0, owner: -1, ordinal: i, category: 0 }, borrow_mode: 0, returns: false } }
        set i (+ i 1)
    }
    if (== i 1024) { return (sb_fail 3 "I exceeded my callable signature bound.") }
    set sb_signatures (array_push sb_signatures ServiceBodySignature { parameters: parameters, result: result })
    return ServiceBodyValue { type: ServiceType { kind: 7, declaration: 0, owner: -1, ordinal: i, category: 0 }, borrow_mode: 0, returns: false }
}
shadow sb_signature {
    set sb_signatures []
    let first: ServiceBodyValue = (sb_signature [(sb_value 1)] (sb_value 2))
    assert (sb_equal first (sb_signature [(sb_value 1)] (sb_value 2)))
    assert (not (sb_equal first (sb_signature [(sb_value 2)] (sb_value 2))))
    set sb_signatures []
}
fn sb_annotation(space: ServiceNamespace, owner: int, spelling: string) -> ServiceBodyValue {
    set sb_type_depth (+ sb_type_depth 1)
    if (> sb_type_depth 128) { set sb_type_depth (- sb_type_depth 1) return (sb_fail 3 "I exceeded my callable type nesting bound.") }
    let result: ServiceBodyValue = (sb_annotation_impl space owner spelling)
    set sb_type_depth (- sb_type_depth 1) return result
}
shadow sb_annotation {
    set sb_signatures [] set sb_status 0
    let a: ServiceBodyValue = (sb_annotation (sb_empty) 0 "fn(int)->bool")
    assert (== a.type.kind 7) assert (== (array_length (at sb_signatures a.type.ordinal).parameters) 1)
    assert (not (sb_equal a (sb_annotation (sb_empty) 0 "fn(bool)->bool")))
    let nested: ServiceBodyValue = (sb_annotation (sb_empty) 0 "fn(fn(int)->bool)->fn()->int")
    assert (== nested.type.kind 7)
    set sb_signatures [] set sb_status 0 set sb_diagnostic ""
}
fn sb_type_token(token: LexerToken) -> string {
    if (== token.token_type LexerTokenType.TOKEN_LPAREN) { return "(" }
    if (== token.token_type LexerTokenType.TOKEN_RPAREN) { return ")" }
    if (== token.token_type LexerTokenType.TOKEN_COMMA) { return "," }
    if (== token.token_type LexerTokenType.TOKEN_ARROW) { return "->" }
    if (== token.token_type LexerTokenType.TOKEN_AMPERSAND) { return "&" }
    if (== token.token_type LexerTokenType.TOKEN_DOT) { return "." }
    if (!= token.value "") { return token.value }
    return "?"
}
shadow sb_type_token {
    let tokens: List<LexerToken> = (tokenize_string "( )->&" "test" (list_CompilerDiagnostic_new))
    assert (== (sb_type_token (list_LexerToken_get tokens 0)) "(")
    assert (== (sb_type_token (list_LexerToken_get tokens 2)) "->")
    assert (== (sb_type_token (list_LexerToken_get tokens 3)) "&")
}
fn sb_annotation_impl(space: ServiceNamespace, owner: int, spelling: string) -> ServiceBodyValue {
    if (or (== spelling "") (== spelling "unknown")) { return (sb_value 0) }
    let tokens: List<LexerToken> = (tokenize_string spelling "<service-type>" (list_CompilerDiagnostic_new))
    let count: int = (list_LexerToken_length tokens)
    if (== (list_LexerToken_get tokens 0).token_type LexerTokenType.TOKEN_FN) {
        if (or (< count 5) (!= (list_LexerToken_get tokens 1).token_type LexerTokenType.TOKEN_LPAREN)) { return (sb_fail 1 "I require a complete callable signature.") }
        let mut parameters: array<ServiceBodyValue> = [] let mut part: string = "" let mut nesting: int = 0 let mut at_token: int = 2
        while (< at_token count) {
            let token: LexerToken = (list_LexerToken_get tokens at_token)
            if (and (== nesting 0) (or (== token.token_type LexerTokenType.TOKEN_COMMA) (== token.token_type LexerTokenType.TOKEN_RPAREN))) {
                if (!= part "") { set parameters (array_push parameters (sb_annotation space owner part)) set part "" }
                else if (or (== token.token_type LexerTokenType.TOKEN_COMMA) (> (array_length parameters) 0)) { return (sb_fail 1 "I require each callable parameter type.") }
                if (> (array_length parameters) 256) { return (sb_fail 3 "I exceeded my callable parameter bound.") }
                if (== token.token_type LexerTokenType.TOKEN_RPAREN) { break }
            } else {
                if (== token.token_type LexerTokenType.TOKEN_LPAREN) { set nesting (+ nesting 1) }
                if (== token.token_type LexerTokenType.TOKEN_RPAREN) { set nesting (- nesting 1) }
                set part (+ part (+ " " (sb_type_token token)))
            }
            set at_token (+ at_token 1)
        }
        if (or (>= (+ at_token 2) count) (!= (list_LexerToken_get tokens (+ at_token 1)).token_type LexerTokenType.TOKEN_ARROW)) { return (sb_fail 1 "I require the callable return type.") }
        set part "" set at_token (+ at_token 2)
        while (< at_token (- count 1)) { set part (+ part (+ " " (sb_type_token (list_LexerToken_get tokens at_token)))) set at_token (+ at_token 1) }
        let result: ServiceBodyValue = (sb_annotation space owner part)
        if (or (== result.type.kind 0) (!= result.borrow_mode 0)) { return (sb_fail 1 "I require a complete nonborrowed callable result.") }
        return (sb_signature parameters result)
    }
    let mut i: int = 0
    let mut mode: int = 0
    if (== (list_LexerToken_get tokens 0).token_type LexerTokenType.TOKEN_AMPERSAND) {
        set mode 1 set i 1
        if (== (list_LexerToken_get tokens i).token_type LexerTokenType.TOKEN_MUT) { set mode 2 set i (+ i 1) }
    }
    let mut name: string = (list_LexerToken_get tokens i).value
    set i (+ i 1)
    while (and (< (+ i 1) count) (== (list_LexerToken_get tokens i).token_type LexerTokenType.TOKEN_DOT)) {
        set name (+ name (+ "." (list_LexerToken_get tokens (+ i 1)).value)) set i (+ i 2)
    }
    if (and (< i count) (!= (list_LexerToken_get tokens i).token_type LexerTokenType.TOKEN_EOF)) {
        return (sb_fail 2 "I have not checked this ordinary type in my service body path.")
    }
    let mut result: ServiceBodyValue = ServiceBodyValue { type: (service_named_type space owner name), borrow_mode: mode, returns: false }
    if (== name "int") { set result (sb_mode (sb_value 1) mode) }
    if (== name "bool") { set result (sb_mode (sb_value 2) mode) }
    if (== name "void") { set result (sb_mode (sb_value 3) mode) }
    if (== result.type.kind 0) { return (sb_fail 2 "I have not checked this ordinary type in my service body path.") }
    return result
}
shadow sb_annotation_impl {
    let space: ServiceNamespace = (sb_empty)
    assert (== (sb_annotation space 0 "int").type.kind 1)
    assert (== (sb_annotation space 0 "bool").type.kind 2)
    set sb_status 0 let _: ServiceBodyValue = (sb_annotation space 0 "array<int>") assert (== sb_status 2)
    set sb_status 0 set sb_diagnostic ""
}
fn sb_local(name: string) -> int {
    let mut i: int = sb_count
    while (> i 0) { set i (- i 1) if (== (at sb_locals i).name name) { return i } }
    return -1
}
shadow sb_local { set sb_count 0 assert (== (sb_local "missing") -1) }
fn sb_bind(name: string, value: ServiceBodyValue, mutable: bool) -> bool {
    if (== sb_count 1024) { let _: ServiceBodyValue = (sb_fail 3 "I exceeded my checked service local bound.") return false }
    let item: ServiceBodyLocal = ServiceBodyLocal { name: name, value: value, mutable: mutable }
    if (< sb_count (array_length sb_locals)) { (array_set sb_locals sb_count item) }
    else { set sb_locals (array_push sb_locals item) }
    set sb_count (+ sb_count 1) return true
}
shadow sb_bind {
    set sb_count 0 assert (sb_bind "x" (sb_value 1) false) assert (== (sb_local "x") 0)
    assert (sb_bind "x" (sb_value 2) true) assert (== (sb_local "x") 1)
    set sb_count 0 set sb_locals []
}
fn sb_remember(kind: int, id: int, value: ServiceBodyValue, declaration: int) -> ServiceBodyValue {
    if (== value.type.kind 0) { return value }
    if (== (array_length sb_facts) 16384) { return (sb_fail 3 "I exceeded my checked service fact bound.") }
    set sb_facts (array_push sb_facts ServiceBodyFact { node_kind: kind, node_id: id,
        type: value.type, borrow_mode: value.borrow_mode, declaration: declaration })
    return value
}
shadow sb_remember {
    set sb_facts [] let _: ServiceBodyValue = (sb_remember 0 7 (sb_value 1) 0)
    assert (== (at sb_facts 0).node_id 7) set sb_facts []
}
fn sb_callable(parser: Parser, space: ServiceNamespace, row: ServiceName) -> ServiceBodyValue {
    if (!= row.kind 1) { return (sb_fail 2 "I require a noncapturing helper value.") }
    let function: ASTFunction = (parser_get_function parser row.node_id)
    if (< function.body 0) { return (sb_fail 2 "I require a noncapturing helper value.") }
    let mut parameters: array<ServiceBodyValue> = [] let mut i: int = 0
    while (< i function.param_count) {
        let parameter: ASTLet = (parser_get_let parser (+ function.param_start i))
        set parameters (array_push parameters (sb_annotation space row.target_owner parameter.var_type)) set i (+ i 1)
    }
    return (sb_signature parameters (sb_annotation space row.target_owner function.return_type))
}
shadow sb_callable {
    let tokens: List<LexerToken> = (tokenize_string "fn f(x:int)->int{return x}" "test" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program tokens (list_LexerToken_length tokens) "test")
    set sb_signatures []
    let row: ServiceName = ServiceName { name: "f", id: 1, target: 1, owner: 0, target_owner: 0, kind: 1, ordinal: -1, request: -1, exported: true, immutable: true, node_id: 0 }
    let result: ServiceBodyValue = (sb_callable p (sb_empty) row)
    assert (== result.type.kind 7)
    assert (== (array_length (at sb_signatures result.type.ordinal).parameters) 1)
    assert (== (at sb_signatures result.type.ordinal).result.type.kind 1)
    set sb_signatures []
}
fn sb_call(parser: Parser, space: ServiceNamespace, kind: int, id: int, name: string, start: int, count: int) -> ServiceBodyValue {
