        let arithmetic: bool = (or (== op.op LexerTokenType.TOKEN_PLUS) (or (== op.op LexerTokenType.TOKEN_MINUS) (or (== op.op LexerTokenType.TOKEN_STAR) (or (== op.op LexerTokenType.TOKEN_SLASH) (== op.op LexerTokenType.TOKEN_PERCENT)))))
