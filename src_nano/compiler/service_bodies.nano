            let mut mode: int = 0
            if (and (== i 0) (== signature.input_mode 1)) { set mode 2 }
            let expected: ServiceBodyValue = ServiceBodyValue { type: (at signature.parameters i), borrow_mode: mode, returns: false }
            let _: ServiceBodyValue = (sb_require (sb_expression parser space argument.node_type argument.node_id) expected)
            set i (+ i 1)
        }
        return (sb_remember kind id ServiceBodyValue { type: signature.result, borrow_mode: 0, returns: false } row.target)
    }
