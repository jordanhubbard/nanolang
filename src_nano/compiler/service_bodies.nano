    if (== input.type.kind 0) { return input }
    if (or (!= input.borrow_mode 0) (!= input.type.kind 6)) { return (sb_fail 2 "I have not checked this non-catalog match in my service body path.") }
    let mut seen_ok: bool = false let mut seen_error: bool = false
    let mut result: ServiceBodyValue = (sb_value 0) let mut all_return: bool = true
    let mut i: int = 0
    while (< i node.arm_count) {
        let arm: string = (at node.arm_variants i)
        if (or (and (!= arm "Ok") (!= arm "Error")) (or (and (== arm "Ok") seen_ok) (and (== arm "Error") seen_error))) {
            return (sb_fail 1 "I require distinct catalog Result arms.")
        }
        if (== arm "Ok") { set seen_ok true } else { set seen_error true }
        if (and (< i (array_length node.arm_guard_ids)) (>= (at node.arm_guard_ids i) 0)) {
            return (sb_fail 2 "I have not checked guarded catalog Result exhaustiveness.")
        }
        let payload: ServiceType = (service_member_type space input.type arm)
