# I substitute complete type-name tokens and preserve nested spelling.
# Checking and native emission use the same concrete generic field annotation.
fn type_parameter_word_char(value: int) -> bool {
    return (or (or (and (>= value 65) (<= value 90)) (and (>= value 97) (<= value 122))) (or (and (>= value 48) (<= value 57)) (or (== value 95) (== value 46))))
}
shadow type_parameter_word_char {
    assert (type_parameter_word_char 84)
    assert (not (type_parameter_word_char 60))
}

pub fn substitute_type_parameters(spelling: string, params: array<string>, args: array<string>) -> string {
    let mut result: string = ""
    let mut i: int = 0
    while (< i (str_length spelling)) {
        if (type_parameter_word_char (char_at spelling i)) {
            let start: int = i
            while (and (< i (str_length spelling)) (type_parameter_word_char (char_at spelling i))) { set i (+ i 1) }
            let mut word: string = (str_substring spelling start (- i start))
            let mut j: int = 0
            while (and (< j (array_length params)) (< j (array_length args))) {
                if (== word (at params j)) { set word (at args j) break }
                set j (+ j 1)
            }
            set result (+ result word)
        } else {
            set result (+ result (str_substring spelling i 1))
            set i (+ i 1)
        }
    }
    return result
}
shadow substitute_type_parameters {
    assert (== (substitute_type_parameters "Pair<T,array<E>>" ["T", "E"] ["int", "Handle"]) "Pair<int,array<Handle>>")
    assert (== (substitute_type_parameters "Tree" ["T"] ["int"]) "Tree")
    assert (== (substitute_type_parameters "module.T" ["T"] ["int"]) "module.T")
    assert (== (substitute_type_parameters "array<T>" ["T"] ["array<Plain>"]) "array<array<Plain>>")
}

# I split a selected payload only outside complete nested type arguments.
pub fn selected_payload_dot(spelling: string) -> int {
    if (not (str_contains spelling ".")) { return -1 }
    let mut stack: array<int> = []
    let mut depth: int = 0
    let mut dot: int = -1
    let mut i: int = 0
    while (< i (str_length spelling)) {
        let ch: int = (char_at spelling i)
        if (or (== ch 60) (== ch 40)) {
            if (and (== ch 40) (== depth 0)) { return -1 }
            if (== depth (array_length stack)) { set stack (array_push stack ch) }
            else { (array_set stack depth ch) }
            set depth (+ depth 1)
        }
        if (or (== ch 62) (== ch 41)) {
            let mut arrow: bool = false
            if (and (== ch 62) (> i 0)) { set arrow (== (char_at spelling (- i 1)) 45) }
            if arrow { if (== depth 0) { return -1 } }
            else {
                if (== depth 0) { return -1 }
                let opening: int = (at stack (- depth 1))
                if (or (and (== ch 62) (!= opening 60)) (and (== ch 41) (!= opening 40))) { return -1 }
                set depth (- depth 1)
            }
        }
        if (and (== ch 46) (== depth 0)) { set dot i }
        set i (+ i 1)
    }
    if (!= depth 0) { return -1 }
    if (or (<= dot 0) (>= dot (- (str_length spelling) 1))) { return -1 }
    set i (+ dot 1)
    while (< i (str_length spelling)) {
        let ch: int = (char_at spelling i)
        if (not (or (or (and (>= ch 65) (<= ch 90)) (and (>= ch 97) (<= ch 122))) (or (== ch 95) (and (> i (+ dot 1)) (and (>= ch 48) (<= ch 57)))))) { return -1 }
        set i (+ i 1)
    }
    return dot
}
shadow selected_payload_dot {
    assert (== (selected_payload_dot "Box<int>.Some") 8)
    assert (== (selected_payload_dot "Box<fn(A.Item)->B.Item>.Some") 23)
    assert (== (selected_payload_dot "Box<(A.Item,int)>.Some") 17)
    assert (== (selected_payload_dot "Box<int.Some") -1)
    assert (== (selected_payload_dot "Box<int>>.Some") -1)
    assert (== (selected_payload_dot "Box<int>.9bad") -1)
    assert (== (selected_payload_dot "Box<(int>)>.Some") -1)
    assert (== (selected_payload_dot "fn(int)->Box<int>.Some") -1)
    assert (== (selected_payload_dot "(Box<int>.Some,int)") -1)
    assert (== (selected_payload_dot "Box<int>.") -1)
}
