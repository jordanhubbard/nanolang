# I retain physical service origins before module aliases change visible names.
import "src_nano/parser.nano"
from "src_nano/compiler/lexer.nano" import tokenize_string

struct ServiceOrigin {
    file_index: int,
    line: int,
    column: int
}

struct ServiceOrigins {
    ok: bool,
    locations: array<ServiceOrigin>
}

fn service_origin_file(files: array<string>, path: string) -> int {
    if (== path "") { return -1 }
    if (> (str_length path) 4096) { return -1 }
    if (!= (str_substring path 0 1) "/") { return -1 }
    if (not (parser_service_utf8 path)) { return -1 }
    let mut result: int = -1
    let mut i: int = 0
    while (< i (array_length files)) {
        if (== (at files i) path) {
            if (>= result 0) { return -1 }
            set result i
        }
        set i (+ i 1)
    }
    return result
}

shadow service_origin_file {
    assert (== (service_origin_file ["/one/binding.nano", "/two/binding.nano"] "/two/binding.nano") 1)
    assert (== (service_origin_file ["/same", "/same"] "/same") -1)
    assert (== (service_origin_file ["relative"] "relative") -1)
    assert (== (service_origin_file ["/one"] "/missing") -1)
}

pub fn bind_service_origins(parser: Parser, files: array<string>, source_files: array<string>, source_lines: array<int>) -> ServiceOrigins {
    let failure: ServiceOrigins = ServiceOrigins { ok: false, locations: [] }
    if (== parser.services_count 0) { return ServiceOrigins { ok: true, locations: [] } }
    if (> parser.services_count 16) { return failure }
    if (!= (array_length source_files) (array_length source_lines)) { return failure }
    let mut locations: array<ServiceOrigin> = []
    let mut i: int = 0
    while (< i parser.services_count) {
        let node: ASTServiceDecl = (list_ASTServiceDecl_get parser.services i)
        let position: int = (- node.line 1)
        if (or (< position 0) (>= position (array_length source_files))) { return failure }
        let owner: int = (service_origin_file files (at source_files position))
        let line: int = (at source_lines position)
        if (or (< owner 0) (or (< line 1) (< node.column 1))) { return failure }
        if (and (!= node.origin_index -1) (!= node.origin_index owner)) { return failure }
        let mut j: int = 0
        while (< j (array_length locations)) {
            let previous: ServiceOrigin = (at locations j)
            if (== previous.file_index owner) { return failure }
            set j (+ j 1)
        }
        set locations (array_push locations ServiceOrigin { file_index: owner, line: line, column: node.column })
        set i (+ i 1)
    }
    # I change the retained nodes only after validating every mapping.
    set i 0
    while (< i parser.services_count) {
        let node: ASTServiceDecl = (list_ASTServiceDecl_get parser.services i)
        let origin: ServiceOrigin = (at locations i)
        let bound: ASTServiceDecl = ASTServiceDecl {
            node_type: node.node_type, line: node.line, column: node.column,
            interface_id: node.interface_id, interface_bytes: node.interface_bytes,
            document_path: node.document_path, path_bytes: node.path_bytes,
            catalog_version: node.catalog_version, origin_index: origin.file_index
        }
        (list_ASTServiceDecl_set parser.services i bound)
        set i (+ i 1)
    }
    return ServiceOrigins { ok: true, locations: locations }
}

shadow bind_service_origins {
    let text: string = "# retained source\nservice \"nsi:nanolang/filesystem\" catalog 1 from \"interface.nsi.json\"\n"
    let tokens: List<LexerToken> = (tokenize_string text "merged.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "merged.nano")
    assert (not parser.has_error)
    let failed: ServiceOrigins = (bind_service_origins parser ["/one/binding.nano"] ["/one/binding.nano"] [1])
    assert (not failed.ok)
    let unbound: ASTServiceDecl = (list_ASTServiceDecl_get parser.services 0)
    assert (== unbound.origin_index -1)
    let bound: ServiceOrigins = (bind_service_origins parser ["/root.nano", "/one/binding.nano"] ["/one/binding.nano", "/one/binding.nano"] [8, 9])
    assert bound.ok
    let origin: ServiceOrigin = (at bound.locations 0)
    assert (== origin.file_index 1)
    assert (== origin.line 9)
    assert (== origin.column 1)
    let node: ASTServiceDecl = (list_ASTServiceDecl_get parser.services 0)
    assert (== node.origin_index 1)
    assert (== node.line 2)
}
