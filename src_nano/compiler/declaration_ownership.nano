# I classify parsed declaration IDs once; true means a lexical local or parameter.
import "src_nano/parser.nano"
from "src_nano/compiler/lexer.nano" import tokenize_string

pub fn declaration_local_lets(parser: Parser) -> array<bool> {
    let mut flags: array<bool> = []
    let mut i: int = 0
    while (< i (parser_get_let_count parser)) { set flags (array_push flags false) set i (+ i 1) }
    set i 0
    while (< i (parser_get_function_count parser)) {
        let f: ASTFunction = (parser_get_function parser i)
        let mut j: int = 0
        while (< j f.param_count) { (array_set flags (+ f.param_start j) true) set j (+ j 1) }
        set i (+ i 1)
    }
    set i 0
    while (< i (list_ASTBlock_length parser.blocks)) {
        let block: ASTBlock = (list_ASTBlock_get parser.blocks i)
        let mut j: int = 0
        while (< j (list_ASTStmtRef_length block.statements)) {
            let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements j)
            if (== stmt.node_type ParseNodeType.PNODE_LET) { (array_set flags stmt.node_id true) }
            set j (+ j 1)
        }
        set i (+ i 1)
    }
    set i 0
    while (< i (list_ASTUnsafeBlock_length parser.unsafe_blocks)) {
        let block: ASTUnsafeBlock = (list_ASTUnsafeBlock_get parser.unsafe_blocks i)
        let mut j: int = 0
        while (< j (list_ASTStmtRef_length block.statements)) {
            let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements j)
            if (== stmt.node_type ParseNodeType.PNODE_LET) { (array_set flags stmt.node_id true) }
            set j (+ j 1)
        }
        set i (+ i 1)
    }
    return flags
}

shadow declaration_local_lets {
    let source: string = (+ "let first: int = 1 f" "n f(arg: int) -> int { let local: int = 2 if true { let nested: int = 3 } unsafe { let inner: int = 4 } return local } shadow f { let test: int = 5 } let last: int = 6")
    let tokens: List<LexerToken> = (tokenize_string source "ownership.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "ownership.nano")
    let flags: array<bool> = (declaration_local_lets parser)
    assert (== (array_length flags) 7)
    assert (not (at flags 0))
    assert (not (at flags 6))
    let mut i: int = 1
    while (< i 6) { assert (at flags i) set i (+ i 1) }
    let empty_tokens: List<LexerToken> = (tokenize_string "" "empty.nano" (list_CompilerDiagnostic_new))
    let empty: Parser = (parse_program empty_tokens (list_LexerToken_length empty_tokens) "empty.nano")
    assert (== (array_length (declaration_local_lets empty)) 0)
}
