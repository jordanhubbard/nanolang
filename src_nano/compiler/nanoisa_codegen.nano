    assert (str_contains glue_text "STR_CONCAT")
    let src4: string = (+ "f" "n len3() -> int { let xs: array<int> = [1, 2, 3] return (array_length xs) } shadow len3 { assert true }")
    let toks4: List<LexerToken> = (tokenize_string src4 "t.nano" diags)
