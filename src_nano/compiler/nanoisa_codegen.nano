fn nisa_emit_match(parser: Parser, node_id: int) -> string {
    let m: ASTMatch = (parser_get_match parser node_id)
    if (!= m.scrutinee_type ParseNodeType.PNODE_IDENTIFIER) {
        return (nisa_fail "match scrutinee needs a local")
    } else {
        let id: ASTIdentifier = (parser_get_identifier parser m.scrutinee)
        let slot: int = (nisa_local_find id.name)
        if (< slot 0) {
            return (nisa_fail (+ "undefined local " id.name))
        } else {
            if (>= slot (array_length nisa_types)) {
                return (nisa_fail (+ "untyped local " id.name))
            } else {
                let utype: string = (at nisa_types slot)
                let uidx: int = (nisa_union_index parser utype)
                if (< uidx 0) {
                    return (nisa_fail (+ "match needs a union local " id.name))
                } else {
                    let l_end: string = (nisa_fresh)
                    let mut out: string = (nisa_emit_expr parser m.scrutinee m.scrutinee_type)
                    let mut i: int = 0
                    while (< i m.arm_count) {
                        let vname: string = (at m.arm_variants i)
                        let vi: int = (nisa_union_variant_index parser uidx vname)
                        if (< vi 0) {
                            return (nisa_fail (+ "unknown variant " vname))
                        } else {
                            let l_next: string = (nisa_fresh)
                            set out (+ out (nisa_line "DUP"))
                            set out (+ out (nisa_line "AGG_TAG"))
                            set out (+ out (nisa_line_imm "PUSH_I64" (int_to_string vi)))
                            set out (+ out (nisa_line "EQ"))
                            set out (+ out (nisa_line_imm "JMP_FALSE" l_next))
                            let bname: string = (at m.arm_bindings i)
                            if (!= bname "") {
                                set nisa_names (array_push nisa_names bname)
                                set nisa_types (array_push nisa_types utype)
                                let bslot: int = (- (array_length nisa_names) 1)
                                set out (+ out (nisa_line "DUP"))
                                set out (+ out (nisa_line_imm "STORE_LOCAL" (int_to_string bslot)))
                            } else {
                                (print "")
                            }
                            set out (+ out (nisa_line "POP"))
                            let bid: int = (at m.arm_body_ids i)
                            let bty: int = (at m.arm_body_types i)
                            if (== bty ParseNodeType.PNODE_BLOCK) {
                                set out (+ out (nisa_emit_block parser bid))
                                if (not nisa_ok) {
                                    return out
                                } else {
                                    set out (+ out (nisa_line "PUSH_VOID"))
                                }
                            } else {
                                let piece: string = (nisa_emit_expr parser bid bty)
                                if (not nisa_ok) {
                                    return piece
                                } else {
                                    set out (+ out piece)
                                }
                            }
                            set out (+ out (nisa_line_imm "JMP" l_end))
                            set out (+ out (nisa_label_line l_next))
                            set i (+ i 1)
                        }
                    }
                    set out (+ out (nisa_line "POP"))
                    set out (+ out (nisa_line_imm "PUSH_BOOL" "0"))
                    set out (+ out (nisa_line "ASSERT"))
                    set out (+ out (nisa_line "HALT"))
                    set out (+ out (nisa_label_line l_end))
                    return out
                }
            }
        }
    }
}

shadow nisa_emit_match {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "union ResultI { Ok { value: int }, Err { error: string } } " (+ (+ "f" "n via_ok() -> ResultI { return ResultI.Ok { value: 42 } } shadow via_ok { assert true } ") (+ "f" "n via_m_ok() -> int { let r: ResultI = (via_ok) match r { Ok(v) => { return v.value } Err(e) => { return 0 } } } shadow via_m_ok { assert true }")))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 1)
    let text: string = (nisa_emit_function p func)
    assert (str_contains text "DUP")
    assert (str_contains text "AGG_TAG")
    assert (str_contains text "EQ")
    assert (str_contains text "PUSH_VOID")
    assert (str_contains text "HALT")
    assert (str_contains text "AGG_GET 0")
    let _2: int = (nisa_reset)
}

fn nisa_emit_stmt(parser: Parser, stmt: ASTStmtRef) -> string {
    if (== stmt.node_type ParseNodeType.PNODE_RETURN) {
        let r: ASTReturn = (parser_get_return parser stmt.node_id)
        if (< r.value 0) {
            return (nisa_line "RET")
        } else {
        if (== r.value_type ParseNodeType.PNODE_CALL) {
            let call: ASTCall = (parser_get_call parser r.value)
            let func_id: ASTIdentifier = (parser_get_identifier parser call.function)
            if (nisa_is_inline_call func_id.name) {
                return (+ (nisa_emit_call parser call) (nisa_line "RET"))
            } else {
                if (nisa_is_host_call parser func_id.name) {
                    return (+ (nisa_emit_host_call parser call) (nisa_line "RET"))
                } else {
                if (not (nisa_fn_defined parser func_id.name)) {
                    return (nisa_fail (+ "undefined function " func_id.name))
                } else {
                    let bad: string = (nisa_check_arity parser func_id.name call.arg_count)
                    if (not nisa_ok) {
                        return bad
                    } else {
                    return (+ (nisa_emit_call_args parser call) (nisa_line_imm "TAIL_CALL" func_id.name))
                    }
                }
                }
            }
        } else {
            if (== r.value_type ParseNodeType.PNODE_MODULE_QUALIFIED_CALL) {
                let mqc: ASTModuleQualifiedCall = (parser_get_module_qualified_call parser r.value)
                let callee: string = (nisa_mqc_callee parser mqc)
                if (== callee "") {
                    return (nisa_fail (+ "undefined module function " (nisa_mqc_qualified mqc)))
                } else {
                    let bad: string = (nisa_check_arity parser callee mqc.arg_count)
                    if (not nisa_ok) {
                        return bad
                    } else {
                    return (+ (nisa_emit_mqc_args parser mqc) (nisa_line_imm "TAIL_CALL" callee))
                    }
                }
            } else {
                let val: string = (nisa_emit_expr parser r.value r.value_type)
                return (+ val (nisa_line "RET"))
            }
        }
        }
    } else {
        if (== stmt.node_type ParseNodeType.PNODE_LET) {
            let l: ASTLet = (parser_get_let parser stmt.node_id)
            let val: string = (nisa_emit_expr parser l.value l.value_type)
            if (not (nisa_type_ok parser l.var_type)) {
                return (nisa_fail (+ "unsupported local type " l.var_type))
            } else {
                set nisa_names (array_push nisa_names l.name)
                set nisa_types (array_push nisa_types l.var_type)
                let slot: int = (- (array_length nisa_names) 1)
                return (+ val (nisa_line_imm "STORE_LOCAL" (int_to_string slot)))
            }
        } else {
            if (== stmt.node_type ParseNodeType.PNODE_SET) {
                let s: ASTSet = (parser_get_set parser stmt.node_id)
                let slot: int = (nisa_local_find s.target)
                if (< slot 0) {
                    let gslot: int = (nisa_global_find s.target)
                    if (< gslot 0) {
                        return (nisa_fail (+ "undefined local " s.target))
                    } else {
                        let gval: string = (nisa_emit_expr parser s.value s.value_type)
                        return (+ gval (nisa_line_imm "STORE_GLOBAL" (int_to_string gslot)))
                    }
                } else {
                    let val: string = (nisa_emit_expr parser s.value s.value_type)
                    return (+ val (nisa_line_imm "STORE_LOCAL" (int_to_string slot)))
                }
            } else {
                if (== stmt.node_type ParseNodeType.PNODE_IF) {
                    let node: ASTIf = (parser_get_if parser stmt.node_id)
                    return (nisa_emit_if parser node)
                } else {
                    if (== stmt.node_type ParseNodeType.PNODE_WHILE) {
                        let w: ASTWhile = (parser_get_while parser stmt.node_id)
                        return (nisa_emit_while parser w)
                    } else {
                        if (== stmt.node_type ParseNodeType.PNODE_FOR) {
                            let for_node: ASTFor = (parser_get_for parser stmt.node_id)
                            return (nisa_emit_for parser for_node)
                        } else {
                        if (== stmt.node_type ParseNodeType.PNODE_BREAK) {
                            let bend: string = (nisa_loop_end_name)
                            if (== bend "") {
                                return (nisa_fail "break outside loop")
                            } else {
                                return (nisa_line_imm "JMP" bend)
                            }
                        } else {
                        if (== stmt.node_type ParseNodeType.PNODE_CONTINUE) {
                            let ctop: string = (nisa_loop_top_name)
                            if (== ctop "") {
                                return (nisa_fail "continue outside loop")
                            } else {
                                return (nisa_line_imm "JMP" ctop)
                            }
                        } else {
                        if (== stmt.node_type ParseNodeType.PNODE_ASSERT) {
                            let node: ASTAssert = (parser_get_assert parser stmt.node_id)
                            return (nisa_emit_assert parser node)
                        } else {
                        if (== stmt.node_type ParseNodeType.PNODE_CALL) {
                            let call: ASTCall = (parser_get_call parser stmt.node_id)
                            let func_id: ASTIdentifier = (parser_get_identifier parser call.function)
                            if (or (nisa_is_print_builtin func_id.name) (nisa_is_hm_void_call func_id.name)) {
                                return (nisa_emit_call parser call)
                            } else {
                                if (nisa_is_mut_arr_stmt func_id.name) {
                                    return (+ (nisa_emit_call parser call) (nisa_line "POP"))
                                } else {
                                if (nisa_fn_is_void parser func_id.name) {
                                    return (nisa_emit_call parser call)
                                } else {
                                    let expr: string = (nisa_emit_expr parser stmt.node_id stmt.node_type)
                                    return (+ expr (nisa_line "POP"))
                                }
                                }
                            }
                        } else {
                            if (== stmt.node_type ParseNodeType.PNODE_MODULE_QUALIFIED_CALL) {
                                let mqc: ASTModuleQualifiedCall = (parser_get_module_qualified_call parser stmt.node_id)
                                let callee: string = (nisa_mqc_callee parser mqc)
                                if (== callee "") {
                                    return (nisa_fail (+ "undefined module function " (nisa_mqc_qualified mqc)))
                                } else {
                                    if (nisa_fn_is_void parser callee) {
                                        return (nisa_emit_mqc parser stmt.node_id)
                                    } else {
                                        return (+ (nisa_emit_mqc parser stmt.node_id) (nisa_line "POP"))
                                    }
                                }
                            } else {
                            if (or (== stmt.node_type ParseNodeType.PNODE_NUMBER)
                                   (or (== stmt.node_type ParseNodeType.PNODE_IDENTIFIER)
                                       (or (== stmt.node_type ParseNodeType.PNODE_BINARY_OP)
                                           (== stmt.node_type ParseNodeType.PNODE_BOOL)))) {
                                let expr: string = (nisa_emit_expr parser stmt.node_id stmt.node_type)
                                return (+ expr (nisa_line "POP"))
                            } else {
                                if (== stmt.node_type ParseNodeType.PNODE_MATCH) {
                                    return (+ (nisa_emit_match parser stmt.node_id) (nisa_line "POP"))
                                } else {
                                if (== stmt.node_type ParseNodeType.PNODE_UNSAFE_BLOCK) {
                                    return (nisa_emit_unsafe parser stmt.node_id)
                                } else {
                                    return (nisa_fail (+ "statement outside the pinned subset " (+ (int_to_string stmt.node_type) (+ " in " nisa_cur_fn))))
                                }
                                }
                            }
                            }
                        }
                    }
                    }
                    }
                    }
                    }
                }
            }
        }
    }
}

shadow nisa_emit_stmt {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n main() -> int { return 1 } shadow main { assert (== (main) 1) }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 0)
    let text: string = (nisa_emit_stmt p stmt)
    assert (str_contains text "RET")
}

fn nisa_emit_block(parser: Parser, block_id: int) -> string {
    if (< block_id 0) {
        return (nisa_fail "missing function body")
    } else {
        let block: ASTBlock = (parser_get_block parser block_id)
        let n: int = (list_ASTStmtRef_length block.statements)
        let mut out: string = ""
        let mut i: int = 0
        while (< i n) {
            let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements i)
            set out (+ out (nisa_emit_stmt parser stmt))
            if (nisa_stmt_terminates parser stmt) {
                break
            } else {
                set i (+ i 1)
            }
        }
        return out
    }
}

shadow nisa_emit_block {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n main() -> int { return 3 } shadow main { assert (== (main) 3) }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let text: string = (nisa_emit_block p func.body)
    assert (str_contains text "PUSH_I64 3")
}

fn nisa_emit_function(parser: Parser, func: ASTFunction) -> string {
    set nisa_names []
    set nisa_types []
    set nisa_cur_fn func.name
    let tag: string = (nisa_result_tag parser func.return_type)
    if (== tag "") {
        return (nisa_fail (+ "unsupported result type " func.return_type))
    } else {
        let mut i: int = 0
        while (< i func.param_count) {
            let plet: ASTLet = (parser_get_let parser (+ func.param_start i))
            if (not (nisa_type_ok parser plet.var_type)) {
                return (nisa_fail (+ "unsupported param type " plet.var_type))
            } else {
                set nisa_names (array_push nisa_names plet.name)
                set nisa_types (array_push nisa_types plet.var_type)
                set i (+ i 1)
            }
        }
        let mut body: string = (nisa_emit_block parser func.body)
        if (nisa_block_falls_through parser func.body) {
            set body (+ body (nisa_line "RET"))
        } else {
            (print "")
        }
        let locals: int = (array_length nisa_names)
        let mut header: string = ".function "
        set header (+ header func.name)
        set header (+ header " ")
        set header (+ header (int_to_string func.param_count))
        set header (+ header " ")
        set header (+ header (int_to_string locals))
        set header (+ header " 0 ")
        set header (+ header tag)
        if (== tag "void") {
            set header (+ header " 0\n")
        } else {
            set header (+ header " 1\n")
        }
        set nisa_fn_emitted (+ nisa_fn_emitted 1)
        return (+ (+ header body) ".end\n")
    }
}

shadow nisa_emit_function {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n add(a: int, b: int) -> int { return (+ a b) } shadow add { assert (== (add 2 3) 5) }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let text: string = (nisa_emit_function p func)
    assert (str_contains text ".function add 2 2 0 int 1")
    assert (str_contains text "I64_ADD")
    assert (str_contains text "LOAD_LOCAL 0")
    assert (str_contains text "LOAD_LOCAL 1")
    let src2: string = (+ "f" "n greeting() -> string { return \"hi\" } shadow greeting { assert true }")
    let toks2: List<LexerToken> = (tokenize_string src2 "t.nano" diags)
    let p2: Parser = (parse_program toks2 (list_LexerToken_length toks2) "t.nano")
    let gfn: ASTFunction = (parser_get_function p2 0)
    let gtext: string = (nisa_emit_function p2 gfn)
    assert (str_contains gtext ".function greeting 0 0 0 string 1")
    assert (str_contains gtext "PUSH_STR s0")
    let src3: string = (+ "f" "n glue(a: string, b: string) -> string { return (+ a b) } shadow glue { assert true }")
    let toks3: List<LexerToken> = (tokenize_string src3 "t.nano" diags)
    let p3: Parser = (parse_program toks3 (list_LexerToken_length toks3) "t.nano")
    let glue_fn: ASTFunction = (parser_get_function p3 0)
    let glue_text: string = (nisa_emit_function p3 glue_fn)
    assert (str_contains glue_text ".function glue 2 2 0 string 1")
    assert (str_contains glue_text "STR_CONCAT")
    let src4: string = (+ "f" "n len3() -> int { let xs: array<int> = [1, 2, 3] return (array_length xs) } shadow len3 { assert true }")
    let toks4: List<LexerToken> = (tokenize_string src4 "t.nano" diags)
    let p4: Parser = (parse_program toks4 (list_LexerToken_length toks4) "t.nano")
    let len_fn: ASTFunction = (parser_get_function p4 0)
    let len_text: string = (nisa_emit_function p4 len_fn)
    assert (str_contains len_text ".function len3 0 1 0 int 1")
    assert (str_contains len_text "ARR_LITERAL 1 3")
    assert (str_contains len_text "ARR_LEN")
    let src5: string = (+ "struct Point { x: int, y: int } " (+ "f" "n getx() -> int { let p: Point = Point { x: 3, y: 4 } return p.x } shadow getx { assert true }"))
    let toks5: List<LexerToken> = (tokenize_string src5 "t.nano" diags)
    let p5: Parser = (parse_program toks5 (list_LexerToken_length toks5) "t.nano")
    let gx: ASTFunction = (parser_get_function p5 0)
    let gx_text: string = (nisa_emit_function p5 gx)
    assert (str_contains gx_text ".function getx 0 1 0 int 1")
    assert (str_contains gx_text "AGG_PACK 0 0 0 2")
    assert (str_contains gx_text "AGG_GET 0")
    let src6: string = (+ "f" "n is_pos(c: int) -> bool { return (> c 0) } shadow is_pos { assert true }")
    let toks6: List<LexerToken> = (tokenize_string src6 "t.nano" diags)
    let p6: Parser = (parse_program toks6 (list_LexerToken_length toks6) "t.nano")
    let pos_fn: ASTFunction = (parser_get_function p6 0)
    let pos_text: string = (nisa_emit_function p6 pos_fn)
    assert (str_contains pos_text ".function is_pos 1 1 0 bool 1")
    assert (str_contains pos_text "I64_GT_S")
    let src7: string = (+ "f" "n yes() -> bool { return true } shadow yes { assert true }")
    let toks7: List<LexerToken> = (tokenize_string src7 "t.nano" diags)
    let p7: Parser = (parse_program toks7 (list_LexerToken_length toks7) "t.nano")
