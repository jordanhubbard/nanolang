/* =============================================================================
 * NanoISA lowering (src_nano dual of src/nanovirt/codegen.c, pinned subset)
 * =============================================================================
 * I walk the self-hosted parser AST and write .nasm. Cut A covers integer
 * functions: literals, locals, +, -, *, /, %, comparisons, calls, return,
 * if/else, while, for-in over array<int> (LT, not I64_LT_S), let, set,
 * string literals, string concat, array<int>
 * literals, array_length, array_get, int- and string-field records
 * (AGG_PACK/AGG_GET),
 * bool results (i64 0/1), bool literals (PUSH_BOOL), not (BOOL_NOT),
 * and/or (BOOL_AND/BOOL_OR), cond as an if-expression (JMP_FALSE/JMP),
 * print (PRINT), println (PRINTLN), assert (ASSERT), void
 * functions (RET with no value; a statement CALL of void does not POP),
 * and pin-record results (ISA tag struct, not the NanoLang name),
 * and array/list results (ISA tag array),
 * and Enum.Variant as ENUM_VAL (local first, then direct import),
 * and one-level nested pin-record field types, and imported
 * functions as CALL/TAIL_CALL (C seed pass 2b), unsafe blocks as
 * inner statements, getcwd as CALL_EXTERN vm_getcwd, and nested
 * pin-record literals as inner AGG_PACK then outer AGG_PACK, bool
 * fields, List<int> fields, string `+` of a string field or
 * `int_to_string`, and `str_concat` as `STR_CONCAT` (C seed builtin;
 * I still write `(+ a b)` in new code), and `string_to_int` as
 * `CAST_INT` (C seed builtin), and nested pin-record field access as
 * chained `AGG_GET` (C seed `infer_expr_struct_type`), and
 * module-qualified calls `(Alias.fn args)` as CALL/TAIL_CALL of the
 * imported function (C seed AST_MODULE_QUALIFIED_CALL: qualified
 * name first, then the suffix after the last dot), and `array<R>`
 * of a pin-record as ISA tag array (empty `[]` is ARR_LITERAL 1 0,
 * the way the C seed defaults the element tag), and module-level
 * lets as LOAD_GLOBAL/STORE_GLOBAL with a void `__init__` (C seed
 * pass 1.5), and `break`/`continue` as `JMP` to the innermost loop
 * end/top (C seed `AST_BREAK` / `AST_CONTINUE`).
 * Anything else fails closed.
 * I do not emit C. I do not delete transpiler.nano.
 */

import "src_nano/parser.nano"
import "src_nano/compiler/lexer.nano"
from "src_nano/compiler/diagnostics.nano" import diag_list_new
from "std/fs.nano" import exists, read

let mut nisa_names: array<string> = []
let mut nisa_types: array<string> = []
let mut nisa_str_vals: array<string> = []
let mut nisa_str_names: array<string> = []
let mut nisa_ok: bool = true
let mut nisa_err: string = ""
let mut nisa_label: int = 0
let mut nisa_seen: array<string> = []
let mut nisa_imp_fn_names: array<string> = []
let mut nisa_imp_fn_rets: array<string> = []
let mut nisa_ext_syms: array<string> = []
let mut nisa_ext_rets: array<string> = []
let mut nisa_ext_params: array<string> = []
let mut nisa_fn_emitted: int = 0
let mut nisa_g_names: array<string> = []
let mut nisa_g_types: array<string> = []
let mut nisa_cur_fn: string = ""
let mut nisa_loop_depth: int = 0
let mut nisa_loop_tops: array<string> = []
let mut nisa_loop_ends: array<string> = []

fn nisa_reset() -> int {
    set nisa_names []
    set nisa_types []
    set nisa_str_vals []
    set nisa_str_names []
    set nisa_ok true
    set nisa_err ""
    set nisa_label 0
    set nisa_seen []
    set nisa_imp_fn_names []
    set nisa_imp_fn_rets []
    set nisa_ext_syms []
    set nisa_ext_rets []
    set nisa_ext_params []
    set nisa_fn_emitted 0
    set nisa_g_names []
    set nisa_g_types []
    set nisa_cur_fn ""
    set nisa_loop_depth 0
    set nisa_loop_tops []
    set nisa_loop_ends []
    return 0
}

shadow nisa_reset {
    let _: int = (nisa_reset)
    assert nisa_ok
    assert (== nisa_err "")
}

fn nisa_fail(msg: string) -> string {
    set nisa_ok false
    if (== nisa_err "") {
        set nisa_err msg
    } else {
        (print "")
    }
    return ""
}

shadow nisa_fail {
    let _: int = (nisa_reset)
    let out: string = (nisa_fail "refused")
    assert (== out "")
    assert (not nisa_ok)
    assert (== nisa_err "refused")
    let _2: int = (nisa_reset)
}

fn nisa_refuse_line() -> string {
    return (+ "I refused that program: " nisa_err)
}

shadow nisa_refuse_line {
    let _: int = (nisa_reset)
    let _f: string = (nisa_fail "no main")
    assert (== (nisa_refuse_line) "I refused that program: no main")
    let _2: int = (nisa_reset)
}

fn nisa_local_find(name: string) -> int {
    let mut i: int = 0
    while (< i (array_length nisa_names)) {
        if (== (at nisa_names i) name) {
            return i
        } else {
            (print "")
        }
        set i (+ i 1)
    }
    return (- 0 1)
}

shadow nisa_local_find {
    let _: int = (nisa_reset)
    set nisa_names (array_push nisa_names "a")
    set nisa_names (array_push nisa_names "b")
    assert (== (nisa_local_find "a") 0)
    assert (== (nisa_local_find "b") 1)
    assert (== (nisa_local_find "z") (- 0 1))
    let _2: int = (nisa_reset)
}

fn nisa_global_find(name: string) -> int {
    let mut i: int = 0
    while (< i (array_length nisa_g_names)) {
        if (== (at nisa_g_names i) name) {
            return i
        } else {
            (print "")
        }
        set i (+ i 1)
    }
    return (- 0 1)
}

shadow nisa_global_find {
    let _: int = (nisa_reset)
    set nisa_g_names (array_push nisa_g_names "g")
    assert (== (nisa_global_find "g") 0)
    assert (== (nisa_global_find "z") (- 0 1))
    let _2: int = (nisa_reset)
}

fn nisa_name_type(name: string) -> string {
    let slot: int = (nisa_local_find name)
    if (and (>= slot 0) (< slot (array_length nisa_types))) {
        return (at nisa_types slot)
    } else {
        let gslot: int = (nisa_global_find name)
        if (and (>= gslot 0) (< gslot (array_length nisa_g_types))) {
            return (at nisa_g_types gslot)
        } else {
            return ""
        }
    }
}

shadow nisa_name_type {
    let _: int = (nisa_reset)
    set nisa_names (array_push nisa_names "x")
    set nisa_types (array_push nisa_types "int")
    set nisa_g_names (array_push nisa_g_names "g")
    set nisa_g_types (array_push nisa_g_types "array<string>")
    assert (== (nisa_name_type "x") "int")
    assert (== (nisa_name_type "g") "array<string>")
    assert (== (nisa_name_type "z") "")
    let _2: int = (nisa_reset)
}

fn nisa_let_is_param(parser: Parser, let_idx: int) -> bool {
    let n: int = (parser_get_function_count parser)
    let mut i: int = 0
    while (< i n) {
        let f: ASTFunction = (parser_get_function parser i)
        if (and (>= let_idx f.param_start) (< let_idx (+ f.param_start f.param_count))) {
            return true
        } else {
            (print "")
        }
        set i (+ i 1)
    }
    return false
}

shadow nisa_let_is_param {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n add(a: int, b: int) -> int { return (+ a b) } shadow add { assert true }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let f: ASTFunction = (parser_get_function p 0)
    assert (nisa_let_is_param p f.param_start)
    assert (not (nisa_let_is_param p 99))
    let _2: int = (nisa_reset)
}

fn nisa_let_in_blocks(parser: Parser, let_idx: int) -> bool {
    let n: int = (parser_get_block_count parser)
    let mut b: int = 0
    while (< b n) {
        let block: ASTBlock = (parser_get_block parser b)
        let ns: int = (list_ASTStmtRef_length block.statements)
        let mut s: int = 0
        while (< s ns) {
            let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements s)
            if (and (== stmt.node_type ParseNodeType.PNODE_LET) (== stmt.node_id let_idx)) {
                return true
            } else {
                (print "")
            }
            set s (+ s 1)
        }
        set b (+ b 1)
    }
    return false
}

shadow nisa_let_in_blocks {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n f() -> int { let x: int = 1 return x } shadow f { assert true }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 0)
    assert (nisa_let_in_blocks p stmt.node_id)
    assert (not (nisa_let_in_blocks p 99))
    let _2: int = (nisa_reset)
}

fn nisa_let_is_global(parser: Parser, let_idx: int) -> bool {
    if (nisa_let_is_param parser let_idx) {
        return false
    } else {
        if (nisa_let_in_blocks parser let_idx) {
            return false
        } else {
            return true
        }
    }
}

shadow nisa_let_is_global {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "let mut g: array<string> = [] " (+ "f" "n f() -> int { let x: int = 1 return x } shadow f { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (nisa_let_is_global p 0)
    let func: ASTFunction = (parser_get_function p 0)
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 0)
    assert (not (nisa_let_is_global p stmt.node_id))
    let _2: int = (nisa_reset)
}

fn nisa_str_escape(lit: string) -> string {
    let mut out: string = ""
    let n: int = (str_length lit)
    let mut i: int = 0
    while (< i n) {
        let ch: string = (str_substring lit i 1)
        if (== ch "\\") {
            set out (+ out "\\\\")
        } else {
            if (== ch "\"") {
                set out (+ out "\\\"")
            } else {
                if (== ch "\n") {
                    set out (+ out "\\n")
                } else {
                    if (== ch "\t") {
                        set out (+ out "\\t")
                    } else {
                        if (== ch "\r") {
                            set out (+ out "\\r")
                        } else {
                            set out (+ out ch)
                        }
                    }
                }
            }
        }
        set i (+ i 1)
    }
    return out
}

shadow nisa_str_escape {
    assert (== (nisa_str_escape "hi") "hi")
    assert (== (nisa_str_escape "a\"b") "a\\\"b")
    assert (== (nisa_str_escape "\\") "\\\\")
}

fn nisa_intern(lit: string) -> string {
    let mut i: int = 0
    while (< i (array_length nisa_str_vals)) {
        if (== (at nisa_str_vals i) lit) {
            return (at nisa_str_names i)
        } else {
            (print "")
        }
        set i (+ i 1)
    }
    let name: string = (+ "s" (int_to_string (array_length nisa_str_vals)))
    set nisa_str_vals (array_push nisa_str_vals lit)
    set nisa_str_names (array_push nisa_str_names name)
    return name
}

shadow nisa_intern {
    let _: int = (nisa_reset)
    assert (== (nisa_intern "hi") "s0")
    assert (== (nisa_intern "hi") "s0")
    assert (== (nisa_intern "ab") "s1")
    assert (== (nisa_intern "a\"b") "s2")
    let _2: int = (nisa_reset)
}

fn nisa_str_prelude() -> string {
    let mut out: string = ""
    let mut i: int = 0
    while (< i (array_length nisa_str_names)) {
        set out (+ out ".string ")
        set out (+ out (at nisa_str_names i))
        set out (+ out " \"")
        set out (+ out (nisa_str_escape (at nisa_str_vals i)))
        set out (+ out "\"\n")
        set i (+ i 1)
    }
    return out
}

shadow nisa_str_prelude {
    let _: int = (nisa_reset)
    let name: string = (nisa_intern "hi")
    let text: string = (nisa_str_prelude)
    assert (== name "s0")
    assert (str_contains text ".string s0 \"hi\"")
    let qn: string = (nisa_intern "a\"b")
    let qtext: string = (nisa_str_prelude)
    assert (== qn "s1")
    assert (str_contains qtext "a\\\"b")
    let _2: int = (nisa_reset)
}

fn nisa_binop_mnemonic(op: int) -> string {
    if (== op LexerTokenType.TOKEN_PLUS) {
        return "I64_ADD"
    } else {
        if (== op LexerTokenType.TOKEN_MINUS) {
            return "I64_SUB"
        } else {
            if (== op LexerTokenType.TOKEN_STAR) {
                return "I64_MUL"
            } else {
                if (== op LexerTokenType.TOKEN_SLASH) {
                    return "I64_DIV_S"
                } else {
                    if (== op LexerTokenType.TOKEN_PERCENT) {
                        return "I64_REM_S"
                    } else {
                        if (== op LexerTokenType.TOKEN_EQ) {
                            return "I64_EQ"
                        } else {
                            if (== op LexerTokenType.TOKEN_NE) {
                                return "I64_NE"
                            } else {
                                if (== op LexerTokenType.TOKEN_LT) {
                                    return "I64_LT_S"
                                } else {
                                    if (== op LexerTokenType.TOKEN_LE) {
                                        return "I64_LE_S"
                                    } else {
                                        if (== op LexerTokenType.TOKEN_GT) {
                                            return "I64_GT_S"
                                        } else {
                                            if (== op LexerTokenType.TOKEN_GE) {
                                                return "I64_GE_S"
                                            } else {
                                                if (== op LexerTokenType.TOKEN_AND) {
                                                    return "BOOL_AND"
                                                } else {
                                                    if (== op LexerTokenType.TOKEN_OR) {
                                                        return "BOOL_OR"
                                                    } else {
                                                        return ""
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

shadow nisa_binop_mnemonic {
    assert (== (nisa_binop_mnemonic LexerTokenType.TOKEN_PLUS) "I64_ADD")
    assert (== (nisa_binop_mnemonic LexerTokenType.TOKEN_STAR) "I64_MUL")
    assert (== (nisa_binop_mnemonic LexerTokenType.TOKEN_AND) "BOOL_AND")
    assert (== (nisa_binop_mnemonic LexerTokenType.TOKEN_OR) "BOOL_OR")
    assert (== (nisa_binop_mnemonic LexerTokenType.TOKEN_GE) "I64_GE_S")
    assert (== (nisa_binop_mnemonic LexerTokenType.TOKEN_LE) "I64_LE_S")
    assert (== (nisa_binop_mnemonic 0) "")
}

fn nisa_f64_binop_mnemonic(op: int) -> string {
    if (== op LexerTokenType.TOKEN_PLUS) {
        return "F64_ADD"
    } else {
        if (== op LexerTokenType.TOKEN_MINUS) {
            return "F64_SUB"
        } else {
            if (== op LexerTokenType.TOKEN_STAR) {
                return "F64_MUL"
            } else {
                if (== op LexerTokenType.TOKEN_SLASH) {
                    return "F64_DIV"
                } else {
                    if (== op LexerTokenType.TOKEN_EQ) {
                        return "F64_EQ"
                    } else {
                        if (== op LexerTokenType.TOKEN_NE) {
                            return "F64_NE"
                        } else {
                            if (== op LexerTokenType.TOKEN_LT) {
                                return "F64_LT"
                            } else {
                                if (== op LexerTokenType.TOKEN_LE) {
                                    return "F64_LE"
                                } else {
                                    if (== op LexerTokenType.TOKEN_GT) {
                                        return "F64_GT"
                                    } else {
                                        if (== op LexerTokenType.TOKEN_GE) {
                                            return "F64_GE"
                                        } else {
                                            return ""
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

shadow nisa_f64_binop_mnemonic {
    assert (== (nisa_f64_binop_mnemonic LexerTokenType.TOKEN_PLUS) "F64_ADD")
    assert (== (nisa_f64_binop_mnemonic LexerTokenType.TOKEN_STAR) "F64_MUL")
    assert (== (nisa_f64_binop_mnemonic LexerTokenType.TOKEN_EQ) "F64_EQ")
    assert (== (nisa_f64_binop_mnemonic LexerTokenType.TOKEN_GE) "F64_GE")
    assert (== (nisa_f64_binop_mnemonic LexerTokenType.TOKEN_PERCENT) "")
    assert (== (nisa_f64_binop_mnemonic 0) "")
}

fn nisa_binop_is_unary_minus(parser: Parser, binop: ASTBinaryOp) -> bool {
    if (!= binop.op LexerTokenType.TOKEN_MINUS) {
        return false
    } else {
        if (!= binop.left_type ParseNodeType.PNODE_NUMBER) {
            return false
        } else {
            let n: ASTNumber = (parser_get_number parser binop.left)
            return (== n.value "0")
        }
    }
}

shadow nisa_binop_is_unary_minus {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n n() -> int { return (- 5) } shadow n { assert true }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 0)
    let r: ASTReturn = (parser_get_return p stmt.node_id)
    let binop: ASTBinaryOp = (parser_get_binary_op p r.value)
    assert (nisa_binop_is_unary_minus p binop)
    let _2: int = (nisa_reset)
    let src2: string = (+ "f" "n s() -> int { return (- 1 2) } shadow s { assert true }")
    let toks2: List<LexerToken> = (tokenize_string src2 "t.nano" diags)
    let p2: Parser = (parse_program toks2 (list_LexerToken_length toks2) "t.nano")
    let func2: ASTFunction = (parser_get_function p2 0)
    let block2: ASTBlock = (parser_get_block p2 func2.body)
    let stmt2: ASTStmtRef = (list_ASTStmtRef_get block2.statements 0)
    let r2: ASTReturn = (parser_get_return p2 stmt2.node_id)
    let binop2: ASTBinaryOp = (parser_get_binary_op p2 r2.value)
    assert (not (nisa_binop_is_unary_minus p2 binop2))
    let _3: int = (nisa_reset)
}

fn nisa_line(op: string) -> string {
    return (+ (+ "  " op) "\n")
}

shadow nisa_line {
    assert (== (nisa_line "RET") "  RET\n")
}

fn nisa_line_imm(op: string, imm: string) -> string {
    return (+ (+ (+ (+ "  " op) " ") imm) "\n")
}

shadow nisa_line_imm {
    assert (== (nisa_line_imm "PUSH_I64" "40") "  PUSH_I64 40\n")
}

fn nisa_local_type_ok(t: string) -> bool {
    if (== t "int") {
        return true
    } else {
        if (== t "string") {
            return true
        } else {
            if (== t "bool") {
                return true
            } else {
                if (== t "float") {
                    return true
                } else {
                return (or (== t "array<int>")
                           (or (== t "array<string>")
                               (or (== t "array<bool>")
                                   (or (== t "List<int>")
                                       (or (== t "list_int")
                                           (or (== t "List<string>") (== t "list_string")))))))
                }
            }
        }
    }
}

shadow nisa_local_type_ok {
    assert (nisa_local_type_ok "int")
    assert (nisa_local_type_ok "string")
    assert (nisa_local_type_ok "bool")
    assert (nisa_local_type_ok "float")
    assert (nisa_local_type_ok "array<int>")
    assert (nisa_local_type_ok "array<string>")
    assert (nisa_local_type_ok "array<bool>")
    assert (nisa_local_type_ok "List<int>")
    assert (nisa_local_type_ok "list_int")
    assert (nisa_local_type_ok "List<string>")
    assert (nisa_local_type_ok "list_string")
}

fn nisa_is_arr_builtin(name: string) -> bool {
    return (or (== name "array_length")
               (or (== name "array_get")
                   (or (== name "array_push")
                       (or (== name "array_new") (== name "at")))))
}

shadow nisa_is_arr_builtin {
    assert (nisa_is_arr_builtin "array_length")
    assert (nisa_is_arr_builtin "array_get")
    assert (nisa_is_arr_builtin "array_push")
    assert (nisa_is_arr_builtin "array_new")
    assert (nisa_is_arr_builtin "at")
    assert (not (nisa_is_arr_builtin "add"))
}

fn nisa_is_print_builtin(name: string) -> bool {
    return (or (== name "print") (== name "println"))
}

shadow nisa_is_print_builtin {
    assert (nisa_is_print_builtin "print")
    assert (nisa_is_print_builtin "println")
    assert (not (nisa_is_print_builtin "add"))
}

fn nisa_is_hm_void_call(name: string) -> bool {
    return (or (== name "map_put")
               (or (== name "map_set") (== name "hashmap_set")))
}

shadow nisa_is_hm_void_call {
    assert (nisa_is_hm_void_call "map_put")
    assert (nisa_is_hm_void_call "map_set")
    assert (not (nisa_is_hm_void_call "map_new"))
}

fn nisa_is_hm_builtin(name: string) -> bool {
    return (or (nisa_is_hm_void_call name)
               (or (== name "map_new")
                   (or (== name "hashmap_new")
                       (or (== name "map_has")
                           (or (== name "hashmap_has")
                               (or (== name "map_get") (== name "hashmap_get")))))))
}

shadow nisa_is_hm_builtin {
    assert (nisa_is_hm_builtin "map_new")
    assert (nisa_is_hm_builtin "map_put")
    assert (nisa_is_hm_builtin "map_has")
    assert (nisa_is_hm_builtin "map_get")
    assert (not (nisa_is_hm_builtin "add"))
}

fn nisa_is_hm_type(t: string) -> bool {
    return (or (== t "HashMap<string, string>")
               (or (== t "HashMap<string,string>")
                   (or (== t "HashMap<string, int>")
                       (== t "HashMap<string,int>"))))
}

shadow nisa_is_hm_type {
    assert (nisa_is_hm_type "HashMap<string, string>")
    assert (nisa_is_hm_type "HashMap<string,string>")
    assert (not (nisa_is_hm_type "array<int>"))
}

fn nisa_is_list_call(name: string) -> bool {
    return (and (or (str_starts_with name "list_") (str_starts_with name "List_"))
                (or (str_ends_with name "_new")
                    (or (str_ends_with name "_length")
                        (or (str_ends_with name "_push")
                            (or (str_ends_with name "_get") (str_ends_with name "_set"))))))
}

shadow nisa_is_list_call {
    assert (nisa_is_list_call "list_int_new")
    assert (nisa_is_list_call "list_int_length")
    assert (nisa_is_list_call "list_int_push")
    assert (nisa_is_list_call "list_int_get")
    assert (nisa_is_list_call "list_string_new")
    assert (nisa_is_list_call "list_string_push")
    assert (nisa_is_list_call "list_string_get")
    assert (nisa_is_list_call "list_string_length")
    assert (nisa_is_list_call "list_Tok_new")
    assert (nisa_is_list_call "list_Tok_push")
    assert (nisa_is_list_call "list_Tok_get")
    assert (nisa_is_list_call "list_Tok_length")
    assert (nisa_is_list_call "list_LexerToken_new")
    assert (nisa_is_list_call "list_LexerToken_push")
    assert (nisa_is_list_call "list_LexerToken_get")
    assert (nisa_is_list_call "list_int_set")
    assert (nisa_is_list_call "list_Tok_set")
    assert (nisa_is_list_call "list_string_set")
    assert (not (nisa_is_list_call "list_int_pop"))
    assert (not (nisa_is_list_call "array_new"))
}

fn nisa_is_mut_arr_stmt(name: string) -> bool {
    if (or (== name "array_push") (== name "array_set")) {
        return true
    } else {
        if (not (nisa_is_list_call name)) {
            return false
        } else {
            return (or (str_ends_with name "_push") (str_ends_with name "_set"))
        }
    }
}

shadow nisa_is_mut_arr_stmt {
    assert (nisa_is_mut_arr_stmt "array_push")
    assert (nisa_is_mut_arr_stmt "array_set")
    assert (nisa_is_mut_arr_stmt "list_int_push")
    assert (nisa_is_mut_arr_stmt "list_LexerToken_push")
    assert (nisa_is_mut_arr_stmt "list_int_set")
    assert (not (nisa_is_mut_arr_stmt "list_int_get"))
    assert (not (nisa_is_mut_arr_stmt "list_int_new"))
}

fn nisa_is_inline_call(name: string) -> bool {
    return (or (nisa_is_hm_builtin name)
               (or (nisa_is_arr_builtin name)
               (or (nisa_is_print_builtin name)
                   (or (nisa_is_list_call name)
                       (or (== name "not")
                           (or (== name "str_contains")
                               (or (== name "str_starts_with")
                                   (or (== name "str_ends_with")
                                       (or (== name "int_to_string")
                                           (or (== name "str_length")
                                               (or (== name "str_substring")
                                                   (or (== name "char_at")
                                                       (or (== name "str_char_at")
                                                           (or (== name "str_concat")
                                                               (or (== name "string_to_int")
                                                                   (or (== name "str_trim")
                                                                       (or (== name "str_split")
                                                                           (== name "str_replace"))))))))))))))))))
}

