fn nisa_struct_index(parser: Parser, name: string) -> int {
    let n: int = (parser_get_struct_def_count parser)
    let mut i: int = 0
    while (< i n) {
        let s: ASTStruct = (parser_get_struct_def parser i)
        if (== s.name name) {
            return i
        } else {
            (print "")
        }
        set i (+ i 1)
    }
    return (- 0 1)
}

shadow nisa_struct_index {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "struct Point { x: int, y: int } " (+ "f" "n getx() -> int { return 0 } shadow getx { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (== (nisa_struct_index p "Point") 0)
    assert (== (nisa_struct_index p "Nope") (- 0 1))
}

fn nisa_struct_field_index(parser: Parser, type_name: string, field_name: string) -> int {
    let sidx: int = (nisa_struct_index parser type_name)
    if (< sidx 0) {
        return (- 0 1)
    } else {
        let sd: ASTStruct = (parser_get_struct_def parser sidx)
        let mut i: int = 0
        while (< i sd.field_count) {
            if (== (at sd.field_names i) field_name) {
                return i
            } else {
                set i (+ i 1)
            }
        }
        return (- 0 1)
    }
}

shadow nisa_struct_field_index {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "struct Loc { file: string, line: int } " (+ "f" "n getx() -> int { return 0 } shadow getx { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (== (nisa_struct_field_index p "Loc" "file") 0)
    assert (== (nisa_struct_field_index p "Loc" "line") 1)
    assert (== (nisa_struct_field_index p "Loc" "nope") (- 0 1))
}

fn nisa_any_struct_field_index(parser: Parser, field: string) -> int {
    let n: int = (parser_get_struct_def_count parser)
    let mut i: int = 0
    while (< i n) {
        let sd: ASTStruct = (parser_get_struct_def parser i)
        let mut j: int = 0
        while (< j sd.field_count) {
            if (== (at sd.field_names j) field) {
                return j
            } else {
                set j (+ j 1)
            }
        }
        set i (+ i 1)
    }
    return (- 0 1)
}

