    let tag_fn: ASTFunction = (parser_get_function p56 0)
    let tag_text: string = (nisa_emit_function p56 tag_fn)
    assert (str_contains tag_text ".function tag 0 0 0 int 1")
    assert (str_contains tag_text "ENUM_VAL 0 19")
    let src57: string = (+ "enum Kind { A = 19, B } " (+ (+ "f" "n tag() -> int { return Kind.A } ") (+ "f" "n via_tag() -> int { return (tag) } shadow tag { assert true } shadow via_tag { assert true }")))
    let toks57: List<LexerToken> = (tokenize_string src57 "t.nano" diags)
