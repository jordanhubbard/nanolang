    let src58: string = (+ "from \"cut_a_kind_imp.nano\" import ImpKind " (+ "f" "n tok_mod() -> int { return ImpKind.A } shadow tok_mod { assert true }"))
    let toks58: List<LexerToken> = (tokenize_string src58 "tests/nanoisa/fixtures/cut_a_add.nano" diags)
    let p58: Parser = (parse_program toks58 (list_LexerToken_length toks58) "tests/nanoisa/fixtures/cut_a_add.nano")
    let p58b: Parser = (nisa_ingest_imports p58 "tests/nanoisa/fixtures/cut_a_add.nano")
    let tok_mod_fn: ASTFunction = (parser_get_function p58b 0)
    let tok_mod_text: string = (nisa_emit_function p58b tok_mod_fn)
    assert (str_contains tok_mod_text ".function tok_mod 0 0 0 int 1")
    assert (str_contains tok_mod_text "ENUM_VAL 0 19")
    let _r59: int = (nisa_reset)
    let src59: string = (+ "enum Kind { A = 19, B } from \"cut_a_kind_imp.nano\" import ImpKind " (+ "f" "n tok_mod() -> int { return ImpKind.A } shadow tok_mod { assert true }"))
    let toks59: List<LexerToken> = (tokenize_string src59 "tests/nanoisa/fixtures/cut_a_add.nano" diags)
    let p59: Parser = (parse_program toks59 (list_LexerToken_length toks59) "tests/nanoisa/fixtures/cut_a_add.nano")
    let p59b: Parser = (nisa_ingest_imports p59 "tests/nanoisa/fixtures/cut_a_add.nano")
    let tok_mod_fn2: ASTFunction = (parser_get_function p59b 0)
    let tok_mod_text2: string = (nisa_emit_function p59b tok_mod_fn2)
    assert (str_contains tok_mod_text2 "ENUM_VAL 1 19")
}

fn nisa_copy_types(dst: Parser, src: Parser) -> Parser {
    let mut acc: Parser = dst
    let en: int = (parser_get_enum_count src)
    let mut i: int = 0
    while (< i en) {
        let ed: ASTEnum = (parser_get_enum src i)
        if (>= (nisa_enum_index acc ed.name) 0) {
            (print "")
        } else {
            set acc (parser_store_enum acc ed.name ed.variant_count ed.variant_names ed.variant_values ed.line ed.column)
        }
        set i (+ i 1)
    }
    let sn: int = (parser_get_struct_def_count src)
    let mut j: int = 0
    while (< j sn) {
        let sd: ASTStruct = (parser_get_struct_def src j)
        if (>= (nisa_struct_index acc sd.name) 0) {
            (print "")
        } else {
            set acc (parser_store_struct acc sd.name sd.field_count sd.field_names sd.field_types sd.line sd.column)
        }
        set j (+ j 1)
    }
    return acc
}

shadow nisa_copy_types {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = "from \"cut_a_tok_imp.nano\" import ImpTok"
    let toks: List<LexerToken> = (tokenize_string src "tests/nanoisa/fixtures/cut_a_add.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "tests/nanoisa/fixtures/cut_a_add.nano")
    let p2: Parser = (nisa_ingest_imports p "tests/nanoisa/fixtures/cut_a_add.nano")
    let empty_src: string = (+ "f" "n getx() -> int { return 0 } shadow getx { assert true }")
    let empty_toks: List<LexerToken> = (tokenize_string empty_src "t.nano" diags)
    let empty_p: Parser = (parse_program empty_toks (list_LexerToken_length empty_toks) "t.nano")
    let filled: Parser = (nisa_copy_types empty_p p2)
    assert (== (parser_get_struct_def_count filled) 1)
    let sd: ASTStruct = (parser_get_struct_def filled 0)
    assert (== sd.name "ImpTok")
}

fn nisa_emit_imported_functions(parser: Parser) -> string {
    let mut out: string = ""
    let mut p: int = 0
    while (< p (array_length nisa_seen)) {
        if (not nisa_ok) {
            set p (array_length nisa_seen)
        } else {
            let path: string = (at nisa_seen p)
            let diags: List<CompilerDiagnostic> = (diag_list_new)
            let src: string = (read path)
            let toks: List<LexerToken> = (tokenize_string src path diags)
            let ip: Parser = (parse_program toks (list_LexerToken_length toks) path)
            if (parser_has_error ip) {
                let _x: string = (nisa_fail (+ "parse failed " path))
                set p (array_length nisa_seen)
            } else {
                let ip2: Parser = (nisa_copy_types ip parser)
                let nfn: int = (parser_get_function_count ip2)
                let mut fi: int = 0
                while (< fi nfn) {
                    if (not nisa_ok) {
                        set fi nfn
                    } else {
                        let fd: ASTFunction = (parser_get_function ip2 fi)
                        if (< fd.body 0) {
                            (print "")
                        } else {
                            if (>= (nisa_fn_index parser fd.name) 0) {
                                (print "")
                            } else {
                                set out (+ out (nisa_emit_function ip2 fd))
                                set out (+ out "\n")
                            }
                        }
                        set fi (+ fi 1)
                    }
                }
                set p (+ p 1)
            }
        }
    }
    return out
}

shadow nisa_emit_imported_functions {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "from \"cut_a_fn_imp.nano\" import imp_add " (+ "f" "n main() -> int { return (imp_add 40 2) } shadow main { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "tests/nanoisa/fixtures/cut_a_add.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "tests/nanoisa/fixtures/cut_a_add.nano")
    let p2: Parser = (nisa_ingest_imports p "tests/nanoisa/fixtures/cut_a_add.nano")
    assert nisa_ok
    let text: string = (nisa_emit_imported_functions p2)
    assert (str_contains text ".function imp_add 2 2 0 int 1")
    assert (str_contains text "I64_ADD")
}

fn nisa_register_parser_globals(parser: Parser) -> int {
    let n: int = (parser_get_let_count parser)
    let mut i: int = 0
    while (< i n) {
        if (not nisa_ok) {
            set i n
        } else {
            if (nisa_let_is_global parser i) {
                let l: ASTLet = (parser_get_let parser i)
                if (>= (nisa_global_find l.name) 0) {
                    (print "")
                } else {
                    if (not (nisa_type_ok parser l.var_type)) {
                        let _x: string = (nisa_fail (+ "unsupported global type " l.var_type))
                    } else {
                        set nisa_g_names (array_push nisa_g_names l.name)
                        set nisa_g_types (array_push nisa_g_types l.var_type)
                    }
                }
            } else {
                (print "")
            }
            set i (+ i 1)
        }
    }
    return 0
}

shadow nisa_register_parser_globals {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "let mut g: array<string> = [] " (+ "f" "n f() -> int { return 0 } shadow f { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let _r: int = (nisa_register_parser_globals p)
    assert nisa_ok
    assert (== (nisa_global_find "g") 0)
    assert (== (at nisa_g_types 0) "array<string>")
    let _2: int = (nisa_reset)
}

fn nisa_collect_all_globals(parser: Parser) -> int {
    let mut p: int = 0
    while (< p (array_length nisa_seen)) {
        if (not nisa_ok) {
            set p (array_length nisa_seen)
        } else {
            let path: string = (at nisa_seen p)
            let diags: List<CompilerDiagnostic> = (diag_list_new)
            let src: string = (read path)
            let toks: List<LexerToken> = (tokenize_string src path diags)
            let ip: Parser = (parse_program toks (list_LexerToken_length toks) path)
            if (parser_has_error ip) {
                let _x: string = (nisa_fail (+ "parse failed " path))
                set p (array_length nisa_seen)
            } else {
                let _r: int = (nisa_register_parser_globals ip)
                set p (+ p 1)
            }
        }
    }
    if nisa_ok {
        let _r2: int = (nisa_register_parser_globals parser)
        return 0
    } else {
        return 0
    }
}

shadow nisa_collect_all_globals {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "let mut g: array<string> = [] " (+ "f" "n f() -> int { return 0 } shadow f { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let _r: int = (nisa_collect_all_globals p)
    assert nisa_ok
    assert (== (nisa_global_find "g") 0)
    let _2: int = (nisa_reset)
}

fn nisa_emit_init_stores(parser: Parser) -> string {
    let mut out: string = ""
    let n: int = (parser_get_let_count parser)
    let mut i: int = 0
    while (< i n) {
        if (not nisa_ok) {
            set i n
        } else {
            if (nisa_let_is_global parser i) {
                let l: ASTLet = (parser_get_let parser i)
                let gslot: int = (nisa_global_find l.name)
                if (< gslot 0) {
                    (print "")
                } else {
                    let val: string = (nisa_emit_expr parser l.value l.value_type)
                    set out (+ out val)
                    set out (+ out (nisa_line_imm "STORE_GLOBAL" (int_to_string gslot)))
                }
            } else {
                (print "")
            }
            set i (+ i 1)
        }
    }
    return out
}

shadow nisa_emit_init_stores {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "let mut g: array<string> = [] " (+ "f" "n f() -> int { return 0 } shadow f { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let _r: int = (nisa_register_parser_globals p)
    let text: string = (nisa_emit_init_stores p)
    assert (str_contains text "ARR_LITERAL")
    assert (str_contains text "STORE_GLOBAL 0")
    let _2: int = (nisa_reset)
}

fn nisa_emit_init(parser: Parser) -> string {
    if (== (array_length nisa_g_names) 0) {
        return ""
    } else {
        set nisa_names []
        set nisa_types []
        let mut body: string = ""
        let mut p: int = 0
        while (< p (array_length nisa_seen)) {
            if (not nisa_ok) {
                set p (array_length nisa_seen)
            } else {
                let path: string = (at nisa_seen p)
                let diags: List<CompilerDiagnostic> = (diag_list_new)
                let src: string = (read path)
                let toks: List<LexerToken> = (tokenize_string src path diags)
                let ip: Parser = (parse_program toks (list_LexerToken_length toks) path)
                if (parser_has_error ip) {
                    let _x: string = (nisa_fail (+ "parse failed " path))
                    set p (array_length nisa_seen)
                } else {
                    let ip2: Parser = (nisa_copy_types ip parser)
                    set body (+ body (nisa_emit_init_stores ip2))
                    set p (+ p 1)
                }
            }
        }
        if (not nisa_ok) {
            return ""
        } else {
            set body (+ body (nisa_emit_init_stores parser))
            if (not nisa_ok) {
                return ""
            } else {
                set body (+ body (nisa_line "RET"))
                let locals: int = (array_length nisa_names)
                let mut header: string = ".function __init__ 0 "
                set header (+ header (int_to_string locals))
                set header (+ header " 0 void 0\n")
                set nisa_fn_emitted (+ nisa_fn_emitted 1)
                return (+ (+ header body) ".end\n")
            }
        }
    }
}

shadow nisa_emit_init {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "let mut g: array<string> = [] " (+ "f" "n f() -> int { return 0 } shadow f { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let _r: int = (nisa_register_parser_globals p)
    let text: string = (nisa_emit_init p)
    assert (str_contains text ".function __init__ 0 0 0 void 0")
    assert (str_contains text "STORE_GLOBAL 0")
    assert (str_contains text "RET")
    let _2: int = (nisa_reset)
}

pub fn nanoisa_emit_nasm(source: string, file_name: string) -> string {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let toks: List<LexerToken> = (tokenize_string source file_name diags)
    let parser: Parser = (parse_program toks (list_LexerToken_length toks) file_name)
    if (parser_has_error parser) {
        let tok: LexerToken = (parser_current parser)
        let loc: string = (+ (int_to_string tok.line) (+ ":" (int_to_string tok.column)))
        let _bad: string = (nisa_fail (+ "parse failed " (+ loc (+ " " tok.value))))
        return ""
    } else {
        let parser2: Parser = (nisa_ingest_imports parser file_name)
        if (not nisa_ok) {
            return ""
        } else {
            let _g: int = (nisa_collect_all_globals parser2)
            if (not nisa_ok) {
                return ""
            } else {
            let n: int = (parser_get_function_count parser2)
            let mut out: string = ""
            let mut main_idx: int = (- 0 1)
            let mut i: int = 0
            while (< i n) {
                let func: ASTFunction = (parser_get_function parser2 i)
                if (< func.body 0) {
                    (print "")
                } else {
                    if (== func.name "main") {
                        set main_idx nisa_fn_emitted
                    } else {
                        (print "")
                    }
                    set out (+ out (nisa_emit_function parser2 func))
                    set out (+ out "\n")
                }
                set i (+ i 1)
            }
            if (not nisa_ok) {
                return ""
            } else {
                set out (+ out (nisa_emit_imported_functions parser2))
                if (not nisa_ok) {
                    return ""
                } else {
                set out (+ out (nisa_emit_init parser2))
                if (not nisa_ok) {
                    return ""
                } else {
                if (< main_idx 0) {
                    set main_idx nisa_fn_emitted
                    set out (+ out ".function main 0 0 0 int 1\n")
                    set out (+ out (nisa_line "PUSH_I64 0"))
                    set out (+ out (nisa_line "RET"))
                    set out (+ out ".end\n")
                    set nisa_fn_emitted (+ nisa_fn_emitted 1)
                } else {
                    (print "")
                }
                    let mut prelude: string = ".entry "
                    set prelude (+ prelude (int_to_string main_idx))
                    set prelude (+ prelude "\n\n")
                    set prelude (+ prelude (nisa_str_prelude))
                    if (> (array_length nisa_str_names) 0) {
                        set prelude (+ prelude "\n")
                    } else {
                        (print "")
                    }
                    set prelude (+ prelude (nisa_ext_prelude))
                    if (> (array_length nisa_ext_syms) 0) {
                        set prelude (+ prelude ".flag needs_extern\n\n")
                    } else {
                        (print "")
                    }
                    return (+ prelude out)
                }
                }
            }
            }
        }
    }
}

shadow nanoisa_emit_nasm {
    let src: string = (+ (+ "f" "n add(a: int, b: int) -> int { return (+ a b) }\n") (+ "f" "n main() -> int { return (add 40 2) }\nshadow add { assert (== (add 2 3) 5) }\nshadow main { assert (== (main) 42) }\n"))
    let text: string = (nanoisa_emit_nasm src "t.nano")
    assert (str_contains text ".function add")
    assert (str_contains text ".function main")
    assert (str_contains text "TAIL_CALL add")
    assert (str_contains text ".entry")
    let lib: string = (+ "f" "n add(a: int, b: int) -> int { return (+ a b) } shadow add { assert true }")
    let lib_text: string = (nanoisa_emit_nasm lib "t.nano")
    assert (str_contains lib_text ".function add")
    assert (str_contains lib_text ".function main")
    assert (str_contains lib_text "PUSH_I64 0")
    assert nisa_ok
    let gsrc: string = (+ "let mut g: array<string> = [] " (+ "f" "n via_g_len() -> int { return (array_length g) } shadow via_g_len { assert true }"))
    let gtext: string = (nanoisa_emit_nasm gsrc "t.nano")
    assert (str_contains gtext ".function __init__")
    assert (str_contains gtext "STORE_GLOBAL")
    assert (str_contains gtext "LOAD_GLOBAL")
    assert nisa_ok
}
