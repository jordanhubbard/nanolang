    assert (str_contains text "HM_NEW 5 1")
}

fn nisa_emit_array_new(parser: Parser, call: ASTCall) -> string {
    if (== call.arg_count 1) {
        return (+ (nisa_emit_call_args parser call) (+ (nisa_line "POP") (nisa_line_imm "ARR_NEW" "1")))
    } else {
        if (!= call.arg_count 2) {
            return (nisa_fail "array_new needs 1 or 2 arguments")
        } else {
            let a0: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
            let a1: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
            let mut out: string = (nisa_emit_expr parser a0.node_id a0.node_type)
            set nisa_names (array_push nisa_names "__anew_sz__")
            set nisa_types (array_push nisa_types "int")
            let sz_slot: int = (- (array_length nisa_names) 1)
            set out (+ out (nisa_line_imm "STORE_LOCAL" (int_to_string sz_slot)))
            set out (+ out (nisa_emit_expr parser a1.node_id a1.node_type))
            set nisa_names (array_push nisa_names "__anew_fill__")
            set nisa_types (array_push nisa_types "int")
            let fill_slot: int = (- (array_length nisa_names) 1)
            set out (+ out (nisa_line_imm "STORE_LOCAL" (int_to_string fill_slot)))
            set out (+ out (nisa_line_imm "ARR_NEW" "1"))
            set nisa_names (array_push nisa_names "__anew_arr__")
            set nisa_types (array_push nisa_types "array<int>")
            let arr_slot: int = (- (array_length nisa_names) 1)
            set out (+ out (nisa_line_imm "STORE_LOCAL" (int_to_string arr_slot)))
            set out (+ out (nisa_line_imm "PUSH_I64" "0"))
            set nisa_names (array_push nisa_names "__anew_i__")
            set nisa_types (array_push nisa_types "int")
            let i_slot: int = (- (array_length nisa_names) 1)
            set out (+ out (nisa_line_imm "STORE_LOCAL" (int_to_string i_slot)))
            let l_top: string = (nisa_fresh)
            let l_end: string = (nisa_fresh)
            set out (+ out (nisa_label_line l_top))
            set out (+ out (nisa_line_imm "LOAD_LOCAL" (int_to_string i_slot)))
            set out (+ out (nisa_line_imm "LOAD_LOCAL" (int_to_string sz_slot)))
            set out (+ out (nisa_line "LT"))
            set out (+ out (nisa_line_imm "JMP_FALSE" l_end))
            set out (+ out (nisa_line_imm "LOAD_LOCAL" (int_to_string arr_slot)))
            set out (+ out (nisa_line_imm "LOAD_LOCAL" (int_to_string fill_slot)))
            set out (+ out (nisa_line "ARR_PUSH"))
            set out (+ out (nisa_line_imm "STORE_LOCAL" (int_to_string arr_slot)))
            set out (+ out (nisa_line_imm "LOAD_LOCAL" (int_to_string i_slot)))
            set out (+ out (nisa_line_imm "PUSH_I64" "1"))
            set out (+ out (nisa_line "I64_ADD"))
            set out (+ out (nisa_line_imm "STORE_LOCAL" (int_to_string i_slot)))
            set out (+ out (nisa_line_imm "JMP" l_top))
            set out (+ out (nisa_label_line l_end))
            set out (+ out (nisa_line_imm "LOAD_LOCAL" (int_to_string arr_slot)))
            return out
        }
    }
}

