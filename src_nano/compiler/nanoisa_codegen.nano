    assert (str_contains via_az_text "JMP_FALSE")
    let src56: string = (+ "enum Kind { A = 19, B } " (+ "f" "n tag() -> int { return Kind.A } shadow tag { assert true }"))
    let toks56: List<LexerToken> = (tokenize_string src56 "t.nano" diags)
