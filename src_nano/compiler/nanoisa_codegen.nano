fn nisa_emit_union_construct(parser: Parser, node_id: int) -> string {
    let uc: ASTUnionConstruct = (parser_get_union_construct parser node_id)
    let uidx: int = (nisa_union_index parser uc.union_name)
    if (< uidx 0) {
        return (nisa_fail (+ "undefined union " uc.union_name))
    } else {
        let vi: int = (nisa_union_variant_index parser uidx uc.variant_name)
        if (< vi 0) {
            return (nisa_fail (+ "unknown variant " (+ uc.union_name (+ "." uc.variant_name))))
        } else {
            let mut out: string = ""
            let mut i: int = 0
            while (< i uc.field_count) {
                let vid: int = (at uc.field_value_ids i)
                let vty: int = (at uc.field_value_types i)
                let piece: string = (nisa_emit_expr parser vid vty)
                if (not nisa_ok) {
                    return piece
                } else {
                    set out (+ out piece)
                    set i (+ i 1)
                }
            }
            let imm: string = (+ "1 " (+ (int_to_string uidx) (+ " " (+ (int_to_string vi) (+ " " (int_to_string uc.field_count))))))
            return (+ out (nisa_line_imm "AGG_PACK" imm))
        }
    }
}

