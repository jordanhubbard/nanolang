    let toks19: List<LexerToken> = (tokenize_string src19 "t.nano" diags)
    let p19: Parser = (parse_program toks19 (list_LexerToken_length toks19) "t.nano")
    let same_fn: ASTFunction = (parser_get_function p19 0)
    let same_text: string = (nisa_emit_function p19 same_fn)
    assert (str_contains same_text ".function same 2 2 0 bool 1")
    assert (str_contains same_text "EQ")
    let src20: string = (+ "f" "n diff(a: string, b: string) -> bool { return (!= a b) } shadow diff { assert true }")
    let toks20: List<LexerToken> = (tokenize_string src20 "t.nano" diags)
    let p20: Parser = (parse_program toks20 (list_LexerToken_length toks20) "t.nano")
    let diff_fn: ASTFunction = (parser_get_function p20 0)
    let diff_text: string = (nisa_emit_function p20 diff_fn)
    assert (str_contains diff_text ".function diff 2 2 0 bool 1")
    assert (str_contains diff_text "NE")
    let src21: string = (+ "f" "n via_at() -> int { let xs: array<int> = [7, 8] return (at xs 0) } shadow via_at { assert true }")
    let toks21: List<LexerToken> = (tokenize_string src21 "t.nano" diags)
    let p21: Parser = (parse_program toks21 (list_LexerToken_length toks21) "t.nano")
    let at_fn: ASTFunction = (parser_get_function p21 0)
    let at_text: string = (nisa_emit_function p21 at_fn)
    assert (str_contains at_text ".function via_at 0 1 0 int 1")
    assert (str_contains at_text "ARR_GET")
    let src22: string = (+ "f" "n slen(s: string) -> int { return (str_length s) } shadow slen { assert true }")
    let toks22: List<LexerToken> = (tokenize_string src22 "t.nano" diags)
    let p22: Parser = (parse_program toks22 (list_LexerToken_length toks22) "t.nano")
    let slen_fn: ASTFunction = (parser_get_function p22 0)
    let slen_text: string = (nisa_emit_function p22 slen_fn)
    assert (str_contains slen_text ".function slen 1 1 0 int 1")
    assert (str_contains slen_text "STR_LEN")
    let src23: string = (+ "f" "n slice(s: string) -> string { return (str_substring s 0 1) } shadow slice { assert true }")
    let toks23: List<LexerToken> = (tokenize_string src23 "t.nano" diags)
    let p23: Parser = (parse_program toks23 (list_LexerToken_length toks23) "t.nano")
    let slice_fn: ASTFunction = (parser_get_function p23 0)
    let slice_text: string = (nisa_emit_function p23 slice_fn)
    assert (str_contains slice_text ".function slice 1 1 0 string 1")
    assert (str_contains slice_text "STR_SUBSTR")
    let src24: string = (+ "f" "n blank_l() -> int { let xs: List<int> = (list_int_new) return (list_int_length xs) } shadow blank_l { assert true }")
    let toks24: List<LexerToken> = (tokenize_string src24 "t.nano" diags)
    let p24: Parser = (parse_program toks24 (list_LexerToken_length toks24) "t.nano")
    let blank_fn: ASTFunction = (parser_get_function p24 0)
    let blank_text: string = (nisa_emit_function p24 blank_fn)
    assert (str_contains blank_text ".function blank_l 0 1 0 int 1")
    assert (str_contains blank_text "ARR_NEW 1")
    assert (str_contains blank_text "ARR_LEN")
    let src25: string = (+ "f" "n grow_l() -> int { let xs: List<int> = (list_int_new) (list_int_push xs 7) return (list_int_get xs 0) } shadow grow_l { assert true }")
    let toks25: List<LexerToken> = (tokenize_string src25 "t.nano" diags)
    let p25: Parser = (parse_program toks25 (list_LexerToken_length toks25) "t.nano")
    let grow_l_fn: ASTFunction = (parser_get_function p25 0)
    let grow_l_text: string = (nisa_emit_function p25 grow_l_fn)
    assert (str_contains grow_l_text ".function grow_l 0 1 0 int 1")
    assert (str_contains grow_l_text "ARR_PUSH")
    assert (str_contains grow_l_text "POP")
    assert (str_contains grow_l_text "ARR_GET")
    let src26: string = (+ "f" "n ch() -> int { return (char_at \"hi\" 0) } shadow ch { assert true }")
    let toks26: List<LexerToken> = (tokenize_string src26 "t.nano" diags)
    let p26: Parser = (parse_program toks26 (list_LexerToken_length toks26) "t.nano")
    let ch_fn: ASTFunction = (parser_get_function p26 0)
    let ch_text: string = (nisa_emit_function p26 ch_fn)
    assert (str_contains ch_text ".function ch 0 0 0 int 1")
    assert (str_contains ch_text "STR_CHAR_AT")
    let src27: string = (+ "f" "n blank_s() -> int { let xs: List<string> = (list_string_new) return (list_string_length xs) } shadow blank_s { assert true }")
    let toks27: List<LexerToken> = (tokenize_string src27 "t.nano" diags)
    let p27: Parser = (parse_program toks27 (list_LexerToken_length toks27) "t.nano")
    let blank_s_fn: ASTFunction = (parser_get_function p27 0)
    let blank_s_text: string = (nisa_emit_function p27 blank_s_fn)
    assert (str_contains blank_s_text ".function blank_s 0 1 0 int 1")
    assert (str_contains blank_s_text "ARR_NEW 5")
    assert (str_contains blank_s_text "ARR_LEN")
    let src28: string = (+ "f" "n grow_s() -> string { let xs: List<string> = (list_string_new) (list_string_push xs \"hi\") return (list_string_get xs 0) } shadow grow_s { assert true }")
    let toks28: List<LexerToken> = (tokenize_string src28 "t.nano" diags)
    let p28: Parser = (parse_program toks28 (list_LexerToken_length toks28) "t.nano")
    let grow_s_fn: ASTFunction = (parser_get_function p28 0)
    let grow_s_text: string = (nisa_emit_function p28 grow_s_fn)
    assert (str_contains grow_s_text ".function grow_s 0 1 0 string 1")
    assert (str_contains grow_s_text "ARR_PUSH")
    assert (str_contains grow_s_text "ARR_GET")
    let src29: string = (+ "struct Tok { t: int, s: string } " (+ "f" "n get_s() -> string { let p: Tok = Tok { t: 1, s: \"hi\" } return p.s } shadow get_s { assert true }"))
    let toks29: List<LexerToken> = (tokenize_string src29 "t.nano" diags)
    let p29: Parser = (parse_program toks29 (list_LexerToken_length toks29) "t.nano")
    let get_s_fn: ASTFunction = (parser_get_function p29 0)
    let get_s_text: string = (nisa_emit_function p29 get_s_fn)
    assert (str_contains get_s_text ".function get_s 0 1 0 string 1")
    assert (str_contains get_s_text "AGG_PACK")
    assert (str_contains get_s_text "AGG_GET 1")
    let src30: string = (+ "struct Tok { t: int, s: string } " (+ "f" "n grow_t() -> string { let xs: List<Tok> = (list_Tok_new) (list_Tok_push xs Tok { t: 1, s: \"hi\" }) let p: Tok = (list_Tok_get xs 0) return p.s } shadow grow_t { assert true }"))
    let toks30: List<LexerToken> = (tokenize_string src30 "t.nano" diags)
    let p30: Parser = (parse_program toks30 (list_LexerToken_length toks30) "t.nano")
    let grow_t_fn: ASTFunction = (parser_get_function p30 0)
    let grow_t_text: string = (nisa_emit_function p30 grow_t_fn)
    assert (str_contains grow_t_text ".function grow_t 0 2 0 string 1")
    assert (str_contains grow_t_text "ARR_NEW 8")
    assert (str_contains grow_t_text "ARR_PUSH")
    assert (str_contains grow_t_text "POP")
    assert (str_contains grow_t_text "ARR_GET")
    assert (str_contains grow_t_text "AGG_GET 1")
    let src31: string = (+ "struct Tok { t: int, s: string } " (+ "f" "n one_t() -> List<Tok> { let xs: List<Tok> = (list_Tok_new) (list_Tok_push xs Tok { t: 1, s: \"hi\" }) return xs } shadow one_t { assert true }"))
    let toks31: List<LexerToken> = (tokenize_string src31 "t.nano" diags)
    let p31: Parser = (parse_program toks31 (list_LexerToken_length toks31) "t.nano")
    let one_t_fn: ASTFunction = (parser_get_function p31 0)
    let one_t_text: string = (nisa_emit_function p31 one_t_fn)
    assert (str_contains one_t_text ".function one_t 0 1 0 array 1")
}

pub fn nanoisa_emit_nasm(source: string) -> string {
    (mb_reset [])
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let toks: List<LexerToken> = (tokenize_string source "cut_a.nano" diags)
    let parser: Parser = (parse_program toks (list_LexerToken_length toks) "cut_a.nano")
    return (nanoisa_emit_parser_nasm parser)
}

# My caller supplies an already merged and checked parser when using the
# canonical frontend. Both entrypoints share this lowering implementation.
pub fn nanoisa_emit_parser_nasm(parser: Parser) -> string {
    return (nisa_emit_module_nasm parser false)
}

# Program mode retains only executable direct-call dependencies. Full-scope
# shadow execution remains the canonical frontend's responsibility.
pub fn nanoisa_emit_program_nasm(parser: Parser) -> string {
    return (nisa_emit_module_nasm parser true)
}

# I choose synthetic names outside the supplied declaration namespace.
fn nisa_shadow_name(parser: Parser, base: string) -> string {
    let mut name: string = base
    while (>= (nisa_fn_index parser name) 0) { set name (+ name "_") }
    return name
}
shadow nisa_shadow_name {
    let diagnostics: List<CompilerDiagnostic> = (diag_list_new)
    let source: string = (+ "f" "n reserved() -> void {} fn reserved_() -> void {}")
    let tokens: List<LexerToken> = (tokenize_string source "names.nano" diagnostics)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "names.nano")
    assert (== (nisa_shadow_name parser "reserved") "reserved__")
    assert (== (nisa_shadow_name parser "free") "free")
}

# I lower a selected suffix into one module with shared initialized globals.
# My caller retains the binding context and supervises execution separately.
pub fn nanoisa_emit_shadows_nasm(parser: Parser, first_shadow: int) -> string {
    return (nanoisa_emit_shadows_with_facts parser first_shadow [])
}

pub fn nanoisa_emit_shadows_with_facts(parser: Parser, first_shadow: int, facts: array<ModuleIntrospection>) -> string {
    let _: int = (nisa_reset)
    if (not (nisa_set_module_facts facts)) { return "" }
    set nisa_program_mode true
    let count: int = parser.shadows_count
    if (or (< first_shadow 0) (> first_shadow count)) {
        return (nisa_fail "I require a valid first-shadow index")
    }
    if (parser_has_error parser) { return (nisa_fail "parse failed") }
    let initializers: string = (nisa_emit_globals parser)
    if (not nisa_ok) { return "" }
    let entry_name: string = (nisa_shadow_name parser "__nanoisa_shadow_entry")
    let mut entry_body: string = ""
    let mut out: string = ""
    let mut i: int = first_shadow
    while (< i count) {
        let selected: ASTShadow = (list_ASTShadow_get parser.shadows i)
        let name: string = (nisa_shadow_name parser (+ "__nanoisa_shadow_" (int_to_string i)))
        let function: ASTFunction = ASTFunction {
            node_type: ParseNodeType.PNODE_FUNCTION, line: selected.line, column: selected.column,
            name: name, param_start: 0, param_count: 0, return_type: "void",
            body: selected.body, is_pure: false
        }
        set out (+ out (nisa_emit_function parser function))
        if (not nisa_ok) {
            set nisa_err (+ (+ "I cannot lower shadow " selected.target_name)
                (+ (+ " at merged line " (int_to_string selected.line)) (+ ": " nisa_err)))
            return ""
        }
        set entry_body (+ entry_body (nisa_line_imm "CALL" name))
        set i (+ i 1)
    }
    let entry_index: int = (- count first_shadow)
    set out (+ out (+ ".function " (+ entry_name " 0 0 0 int 1\n")))
    set out (+ out (+ entry_body "  PUSH_I64 0\n  RET\n.end\n"))
    set i 0
    while (< i (array_length nisa_function_queue)) {
        let function: ASTFunction = (parser_get_function parser (at nisa_function_queue i))
        if (< function.body 0) { let _: int = (nisa_register_extern parser function) }
        else { set out (+ out (nisa_emit_function parser function)) }
        set i (+ i 1)
    }
    set out (+ out initializers)
    if (not nisa_ok) { return "" }
    let mut prelude: string = (+ ".types " (int_to_string (parser_get_struct_def_count parser)))
    set prelude (+ prelude (+ " " (int_to_string (parser_get_enum_count parser))))
    set prelude (+ prelude (+ " " (int_to_string (parser_get_union_count parser))))
    set prelude (+ prelude (+ "\n.entry " (int_to_string entry_index)))
    set prelude (+ prelude (+ "\n\n" nisa_import_text))
    set prelude (+ prelude (nisa_str_prelude))
    return (+ prelude out)
}
shadow nanoisa_emit_shadows_nasm {
    let diagnostics: List<CompilerDiagnostic> = (diag_list_new)
    let source: string = (+ "f" "n main() -> int { return 7 } shadow main { assert (== (main) 7) } shadow main { assert false }")
    let tokens: List<LexerToken> = (tokenize_string source "shadows.nano" diagnostics)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "shadows.nano")
    let assembly: string = (nanoisa_emit_shadows_nasm parser 0)
    assert (str_contains assembly ".entry 2")
    assert (str_contains assembly ".function main")
    assert (str_contains assembly "CALL __nanoisa_shadow_0")
    assert (str_contains assembly "CALL __nanoisa_shadow_1")
    assert (== (nanoisa_emit_shadows_nasm parser (- 0 1)) "")
    assert (== (nanoisa_emit_shadows_nasm parser 3) "")
    let empty: string = (nanoisa_emit_shadows_nasm parser 2)
    assert (str_contains empty ".entry 0")
    assert (not (str_contains empty ".function main"))
}

fn nisa_emit_module_nasm(parser: Parser, program: bool) -> string {
    return (nisa_emit_module_with_facts parser program [])
}

fn nisa_emit_module_with_facts(parser: Parser, program: bool, facts: array<ModuleIntrospection>) -> string {
    let _: int = (nisa_reset)
    if (not (nisa_set_module_facts facts)) { return "" }
    set nisa_program_mode program
    if program {
        let entry: int = (nisa_fn_index parser "main")
        if (< entry 0) { return (nisa_fail "no main") }
        (nisa_require_function entry)
    }
    if (parser_has_error parser) {
        let bad: string = (nisa_fail "parse failed")
        return bad
    } else {
        let n: int = (parser_get_function_count parser)
        let mut declaration_index: int = 0
        while (< declaration_index n) {
            let declaration: ASTFunction = (parser_get_function parser declaration_index)
            if (or (not program) (nisa_metadata_function declaration)) {
                if (< declaration.body 0) {
                    let imported: int = (nisa_register_extern parser declaration)
                }
            }
            set declaration_index (+ declaration_index 1)
        }
        let initializers: string = (nisa_emit_globals parser)
        let mut out: string = ""
        let mut main_idx: int = (- 0 1)
        let mut emitted: int = 0
        let mut i: int = 0
        while (or (and (not program) (< i n)) (and program (< i (array_length nisa_function_queue)))) {
            let mut function_index: int = i
            if program { set function_index (at nisa_function_queue i) }
            let func: ASTFunction = (parser_get_function parser function_index)
            if (< func.body 0) {
                if program { let _: int = (nisa_register_extern parser func) }
            } else {
                if (== func.name "main") {
                    set main_idx emitted
                } else {
                    (print "")
                }
                set out (+ out (nisa_emit_function parser func))
                set out (+ out "\n")
                set emitted (+ emitted 1)
            }
            set i (+ i 1)
        }
        set out (+ out initializers)
        if (< main_idx 0) {
            let missing: string = (nisa_fail "no main")
            return missing
        } else {
            if (not nisa_ok) {
                return ""
            } else {
                let mut prelude: string = (+ ".types " (int_to_string (parser_get_struct_def_count parser)))
                set prelude (+ prelude (+ " " (int_to_string (parser_get_enum_count parser))))
                set prelude (+ prelude (+ " " (int_to_string (parser_get_union_count parser))))
                set prelude (+ prelude "\n.entry ")
                set prelude (+ prelude (int_to_string main_idx))
                set prelude (+ prelude "\n\n")
                set prelude (+ prelude nisa_import_text)
                set prelude (+ prelude (nisa_str_prelude))
                if (> (array_length nisa_str_names) 0) {
                    set prelude (+ prelude "\n")
                } else {
                    (print "")
                }
                return (+ prelude out)
            }
        }
    }
}

shadow nanoisa_emit_nasm {
    let src: string = (+ (+ "f" "n add(a: int, b: int) -> int { return (+ a b) }\n") (+ "f" "n main() -> int { return (add 40 2) }\nshadow add { assert (== (add 2 3) 5) }\nshadow main { assert (== (main) 42) }\n"))
    let text: string = (nanoisa_emit_nasm src)
    assert (str_contains text ".function add")
    assert (str_contains text ".function main")
    assert (str_contains text "TAIL_CALL add")
    assert (str_contains text ".entry")
}

shadow nanoisa_emit_parser_nasm {
    let source: string = (+ "f" "n main() -> int { return 42 }")
    let diagnostics: List<CompilerDiagnostic> = (diag_list_new)
    let tokens: List<LexerToken> = (tokenize_string source "entry.nano" diagnostics)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "entry.nano")
    let raw: string = (nanoisa_emit_nasm source)
    assert (== (nanoisa_emit_parser_nasm parser) raw)
    let with_host: string = (+ "f" "n main() -> string { return (getenv \"ENTRY_TEST\") }")
    let host_text: string = (nanoisa_emit_nasm with_host)
    assert (str_contains host_text "vm_getenv")
    assert (== (nanoisa_emit_parser_nasm parser) raw)
}

shadow nanoisa_emit_parser_nasm {
    let source: string = (+ "f" "n bound_answer() -> int { return 42 } fn main() -> int { return (answer) }")
    let diagnostics: List<CompilerDiagnostic> = (diag_list_new)
    let tokens: List<LexerToken> = (tokenize_string source "bound.nano" diagnostics)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "bound.nano")
    (mb_reset [1])
    (mb_add 0 "answer" "bound_answer")
    let assembly: string = (nanoisa_emit_parser_nasm parser)
    assert (str_contains assembly "TAIL_CALL bound_answer")
    let raw: string = (nanoisa_emit_nasm (+ "f" "n answer() -> int { return 7 } fn main() -> int { return (answer) }"))
    assert (str_contains raw "TAIL_CALL answer")
    assert (not (mb_active))
}

shadow nisa_emit_module_nasm {
    let diagnostics: List<CompilerDiagnostic> = (diag_list_new)
    let source: string = (+ "f" "n unused() -> int { return 9 } fn main() -> int { return 0 }")
    let tokens: List<LexerToken> = (tokenize_string source "program.nano" diagnostics)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "program.nano")
    assert (str_starts_with (nisa_emit_module_nasm parser false) ".types 0 0 0\n.entry ")
    assert (str_contains (nisa_emit_module_nasm parser false) ".function unused")
    assert (not (str_contains (nisa_emit_module_nasm parser true) ".function unused"))
}
shadow nanoisa_emit_program_nasm {
    let diagnostics: List<CompilerDiagnostic> = (diag_list_new)
    let source: string = (+ "extern f" "n unused_host() -> array<string> fn helper() -> int { return 42 } fn main() -> int { return (helper) }")
    let tokens: List<LexerToken> = (tokenize_string source "program.nano" diagnostics)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "program.nano")
    let output: string = (nanoisa_emit_program_nasm parser)
    assert (str_contains output ".function helper")
    assert (str_contains output "TAIL_CALL helper")
    assert (not (str_contains output "unused_host"))
    assert (== (nanoisa_emit_parser_nasm parser) "")
}

shadow nanoisa_emit_nasm {
    let source: string = (+ "struct Item { value: int } f" "n main() -> int { let mut item: Item = Item { value: 1 } set item.value 2 return 0 }")
    assert (== (nanoisa_emit_nasm source) "")
    assert (str_contains (nanoisa_last_lowering_error) "reference IR")
    let control: string = (+ "f" "n main() -> int { let mut value: int = 1 set value 2 return value }")
    assert (str_contains (nanoisa_emit_nasm control) "STORE_LOCAL")
}


fn nisa_set_module_facts(facts: array<ModuleIntrospection>) -> bool {
    let mut i: int = 0
    while (< i (array_length facts)) {
        let info: ModuleIntrospection = (at facts i)
        if (or (not info.ok) (not (mi_identifier info.name))) {
            let rejected: string = (nisa_fail "I require valid retained module facts")
            return false
        }
        let mut j: int = 0
        while (< j i) {
            if (== (at facts j).name info.name) {
                let rejected: string = (nisa_fail (+ "I reject ambiguous module introspection identity: " info.name))
                return false
            }
            set j (+ j 1)
        }
        set i (+ i 1)
    }
    set nisa_module_facts facts
    return true
}
shadow nisa_set_module_facts {
    let reset: int = (nisa_reset)
    let info: ModuleIntrospection = (mi_scan "module probe" "probe.nano" "probe")
    assert (nisa_set_module_facts [info])
    assert (not (nisa_set_module_facts [info, info]))
    let reset_again: int = (nisa_reset)
}

pub fn nanoisa_emit_program_with_facts(parser: Parser, facts: array<ModuleIntrospection>) -> string {
    return (nisa_emit_module_with_facts parser true facts)
}
shadow nanoisa_emit_program_with_facts {
    let tokens: List<LexerToken> = (tokenize_string "fn main() -> int { return 0 }" "facts.nano" (diag_list_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "facts.nano")
    assert (str_contains (nanoisa_emit_program_with_facts parser []) ".function main")
}
shadow nanoisa_emit_shadows_with_facts {
    let tokens: List<LexerToken> = (tokenize_string "fn main() -> int { return 0 } shadow main { assert true }" "facts.nano" (diag_list_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "facts.nano")
    assert (str_contains (nanoisa_emit_shadows_with_facts parser 0 []) "__nanoisa_shadow_entry")
}
shadow nisa_emit_module_with_facts {
    let tokens: List<LexerToken> = (tokenize_string "fn main() -> int { return 0 }" "facts.nano" (diag_list_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "facts.nano")
    assert (str_contains (nisa_emit_module_with_facts parser true []) ".function main")
}
