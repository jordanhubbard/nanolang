fn nisa_mqc_callee(parser: Parser, mqc: ASTModuleQualifiedCall) -> string {
    let q: string = (nisa_mqc_qualified mqc)
    if (nisa_fn_defined parser q) {
        return q
    } else {
        let u: string = (nisa_mqc_unqualified mqc)
        if (nisa_fn_defined parser u) {
            return u
        } else {
            if (nisa_is_host_call parser u) {
                return u
            } else {
                if (nisa_is_host_call parser q) {
                    return q
                } else {
                    return ""
                }
            }
        }
    }
}

shadow nisa_mqc_callee {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "import \"cut_a_fn_imp.nano\" as ImpMod " (+ "f" "n via_q_add() -> int { return (ImpMod.imp_add 40 2) } shadow via_q_add { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "tests/nanoisa/fixtures/cut_a_add.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "tests/nanoisa/fixtures/cut_a_add.nano")
    let p2: Parser = (nisa_ingest_imports p "tests/nanoisa/fixtures/cut_a_add.nano")
    assert nisa_ok
    let func: ASTFunction = (parser_get_function p2 0)
    let block: ASTBlock = (parser_get_block p2 func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 0)
    let r: ASTReturn = (parser_get_return p2 stmt.node_id)
    let mqc: ASTModuleQualifiedCall = (parser_get_module_qualified_call p2 r.value)
    assert (== (nisa_mqc_callee p2 mqc) "imp_add")
    let _2: int = (nisa_reset)
}

fn nisa_emit_mqc_args(parser: Parser, mqc: ASTModuleQualifiedCall) -> string {
    let mut args: string = ""
    let mut i: int = 0
    while (< i mqc.arg_count) {
        let a: ASTStmtRef = (parser_get_call_arg parser (+ mqc.arg_start i))
        set args (+ args (nisa_emit_expr parser a.node_id a.node_type))
        set i (+ i 1)
    }
    return args
}

shadow nisa_emit_mqc_args {
    assert true
}

fn nisa_emit_mqc(parser: Parser, node_id: int) -> string {
    let mqc: ASTModuleQualifiedCall = (parser_get_module_qualified_call parser node_id)
    let callee: string = (nisa_mqc_callee parser mqc)
    if (== callee "") {
        return (nisa_fail (+ "undefined module function " (nisa_mqc_qualified mqc)))
    } else {
        if (nisa_is_host_call parser callee) {
            return (nisa_fail (+ "host module call is not in the pinned subset " callee))
        } else {
            let bad: string = (nisa_check_arity parser callee mqc.arg_count)
            if (not nisa_ok) {
                return bad
            } else {
            return (+ (nisa_emit_mqc_args parser mqc) (nisa_line_imm "CALL" callee))
            }
        }
    }
}

