    let src55: string = (+ (+ "f" "n in_az(c: int) -> bool { return (and (>= c 65) (<= c 90)) } ") (+ "f" "n via_az() -> int { if (in_az 65) { return 1 } else { return 0 } } shadow in_az { assert true } shadow via_az { assert true }"))
    let toks55: List<LexerToken> = (tokenize_string src55 "t.nano" diags)
    let p55: Parser = (parse_program toks55 (list_LexerToken_length toks55) "t.nano")
