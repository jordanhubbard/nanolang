fn nisa_emit_field_access(parser: Parser, node_id: int) -> string {
    let fa: ASTFieldAccess = (parser_get_field_access parser node_id)
    if (!= fa.object_type ParseNodeType.PNODE_IDENTIFIER) {
        let obj: string = (nisa_emit_expr parser fa.object fa.object_type)
        if (not nisa_ok) {
            return obj
        } else {
            let ty: string = (nisa_expr_struct_type parser fa.object fa.object_type)
            let mut fi: int = (nisa_struct_field_index parser ty fa.field_name)
            if (< fi 0) {
                set fi (nisa_any_struct_field_index parser fa.field_name)
            } else {
                (print "")
            }
            if (< fi 0) {
                set fi (nisa_union_field_index parser fa.field_name)
            } else {
                (print "")
            }
            if (< fi 0) {
                return (nisa_fail "record field access needs a local")
            } else {
                return (+ obj (nisa_line_imm "AGG_GET" (int_to_string fi)))
            }
        }
    } else {
        let id: ASTIdentifier = (parser_get_identifier parser fa.object)
        let eidx: int = (nisa_enum_index parser id.name)
        if (>= eidx 0) {
            let ed: ASTEnum = (nisa_enum_def parser eidx)
            let mut vi: int = (- 0 1)
            let mut i: int = 0
            while (< i ed.variant_count) {
                if (== (at ed.variant_names i) fa.field_name) {
                    set vi i
                } else {
                    (print "")
                }
                set i (+ i 1)
            }
            if (< vi 0) {
                return (nisa_fail (+ "unknown enum variant " fa.field_name))
            } else {
                let val: int = (at ed.variant_values vi)
                return (nisa_line_imm "ENUM_VAL" (+ (int_to_string eidx) (+ " " (int_to_string val))))
            }
        } else {
            let slot: int = (nisa_local_find id.name)
            if (< slot 0) {
                return (nisa_fail (+ "undefined local " id.name))
            } else {
                if (>= slot (array_length nisa_types)) {
                    return (nisa_fail (+ "untyped local " id.name))
                } else {
                    let ty: string = (at nisa_types slot)
                    let sidx: int = (nisa_struct_index parser ty)
                    if (< sidx 0) {
                        let sfi: int = (nisa_any_struct_field_index parser fa.field_name)
                        if (>= sfi 0) {
                            let obj: string = (nisa_emit_expr parser fa.object fa.object_type)
                            return (+ obj (nisa_line_imm "AGG_GET" (int_to_string sfi)))
                        } else {
                            let fi: int = (nisa_union_field_index parser fa.field_name)
                            if (< fi 0) {
                                return (nisa_fail (+ "not a record local " id.name))
                            } else {
                                let obj: string = (nisa_emit_expr parser fa.object fa.object_type)
                                return (+ obj (nisa_line_imm "AGG_GET" (int_to_string fi)))
                            }
                        }
                    } else {
                        let sd: ASTStruct = (parser_get_struct_def parser sidx)
                        let mut fi: int = (- 0 1)
                        let mut j: int = 0
                        while (< j sd.field_count) {
                            if (== (at sd.field_names j) fa.field_name) {
                                set fi j
                            } else {
                                (print "")
                            }
                            set j (+ j 1)
                        }
                        if (< fi 0) {
                            return (nisa_fail (+ "unknown field " fa.field_name))
                        } else {
                            let obj: string = (nisa_emit_expr parser fa.object fa.object_type)
                            return (+ obj (nisa_line_imm "AGG_GET" (int_to_string fi)))
                        }
                    }
                }
            }
        }
    }
}

shadow nisa_emit_field_access {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "struct Point { x: int, y: int } " (+ "f" "n getx() -> int { let p: Point = Point { x: 3, y: 4 } return p.x } shadow getx { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    set nisa_names (array_push nisa_names "p")
    set nisa_types (array_push nisa_types "Point")
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 1)
    let r: ASTReturn = (parser_get_return p stmt.node_id)
    let text: string = (nisa_emit_field_access p r.value)
    assert (str_contains text "LOAD_LOCAL 0")
    assert (str_contains text "AGG_GET 0")
    let _r: int = (nisa_reset)
    let src2: string = (+ "struct Tok { t: int, s: string } " (+ "f" "n get_s() -> string { let p: Tok = Tok { t: 1, s: \"hi\" } return p.s } shadow get_s { assert true }"))
    let toks2: List<LexerToken> = (tokenize_string src2 "t.nano" diags)
    let p2: Parser = (parse_program toks2 (list_LexerToken_length toks2) "t.nano")
    let func2: ASTFunction = (parser_get_function p2 0)
    set nisa_names (array_push nisa_names "p")
    set nisa_types (array_push nisa_types "Tok")
    let block2: ASTBlock = (parser_get_block p2 func2.body)
    let stmt2: ASTStmtRef = (list_ASTStmtRef_get block2.statements 1)
    let r2: ASTReturn = (parser_get_return p2 stmt2.node_id)
    let text2: string = (nisa_emit_field_access p2 r2.value)
    assert (str_contains text2 "LOAD_LOCAL 0")
    assert (str_contains text2 "AGG_GET 1")
    let _2: int = (nisa_reset)
    let src3: string = (+ "enum Kind { A = 19, B } " (+ "f" "n tag() -> int { return Kind.A } shadow tag { assert true }"))
    let toks3: List<LexerToken> = (tokenize_string src3 "t.nano" diags)
    let p3: Parser = (parse_program toks3 (list_LexerToken_length toks3) "t.nano")
    let func3: ASTFunction = (parser_get_function p3 0)
    let block3: ASTBlock = (parser_get_block p3 func3.body)
    let stmt3: ASTStmtRef = (list_ASTStmtRef_get block3.statements 0)
    let r3: ASTReturn = (parser_get_return p3 stmt3.node_id)
    let text3: string = (nisa_emit_field_access p3 r3.value)
    assert (str_contains text3 "ENUM_VAL 0 19")
    let _3: int = (nisa_reset)
    let src4: string = (+ "struct Loc { file: string, line: int } struct Nest { inner: Loc, tag: int } " (+ (+ "f" "n nest_d() -> Nest { return Nest { inner: Loc { file: \"f\", line: 7 }, tag: 1 } } ") (+ "f" "n nest_line() -> int { return (nest_d).inner.line } shadow nest_d { assert true } shadow nest_line { assert true }")))
    let toks4: List<LexerToken> = (tokenize_string src4 "t.nano" diags)
    let p4: Parser = (parse_program toks4 (list_LexerToken_length toks4) "t.nano")
    let func4: ASTFunction = (parser_get_function p4 1)
    let block4: ASTBlock = (parser_get_block p4 func4.body)
    let stmt4: ASTStmtRef = (list_ASTStmtRef_get block4.statements 0)
    let r4: ASTReturn = (parser_get_return p4 stmt4.node_id)
    let text4: string = (nisa_emit_field_access p4 r4.value)
    assert (str_contains text4 "CALL nest_d")
    assert (str_contains text4 "AGG_GET 0")
    assert (str_contains text4 "AGG_GET 1")
    let _4: int = (nisa_reset)
    let src5: string = (+ "struct ChainInner { path: string, lineno: int } struct ChainOut { inner: ChainInner, flag: int } union ChainBox { Packed { output: ChainOut }, Miss { note: string } } " (+ (+ "f" "n origin_chain() -> ChainBox { return ChainBox.Packed { output: ChainOut { inner: ChainInner { path: \"f\", lineno: 7 }, flag: 1 } } } shadow origin_chain { assert true } ") (+ "f" "n via_chain() -> int { let b: ChainBox = (origin_chain) match b { Packed(w) => { return w.output.inner.lineno } Miss(e) => { return 0 } } } shadow via_chain { assert true }")))
    let toks5: List<LexerToken> = (tokenize_string src5 "t.nano" diags)
    let p5: Parser = (parse_program toks5 (list_LexerToken_length toks5) "t.nano")
    let func5: ASTFunction = (parser_get_function p5 1)
    let text5: string = (nisa_emit_function p5 func5)
    assert (str_contains text5 "AGG_GET 0")
    assert (str_contains text5 "AGG_GET 1")
    assert (not (str_contains text5 "record field access needs a local"))
    let _5: int = (nisa_reset)
}

fn nisa_emit_hm_call(parser: Parser, call: ASTCall) -> string {
    let func_id: ASTIdentifier = (parser_get_identifier parser call.function)
    if (or (== func_id.name "map_new") (== func_id.name "hashmap_new")) {
        if (!= call.arg_count 0) {
            return (nisa_fail "map_new needs 0 arguments")
        } else {
            return (nisa_line_imm "HM_NEW" "5 1")
        }
    } else {
        if (or (== func_id.name "map_has") (== func_id.name "hashmap_has")) {
            if (!= call.arg_count 2) {
                return (nisa_fail "map_has needs 2 arguments")
            } else {
                return (+ (nisa_emit_call_args parser call) (nisa_line "HM_HAS"))
            }
        } else {
            if (or (== func_id.name "map_get") (== func_id.name "hashmap_get")) {
                if (!= call.arg_count 2) {
                    return (nisa_fail "map_get needs 2 arguments")
                } else {
                    return (+ (nisa_emit_call_args parser call) (nisa_line "HM_GET"))
                }
            } else {
                if (nisa_is_hm_void_call func_id.name) {
                    if (!= call.arg_count 3) {
                        return (nisa_fail "map_put needs 3 arguments")
                    } else {
                        return (+ (nisa_emit_call_args parser call) (+ (nisa_line "HM_SET") (nisa_line "POP")))
                    }
                } else {
                    return (nisa_fail (+ "unsupported hashmap call " func_id.name))
                }
            }
        }
    }
}

