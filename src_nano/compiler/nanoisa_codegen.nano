    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (== (nisa_union_index p "ResultI") 0)
    assert (== (nisa_union_index p "Nope") (- 0 1))
    let _2: int = (nisa_reset)
}

fn nisa_union_variant_index(parser: Parser, uidx: int, vname: string) -> int {
    let u: ASTUnion = (parser_get_union parser uidx)
    let mut i: int = 0
    while (< i u.variant_count) {
        if (== (at u.variant_names i) vname) {
            return i
        } else {
            set i (+ i 1)
        }
    }
    return (- 0 1)
}

shadow nisa_union_variant_index {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "union ResultI { Ok { value: int }, Err { error: string } } " (+ "f" "n via_ok() -> ResultI { return ResultI.Ok { value: 42 } } shadow via_ok { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (== (nisa_union_variant_index p 0 "Ok") 0)
    assert (== (nisa_union_variant_index p 0 "Err") 1)
    assert (== (nisa_union_variant_index p 0 "Nope") (- 0 1))
    let _2: int = (nisa_reset)
}

fn nisa_union_field_index(parser: Parser, field: string) -> int {
    let n: int = (parser_get_union_count parser)
    let mut ui: int = 0
    while (< ui n) {
        let u: ASTUnion = (parser_get_union parser ui)
        let mut off: int = 0
        let mut vi: int = 0
        while (< vi u.variant_count) {
            let fc: int = (at u.variant_field_counts vi)
            let mut fi: int = 0
            while (< fi fc) {
                if (== (at u.variant_field_names (+ off fi)) field) {
                    return fi
                } else {
                    set fi (+ fi 1)
                }
            }
            set off (+ off fc)
            set vi (+ vi 1)
        }
        set ui (+ ui 1)
    }
    return (- 0 1)
}

shadow nisa_union_field_index {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "union ResultI { Ok { value: int }, Err { error: string } } " (+ "f" "n via_ok() -> ResultI { return ResultI.Ok { value: 42 } } shadow via_ok { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (== (nisa_union_field_index p "value") 0)
    assert (== (nisa_union_field_index p "error") 0)
    assert (== (nisa_union_field_index p "Nope") (- 0 1))
    let _2: int = (nisa_reset)
}

fn nisa_union_named_field_type(parser: Parser, uidx: int, field: string) -> string {
    let u: ASTUnion = (parser_get_union parser uidx)
    let mut off: int = 0
    let mut vi: int = 0
    while (< vi u.variant_count) {
        let fc: int = (at u.variant_field_counts vi)
        let mut fi: int = 0
        while (< fi fc) {
            if (== (at u.variant_field_names (+ off fi)) field) {
                return (at u.variant_field_types (+ off fi))
            } else {
                set fi (+ fi 1)
            }
        }
        set off (+ off fc)
        set vi (+ vi 1)
    }
    return ""
}

shadow nisa_union_named_field_type {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "union ResultI { Ok { value: int }, Err { error: string } } " (+ "f" "n via_ok() -> ResultI { return ResultI.Ok { value: 42 } } shadow via_ok { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (== (nisa_union_named_field_type p 0 "value") "int")
    assert (== (nisa_union_named_field_type p 0 "error") "string")
    assert (== (nisa_union_named_field_type p 0 "Nope") "")
    let _2: int = (nisa_reset)
}

fn nisa_is_leaf_record(parser: Parser, name: string) -> bool {
    let idx: int = (nisa_struct_index parser name)
    if (< idx 0) {
        return false
    } else {
        let s: ASTStruct = (parser_get_struct_def parser idx)
        let mut i: int = 0
        while (< i s.field_count) {
            let ft: string = (at s.field_types i)
            if (and (!= ft "int") (and (!= ft "string") (and (!= ft "bool") (!= ft "float")))) {
                return false
            } else {
                set i (+ i 1)
            }
        }
        return true
    }
}

shadow nisa_is_leaf_record {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "struct Loc { file: string, line: int } struct Flag { ok: bool } struct VecF { x: float, y: float } struct Diag { code: string, location: Loc } " (+ "f" "n getx() -> int { return 0 } shadow getx { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (nisa_is_leaf_record p "Loc")
    assert (nisa_is_leaf_record p "Flag")
    assert (nisa_is_leaf_record p "VecF")
    assert (not (nisa_is_leaf_record p "Diag"))
    assert (not (nisa_is_leaf_record p "Nope"))
}

fn nisa_is_int_record(parser: Parser, name: string) -> bool {
    let idx: int = (nisa_struct_index parser name)
    if (< idx 0) {
        return false
    } else {
        let s: ASTStruct = (parser_get_struct_def parser idx)
        let mut i: int = 0
        while (< i s.field_count) {
            if (!= (at s.field_types i) "int") {
                return false
            } else {
                set i (+ i 1)
            }
        }
        return true
    }
}

shadow nisa_is_int_record {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "struct Point { x: int, y: int } " (+ "f" "n getx() -> int { return 0 } shadow getx { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (nisa_is_int_record p "Point")
    assert (not (nisa_is_int_record p "Nope"))
}

fn nisa_is_pin_record(parser: Parser, name: string) -> bool {
    let idx: int = (nisa_struct_index parser name)
    if (< idx 0) {
        return false
    } else {
        let s: ASTStruct = (parser_get_struct_def parser idx)
        let mut i: int = 0
        while (< i s.field_count) {
            let ft: string = (at s.field_types i)
            if (or (== ft "int") (or (== ft "string") (or (== ft "bool") (== ft "float")))) {
                set i (+ i 1)
            } else {
                if (or (nisa_local_type_ok ft) (nisa_is_hm_type ft)) {
                    set i (+ i 1)
                } else {
                    if (nisa_is_leaf_record parser ft) {
                        set i (+ i 1)
                    } else {
                        if (nisa_is_pin_record parser ft) {
                            set i (+ i 1)
                        } else {
                            let inner: string = (nisa_seq_inner ft)
                            if (and (!= inner "") (nisa_is_pin_record parser inner)) {
                                set i (+ i 1)
                            } else {
                                return false
                            }
                        }
                    }
                }
            }
        }
        return true
    }
}

shadow nisa_is_pin_record {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "struct Point { x: int, y: int } struct Tok { t: int, s: string } struct Loc { file: string, line: int } struct Diag { code: string, location: Loc } struct Flag { ok: bool } struct VecF { x: float, y: float } struct Bag { xs: List<int> } struct FlagBag { flags: array<bool>, name: string } struct TypeRec { kind: int, name: string } struct Sym { name: string, ty: TypeRec, args: array<TypeRec> } struct BagHM { m: HashMap<string, int>, n: int } " (+ "f" "n getx() -> int { return 0 } shadow getx { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (nisa_is_pin_record p "Point")
    assert (nisa_is_pin_record p "Tok")
    assert (nisa_is_pin_record p "Loc")
    assert (nisa_is_pin_record p "Diag")
    assert (nisa_is_pin_record p "Flag")
    assert (nisa_is_pin_record p "VecF")
    assert (nisa_is_pin_record p "Bag")
    assert (nisa_is_pin_record p "FlagBag")
    assert (nisa_is_pin_record p "TypeRec")
    assert (nisa_is_pin_record p "Sym")
    assert (nisa_is_pin_record p "BagHM")
    assert (not (nisa_is_pin_record p "Nope"))
    assert (not (nisa_is_int_record p "Tok"))
}

fn nisa_list_inner(t: string) -> string {
    if (and (str_starts_with t "List<") (str_ends_with t ">")) {
        let n: int = (str_length t)
        return (str_substring t 5 (- n 6))
    } else {
        return ""
    }
}

shadow nisa_list_inner {
    assert (== (nisa_list_inner "List<Tok>") "Tok")
    assert (== (nisa_list_inner "List<int>") "int")
    assert (== (nisa_list_inner "int") "")
}

fn nisa_array_inner(t: string) -> string {
    if (and (str_starts_with t "array<") (str_ends_with t ">")) {
        let n: int = (str_length t)
        return (str_substring t 6 (- n 7))
    } else {
        return ""
    }
}

shadow nisa_array_inner {
    assert (== (nisa_array_inner "array<Loc>") "Loc")
    assert (== (nisa_array_inner "array<int>") "int")
    assert (== (nisa_array_inner "List<Loc>") "")
    assert (== (nisa_array_inner "Loc") "")
}

fn nisa_seq_inner(t: string) -> string {
    let list_i: string = (nisa_list_inner t)
    if (!= list_i "") {
        return list_i
    } else {
        return (nisa_array_inner t)
    }
}

shadow nisa_seq_inner {
    assert (== (nisa_seq_inner "List<Tok>") "Tok")
    assert (== (nisa_seq_inner "array<Loc>") "Loc")
    assert (== (nisa_seq_inner "int") "")
}

fn nisa_type_ok(parser: Parser, t: string) -> bool {
    if (nisa_local_type_ok t) {
        return true
    } else {
        if (nisa_is_pin_record parser t) {
            return true
        } else {
            if (>= (nisa_union_index parser t) 0) {
                return true
            } else {
                let inner: string = (nisa_seq_inner t)
                if (== inner "") {
                    return (nisa_is_hm_type t)
                } else {
                    return (nisa_is_pin_record parser inner)
                }
            }
        }
    }
}

shadow nisa_type_ok {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "struct Point { x: int, y: int } struct Tok { t: int, s: string } struct FlagBag { flags: array<bool>, name: string } struct TypeRec { kind: int, name: string } struct Sym { name: string, ty: TypeRec, args: array<TypeRec> } union ResultI { Ok { value: int }, Err { error: string } } " (+ "f" "n getx() -> int { return 0 } shadow getx { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (nisa_type_ok p "int")
    assert (nisa_type_ok p "float")
    assert (nisa_type_ok p "Point")
    assert (nisa_type_ok p "Tok")
    assert (nisa_type_ok p "List<Tok>")
    assert (nisa_type_ok p "array<string>")
    assert (nisa_type_ok p "array<bool>")
    assert (nisa_type_ok p "List<string>")
    assert (nisa_type_ok p "array<Point>")
    assert (nisa_type_ok p "array<Tok>")
    assert (nisa_type_ok p "HashMap<string, string>")
    assert (nisa_type_ok p "Sym")
    assert (nisa_type_ok p "array<Sym>")
    assert (nisa_type_ok p "FlagBag")
    assert (nisa_type_ok p "ResultI")
    assert (not (nisa_type_ok p "List<Nope>"))
}

fn nisa_fresh() -> string {
    let n: int = nisa_label
    set nisa_label (+ nisa_label 1)
    return (+ "L" (int_to_string n))
}

shadow nisa_fresh {
    let _: int = (nisa_reset)
    assert (== (nisa_fresh) "L0")
    assert (== (nisa_fresh) "L1")
    let _2: int = (nisa_reset)
}

fn nisa_label_line(name: string) -> string {
    return (+ name ":\n")
}

shadow nisa_label_line {
    assert (== (nisa_label_line "L0") "L0:\n")
}

fn nisa_loop_push(top: string, end: string) -> int {
    if (>= nisa_loop_depth (array_length nisa_loop_ends)) {
        set nisa_loop_tops (array_push nisa_loop_tops top)
        set nisa_loop_ends (array_push nisa_loop_ends end)
    } else {
        (array_set nisa_loop_tops nisa_loop_depth top)
        (array_set nisa_loop_ends nisa_loop_depth end)
    }
    set nisa_loop_depth (+ nisa_loop_depth 1)
    return 0
}

shadow nisa_loop_push {
    let _: int = (nisa_reset)
    let _p: int = (nisa_loop_push "L0" "L1")
    assert (== nisa_loop_depth 1)
    assert (== (nisa_loop_end_name) "L1")
    assert (== (nisa_loop_top_name) "L0")
    let _q: int = (nisa_loop_pop)
    assert (== nisa_loop_depth 0)
    let _2: int = (nisa_reset)
}

fn nisa_loop_pop() -> int {
    if (> nisa_loop_depth 0) {
        set nisa_loop_depth (- nisa_loop_depth 1)
    } else {
        (print "")
    }
    return 0
}

shadow nisa_loop_pop {
    let _: int = (nisa_reset)
    let _p: int = (nisa_loop_push "L2" "L3")
    let _q: int = (nisa_loop_pop)
    assert (== nisa_loop_depth 0)
    let _2: int = (nisa_reset)
}

fn nisa_loop_end_name() -> string {
    if (< nisa_loop_depth 1) {
        return ""
    } else {
        return (at nisa_loop_ends (- nisa_loop_depth 1))
    }
}

shadow nisa_loop_end_name {
    let _: int = (nisa_reset)
    assert (== (nisa_loop_end_name) "")
    let _p: int = (nisa_loop_push "Lt" "Le")
    assert (== (nisa_loop_end_name) "Le")
    let _2: int = (nisa_reset)
}

fn nisa_loop_top_name() -> string {
    if (< nisa_loop_depth 1) {
        return ""
    } else {
        return (at nisa_loop_tops (- nisa_loop_depth 1))
    }
}

shadow nisa_loop_top_name {
    let _: int = (nisa_reset)
    assert (== (nisa_loop_top_name) "")
    let _p: int = (nisa_loop_push "Lt" "Le")
    assert (== (nisa_loop_top_name) "Lt")
    let _2: int = (nisa_reset)
}

fn nisa_fn_index(parser: Parser, name: string) -> int {
    let n: int = (parser_get_function_count parser)
    let mut i: int = 0
    while (< i n) {
        let f: ASTFunction = (parser_get_function parser i)
        if (== f.name name) {
            return i
        } else {
            (print "")
        }
        set i (+ i 1)
    }
    return (- 0 1)
}

shadow nisa_fn_index {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n add(a: int, b: int) -> int { return (+ a b) } shadow add { assert (== (add 1 1) 2) }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (== (nisa_fn_index p "add") 0)
    assert (== (nisa_fn_index p "nope") (- 0 1))
}

fn nisa_fn_defined(parser: Parser, name: string) -> bool {
    if (>= (nisa_fn_index parser name) 0) {
        return true
    } else {
        return (>= (nisa_imp_fn_index name) 0)
    }
}

shadow nisa_fn_defined {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "from \"cut_a_fn_imp.nano\" import imp_add " (+ "f" "n via_imp_add() -> int { return (imp_add 40 2) } shadow via_imp_add { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "tests/nanoisa/fixtures/cut_a_add.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "tests/nanoisa/fixtures/cut_a_add.nano")
    let p2: Parser = (nisa_ingest_imports p "tests/nanoisa/fixtures/cut_a_add.nano")
    assert nisa_ok
    assert (nisa_fn_defined p2 "via_imp_add")
    assert (nisa_fn_defined p2 "imp_add")
    assert (not (nisa_fn_defined p2 "nope"))
}

fn nisa_fn_is_void(parser: Parser, name: string) -> bool {
    let idx: int = (nisa_fn_index parser name)
    if (>= idx 0) {
        let func: ASTFunction = (parser_get_function parser idx)
        return (== func.return_type "void")
    } else {
        let iidx: int = (nisa_imp_fn_index name)
        if (< iidx 0) {
            return false
        } else {
            return (== (at nisa_imp_fn_rets iidx) "void")
        }
    }
}

shadow nisa_fn_is_void {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ (+ "f" "n quiet() -> void { } ") (+ "f" "n via_quiet() -> int { (quiet) return 0 } shadow quiet { assert true } shadow via_quiet { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (nisa_fn_is_void p "quiet")
    assert (not (nisa_fn_is_void p "via_quiet"))
    assert (not (nisa_fn_is_void p "nope"))
}

fn nisa_check_arity(parser: Parser, name: string, argc: int) -> string {
    let idx: int = (nisa_fn_index parser name)
    if (< idx 0) {
        return ""
    } else {
        let fd: ASTFunction = (parser_get_function parser idx)
        if (!= argc fd.param_count) {
            return (nisa_fail (+ "wrong arity " name))
        } else {
            return ""
        }
    }
}

shadow nisa_check_arity {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n add(a: int, b: int) -> int { return (+ a b) } shadow add { assert true }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (== (nisa_check_arity p "add" 2) "")
    assert nisa_ok
    let bad: string = (nisa_check_arity p "add" 1)
    assert (== bad "")
    assert (not nisa_ok)
    assert (== nisa_err "wrong arity add")
    let _2: int = (nisa_reset)
}

fn nisa_os_sym(name: string) -> string {
    if (== name "getcwd") {
        return "vm_getcwd"
    }
    if (== name "chdir") {
        return "vm_chdir"
    }
    if (== name "file_read") {
        return "vm_file_read"
    }
    if (== name "file_write") {
        return "vm_file_write"
    }
    if (== name "file_exists") {
        return "vm_file_exists"
    }
    if (== name "dir_exists") {
        return "vm_dir_exists"
    }
    if (== name "dir_create") {
        return "vm_dir_create"
    }
    if (== name "dir_list") {
        return "vm_dir_list"
    }
    if (== name "tmp_dir") {
        return "vm_tmp_dir"
    }
    if (== name "mktemp") {
        return "vm_mktemp"
    }
    if (== name "mktemp_dir") {
        return "vm_mktemp_dir"
    }
    if (== name "getenv") {
        return "vm_getenv"
    }
    if (== name "setenv") {
        return "vm_setenv"
    }
    if (== name "str_index_of") {
        return "vm_str_index_of"
    }
    if (== name "process_run") {
        return "vm_process_run"
    }
    if (== name "system") {
        return "vm_system"
    }
    if (== name "get_argc") {
        return "get_argc"
    }
    if (== name "get_argv") {
        return "get_argv"
    }
    if (== name "string_from_char") {
        return "vm_string_from_char"
    }
    return ""
}

shadow nisa_os_sym {
    assert (== (nisa_os_sym "getcwd") "vm_getcwd")
    assert (== (nisa_os_sym "getenv") "vm_getenv")
    assert (== (nisa_os_sym "file_read") "vm_file_read")
    assert (== (nisa_os_sym "file_write") "vm_file_write")
    assert (== (nisa_os_sym "file_exists") "vm_file_exists")
    assert (== (nisa_os_sym "tmp_dir") "vm_tmp_dir")
    assert (== (nisa_os_sym "system") "vm_system")
    assert (== (nisa_os_sym "get_argc") "get_argc")
    assert (== (nisa_os_sym "get_argv") "get_argv")
