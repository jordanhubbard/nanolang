fn nisa_emit_call(parser: Parser, call: ASTCall) -> string {
    let func_id: ASTIdentifier = (parser_get_identifier parser call.function)
    if (== func_id.name "array_new") {
        return (nisa_emit_array_new parser call)
    } else {
    if (and (nisa_is_list_call func_id.name) (str_ends_with func_id.name "_new")) {
        if (!= call.arg_count 0) {
            return (nisa_fail "list_T_new needs 0 arguments")
        } else {
            return (nisa_line_imm "ARR_NEW" "1")
        }
    } else {
    if (or (== func_id.name "array_length") (and (nisa_is_list_call func_id.name) (str_ends_with func_id.name "_length"))) {
        if (!= call.arg_count 1) {
            return (nisa_fail "array_length needs 1 argument")
        } else {
            return (+ (nisa_emit_call_args parser call) (nisa_line "ARR_LEN"))
        }
    } else {
        if (or (== func_id.name "array_get") (or (== func_id.name "at") (and (nisa_is_list_call func_id.name) (str_ends_with func_id.name "_get")))) {
            if (!= call.arg_count 2) {
                return (nisa_fail "array_get needs 2 arguments")
            } else {
                return (+ (nisa_emit_call_args parser call) (nisa_line "ARR_GET"))
            }
        } else {
            if (or (== func_id.name "array_push") (and (nisa_is_list_call func_id.name) (str_ends_with func_id.name "_push"))) {
                if (!= call.arg_count 2) {
                    return (nisa_fail "array_push needs 2 arguments")
                } else {
                    return (+ (nisa_emit_call_args parser call) (nisa_line "ARR_PUSH"))
                }
            } else {
                if (or (== func_id.name "array_set") (and (nisa_is_list_call func_id.name) (str_ends_with func_id.name "_set"))) {
                    if (!= call.arg_count 3) {
                        return (nisa_fail "array_set needs 3 arguments")
                    } else {
                        return (+ (nisa_emit_call_args parser call) (nisa_line "ARR_SET"))
                    }
                } else {
                if (or (== func_id.name "str_contains")
                       (or (== func_id.name "str_starts_with")
                           (== func_id.name "str_ends_with"))) {
                    if (!= call.arg_count 2) {
                        return (nisa_fail "string prefix test needs 2 arguments")
                    } else {
                        if (== func_id.name "str_contains") {
                            return (+ (nisa_emit_call_args parser call) (nisa_line "STR_CONTAINS"))
                        } else {
                            if (== func_id.name "str_starts_with") {
                                return (+ (nisa_emit_call_args parser call) (nisa_line "STR_STARTS_WITH"))
                            } else {
                                return (+ (nisa_emit_call_args parser call) (nisa_line "STR_ENDS_WITH"))
                            }
                        }
                    }
                } else {
                    if (== func_id.name "str_concat") {
                        if (!= call.arg_count 2) {
                            return (nisa_fail "str_concat needs 2 arguments")
                        } else {
                            return (+ (nisa_emit_call_args parser call) (nisa_line "STR_CONCAT"))
                        }
                    } else {
                    if (== func_id.name "int_to_string") {
                        if (!= call.arg_count 1) {
                            return (nisa_fail "int_to_string needs 1 argument")
                        } else {
                            return (+ (nisa_emit_call_args parser call) (nisa_line "CAST_STRING"))
                        }
                    } else {
                    if (== func_id.name "string_to_int") {
                        if (!= call.arg_count 1) {
                            return (nisa_fail "string_to_int needs 1 argument")
                        } else {
                            return (+ (nisa_emit_call_args parser call) (nisa_line "CAST_INT"))
                        }
                    } else {
                        if (== func_id.name "str_length") {
                            if (!= call.arg_count 1) {
                                return (nisa_fail "str_length needs 1 argument")
                            } else {
                                return (+ (nisa_emit_call_args parser call) (nisa_line "STR_LEN"))
                            }
                        } else {
                            if (== func_id.name "str_substring") {
                                if (!= call.arg_count 3) {
                                    return (nisa_fail "str_substring needs 3 arguments")
                                } else {
                                    return (+ (nisa_emit_call_args parser call) (nisa_line "STR_SUBSTR"))
                                }
                            } else {
                            if (== func_id.name "str_trim") {
                                if (!= call.arg_count 1) {
                                    return (nisa_fail "str_trim needs 1 argument")
                                } else {
                                    return (+ (nisa_emit_call_args parser call) (nisa_line "STR_TRIM"))
                                }
                            } else {
                            if (== func_id.name "str_split") {
                                if (!= call.arg_count 2) {
                                    return (nisa_fail "str_split needs 2 arguments")
                                } else {
                                    return (+ (nisa_emit_call_args parser call) (nisa_line "STR_SPLIT"))
                                }
                            } else {
                            if (== func_id.name "str_replace") {
                                if (!= call.arg_count 3) {
                                    return (nisa_fail "str_replace needs 3 arguments")
                                } else {
                                    return (+ (nisa_emit_call_args parser call) (nisa_line "STR_REPLACE"))
                                }
                            } else {
                            if (or (== func_id.name "char_at") (== func_id.name "str_char_at")) {
                                if (!= call.arg_count 2) {
                                    return (nisa_fail "char_at needs 2 arguments")
                                } else {
                                    return (+ (nisa_emit_call_args parser call) (nisa_line "STR_CHAR_AT"))
                                }
                            } else {
                            if (== func_id.name "not") {
                                if (!= call.arg_count 1) {
                                    return (nisa_fail "not needs 1 argument")
                                } else {
                                    return (+ (nisa_emit_call_args parser call) (nisa_line "BOOL_NOT"))
                                }
                            } else {
                                if (nisa_is_print_builtin func_id.name) {
                                    if (!= call.arg_count 1) {
                                        return (nisa_fail "print needs 1 argument")
                                    } else {
                                        if (== func_id.name "println") {
                                            return (+ (nisa_emit_call_args parser call) (nisa_line "PRINTLN"))
                                        } else {
                                            return (+ (nisa_emit_call_args parser call) (nisa_line "PRINT"))
                                        }
                                    }
                                } else {
                                    if (nisa_is_hm_builtin func_id.name) {
                                        return (nisa_emit_hm_call parser call)
                                    } else {
                                    if (nisa_is_host_call parser func_id.name) {
                                        return (nisa_emit_host_call parser call)
                                    } else {
                                    if (not (nisa_fn_defined parser func_id.name)) {
                                        return (nisa_fail (+ "undefined function " func_id.name))
                                    } else {
                                        let bad: string = (nisa_check_arity parser func_id.name call.arg_count)
                                        if (not nisa_ok) {
                                            return bad
                                        } else {
                                        return (+ (nisa_emit_call_args parser call) (nisa_line_imm "CALL" func_id.name))
                                        }
                                    }
                                    }
                                    }
                                }
                            }
                            }
                            }
                            }
                            }
                            }
                        }
                    }
                    }
                    }
                }
                }
            }
        }
    }
    }
    }
}

shadow nisa_emit_call {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n len3() -> int { let xs: array<int> = [1, 2, 3] return (array_length xs) } shadow len3 { assert true }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 1)
    let r: ASTReturn = (parser_get_return p stmt.node_id)
    let call: ASTCall = (parser_get_call p r.value)
    let text: string = (nisa_emit_call p call)
    assert (str_contains text "ARR_LEN")
    assert (str_contains text "LOAD_LOCAL 0")
    let _2: int = (nisa_reset)
}

fn nisa_emit_expr(parser: Parser, node_id: int, node_type: int) -> string {
    if (== node_type ParseNodeType.PNODE_NUMBER) {
        let num: ASTNumber = (parser_get_number parser node_id)
        return (nisa_line_imm "PUSH_I64" num.value)
    } else {
        if (== node_type ParseNodeType.PNODE_FLOAT) {
            let fl: ASTFloat = (parser_get_float parser node_id)
            return (nisa_line_imm "PUSH_F64" fl.value)
        } else {
        if (== node_type ParseNodeType.PNODE_STRING) {
            let s: ASTString = (parser_get_string parser node_id)
            let name: string = (nisa_intern s.value)
            return (nisa_line_imm "PUSH_STR" name)
        } else {
            if (== node_type ParseNodeType.PNODE_IDENTIFIER) {
                let id: ASTIdentifier = (parser_get_identifier parser node_id)
                let slot: int = (nisa_local_find id.name)
                if (< slot 0) {
                    let gslot: int = (nisa_global_find id.name)
                    if (< gslot 0) {
                        return (nisa_fail (+ "undefined local " id.name))
                    } else {
                        return (nisa_line_imm "LOAD_GLOBAL" (int_to_string gslot))
                    }
                } else {
                    return (nisa_line_imm "LOAD_LOCAL" (int_to_string slot))
                }
            } else {
                if (== node_type ParseNodeType.PNODE_BINARY_OP) {
                    let binop: ASTBinaryOp = (parser_get_binary_op parser node_id)
                    if (nisa_binop_is_unary_minus parser binop) {
                        let rhs: string = (nisa_emit_expr parser binop.right binop.right_type)
                        if (nisa_expr_is_float parser binop.right binop.right_type) {
                            return (+ rhs (nisa_line "F64_NEG"))
                        } else {
                            return (+ rhs (nisa_line "I64_NEG"))
                        }
                    } else {
                    let left_s: bool = (nisa_expr_is_string parser binop.left binop.left_type)
                    let right_s: bool = (nisa_expr_is_string parser binop.right binop.right_type)
                    if (or left_s right_s) {
                        if (== binop.op LexerTokenType.TOKEN_PLUS) {
                            let left: string = (nisa_emit_expr parser binop.left binop.left_type)
                            let right: string = (nisa_emit_expr parser binop.right binop.right_type)
                            return (+ (+ left right) (nisa_line "STR_CONCAT"))
                        } else {
                            if (== binop.op LexerTokenType.TOKEN_EQ) {
                                let left: string = (nisa_emit_expr parser binop.left binop.left_type)
                                let right: string = (nisa_emit_expr parser binop.right binop.right_type)
                                return (+ (+ left right) (nisa_line "EQ"))
                            } else {
                                if (== binop.op LexerTokenType.TOKEN_NE) {
                                    let left: string = (nisa_emit_expr parser binop.left binop.left_type)
                                    let right: string = (nisa_emit_expr parser binop.right binop.right_type)
                                    return (+ (+ left right) (nisa_line "NE"))
                                } else {
                                    return (nisa_fail "unsupported string operator")
                                }
                            }
                        }
                    } else {
                            let left_f: bool = (nisa_expr_is_float parser binop.left binop.left_type)
                            let right_f: bool = (nisa_expr_is_float parser binop.right binop.right_type)
                            if (or left_f right_f) {
                                let mnemonic: string = (nisa_f64_binop_mnemonic binop.op)
                                if (== mnemonic "") {
                                    return (nisa_fail "unsupported float operator")
                                } else {
                                    let left: string = (nisa_emit_expr parser binop.left binop.left_type)
                                    let right: string = (nisa_emit_expr parser binop.right binop.right_type)
                                    return (+ (+ left right) (nisa_line mnemonic))
                                }
                            } else {
                            let left_b: bool = (nisa_expr_is_bool parser binop.left binop.left_type)
                            let right_b: bool = (nisa_expr_is_bool parser binop.right binop.right_type)
                            if (and (and left_b right_b)
                                    (or (== binop.op LexerTokenType.TOKEN_EQ)
                                        (== binop.op LexerTokenType.TOKEN_NE))) {
                                let left: string = (nisa_emit_expr parser binop.left binop.left_type)
                                let right: string = (nisa_emit_expr parser binop.right binop.right_type)
                                if (== binop.op LexerTokenType.TOKEN_EQ) {
                                    return (+ (+ left right) (nisa_line "EQ"))
                                } else {
                                    return (+ (+ left right) (nisa_line "NE"))
                                }
                            } else {
                            let mnemonic: string = (nisa_binop_mnemonic binop.op)
                            if (== mnemonic "") {
                                return (nisa_fail "unsupported integer operator")
                            } else {
                                let left: string = (nisa_emit_expr parser binop.left binop.left_type)
                                let right: string = (nisa_emit_expr parser binop.right binop.right_type)
                                return (+ (+ left right) (nisa_line mnemonic))
                            }
                            }
                            }
                    }
                    }
                } else {
                    if (== node_type ParseNodeType.PNODE_CALL) {
                        let call: ASTCall = (parser_get_call parser node_id)
                        return (nisa_emit_call parser call)
                    } else {
                        if (== node_type ParseNodeType.PNODE_ARRAY_LITERAL) {
                            return (nisa_emit_array_literal parser node_id)
                        } else {
                            if (== node_type ParseNodeType.PNODE_STRUCT_LITERAL) {
                                return (nisa_emit_struct_literal parser node_id)
                            } else {
                                if (== node_type ParseNodeType.PNODE_FIELD_ACCESS) {
                                    return (nisa_emit_field_access parser node_id)
                                } else {
                                    if (== node_type ParseNodeType.PNODE_BOOL) {
                                        let bval: ASTBool = (parser_get_bool parser node_id)
                                        if bval.value {
                                            return (nisa_line_imm "PUSH_BOOL" "1")
                                        } else {
                                            return (nisa_line_imm "PUSH_BOOL" "0")
                                        }
                                    } else {
                                        if (== node_type ParseNodeType.PNODE_IF) {
                                            let inode: ASTIf = (parser_get_if parser node_id)
                                            if (< inode.else_body 0) {
                                                return (nisa_fail "if expression needs else")
                                            } else {
                                                let l_else: string = (nisa_fresh)
                                                let l_end: string = (nisa_fresh)
                                                let cnd_text: string = (nisa_emit_expr parser inode.condition inode.condition_type)
                                                let then_text: string = (nisa_emit_expr parser inode.then_body ParseNodeType.PNODE_BLOCK)
                                                let else_text: string = (nisa_emit_expr parser inode.else_body ParseNodeType.PNODE_BLOCK)
                                                let mut out: string = (+ cnd_text (nisa_line_imm "JMP_FALSE" l_else))
                                                set out (+ out then_text)
                                                set out (+ out (nisa_line_imm "JMP" l_end))
                                                set out (+ out (nisa_label_line l_else))
                                                set out (+ out else_text)
                                                set out (+ out (nisa_label_line l_end))
                                                return out
                                            }
                                            } else {
                                                if (== node_type ParseNodeType.PNODE_BLOCK) {
                                                    let blk: ASTBlock = (parser_get_block parser node_id)
                                                    if (!= (list_ASTStmtRef_length blk.statements) 1) {
                                                        return (nisa_fail "expression block needs 1 statement")
                                                    } else {
                                                        let st: ASTStmtRef = (list_ASTStmtRef_get blk.statements 0)
                                                        return (nisa_emit_expr parser st.node_id st.node_type)
                                                    }
                                                } else {
                                                    if (== node_type ParseNodeType.PNODE_MODULE_QUALIFIED_CALL) {
                                                        return (nisa_emit_mqc parser node_id)
                                                    } else {
                                                        if (== node_type ParseNodeType.PNODE_UNION_CONSTRUCT) {
                                                            return (nisa_emit_union_construct parser node_id)
                                                        } else {
                                                            return (nisa_fail (+ "expression outside the pinned subset " (+ (int_to_string node_type) (+ " in " nisa_cur_fn))))
                                                        }
                                                    }
                                                }
                                            }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        }
    }
}

shadow nisa_emit_expr {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n main() -> int { return 7 } shadow main { assert (== (main) 7) }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let num: ASTNumber = (parser_get_number p 0)
    let text: string = (nisa_emit_expr p 0 ParseNodeType.PNODE_NUMBER)
    assert (str_contains text "PUSH_I64 7")
    assert (== num.value "7")
    let srcf: string = (+ "f" "n fone() -> float { return 1.0 } shadow fone { assert true }")
    let toksf: List<LexerToken> = (tokenize_string srcf "t.nano" diags)
    let pf: Parser = (parse_program toksf (list_LexerToken_length toksf) "t.nano")
    let fl: ASTFloat = (parser_get_float pf 0)
    let textf: string = (nisa_emit_expr pf 0 ParseNodeType.PNODE_FLOAT)
    assert (str_contains textf "PUSH_F64 1.0")
    assert (== fl.value "1.0")
    let _2: int = (nisa_reset)
}

fn nisa_arm_falls_through(parser: Parser, body_id: int, body_type: int) -> bool {
    if (== body_type ParseNodeType.PNODE_BLOCK) {
        return (nisa_block_falls_through parser body_id)
    } else {
        if (== body_type ParseNodeType.PNODE_RETURN) {
            return false
        } else {
            return true
        }
    }
}

shadow nisa_arm_falls_through {
    assert true
}

fn nisa_match_falls_through(parser: Parser, node_id: int) -> bool {
    let m: ASTMatch = (parser_get_match parser node_id)
    if (== m.arm_count 0) {
        return true
    } else {
        let mut i: int = 0
        while (< i m.arm_count) {
            let bid: int = (at m.arm_body_ids i)
            let bty: int = (at m.arm_body_types i)
            if (nisa_arm_falls_through parser bid bty) {
                return true
            } else {
                set i (+ i 1)
            }
        }
        return false
    }
}

shadow nisa_match_falls_through {
    assert true
}

fn nisa_block_falls_through(parser: Parser, block_id: int) -> bool {
    if (< block_id 0) {
        return true
    } else {
        let block: ASTBlock = (parser_get_block parser block_id)
        let n: int = (list_ASTStmtRef_length block.statements)
        let mut i: int = 0
        while (< i n) {
            let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements i)
            if (== stmt.node_type ParseNodeType.PNODE_RETURN) {
                return false
            } else {
                if (or (== stmt.node_type ParseNodeType.PNODE_BREAK) (== stmt.node_type ParseNodeType.PNODE_CONTINUE)) {
                    return false
                } else {
                if (== stmt.node_type ParseNodeType.PNODE_IF) {
                    let node: ASTIf = (parser_get_if parser stmt.node_id)
                    if (< node.else_body 0) {
                        (print "")
                    } else {
                        if (and (not (nisa_block_falls_through parser node.then_body))
                                (not (nisa_block_falls_through parser node.else_body))) {
                            return false
                        } else {
                            (print "")
                        }
                    }
                } else {
                    if (== stmt.node_type ParseNodeType.PNODE_MATCH) {
                        if (not (nisa_match_falls_through parser stmt.node_id)) {
                            return false
                        } else {
                            (print "")
                        }
                    } else {
                        (print "")
                    }
                }
                }
            }
            set i (+ i 1)
        }
        return true
    }
}

shadow nisa_block_falls_through {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n main() -> int { return 1 } shadow main { assert (== (main) 1) }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    assert (not (nisa_block_falls_through p func.body))
}

fn nisa_stmt_terminates(parser: Parser, stmt: ASTStmtRef) -> bool {
    if (== stmt.node_type ParseNodeType.PNODE_RETURN) {
        return true
    } else {
        if (or (== stmt.node_type ParseNodeType.PNODE_BREAK) (== stmt.node_type ParseNodeType.PNODE_CONTINUE)) {
            return true
        } else {
        if (== stmt.node_type ParseNodeType.PNODE_IF) {
            let node: ASTIf = (parser_get_if parser stmt.node_id)
            if (< node.else_body 0) {
                return false
            } else {
                return (and (not (nisa_block_falls_through parser node.then_body))
                            (not (nisa_block_falls_through parser node.else_body)))
            }
        } else {
            if (== stmt.node_type ParseNodeType.PNODE_MATCH) {
                return (not (nisa_match_falls_through parser stmt.node_id))
            } else {
                return false
            }
        }
        }
    }
}

shadow nisa_stmt_terminates {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n main() -> int { return 1 } shadow main { assert (== (main) 1) }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 0)
    assert (nisa_stmt_terminates p stmt)
}

fn nisa_emit_unsafe(parser: Parser, node_id: int) -> string {
    let ub: ASTUnsafeBlock = (parser_get_unsafe_block parser node_id)
    let n: int = (list_ASTStmtRef_length ub.statements)
    let mut out: string = ""
    let mut i: int = 0
    while (< i n) {
        let stmt: ASTStmtRef = (list_ASTStmtRef_get ub.statements i)
        set out (+ out (nisa_emit_stmt parser stmt))
        if (nisa_stmt_terminates parser stmt) {
            set i n
        } else {
            set i (+ i 1)
        }
    }
    return out
}

shadow nisa_emit_unsafe {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n via_raw() -> int { unsafe { return 7 } } shadow via_raw { assert true }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let text: string = (nisa_emit_function p func)
    assert (str_contains text ".function via_raw 0 0 0 int 1")
    assert (str_contains text "PUSH_I64 7")
    assert (str_contains text "RET")
}

fn nisa_emit_if(parser: Parser, node: ASTIf) -> string {
    let l_else: string = (nisa_fresh)
    let cnd_text: string = (nisa_emit_expr parser node.condition node.condition_type)
    let then_ft: bool = (nisa_block_falls_through parser node.then_body)
    let mut out: string = (+ cnd_text (nisa_line_imm "JMP_FALSE" l_else))
    set out (+ out (nisa_emit_block parser node.then_body))
    if (>= node.else_body 0) {
        if (== then_ft true) {
            let l_end: string = (nisa_fresh)
            set out (+ out (nisa_line_imm "JMP" l_end))
            set out (+ out (nisa_label_line l_else))
            set out (+ out (nisa_emit_block parser node.else_body))
            set out (+ out (nisa_label_line l_end))
            return out
        } else {
            set out (+ out (nisa_label_line l_else))
            set out (+ out (nisa_emit_block parser node.else_body))
            return out
        }
    } else {
        set out (+ out (nisa_label_line l_else))
        return out
    }
}

shadow nisa_emit_if {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n choose(c: int) -> int { if (> c 0) { return 1 } else { return 0 } } shadow choose { assert (== (choose 1) 1) }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    set nisa_names (array_push nisa_names "c")
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 0)
    let node: ASTIf = (parser_get_if p stmt.node_id)
    let text: string = (nisa_emit_if p node)
    assert (str_contains text "I64_GT_S")
    assert (str_contains text "JMP_FALSE")
}

fn nisa_emit_while(parser: Parser, w: ASTWhile) -> string {
    let l_top: string = (nisa_fresh)
    let l_end: string = (nisa_fresh)
    let mut out: string = (nisa_label_line l_top)
    set out (+ out (nisa_emit_expr parser w.condition w.condition_type))
    set out (+ out (nisa_line_imm "JMP_FALSE" l_end))
    let _p: int = (nisa_loop_push l_top l_end)
    set out (+ out (nisa_emit_block parser w.body))
    let _q: int = (nisa_loop_pop)
    if (nisa_block_falls_through parser w.body) {
        set out (+ out (nisa_line_imm "JMP" l_top))
    } else {
        (print "")
    }
    set out (+ out (nisa_label_line l_end))
    return out
}

shadow nisa_emit_while {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n loop_sum(n: int) -> int { let mut i: int = 0 while (< i n) { set i (+ i 1) } return i } shadow loop_sum { assert (== (loop_sum 1) 1) }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    set nisa_names (array_push nisa_names "n")
    set nisa_names (array_push nisa_names "i")
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 1)
    let w: ASTWhile = (parser_get_while p stmt.node_id)
    let text: string = (nisa_emit_while p w)
    assert (str_contains text "I64_LT_S")
    assert (str_contains text "JMP_FALSE")
    assert (str_contains text "JMP L")
}

fn nisa_emit_for(parser: Parser, node: ASTFor) -> string {
    let l_top: string = (nisa_fresh)
    let l_end: string = (nisa_fresh)
    let mut out: string = (nisa_emit_expr parser node.iterable node.iterable_type)
    set nisa_names (array_push nisa_names "__for_arr__")
    set nisa_types (array_push nisa_types "array<int>")
    let arr_slot: int = (- (array_length nisa_names) 1)
    set out (+ out (nisa_line_imm "STORE_LOCAL" (int_to_string arr_slot)))
    set out (+ out (nisa_line_imm "PUSH_I64" "0"))
    set nisa_names (array_push nisa_names "__for_idx__")
    set nisa_types (array_push nisa_types "int")
    let idx_slot: int = (- (array_length nisa_names) 1)
    set out (+ out (nisa_line_imm "STORE_LOCAL" (int_to_string idx_slot)))
    set out (+ out (nisa_line_imm "LOAD_LOCAL" (int_to_string arr_slot)))
    set out (+ out (nisa_line "ARR_LEN"))
    set nisa_names (array_push nisa_names "__for_len__")
    set nisa_types (array_push nisa_types "int")
    let len_slot: int = (- (array_length nisa_names) 1)
    set out (+ out (nisa_line_imm "STORE_LOCAL" (int_to_string len_slot)))
    set out (+ out (nisa_label_line l_top))
    set out (+ out (nisa_line_imm "LOAD_LOCAL" (int_to_string idx_slot)))
    set out (+ out (nisa_line_imm "LOAD_LOCAL" (int_to_string len_slot)))
    set out (+ out (nisa_line "LT"))
    set out (+ out (nisa_line_imm "JMP_FALSE" l_end))
    set out (+ out (nisa_line_imm "LOAD_LOCAL" (int_to_string arr_slot)))
    set out (+ out (nisa_line_imm "LOAD_LOCAL" (int_to_string idx_slot)))
    set out (+ out (nisa_line "ARR_GET"))
    set nisa_names (array_push nisa_names node.var_name)
    set nisa_types (array_push nisa_types "int")
    let var_slot: int = (- (array_length nisa_names) 1)
    set out (+ out (nisa_line_imm "STORE_LOCAL" (int_to_string var_slot)))
    let _p: int = (nisa_loop_push l_top l_end)
    set out (+ out (nisa_emit_block parser node.body))
    let _q: int = (nisa_loop_pop)
    if (nisa_block_falls_through parser node.body) {
        set out (+ out (nisa_line_imm "LOAD_LOCAL" (int_to_string idx_slot)))
        set out (+ out (nisa_line_imm "PUSH_I64" "1"))
        set out (+ out (nisa_line "I64_ADD"))
        set out (+ out (nisa_line_imm "STORE_LOCAL" (int_to_string idx_slot)))
        set out (+ out (nisa_line_imm "JMP" l_top))
    } else {
        (print "")
    }
    set out (+ out (nisa_label_line l_end))
    return out
}

