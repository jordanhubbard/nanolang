fn nisa_emit_field_access(parser: Parser, node_id: int) -> string {
    let access: ASTFieldAccess = (parser_get_field_access parser node_id)
    let enum_index: int = (nisa_enum_receiver parser access)
    if (>= enum_index 0) {
        let declaration: ASTEnum = (parser_get_enum parser enum_index)
        if (or (!= declaration.variant_count (array_length declaration.variant_names))
               (!= declaration.variant_count (array_length declaration.variant_values))) {
            return (nisa_fail "I require complete enum member metadata")
        }
        let mut member: int = 0
        while (< member declaration.variant_count) {
            if (== (at declaration.variant_names member) access.field_name) {
                return (nisa_line_imm "PUSH_I64" (int_to_string (at declaration.variant_values member)))
            }
            set member (+ member 1)
        }
        return (nisa_fail (+ "unknown enum member " access.field_name))
    }
    let ty: string = (nisa_expr_type parser access.object access.object_type)
    let index: int = (nisa_struct_index parser ty)
    if (< index 0) { return (nisa_fail "I require a typed record for field access") }
    let record: ASTStruct = (parser_get_struct_def parser index)
    let mut i: int = 0
    while (< i record.field_count) {
        if (== (at record.field_names i) access.field_name) {
            return (+ (nisa_emit_expr parser access.object access.object_type) (nisa_line_imm "AGG_GET" (int_to_string i)))
        }
        set i (+ i 1)
    }
    return (nisa_fail (+ "unknown field " access.field_name))
}

shadow nisa_emit_field_access {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "struct Point { x: int, y: int } " (+ "f" "n getx() -> int { let p: Point = Point { x: 3, y: 4 } return p.x } shadow getx { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    set nisa_names (array_push nisa_names "p")
    set nisa_types (array_push nisa_types "Point")
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 1)
    let r: ASTReturn = (parser_get_return p stmt.node_id)
    let text: string = (nisa_emit_field_access p r.value)
    assert (str_contains text "LOAD_LOCAL 0")
    assert (str_contains text "AGG_GET 0")
    let _r: int = (nisa_reset)
    let src2: string = (+ "struct Tok { t: int, s: string } " (+ "f" "n get_s() -> string { let p: Tok = Tok { t: 1, s: \"hi\" } return p.s } shadow get_s { assert true }"))
    let toks2: List<LexerToken> = (tokenize_string src2 "t.nano" diags)
    let p2: Parser = (parse_program toks2 (list_LexerToken_length toks2) "t.nano")
    let func2: ASTFunction = (parser_get_function p2 0)
    set nisa_names (array_push nisa_names "p")
    set nisa_types (array_push nisa_types "Tok")
    let block2: ASTBlock = (parser_get_block p2 func2.body)
    let stmt2: ASTStmtRef = (list_ASTStmtRef_get block2.statements 1)
    let r2: ASTReturn = (parser_get_return p2 stmt2.node_id)
    let text2: string = (nisa_emit_field_access p2 r2.value)
    assert (str_contains text2 "LOAD_LOCAL 0")
    assert (str_contains text2 "AGG_GET 1")
    let _2: int = (nisa_reset)
}

# I reserve anonymous slots after evaluating each operand, in C-seed order.
fn nisa_temp_local(value_type: string) -> string {
    let slot: int = (array_length nisa_names)
    set nisa_names (array_push nisa_names "")
    set nisa_types (array_push nisa_types value_type)
    return (int_to_string slot)
}
shadow nisa_temp_local {
    let reset: int = (nisa_reset)
    assert (== (nisa_temp_local "int") "0")
    assert (== (nisa_temp_local "string") "1")
    assert (== (nisa_local_find "") (- 0 1))
    assert (== (at nisa_types 1) "string")
    let reset_again: int = (nisa_reset)
}

fn nisa_increment_local(slot: string) -> string {
    let mut text: string = (nisa_line_imm "LOAD_LOCAL" slot)
    set text (+ text (nisa_line_imm "PUSH_I64" "1"))
    set text (+ text (nisa_line "I64_ADD"))
    return (+ text (nisa_line_imm "STORE_LOCAL" slot))
}
shadow nisa_increment_local {
    assert (== (nisa_increment_local "2") "  LOAD_LOCAL 2\n  PUSH_I64 1\n  I64_ADD\n  STORE_LOCAL 2\n")
}

# I evaluate each bound once and materialize the same integer array as my seed.
fn nisa_emit_range(parser: Parser, call: ASTCall) -> string {
    if (!= call.arg_count 2) {
        return (nisa_fail "I require two integer range bounds")
    }
    let mut argument: int = 0
    while (< argument call.arg_count) {
        let value: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start argument))
        if (!= (nisa_expr_type parser value.node_id value.node_type) "int") {
            return (nisa_fail "I require integer range bounds")
        }
        set argument (+ argument 1)
    }
    let mut text: string = ""
    set text (+ text (nisa_emit_call_args parser call))
    let end_slot: string = (nisa_temp_local "int")
    set text (+ text (nisa_line_imm "STORE_LOCAL" end_slot))
    let index_slot: string = (nisa_temp_local "int")
    set text (+ text (nisa_line_imm "STORE_LOCAL" index_slot))
    set text (+ text (nisa_line_imm "ARR_NEW" "1"))
    let array_slot: string = (nisa_temp_local "array<int>")
    set text (+ text (nisa_line_imm "STORE_LOCAL" array_slot))
    let top: string = (nisa_fresh)
    let end: string = (nisa_fresh)
    set text (+ text (nisa_label_line top))
    set text (+ text (nisa_line_imm "LOAD_LOCAL" index_slot))
    set text (+ text (nisa_line_imm "LOAD_LOCAL" end_slot))
    set text (+ text (nisa_line "LT"))
    set text (+ text (nisa_line_imm "JMP_FALSE" end))
    set text (+ text (nisa_line_imm "LOAD_LOCAL" array_slot))
    set text (+ text (nisa_line_imm "LOAD_LOCAL" index_slot))
    set text (+ text (nisa_line "ARR_PUSH"))
    set text (+ text (nisa_line_imm "STORE_LOCAL" array_slot))
    set text (+ text (nisa_increment_local index_slot))
    set text (+ text (nisa_line_imm "JMP" top))
    set text (+ text (nisa_label_line end))
    return (+ text (nisa_line_imm "LOAD_LOCAL" array_slot))
}
shadow nisa_emit_range {
    let text: string = (nanoisa_emit_nasm "fn main() -> int { for value in (range 0 3) { assert (>= value 0) } return 0 }")
    assert (str_contains text "ARR_NEW 1")
    assert (str_contains text "LT")
    assert (str_contains text "ARR_PUSH")
    assert (== (nanoisa_emit_nasm "fn main() -> int { let values: array<int> = (range true) return 0 }") "")
}

fn nisa_emit_filled_array(parser: Parser, call: ASTCall) -> string {
    if (!= call.arg_count 2) { return (nisa_fail "I require an array count and fill value") }
    let count: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
    let fill: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
    if (!= (nisa_expr_type parser count.node_id count.node_type) "int") {
        return (nisa_fail "I require an integer array count")
    }
    let element: string = (nisa_expr_type parser fill.node_id fill.node_type)
    let result_type: string = (+ "array<" (+ element ">"))
    if (not (nisa_type_ok parser result_type)) { return (nisa_fail "I require a supported array fill type") }
    let mut tag: string = "1"
    if (== element "string") { set tag "5" }
    if (== element "bool") { set tag "4" }
    if (nisa_is_pin_record parser element) { set tag "8" }
    let mut output: string = (nisa_emit_expr parser count.node_id count.node_type)
    let size_slot: string = (nisa_temp_local "int")
    set output (+ output (nisa_line_imm "STORE_LOCAL" size_slot))
    set output (+ output (nisa_emit_expr parser fill.node_id fill.node_type))
    let fill_slot: string = (nisa_temp_local element)
    set output (+ output (nisa_line_imm "STORE_LOCAL" fill_slot))
    set output (+ output (nisa_line_imm "LOAD_LOCAL" size_slot))
    set output (+ output (nisa_line_imm "PUSH_I64" "0"))
    set output (+ output (nisa_line "I64_GE_S"))
    set output (+ output (nisa_line "ASSERT"))
    set output (+ output (nisa_line_imm "ARR_NEW" tag))
    let array_slot: string = (nisa_temp_local result_type)
    set output (+ output (nisa_line_imm "STORE_LOCAL" array_slot))
    set output (+ output (nisa_line_imm "PUSH_I64" "0"))
    let index_slot: string = (nisa_temp_local "int")
    set output (+ output (nisa_line_imm "STORE_LOCAL" index_slot))
    let top: string = (nisa_fresh)
    let end: string = (nisa_fresh)
    set output (+ output (nisa_label_line top))
    set output (+ output (nisa_line_imm "LOAD_LOCAL" index_slot))
    set output (+ output (nisa_line_imm "LOAD_LOCAL" size_slot))
    set output (+ output (nisa_line "LT"))
    set output (+ output (nisa_line_imm "JMP_FALSE" end))
    set output (+ output (nisa_line_imm "LOAD_LOCAL" array_slot))
    set output (+ output (nisa_line_imm "LOAD_LOCAL" fill_slot))
    set output (+ output (nisa_line "ARR_PUSH"))
    set output (+ output (nisa_line_imm "STORE_LOCAL" array_slot))
    set output (+ output (nisa_line_imm "LOAD_LOCAL" index_slot))
    set output (+ output (nisa_line_imm "PUSH_I64" "1"))
    set output (+ output (nisa_line "I64_ADD"))
    set output (+ output (nisa_line_imm "STORE_LOCAL" index_slot))
    set output (+ output (nisa_line_imm "JMP" top))
    set output (+ output (nisa_label_line end))
    return (+ output (nisa_line_imm "LOAD_LOCAL" array_slot))
}
shadow nisa_emit_filled_array {
    let reset: int = (nisa_reset)
    let tokens: List<LexerToken> = (tokenize_string "fn main() -> int { let xs: array<string> = (array_new 0 \"\") return 0 }" "filled.nano" (diag_list_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "filled.nano")
    let text: string = (nisa_emit_filled_array parser (parser_get_call parser 0))
    assert (str_contains text "ARR_NEW 5")
    assert (str_contains text "I64_GE_S\n  ASSERT")
    assert (== (array_length nisa_names) 4)
    let reset_again: int = (nisa_reset)
}

fn nisa_emit_push_call(parser: Parser, call: ASTCall, name: string) -> string {
    if (!= call.arg_count 2) { return (nisa_fail "I require a container and append value") }
    let object: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
    let value: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
    let container: string = (nisa_push_container_type parser call)
    let element: string = (nisa_element_type parser container)
    if (== element "") { return (nisa_fail "I require a supported typed container for append") }
    if (nisa_is_list_call name) {
        let declared: string = (str_substring name 5 (- (str_length name) 10))
        if (!= declared element) { return (nisa_fail "I require the list append to match its element type") }
    }
    if (not (nisa_value_type_matches parser (nisa_expr_type parser value.node_id value.node_type) element)) {
        return (nisa_fail "I require an append value matching the element type")
    }
    let receiver: string = (nisa_emit_expected_expr parser object.node_id object.node_type container)
    let appended: string = (nisa_emit_expr parser value.node_id value.node_type)
    return (+ receiver (+ appended (nisa_line "ARR_PUSH")))
}
shadow nisa_emit_push_call {
    let reset: int = (nisa_reset)
    let tokens: List<LexerToken> = (tokenize_string "fn main() -> int { (array_push values true) return 0 }" "push.nano" (diag_list_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "push.nano")
    set nisa_names ["values"]
    set nisa_types ["array<bool>"]
    assert (str_contains (nisa_emit_push_call parser (parser_get_call parser 0) "array_push") "ARR_PUSH")
    set nisa_types ["array<int>"]
    assert (== (nisa_emit_push_call parser (parser_get_call parser 0) "array_push") "")
    assert (not nisa_ok)
    let reset_again: int = (nisa_reset)
}

fn nisa_emit_set_call(parser: Parser, call: ASTCall, name: string) -> string {
    if (!= call.arg_count 3) { return (nisa_fail "I require a container, integer index and replacement value") }
    let object: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
    let index: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
    let value: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 2))
    let element: string = (nisa_element_type parser (nisa_expr_type parser object.node_id object.node_type))
    if (== element "") { return (nisa_fail "I require a supported typed container for replacement") }
    if (!= (nisa_expr_type parser index.node_id index.node_type) "int") {
        return (nisa_fail "I require an integer replacement index")
    }
    if (nisa_is_list_call name) {
        let declared: string = (str_substring name 5 (- (str_length name) 9))
        if (!= declared element) { return (nisa_fail "I require the list setter to match its element type") }
    }
    if (not (nisa_value_type_matches parser (nisa_expr_type parser value.node_id value.node_type) element)) {
        return (nisa_fail "I require a replacement value matching the element type")
    }
    return (+ (nisa_emit_call_args parser call) (+ (nisa_line "ARR_SET") (nisa_line "POP")))
}
shadow nisa_emit_set_call {
    let _: int = (nisa_reset)
    let tokens: List<LexerToken> = (tokenize_string "fn main() -> int { (array_set values 0 7) return 0 }" "set.nano" (diag_list_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "set.nano")
    set nisa_names ["values"]
    set nisa_types ["array<int>"]
    let text: string = (nisa_emit_set_call parser (parser_get_call parser 0) "array_set")
    assert (str_contains text "ARR_SET\n  POP")
    let reset: int = (nisa_reset)
}

fn nisa_emit_call(parser: Parser, call: ASTCall) -> string {
    if (and (!= call.function_type ParseNodeType.PNODE_IDENTIFIER) (!= call.function_type ParseNodeType.PNODE_MODULE_QUALIFIED_CALL)) {
        return (nisa_fail "computed function calls are outside the NanoISA subset")
    } else { (print "") }
    let function_name: string = (nisa_call_name parser call)
    let declared_index: int = (nisa_call_index parser call)
    if (>= declared_index 0) {
        if (nisa_metadata_function (parser_get_function parser declared_index)) { return (nisa_emit_metadata_call parser call) }
    }
    if (and (< declared_index 0) (>= (nisa_artifact_arity function_name) 0)) {
        return (nisa_fail "I require a bound declaration for this artifact call")
    }
    if (and (>= declared_index 0) (>= (nisa_artifact_arity function_name) 0)) {
        let declaration: ASTFunction = (parser_get_function parser declared_index)
        if (< declaration.body 0) {
            if (!= call.arg_count declaration.param_count) { return (nisa_fail "I require the exact artifact call arity") }
            let mut i: int = 0
            while (< i call.arg_count) {
                let argument: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start i))
                if (!= (nisa_expr_type parser argument.node_id argument.node_type) "string") {
                    return (nisa_fail "I require string operands for this artifact call")
                }
                set i (+ i 1)
            }
            let index: int = (nisa_register_artifact parser declaration)
            if (< index 0) { return "" }
            return (+ (nisa_emit_call_args parser call) (nisa_line_imm "CALL_EXTERN" (int_to_string index)))
        }
    }
    if (and nisa_program_mode (>= declared_index 0)) {
        let declaration: ASTFunction = (parser_get_function parser declared_index)
        if (and (< declaration.body 0) (< (nisa_import_find declaration.name) 0)) {
            let _: int = (nisa_register_extern parser declaration)
            if (not nisa_ok) { return "" }
        }
    }
    if (and (!= (nisa_string_binary_opcode function_name) "") (< declared_index 0)) {
        if (!= call.arg_count 2) { return (nisa_fail (+ "I require two string operands for " function_name)) }
        let mut i: int = 0
        while (< i call.arg_count) {
            let argument: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start i))
            if (!= (nisa_expr_type parser argument.node_id argument.node_type) "string") {
                return (nisa_fail (+ "I require two string operands for " function_name))
            }
            set i (+ i 1)
        }
        return (+ (nisa_emit_call_args parser call) (nisa_line (nisa_string_binary_opcode function_name)))
    }
    if (== function_name "range") { return (nisa_fail "I require range inside a for loop") }
    if (== function_name "array_new") { return (nisa_emit_filled_array parser call) }
    if (nisa_is_set_call function_name) { return (nisa_emit_set_call parser call function_name) }
    if (== function_name "string_to_int") {
        if (!= call.arg_count 1) { return (nisa_fail "string_to_int needs one string argument") }
        let argument: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
        if (!= (nisa_expr_type parser argument.node_id argument.node_type) "string") {
            return (nisa_fail "string_to_int needs one string argument")
        }
        return (+ (nisa_emit_call_args parser call) (nisa_line "CAST_INT"))
    }
    if (!= (nisa_map_opcode function_name) "") { return (nisa_emit_map_call parser call function_name) }
    if (== function_name "float_to_string") {
        if (!= call.arg_count 1) { return (nisa_fail "I require one float to format") }
        let argument: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
        if (!= (nisa_expr_type parser argument.node_id argument.node_type) "float") {
            return (nisa_fail "I require a float to format")
        }
        let done: string = (nisa_fresh)
        let mut output: string = (+ (nisa_emit_expr parser argument.node_id argument.node_type) (nisa_line "CAST_STRING"))
        let markers: array<string> = [".", "e", "n", "i"]
        let mut index: int = 0
        while (< index 4) {
            set output (+ output (nisa_line "DUP"))
            set output (+ output (nisa_line_imm "PUSH_STR" (nisa_intern (at markers index))))
            set output (+ output (nisa_line "STR_CONTAINS"))
            set output (+ output (nisa_line_imm "JMP_TRUE" done))
            set index (+ index 1)
        }
        set output (+ output (nisa_line_imm "PUSH_STR" (nisa_intern ".0")))
        set output (+ output (nisa_line "STR_CONCAT"))
        return (+ output (nisa_label_line done))
    }
    let host_symbol: string = (nisa_call_host_symbol parser function_name)
    if (!= host_symbol "") { return (nisa_emit_host_call parser call host_symbol) }
    if (and (nisa_is_list_call function_name) (str_ends_with function_name "_new")) {
        if (!= call.arg_count 0) {
            return (nisa_fail "list_T_new needs 0 arguments")
        } else {
            return (nisa_line_imm "ARR_NEW" (nisa_list_element_tag parser function_name))
        }
    } else {
    if (or (== function_name "array_length") (and (nisa_is_list_call function_name) (str_ends_with function_name "_length"))) {
        if (!= call.arg_count 1) {
            return (nisa_fail "array_length needs 1 argument")
        } else {
            return (+ (nisa_emit_call_args parser call) (nisa_line "ARR_LEN"))
        }
    } else {
        if (or (== function_name "array_get") (or (== function_name "at") (and (nisa_is_list_call function_name) (str_ends_with function_name "_get")))) {
            if (!= call.arg_count 2) {
                return (nisa_fail "array_get needs 2 arguments")
            } else {
                if (== (nisa_access_result parser call) "") { return "" }
                return (+ (nisa_emit_call_args parser call) (nisa_line "ARR_GET"))
            }
        } else {
            if (or (== function_name "array_push") (and (nisa_is_list_call function_name) (str_ends_with function_name "_push"))) {
                return (nisa_emit_push_call parser call function_name)
            } else {
                if (== function_name "str_contains") {
                    if (!= call.arg_count 2) {
                        return (nisa_fail "str_contains needs 2 arguments")
                    } else {
                        return (+ (nisa_emit_call_args parser call) (nisa_line "STR_CONTAINS"))
                    }
                } else {
                    if (== function_name "int_to_string") {
                        if (!= call.arg_count 1) {
                            return (nisa_fail "int_to_string needs 1 argument")
                        } else {
                            return (+ (nisa_emit_call_args parser call) (nisa_line "CAST_STRING"))
                        }
                    } else {
                        if (== function_name "str_length") {
                            if (!= call.arg_count 1) {
                                return (nisa_fail "str_length needs 1 argument")
                            } else {
                                return (+ (nisa_emit_call_args parser call) (nisa_line "STR_LEN"))
                            }
                        } else {
                            if (== function_name "str_substring") {
                                if (!= call.arg_count 3) {
                                    return (nisa_fail "str_substring needs 3 arguments")
                                } else {
                                    return (+ (nisa_emit_call_args parser call) (nisa_line "STR_SUBSTR"))
                                }
                            } else {
                            if (or (== function_name "char_at") (== function_name "str_char_at")) {
                                if (!= call.arg_count 2) {
                                    return (nisa_fail "char_at needs 2 arguments")
                                } else {
                                    return (+ (nisa_emit_call_args parser call) (nisa_line "STR_CHAR_AT"))
                                }
                            } else {
                            if (== function_name "not") {
                                if (!= call.arg_count 1) {
                                    return (nisa_fail "not needs 1 argument")
                                } else {
                                    return (+ (nisa_emit_call_args parser call) (nisa_line "BOOL_NOT"))
                                }
                            } else {
                                if (nisa_is_print_builtin function_name) {
                                    if (!= call.arg_count 1) {
                                        return (nisa_fail "print needs 1 argument")
                                    } else {
                                        if (== function_name "println") {
                                            return (+ (nisa_emit_call_args parser call) (nisa_line "PRINTLN"))
                                        } else {
                                            return (+ (nisa_emit_call_args parser call) (nisa_line "PRINT"))
                                        }
                                    }
                                } else {
                                    if (< (nisa_fn_index parser function_name) 0) {
                                        return (nisa_fail (+ "undefined function " function_name))
                                    } else {
                                        (nisa_require_function (nisa_fn_index parser function_name))
                                        return (+ (nisa_emit_call_args parser call) (nisa_line_imm "CALL" function_name))
                                    }
                                }
                            }
                            }
                            }
                        }
                    }
                }
            }
        }
    }
    }
}

shadow nisa_emit_call {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n len3() -> int { let xs: array<int> = [1, 2, 3] return (array_length xs) } shadow len3 { assert true }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let block: ASTBlock = (parser_get_block p func.body)
    let declaration: ASTStmtRef = (list_ASTStmtRef_get block.statements 0)
    let initialized: string = (nisa_emit_stmt p declaration)
    assert (str_contains initialized "STORE_LOCAL 0")
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 1)
    let r: ASTReturn = (parser_get_return p stmt.node_id)
    let call: ASTCall = (parser_get_call p r.value)
    let text: string = (nisa_emit_call p call)
    assert (str_contains text "ARR_LEN")
    assert (str_contains text "LOAD_LOCAL 0")
    let joined: string = (nanoisa_emit_nasm (+ "f" "n main() -> string { return (str_concat \"a\" \"b\") }"))
    assert (str_contains joined "STR_CONCAT")
    let formatted: string = (nanoisa_emit_nasm "fn main() -> string { return (float_to_string 2.0) }")
    assert (str_contains formatted "CAST_STRING")
    assert (str_contains formatted "STR_CONTAINS")
    assert (str_contains formatted "JMP_TRUE")
    assert nisa_ok
    let _2: int = (nisa_reset)
}

fn nisa_float_mnemonic(op: int) -> string {
    if (== op LexerTokenType.TOKEN_PLUS) { return "F64_ADD" }
    if (== op LexerTokenType.TOKEN_MINUS) { return "F64_SUB" }
    if (== op LexerTokenType.TOKEN_STAR) { return "F64_MUL" }
    if (== op LexerTokenType.TOKEN_SLASH) { return "F64_DIV" }
    if (== op LexerTokenType.TOKEN_EQ) { return "F64_EQ" }
    if (== op LexerTokenType.TOKEN_NE) { return "F64_NE" }
    if (== op LexerTokenType.TOKEN_LT) { return "F64_LT" }
    if (== op LexerTokenType.TOKEN_LE) { return "F64_LE" }
    if (== op LexerTokenType.TOKEN_GT) { return "F64_GT" }
    if (== op LexerTokenType.TOKEN_GE) { return "F64_GE" }
    return ""
}
shadow nisa_float_mnemonic {
    assert (== (nisa_float_mnemonic LexerTokenType.TOKEN_PLUS) "F64_ADD")
    assert (== (nisa_float_mnemonic LexerTokenType.TOKEN_EQ) "F64_EQ")
    assert (== (nisa_float_mnemonic LexerTokenType.TOKEN_PERCENT) "")
}

fn nisa_emit_float_binary(parser: Parser, op: ASTBinaryOp, left_type: string, right_type: string) -> string {
    if (or (!= left_type "float") (!= right_type "float")) {
        return (nisa_fail "I require two float operands")
    }
    let mnemonic: string = (nisa_float_mnemonic op.op)
    if (== mnemonic "") { return (nisa_fail "I cannot apply this operator to floats") }
    let left: string = (nisa_emit_expr parser op.left op.left_type)
    let right: string = (nisa_emit_expr parser op.right op.right_type)
    return (+ left (+ right (nisa_line mnemonic)))
}
shadow nisa_emit_float_binary {
    let text: string = (nanoisa_emit_nasm "fn main() -> float { return (+ 1.5 2.0) }")
    assert (str_contains text "PUSH_F64 1.5")
    assert (str_contains text "F64_ADD")
}

fn nisa_emit_expr(parser: Parser, node_id: int, node_type: int) -> string {
    if (== node_type ParseNodeType.PNODE_FLOAT) {
        return (nisa_line_imm "PUSH_F64" (parser_get_float parser node_id).value)
    }
    if (== node_type ParseNodeType.PNODE_MODULE_QUALIFIED_CALL) {
        return (nisa_emit_call parser (nisa_get_call parser node_id node_type))
    }
    if (== node_type ParseNodeType.PNODE_NUMBER) {
        let num: ASTNumber = (parser_get_number parser node_id)
        return (nisa_line_imm "PUSH_I64" num.value)
    } else {
        if (== node_type ParseNodeType.PNODE_STRING) {
            let s: ASTString = (parser_get_string parser node_id)
            let name: string = (nisa_intern (nisa_decode_string s.value))
            return (nisa_line_imm "PUSH_STR" name)
        } else {
            if (== node_type ParseNodeType.PNODE_IDENTIFIER) {
                let id: ASTIdentifier = (parser_get_identifier parser node_id)
                let slot: int = (nisa_local_find id.name)
                if (< slot 0) {
                    let global: int = (nisa_global_find id.name id.line)
                    if (< global 0) { return (nisa_fail (+ "undefined binding " id.name)) }
                    return (nisa_line_imm "LOAD_GLOBAL" (int_to_string global))
                } else {
                    return (nisa_line_imm "LOAD_LOCAL" (int_to_string slot))
                }
            } else {
                if (== node_type ParseNodeType.PNODE_BINARY_OP) {
                    let binop: ASTBinaryOp = (parser_get_binary_op parser node_id)
                    let left_type: string = (nisa_expr_type parser binop.left binop.left_type)
                    let right_type: string = (nisa_expr_type parser binop.right binop.right_type)
                    if binop.is_unary {
                        let operand: string = (nisa_emit_expr parser binop.right binop.right_type)
                        if (== right_type "float") { return (+ operand (nisa_line "F64_NEG")) }
                        if (nisa_value_type_matches parser right_type "int") { return (+ operand (nisa_line "I64_NEG")) }
                        return (nisa_fail "I require a numeric unary operand")
                    }
                    if (or (== left_type "float") (== right_type "float")) {
                        return (nisa_emit_float_binary parser binop left_type right_type)
                    }
                    let left_s: bool = (nisa_expr_is_string parser binop.left binop.left_type)
                    let right_s: bool = (nisa_expr_is_string parser binop.right binop.right_type)
                    if (and left_s right_s) {
                        if (== binop.op LexerTokenType.TOKEN_PLUS) {
                            let left: string = (nisa_emit_expr parser binop.left binop.left_type)
                            let right: string = (nisa_emit_expr parser binop.right binop.right_type)
                            return (+ (+ left right) (nisa_line "STR_CONCAT"))
                        } else {
                            if (== binop.op LexerTokenType.TOKEN_EQ) {
                                let left: string = (nisa_emit_expr parser binop.left binop.left_type)
                                let right: string = (nisa_emit_expr parser binop.right binop.right_type)
                                return (+ (+ left right) (nisa_line "EQ"))
                            } else {
                                if (== binop.op LexerTokenType.TOKEN_NE) {
                                    let left: string = (nisa_emit_expr parser binop.left binop.left_type)
                                    let right: string = (nisa_emit_expr parser binop.right binop.right_type)
                                    return (+ (+ left right) (nisa_line "NE"))
                                } else {
                                    return (nisa_fail "unsupported string operator")
                                }
                            }
                        }
                    } else {
                        if (or left_s right_s) {
                            return (nisa_fail "string concat needs two strings")
                        } else {
                            let mut mnemonic: string = (nisa_binop_mnemonic binop.op)
                            if (or (== binop.op LexerTokenType.TOKEN_EQ) (== binop.op LexerTokenType.TOKEN_NE)) {
                                if (or (== left_type "bool") (== right_type "bool")) {
                                    if (!= left_type right_type) {
                                        return (nisa_fail "bool equality needs two bool operands")
                                    }
                                    if (== binop.op LexerTokenType.TOKEN_EQ) { set mnemonic "EQ" }
                                    else { set mnemonic "NE" }
                                }
                            }
                            if (== mnemonic "") {
                                return (nisa_fail "unsupported integer operator")
                            } else {
                                let left: string = (nisa_emit_expr parser binop.left binop.left_type)
                                let right: string = (nisa_emit_expr parser binop.right binop.right_type)
                                return (+ (+ left right) (nisa_line mnemonic))
                            }
                        }
                    }
                } else {
                    if (== node_type ParseNodeType.PNODE_CALL) {
                        let call: ASTCall = (parser_get_call parser node_id)
                        return (nisa_emit_call parser call)
                    } else {
                        if (== node_type ParseNodeType.PNODE_ARRAY_LITERAL) {
                            return (nisa_emit_array_literal parser node_id)
                        } else {
                            if (== node_type ParseNodeType.PNODE_STRUCT_LITERAL) {
                                return (nisa_emit_struct_literal parser node_id)
                            } else {
                                if (== node_type ParseNodeType.PNODE_FIELD_ACCESS) {
                                    return (nisa_emit_field_access parser node_id)
                                } else {
                                    if (== node_type ParseNodeType.PNODE_BOOL) {
                                        let bval: ASTBool = (parser_get_bool parser node_id)
                                        if bval.value {
                                            return (nisa_line_imm "PUSH_BOOL" "1")
                                        } else {
                                            return (nisa_line_imm "PUSH_BOOL" "0")
                                        }
                                    } else {
                                        if (== node_type ParseNodeType.PNODE_IF) {
                                            let inode: ASTIf = (parser_get_if parser node_id)
                                            if (< inode.else_body 0) {
                                                return (nisa_fail "if expression needs else")
                                            } else {
                                                let l_else: string = (nisa_fresh)
                                                let l_end: string = (nisa_fresh)
                                                let cnd_text: string = (nisa_emit_expr parser inode.condition inode.condition_type)
                                                let then_text: string = (nisa_emit_expr parser inode.then_body ParseNodeType.PNODE_BLOCK)
                                                let else_text: string = (nisa_emit_expr parser inode.else_body ParseNodeType.PNODE_BLOCK)
                                                let mut out: string = (+ cnd_text (nisa_line_imm "JMP_FALSE" l_else))
                                                set out (+ out then_text)
                                                set out (+ out (nisa_line_imm "JMP" l_end))
                                                set out (+ out (nisa_label_line l_else))
                                                set out (+ out else_text)
                                                set out (+ out (nisa_label_line l_end))
                                                return out
                                            }
                                        } else {
                                            if (== node_type ParseNodeType.PNODE_BLOCK) {
                                                let blk: ASTBlock = (parser_get_block parser node_id)
                                                if (!= (list_ASTStmtRef_length blk.statements) 1) {
                                                    return (nisa_fail "expression block needs 1 statement")
                                                } else {
                                                    let st: ASTStmtRef = (list_ASTStmtRef_get blk.statements 0)
                                                    return (nisa_emit_expr parser st.node_id st.node_type)
                                                }
                                            } else {
                                                return (nisa_fail "expression outside the pinned subset")
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

shadow nisa_emit_expr {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n main() -> int { return 7 } shadow main { assert (== (main) 7) }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let num: ASTNumber = (parser_get_number p 0)
    let text: string = (nisa_emit_expr p 0 ParseNodeType.PNODE_NUMBER)
    assert (str_contains text "PUSH_I64 7")
    assert (== num.value "7")
}

fn nisa_statements_fall_through(parser: Parser, statements: List<ASTStmtRef>) -> bool {
    let mut i: int = 0
    while (< i (list_ASTStmtRef_length statements)) {
        if (nisa_stmt_terminates parser (list_ASTStmtRef_get statements i)) { return false }
        set i (+ i 1)
    }
    return true
}
shadow nisa_statements_fall_through {
    let tokens: List<LexerToken> = (tokenize_string "fn main() -> int { unsafe { return 3 } return 4 }" "unsafe.nano" (diag_list_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "unsafe.nano")
    let block: ASTUnsafeBlock = (parser_get_unsafe_block parser 0)
    assert (not (nisa_statements_fall_through parser block.statements))
}

fn nisa_block_falls_through(parser: Parser, block_id: int) -> bool {
    if (< block_id 0) { return true }
    let block: ASTBlock = (parser_get_block parser block_id)
    return (nisa_statements_fall_through parser block.statements)
}

shadow nisa_block_falls_through {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n main() -> int { return 1 } shadow main { assert (== (main) 1) }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    assert (not (nisa_block_falls_through p func.body))
}

fn nisa_stmt_terminates(parser: Parser, stmt: ASTStmtRef) -> bool {
    if (== stmt.node_type ParseNodeType.PNODE_UNSAFE_BLOCK) {
        let block: ASTUnsafeBlock = (parser_get_unsafe_block parser stmt.node_id)
        return (not (nisa_statements_fall_through parser block.statements))
    }
    if (or (== stmt.node_type ParseNodeType.PNODE_RETURN)
                   (or (== stmt.node_type ParseNodeType.PNODE_BREAK)
                       (== stmt.node_type ParseNodeType.PNODE_CONTINUE))) {
        return true
    } else {
        if (== stmt.node_type ParseNodeType.PNODE_IF) {
            let node: ASTIf = (parser_get_if parser stmt.node_id)
            if (< node.else_body 0) {
                return false
            } else {
                return (and (not (nisa_block_falls_through parser node.then_body))
                            (not (nisa_block_falls_through parser node.else_body)))
            }
        } else {
            return false
        }
    }
}

shadow nisa_stmt_terminates {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n main() -> int { return 1 } shadow main { assert (== (main) 1) }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 0)
    assert (nisa_stmt_terminates p stmt)
}

fn nisa_emit_if(parser: Parser, node: ASTIf) -> string {
    let l_else: string = (nisa_fresh)
    let cnd_text: string = (nisa_emit_expr parser node.condition node.condition_type)
    let then_ft: bool = (nisa_block_falls_through parser node.then_body)
    let mut out: string = (+ cnd_text (nisa_line_imm "JMP_FALSE" l_else))
    set out (+ out (nisa_emit_block parser node.then_body))
    if (>= node.else_body 0) {
        if (== then_ft true) {
            let l_end: string = (nisa_fresh)
            set out (+ out (nisa_line_imm "JMP" l_end))
            set out (+ out (nisa_label_line l_else))
            set out (+ out (nisa_emit_block parser node.else_body))
            set out (+ out (nisa_label_line l_end))
            return out
        } else {
            set out (+ out (nisa_label_line l_else))
            set out (+ out (nisa_emit_block parser node.else_body))
            return out
        }
    } else {
        set out (+ out (nisa_label_line l_else))
        return out
    }
}

shadow nisa_emit_if {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n choose(c: int) -> int { if (> c 0) { return 1 } else { return 0 } } shadow choose { assert (== (choose 1) 1) }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    set nisa_names (array_push nisa_names "c")
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 0)
    let node: ASTIf = (parser_get_if p stmt.node_id)
    let text: string = (nisa_emit_if p node)
    assert (str_contains text "I64_GT_S")
    assert (str_contains text "JMP_FALSE")
}

fn nisa_emit_while(parser: Parser, w: ASTWhile) -> string {
    let l_top: string = (nisa_fresh)
    let l_end: string = (nisa_fresh)
    let outer_top: string = nisa_loop_top
    let outer_end: string = nisa_loop_end
    let outer_index: string = nisa_loop_index
    set nisa_loop_index ""
    set nisa_loop_top l_top
    set nisa_loop_end l_end
    let mut out: string = (nisa_label_line l_top)
    let mut unconditional: bool = false
    if (== w.condition_type ParseNodeType.PNODE_BOOL) {
        let condition: ASTBool = (parser_get_bool parser w.condition)
        set unconditional condition.value
    }
    if (not unconditional) {
        set out (+ out (nisa_emit_expr parser w.condition w.condition_type))
        set out (+ out (nisa_line_imm "JMP_FALSE" l_end))
    }
    set out (+ out (nisa_emit_block parser w.body))
    if (nisa_block_falls_through parser w.body) {
        set out (+ out (nisa_line_imm "JMP" l_top))
    } else {
        (print "")
    }
    set out (+ out (nisa_label_line l_end))
    set nisa_loop_top outer_top
    set nisa_loop_end outer_end
    set nisa_loop_index outer_index
    return out
}

shadow nisa_emit_while {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n loop_sum(n: int) -> int { let mut i: int = 0 while (< i n) { set i (+ i 1) } return i } shadow loop_sum { assert (== (loop_sum 1) 1) }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    set nisa_names (array_push nisa_names "n")
    set nisa_names (array_push nisa_names "i")
    set nisa_types ["int", "int"]
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 1)
    let w: ASTWhile = (parser_get_while p stmt.node_id)
    let text: string = (nisa_emit_while p w)
    assert (str_contains text "I64_LT_S")
    assert (str_contains text "JMP_FALSE")
    assert (str_contains text "JMP L")
}

fn nisa_emit_for(parser: Parser, loop: ASTFor) -> string {
    let container: string = (nisa_expr_type parser loop.iterable loop.iterable_type)
    let element: string = (nisa_element_type parser container)
    if (== element "") { return (nisa_fail "I require a supported array or list for iteration") }
    let mut text: string = ""
    if (or (== loop.iterable_type ParseNodeType.PNODE_CALL) (== loop.iterable_type ParseNodeType.PNODE_MODULE_QUALIFIED_CALL)) {
        let iterable: ASTCall = (nisa_get_call parser loop.iterable loop.iterable_type)
        if (== (nisa_call_name parser iterable) "range") { set text (nisa_emit_range parser iterable) }
        else { set text (nisa_emit_expr parser loop.iterable loop.iterable_type) }
    } else { set text (nisa_emit_expr parser loop.iterable loop.iterable_type) }
    let array_slot: string = (nisa_temp_local container)
    set text (+ text (nisa_line_imm "STORE_LOCAL" array_slot))
    set text (+ text (nisa_line_imm "PUSH_I64" "0"))
    let index_slot: string = (nisa_temp_local "int")
    set text (+ text (nisa_line_imm "STORE_LOCAL" index_slot))
    set text (+ text (nisa_line_imm "LOAD_LOCAL" array_slot))
    set text (+ text (nisa_line "ARR_LEN"))
    let length_slot: string = (nisa_temp_local "int")
    set text (+ text (nisa_line_imm "STORE_LOCAL" length_slot))
    let outer_top: string = nisa_loop_top
    let outer_end: string = nisa_loop_end
    let outer_index: string = nisa_loop_index
    let top: string = (nisa_fresh)
    let end: string = (nisa_fresh)
    set nisa_loop_top top
    set nisa_loop_end end
    set nisa_loop_index index_slot
    set text (+ text (nisa_label_line top))
    set text (+ text (nisa_line_imm "LOAD_LOCAL" index_slot))
    set text (+ text (nisa_line_imm "LOAD_LOCAL" length_slot))
    set text (+ text (nisa_line "LT"))
    set text (+ text (nisa_line_imm "JMP_FALSE" end))
    set text (+ text (nisa_line_imm "LOAD_LOCAL" array_slot))
    set text (+ text (nisa_line_imm "LOAD_LOCAL" index_slot))
    set text (+ text (nisa_line "ARR_GET"))
    let variable_slot: int = (array_length nisa_names)
    set nisa_names (array_push nisa_names loop.var_name)
    set nisa_types (array_push nisa_types element)
    set text (+ text (nisa_line_imm "STORE_LOCAL" (int_to_string variable_slot)))
    set text (+ text (nisa_emit_block parser loop.body))
    if (nisa_block_falls_through parser loop.body) {
        set text (+ text (nisa_increment_local index_slot))
        set text (+ text (nisa_line_imm "JMP" top))
    }
    set text (+ text (nisa_label_line end))
    (array_set nisa_names variable_slot "")
    set nisa_loop_top outer_top
    set nisa_loop_end outer_end
    set nisa_loop_index outer_index
    return text
}
shadow nisa_emit_for {
    let text: string = (nanoisa_emit_nasm "fn main() -> int { let index: int = 20 for index in (range 0 2) { continue } return index }")
    assert (str_contains text "ARR_GET")
    assert (str_contains text "LOAD_LOCAL 0\n  RET")
    assert (== nisa_loop_index "")
}

fn nisa_emit_assert(parser: Parser, node: ASTAssert) -> string {
    let ok_text: string = (nisa_emit_expr parser node.condition node.condition_type)
    return (+ ok_text (nisa_line "ASSERT"))
}

shadow nisa_emit_assert {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n prove(b: bool) -> int { assert b return 0 } shadow prove { assert true }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    set nisa_names (array_push nisa_names "b")
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 0)
    let node: ASTAssert = (parser_get_assert p stmt.node_id)
    let text: string = (nisa_emit_assert p node)
    assert (str_contains text "LOAD_LOCAL 0")
    assert (str_contains text "ASSERT")
}

# I describe the emitted stack effect; list push still needs its trailing POP.
fn nisa_call_has_result(parser: Parser, call: ASTCall) -> bool {
    let name: string = (nisa_call_name parser call)
    if (nisa_is_print_builtin name) { return false }
    if (nisa_is_set_call name) { return false }
    if (== (nisa_map_opcode name) "HM_SET") { return false }
    let index: int = (nisa_call_index parser call)
    if (< index 0) { return true }
    let function: ASTFunction = (parser_get_function parser index)
    return (!= function.return_type "void")
}

shadow nisa_call_has_result {
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let source: string = (+ "f" "n nop() -> void {} fn value() -> int { return 1 } fn main() -> int { (nop) (print \"x\") return (value) }")
    let tokens: List<LexerToken> = (tokenize_string source "t.nano" diags)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "t.nano")
    assert (not (nisa_call_has_result parser (parser_get_call parser 0)))
    assert (not (nisa_call_has_result parser (parser_get_call parser 1)))
    assert (nisa_call_has_result parser (parser_get_call parser 2))
}

fn nisa_emit_stmt(parser: Parser, stmt: ASTStmtRef) -> string {
    if (== stmt.node_type ParseNodeType.PNODE_FOR) {
        return (nisa_emit_for parser (parser_get_for parser stmt.node_id))
    }
    if (== stmt.node_type ParseNodeType.PNODE_UNSAFE_BLOCK) {
        let block: ASTUnsafeBlock = (parser_get_unsafe_block parser stmt.node_id)
        return (nisa_emit_statements parser block.statements)
    }
    if (== stmt.node_type ParseNodeType.PNODE_BREAK) {
        if (== nisa_loop_end "") { return (nisa_fail "break needs an enclosing loop") }
        return (nisa_line_imm "JMP" nisa_loop_end)
    }
    if (== stmt.node_type ParseNodeType.PNODE_CONTINUE) {
        if (== nisa_loop_top "") { return (nisa_fail "continue needs an enclosing loop") }
        let mut step: string = ""
        if (!= nisa_loop_index "") { set step (nisa_increment_local nisa_loop_index) }
        return (+ step (nisa_line_imm "JMP" nisa_loop_top))
    }
    if (== stmt.node_type ParseNodeType.PNODE_RETURN) {
        let r: ASTReturn = (parser_get_return parser stmt.node_id)
        if (< r.value 0) {
            if nisa_void_return { return (nisa_line "RET") }
            return (nisa_fail "a value-result function needs a return value")
        }
        if (and (!= (nisa_map_value_type nisa_return_type) "")
                (and (not (nisa_is_map_constructor parser r.value r.value_type))
                     (!= (nisa_expr_type parser r.value r.value_type) nisa_return_type))) {
            return (nisa_fail "I require the declared map return type")
        }
        if (or (== r.value_type ParseNodeType.PNODE_CALL) (== r.value_type ParseNodeType.PNODE_MODULE_QUALIFIED_CALL)) {
            let result_call: ASTCall = (nisa_get_call parser r.value r.value_type)
            let result_type: string = (nisa_expr_type parser r.value r.value_type)
            if (and (or (== nisa_return_type "float") (== result_type "float")) (!= result_type nisa_return_type)) {
                return (nisa_fail "I require the declared float return type")
            }
            if (== nisa_void_return (nisa_call_has_result parser result_call)) {
                return (nisa_fail "return call result count does not match my function")
            }
        } else {
            if nisa_void_return { return (nisa_fail "a void function cannot return a value") }
        }
        if (or (== r.value_type ParseNodeType.PNODE_CALL) (== r.value_type ParseNodeType.PNODE_MODULE_QUALIFIED_CALL)) {
            let call: ASTCall = (nisa_get_call parser r.value r.value_type)
            if (and (!= call.function_type ParseNodeType.PNODE_IDENTIFIER) (!= call.function_type ParseNodeType.PNODE_MODULE_QUALIFIED_CALL)) {
                return (+ (nisa_emit_call parser call) (nisa_line "RET"))
            } else {
                let function_name: string = (nisa_call_name parser call)
                let call_index: int = (nisa_call_index parser call)
                if (and (>= call_index 0) (>= (nisa_artifact_arity function_name) 0)) {
                    if (< (parser_get_function parser call_index).body 0) {
                        return (+ (nisa_emit_call parser call) (nisa_line "RET"))
                    }
                }
                if (and (== function_name "map_new") (< call_index 0)) {
                    return (+ (nisa_emit_expected_expr parser r.value r.value_type nisa_return_type) (nisa_line "RET"))
                }
                if (and (!= (nisa_string_binary_opcode function_name) "") (< call_index 0)) {
                    return (+ (nisa_emit_call parser call) (nisa_line "RET"))
                }
                if (>= call_index 0) {
                    if (nisa_metadata_function (parser_get_function parser call_index)) {
                        return (+ (nisa_emit_call parser call) (nisa_line "RET"))
                    }
                }
                if (or (nisa_is_inline_call function_name) (!= (nisa_call_host_symbol parser function_name) "")) {
                    return (+ (nisa_emit_call parser call) (nisa_line "RET"))
                } else {
                    if (< (nisa_fn_index parser function_name) 0) {
                        return (nisa_fail (+ "undefined function " function_name))
                    } else {
                        (nisa_require_function (nisa_fn_index parser function_name))
                        return (+ (nisa_emit_call_args parser call) (nisa_line_imm "TAIL_CALL" function_name))
                    }
                }
            }
        } else {
            let val: string = (nisa_emit_expected_expr parser r.value r.value_type nisa_return_type)
            return (+ val (nisa_line "RET"))
        }
    } else {
        if (== stmt.node_type ParseNodeType.PNODE_LET) {
            let l: ASTLet = (parser_get_let parser stmt.node_id)
            let val: string = (nisa_emit_expected_expr parser l.value l.value_type l.var_type)
            if (not (nisa_type_ok parser l.var_type)) {
                return (nisa_fail (+ "unsupported local type " l.var_type))
            } else {
                set nisa_names (array_push nisa_names l.name)
                set nisa_types (array_push nisa_types l.var_type)
                let slot: int = (- (array_length nisa_names) 1)
                return (+ val (nisa_line_imm "STORE_LOCAL" (int_to_string slot)))
            }
        } else {
            if (== stmt.node_type ParseNodeType.PNODE_SET) {
                let s: ASTSet = (parser_get_set parser stmt.node_id)
                if (!= s.field_name "") {
                    return (nisa_fail "I require reference IR before lowering field-place assignment")
                }
                let slot: int = (nisa_local_find s.target)
                if (< slot 0) {
                    let global: int = (nisa_global_find s.target s.line)
                    if (< global 0) { return (nisa_fail (+ "undefined binding " s.target)) }
                    let declaration: ASTLet = (parser_get_let parser (at nisa_global_nodes global))
                    if (not declaration.is_mut) { return (nisa_fail (+ "I cannot assign this immutable global: " s.target)) }
                    let value: string = (nisa_emit_expected_expr parser s.value s.value_type (at nisa_global_types global))
                    return (+ value (nisa_line_imm "STORE_GLOBAL" (int_to_string global)))
                } else {
                    let val: string = (nisa_emit_expected_expr parser s.value s.value_type (at nisa_types slot))
                    return (+ val (nisa_line_imm "STORE_LOCAL" (int_to_string slot)))
                }
            } else {
                if (== stmt.node_type ParseNodeType.PNODE_IF) {
                    let node: ASTIf = (parser_get_if parser stmt.node_id)
                    return (nisa_emit_if parser node)
                } else {
                    if (== stmt.node_type ParseNodeType.PNODE_WHILE) {
                        let w: ASTWhile = (parser_get_while parser stmt.node_id)
                        return (nisa_emit_while parser w)
                    } else {
                        if (== stmt.node_type ParseNodeType.PNODE_ASSERT) {
                            let node: ASTAssert = (parser_get_assert parser stmt.node_id)
                            return (nisa_emit_assert parser node)
                        } else {
                        if (or (== stmt.node_type ParseNodeType.PNODE_CALL) (== stmt.node_type ParseNodeType.PNODE_MODULE_QUALIFIED_CALL)) {
                            let call: ASTCall = (nisa_get_call parser stmt.node_id stmt.node_type)
                            if (not (nisa_call_has_result parser call)) {
                                return (nisa_emit_call parser call)
                            }
                            let expr: string = (nisa_emit_expr parser stmt.node_id stmt.node_type)
                            return (+ expr (nisa_line "POP"))
                        } else {
                            if (or (== stmt.node_type ParseNodeType.PNODE_NUMBER)
                                   (or (== stmt.node_type ParseNodeType.PNODE_IDENTIFIER)
                                       (or (== stmt.node_type ParseNodeType.PNODE_BINARY_OP)
                                           (== stmt.node_type ParseNodeType.PNODE_BOOL)))) {
                                let expr: string = (nisa_emit_expr parser stmt.node_id stmt.node_type)
                                return (+ expr (nisa_line "POP"))
                            } else {
                                return (nisa_fail "statement outside the pinned subset")
                            }
                        }
                    }
                    }
                }
            }
        }
    }
}

shadow nisa_emit_stmt {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n main() -> int { return 1 } shadow main { assert (== (main) 1) }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 0)
    let text: string = (nisa_emit_stmt p stmt)
    assert (str_contains text "RET")
    let joined: string = (nanoisa_emit_nasm (+ "f" "n main() -> string { return (str_concat \"a\" \"b\") }"))
    assert (str_contains joined "STR_CONCAT\n  RET")
    assert nisa_ok
}

fn nisa_emit_statements(parser: Parser, statements: List<ASTStmtRef>) -> string {
    let first_slot: int = (array_length nisa_names)
    let mut out: string = ""
    let mut i: int = 0
    while (< i (list_ASTStmtRef_length statements)) {
        let stmt: ASTStmtRef = (list_ASTStmtRef_get statements i)
        set out (+ out (nisa_emit_stmt parser stmt))
        if (nisa_stmt_terminates parser stmt) { break }
        set i (+ i 1)
    }
    # I retain allocated slots but hide names that leave this lexical block.
    let mut names: array<string> = []
    let mut slot: int = 0
    while (< slot (array_length nisa_names)) {
        if (< slot first_slot) {
            set names (array_push names (at nisa_names slot))
        } else {
            set names (array_push names "")
        }
        set slot (+ slot 1)
    }
    set nisa_names names
    return out
}
shadow nisa_emit_statements {
    let _: int = (nisa_reset)
    let tokens: List<LexerToken> = (tokenize_string "fn main() -> int { unsafe { return 3 return 4 } }" "unsafe.nano" (diag_list_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "unsafe.nano")
    let block: ASTUnsafeBlock = (parser_get_unsafe_block parser 0)
    let text: string = (nisa_emit_statements parser block.statements)
    assert (str_contains text "PUSH_I64 3")
    assert (not (str_contains text "PUSH_I64 4"))
}

fn nisa_emit_block(parser: Parser, block_id: int) -> string {
    if (< block_id 0) { return (nisa_fail "missing function body") }
    let block: ASTBlock = (parser_get_block parser block_id)
    return (nisa_emit_statements parser block.statements)
}

shadow nisa_emit_block {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n main() -> int { return 3 } shadow main { assert (== (main) 3) }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let text: string = (nisa_emit_block p func.body)
    assert (str_contains text "PUSH_I64 3")
}

fn nisa_result_tag(parser: Parser, t: string) -> string {
    if (== t "float") { return "float" }
    if (>= (nisa_enum_index parser t) 0) { return "int" }
    if (and (str_starts_with t "array<") (nisa_type_ok parser t)) { return "array" }
    if (!= (nisa_map_value_type t) "") { return "hashmap" }
    if (or (== t "void") (or (== t "int") (or (== t "string") (== t "bool")))) {
        return t
    } else {
        if (and (str_starts_with t "List<") (str_ends_with t ">")) {
            let inner: string = (str_substring t 5 (- (str_length t) 6))
            if (or (>= (nisa_enum_index parser inner) 0) (nisa_is_pin_record parser inner)) {
                return "array"
            } else {
                return ""
            }
        } else {
            if (nisa_is_pin_record parser t) {
                return "struct"
            } else {
                return ""
            }
        }
    }
}

shadow nisa_result_tag {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "struct Tok { t: int, s: string, flag: bool } struct Box { p: Tok } " (+ "f" "n main() -> int { return 0 } shadow main { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (== (nisa_result_tag p "void") "void")
    assert (== (nisa_result_tag p "Tok") "struct")
    assert (== (nisa_result_tag p "Box") "struct")
    assert (== (nisa_result_tag p "List<Tok>") "array")
    assert (== (nisa_result_tag p "List<Box>") "array")
}

fn nisa_emit_function(parser: Parser, func: ASTFunction) -> string {
    set nisa_names []
    set nisa_types []
    let result_tag: string = (nisa_result_tag parser func.return_type)
    set nisa_void_return (== func.return_type "void")
    set nisa_return_type func.return_type
    set nisa_loop_top ""
    set nisa_loop_end ""
    set nisa_loop_index ""
    if (== result_tag "") {
        return (nisa_fail (+ "unsupported result type " func.return_type))
    } else {
        let mut i: int = 0
        while (< i func.param_count) {
            let plet: ASTLet = (parser_get_let parser (+ func.param_start i))
            if (not (nisa_type_ok parser plet.var_type)) {
                return (nisa_fail (+ "unsupported param type " plet.var_type))
            } else {
                set nisa_names (array_push nisa_names plet.name)
                set nisa_types (array_push nisa_types plet.var_type)
                set i (+ i 1)
            }
        }
        let mut body: string = (nisa_emit_block parser func.body)
        if (nisa_block_falls_through parser func.body) {
            set body (+ body (nisa_line "RET"))
        } else {
            (print "")
        }
        let locals: int = (array_length nisa_names)
        let mut header: string = ".function "
        set header (+ header func.name)
        set header (+ header " ")
        set header (+ header (int_to_string func.param_count))
        set header (+ header " ")
        set header (+ header (int_to_string locals))
        set header (+ header " 0 ")
        set header (+ header result_tag)
        if nisa_void_return {
            set header (+ header " 0\n")
        } else {
            set header (+ header " 1\n")
        }
        return (+ (+ header body) ".end\n")
    }
}

shadow nisa_emit_function {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n add(a: int, b: int) -> int { return (+ a b) } shadow add { assert (== (add 2 3) 5) }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let text: string = (nisa_emit_function p func)
    assert (str_contains text ".function add 2 2 0 int 1")
    assert (str_contains text "I64_ADD")
    assert (str_contains text "LOAD_LOCAL 0")
    assert (str_contains text "LOAD_LOCAL 1")
    let src2: string = (+ "f" "n greeting() -> string { return \"hi\" } shadow greeting { assert true }")
    let toks2: List<LexerToken> = (tokenize_string src2 "t.nano" diags)
    let p2: Parser = (parse_program toks2 (list_LexerToken_length toks2) "t.nano")
    let gfn: ASTFunction = (parser_get_function p2 0)
    let gtext: string = (nisa_emit_function p2 gfn)
    assert (str_contains gtext ".function greeting 0 0 0 string 1")
    assert (str_contains gtext "PUSH_STR s0")
    let src3: string = (+ "f" "n glue(a: string, b: string) -> string { return (+ a b) } shadow glue { assert true }")
    let toks3: List<LexerToken> = (tokenize_string src3 "t.nano" diags)
