fn nisa_os_arity(name: string) -> int {
    if (== name "getcwd") {
        return 0
    }
    if (== name "tmp_dir") {
        return 0
    }
    if (== name "get_argc") {
        return 0
    }
    if (== name "chdir") {
        return 1
    }
    if (== name "file_read") {
        return 1
    }
    if (== name "file_exists") {
        return 1
    }
    if (== name "dir_exists") {
        return 1
    }
    if (== name "dir_create") {
        return 1
    }
    if (== name "dir_list") {
        return 1
    }
    if (== name "mktemp") {
        return 1
    }
    if (== name "mktemp_dir") {
        return 1
    }
    if (== name "getenv") {
        return 1
    }
    if (== name "process_run") {
        return 1
    }
    if (== name "system") {
        return 1
    }
    if (== name "get_argv") {
        return 1
    }
    if (== name "string_from_char") {
        return 1
    }
    if (== name "file_write") {
        return 2
    }
    if (== name "setenv") {
        return 2
    }
    if (== name "str_index_of") {
        return 2
    }
    return (- 0 1)
}

