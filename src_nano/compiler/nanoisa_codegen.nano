fn nisa_emit_stmt(parser: Parser, stmt: ASTStmtRef) -> string {
    if (== stmt.node_type ParseNodeType.PNODE_RETURN) {
        let r: ASTReturn = (parser_get_return parser stmt.node_id)
        if (== r.value_type ParseNodeType.PNODE_CALL) {
            let call: ASTCall = (parser_get_call parser r.value)
            let func_id: ASTIdentifier = (parser_get_identifier parser call.function)
            if (nisa_is_inline_call func_id.name) {
                return (+ (nisa_emit_call parser call) (nisa_line "RET"))
            } else {
                if (< (nisa_fn_index parser func_id.name) 0) {
                    return (nisa_fail (+ "undefined function " func_id.name))
                } else {
                    return (+ (nisa_emit_call_args parser call) (nisa_line_imm "TAIL_CALL" func_id.name))
                }
            }
        } else {
            let val: string = (nisa_emit_expr parser r.value r.value_type)
            return (+ val (nisa_line "RET"))
        }
    } else {
        if (== stmt.node_type ParseNodeType.PNODE_LET) {
            let l: ASTLet = (parser_get_let parser stmt.node_id)
            let val: string = (nisa_emit_expr parser l.value l.value_type)
            if (not (nisa_type_ok parser l.var_type)) {
                return (nisa_fail (+ "unsupported local type " l.var_type))
            } else {
                set nisa_names (array_push nisa_names l.name)
                set nisa_types (array_push nisa_types l.var_type)
                let slot: int = (- (array_length nisa_names) 1)
                return (+ val (nisa_line_imm "STORE_LOCAL" (int_to_string slot)))
            }
        } else {
            if (== stmt.node_type ParseNodeType.PNODE_SET) {
                let s: ASTSet = (parser_get_set parser stmt.node_id)
                let slot: int = (nisa_local_find s.target)
                if (< slot 0) {
                    return (nisa_fail (+ "undefined local " s.target))
                } else {
                    let val: string = (nisa_emit_expr parser s.value s.value_type)
                    return (+ val (nisa_line_imm "STORE_LOCAL" (int_to_string slot)))
                }
            } else {
                if (== stmt.node_type ParseNodeType.PNODE_IF) {
                    let node: ASTIf = (parser_get_if parser stmt.node_id)
                    return (nisa_emit_if parser node)
                } else {
                    if (== stmt.node_type ParseNodeType.PNODE_WHILE) {
                        let w: ASTWhile = (parser_get_while parser stmt.node_id)
                        return (nisa_emit_while parser w)
                    } else {
                        if (== stmt.node_type ParseNodeType.PNODE_ASSERT) {
                            let node: ASTAssert = (parser_get_assert parser stmt.node_id)
                            return (nisa_emit_assert parser node)
                        } else {
                        if (== stmt.node_type ParseNodeType.PNODE_CALL) {
                            let call: ASTCall = (parser_get_call parser stmt.node_id)
                            let func_id: ASTIdentifier = (parser_get_identifier parser call.function)
                            if (nisa_is_print_builtin func_id.name) {
                                return (nisa_emit_call parser call)
                            } else {
                                let expr: string = (nisa_emit_expr parser stmt.node_id stmt.node_type)
                                return (+ expr (nisa_line "POP"))
                            }
                        } else {
                            if (or (== stmt.node_type ParseNodeType.PNODE_NUMBER)
                                   (or (== stmt.node_type ParseNodeType.PNODE_IDENTIFIER)
                                       (or (== stmt.node_type ParseNodeType.PNODE_BINARY_OP)
                                           (== stmt.node_type ParseNodeType.PNODE_BOOL)))) {
                                let expr: string = (nisa_emit_expr parser stmt.node_id stmt.node_type)
                                return (+ expr (nisa_line "POP"))
                            } else {
                                return (nisa_fail "statement outside the pinned subset")
                            }
                        }
                    }
                    }
                }
            }
        }
    }
}

shadow nisa_emit_stmt {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n main() -> int { return 1 } shadow main { assert (== (main) 1) }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 0)
    let text: string = (nisa_emit_stmt p stmt)
    assert (str_contains text "RET")
}

fn nisa_emit_block(parser: Parser, block_id: int) -> string {
    if (< block_id 0) {
        return (nisa_fail "missing function body")
    } else {
        let block: ASTBlock = (parser_get_block parser block_id)
        let n: int = (list_ASTStmtRef_length block.statements)
        let mut out: string = ""
        let mut i: int = 0
        while (< i n) {
            let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements i)
            set out (+ out (nisa_emit_stmt parser stmt))
            if (nisa_stmt_terminates parser stmt) {
                break
            } else {
                set i (+ i 1)
            }
        }
        return out
    }
}

shadow nisa_emit_block {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n main() -> int { return 3 } shadow main { assert (== (main) 3) }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let text: string = (nisa_emit_block p func.body)
    assert (str_contains text "PUSH_I64 3")
}

fn nisa_emit_function(parser: Parser, func: ASTFunction) -> string {
    set nisa_names []
    set nisa_types []
    if (and (not (== func.return_type "int")) (and (not (== func.return_type "string")) (not (== func.return_type "bool")))) {
        return (nisa_fail (+ "unsupported result type " func.return_type))
    } else {
        let mut i: int = 0
        while (< i func.param_count) {
            let plet: ASTLet = (parser_get_let parser (+ func.param_start i))
            if (not (nisa_type_ok parser plet.var_type)) {
                return (nisa_fail (+ "unsupported param type " plet.var_type))
            } else {
                set nisa_names (array_push nisa_names plet.name)
                set nisa_types (array_push nisa_types plet.var_type)
                set i (+ i 1)
            }
        }
        let mut body: string = (nisa_emit_block parser func.body)
        if (nisa_block_falls_through parser func.body) {
            set body (+ body (nisa_line "RET"))
        } else {
            (print "")
        }
        let locals: int = (array_length nisa_names)
        let mut header: string = ".function "
        set header (+ header func.name)
        set header (+ header " ")
        set header (+ header (int_to_string func.param_count))
        set header (+ header " ")
        set header (+ header (int_to_string locals))
        set header (+ header " 0 ")
        set header (+ header func.return_type)
        set header (+ header " 1\n")
        return (+ (+ header body) ".end\n")
    }
}

