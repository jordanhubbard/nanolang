    let src50: string = (+ "struct Tok { t: int, s: string } " (+ "f" "n one_t() -> List<Tok> { let xs: List<Tok> = (list_Tok_new) (list_Tok_push xs Tok { t: 1, s: \"hi\" }) return xs } shadow one_t { assert true }"))
    let toks50: List<LexerToken> = (tokenize_string src50 "t.nano" diags)
    let p50: Parser = (parse_program toks50 (list_LexerToken_length toks50) "t.nano")
    let one_t_fn: ASTFunction = (parser_get_function p50 0)
    let one_t_text: string = (nisa_emit_function p50 one_t_fn)
    assert (str_contains one_t_text ".function one_t 0 1 0 array 1")
    assert (str_contains one_t_text "ARR_NEW")
    assert (str_contains one_t_text "ARR_PUSH")
    assert (str_contains one_t_text "POP")
    assert (str_contains one_t_text "RET")
    let src51: string = (+ "struct Tok { t: int, s: string } " (+ (+ "f" "n one_t() -> List<Tok> { let xs: List<Tok> = (list_Tok_new) (list_Tok_push xs Tok { t: 1, s: \"hi\" }) return xs } ") (+ "f" "n via_one_t() -> int { let xs: List<Tok> = (one_t) let p: Tok = (list_Tok_get xs 0) return (str_length p.s) } shadow one_t { assert true } shadow via_one_t { assert true }")))
    let toks51: List<LexerToken> = (tokenize_string src51 "t.nano" diags)
    let p51: Parser = (parse_program toks51 (list_LexerToken_length toks51) "t.nano")
    let via_one_t_fn: ASTFunction = (parser_get_function p51 1)
    let via_one_t_text: string = (nisa_emit_function p51 via_one_t_fn)
    assert (str_contains via_one_t_text ".function via_one_t 0 2 0 int 1")
    assert (str_contains via_one_t_text "CALL one_t")
    assert (str_contains via_one_t_text "ARR_GET")
    assert (str_contains via_one_t_text "AGG_GET 1")
    assert (str_contains via_one_t_text "STR_LEN")
    let src52: string = (+ "struct LexerToken { token_type: int, value: string, line: int, column: int } " (+ "f" "n one_lex() -> List<LexerToken> { let xs: List<LexerToken> = (list_LexerToken_new) (list_LexerToken_push xs LexerToken { token_type: 1, value: \"hi\", line: 2, column: 3 }) return xs } shadow one_lex { assert true }"))
    let toks52: List<LexerToken> = (tokenize_string src52 "t.nano" diags)
    let p52: Parser = (parse_program toks52 (list_LexerToken_length toks52) "t.nano")
    let one_lex_fn: ASTFunction = (parser_get_function p52 0)
    let one_lex_text: string = (nisa_emit_function p52 one_lex_fn)
    assert (str_contains one_lex_text ".function one_lex 0 1 0 array 1")
    assert (str_contains one_lex_text "ARR_NEW")
    assert (str_contains one_lex_text "ARR_PUSH")
    assert (str_contains one_lex_text "AGG_PACK 0 0 0 4")
    assert (str_contains one_lex_text "POP")
    let src53: string = (+ "struct LexerToken { token_type: int, value: string, line: int, column: int } " (+ (+ "f" "n one_lex() -> List<LexerToken> { let xs: List<LexerToken> = (list_LexerToken_new) (list_LexerToken_push xs LexerToken { token_type: 1, value: \"hi\", line: 2, column: 3 }) return xs } ") (+ "f" "n via_one_lex() -> int { let xs: List<LexerToken> = (one_lex) let t: LexerToken = (list_LexerToken_get xs 0) return (str_length t.value) } shadow one_lex { assert true } shadow via_one_lex { assert true }")))
    let toks53: List<LexerToken> = (tokenize_string src53 "t.nano" diags)
