fn nisa_os_ret(name: string) -> string {
    if (== name "getcwd") {
        return "string"
    }
    if (== name "file_read") {
        return "string"
    }
    if (== name "tmp_dir") {
        return "string"
    }
    if (== name "mktemp") {
        return "string"
    }
    if (== name "mktemp_dir") {
        return "string"
    }
    if (== name "getenv") {
        return "string"
    }
    if (== name "file_exists") {
        return "bool"
    }
    if (== name "dir_exists") {
        return "bool"
    }
    if (== name "chdir") {
        return "int"
    }
    if (== name "file_write") {
        return "int"
    }
    if (== name "dir_create") {
        return "int"
    }
    if (== name "setenv") {
        return "int"
    }
    if (== name "str_index_of") {
        return "int"
    }
    if (== name "dir_list") {
        return "array"
    }
    if (== name "process_run") {
        return "array"
    }
    if (== name "system") {
        return "int"
    }
    if (== name "get_argc") {
        return "int"
    }
    if (== name "get_argv") {
        return "string"
    }
    if (== name "string_from_char") {
        return "string"
    }
    return ""
}

