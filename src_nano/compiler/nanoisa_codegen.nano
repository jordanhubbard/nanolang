    assert (str_contains via_one_lex_text ".function via_one_lex 0 2 0 int 1")
    assert (str_contains via_one_lex_text "CALL one_lex")
    assert (str_contains via_one_lex_text "ARR_GET")
    assert (str_contains via_one_lex_text "AGG_GET 1")
    assert (str_contains via_one_lex_text "STR_LEN")
    let src54: string = (+ "f" "n in_az(c: int) -> bool { return (and (>= c 65) (<= c 90)) } shadow in_az { assert true }")
    let toks54: List<LexerToken> = (tokenize_string src54 "t.nano" diags)
