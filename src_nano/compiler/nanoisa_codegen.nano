fn nisa_os_params(arity: int) -> string {
    if (== arity 0) {
        return ""
    }
    if (== arity 1) {
        return "string"
    }
    if (== arity 2) {
        return "string string"
    }
    return ""
}

shadow nisa_os_params {
    assert (== (nisa_os_params 0) "")
    assert (== (nisa_os_params 1) "string")
    assert (== (nisa_os_params 2) "string string")
    assert (== (nisa_os_params 3) "")
}

fn nisa_os_param_tags(name: string) -> string {
    if (or (== name "get_argv") (== name "string_from_char")) {
        return "int"
    } else {
        return (nisa_os_params (nisa_os_arity name))
    }
}

shadow nisa_os_param_tags {
    assert (== (nisa_os_param_tags "getcwd") "")
    assert (== (nisa_os_param_tags "get_argc") "")
    assert (== (nisa_os_param_tags "system") "string")
    assert (== (nisa_os_param_tags "get_argv") "int")
    assert (== (nisa_os_param_tags "string_from_char") "int")
    assert (== (nisa_os_param_tags "getenv") "string")
}

fn nisa_ext_index(sym: string) -> int {
    let n: int = (array_length nisa_ext_syms)
    let mut i: int = 0
    while (< i n) {
        if (== (at nisa_ext_syms i) sym) {
            return i
        } else {
            set i (+ i 1)
        }
    }
    return (- 0 1)
}

shadow nisa_ext_index {
    let _: int = (nisa_reset)
    assert (== (nisa_ext_index "vm_getcwd") (- 0 1))
}

fn nisa_ensure_extern(sym: string, ret: string, params: string) -> int {
    let idx: int = (nisa_ext_index sym)
    if (>= idx 0) {
        return idx
    } else {
        set nisa_ext_syms (array_push nisa_ext_syms sym)
        set nisa_ext_rets (array_push nisa_ext_rets ret)
        set nisa_ext_params (array_push nisa_ext_params params)
        return (- (array_length nisa_ext_syms) 1)
    }
}

shadow nisa_ensure_extern {
    let _: int = (nisa_reset)
    let a: int = (nisa_ensure_extern "vm_getcwd" "string" "")
    let b: int = (nisa_ensure_extern "vm_getcwd" "string" "")
    assert (== a 0)
    assert (== b 0)
}

fn nisa_is_host_call(parser: Parser, name: string) -> bool {
    if (!= (nisa_os_sym name) "") {
        return true
    } else {
        if (!= (nisa_math_arity name) 0) {
            return true
        } else {
        let idx: int = (nisa_fn_index parser name)
        if (< idx 0) {
            return false
        } else {
            let fd: ASTFunction = (parser_get_function parser idx)
            return (< fd.body 0)
        }
        }
    }
}

shadow nisa_is_host_call {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n add(a: int, b: int) -> int { return (+ a b) } shadow add { assert true }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (nisa_is_host_call p "getcwd")
    assert (nisa_is_host_call p "file_exists")
    assert (nisa_is_host_call p "tmp_dir")
    assert (nisa_is_host_call p "file_read")
    assert (nisa_is_host_call p "system")
    assert (nisa_is_host_call p "get_argc")
    assert (nisa_is_host_call p "get_argv")
    assert (nisa_is_host_call p "sqrt")
    assert (nisa_is_host_call p "string_from_char")
    assert (nisa_is_host_call p "pow")
    assert (not (nisa_is_host_call p "add"))
}

fn nisa_math_arity(name: string) -> int {
    if (== name "sqrt") {
        return 1
    }
    if (== name "sin") {
        return 1
    }
    if (== name "cos") {
        return 1
    }
    if (== name "tan") {
        return 1
    }
    if (== name "asin") {
        return 1
    }
    if (== name "acos") {
        return 1
    }
    if (== name "atan") {
        return 1
    }
    if (== name "floor") {
        return 1
    }
    if (== name "ceil") {
        return 1
    }
    if (== name "round") {
        return 1
    }
    if (== name "log") {
        return 1
    }
    if (== name "log2") {
        return 1
    }
    if (== name "log10") {
        return 1
    }
    if (== name "exp") {
        return 1
    }
    if (== name "pow") {
        return 2
    }
    if (== name "atan2") {
        return 2
    }
    if (== name "fmod") {
        return 2
    }
    return 0
}

shadow nisa_math_arity {
    assert (== (nisa_math_arity "sqrt") 1)
    assert (== (nisa_math_arity "pow") 2)
    assert (== (nisa_math_arity "fmod") 2)
    assert (== (nisa_math_arity "add") 0)
}

fn nisa_host_param_tags(parser: Parser, fd: ASTFunction) -> string {
    let mut out: string = ""
    let mut i: int = 0
    while (< i fd.param_count) {
        let plet: ASTLet = (parser_get_let parser (+ fd.param_start i))
        let tag: string = (nisa_result_tag parser plet.var_type)
        if (== tag "") {
            let _x: string = (nisa_fail (+ "unsupported param type " plet.var_type))
            return ""
        } else {
            if (== i 0) {
                set out tag
            } else {
                set out (+ out (+ " " tag))
            }
            set i (+ i 1)
        }
    }
    return out
}

shadow nisa_host_param_tags {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n add(a: int, b: int) -> int { return (+ a b) } shadow add { assert true }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let fd: ASTFunction = (parser_get_function p 0)
    assert (== (nisa_host_param_tags p fd) "int int")
}

fn nisa_emit_host_call(parser: Parser, call: ASTCall) -> string {
    let func_id: ASTIdentifier = (parser_get_identifier parser call.function)
    let math_n: int = (nisa_math_arity func_id.name)
    if (!= math_n 0) {
        if (!= call.arg_count math_n) {
            return (nisa_fail (+ func_id.name " wrong arity"))
        } else {
            let mut params: string = "float"
            if (== math_n 2) {
                set params "float float"
            } else {
                (print "")
            }
            let idx: int = (nisa_ensure_extern func_id.name "float" params)
            return (+ (nisa_emit_call_args parser call) (nisa_line_imm "CALL_EXTERN" (int_to_string idx)))
        }
    } else {
    let os: string = (nisa_os_sym func_id.name)
    if (!= os "") {
        let arity: int = (nisa_os_arity func_id.name)
        if (!= call.arg_count arity) {
            return (nisa_fail (+ func_id.name " wrong arity"))
        } else {
            let ret: string = (nisa_os_ret func_id.name)
            if (== ret "") {
                return (nisa_fail (+ "unsupported host result " func_id.name))
            } else {
                let params: string = (nisa_os_param_tags func_id.name)
                let idx: int = (nisa_ensure_extern os ret params)
                return (+ (nisa_emit_call_args parser call) (nisa_line_imm "CALL_EXTERN" (int_to_string idx)))
            }
        }
    } else {
        let fidx: int = (nisa_fn_index parser func_id.name)
        if (< fidx 0) {
            return (nisa_fail (+ "undefined function " func_id.name))
        } else {
            let fd: ASTFunction = (parser_get_function parser fidx)
            let ret: string = (nisa_result_tag parser fd.return_type)
            if (== ret "") {
                return (nisa_fail (+ "unsupported result type " fd.return_type))
            } else {
                if (!= call.arg_count fd.param_count) {
                    return (nisa_fail (+ "wrong arity " func_id.name))
                } else {
                    let params: string = (nisa_host_param_tags parser fd)
                    let idx: int = (nisa_ensure_extern fd.name ret params)
                    return (+ (nisa_emit_call_args parser call) (nisa_line_imm "CALL_EXTERN" (int_to_string idx)))
                }
            }
        }
    }
    }
}

shadow nisa_emit_host_call {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n via_cwd() -> string { return (getcwd) } shadow via_cwd { assert true }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 0)
    let r: ASTReturn = (parser_get_return p stmt.node_id)
    let call: ASTCall = (parser_get_call p r.value)
    let text: string = (nisa_emit_host_call p call)
    assert (str_contains text "CALL_EXTERN 0")
}

fn nisa_ext_prelude() -> string {
    let mut out: string = ""
    let mut i: int = 0
    while (< i (array_length nisa_ext_syms)) {
        set out (+ out ".import \"\" \"")
        set out (+ out (at nisa_ext_syms i))
        set out (+ out "\" ")
        set out (+ out (at nisa_ext_rets i))
        let params: string = (at nisa_ext_params i)
        if (!= params "") {
            set out (+ out (+ " " params))
        } else {
            (print "")
        }
        set out (+ out "\n")
        set i (+ i 1)
    }
    return out
}

shadow nisa_ext_prelude {
    let _: int = (nisa_reset)
    let _i: int = (nisa_ensure_extern "vm_getcwd" "string" "")
    let text: string = (nisa_ext_prelude)
    assert (str_contains text ".import \"\" \"vm_getcwd\" string")
}

fn nisa_result_tag(parser: Parser, t: string) -> string {
    if (or (== t "int") (or (== t "string") (or (== t "bool") (or (== t "void") (== t "float"))))) {
        return t
    } else {
        if (nisa_is_pin_record parser t) {
            return "struct"
        } else {
            if (>= (nisa_union_index parser t) 0) {
                return "struct"
            } else {
            if (nisa_is_hm_type t) {
                return "hashmap"
            } else {
            if (nisa_local_type_ok t) {
                return "array"
            } else {
                let inner: string = (nisa_seq_inner t)
                if (and (!= inner "") (nisa_is_pin_record parser inner)) {
                    return "array"
                } else {
                    return ""
                }
            }
            }
            }
        }
    }
}

shadow nisa_result_tag {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "struct Point { x: int, y: int } struct Tok { t: int, s: string } struct LexerToken { token_type: int, value: string, line: int, column: int } struct TypeRec { kind: int, name: string } struct Sym { name: string, ty: TypeRec, args: array<TypeRec> } struct BagHM { m: HashMap<string, int>, n: int } union ResultI { Ok { value: int }, Err { error: string } } " (+ "f" "n origin() -> Point { return Point { x: 0, y: 1 } } shadow origin { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (== (nisa_result_tag p "int") "int")
    assert (== (nisa_result_tag p "void") "void")
    assert (== (nisa_result_tag p "float") "float")
    assert (== (nisa_result_tag p "Point") "struct")
    assert (== (nisa_result_tag p "array<int>") "array")
    assert (== (nisa_result_tag p "List<Tok>") "array")
    assert (== (nisa_result_tag p "List<LexerToken>") "array")
    assert (== (nisa_result_tag p "array<Point>") "array")
    assert (== (nisa_result_tag p "array<Tok>") "array")
    assert (== (nisa_result_tag p "HashMap<string, string>") "hashmap")
    assert (== (nisa_result_tag p "Sym") "struct")
    assert (== (nisa_result_tag p "array<Sym>") "array")
    assert (== (nisa_result_tag p "BagHM") "struct")
    assert (== (nisa_result_tag p "ResultI") "struct")
    assert (== (nisa_result_tag p "Nope") "")
}

fn nisa_expr_is_string(parser: Parser, node_id: int, node_type: int) -> bool {
    if (== node_type ParseNodeType.PNODE_STRING) {
        return true
    } else {
        if (== node_type ParseNodeType.PNODE_IDENTIFIER) {
            let id: ASTIdentifier = (parser_get_identifier parser node_id)
            return (== (nisa_name_type id.name) "string")
        } else {
            if (== node_type ParseNodeType.PNODE_BINARY_OP) {
                let binop: ASTBinaryOp = (parser_get_binary_op parser node_id)
                if (== binop.op LexerTokenType.TOKEN_PLUS) {
                    return (and (nisa_expr_is_string parser binop.left binop.left_type) (nisa_expr_is_string parser binop.right binop.right_type))
                } else {
                    return false
                }
            } else {
                if (== node_type ParseNodeType.PNODE_CALL) {
                    let call: ASTCall = (parser_get_call parser node_id)
                    let func_id: ASTIdentifier = (parser_get_identifier parser call.function)
                    if (or (== func_id.name "int_to_string")
                           (or (== func_id.name "getcwd")
                               (or (== func_id.name "getenv")
                                   (or (== func_id.name "file_read")
                                       (or (== func_id.name "tmp_dir")
                                           (or (== func_id.name "str_concat")
                                               (or (== func_id.name "str_substring")
                                                   (or (== func_id.name "str_trim")
                                                       (or (== func_id.name "str_replace")
                                                           (== func_id.name "string_from_char")))))))))) {
                        return true
                    } else {
                    let fidx: int = (nisa_fn_index parser func_id.name)
                    if (< fidx 0) {
                        return false
                    } else {
                        let f: ASTFunction = (parser_get_function parser fidx)
                        return (== f.return_type "string")
                    }
                    }
                } else {
                    if (== node_type ParseNodeType.PNODE_FIELD_ACCESS) {
                        let fa: ASTFieldAccess = (parser_get_field_access parser node_id)
                        let ty: string = (nisa_expr_struct_type parser fa.object fa.object_type)
                        let fi: int = (nisa_struct_field_index parser ty fa.field_name)
                        if (< fi 0) {
                            return false
                        } else {
                            let sidx: int = (nisa_struct_index parser ty)
                            let sd: ASTStruct = (parser_get_struct_def parser sidx)
                            return (== (at sd.field_types fi) "string")
                        }
                    } else {
                    return false
                    }
                }
            }
        }
    }
}

