fn nisa_expr_struct_type(parser: Parser, node_id: int, node_type: int) -> string {
    if (== node_type ParseNodeType.PNODE_IDENTIFIER) {
        let id: ASTIdentifier = (parser_get_identifier parser node_id)
        return (nisa_name_type id.name)
    } else {
        if (== node_type ParseNodeType.PNODE_STRUCT_LITERAL) {
            let lit: ASTStructLiteral = (parser_get_struct_literal parser node_id)
            return lit.struct_name
        } else {
            if (== node_type ParseNodeType.PNODE_CALL) {
                let call: ASTCall = (parser_get_call parser node_id)
                let func_id: ASTIdentifier = (parser_get_identifier parser call.function)
                let fidx: int = (nisa_fn_index parser func_id.name)
                if (< fidx 0) {
                    return ""
                } else {
                    let f: ASTFunction = (parser_get_function parser fidx)
                    return f.return_type
                }
            } else {
                if (== node_type ParseNodeType.PNODE_FIELD_ACCESS) {
                    let fa: ASTFieldAccess = (parser_get_field_access parser node_id)
                    let obj_ty: string = (nisa_expr_struct_type parser fa.object fa.object_type)
                    let fi: int = (nisa_struct_field_index parser obj_ty fa.field_name)
                    if (< fi 0) {
                        let uidx: int = (nisa_union_index parser obj_ty)
                        if (< uidx 0) {
                            return ""
                        } else {
                            return (nisa_union_named_field_type parser uidx fa.field_name)
                        }
                    } else {
                        let sidx: int = (nisa_struct_index parser obj_ty)
                        let sd: ASTStruct = (parser_get_struct_def parser sidx)
                        return (at sd.field_types fi)
                    }
                } else {
                    return ""
                }
            }
        }
    }
}

shadow nisa_expr_struct_type {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "struct Loc { file: string, line: int } struct Nest { inner: Loc, tag: int } " (+ "f" "n nest_d() -> Nest { return Nest { inner: Loc { file: \"f\", line: 7 }, tag: 1 } } shadow nest_d { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 0)
    let r: ASTReturn = (parser_get_return p stmt.node_id)
    assert (== (nisa_expr_struct_type p r.value r.value_type) "Nest")
    let _2: int = (nisa_reset)
}

fn nisa_dirname(path: string) -> string {
    let n: int = (str_length path)
    let mut last: int = (- 0 1)
    let mut i: int = 0
    while (< i n) {
        if (== (char_at path i) 47) {
            set last i
        } else {
            (print "")
        }
        set i (+ i 1)
    }
    if (< last 0) {
        return "."
    } else {
        return (str_substring path 0 last)
    }
}

shadow nisa_dirname {
    assert (== (nisa_dirname "cut_a.nano") ".")
    assert (== (nisa_dirname "tests/nanoisa/fixtures/cut_a_add.nano") "tests/nanoisa/fixtures")
}

fn nisa_resolve_import(file_name: string, module_path: string) -> string {
    if (exists module_path) {
        return module_path
    } else {
        let joined: string = (+ (nisa_dirname file_name) (+ "/" module_path))
        if (exists joined) {
            return joined
        } else {
            let via_stdlib: string = (+ "stdlib/" module_path)
            if (exists via_stdlib) {
                return via_stdlib
            } else {
                let via_mod: string = (+ "modules/" module_path)
                if (exists via_mod) {
                    return via_mod
                } else {
                    return ""
                }
            }
        }
    }
}

shadow nisa_resolve_import {
    assert (== (nisa_resolve_import "tests/nanoisa/fixtures/cut_a_add.nano" "cut_a_kind_imp.nano") "tests/nanoisa/fixtures/cut_a_kind_imp.nano")
    assert (== (nisa_resolve_import "src_nano/compiler/lexer.nano" "std/fs.nano") "modules/std/fs.nano")
    assert (== (nisa_resolve_import "src_nano/compiler/lexer.nano" "src_nano/compiler/ir.nano") "src_nano/compiler/ir.nano")
}

fn nisa_seen_has(path: string) -> bool {
    let n: int = (array_length nisa_seen)
    let mut i: int = 0
    while (< i n) {
        if (== (at nisa_seen i) path) {
            return true
        } else {
            (print "")
        }
        set i (+ i 1)
    }
    return false
}

shadow nisa_seen_has {
    let _: int = (nisa_reset)
    assert (not (nisa_seen_has "a.nano"))
    set nisa_seen (array_push nisa_seen "a.nano")
    assert (nisa_seen_has "a.nano")
    assert (not (nisa_seen_has "b.nano"))
    let _2: int = (nisa_reset)
}

fn nisa_imp_fn_index(name: string) -> int {
    let n: int = (array_length nisa_imp_fn_names)
    let mut i: int = 0
    while (< i n) {
        if (== (at nisa_imp_fn_names i) name) {
            return i
        } else {
            (print "")
        }
        set i (+ i 1)
    }
    return (- 0 1)
}

shadow nisa_imp_fn_index {
    let _: int = (nisa_reset)
    assert (< (nisa_imp_fn_index "imp_add") 0)
    set nisa_imp_fn_names (array_push nisa_imp_fn_names "imp_add")
    set nisa_imp_fn_rets (array_push nisa_imp_fn_rets "int")
    assert (== (nisa_imp_fn_index "imp_add") 0)
    assert (< (nisa_imp_fn_index "nope") 0)
}

fn nisa_ingest_imports(parser: Parser, file_name: string) -> Parser {
    let mut acc: Parser = parser
    let mut queue: array<string> = []
    let n: int = (parser_get_import_count parser)
    let mut i: int = 0
    while (< i n) {
        let imp: ASTImport = (parser_get_import parser i)
        let path: string = (nisa_resolve_import file_name imp.module_path)
        if (== path "") {
            let _b: string = (nisa_fail (+ "cannot read import " imp.module_path))
            return acc
        } else {
            set queue (array_push queue path)
        }
        set i (+ i 1)
    }
    let mut q: int = 0
    while (< q (array_length queue)) {
        let path: string = (at queue q)
        if (nisa_seen_has path) {
            (print "")
        } else {
            set nisa_seen (array_push nisa_seen path)
            let diags: List<CompilerDiagnostic> = (diag_list_new)
            let src: string = (read path)
            let toks: List<LexerToken> = (tokenize_string src path diags)
            let ip: Parser = (parse_program toks (list_LexerToken_length toks) path)
            if (parser_has_error ip) {
                let _p: string = (nisa_fail (+ "parse failed " path))
                return acc
            } else {
                let en: int = (parser_get_enum_count ip)
                let mut j: int = 0
                while (< j en) {
                    let ed: ASTEnum = (parser_get_enum ip j)
                    if (>= (nisa_enum_index acc ed.name) 0) {
                        (print "")
                    } else {
                        set acc (parser_store_enum acc ed.name ed.variant_count ed.variant_names ed.variant_values ed.line ed.column)
                    }
                    set j (+ j 1)
                }
                let sn: int = (parser_get_struct_def_count ip)
                let mut sj: int = 0
                while (< sj sn) {
                    let sd: ASTStruct = (parser_get_struct_def ip sj)
                    if (>= (nisa_struct_index acc sd.name) 0) {
                        (print "")
                    } else {
                        set acc (parser_store_struct acc sd.name sd.field_count sd.field_names sd.field_types sd.line sd.column)
                    }
                    set sj (+ sj 1)
                }
                let nfn: int = (parser_get_function_count ip)
                let mut fi: int = 0
                while (< fi nfn) {
                    let fd: ASTFunction = (parser_get_function ip fi)
                    if (< fd.body 0) {
                        (print "")
                    } else {
                        if (>= (nisa_fn_index acc fd.name) 0) {
                            (print "")
                        } else {
                            if (>= (nisa_imp_fn_index fd.name) 0) {
                                (print "")
                            } else {
                                set nisa_imp_fn_names (array_push nisa_imp_fn_names fd.name)
                                set nisa_imp_fn_rets (array_push nisa_imp_fn_rets fd.return_type)
                            }
                        }
                    }
                    set fi (+ fi 1)
                }
                let m: int = (parser_get_import_count ip)
                let mut k: int = 0
                while (< k m) {
                    let imp2: ASTImport = (parser_get_import ip k)
                    let next: string = (nisa_resolve_import path imp2.module_path)
                    if (== next "") {
                        let _c: string = (nisa_fail (+ "cannot read import " imp2.module_path))
                        return acc
                    } else {
                        set queue (array_push queue next)
                    }
                    set k (+ k 1)
                }
            }
        }
        set q (+ q 1)
    }
    return acc
}

shadow nisa_ingest_imports {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = "from \"cut_a_kind_imp.nano\" import ImpKind"
    let toks: List<LexerToken> = (tokenize_string src "tests/nanoisa/fixtures/cut_a_add.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "tests/nanoisa/fixtures/cut_a_add.nano")
    let p2: Parser = (nisa_ingest_imports p "tests/nanoisa/fixtures/cut_a_add.nano")
    assert nisa_ok
    assert (== (parser_get_enum_count p2) 1)
    let ed: ASTEnum = (parser_get_enum p2 0)
    assert (== ed.name "ImpKind")
    assert (== (at ed.variant_values 0) 19)
    let _r: int = (nisa_reset)
    let src3: string = "from \"cut_a_kind_mid.nano\" import ImpKind"
    let toks3: List<LexerToken> = (tokenize_string src3 "tests/nanoisa/fixtures/cut_a_add.nano" diags)
    let p3: Parser = (parse_program toks3 (list_LexerToken_length toks3) "tests/nanoisa/fixtures/cut_a_add.nano")
    let p4: Parser = (nisa_ingest_imports p3 "tests/nanoisa/fixtures/cut_a_add.nano")
    assert nisa_ok
    assert (== (parser_get_enum_count p4) 1)
    let ed4: ASTEnum = (parser_get_enum p4 0)
    assert (== ed4.name "ImpKind")
    let _r2: int = (nisa_reset)
    let src5: string = "from \"cut_a_tok_imp.nano\" import ImpTok"
    let toks5: List<LexerToken> = (tokenize_string src5 "tests/nanoisa/fixtures/cut_a_add.nano" diags)
    let p5: Parser = (parse_program toks5 (list_LexerToken_length toks5) "tests/nanoisa/fixtures/cut_a_add.nano")
    let p6: Parser = (nisa_ingest_imports p5 "tests/nanoisa/fixtures/cut_a_add.nano")
    assert nisa_ok
    assert (== (parser_get_struct_def_count p6) 1)
    let sd6: ASTStruct = (parser_get_struct_def p6 0)
    assert (== sd6.name "ImpTok")
    let _r3: int = (nisa_reset)
    let src7: string = "from \"cut_a_fn_imp.nano\" import imp_add"
    let toks7: List<LexerToken> = (tokenize_string src7 "tests/nanoisa/fixtures/cut_a_add.nano" diags)
    let p7: Parser = (parse_program toks7 (list_LexerToken_length toks7) "tests/nanoisa/fixtures/cut_a_add.nano")
    let p8: Parser = (nisa_ingest_imports p7 "tests/nanoisa/fixtures/cut_a_add.nano")
    assert nisa_ok
    assert (== (nisa_imp_fn_index "imp_add") 0)
    assert (== (at nisa_imp_fn_rets 0) "int")
    let _2: int = (nisa_reset)
}

fn nisa_enum_index(parser: Parser, name: string) -> int {
    let n: int = (parser_get_enum_count parser)
    let mut i: int = 0
    while (< i n) {
        let e: ASTEnum = (parser_get_enum parser i)
        if (== e.name name) {
            return i
        } else {
            (print "")
        }
        set i (+ i 1)
    }
    return (- 0 1)
}

fn nisa_enum_def(parser: Parser, eidx: int) -> ASTEnum {
