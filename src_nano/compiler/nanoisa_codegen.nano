fn nisa_expr_is_bool(parser: Parser, node_id: int, node_type: int) -> bool {
    if (== node_type ParseNodeType.PNODE_BOOL) {
        return true
    } else {
        if (== node_type ParseNodeType.PNODE_IDENTIFIER) {
            let id: ASTIdentifier = (parser_get_identifier parser node_id)
            return (== (nisa_name_type id.name) "bool")
        } else {
            if (== node_type ParseNodeType.PNODE_FIELD_ACCESS) {
                let fa: ASTFieldAccess = (parser_get_field_access parser node_id)
                let ty: string = (nisa_expr_struct_type parser fa.object fa.object_type)
                let fi: int = (nisa_struct_field_index parser ty fa.field_name)
                if (< fi 0) {
                    return false
                } else {
                    let sidx: int = (nisa_struct_index parser ty)
                    let sd: ASTStruct = (parser_get_struct_def parser sidx)
                    return (== (at sd.field_types fi) "bool")
                }
            } else {
                if (== node_type ParseNodeType.PNODE_CALL) {
                    let call: ASTCall = (parser_get_call parser node_id)
                    let func_id: ASTIdentifier = (parser_get_identifier parser call.function)
                    if (or (== func_id.name "map_has")
                           (or (== func_id.name "hashmap_has")
                               (or (== func_id.name "str_contains")
                                   (or (== func_id.name "str_starts_with")
                                       (or (== func_id.name "str_ends_with")
                                           (or (== func_id.name "file_exists")
                                               (== func_id.name "dir_exists"))))))) {
                        return true
                    } else {
                        let fidx: int = (nisa_fn_index parser func_id.name)
                        if (< fidx 0) {
                            return false
                        } else {
                            let f: ASTFunction = (parser_get_function parser fidx)
                            return (== f.return_type "bool")
                        }
                    }
                } else {
                    if (== node_type ParseNodeType.PNODE_BINARY_OP) {
                        let binop: ASTBinaryOp = (parser_get_binary_op parser node_id)
                        return (or (== binop.op LexerTokenType.TOKEN_EQ)
                                   (or (== binop.op LexerTokenType.TOKEN_NE)
                                       (or (== binop.op LexerTokenType.TOKEN_LT)
                                           (or (== binop.op LexerTokenType.TOKEN_LE)
                                               (or (== binop.op LexerTokenType.TOKEN_GT)
                                                   (or (== binop.op LexerTokenType.TOKEN_GE)
                                                       (or (== binop.op LexerTokenType.TOKEN_AND)
                                                           (== binop.op LexerTokenType.TOKEN_OR))))))))
                    } else {
                        return false
                    }
                }
            }
        }
    }
}

