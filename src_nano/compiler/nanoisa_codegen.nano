from "src_nano/compiler/declaration_ownership.nano" import declaration_local_lets
/* =============================================================================
 * NanoISA lowering (src_nano dual of src/nanovirt/codegen.c, pinned subset)
 * =============================================================================
 * I walk the self-hosted parser AST and write .nasm. Cut A covers integer
 * functions: literals, locals, +, -, *, /, %, comparisons, calls, return,
 * if/else, while, let, set, string literals, string concat, array<int>
 * literals, array_length, array_get, int-, bool-, and string-field records
 * (AGG_PACK/AGG_GET), flat-record results,
 * bool results (i64 0/1), bool literals (PUSH_BOOL), not (BOOL_NOT),
 * and/or (BOOL_AND/BOOL_OR), cond as an if-expression (JMP_FALSE/JMP),
 * print (PRINT), println (PRINTLN), and assert (ASSERT).
 * Anything else fails closed. I do not emit C. I do not delete
 * transpiler.nano.
 */

import "src_nano/compiler/module_facts.nano"
import "src_nano/parser.nano"
import "src_nano/compiler/lexer.nano"
import "src_nano/compiler/module_bindings.nano"
module "modules/compiler_support/compiler_support.nano" as CompilerSupport
from "src_nano/compiler/diagnostics.nano" import diag_list_new

let mut nisa_module_facts: array<ModuleIntrospection> = []
let mut nisa_names: array<string> = []
let mut nisa_types: array<string> = []
let mut nisa_str_vals: array<string> = []
let mut nisa_str_names: array<string> = []
let mut nisa_ok: bool = true
let mut nisa_err: string = ""
let mut nisa_label: int = 0
let mut nisa_void_return: bool = false
let mut nisa_return_type: string = ""
let mut nisa_loop_top: string = ""
let mut nisa_loop_end: string = ""
let mut nisa_loop_index: string = ""
let mut nisa_import_names: array<string> = []
let mut nisa_import_text: string = ""
let mut nisa_artifact_owners: array<int> = []
let mut nisa_artifact_paths: array<string> = []
let mut nisa_program_mode: bool = false
let mut nisa_function_queue: array<int> = []
let mut nisa_global_names: array<string> = []
let mut nisa_global_types: array<string> = []
let mut nisa_global_owners: array<int> = []
let mut nisa_global_nodes: array<int> = []

fn nisa_reset() -> int {
    set nisa_module_facts []
    set nisa_names []
    set nisa_types []
    set nisa_str_vals []
    set nisa_str_names []
    set nisa_ok true
    set nisa_err ""
    set nisa_label 0
    set nisa_void_return false
    set nisa_return_type ""
    set nisa_loop_top ""
    set nisa_loop_end ""
    set nisa_loop_index ""
    set nisa_import_names []
    set nisa_import_text ""
    set nisa_artifact_owners []
    set nisa_artifact_paths []
    set nisa_program_mode false
    set nisa_function_queue []
    set nisa_global_names []
    set nisa_global_types []
    set nisa_global_owners []
    set nisa_global_nodes []
    return 0
}

shadow nisa_reset {
    let _: int = (nisa_reset)
    assert nisa_ok
    assert (== nisa_err "")
    assert (== nisa_loop_top "")
    assert (== nisa_loop_end "")
}

fn nisa_fail(msg: string) -> string {
    set nisa_ok false
    if (== nisa_err "") {
        set nisa_err msg
    } else {
        (print "")
    }
    return ""
}

shadow nisa_fail {
    let _: int = (nisa_reset)
    let out: string = (nisa_fail "refused")
    assert (== out "")
    assert (not nisa_ok)
    assert (== nisa_err "refused")
    let _2: int = (nisa_reset)
}

pub fn nanoisa_last_lowering_error() -> string {
    return nisa_err
}

shadow nanoisa_last_lowering_error {
    let _: int = (nisa_reset)
    let ignored: string = (nisa_fail "precise refusal")
    assert (== ignored "")
    assert (== (nanoisa_last_lowering_error) "precise refusal")
    let _2: int = (nisa_reset)
}

fn nisa_local_find(name: string) -> int {
    let mut i: int = (- (array_length nisa_names) 1)
    while (>= i 0) {
        if (and (!= name "") (== (at nisa_names i) name)) { return i }
        set i (- i 1)
    }
    return (- 0 1)
}

shadow nisa_local_find {
    let _: int = (nisa_reset)
    set nisa_names (array_push nisa_names "a")
    set nisa_names (array_push nisa_names "b")
    assert (== (nisa_local_find "a") 0)
    assert (== (nisa_local_find "b") 1)
    assert (== (nisa_local_find "z") (- 0 1))
    set nisa_names (array_push nisa_names "a")
    assert (== (nisa_local_find "a") 2)
    let _2: int = (nisa_reset)
}

fn nisa_intern(lit: string) -> string {
    let mut i: int = 0
    while (< i (array_length nisa_str_vals)) {
        if (== (at nisa_str_vals i) lit) { return (at nisa_str_names i) }
        set i (+ i 1)
    }
    let name: string = (+ "s" (int_to_string (array_length nisa_str_vals)))
    set nisa_str_vals (array_push nisa_str_vals lit)
    set nisa_str_names (array_push nisa_str_names name)
    return name
}

shadow nisa_intern {
    let _: int = (nisa_reset)
    assert (== (nisa_intern "hi") "s0")
    assert (== (nisa_intern "hi") "s0")
    assert (== (nisa_intern "ab") "s1")
    let _2: int = (nisa_reset)
}

# My parser stores source spellings; I decode the C-seed string contract first.
fn nisa_decode_string(raw: string) -> string {
    let mut output: string = ""
    let mut i: int = 0
    while (< i (str_length raw)) {
        let mut part: string = (str_substring raw i 1)
        if (and (== (char_at raw i) 92) (< (+ i 1) (str_length raw))) {
            set i (+ i 1)
            let code: int = (char_at raw i)
            set part (str_substring raw i 1)
            # My C-string ABI ends at the first decoded NUL.
            if (== code 48) { return output }
            if (== code 110) { set part "\n" }
            if (== code 116) { set part "\t" }
            if (== code 114) { set part "\r" }
            if (not (or (== code 110) (or (== code 116) (or (== code 114)
                    (or (== code 92) (or (== code 34) (== code 39))))))) {
                set part (+ "\\" part)
            }
        }
        set output (+ output part)
        set i (+ i 1)
    }
    return output
}
shadow nisa_decode_string {
    assert (== (nisa_decode_string "\\n\\r\\t") "\n\r\t")
    assert (== (nisa_decode_string "\\\"\\\\\\'") "\"\\'")
    assert (== (nisa_decode_string "a\\qb") "a\\qb")
    assert (== (nisa_decode_string "a\\0b") "a")
}

# I escape bytes using the assembler quoted-string grammar.
fn nisa_escape_string(value: string) -> string {
    let digits: string = "0123456789abcdef"
    let mut output: string = ""
    let mut i: int = 0
    while (< i (str_length value)) {
        let octet: int = (char_at value i)
        let mut escaped: string = (str_substring value i 1)
        if (== octet 34) { set escaped "\\\"" }
        if (== octet 92) { set escaped "\\\\" }
        if (== octet 10) { set escaped "\\n" }
        if (== octet 13) { set escaped "\\r" }
        if (== octet 9) { set escaped "\\t" }
        if (and (or (< octet 32) (== octet 127))
                (and (!= octet 10) (and (!= octet 13) (!= octet 9)))) {
            set escaped (+ "\\x" (+ (str_substring digits (/ octet 16) 1)
                                      (str_substring digits (% octet 16) 1)))
        }
        set output (+ output escaped)
        set i (+ i 1)
    }
    return output
}
shadow nisa_escape_string {
    assert (== (nisa_escape_string "plain") "plain")
    assert (== (nisa_escape_string "\n\r\t") "\\n\\r\\t")
    assert (== (nisa_escape_string "\"\\") "\\\"\\\\")
    assert (== (nisa_escape_string "café") "café")
    assert (== (nisa_escape_string (string_from_char 1)) "\\x01")
    assert (== (nisa_escape_string (string_from_char 127)) "\\x7f")
}

fn nisa_str_prelude() -> string {
    let mut out: string = ""
    let mut i: int = 0
    while (< i (array_length nisa_str_names)) {
        set out (+ out ".string ")
        set out (+ out (at nisa_str_names i))
        set out (+ out " \"")
        set out (+ out (nisa_escape_string (at nisa_str_vals i)))
        set out (+ out "\"\n")
        set i (+ i 1)
    }
    return out
}

shadow nisa_str_prelude {
    let _: int = (nisa_reset)
    let name: string = (nisa_intern "hi")
    let text: string = (nisa_str_prelude)
    assert (== name "s0")
    assert (str_contains text ".string s0 \"hi\"")
    let _2: int = (nisa_reset)
}

fn nisa_binop_mnemonic(op: int) -> string {
    if (== op LexerTokenType.TOKEN_PLUS) {
        return "I64_ADD"
    } else {
        if (== op LexerTokenType.TOKEN_MINUS) {
            return "I64_SUB"
        } else {
            if (== op LexerTokenType.TOKEN_STAR) {
                return "I64_MUL"
            } else {
                if (== op LexerTokenType.TOKEN_SLASH) {
                    return "I64_DIV_S"
                } else {
                    if (== op LexerTokenType.TOKEN_PERCENT) {
                        return "I64_REM_S"
                    } else {
                        if (== op LexerTokenType.TOKEN_EQ) {
                            return "I64_EQ"
                        } else {
                            if (== op LexerTokenType.TOKEN_NE) {
                                return "I64_NE"
                            } else {
                                if (== op LexerTokenType.TOKEN_LT) {
                                    return "I64_LT_S"
                                } else {
                                    if (== op LexerTokenType.TOKEN_LE) {
                                        return "I64_LE_S"
                                    } else {
                                        if (== op LexerTokenType.TOKEN_GT) {
                                            return "I64_GT_S"
                                        } else {
                                            if (== op LexerTokenType.TOKEN_GE) {
                                                return "I64_GE_S"
                                            } else {
                                                if (== op LexerTokenType.TOKEN_AND) {
                                                    return "BOOL_AND"
                                                } else {
                                                    if (== op LexerTokenType.TOKEN_OR) {
                                                        return "BOOL_OR"
                                                    } else {
                                                        return ""
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

shadow nisa_binop_mnemonic {
    assert (== (nisa_binop_mnemonic LexerTokenType.TOKEN_PLUS) "I64_ADD")
    assert (== (nisa_binop_mnemonic LexerTokenType.TOKEN_STAR) "I64_MUL")
    assert (== (nisa_binop_mnemonic LexerTokenType.TOKEN_AND) "BOOL_AND")
    assert (== (nisa_binop_mnemonic LexerTokenType.TOKEN_OR) "BOOL_OR")
    assert (== (nisa_binop_mnemonic 0) "")
}

fn nisa_line(op: string) -> string {
    return (+ (+ "  " op) "\n")
}

shadow nisa_line {
    assert (== (nisa_line "RET") "  RET\n")
}

fn nisa_line_imm(op: string, imm: string) -> string {
    return (+ (+ (+ (+ "  " op) " ") imm) "\n")
}

shadow nisa_line_imm {
    assert (== (nisa_line_imm "PUSH_I64" "40") "  PUSH_I64 40\n")
}

fn nisa_map_value_type(t: string) -> string {
    if (== t "HashMap<string,int>") { return "int" }
    if (== t "HashMap<string,string>") { return "string" }
    return ""
}
shadow nisa_map_value_type {
    assert (== (nisa_map_value_type "HashMap<string,int>") "int")
    assert (== (nisa_map_value_type "HashMap<string,string>") "string")
    assert (== (nisa_map_value_type "HashMap<int,string>") "")
    assert (== (nisa_map_value_type "HashMap<string,bool>") "")
}

fn nisa_local_type_ok(t: string) -> bool {
    if (== t "float") { return true }
    if (== t "array<bool>") { return true }
    if (!= (nisa_map_value_type t) "") { return true }
    if (== t "int") {
        return true
    } else {
        if (== t "string") {
            return true
        } else {
            if (== t "bool") {
                return true
            } else {
                return (or (== t "array<int>")
                           (or (== t "array<string>")
                               (or (== t "List<int>")
                                   (or (== t "list_int")
                                       (or (== t "List<string>") (== t "list_string"))))))
            }
        }
    }
}

shadow nisa_local_type_ok {
    assert (nisa_local_type_ok "float")
    assert (nisa_local_type_ok "int")
    assert (nisa_local_type_ok "string")
    assert (nisa_local_type_ok "bool")
    assert (nisa_local_type_ok "array<int>")
    assert (nisa_local_type_ok "array<string>")
    assert (nisa_local_type_ok "List<int>")
    assert (nisa_local_type_ok "list_int")
    assert (nisa_local_type_ok "List<string>")
    assert (nisa_local_type_ok "list_string")
    assert (nisa_local_type_ok "array<bool>")
}

fn nisa_is_arr_builtin(name: string) -> bool {
    return (or (== name "array_new") (or (== name "array_set") (or (== name "array_length")
               (or (== name "array_get")
                   (or (== name "array_push") (== name "at"))))))
}

shadow nisa_is_arr_builtin {
    assert (nisa_is_arr_builtin "array_new")
    assert (nisa_is_arr_builtin "array_length")
    assert (nisa_is_arr_builtin "array_get")
    assert (nisa_is_arr_builtin "array_push")
    assert (nisa_is_arr_builtin "at")
    assert (not (nisa_is_arr_builtin "add"))
}

fn nisa_is_print_builtin(name: string) -> bool {
    return (or (== name "print") (== name "println"))
}

shadow nisa_is_print_builtin {
    assert (nisa_is_print_builtin "print")
    assert (nisa_is_print_builtin "println")
    assert (not (nisa_is_print_builtin "add"))
}

fn nisa_is_list_call(name: string) -> bool {
    return (and (or (str_starts_with name "list_") (str_starts_with name "List_"))
                (or (str_ends_with name "_new")
                    (or (str_ends_with name "_length")
                        (or (str_ends_with name "_push") (or (str_ends_with name "_get") (str_ends_with name "_set"))))))
}

shadow nisa_is_list_call {
    assert (nisa_is_list_call "list_int_new")
    assert (nisa_is_list_call "list_int_length")
    assert (nisa_is_list_call "list_int_push")
    assert (nisa_is_list_call "list_int_get")
    assert (nisa_is_list_call "list_string_new")
    assert (nisa_is_list_call "list_string_push")
    assert (nisa_is_list_call "list_string_get")
    assert (nisa_is_list_call "list_string_length")
    assert (nisa_is_list_call "list_string_set")
    assert (not (nisa_is_list_call "array_new"))
}

fn nisa_is_set_call(name: string) -> bool {
    return (or (== name "array_set") (and (nisa_is_list_call name) (str_ends_with name "_set")))
}
shadow nisa_is_set_call {
    assert (nisa_is_set_call "array_set")
    assert (nisa_is_set_call "list_string_set")
    assert (not (nisa_is_set_call "list_string_get"))
}

fn nisa_list_element_tag(parser: Parser, name: string) -> string {
    let type_len: int = (- (str_length name) 9)
    if (<= type_len 0) {
        return "1"
    } else {
        let type_name: string = (str_substring name 5 type_len)
        if (or (== type_name "int") (== type_name "Token")) {
            return "1"
        } else {
            if (== type_name "u8") {
                return "2"
            } else {
                if (== type_name "float") {
                    return "3"
                } else {
                    if (== type_name "bool") {
                        return "4"
                    } else {
                        if (== type_name "string") {
                            return "5"
                        } else {
                            if (>= (nisa_struct_index parser type_name) 0) {
                                return "8"
                            } else {
                                let enum_count: int = (parser_get_enum_count parser)
                                let mut i: int = 0
                                while (< i enum_count) {
                                    let e: ASTEnum = (parser_get_enum parser i)
                                    if (== e.name type_name) {
                                        return "1"
                                    } else {
                                        set i (+ i 1)
                                    }
                                }
                                return "1"
                            }
                        }
                    }
                }
            }
        }
    }
}

shadow nisa_list_element_tag {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "struct Tok { t: int, s: string } enum Shade { Light, Dark } " (+ "f" "n main() -> int { return 0 } shadow main { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (== (nisa_list_element_tag p "list_int_new") "1")
    assert (== (nisa_list_element_tag p "list_u8_new") "2")
    assert (== (nisa_list_element_tag p "list_float_new") "3")
    assert (== (nisa_list_element_tag p "list_bool_new") "4")
    assert (== (nisa_list_element_tag p "list_string_new") "5")
    assert (== (nisa_list_element_tag p "list_Tok_new") "8")
    assert (== (nisa_list_element_tag p "list_Shade_new") "1")
}

# I preserve exact two-string operations without replacing declared functions.
fn nisa_string_binary_opcode(name: string) -> string {
    if (== name "str_concat") { return "STR_CONCAT" }
    if (== name "str_starts_with") { return "STR_STARTS_WITH" }
    if (== name "str_ends_with") { return "STR_ENDS_WITH" }
    return ""
}
shadow nisa_string_binary_opcode {
    assert (== (nisa_string_binary_opcode "str_concat") "STR_CONCAT")
    assert (== (nisa_string_binary_opcode "str_starts_with") "STR_STARTS_WITH")
    assert (== (nisa_string_binary_opcode "str_ends_with") "STR_ENDS_WITH")
    assert (== (nisa_string_binary_opcode "unknown") "")
}

fn nisa_is_inline_call(name: string) -> bool {
    if (== name "float_to_string") { return true }
    if (== name "string_to_int") { return true }
    if (!= (nisa_map_opcode name) "") { return true }
    return (or (nisa_is_arr_builtin name)
               (or (nisa_is_print_builtin name)
                   (or (nisa_is_list_call name)
                       (or (== name "not")
                           (or (== name "str_contains")
                               (or (== name "int_to_string")
                                   (or (== name "str_length")
                                       (or (== name "str_substring")
                                           (or (== name "char_at") (== name "str_char_at"))))))))))
}

shadow nisa_is_inline_call {
    assert (nisa_is_inline_call "float_to_string")
    assert (nisa_is_inline_call "array_length")
    assert (nisa_is_inline_call "not")
    assert (nisa_is_inline_call "print")
    assert (nisa_is_inline_call "str_contains")
    assert (nisa_is_inline_call "int_to_string")
    assert (nisa_is_inline_call "str_length")
    assert (nisa_is_inline_call "str_substring")
    assert (nisa_is_inline_call "list_int_new")
    assert (nisa_is_inline_call "list_int_length")
    assert (nisa_is_inline_call "list_int_push")
    assert (nisa_is_inline_call "list_int_get")
    assert (nisa_is_inline_call "list_string_new")
    assert (nisa_is_inline_call "list_string_push")
    assert (nisa_is_inline_call "char_at")
    assert (nisa_is_inline_call "str_char_at")
    assert (nisa_is_inline_call "at")
    assert (not (nisa_is_inline_call "add"))
}

fn nisa_struct_index(parser: Parser, name: string) -> int {
    let n: int = (parser_get_struct_def_count parser)
    let mut i: int = 0
    while (< i n) {
        let s: ASTStruct = (parser_get_struct_def parser i)
        if (== s.name name) {
            return i
        } else {
            (print "")
        }
        set i (+ i 1)
    }
    return (- 0 1)
}

shadow nisa_struct_index {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "struct Point { x: int, y: int } " (+ "f" "n getx() -> int { return 0 } shadow getx { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (== (nisa_struct_index p "Point") 0)
    assert (== (nisa_struct_index p "Nope") (- 0 1))
}

fn nisa_is_int_record(parser: Parser, name: string) -> bool {
    let idx: int = (nisa_struct_index parser name)
    if (< idx 0) {
        return false
    } else {
        let s: ASTStruct = (parser_get_struct_def parser idx)
        let mut i: int = 0
        while (< i s.field_count) {
            if (!= (at s.field_types i) "int") {
                return false
            } else {
                set i (+ i 1)
            }
        }
        return true
    }
}

shadow nisa_is_int_record {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "struct Point { x: int, y: int } " (+ "f" "n getx() -> int { return 0 } shadow getx { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (nisa_is_int_record p "Point")
    assert (not (nisa_is_int_record p "Nope"))
}

fn nisa_enum_index(parser: Parser, name: string) -> int {
    let mut found: int = -1
    let mut i: int = 0
    while (< i (parser_get_enum_count parser)) {
        let declaration: ASTEnum = (parser_get_enum parser i)
        if (== declaration.name name) {
            if (>= found 0) { return -1 }
            set found i
        }
        set i (+ i 1)
    }
    return found
}
shadow nisa_enum_index {
    let tokens: List<LexerToken> = (tokenize_string "enum Mode { Low = -3, Next }" "enum.nano" (diag_list_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "enum.nano")
    assert (== (nisa_enum_index parser "Mode") 0)
    assert (== (nisa_enum_index parser "Missing") -1)
}

fn nisa_enum_receiver(parser: Parser, access: ASTFieldAccess) -> int {
    if (!= access.object_type ParseNodeType.PNODE_IDENTIFIER) { return -1 }
    let name: ASTIdentifier = (parser_get_identifier parser access.object)
    if (>= (nisa_local_find name.name) 0) { return -1 }
    if (>= (nisa_global_find name.name name.line) 0) { return -1 }
    return (nisa_enum_index parser name.name)
}
shadow nisa_enum_receiver {
    let _: int = (nisa_reset)
    let tokens: List<LexerToken> = (tokenize_string "enum Mode { Low = -3 } fn main() -> int { return Mode.Low }" "enum.nano" (diag_list_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "enum.nano")
    let access: ASTFieldAccess = (parser_get_field_access parser 0)
    assert (== (nisa_enum_receiver parser access) 0)
    set nisa_names ["Mode"]
    assert (== (nisa_enum_receiver parser access) -1)
    let reset: int = (nisa_reset)
}

fn nisa_value_type_matches(parser: Parser, actual: string, expected: string) -> bool {
    if (== actual expected) { return true }
    if (== expected "int") { return (>= (nisa_enum_index parser actual) 0) }
    if (== actual "int") { return (>= (nisa_enum_index parser expected) 0) }
    return false
}
shadow nisa_value_type_matches {
    let tokens: List<LexerToken> = (tokenize_string "enum Mode { Low = -3 }" "enum.nano" (diag_list_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "enum.nano")
    assert (nisa_value_type_matches parser "Mode" "int")
    assert (nisa_value_type_matches parser "int" "Mode")
    assert (not (nisa_value_type_matches parser "Mode" "bool"))
}

fn nisa_field_shape_supported(parser: Parser, field: string, ancestors: array<string>) -> bool {
    if (>= (nisa_enum_index parser field) 0) { return true }
    if (!= (nisa_map_value_type field) "") { return true }
    if (or (== field "int") (or (== field "string") (== field "bool"))) { return true }
    if (or (== field "array<bool>") (or (== field "array<int>") (== field "array<string>"))) { return true }
    if (or (== field "List<int>") (== field "List<string>")) { return true }
    if (and (str_starts_with field "array<") (str_ends_with field ">")) {
        let element: string = (str_substring field 6 (- (str_length field) 7))
        return (or (>= (nisa_enum_index parser element) 0) (nisa_record_shape_supported parser element ancestors))
    }
    if (and (str_starts_with field "List<") (str_ends_with field ">")) {
        let element: string = (str_substring field 5 (- (str_length field) 6))
        return (or (>= (nisa_enum_index parser element) 0) (nisa_record_shape_supported parser element ancestors))
    }
    return (nisa_record_shape_supported parser field ancestors)
}
shadow nisa_field_shape_supported {
    let diagnostics: List<CompilerDiagnostic> = (diag_list_new)
    let tokens: List<LexerToken> = (tokenize_string "struct Point { x: int }" "shape.nano" diagnostics)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "shape.nano")
    assert (nisa_field_shape_supported parser "List<Point>" [])
    assert (nisa_field_shape_supported parser "HashMap<string,int>" [])
    assert (not (nisa_field_shape_supported parser "HashMap<int,int>" []))
    assert (nisa_field_shape_supported parser "array<bool>" [])
}

fn nisa_record_shape_supported(parser: Parser, name: string, ancestors: array<string>) -> bool {
    let index: int = (nisa_struct_index parser name)
    if (< index 0) { return false }
    let mut path: array<string> = []
    let mut i: int = 0
    while (< i (array_length ancestors)) {
        let ancestor: string = (at ancestors i)
        if (== ancestor name) { return false }
        set path (array_push path ancestor)
        set i (+ i 1)
    }
    set path (array_push path name)
    let record: ASTStruct = (parser_get_struct_def parser index)
    set i 0
    while (< i record.field_count) {
        if (not (nisa_field_shape_supported parser (at record.field_types i) path)) { return false }
        set i (+ i 1)
    }
    return true
}
shadow nisa_record_shape_supported {
    let diagnostics: List<CompilerDiagnostic> = (diag_list_new)
    let source: string = "struct Point { x: int } struct Pair { first: Point, second: Point } struct Cycle { next: List<Cycle> }"
    let tokens: List<LexerToken> = (tokenize_string source "shape.nano" diagnostics)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "shape.nano")
    assert (nisa_record_shape_supported parser "Pair" [])
    assert (not (nisa_record_shape_supported parser "Cycle" []))
}

fn nisa_is_pin_record(parser: Parser, name: string) -> bool {
    return (nisa_record_shape_supported parser name [])
}

shadow nisa_is_pin_record {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "struct Point { x: int, y: int } struct Tok { t: int, s: string } struct Flags { enabled: bool, label: string } struct Nested { child: Flags } " (+ "f" "n getx() -> int { return 0 } shadow getx { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (nisa_is_pin_record p "Point")
    assert (nisa_is_pin_record p "Tok")
    assert (nisa_is_pin_record p "Flags")
    assert (nisa_is_pin_record p "Nested")
    assert (not (nisa_is_pin_record p "Nope"))
    assert (not (nisa_is_int_record p "Tok"))
}

fn nisa_type_ok(parser: Parser, t: string) -> bool {
    if (>= (nisa_enum_index parser t) 0) { return true }
    if (and (str_starts_with t "array<") (str_ends_with t ">")) {
        let element: string = (str_substring t 6 (- (str_length t) 7))
        if (or (== element "bool") (or (== element "int") (== element "string"))) { return true }
        return (or (>= (nisa_enum_index parser element) 0) (nisa_is_pin_record parser element))
    }
    if (nisa_local_type_ok t) {
        return true
    } else {
        if (and (str_starts_with t "List<") (str_ends_with t ">")) {
            let inner: string = (str_substring t 5 (- (str_length t) 6))
            return (or (>= (nisa_enum_index parser inner) 0) (nisa_is_pin_record parser inner))
        } else {
            return (nisa_is_pin_record parser t)
        }
    }
}

shadow nisa_type_ok {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "struct Point { x: int, y: int } struct Tok { t: int, s: string } struct Box { p: Point } " (+ "f" "n getx() -> int { return 0 } shadow getx { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (nisa_type_ok p "int")
    assert (nisa_type_ok p "Point")
    assert (nisa_type_ok p "Tok")
    assert (nisa_type_ok p "array<string>")
    assert (nisa_type_ok p "List<string>")
    assert (nisa_type_ok p "List<Tok>")
    assert (nisa_type_ok p "List<Box>")
    assert (nisa_type_ok p "array<bool>")
}

fn nisa_fresh() -> string {
    let n: int = nisa_label
    set nisa_label (+ nisa_label 1)
    return (+ "L" (int_to_string n))
}

shadow nisa_fresh {
    let _: int = (nisa_reset)
    assert (== (nisa_fresh) "L0")
    assert (== (nisa_fresh) "L1")
    let _2: int = (nisa_reset)
}

fn nisa_label_line(name: string) -> string {
    return (+ name ":\n")
}

shadow nisa_label_line {
    assert (== (nisa_label_line "L0") "L0:\n")
}

fn nisa_fn_index(parser: Parser, name: string) -> int {
    let n: int = (parser_get_function_count parser)
    let mut i: int = 0
    while (< i n) {
        let f: ASTFunction = (parser_get_function parser i)
        if (== f.name name) {
            return i
        } else {
            (print "")
        }
        set i (+ i 1)
    }
    return (- 0 1)
}

shadow nisa_fn_index {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n add(a: int, b: int) -> int { return (+ a b) } shadow add { assert (== (add 1 1) 2) }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    assert (== (nisa_fn_index p "add") 0)
    assert (== (nisa_fn_index p "nope") (- 0 1))
}

# I visit each directly required function once, including recursive cycles.
fn nisa_require_function(index: int) -> void {
    if (not nisa_program_mode) { return }
    let mut i: int = 0
    while (< i (array_length nisa_function_queue)) {
        if (== (at nisa_function_queue i) index) { return }
        set i (+ i 1)
    }
    set nisa_function_queue (array_push nisa_function_queue index)
}
shadow nisa_require_function {
    let _: int = (nisa_reset)
    set nisa_program_mode true
    (nisa_require_function 2)
    (nisa_require_function 1)
    (nisa_require_function 2)
    assert (== (array_length nisa_function_queue) 2)
    assert (== (at nisa_function_queue 0) 2)
    assert (== (at nisa_function_queue 1) 1)
    let _2: int = (nisa_reset)
}

# My Parser stores top-level lets with locals and parameters. I exclude every
# lexical block, including shadows and unsafe blocks, before identifying globals.
fn nisa_is_global_let(parser: Parser, index: int) -> bool {
    let mut i: int = 0
    while (< i (list_ASTBlock_length parser.blocks)) {
        let block: ASTBlock = (parser_get_block parser i)
        let mut j: int = 0
        while (< j (list_ASTStmtRef_length block.statements)) {
            let item: ASTStmtRef = (list_ASTStmtRef_get block.statements j)
            if (and (== item.node_type ParseNodeType.PNODE_LET) (== item.node_id index)) { return false }
            set j (+ j 1)
        }
        set i (+ i 1)
    }
    set i 0
    while (< i (list_ASTUnsafeBlock_length parser.unsafe_blocks)) {
        let block: ASTUnsafeBlock = (parser_get_unsafe_block parser i)
        let mut j: int = 0
        while (< j (list_ASTStmtRef_length block.statements)) {
            let item: ASTStmtRef = (list_ASTStmtRef_get block.statements j)
            if (and (== item.node_type ParseNodeType.PNODE_LET) (== item.node_id index)) { return false }
            set j (+ j 1)
        }
        set i (+ i 1)
    }
    set i 0
    while (< i (parser_get_function_count parser)) {
        let function: ASTFunction = (parser_get_function parser i)
        if (and (>= index function.param_start) (< index (+ function.param_start function.param_count))) { return false }
        set i (+ i 1)
    }
    return true
}
shadow nisa_is_global_let {
    let diagnostics: List<CompilerDiagnostic> = (diag_list_new)
    let source: string = (+ "let count: int = 1 f" "n main(arg: int) -> int { let local: int = 2 unsafe { let inner: int = 3 } return local } shadow main { let test: int = 4 }")
    let tokens: List<LexerToken> = (tokenize_string source "globals.nano" diagnostics)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "globals.nano")
    assert (nisa_is_global_let parser 0)
    let mut i: int = 1
    while (< i (parser_get_let_count parser)) {
        assert (not (nisa_is_global_let parser i))
        set i (+ i 1)
    }
}

fn nisa_global_let_flags(parser: Parser) -> array<bool> {
    let mut flags: array<bool> = (declaration_local_lets parser)
    let mut i: int = 0
    while (< i (array_length flags)) {
        (array_set flags i (not (at flags i)))
        set i (+ i 1)
    }
    return flags
}

shadow nisa_global_let_flags {
    let diagnostics: List<CompilerDiagnostic> = (diag_list_new)
    let source: string = (+ "let first: int = 1 f" "n f(arg: int) -> int { let local: int = 2 if true { let nested: int = 3 } unsafe { let inner: int = 4 } return local } shadow f { let test: int = 5 } let last: int = 6 fn main() -> int { return 0 }")
    let tokens: List<LexerToken> = (tokenize_string source "ownership.nano" diagnostics)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "ownership.nano")
    let flags: array<bool> = (nisa_global_let_flags parser)
    assert (== (array_length flags) (parser_get_let_count parser))
    let mut i: int = 0
    let mut globals: int = 0
    while (< i (array_length flags)) {
        assert (== (at flags i) (nisa_is_global_let parser i))
        if (at flags i) { set globals (+ globals 1) }
        set i (+ i 1)
    }
    assert (== globals 2)
}

# Global identity includes its merged-source owner; locals always win.
fn nisa_global_find(name: string, line: int) -> int {
    let owner: int = (mb_owner line)
    let mut i: int = 0
    while (< i (array_length nisa_global_names)) {
        if (and (== (at nisa_global_names i) name) (== (at nisa_global_owners i) owner)) { return i }
        set i (+ i 1)
    }
    return (- 0 1)
}
shadow nisa_global_find {
    let _: int = (nisa_reset)
    (mb_reset [1, 5])
    set nisa_global_names ["count", "count"]
    set nisa_global_owners [0, 1]
    assert (== (nisa_global_find "count" 1) 0)
    assert (== (nisa_global_find "count" 5) 1)
    assert (== (nisa_global_find "missing" 5) (- 0 1))
    let _2: int = (nisa_reset)
    (mb_reset [])
}

fn nisa_emit_globals(parser: Parser) -> string {
    let global_flags: array<bool> = (nisa_global_let_flags parser)
    let mut i: int = 0
    while (< i (array_length global_flags)) {
        if (at global_flags i) {
            let declaration: ASTLet = (parser_get_let parser i)
            if (or declaration.is_destructure (not (nisa_type_ok parser declaration.var_type))) {
                return (nisa_fail (+ "I cannot lower this global type: " declaration.var_type))
            }
            if (>= (nisa_global_find declaration.name declaration.line) 0) {
                return (nisa_fail (+ "I cannot redeclare this global: " declaration.name))
            }
            set nisa_global_names (array_push nisa_global_names declaration.name)
            set nisa_global_types (array_push nisa_global_types declaration.var_type)
            set nisa_global_owners (array_push nisa_global_owners (mb_owner declaration.line))
            set nisa_global_nodes (array_push nisa_global_nodes i)
        }
        set i (+ i 1)
    }
    if (== (array_length nisa_global_nodes) 0) { return "" }
    if (>= (nisa_fn_index parser "__init__") 0) {
        return (nisa_fail "I reserve __init__ for global initialization")
    }
    set nisa_names []
    set nisa_types []
    let mut body: string = ""
    set i 0
    while (< i (array_length nisa_global_nodes)) {
        let declaration: ASTLet = (parser_get_let parser (at nisa_global_nodes i))
        set body (+ body (nisa_emit_expected_expr parser declaration.value declaration.value_type declaration.var_type))
        set body (+ body (nisa_line_imm "STORE_GLOBAL" (int_to_string i)))
        set i (+ i 1)
    }
    let locals: int = (array_length nisa_names)
    set nisa_names []
    set nisa_types []
    let header: string = (+ ".function __init__ 0 " (+ (int_to_string locals) " 0 void 0\n"))
    return (+ header (+ body "  RET\n.end\n\n"))
}
shadow nisa_emit_globals {
    let _: int = (nisa_reset)
    let diagnostics: List<CompilerDiagnostic> = (diag_list_new)
    let source: string = (+ "let first: int = 7 let second: int = (+ first 1) f" "n main() -> int { return second }")
    let tokens: List<LexerToken> = (tokenize_string source "globals.nano" diagnostics)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "globals.nano")
    let output: string = (nisa_emit_globals parser)
    assert (str_contains output ".function __init__")
    assert (str_contains output "STORE_GLOBAL 0")
    assert (str_contains output "LOAD_GLOBAL 0")
    assert (str_contains output "STORE_GLOBAL 1")
    let _2: int = (nisa_reset)
    let filled: string = (+ "let xs: array<int> = (array_new 3 7) f" "n main() -> int { return 0 }")
    let filled_tokens: List<LexerToken> = (tokenize_string filled "globals.nano" diagnostics)
    let filled_parser: Parser = (parse_program filled_tokens (list_LexerToken_length filled_tokens) "globals.nano")
    let filled_output: string = (nisa_emit_globals filled_parser)
    assert (str_contains filled_output ".function __init__ 0 4 0 void 0")
    assert (== (array_length nisa_names) 0)
    assert (== (array_length nisa_types) 0)
    let _3: int = (nisa_reset)
}

# I preserve the supported string-key map value type through each operation.
fn nisa_map_opcode(name: string) -> string {
    if (== name "map_new") { return "HM_NEW" }
    if (== name "map_get") { return "HM_GET" }
    if (or (== name "map_put") (== name "map_set")) { return "HM_SET" }
    if (== name "map_has") { return "HM_HAS" }
    if (or (== name "map_size") (== name "map_length")) { return "HM_LEN" }
    return ""
}
shadow nisa_map_opcode {
    assert (== (nisa_map_opcode "map_put") "HM_SET")
    assert (== (nisa_map_opcode "map_new") "HM_NEW")
    assert (== (nisa_map_opcode "map_keys") "")
}

fn nisa_map_result(name: string) -> string {
    let opcode: string = (nisa_map_opcode name)
    if (== opcode "HM_NEW") { return "HashMap<string,int>" }
    if (== opcode "HM_SET") { return "void" }
    if (== opcode "HM_HAS") { return "bool" }
    if (or (== opcode "HM_GET") (== opcode "HM_LEN")) { return "int" }
    return ""
}
shadow nisa_map_result {
    assert (== (nisa_map_result "map_new") "HashMap<string,int>")
    assert (== (nisa_map_result "map_put") "void")
    assert (== (nisa_map_result "map_has") "bool")
    assert (== (nisa_map_result "map_get") "int")
    assert (== (nisa_map_result "unknown") "")
}

fn nisa_emit_map_call(parser: Parser, call: ASTCall, name: string) -> string {
    let opcode: string = (nisa_map_opcode name)
    let mut arity: int = 2
    if (== opcode "HM_NEW") { set arity 0 }
    if (== opcode "HM_LEN") { set arity 1 }
    if (== opcode "HM_SET") { set arity 3 }
    if (!= call.arg_count arity) { return (nisa_fail "map call arity mismatch") }
    if (== opcode "HM_NEW") { return (nisa_line_imm opcode "5 1") }
    let receiver: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
    let map_type: string = (nisa_expr_type parser receiver.node_id receiver.node_type)
    let value_type: string = (nisa_map_value_type map_type)
    if (== value_type "") { return (nisa_fail "I require a supported string-keyed map") }
    let mut i: int = 0
    while (< i arity) {
        let argument: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start i))
        let actual: string = (nisa_expr_type parser argument.node_id argument.node_type)
        let mut expected: string = map_type
        if (== i 1) { set expected "string" }
        if (== i 2) { set expected value_type }
        if (!= actual expected) { return (nisa_fail "I require map arguments to match their declared types") }
        set i (+ i 1)
    }
    let mut output: string = (+ (nisa_emit_call_args parser call) (nisa_line opcode))
    if (== opcode "HM_SET") { set output (+ output (nisa_line "POP")) }
    return output
}
shadow nisa_emit_map_call {
    let _: int = (nisa_reset)
    let diagnostics: List<CompilerDiagnostic> = (diag_list_new)
    let source: string = (+ "f" "n main() -> HashMap<string,int> { return (map_new) }")
    let tokens: List<LexerToken> = (tokenize_string source "t.nano" diagnostics)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "t.nano")
    assert (== (nisa_emit_map_call parser (parser_get_call parser 0) "map_new") "  HM_NEW 5 1\n")
}

# I name a bounded host ABI. Other externs need an explicit future contract.
fn nisa_host_result(name: string) -> string {
    let strings: array<string> = ["vm_string_from_char", "get_argv", "nl_os_getenv", "file_read", "vm_file_read", "path_normalize", "nl_exec_capture", "vm_getenv", "vm_getcwd", "vm_tmp_dir", "vm_mktemp", "vm_mktemp_dir"]
    let integers: array<string> = ["get_argc", "file_write", "vm_file_write", "file_delete", "file_compare_identity", "file_compare_destinations", "nl_exec_shell", "vm_chdir", "vm_dir_create", "vm_setenv"]
    let booleans: array<string> = ["vm_is_alnum", "file_exists", "vm_file_exists", "vm_dir_exists"]
    let mut i: int = 0
    while (< i (array_length strings)) {
        if (== name (at strings i)) { return "string" }
        set i (+ i 1)
    }
    set i 0
    while (< i (array_length integers)) {
        if (== name (at integers i)) { return "int" }
        set i (+ i 1)
    }
    set i 0
    while (< i (array_length booleans)) {
        if (== name (at booleans i)) { return "bool" }
        set i (+ i 1)
    }
    return ""
}
shadow nisa_host_result {
    assert (== (nisa_host_result "vm_getenv") "string")
    assert (== (nisa_host_result "vm_string_from_char") "string")
    assert (== (nisa_host_result "get_argc") "int")
    assert (== (nisa_host_result "file_exists") "bool")
    assert (== (nisa_host_result "vm_is_alnum") "bool")
    assert (== (nisa_host_result "arbitrary_foreign_function") "")
}

fn nisa_host_arity(name: string) -> int {
    if (== (nisa_host_result name) "") { return -1 }
    if (or (== name "get_argc") (or (== name "vm_getcwd") (== name "vm_tmp_dir"))) { return 0 }
    if (or (== name "file_write") (or (== name "vm_file_write")
            (or (== name "file_compare_identity") (or (== name "file_compare_destinations") (== name "vm_setenv"))))) { return 2 }
    return 1
}
shadow nisa_host_arity {
    assert (== (nisa_host_arity "get_argc") 0)
    assert (== (nisa_host_arity "vm_getenv") 1)
    assert (== (nisa_host_arity "file_write") 2)
    assert (== (nisa_host_arity "unknown") -1)
}

fn nisa_host_parameter(name: string) -> string {
    if (<= (nisa_host_arity name) 0) { return "" }
    if (or (== name "vm_is_alnum") (or (== name "get_argv") (== name "vm_string_from_char"))) { return "int" }
    return "string"
}
shadow nisa_host_parameter {
    assert (== (nisa_host_parameter "get_argv") "int")
    assert (== (nisa_host_parameter "vm_is_alnum") "int")
    assert (== (nisa_host_parameter "vm_string_from_char") "int")
    assert (== (nisa_host_parameter "vm_getenv") "string")
    assert (== (nisa_host_parameter "get_argc") "")
}

fn nisa_builtin_host_symbol(name: string) -> string {
    let names: array<string> = ["is_alnum", "string_from_char", "getenv", "getcwd", "chdir", "file_read", "file_write", "file_exists", "dir_exists", "dir_create", "tmp_dir", "mktemp", "mktemp_dir", "setenv"]
    let mut i: int = 0
    while (< i (array_length names)) {
        if (== name (at names i)) { return (+ "vm_" name) }
        set i (+ i 1)
    }
    return ""
}
shadow nisa_builtin_host_symbol {
    assert (== (nisa_builtin_host_symbol "getenv") "vm_getenv")
    assert (== (nisa_builtin_host_symbol "is_alnum") "vm_is_alnum")
    assert (== (nisa_builtin_host_symbol "string_from_char") "vm_string_from_char")
    assert (== (nisa_builtin_host_symbol "file_exists") "vm_file_exists")
    assert (== (nisa_builtin_host_symbol "get_argc") "")
}

fn nisa_call_host_symbol(parser: Parser, name: string) -> string {
    let index: int = (nisa_fn_index parser name)
    if (>= index 0) {
        let function: ASTFunction = (parser_get_function parser index)
        if (>= function.body 0) { return "" }
    }
    let builtin: string = (nisa_builtin_host_symbol name)
    if (!= builtin "") { return builtin }
    if (and (>= index 0) (!= (nisa_host_result name) "")) { return name }
    return ""
}
shadow nisa_call_host_symbol {
    let diagnostics: List<CompilerDiagnostic> = (diag_list_new)
    let source: string = (+ "extern f" "n get_argc() -> int fn getenv(name: string) -> string { return name }")
    let tokens: List<LexerToken> = (tokenize_string source "t.nano" diagnostics)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "t.nano")
    assert (== (nisa_call_host_symbol parser "get_argc") "get_argc")
    assert (== (nisa_call_host_symbol parser "getenv") "")
    assert (== (nisa_call_host_symbol parser "file_exists") "vm_file_exists")
    assert (== (nisa_call_host_symbol parser "unknown") "")
}

fn nisa_import_find(symbol: string) -> int {
    let mut i: int = 0
    while (< i (array_length nisa_import_names)) {
        if (== symbol (at nisa_import_names i)) { return i }
        set i (+ i 1)
    }
    return -1
}
shadow nisa_import_find {
    let _: int = (nisa_reset)
    set nisa_import_names ["get_argc", "vm_getenv"]
    assert (== (nisa_import_find "vm_getenv") 1)
    assert (== (nisa_import_find "missing") -1)
    let _2: int = (nisa_reset)
}

fn nisa_import_add(symbol: string) -> int {
    let index: int = (array_length nisa_import_names)
    let result: string = (nisa_host_result symbol)
    if (== result "") {
        let rejected: string = (nisa_fail (+ "unsupported host import " symbol))
        return -1
    }
    set nisa_import_names (array_push nisa_import_names symbol)
    set nisa_import_text (+ nisa_import_text (+ ".import \"\" \"" (+ symbol (+ "\" " result))))
    let mut i: int = 0
    while (< i (nisa_host_arity symbol)) {
        set nisa_import_text (+ nisa_import_text (+ " " (nisa_host_parameter symbol)))
        set i (+ i 1)
    }
    set nisa_import_text (+ nisa_import_text "\n")
    return index
}
shadow nisa_import_add {
    let _: int = (nisa_reset)
    assert (== (nisa_import_add "vm_getenv") 0)
    assert (== nisa_import_text ".import \"\" \"vm_getenv\" string string\n")
    let _2: int = (nisa_reset)
}

fn nisa_artifact_arity(name: string) -> int {
    if (== name "nl_nanoisa_assemble_save") { return 2 }
    if (or (== name "nl_nanoisa_assemble_text_save") (or (== name "file_append") (or (== name "file_copy") (== name "dir_copy")))) { return 2 }
    if (== name "nl_nanoisa_last_error") { return 0 }
    if (or (== name "path_join") (== name "path_relpath")) { return 2 }
    let names: array<string> = ["path_basename", "path_dirname", "path_normalize", "path_canonical", "nlc_module_artifact", "fs_walkdir", "fs_mkdir_p", "nl_nanoisa_load_print", "nl_nanoisa_load_pretty"]
    let mut i: int = 0
    while (< i (array_length names)) {
        if (== name (at names i)) { return 1 }
        set i (+ i 1)
    }
    return -1
}
shadow nisa_artifact_arity {
    assert (== (nisa_artifact_arity "nl_nanoisa_assemble_save") 2)
    assert (== (nisa_artifact_arity "nl_nanoisa_load_print") 1)
    assert (== (nisa_artifact_arity "nl_nanoisa_load_pretty") 1)
    assert (== (nisa_artifact_arity "fs_walkdir") 1)
    assert (== (nisa_artifact_arity "fs_mkdir_p") 1)
    assert (== (nisa_artifact_arity "file_append") 2)
    assert (== (nisa_artifact_arity "file_copy") 2)
    assert (== (nisa_artifact_arity "dir_copy") 2)
    assert (== (nisa_artifact_arity "path_basename") 1)
    assert (== (nisa_artifact_arity "path_join") 2)
    assert (== (nisa_artifact_arity "nlc_module_artifact") 1)
    assert (== (nisa_artifact_arity "nl_nanoisa_assemble_text_save") 2)
    assert (== (nisa_artifact_arity "nl_nanoisa_last_error") 0)
    assert (== (nisa_artifact_arity "arbitrary") -1)
}

fn nisa_artifact_result(name: string) -> string {
    if (== name "nl_nanoisa_assemble_save") { return "int" }
    if (== name "fs_walkdir") { return "array<string>" }
    if (or (== name "nl_nanoisa_assemble_text_save") (or (== name "file_append") (or (== name "fs_mkdir_p") (or (== name "file_copy") (== name "dir_copy"))))) { return "int" }
    if (>= (nisa_artifact_arity name) 0) { return "string" }
    return ""
}
shadow nisa_artifact_result {
    assert (== (nisa_artifact_result "nl_nanoisa_assemble_save") "int")
    assert (== (nisa_artifact_result "nl_nanoisa_load_print") "string")
    assert (== (nisa_artifact_result "nl_nanoisa_load_pretty") "string")
    assert (== (nisa_artifact_result "nl_nanoisa_assemble_text_save") "int")
    assert (== (nisa_artifact_result "nl_nanoisa_last_error") "string")
    assert (== (nisa_artifact_result "fs_walkdir") "array<string>")
    assert (== (nisa_artifact_result "fs_mkdir_p") "int")
    assert (== (nisa_artifact_result "file_append") "int")
    assert (== (nisa_artifact_result "file_copy") "int")
    assert (== (nisa_artifact_result "dir_copy") "int")
    assert (== (nisa_artifact_result "path_join") "string")
    assert (== (nisa_artifact_result "unknown") "")
}

fn nisa_artifact_path(owner: int) -> string {
    let mut i: int = 0
    while (< i (array_length nisa_artifact_owners)) {
        if (== owner (at nisa_artifact_owners i)) { return (at nisa_artifact_paths i) }
        set i (+ i 1)
    }
    let source: string = (mb_source owner)
    if (== source "") { return (nisa_fail "I require the owning source for an artifact import") }
    let path: string = (CompilerSupport.module_artifact source)
    if (not (str_starts_with path "/")) { return (nisa_fail (+ "I cannot build the owning module artifact: " source)) }
    set nisa_artifact_owners (array_push nisa_artifact_owners owner)
    set nisa_artifact_paths (array_push nisa_artifact_paths path)
    return path
}
shadow nisa_artifact_path {
    let reset: int = (nisa_reset)
    set nisa_artifact_owners [2]
    set nisa_artifact_paths ["/retained/artifact.so"]
    assert (== (nisa_artifact_path 2) "/retained/artifact.so")
    (mb_reset [])
    assert (== (nisa_artifact_path 0) "")
    assert (not nisa_ok)
    let reset_again: int = (nisa_reset)
}

fn nisa_register_artifact(parser: Parser, function: ASTFunction) -> int {
    let arity: int = (nisa_artifact_arity function.name)
    let result: string = (nisa_artifact_result function.name)
    if (or (< arity 0) (or (!= function.return_type result) (!= function.param_count arity))) {
        let rejected: string = (nisa_fail "I require the exact artifact result and arity")
        return -1
    }
    let mut i: int = 0
    while (< i arity) {
        let parameter: ASTLet = (parser_get_let parser (+ function.param_start i))
        if (!= parameter.var_type "string") {
            let rejected: string = (nisa_fail "I require the exact artifact parameter types")
            return -1
        }
        set i (+ i 1)
    }
    let owner: int = (mb_owner function.line)
    let key: string = (+ "#artifact:" (+ (int_to_string owner) (+ ":" function.name)))
    let existing: int = (nisa_import_find key)
    if (>= existing 0) { return existing }
    let path: string = (nisa_artifact_path owner)
    if (== path "") { return -1 }
    let index: int = (array_length nisa_import_names)
    set nisa_import_names (array_push nisa_import_names key)
    set nisa_import_text (+ nisa_import_text (+ ".import \"" (+ (nisa_escape_string path) (+ "\" \"" (+ function.name (+ "\" " (nisa_result_tag parser result)))))))
    set i 0
    while (< i arity) { set nisa_import_text (+ nisa_import_text " string") set i (+ i 1) }
    set nisa_import_text (+ nisa_import_text (+ "\n.import_kind " (+ (int_to_string index) " artifact\n")))
    return index
}
shadow nisa_register_artifact {
    let reset: int = (nisa_reset)
    let tokens: List<LexerToken> = (tokenize_string "extern fn path_basename(path: string) -> string" "artifact.nano" (diag_list_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "artifact.nano")
    (mb_reset [1])
    set nisa_artifact_owners [0]
    set nisa_artifact_paths ["/retained/a\"b.so"]
    assert (== (nisa_register_artifact parser (parser_get_function parser 0)) 0)
    assert (str_contains nisa_import_text ".import_kind 0 artifact")
    assert (== (nisa_register_artifact parser (parser_get_function parser 0)) 0)
    assert (== (array_length nisa_import_names) 1)
    (mb_reset [])
    let reset_again: int = (nisa_reset)
}

fn nisa_metadata_operation(name: string) -> string {
    let operations: array<string> = ["is_unsafe", "has_ffi", "name", "path", "function_count", "struct_count", "function_name", "struct_name"]
    let mut i: int = 0
    while (< i (array_length operations)) {
        let operation: string = (at operations i)
        if (str_starts_with name (+ "___module_" (+ operation "_"))) { return operation }
        set i (+ i 1)
    }
    return ""
}
shadow nisa_metadata_operation {
    assert (== (nisa_metadata_operation "___module_function_name_probe") "function_name")
    assert (== (nisa_metadata_operation "ordinary") "")
}

fn nisa_metadata_index(name: string) -> int {
    let operation: string = (nisa_metadata_operation name)
    if (== operation "") { return -1 }
    let prefix: string = (+ "___module_" (+ operation "_"))
    let module_name: string = (str_substring name (str_length prefix) (- (str_length name) (str_length prefix)))
    let mut i: int = 0
    while (< i (array_length nisa_module_facts)) {
        if (== (at nisa_module_facts i).name module_name) { return i }
        set i (+ i 1)
    }
    return -1
}
shadow nisa_metadata_index {
    set nisa_module_facts [(mi_scan "module probe" "probe.nano" "probe")]
    assert (== (nisa_metadata_index "___module_path_probe") 0)
    assert (== (nisa_metadata_index "___module_path_missing") -1)
    let reset: int = (nisa_reset)
}

fn nisa_metadata_function(function: ASTFunction) -> bool {
    return (and (< function.body 0) (!= (nisa_metadata_operation function.name) ""))
}
shadow nisa_metadata_function {
    let tokens: List<LexerToken> = (tokenize_string "extern fn ___module_name_probe() -> string" "facts.nano" (diag_list_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "facts.nano")
    assert (nisa_metadata_function (parser_get_function parser 0))
}

fn nisa_metadata_validate(parser: Parser, function: ASTFunction) -> bool {
    let operation: string = (nisa_metadata_operation function.name)
    let index: int = (nisa_metadata_index function.name)
    if (< index 0) {
        let rejected: string = (nisa_fail (+ "I require retained module facts for " function.name))
        return false
    }
    let mut result: string = "string"
    let mut arity: int = 0
    if (or (== operation "is_unsafe") (== operation "has_ffi")) { set result "bool" }
    if (or (== operation "function_count") (== operation "struct_count")) { set result "int" }
    if (or (== operation "function_name") (== operation "struct_name")) { set arity 1 }
    if (or (!= function.return_type result) (!= function.param_count arity)) {
        let rejected: string = (nisa_fail "I require the declared module introspection signature")
        return false
    }
    if (== arity 1) {
        if (!= (parser_get_let parser function.param_start).var_type "int") {
            let rejected: string = (nisa_fail "I require an integer module introspection index")
            return false
        }
    }
    return true
}
shadow nisa_metadata_validate {
    let tokens: List<LexerToken> = (tokenize_string "extern fn ___module_name_probe() -> string" "facts.nano" (diag_list_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "facts.nano")
    set nisa_module_facts [(mi_scan "module probe" "probe.nano" "probe")]
    assert (nisa_metadata_validate parser (parser_get_function parser 0))
    let reset: int = (nisa_reset)
}

fn nisa_metadata_names(values: array<string>, argument: string) -> string {
    let done: string = (nisa_fresh)
    let mut output: string = argument
    let mut i: int = 0
    while (< i (array_length values)) {
        let next: string = (nisa_fresh)
        set output (+ output (nisa_line "DUP"))
        set output (+ output (nisa_line_imm "PUSH_I64" (int_to_string i)))
        set output (+ output (nisa_line "I64_EQ"))
        set output (+ output (nisa_line_imm "JMP_FALSE" next))
        set output (+ output (nisa_line "POP"))
        set output (+ output (nisa_line_imm "PUSH_STR" (nisa_intern (at values i))))
        set output (+ output (nisa_line_imm "JMP" done))
        set output (+ output (nisa_label_line next))
        set i (+ i 1)
    }
    set output (+ output (nisa_line "POP"))
    set output (+ output (nisa_line_imm "PUSH_STR" (nisa_intern "")))
    return (+ output (nisa_label_line done))
}
shadow nisa_metadata_names {
    let reset: int = (nisa_reset)
    assert (str_contains (nisa_metadata_names ["visible"] "  PUSH_I64 0\n") "I64_EQ")
    assert (== (at nisa_str_vals 0) "visible")
    let reset_again: int = (nisa_reset)
}

fn nisa_emit_metadata_call(parser: Parser, call: ASTCall) -> string {
    let index: int = (nisa_call_index parser call)
    if (< index 0) { return (nisa_fail "I require a bound module introspection declaration") }
    let function: ASTFunction = (parser_get_function parser index)
    if (not (nisa_metadata_validate parser function)) { return "" }
    if (!= call.arg_count function.param_count) { return (nisa_fail "I require the module introspection argument count") }
    let info: ModuleIntrospection = (at nisa_module_facts (nisa_metadata_index function.name))
    let operation: string = (nisa_metadata_operation function.name)
    if (== operation "name") { return (nisa_line_imm "PUSH_STR" (nisa_intern info.name)) }
    if (== operation "path") { return (nisa_line_imm "PUSH_STR" (nisa_intern info.path)) }
    if (== operation "function_count") { return (nisa_line_imm "PUSH_I64" (int_to_string (array_length info.functions))) }
    if (== operation "struct_count") { return (nisa_line_imm "PUSH_I64" (int_to_string (array_length info.structs))) }
    if (== operation "is_unsafe") {
        if info.is_unsafe { return (nisa_line_imm "PUSH_BOOL" "1") }
        return (nisa_line_imm "PUSH_BOOL" "0")
    }
    if (== operation "has_ffi") {
        if info.has_ffi { return (nisa_line_imm "PUSH_BOOL" "1") }
        return (nisa_line_imm "PUSH_BOOL" "0")
    }
    let argument: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
    if (!= (nisa_expr_type parser argument.node_id argument.node_type) "int") {
        return (nisa_fail "I require an integer module introspection index")
    }
    let value: string = (nisa_emit_expr parser argument.node_id argument.node_type)
    if (== operation "function_name") { return (nisa_metadata_names info.functions value) }
    return (nisa_metadata_names info.structs value)
}
shadow nisa_emit_metadata_call {
    let reset: int = (nisa_reset)
    let tokens: List<LexerToken> = (tokenize_string "extern fn ___module_name_probe() -> string fn main() -> string { return (___module_name_probe) }" "facts.nano" (diag_list_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "facts.nano")
    set nisa_module_facts [(mi_scan "module probe" "probe.nano" "probe")]
    assert (str_contains (nisa_emit_metadata_call parser (parser_get_call parser 0)) "PUSH_STR")
    assert (== (at nisa_str_vals 0) "probe")
    let reset_again: int = (nisa_reset)
}

fn nisa_register_extern(parser: Parser, function: ASTFunction) -> int {
    if (nisa_metadata_function function) {
        if (nisa_metadata_validate parser function) { return 0 }
        return -1
    }
    if (>= (nisa_artifact_arity function.name) 0) { return (nisa_register_artifact parser function) }
    let result: string = (nisa_host_result function.name)
    if (or (== result "") (!= result function.return_type)) {
        let rejected: string = (nisa_fail (+ "unsupported extern result or symbol " function.name))
        return -1
    }
    if (!= function.param_count (nisa_host_arity function.name)) {
        let rejected: string = (nisa_fail (+ "extern arity does not match my host ABI: " function.name))
        return -1
    }
    let mut i: int = 0
    while (< i function.param_count) {
        let parameter: ASTLet = (parser_get_let parser (+ function.param_start i))
        if (!= parameter.var_type (nisa_host_parameter function.name)) {
            let rejected: string = (nisa_fail (+ "extern parameter does not match my host ABI: " function.name))
            return -1
        }
        set i (+ i 1)
    }
    return (nisa_import_add function.name)
}
shadow nisa_register_extern {
    let _: int = (nisa_reset)
    let diagnostics: List<CompilerDiagnostic> = (diag_list_new)
    let source: string = (+ "extern f" "n get_argv(index: int) -> string")
    let tokens: List<LexerToken> = (tokenize_string source "t.nano" diagnostics)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "t.nano")
    assert (== (nisa_register_extern parser (parser_get_function parser 0)) 0)
    assert (str_contains nisa_import_text "string int")
    let _2: int = (nisa_reset)
}

fn nisa_emit_host_call(parser: Parser, call: ASTCall, symbol: string) -> string {
    if (!= call.arg_count (nisa_host_arity symbol)) { return (nisa_fail "host call arity mismatch") }
    let mut i: int = 0
    while (< i call.arg_count) {
        let argument: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start i))
        let argument_type: string = (nisa_expr_type parser argument.node_id argument.node_type)
        if (!= argument_type (nisa_host_parameter symbol)) { return (nisa_fail "host call parameter type mismatch") }
        set i (+ i 1)
    }
    let mut index: int = (nisa_import_find symbol)
    if (< index 0) { set index (nisa_import_add symbol) }
    return (+ (nisa_emit_call_args parser call) (nisa_line_imm "CALL_EXTERN" (int_to_string index)))
}
shadow nisa_emit_host_call {
    let _: int = (nisa_reset)
    let diagnostics: List<CompilerDiagnostic> = (diag_list_new)
    let source: string = (+ "f" "n main() -> string { return (getenv \"TEST\") }")
    let tokens: List<LexerToken> = (tokenize_string source "t.nano" diagnostics)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "t.nano")
    let text: string = (nisa_emit_host_call parser (parser_get_call parser 0) "vm_getenv")
    assert (str_contains text "CALL_EXTERN 0")
    assert (str_contains nisa_import_text "vm_getenv")
    let _2: int = (nisa_reset)
}

# I preserve argument storage while adapting qualified calls to one call path.
fn nisa_get_call(parser: Parser, node_id: int, node_type: int) -> ASTCall {
    if (== node_type ParseNodeType.PNODE_MODULE_QUALIFIED_CALL) {
        let qualified: ASTModuleQualifiedCall = (parser_get_module_qualified_call parser node_id)
        return ASTCall { borrow_mode: 0, node_type: ParseNodeType.PNODE_CALL, line: qualified.line,
            column: qualified.column, function: node_id,
            function_type: ParseNodeType.PNODE_MODULE_QUALIFIED_CALL,
            arg_start: qualified.arg_start, arg_count: qualified.arg_count }
    }
    return (parser_get_call parser node_id)
}
shadow nisa_get_call {
    let diagnostics: List<CompilerDiagnostic> = (diag_list_new)
    let source: string = (+ "f" "n main() -> int { return (lib.value 7) }")
    let tokens: List<LexerToken> = (tokenize_string source "call.nano" diagnostics)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "call.nano")
    let call: ASTCall = (nisa_get_call parser 0 ParseNodeType.PNODE_MODULE_QUALIFIED_CALL)
    assert (== call.arg_count 1)
    assert (== call.function_type ParseNodeType.PNODE_MODULE_QUALIFIED_CALL)
}

fn nisa_call_name(parser: Parser, call: ASTCall) -> string {
    if (== call.function_type ParseNodeType.PNODE_MODULE_QUALIFIED_CALL) {
        let qualified: ASTModuleQualifiedCall = (parser_get_module_qualified_call parser call.function)
        return (mb_lookup (mb_owner qualified.line) qualified.function_name)
    }
    if (!= call.function_type ParseNodeType.PNODE_IDENTIFIER) { return "" }
    let identifier: ASTIdentifier = (parser_get_identifier parser call.function)
    if (or (>= (nisa_local_find identifier.name) 0) (>= (nisa_global_find identifier.name identifier.line) 0)) {
        return (nisa_fail "I cannot resolve an indirect call target in this emitter")
    }
    return (mb_resolve identifier.name identifier.line nisa_names)
}
# I resolve duplicate C-linkage spellings by the declaration's source owner.
fn nisa_call_index(parser: Parser, call: ASTCall) -> int {
    let name: string = (nisa_call_name parser call)
    let mut original: string = ""
    if (== call.function_type ParseNodeType.PNODE_MODULE_QUALIFIED_CALL) {
        set original (parser_get_module_qualified_call parser call.function).function_name
    } else {
        if (!= call.function_type ParseNodeType.PNODE_IDENTIFIER) { return -1 }
        set original (parser_get_identifier parser call.function).name
    }
    let owner: int = (mb_target_owner (mb_owner call.line) original)
    if (>= owner 0) {
        let mut i: int = 0
        while (< i (parser_get_function_count parser)) {
            let function: ASTFunction = (parser_get_function parser i)
            if (and (== function.name name) (== (mb_owner function.line) owner)) { return i }
            set i (+ i 1)
        }
    }
    let fallback: int = (nisa_fn_index parser name)
    if (or (< owner 0) (< fallback 0)) { return fallback }
    if (>= (parser_get_function parser fallback).body 0) { return fallback }
    return -1
}
shadow nisa_call_index {
    let reset: int = (nisa_reset)
    let tokens: List<LexerToken> = (tokenize_string "extern fn path_basename(p: string) -> string\nextern fn path_basename(p: string) -> string\nfn main() -> string { return (second \"x\") }" "owner.nano" (diag_list_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "owner.nano")
    (mb_reset [1, 2, 3])
    (mb_add_target 2 "second" "path_basename" 1)
    assert (== (nisa_call_index parser (parser_get_call parser 0)) 1)
    (mb_reset [])
    let reset_again: int = (nisa_reset)
}

shadow nisa_call_name {
    let diagnostics: List<CompilerDiagnostic> = (diag_list_new)
    let source: string = (+ "f" "n main() -> int { return (answer) }")
    let tokens: List<LexerToken> = (tokenize_string source "call.nano" diagnostics)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "call.nano")
    let _: int = (nisa_reset)
    (mb_reset [1])
    (mb_add 0 "answer" "bound_answer")
    assert (== (nisa_call_name parser (parser_get_call parser 0)) "bound_answer")
    set nisa_names ["answer"]
    assert (== (nisa_call_name parser (parser_get_call parser 0)) "")
    assert (not nisa_ok)
    let _2: int = (nisa_reset)
    (mb_reset [])
}

fn nisa_element_type(parser: Parser, container: string) -> string {
    if (== container "array<bool>") { return "bool" }
    if (and (str_starts_with container "array<") (str_ends_with container ">")) {
        let element: string = (str_substring container 6 (- (str_length container) 7))
        if (or (>= (nisa_enum_index parser element) 0) (nisa_is_pin_record parser element)) { return element }
    }
    if (or (== container "array<int>") (or (== container "List<int>") (== container "list_int"))) { return "int" }
    if (or (== container "array<string>") (or (== container "List<string>") (== container "list_string"))) { return "string" }
    if (and (str_starts_with container "List<") (str_ends_with container ">")) {
        let element: string = (str_substring container 5 (- (str_length container) 6))
        if (or (>= (nisa_enum_index parser element) 0) (nisa_is_pin_record parser element)) { return element }
    }
    return ""
}
shadow nisa_element_type {
    let diagnostics: List<CompilerDiagnostic> = (diag_list_new)
    let tokens: List<LexerToken> = (tokenize_string "struct Entry { text: string }" "element.nano" diagnostics)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "element.nano")
    assert (== (nisa_element_type parser "array<string>") "string")
    assert (== (nisa_element_type parser "List<int>") "int")
    assert (== (nisa_element_type parser "List<Entry>") "Entry")
    assert (== (nisa_element_type parser "array<bool>") "bool")
}

fn nisa_access_result(parser: Parser, call: ASTCall) -> string {
    if (!= call.arg_count 2) { return (nisa_fail "I require a container and integer index") }
    let object: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
    let index: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
    if (!= (nisa_expr_type parser index.node_id index.node_type) "int") {
        return (nisa_fail "I require an integer index")
    }
    let container: string = (nisa_expr_type parser object.node_id object.node_type)
    let element: string = (nisa_element_type parser container)
    if (== element "") { return (nisa_fail "I require a supported typed container for element access") }
    let name: string = (nisa_call_name parser call)
    if (nisa_is_list_call name) {
        let declared: string = (str_substring name 5 (- (str_length name) 9))
        if (!= declared element) { return (nisa_fail "I require the list accessor to match its element type") }
    }
    return element
}
shadow nisa_access_result {
    let _: int = (nisa_reset)
    let diagnostics: List<CompilerDiagnostic> = (diag_list_new)
    let tokens: List<LexerToken> = (tokenize_string (+ "f" "n first(words: array<string>) -> string { return (at words 0) }") "element.nano" diagnostics)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "element.nano")
    set nisa_names ["words"]
    set nisa_types ["array<string>"]
    assert (== (nisa_access_result parser (parser_get_call parser 0)) "string")
    let _2: int = (nisa_reset)
}

# I specialize only an empty literal; an established receiver keeps its type.
fn nisa_push_container_type(parser: Parser, call: ASTCall) -> string {
    if (!= call.arg_count 2) { return "" }
    let object: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
    if (and (== (nisa_call_name parser call) "array_push") (== object.node_type ParseNodeType.PNODE_ARRAY_LITERAL)) {
        let literal: ASTArrayLiteral = (parser_get_array_literal parser object.node_id)
        if (== literal.element_count 0) {
            let value: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
            let container: string = (+ "array<" (+ (nisa_expr_type parser value.node_id value.node_type) ">"))
            if (nisa_type_ok parser container) { return container }
            return ""
        }
    }
    return (nisa_expr_type parser object.node_id object.node_type)
}
shadow nisa_push_container_type {
    let reset: int = (nisa_reset)
    let tokens: List<LexerToken> = (tokenize_string "fn main() -> int { let values: array<string> = (array_push [] \"value\") return 0 }" "append.nano" (diag_list_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "append.nano")
    assert (== (nisa_push_container_type parser (parser_get_call parser 0)) "array<string>")
}

fn nisa_expr_type(parser: Parser, node_id: int, node_type: int) -> string {
    if (== node_type ParseNodeType.PNODE_STRUCT_LITERAL) {
        let literal: ASTStructLiteral = (parser_get_struct_literal parser node_id)
        return literal.struct_name
    }
    if (== node_type ParseNodeType.PNODE_ARRAY_LITERAL) {
        let literal: ASTArrayLiteral = (parser_get_array_literal parser node_id)
        let mut element: string = "int"
        let mut i: int = 0
        while (< i literal.element_count) {
            let value: ASTStmtRef = (parser_get_array_element parser (+ literal.element_start i))
            let actual: string = (nisa_expr_type parser value.node_id value.node_type)
            if (== i 0) { set element actual }
            if (!= actual element) { return "" }
            set i (+ i 1)
        }
        if (or (== element "bool") (or (== element "int") (or (== element "string") (or (>= (nisa_enum_index parser element) 0) (nisa_is_pin_record parser element))))) { return (+ "array<" (+ element ">")) }
        return ""
    }
    if (== node_type ParseNodeType.PNODE_STRING) { return "string" }
    if (== node_type ParseNodeType.PNODE_BOOL) { return "bool" }
    if (== node_type ParseNodeType.PNODE_NUMBER) { return "int" }
    if (== node_type ParseNodeType.PNODE_FLOAT) { return "float" }
    if (== node_type ParseNodeType.PNODE_IDENTIFIER) {
        let identifier: ASTIdentifier = (parser_get_identifier parser node_id)
        let slot: int = (nisa_local_find identifier.name)
        if (< slot 0) {
            let global: int = (nisa_global_find identifier.name identifier.line)
            if (< global 0) { return "" }
            return (at nisa_global_types global)
        }
        if (>= slot (array_length nisa_types)) { return "" }
        return (at nisa_types slot)
    }
    if (== node_type ParseNodeType.PNODE_FIELD_ACCESS) {
        let access: ASTFieldAccess = (parser_get_field_access parser node_id)
        let enum_index: int = (nisa_enum_receiver parser access)
        if (>= enum_index 0) { return (parser_get_enum parser enum_index).name }
        let object_type: string = (nisa_expr_type parser access.object access.object_type)
        let record_index: int = (nisa_struct_index parser object_type)
        if (< record_index 0) { return "" }
        let record: ASTStruct = (parser_get_struct_def parser record_index)
        let mut field: int = 0
        while (< field record.field_count) {
            if (== (at record.field_names field) access.field_name) {
                return (at record.field_types field)
            }
            set field (+ field 1)
        }
        return ""
    }
    if (or (== node_type ParseNodeType.PNODE_CALL) (== node_type ParseNodeType.PNODE_MODULE_QUALIFIED_CALL)) {
        let call: ASTCall = (nisa_get_call parser node_id node_type)
        let target_name: string = (nisa_call_name parser call)
        if (and (!= (nisa_string_binary_opcode target_name) "") (< (nisa_call_index parser call) 0)) {
            if (== target_name "str_concat") { return "string" }
            return "bool"
        }
        if (== target_name "range") { return "array<int>" }
        if (== target_name "array_new") {
            if (!= call.arg_count 2) { return "" }
            let fill: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start 1))
            let result: string = (+ "array<" (+ (nisa_expr_type parser fill.node_id fill.node_type) ">"))
            if (nisa_type_ok parser result) { return result }
            return ""
        }
        if (nisa_is_set_call target_name) { return "void" }
        if (and (nisa_is_list_call target_name) (str_ends_with target_name "_new")) {
            let element: string = (str_substring target_name 5 (- (str_length target_name) 9))
            let container: string = (+ "List<" (+ element ">"))
            if (!= (nisa_element_type parser container) "") { return container }
            return ""
        }
        if (and (== target_name "array_push") (== call.arg_count 2)) {
            return (nisa_push_container_type parser call)
        }
        if (or (== target_name "at") (or (== target_name "array_get")
                (and (nisa_is_list_call target_name) (str_ends_with target_name "_get")))) {
            return (nisa_access_result parser call)
        }
        if (== target_name "string_to_int") { return "int" }
        if (and (== (nisa_map_opcode target_name) "HM_GET") (== call.arg_count 2)) {
            let receiver: ASTStmtRef = (parser_get_call_arg parser call.arg_start)
            return (nisa_map_value_type (nisa_expr_type parser receiver.node_id receiver.node_type))
        }
        let map_result: string = (nisa_map_result target_name)
        if (!= map_result "") { return map_result }
        let host_symbol: string = (nisa_call_host_symbol parser target_name)
        if (!= host_symbol "") { return (nisa_host_result host_symbol) }
        if (or (== target_name "float_to_string") (or (== target_name "str_substring") (== target_name "int_to_string"))) { return "string" }
        if (or (== target_name "not") (== target_name "str_contains")) { return "bool" }
        if (or (== target_name "str_length")
               (or (== target_name "char_at") (== target_name "str_char_at"))) { return "int" }
        if (or (== target_name "array_length")
               (and (nisa_is_list_call target_name) (str_ends_with target_name "_length"))) { return "int" }
        let function_index: int = (nisa_call_index parser call)
        if (< function_index 0) { return "" }
        let function: ASTFunction = (parser_get_function parser function_index)
        return function.return_type
    }
    if (== node_type ParseNodeType.PNODE_BINARY_OP) {
        let binary: ASTBinaryOp = (parser_get_binary_op parser node_id)
        if binary.is_unary { return (nisa_expr_type parser binary.right binary.right_type) }
        if (or (== binary.op LexerTokenType.TOKEN_EQ)
               (or (== binary.op LexerTokenType.TOKEN_NE)
                   (or (== binary.op LexerTokenType.TOKEN_LT)
                       (or (== binary.op LexerTokenType.TOKEN_LE)
                           (or (== binary.op LexerTokenType.TOKEN_GT)
                               (or (== binary.op LexerTokenType.TOKEN_GE)
                                   (or (== binary.op LexerTokenType.TOKEN_AND)
                                       (== binary.op LexerTokenType.TOKEN_OR)))))))) { return "bool" }
        let left: string = (nisa_expr_type parser binary.left binary.left_type)
        let right: string = (nisa_expr_type parser binary.right binary.right_type)
        if (and (== binary.op LexerTokenType.TOKEN_PLUS)
                (and (== left "string") (== right "string"))) { return "string" }
        if (and (== left "float") (== right "float")) { return "float" }
        if (and (nisa_value_type_matches parser left "int") (nisa_value_type_matches parser right "int")) { return "int" }
    }
    return ""
}

shadow nisa_expr_type {
    let _: int = (nisa_reset)
    let diagnostics: List<CompilerDiagnostic> = (diag_list_new)
    let source: string = (+ "struct Options { label: string, flag: bool } f" "n probe(options: Options) -> string { return (str_concat options.label (int_to_string 42)) }")
    let tokens: List<LexerToken> = (tokenize_string source "t.nano" diagnostics)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "t.nano")
    set nisa_names ["options"]
    set nisa_types ["Options"]
    let function: ASTFunction = (parser_get_function parser 0)
    let block: ASTBlock = (parser_get_block parser function.body)
    let statement: ASTStmtRef = (list_ASTStmtRef_get block.statements 0)
    let result: ASTReturn = (parser_get_return parser statement.node_id)
    assert (== (nisa_expr_type parser result.value result.value_type) "string")
    let _2: int = (nisa_reset)
}

fn nisa_expr_is_string(parser: Parser, node_id: int, node_type: int) -> bool {
    return (== (nisa_expr_type parser node_id node_type) "string")
}

shadow nisa_expr_is_string {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n greeting() -> string { return \"hi\" } shadow greeting { assert (== (greeting) \"hi\") }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 0)
    let r: ASTReturn = (parser_get_return p stmt.node_id)
    assert (nisa_expr_is_string p r.value r.value_type)
    let _2: int = (nisa_reset)
}

fn nisa_is_map_constructor(parser: Parser, node_id: int, node_type: int) -> bool {
    if (and (!= node_type ParseNodeType.PNODE_CALL) (!= node_type ParseNodeType.PNODE_MODULE_QUALIFIED_CALL)) { return false }
    let call: ASTCall = (nisa_get_call parser node_id node_type)
    return (and (== call.arg_count 0)
        (and (== (nisa_call_name parser call) "map_new") (< (nisa_call_index parser call) 0)))
}
shadow nisa_is_map_constructor {
    let _: int = (nisa_reset)
    let source: string = (+ "f" "n main() -> HashMap<string,string> { return (map_new) }")
    let tokens: List<LexerToken> = (tokenize_string source "map.nano" (diag_list_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "map.nano")
    assert (nisa_is_map_constructor parser 0 ParseNodeType.PNODE_CALL)
    assert (not (nisa_is_map_constructor parser 0 ParseNodeType.PNODE_NUMBER))
}

# I carry declared constructor context without changing the AST.
fn nisa_emit_expected_expr(parser: Parser, node_id: int, node_type: int, expected: string) -> string {
    if (!= expected "") {
        let actual: string = (nisa_expr_type parser node_id node_type)
        if (and (or (== expected "float") (== actual "float")) (!= actual expected)) {
            return (nisa_fail "I require the declared float value type")
        }
    }
    if (and (!= (nisa_map_value_type expected) "") (nisa_is_map_constructor parser node_id node_type)) {
        if (== (nisa_map_value_type expected) "string") { return (nisa_line_imm "HM_NEW" "5 5") }
        return (nisa_line_imm "HM_NEW" "5 1")
    }
    if (and (!= (nisa_map_value_type expected) "")
            (!= (nisa_expr_type parser node_id node_type) expected)) {
        return (nisa_fail "I require the declared map key and value types")
    }
    if (and (== node_type ParseNodeType.PNODE_ARRAY_LITERAL)
            (and (str_starts_with expected "array<") (nisa_type_ok parser expected))) {
        let literal: ASTArrayLiteral = (parser_get_array_literal parser node_id)
        let mut tag: string = "1"
        let element: string = (nisa_element_type parser expected)
        if (== element "string") { set tag "5" }
        if (== element "bool") { set tag "4" }
        if (nisa_is_pin_record parser element) { set tag "8" }
        let mut output: string = ""
        let mut i: int = 0
        while (< i literal.element_count) {
            let value: ASTStmtRef = (parser_get_array_element parser (+ literal.element_start i))
            if (not (nisa_value_type_matches parser (nisa_expr_type parser value.node_id value.node_type) element)) {
                return (nisa_fail "array element does not match my declared type")
            }
            set output (+ output (nisa_emit_expr parser value.node_id value.node_type))
            set i (+ i 1)
        }
        return (+ output (nisa_line_imm "ARR_LITERAL" (+ tag (+ " " (int_to_string literal.element_count)))))
    }
    return (nisa_emit_expr parser node_id node_type)
}
shadow nisa_emit_expected_expr {
    let diagnostics: List<CompilerDiagnostic> = (diag_list_new)
    let source: string = (+ "f" "n main() -> array<string> { return [] }")
    let tokens: List<LexerToken> = (tokenize_string source "array.nano" diagnostics)
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "array.nano")
    assert (== (nisa_emit_expected_expr parser 0 ParseNodeType.PNODE_ARRAY_LITERAL "array<string>") "  ARR_LITERAL 5 0\n")
    assert (== (nisa_emit_expected_expr parser 0 ParseNodeType.PNODE_ARRAY_LITERAL "array<int>") "  ARR_LITERAL 1 0\n")
    assert (== (nisa_emit_expected_expr parser 0 ParseNodeType.PNODE_ARRAY_LITERAL "array<bool>") "  ARR_LITERAL 4 0\n")
}

fn nisa_emit_call_args(parser: Parser, call: ASTCall) -> string {
    let mut args: string = ""
    let mut i: int = 0
    while (< i call.arg_count) {
        let a: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start i))
        let mut expected: string = ""
        let function_index: int = (nisa_call_index parser call)
        if (>= function_index 0) {
            let function: ASTFunction = (parser_get_function parser function_index)
            if (< i function.param_count) {
                let parameter: ASTLet = (parser_get_let parser (+ function.param_start i))
                set expected parameter.var_type
            }
        }
        set args (+ args (nisa_emit_expected_expr parser a.node_id a.node_type expected))
        set i (+ i 1)
    }
    return args
}

shadow nisa_emit_call_args {
    assert true
}

fn nisa_emit_array_literal(parser: Parser, node_id: int) -> string {
    let expected: string = (nisa_expr_type parser node_id ParseNodeType.PNODE_ARRAY_LITERAL)
    if (== expected "") {
        return (nisa_fail "I require homogeneous supported array elements")
    }
    return (nisa_emit_expected_expr parser node_id ParseNodeType.PNODE_ARRAY_LITERAL expected)
}

shadow nisa_emit_array_literal {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n len3() -> int { let xs: array<int> = [1, 2, 3] return (array_length xs) } shadow len3 { assert true }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 0)
    let l: ASTLet = (parser_get_let p stmt.node_id)
    let text: string = (nisa_emit_array_literal p l.value)
    assert (str_contains text "PUSH_I64 1")
    assert (str_contains text "ARR_LITERAL 1 3")
    let src2: string = (+ "f" "n names() -> int { let xs: array<string> = [\"a\"] return (array_length xs) } shadow names { assert true }")
    let toks2: List<LexerToken> = (tokenize_string src2 "t.nano" diags)
    let p2: Parser = (parse_program toks2 (list_LexerToken_length toks2) "t.nano")
    let func2: ASTFunction = (parser_get_function p2 0)
    let block2: ASTBlock = (parser_get_block p2 func2.body)
    let stmt2: ASTStmtRef = (list_ASTStmtRef_get block2.statements 0)
    let l2: ASTLet = (parser_get_let p2 stmt2.node_id)
    let text2: string = (nisa_emit_array_literal p2 l2.value)
    assert (str_contains text2 "ARR_LITERAL 5 1")
    let _2: int = (nisa_reset)
}

fn nisa_emit_struct_literal(parser: Parser, node_id: int) -> string {
    let lit: ASTStructLiteral = (parser_get_struct_literal parser node_id)
    if (not (nisa_is_pin_record parser lit.struct_name)) {
        return (nisa_fail (+ "unsupported record " lit.struct_name))
    } else {
        let sidx: int = (nisa_struct_index parser lit.struct_name)
        let sd: ASTStruct = (parser_get_struct_def parser sidx)
        let mut out: string = ""
        let mut i: int = 0
        while (< i sd.field_count) {
            let fname: string = (at sd.field_names i)
            let mut found: bool = false
            let mut j: int = 0
            while (< j lit.field_count) {
                if (== (at lit.field_names j) fname) {
                    let vid: int = (at lit.field_value_ids j)
                    let vty: int = (at lit.field_value_types j)
                    let expected: string = (at sd.field_types i)
                    let contextual_array: bool = (and (== vty ParseNodeType.PNODE_ARRAY_LITERAL)
                        (and (str_starts_with expected "array<") (nisa_type_ok parser expected)))
                    let contextual_map: bool = (and (!= (nisa_map_value_type expected) "")
                        (nisa_is_map_constructor parser vid vty))
                    if (and (not (or contextual_array contextual_map)) (not (nisa_value_type_matches parser (nisa_expr_type parser vid vty) expected))) {
                        return (nisa_fail (+ "I require the declared type for record field " fname))
                    }
                    set out (+ out (nisa_emit_expected_expr parser vid vty expected))
                    set found true
                    set j lit.field_count
                } else {
                    set j (+ j 1)
                }
            }
            if (not found) {
                return (nisa_fail (+ "missing record field " fname))
            } else {
                set i (+ i 1)
            }
        }
        let imm: string = (+ "0 " (+ (int_to_string sidx) (+ " 0 " (int_to_string sd.field_count))))
        return (+ out (nisa_line_imm "AGG_PACK" imm))
    }
}

