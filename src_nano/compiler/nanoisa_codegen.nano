    assert (str_contains text "LOAD_LOCAL 1")
    let src2: string = (+ "f" "n greeting() -> string { return \"hi\" } shadow greeting { assert true }")
    let toks2: List<LexerToken> = (tokenize_string src2 "t.nano" diags)
    let p2: Parser = (parse_program toks2 (list_LexerToken_length toks2) "t.nano")
    let gfn: ASTFunction = (parser_get_function p2 0)
    let gtext: string = (nisa_emit_function p2 gfn)
    assert (str_contains gtext ".function greeting 0 0 0 string 1")
    assert (str_contains gtext "PUSH_STR s0")
    let src3: string = (+ "f" "n glue(a: string, b: string) -> string { return (+ a b) } shadow glue { assert true }")
    let toks3: List<LexerToken> = (tokenize_string src3 "t.nano" diags)
    let p3: Parser = (parse_program toks3 (list_LexerToken_length toks3) "t.nano")
    let glue_fn: ASTFunction = (parser_get_function p3 0)
    let glue_text: string = (nisa_emit_function p3 glue_fn)
    assert (str_contains glue_text ".function glue 2 2 0 string 1")
    assert (str_contains glue_text "STR_CONCAT")
    let src4: string = (+ "f" "n len3() -> int { let xs: array<int> = [1, 2, 3] return (array_length xs) } shadow len3 { assert true }")
    let toks4: List<LexerToken> = (tokenize_string src4 "t.nano" diags)
    let p4: Parser = (parse_program toks4 (list_LexerToken_length toks4) "t.nano")
    let len_fn: ASTFunction = (parser_get_function p4 0)
    let len_text: string = (nisa_emit_function p4 len_fn)
    assert (str_contains len_text ".function len3 0 1 0 int 1")
    assert (str_contains len_text "ARR_LITERAL 1 3")
    assert (str_contains len_text "ARR_LEN")
    let src5: string = (+ "struct Point { x: int, y: int } " (+ "f" "n getx() -> int { let p: Point = Point { x: 3, y: 4 } return p.x } shadow getx { assert true }"))
    let toks5: List<LexerToken> = (tokenize_string src5 "t.nano" diags)
    let p5: Parser = (parse_program toks5 (list_LexerToken_length toks5) "t.nano")
    let gx: ASTFunction = (parser_get_function p5 0)
    let gx_text: string = (nisa_emit_function p5 gx)
    assert (str_contains gx_text ".function getx 0 1 0 int 1")
    assert (str_contains gx_text "AGG_PACK 0 0 0 2")
    assert (str_contains gx_text "AGG_GET 0")
    let src6: string = (+ "f" "n is_pos(c: int) -> bool { return (> c 0) } shadow is_pos { assert true }")
    let toks6: List<LexerToken> = (tokenize_string src6 "t.nano" diags)
    let p6: Parser = (parse_program toks6 (list_LexerToken_length toks6) "t.nano")
    let pos_fn: ASTFunction = (parser_get_function p6 0)
    let pos_text: string = (nisa_emit_function p6 pos_fn)
    assert (str_contains pos_text ".function is_pos 1 1 0 bool 1")
    assert (str_contains pos_text "I64_GT_S")
    let src7: string = (+ "f" "n yes() -> bool { return true } shadow yes { assert true }")
    let toks7: List<LexerToken> = (tokenize_string src7 "t.nano" diags)
    let p7: Parser = (parse_program toks7 (list_LexerToken_length toks7) "t.nano")
    let yes_fn: ASTFunction = (parser_get_function p7 0)
    let yes_text: string = (nisa_emit_function p7 yes_fn)
    assert (str_contains yes_text ".function yes 0 0 0 bool 1")
    assert (str_contains yes_text "PUSH_BOOL 1")
    let src8: string = (+ "f" "n invert(b: bool) -> bool { return (not b) } shadow invert { assert true }")
    let toks8: List<LexerToken> = (tokenize_string src8 "t.nano" diags)
    let p8: Parser = (parse_program toks8 (list_LexerToken_length toks8) "t.nano")
    let inv_fn: ASTFunction = (parser_get_function p8 0)
    let inv_text: string = (nisa_emit_function p8 inv_fn)
    assert (str_contains inv_text ".function invert 1 1 0 bool 1")
    assert (str_contains inv_text "BOOL_NOT")
    let src9: string = (+ "f" "n both(a: bool, b: bool) -> bool { return (and a b) } shadow both { assert true }")
    let toks9: List<LexerToken> = (tokenize_string src9 "t.nano" diags)
    let p9: Parser = (parse_program toks9 (list_LexerToken_length toks9) "t.nano")
    let both_fn: ASTFunction = (parser_get_function p9 0)
    let both_text: string = (nisa_emit_function p9 both_fn)
    assert (str_contains both_text ".function both 2 2 0 bool 1")
    assert (str_contains both_text "BOOL_AND")
    let src10: string = (+ "f" "n pick(c: int) -> int { return (cond ((> c 0) 1) (else 0)) } shadow pick { assert true }")
    let toks10: List<LexerToken> = (tokenize_string src10 "t.nano" diags)
    let p10: Parser = (parse_program toks10 (list_LexerToken_length toks10) "t.nano")
    let pick_fn: ASTFunction = (parser_get_function p10 0)
    let pick_text: string = (nisa_emit_function p10 pick_fn)
    assert (str_contains pick_text ".function pick 1 1 0 int 1")
    assert (str_contains pick_text "JMP_FALSE")
    assert (str_contains pick_text "JMP L")
}

pub fn nanoisa_emit_nasm(source: string) -> string {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let toks: List<LexerToken> = (tokenize_string source "cut_a.nano" diags)
    let parser: Parser = (parse_program toks (list_LexerToken_length toks) "cut_a.nano")
    if (parser_has_error parser) {
        let bad: string = (nisa_fail "parse failed")
        return bad
    } else {
        let n: int = (parser_get_function_count parser)
        let mut out: string = ""
        let mut main_idx: int = (- 0 1)
        let mut emitted: int = 0
        let mut i: int = 0
        while (< i n) {
            let func: ASTFunction = (parser_get_function parser i)
            if (< func.body 0) {
                (print "")
            } else {
                if (== func.name "main") {
                    set main_idx emitted
                } else {
                    (print "")
                }
                set out (+ out (nisa_emit_function parser func))
                set out (+ out "\n")
                set emitted (+ emitted 1)
            }
            set i (+ i 1)
        }
        if (< main_idx 0) {
            let missing: string = (nisa_fail "no main")
            return missing
        } else {
            if (not nisa_ok) {
                return ""
            } else {
                let mut prelude: string = ".entry "
                set prelude (+ prelude (int_to_string main_idx))
                set prelude (+ prelude "\n\n")
                set prelude (+ prelude (nisa_str_prelude))
                if (> (array_length nisa_str_names) 0) {
                    set prelude (+ prelude "\n")
                } else {
                    (print "")
                }
                return (+ prelude out)
            }
        }
    }
}

shadow nanoisa_emit_nasm {
    let src: string = (+ (+ "f" "n add(a: int, b: int) -> int { return (+ a b) }\n") (+ "f" "n main() -> int { return (add 40 2) }\nshadow add { assert (== (add 2 3) 5) }\nshadow main { assert (== (main) 42) }\n"))
    let text: string = (nanoisa_emit_nasm src)
    assert (str_contains text ".function add")
    assert (str_contains text ".function main")
    assert (str_contains text "TAIL_CALL add")
    assert (str_contains text ".entry")
}
