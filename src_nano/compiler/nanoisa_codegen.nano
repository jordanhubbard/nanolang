fn nisa_expr_is_float(parser: Parser, node_id: int, node_type: int) -> bool {
    if (== node_type ParseNodeType.PNODE_FLOAT) {
        return true
    } else {
        if (== node_type ParseNodeType.PNODE_IDENTIFIER) {
            let id: ASTIdentifier = (parser_get_identifier parser node_id)
            return (== (nisa_name_type id.name) "float")
        } else {
            if (== node_type ParseNodeType.PNODE_FIELD_ACCESS) {
                let fa: ASTFieldAccess = (parser_get_field_access parser node_id)
                let ty: string = (nisa_expr_struct_type parser fa.object fa.object_type)
                let fi: int = (nisa_struct_field_index parser ty fa.field_name)
                if (< fi 0) {
                    return false
                } else {
                    let sidx: int = (nisa_struct_index parser ty)
                    let sd: ASTStruct = (parser_get_struct_def parser sidx)
                    return (== (at sd.field_types fi) "float")
                }
            } else {
                if (== node_type ParseNodeType.PNODE_CALL) {
                    let call: ASTCall = (parser_get_call parser node_id)
                    let func_id: ASTIdentifier = (parser_get_identifier parser call.function)
                    if (!= (nisa_math_arity func_id.name) 0) {
                        return true
                    } else {
                    let fidx: int = (nisa_fn_index parser func_id.name)
                    if (< fidx 0) {
                        return false
                    } else {
                        let f: ASTFunction = (parser_get_function parser fidx)
                        return (== f.return_type "float")
                    }
                    }
                } else {
                    if (== node_type ParseNodeType.PNODE_BINARY_OP) {
                        let binop: ASTBinaryOp = (parser_get_binary_op parser node_id)
                        if (or (== binop.op LexerTokenType.TOKEN_PLUS)
                               (or (== binop.op LexerTokenType.TOKEN_MINUS)
                                   (or (== binop.op LexerTokenType.TOKEN_STAR)
                                       (== binop.op LexerTokenType.TOKEN_SLASH)))) {
                            return (or (nisa_expr_is_float parser binop.left binop.left_type)
                                       (nisa_expr_is_float parser binop.right binop.right_type))
                        } else {
                            return false
                        }
                    } else {
                        return false
                    }
                }
            }
        }
    }
}

shadow nisa_expr_is_float {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "f" "n fone() -> float { return 1.0 } shadow fone { assert true }")
    let toks: List<LexerToken> = (tokenize_string src "t.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "t.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 0)
    let r: ASTReturn = (parser_get_return p stmt.node_id)
    assert (nisa_expr_is_float p r.value r.value_type)
    let _2: int = (nisa_reset)
}

fn nisa_emit_call_args(parser: Parser, call: ASTCall) -> string {
    let mut args: string = ""
    let mut i: int = 0
    while (< i call.arg_count) {
        let a: ASTStmtRef = (parser_get_call_arg parser (+ call.arg_start i))
        set args (+ args (nisa_emit_expr parser a.node_id a.node_type))
        set i (+ i 1)
    }
    return args
}

shadow nisa_emit_call_args {
    assert true
}

fn nisa_last_dot(name: string) -> int {
    let mut i: int = (- (str_length name) 1)
    while (>= i 0) {
        if (== (char_at name i) 46) {
            return i
        } else {
            set i (- i 1)
        }
    }
    return (- 0 1)
}

shadow nisa_last_dot {
    assert (== (nisa_last_dot "ImpMod.imp_add") 6)
    assert (< (nisa_last_dot "imp_add") 0)
}

fn nisa_dot_suffix(name: string) -> string {
    let idx: int = (nisa_last_dot name)
    if (< idx 0) {
        return name
    } else {
        let start: int = (+ idx 1)
        let n: int = (str_length name)
        let len: int = (- n start)
        if (<= len 0) {
            return name
        } else {
            return (str_substring name start len)
        }
    }
}

shadow nisa_dot_suffix {
    assert (== (nisa_dot_suffix "imp_add") "imp_add")
    assert (== (nisa_dot_suffix "ImpMod.imp_add") "imp_add")
    assert (== (nisa_dot_suffix "Diagnostics.diag_location") "diag_location")
}

fn nisa_mqc_qualified(mqc: ASTModuleQualifiedCall) -> string {
    if (!= mqc.module_name "") {
        return (+ mqc.module_name (+ "." mqc.function_name))
    } else {
        return mqc.function_name
    }
}

shadow nisa_mqc_qualified {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
    let src: string = (+ "import \"cut_a_fn_imp.nano\" as ImpMod " (+ "f" "n via_q_add() -> int { return (ImpMod.imp_add 40 2) } shadow via_q_add { assert true }"))
    let toks: List<LexerToken> = (tokenize_string src "tests/nanoisa/fixtures/cut_a_add.nano" diags)
    let p: Parser = (parse_program toks (list_LexerToken_length toks) "tests/nanoisa/fixtures/cut_a_add.nano")
    let func: ASTFunction = (parser_get_function p 0)
    let block: ASTBlock = (parser_get_block p func.body)
    let stmt: ASTStmtRef = (list_ASTStmtRef_get block.statements 0)
    let r: ASTReturn = (parser_get_return p stmt.node_id)
    let mqc: ASTModuleQualifiedCall = (parser_get_module_qualified_call p r.value)
    assert (== (nisa_mqc_qualified mqc) "ImpMod.imp_add")
    let _2: int = (nisa_reset)
}

fn nisa_mqc_unqualified(mqc: ASTModuleQualifiedCall) -> string {
    if (!= mqc.module_name "") {
        return mqc.function_name
    } else {
        return (nisa_dot_suffix mqc.function_name)
    }
}

shadow nisa_mqc_unqualified {
    let _: int = (nisa_reset)
    let diags: List<CompilerDiagnostic> = (diag_list_new)
