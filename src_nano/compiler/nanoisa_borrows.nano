fn nb_local(name: string) -> int {
    let mut i: int = (array_length nb_names)
    while (> i 0) { set i (- i 1) if (== (at nb_names i) name) { return i } }
    return -1
}
shadow nb_local { set nb_names ["outer", "inner", "outer"] assert (== (nb_local "outer") 2) assert (== (nb_local "missing") -1) set nb_names [] }
fn nb_slot(name: string, tag: int, layout: int, mode: int, mutable: bool) -> int {
    let index: int = (array_length nb_names)
    if (>= index 256) { return (nb_fail "at most 256 local slots") }
    set nb_names (array_push nb_names name)
    set nb_named (array_push nb_named false)
    set nb_projection_parents (array_push nb_projection_parents -1)
    set nb_projection_fields (array_push nb_projection_fields -1)
    set nb_tags (array_push nb_tags tag)
    set nb_layouts (array_push nb_layouts layout)
    set nb_identities (array_push nb_identities "")
    set nb_variants (array_push nb_variants -1)
    set nb_modes (array_push nb_modes mode)
    set nb_live (array_push nb_live true)
    set nb_disposal_pending (array_push nb_disposal_pending false)
    set nb_mutable (array_push nb_mutable mutable)
    return index
}
fn nb_reset_locals() -> int {
    set nb_control_depth 0
    set nb_transferred false set nb_loop_first -1 set nb_loop_index -1 set nb_loop_top "" set nb_loop_done ""
    set nb_loop_live [] set nb_loop_pending [] set nb_loop_breaks 0
    set nb_names [] set nb_named [] set nb_tags [] set nb_identities [] set nb_variants []
    set nb_projection_parents [] set nb_projection_fields [] set nb_layouts [] set nb_modes []
    set nb_live [] set nb_disposal_pending [] set nb_mutable [] set nb_code "" set nb_returned false set nb_transfers_owner false
    return 0
}
