# I inspect mutation lowering without executing a pending source module.
fn nb_owner_array_mutation_fixture(body: string) -> Parser {
    let prefix: string = (+ "resource struct Handle { fd: int } struct Bundle { file: Handle, values: array<float> } f" (+ "n close(owner: Handle) -> int { let Handle { fd } = owner return fd } shadow close { assert (== (close Handle { fd: 7 }) 7) } f" "n main() -> int { let owned: Bundle = Bundle { values: [1.5], file: Handle { fd: 7 } } let values = owned.values "))
    let suffix: string = " let Bundle { values, file } = owned assert (== (close file) 7) return 0 } shadow main { assert (== (main) 0) }"
    let tokens: List<LexerToken> = (tokenize_string (+ prefix (+ body suffix)) "owner-array-mutation.nano" (list_CompilerDiagnostic_new))
    return (parse_program tokens (list_LexerToken_length tokens) "owner-array-mutation.nano")
}
