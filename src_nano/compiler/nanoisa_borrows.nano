# I exercise selected ownership in source shadows as well as raw bytecode tests.
fn nb_owned_union_fixture() -> Parser {
    let source: string = "resource struct Handle { fd: int } union Choice<T,U> { Some { value: T }, None { error: U } } fn main(value: Choice<Handle,string>) -> int { match value { Some(payload) => { let Choice.Some { value } = payload let Handle { fd } = value return fd } None(payload) => { return 0 } } }"
    let tokens: List<LexerToken> = (tokenize_string source "owned-selected.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "owned-selected.nano")
    (mb_reset []) let _: int = (nb_reset_locals) set nb_error ""
    set nb_union_identities [] set nb_union_spellings [] set nb_union_sources [] set nb_union_resources [] set nb_union_graph false
    set nb_ordinary_layouts [false] set nb_union_layout_base 1
    set nb_value_graph true set nb_mixed false set nb_owner_arrays false set nb_in_helper false set nb_result 1
    let registered: bool = (nb_register_union parser "Choice<Handle,string>")
    if (not registered) { let _: int = (nb_fail "the owned union shadow fixture") }
    let local: int = (nb_slot "value" 10 0 0 false)
    (array_set nb_identities local (at nb_union_identities 0))
    return parser
}
