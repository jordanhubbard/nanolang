# I split only complete generic spellings; uncertainty routes to the checked owner profile.
fn nb_route_parts(spelling: string) -> array<string> {
    let length: int = (str_length spelling)
    let mut opening: int = -1
    let mut i: int = 0
    while (< i length) { if (== (char_at spelling i) 60) { set opening i break } set i (+ i 1) }
    if (< opening 0) { return [spelling] }
    if (or (== opening 0) (!= (char_at spelling (- length 1)) 62)) { return [] }
    let mut parts: array<string> = [(str_trim (str_substring spelling 0 opening))]
    let mut depth: int = 0
    let mut start: int = (+ opening 1)
    set i start
    while (< i length) {
        let octet: int = (char_at spelling i)
        if (== octet 60) { set depth (+ depth 1) }
        if (== octet 62) {
            if (== depth 0) {
                if (!= i (- length 1)) { return [] }
                let argument: string = (str_trim (str_substring spelling start (- i start)))
                if (== argument "") { return [] }
                return (array_push parts argument)
            }
            set depth (- depth 1)
        }
        if (and (== octet 44) (== depth 0)) {
            let argument: string = (str_trim (str_substring spelling start (- i start)))
            if (== argument "") { return [] }
            set parts (array_push parts argument)
            set start (+ i 1)
        }
        set i (+ i 1)
    }
    return []
}
