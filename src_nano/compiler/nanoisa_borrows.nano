pub fn nanoisa_has_borrows(parser: Parser) -> bool {
    let mut i: int = 0
    while (< i (parser_get_function_count parser)) {
        let function: ASTFunction = (parser_get_function parser i)
        let returned: int = (nb_record parser function.return_type)
        if (nb_record_has_owner parser returned) { return true }
        let mut j: int = 0
        while (< j function.param_count) {
            let spelling: string = (parser_get_let parser (+ function.param_start j)).var_type
            if (str_starts_with spelling "&") { return true }
            let record: int = (nb_record parser spelling)
            if (nb_record_has_owner parser record) { return true }
            set j (+ j 1)
        }
        set i (+ i 1)
    }
    let local_flags: array<bool> = (declaration_local_lets parser)
    set i 0
    while (< i (array_length local_flags)) {
        let record: int = (nb_record parser (parser_get_let parser i).var_type)
        if (nb_record_has_owner parser record) { return true }
        set i (+ i 1)
    }
    set i 0
    while (< i (parser_get_struct_literal_count parser)) {
        let record: int = (nb_record parser (parser_get_struct_literal parser i).struct_name)
        if (nb_record_has_owner parser record) { return true }
        set i (+ i 1)
    }
    return false
}
