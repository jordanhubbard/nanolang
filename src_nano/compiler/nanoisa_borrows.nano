fn nb_place(parser: Parser, id: int, kind: int) -> NBPlace {
    if (== kind ParseNodeType.PNODE_IDENTIFIER) {
        let local: int = (nb_local (parser_get_identifier parser id).name)
        if (< local 0) { return (nb_invalid_place "a live resource place") }
        if (nb_ordinary_local local) { return (nb_invalid_place "an owner resource place") }
        if (or (not (at nb_live local)) (!= (at nb_tags local) 8)) { return (nb_invalid_place "a live resource place") }
        return NBPlace { root: local, layout: (at nb_layouts local), path: "" }
    }
    if (== kind ParseNodeType.PNODE_FIELD_ACCESS) {
        let field: ASTFieldAccess = (parser_get_field_access parser id)
        let parent: NBPlace = (nb_place parser field.object field.object_type)
        if (< parent.root 0) { return parent }
        let index: int = (nb_layout_field parser parent.layout field.field_name)
        if (< index 0) { return (nb_invalid_place "a declared resource path") }
        let record: ASTStruct = (parser_get_struct_def parser parent.layout)
        let child: int = (nb_record parser (at record.field_types index))
        if (or (< child 0) (>= (str_length parent.path) 128)) { return (nb_invalid_place "a resource path of at most 32 fields") }
        return NBPlace { root: parent.root, layout: child, path: (+ parent.path (nb_hex index 2)) }
    }
    return (nb_invalid_place "a root-local resource field chain")
}
shadow nb_place { set nb_error "" assert (== (nb_place (nb_fixture) 0 ParseNodeType.PNODE_NUMBER).root -1) set nb_error "" }
fn nb_observe_owner_path(parser: Parser, id: int, kind: int) -> int {
    if (or (not nb_owner_arrays) (not nb_value_graph)) { return (nb_fail "a mode-zero owner ARRAY observation") }
    let place: NBPlace = (nb_place parser id kind)
    if (< place.root 0) { return 0 }
    if (or (!= (at nb_modes place.root) 0) (at nb_disposal_pending place.root)) { return (nb_fail "an intact mode-zero owner leaf observation") }
    if (== kind ParseNodeType.PNODE_IDENTIFIER) { return (nb_op1 "LOAD_LOCAL" place.root) }
    let field: ASTFieldAccess = (parser_get_field_access parser id)
    let parent: NBPlace = (nb_place parser field.object field.object_type)
    if (< parent.root 0) { return 0 }
    let index: int = (nb_layout_field parser parent.layout field.field_name)
    if (< index 0) { return 0 }
    let _: int = (nb_observe_owner_path parser field.object field.object_type)
    if (!= nb_error "") { return 0 }
    return (nb_op1 "AGG_GET" index)
}
shadow nb_observe_owner_path {
    let owned: bool = nb_owner_arrays let graph: bool = nb_value_graph
