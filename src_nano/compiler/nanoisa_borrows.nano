    let tokens: List<LexerToken> = (tokenize_string source "observation.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "observation.nano")
    assert (not (parser_has_error parser))
    let body: ASTBlock = (parser_get_block parser (parser_get_function parser 0).body)
    let returned: ASTReturn = (parser_get_return parser (list_ASTStmtRef_get body.statements 0).node_id)
    let field: ASTFieldAccess = (parser_get_field_access parser returned.value)
    let _: int = (nb_slot "owned" 8 1 0 false)
    set nb_owner_arrays true set nb_value_graph true
    let _: int = (nb_observe_owner_path parser field.object field.object_type)
    assert (== nb_error "") assert (== nb_code "  LOAD_LOCAL 0\n  AGG_GET 0\n")
    assert (at nb_live 0)
    (array_set nb_disposal_pending 0 true)
    let _: int = (nb_observe_owner_path parser field.object field.object_type)
    assert (!= nb_error "")
    set nb_error "" let _: int = (nb_reset_locals)
    set nb_owner_arrays owned set nb_value_graph graph set nb_ordinary_layouts ordinary
}
fn nb_overlap(left: NBPlace, right: NBPlace) -> bool {
    return (and (== left.root right.root) (or (str_starts_with left.path right.path) (str_starts_with right.path left.path)))
}
shadow nb_overlap {
    let root: NBPlace = NBPlace { root: 0, layout: 0, path: "" }
