pub fn nanoisa_borrow_error() -> string { return nb_error }
shadow nanoisa_borrow_error { set nb_error "checked boundary" assert (== (nanoisa_borrow_error) "checked boundary") set nb_error "" }
fn nb_fail(message: string) -> int {
    if (== nb_error "") { set nb_error (+ "I require " (+ message " in my source borrow profile")) }
    return 0
}
shadow nb_fail { set nb_error "" let _: int = (nb_fail "one helper") assert (str_contains nb_error "one helper") let _: int = (nb_fail "later") assert (not (str_contains nb_error "later")) set nb_error "" }
fn nb_tag(name: string) -> int {
    if (== name "int") { return 1 }
    if (== name "bool") { return 4 }
    return 0
}
shadow nb_tag { assert (== (nb_tag "int") 1) assert (== (nb_tag "bool") 4) assert (== (nb_tag "string") 0) }
# I keep retained fields separate from numeric and reference scalar tags.
fn nb_field_tag(name: string) -> int {
    if (== name "string") { return 5 }
    return (nb_tag name)
}
shadow nb_field_tag {
    assert (== (nb_field_tag "string") 5)
    assert (== (nb_field_tag "int") 1)
    assert (== (nb_field_tag "bool") 4)
    assert (== (nb_field_tag "float") 0)
    assert (== (nb_field_tag "array<string>") 0)
    assert (== (nb_tag "string") 0)
}
# I admit FLOAT locals without admitting FLOAT fields or signatures.
fn nb_local_tag(name: string) -> int {
    if (== name "float") { return 3 }
    return (nb_field_tag name)
}
shadow nb_local_tag {
    assert (== (nb_local_tag "float") 3)
    assert (== (nb_descriptor (nb_local_tag "float") 0 4294967295) "03000000ffffffff")
    assert (== (nb_local_tag "bool") 4)
    assert (== (nb_local_tag "string") 5)
    assert (== (nb_tag "float") 0)
    assert (== (nb_local_tag "array<float>") 0)
}
# I keep string parameters separate from scalar resource leaves and results.
fn nb_parameter_tag(name: string) -> int {
    if (== name "string") { return 5 }
    return (nb_tag name)
}
shadow nb_parameter_tag {
    assert (== (nb_parameter_tag "string") 5)
    assert (== (nb_parameter_tag "int") 1)
    assert (== (nb_tag "string") 0)
    assert (== (nb_parameter_tag "array<string>") 0)
}
fn nb_decode_string(raw: string) -> string {
    let mut output: string = ""
    let mut i: int = 0
    while (< i (str_length raw)) {
        let mut part: string = (str_substring raw i 1)
        if (and (== (char_at raw i) 92) (< (+ i 1) (str_length raw))) {
            set i (+ i 1)
            let code: int = (char_at raw i)
            set part (str_substring raw i 1)
            # I refuse NUL before my C-string ABI could truncate it.
            if (== code 48) { let _: int = (nb_fail "string literals without embedded NUL") return "" }
            if (== code 110) { set part "\n" }
            if (== code 116) { set part "\t" }
            if (== code 114) { set part "\r" }
            if (not (or (== code 110) (or (== code 116) (or (== code 114)
                    (or (== code 92) (or (== code 34) (== code 39))))))) {
                set part (+ "\\" part)
            }
        }
        set output (+ output part)
        set i (+ i 1)
    }
    return output
}
shadow nb_decode_string {
    assert (== (nb_decode_string "\\n\\r\\t") "\n\r\t")
    assert (== (nb_decode_string "\\\"\\\\\\'") "\"\\'")
    assert (== (nb_decode_string "a\\qb") "a\\qb")
    set nb_error ""
    assert (== (nb_decode_string "a\\0b") "")
    assert (!= nb_error "")
    set nb_error ""
}

# I escape bytes using the assembler quoted-string grammar.
fn nb_escape_string(value: string) -> string {
    let digits: string = "0123456789abcdef"
    let mut output: string = ""
    let mut i: int = 0
    while (< i (str_length value)) {
        let octet: int = (char_at value i)
        let mut escaped: string = (str_substring value i 1)
        if (== octet 34) { set escaped "\\\"" }
        if (== octet 92) { set escaped "\\\\" }
        if (== octet 10) { set escaped "\\n" }
        if (== octet 13) { set escaped "\\r" }
        if (== octet 9) { set escaped "\\t" }
        if (and (or (< octet 32) (== octet 127))
                (and (!= octet 10) (and (!= octet 13) (!= octet 9)))) {
            set escaped (+ "\\x" (+ (str_substring digits (/ octet 16) 1)
                                      (str_substring digits (% octet 16) 1)))
        }
        set output (+ output escaped)
        set i (+ i 1)
    }
    return output
}
shadow nb_escape_string {
    assert (== (nb_escape_string "plain") "plain")
    assert (== (nb_escape_string "\n\r\t") "\\n\\r\\t")
    assert (== (nb_escape_string "\"\\") "\\\"\\\\")
    assert (== (nb_escape_string "café") "café")
    assert (== (nb_escape_string (string_from_char 1)) "\\x01")
    assert (== (nb_escape_string (string_from_char 127)) "\\x7f")
}

fn nb_hex(value: int, width: int) -> string {
    let digits: string = "0123456789abcdef"
    let mut out: string = ""
    let mut remaining: int = value
    let mut i: int = 0
    while (< i width) {
        let octet: int = (% remaining 256)
        set out (+ out (str_substring digits (/ octet 16) 1))
        set out (+ out (str_substring digits (% octet 16) 1))
        set remaining (/ remaining 256)
        set i (+ i 1)
    }
    return out
}
shadow nb_hex { assert (== (nb_hex 258 2) "0201") assert (== (nb_hex 4294967295 4) "ffffffff") }
fn nb_descriptor(tag: int, mode: int, layout: int) -> string {
    return (+ (nb_hex tag 1) (+ (nb_hex mode 1) (+ "0000" (nb_hex layout 4))))
}
shadow nb_descriptor { assert (== (nb_descriptor 8 1 2) "0801000002000000") }
fn nb_emit(op: string) -> int {
    if (== nb_error "") { set nb_code (+ nb_code (+ "  " (+ op "\n"))) }
    return 0
}
shadow nb_emit { set nb_code "" set nb_error "" let _: int = (nb_emit "RET") assert (== nb_code "  RET\n") }
fn nb_op1(op: string, a: int) -> int { return (nb_emit (+ op (+ " " (int_to_string a)))) }
shadow nb_op1 { set nb_code "" set nb_error "" let _: int = (nb_op1 "LOAD_LOCAL" 2) assert (== nb_code "  LOAD_LOCAL 2\n") }
fn nb_op2(op: string, a: int, b: int) -> int { return (nb_emit (+ op (+ " " (+ (int_to_string a) (+ " " (int_to_string b)))))) }
shadow nb_op2 { set nb_code "" set nb_error "" let _: int = (nb_op2 "REF_GET" 0 1) assert (== nb_code "  REF_GET 0 1\n") }
fn nb_label() -> string {
    let name: string = (+ "nb_control_" (int_to_string nb_next_label))
    set nb_next_label (+ nb_next_label 1)
    return name
}
shadow nb_label {
    set nb_next_label 0
    assert (== (nb_label) "nb_control_0")
    assert (== (nb_label) "nb_control_1")
    set nb_next_label 0
}
fn nb_record(parser: Parser, name: string) -> int {
    let mut i: int = 0
    while (< i (parser_get_struct_def_count parser)) {
        if (== (parser_get_struct_def parser i).name name) { return i }
        set i (+ i 1)
    }
    return -1
}
fn nb_ordinary_layout(layout: int) -> bool {
    if (or (< layout 0) (>= layout (array_length nb_ordinary_layouts))) { return false }
    return (at nb_ordinary_layouts layout)
}
shadow nb_ordinary_layout {
    set nb_ordinary_layouts [false, true]
    assert (not (nb_ordinary_layout 0)) assert (nb_ordinary_layout 1)
    assert (not (nb_ordinary_layout 4294967295)) set nb_ordinary_layouts []
}
fn nb_ordinary_local(local: int) -> bool {
    if (or (< local 0) (>= local (array_length nb_tags))) { return false }
    return (and (== (at nb_tags local) 8) (nb_ordinary_layout (at nb_layouts local)))
}
shadow nb_ordinary_local {
    let _: int = (nb_reset_locals) set nb_ordinary_layouts [false, true]
    let _: int = (nb_slot "owner" 8 0 0 false)
    let _: int = (nb_slot "ordinary" 8 1 0 false)
    assert (not (nb_ordinary_local 0)) assert (nb_ordinary_local 1)
    set nb_ordinary_layouts [] let _: int = (nb_reset_locals)
}
# I share exact ARRAY expression support without ordinary record authority.
fn nb_arrays() -> bool { return (or nb_mixed nb_owner_arrays) }
shadow nb_arrays {
    let mixed: bool = nb_mixed let owned: bool = nb_owner_arrays
    set nb_mixed false set nb_owner_arrays false assert (not (nb_arrays))
    set nb_owner_arrays true assert (nb_arrays)
    set nb_owner_arrays false set nb_mixed true assert (nb_arrays)
    set nb_mixed mixed set nb_owner_arrays owned
}
fn nb_owner_field_tag(parser: Parser, layout: int, field: int) -> int {
    let spelling: string = (at (parser_get_struct_def parser layout).field_types field)
    if (and nb_owner_arrays (and (not (nb_ordinary_layout layout)) (== spelling "array<float>"))) { return 7 }
    return (nb_field_tag spelling)
}
shadow nb_owner_field_tag {
    let mixed: bool = nb_mixed let owned: bool = nb_owner_arrays
    let ordinary: array<bool> = nb_ordinary_layouts
    set nb_ordinary_layouts [false, false]
    let parser: Parser = (nb_owner_array_fixture)
    set nb_owner_arrays false assert (== (nb_owner_field_tag parser 1 1) 0)
    set nb_owner_arrays true assert (== (nb_owner_field_tag parser 1 1) 7)
    assert (== (nb_field_tag "array<float>") 0)
    assert (== (nb_owner_field_tag parser 0 0) 1)
