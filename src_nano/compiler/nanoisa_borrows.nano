fn nb_decode_string(raw: string) -> string {
    let mut output: string = ""
    let mut i: int = 0
    while (< i (str_length raw)) {
        let mut part: string = (str_substring raw i 1)
        if (and (== (char_at raw i) 92) (< (+ i 1) (str_length raw))) {
            set i (+ i 1)
            let code: int = (char_at raw i)
            set part (str_substring raw i 1)
            # I refuse NUL before my C-string ABI could truncate it.
            if (== code 48) { let _: int = (nb_fail "string literals without embedded NUL") return "" }
            if (== code 110) { set part "\n" }
            if (== code 116) { set part "\t" }
            if (== code 114) { set part "\r" }
            if (not (or (== code 110) (or (== code 116) (or (== code 114)
                    (or (== code 92) (or (== code 34) (== code 39))))))) {
                set part (+ "\\" part)
            }
        }
        set output (+ output part)
        set i (+ i 1)
    }
    return output
}
shadow nb_decode_string {
    assert (== (nb_decode_string "\\n\\r\\t") "\n\r\t")
    assert (== (nb_decode_string "\\\"\\\\\\'") "\"\\'")
    assert (== (nb_decode_string "a\\qb") "a\\qb")
    set nb_error ""
    assert (== (nb_decode_string "a\\0b") "")
    assert (!= nb_error "")
    set nb_error ""
}

# I escape bytes using the assembler quoted-string grammar.
fn nb_escape_string(value: string) -> string {
    let digits: string = "0123456789abcdef"
    let mut output: string = ""
    let mut i: int = 0
    while (< i (str_length value)) {
        let octet: int = (char_at value i)
        let mut escaped: string = (str_substring value i 1)
        if (== octet 34) { set escaped "\\\"" }
        if (== octet 92) { set escaped "\\\\" }
        if (== octet 10) { set escaped "\\n" }
        if (== octet 13) { set escaped "\\r" }
        if (== octet 9) { set escaped "\\t" }
        if (and (or (< octet 32) (== octet 127))
                (and (!= octet 10) (and (!= octet 13) (!= octet 9)))) {
            set escaped (+ "\\x" (+ (str_substring digits (/ octet 16) 1)
                                      (str_substring digits (% octet 16) 1)))
        }
        set output (+ output escaped)
        set i (+ i 1)
    }
    return output
}
shadow nb_escape_string {
    assert (== (nb_escape_string "plain") "plain")
    assert (== (nb_escape_string "\n\r\t") "\\n\\r\\t")
    assert (== (nb_escape_string "\"\\") "\\\"\\\\")
    assert (== (nb_escape_string "café") "café")
    assert (== (nb_escape_string (string_from_char 1)) "\\x01")
    assert (== (nb_escape_string (string_from_char 127)) "\\x7f")
}

fn nb_hex(value: int, width: int) -> string {
    let digits: string = "0123456789abcdef"
    let mut out: string = ""
    let mut remaining: int = value
    let mut i: int = 0
    while (< i width) {
        let octet: int = (% remaining 256)
        set out (+ out (str_substring digits (/ octet 16) 1))
        set out (+ out (str_substring digits (% octet 16) 1))
        set remaining (/ remaining 256)
        set i (+ i 1)
    }
    return out
}
shadow nb_hex { assert (== (nb_hex 258 2) "0201") assert (== (nb_hex 4294967295 4) "ffffffff") }
fn nb_descriptor(tag: int, mode: int, layout: int) -> string {
    let mut retained: int = layout
    if (== tag 10) {
        if (!= layout 4294967295) { set retained (+ nb_union_layout_base layout) }
    } else { if (!= tag 8) { set retained 4294967295 } }
    return (+ (nb_hex tag 1) (+ (nb_hex mode 1) (+ "0000" (nb_hex retained 4))))
}
shadow nb_descriptor {
    assert (== (nb_descriptor 8 1 2) "0801000002000000")
    set nb_union_layout_base 3
    assert (== (nb_descriptor 10 0 2) "0a00000005000000")
    assert (== (nb_descriptor 1 0 2) "01000000ffffffff")
    set nb_union_layout_base 0
}
