shadow nb_slot { let _: int = (nb_reset_locals) assert (== (nb_slot "answer" 1 4294967295 0 true) 0) assert (at nb_mutable 0) assert (not (at nb_disposal_pending 0)) assert (== (at nb_tags 0) 1) let _: int = (nb_reset_locals) }
# I emit zero-width name markers; names remain advisory lexical facts.
fn nb_name_begin(slot: int, name: string) -> int {
    if (and (== nb_error "") (!= name "")) {
        let _: int = (nb_emit (+ ".local_begin " (+ (int_to_string slot) (+ " \"" (+ name "\"")))))
        (array_set nb_named slot true)
    }
    return 0
}
