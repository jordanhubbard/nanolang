        else { if (str_starts_with parameter.var_type "&") { set nominal (str_substring parameter.var_type 1 (- (str_length parameter.var_type) 1)) } }
        if (< (nb_record parser nominal) 0) { let _: int = (nb_fail "an exact borrowed record parameter") return "" }
        let mut prior: int = 0
