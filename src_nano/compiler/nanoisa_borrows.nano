        if nb_union_graph { set version 4 }
        set ownership (+ (nb_hex version 4) (str_substring ownership 8 (- (str_length ownership) 8)))
        let paths: string = (nb_path_suffix)
        let facts: string = (nb_union_fact_bytes parser)
        set ownership (+ ownership (+ (nb_hex (/ (str_length paths) 2) 4) paths))
        set ownership (+ ownership "01000000")
        # UNION_VARIANTS kind 1, revision 1, followed by its bounded payload.
        set ownership (+ ownership (+ "01000100" (nb_hex (/ (str_length facts) 2) 4)))
        set ownership (+ ownership facts)
        while (!= (% (str_length ownership) 8) 0) { set ownership (+ ownership "00") }
    } else { if (> (array_length nb_paths) 0) {
        set ownership (+ "02000000" (str_substring ownership 8 (- (str_length ownership) 8)))
        set ownership (+ ownership (nb_path_suffix))
    } }
    let mut prelude: string = (+ ".types " (+ (int_to_string records) (+ " 0 " (+ (int_to_string (array_length nb_union_identities)) "\n.entry 0\n"))))
    set i 0
    while (< i (array_length nb_strings)) {
        set prelude (+ prelude (+ ".string \"" (+ (nb_escape_string (at nb_strings i)) "\"\n")))
        set i (+ i 1)
    }
    set prelude (+ prelude (+ ".layouts \"" (+ layouts "\"\n")))
    set prelude (+ prelude (+ ".ownership \"" (+ ownership "\"\n")))
    return (+ prelude (+ functions parameters))
}
