pub fn nanoisa_borrow_error() -> string { return nb_error }
shadow nanoisa_borrow_error { set nb_error "checked boundary" assert (== (nanoisa_borrow_error) "checked boundary") set nb_error "" }
fn nb_fail(message: string) -> int {
    if (== nb_error "") { set nb_error (+ "I require " (+ message " in my source borrow profile")) }
    return 0
}
shadow nb_fail { set nb_error "" let _: int = (nb_fail "one helper") assert (str_contains nb_error "one helper") let _: int = (nb_fail "later") assert (not (str_contains nb_error "later")) set nb_error "" }
fn nb_tag(name: string) -> int {
    if (== name "int") { return 1 }
    if (== name "bool") { return 4 }
    return 0
}
shadow nb_tag { assert (== (nb_tag "int") 1) assert (== (nb_tag "bool") 4) assert (== (nb_tag "string") 0) }
# I keep retained fields separate from numeric and reference scalar tags.
fn nb_field_tag(name: string) -> int {
    if (== name "string") { return 5 }
    return (nb_tag name)
}
shadow nb_field_tag {
    assert (== (nb_field_tag "string") 5)
    assert (== (nb_field_tag "int") 1)
    assert (== (nb_field_tag "bool") 4)
    assert (== (nb_field_tag "float") 0)
    assert (== (nb_field_tag "array<string>") 0)
    assert (== (nb_tag "string") 0)
}
# I admit FLOAT locals without admitting FLOAT fields or signatures.
fn nb_local_tag(name: string) -> int {
    if (== name "float") { return 3 }
    return (nb_field_tag name)
}
shadow nb_local_tag {
    assert (== (nb_local_tag "float") 3)
