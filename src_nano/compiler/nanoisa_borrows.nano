    let _: int = (nb_reset_locals) set nb_union_resources [false, true]
    let _: int = (nb_slot "plain" 10 0 0 false)
    let _: int = (nb_slot "owned" 10 1 0 false)
    assert (not (nb_owned_local 0)) assert (nb_owned_local 1)
    set nb_union_resources [] let _: int = (nb_reset_locals)
}
fn nb_ordinary_local(local: int) -> bool {
    if (or (< local 0) (>= local (array_length nb_tags))) { return false }
