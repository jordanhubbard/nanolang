fn nb_field(parser: Parser, local: int, name: string) -> int {
    if (< local 0) { let _: int = (nb_fail "a live exact resource place") return -1 }
    if (or (not (at nb_live local)) (!= (at nb_tags local) 8)) { let _: int = (nb_fail "a live exact resource place") return -1 }
    let record: ASTStruct = (parser_get_struct_def parser (at nb_layouts local))
    let mut i: int = 0
    while (< i record.field_count) { if (== (at record.field_names i) name) { return i } set i (+ i 1) }
    let _: int = (nb_fail "a declared resource field") return -1
}
struct NBPlace { root: int, layout: int, path: string }
fn nb_invalid_place(message: string) -> NBPlace {
    let _: int = (nb_fail message)
    return NBPlace { root: -1, layout: -1, path: "" }
}
shadow nb_invalid_place { set nb_error "" assert (== (nb_invalid_place "a live place").root -1) assert (!= nb_error "") set nb_error "" }
fn nb_leaf(parser: Parser, layout: int) -> bool {
    let record: ASTStruct = (parser_get_struct_def parser layout)
    let mut i: int = 0
    while (< i record.field_count) {
        if (== (nb_tag (at record.field_types i)) 0) { return false }
        set i (+ i 1)
    }
    return true
}
shadow nb_leaf { assert (nb_leaf (nb_fixture) 0) }
fn nb_layout_field(parser: Parser, layout: int, name: string) -> int {
    let record: ASTStruct = (parser_get_struct_def parser layout)
    let mut i: int = 0
    while (< i record.field_count) { if (== (at record.field_names i) name) { return i } set i (+ i 1) }
    let _: int = (nb_fail "a declared resource field") return -1
}
shadow nb_layout_field { set nb_error "" assert (== (nb_layout_field (nb_fixture) 0 "value") 0) }
fn nb_place(parser: Parser, id: int, kind: int) -> NBPlace {
    if (== kind ParseNodeType.PNODE_IDENTIFIER) {
        let local: int = (nb_local (parser_get_identifier parser id).name)
        if (< local 0) { return (nb_invalid_place "a live resource place") }
        if (nb_ordinary_local local) { return (nb_invalid_place "an owner resource place") }
        if (or (not (at nb_live local)) (!= (at nb_tags local) 8)) { return (nb_invalid_place "a live resource place") }
        return NBPlace { root: local, layout: (at nb_layouts local), path: "" }
    }
    if (== kind ParseNodeType.PNODE_FIELD_ACCESS) {
        let field: ASTFieldAccess = (parser_get_field_access parser id)
        let parent: NBPlace = (nb_place parser field.object field.object_type)
        if (< parent.root 0) { return parent }
        let index: int = (nb_layout_field parser parent.layout field.field_name)
        if (< index 0) { return (nb_invalid_place "a declared resource path") }
        let record: ASTStruct = (parser_get_struct_def parser parent.layout)
        let child: int = (nb_record parser (at record.field_types index))
        if (or (< child 0) (>= (str_length parent.path) 128)) { return (nb_invalid_place "a resource path of at most 32 fields") }
        return NBPlace { root: parent.root, layout: child, path: (+ parent.path (nb_hex index 2)) }
    }
    return (nb_invalid_place "a root-local resource field chain")
}
shadow nb_place { set nb_error "" assert (== (nb_place (nb_fixture) 0 ParseNodeType.PNODE_NUMBER).root -1) set nb_error "" }
fn nb_observe_owner_path(parser: Parser, id: int, kind: int) -> int {
    if (or (not nb_owner_arrays) (not nb_value_graph)) { return (nb_fail "a mode-zero owner ARRAY observation") }
    let place: NBPlace = (nb_place parser id kind)
    if (< place.root 0) { return 0 }
    if (or (!= (at nb_modes place.root) 0) (at nb_disposal_pending place.root)) { return (nb_fail "an intact mode-zero owner leaf observation") }
    if (== kind ParseNodeType.PNODE_IDENTIFIER) { return (nb_op1 "LOAD_LOCAL" place.root) }
    let field: ASTFieldAccess = (parser_get_field_access parser id)
    let parent: NBPlace = (nb_place parser field.object field.object_type)
    if (< parent.root 0) { return 0 }
    let index: int = (nb_layout_field parser parent.layout field.field_name)
    if (< index 0) { return 0 }
    let _: int = (nb_observe_owner_path parser field.object field.object_type)
    if (!= nb_error "") { return 0 }
    return (nb_op1 "AGG_GET" index)
}
shadow nb_observe_owner_path {
    let owned: bool = nb_owner_arrays let graph: bool = nb_value_graph
    let ordinary: array<bool> = nb_ordinary_layouts set nb_ordinary_layouts [false, false]
    set nb_error "" let _: int = (nb_reset_locals)
    let source: string = "resource struct Handle { fd: int } struct Bundle { file: Handle, values: array<float> } fn main() -> int { return owned.file.fd }"
    let tokens: List<LexerToken> = (tokenize_string source "observation.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "observation.nano")
    assert (not (parser_has_error parser))
    let body: ASTBlock = (parser_get_block parser (parser_get_function parser 0).body)
    let returned: ASTReturn = (parser_get_return parser (list_ASTStmtRef_get body.statements 0).node_id)
    let field: ASTFieldAccess = (parser_get_field_access parser returned.value)
    let _: int = (nb_slot "owned" 8 1 0 false)
    set nb_owner_arrays true set nb_value_graph true
    let _: int = (nb_observe_owner_path parser field.object field.object_type)
    assert (== nb_error "") assert (== nb_code "  LOAD_LOCAL 0\n  AGG_GET 0\n")
    assert (at nb_live 0)
    (array_set nb_disposal_pending 0 true)
    let _: int = (nb_observe_owner_path parser field.object field.object_type)
    assert (!= nb_error "")
    set nb_error "" let _: int = (nb_reset_locals)
    set nb_owner_arrays owned set nb_value_graph graph set nb_ordinary_layouts ordinary
}
fn nb_overlap(left: NBPlace, right: NBPlace) -> bool {
    return (and (== left.root right.root) (or (str_starts_with left.path right.path) (str_starts_with right.path left.path)))
}
shadow nb_overlap {
    let root: NBPlace = NBPlace { root: 0, layout: 0, path: "" }
    let child: NBPlace = NBPlace { root: 0, layout: 0, path: "0000" }
    let sibling: NBPlace = NBPlace { root: 0, layout: 0, path: "0100" }
    assert (nb_overlap root child) assert (nb_overlap child root) assert (not (nb_overlap child sibling))
}
fn nb_reference(parser: Parser, place: NBPlace, reference: int, mode: int) -> int {
    if (not (nb_leaf parser place.layout)) { return (nb_fail "a scalar-leaf resource referent") }
    if (== place.path "") {
        if (== mode 2) { return (nb_op2 "BORROW_LOCAL_EXCLUSIVE" reference place.root) }
        return (nb_op2 "BORROW_LOCAL_SHARED" reference place.root)
    }
    let mut index: int = 0
    while (< index (array_length nb_paths)) { if (== (at nb_paths index) place.path) { break } set index (+ index 1) }
    if (== index (array_length nb_paths)) {
        if (>= index 256) { return (nb_fail "at most 256 numeric resource paths") }
        set nb_paths (array_push nb_paths place.path)
    }
    let mut opcode: string = "BORROW_PATH_SHARED"
    if (== mode 2) { set opcode "BORROW_PATH_EXCLUSIVE" }
    return (nb_emit (+ opcode (+ " " (+ (int_to_string reference) (+ " " (+ (int_to_string place.root) (+ " " (int_to_string index))))))))
}
shadow nb_reference {
    set nb_error "" set nb_paths [] set nb_code ""
    let _: int = (nb_reference (nb_fixture) NBPlace { root: 2, layout: 0, path: "0000" } 1 2)
    assert (== nb_code "  BORROW_PATH_EXCLUSIVE 1 2 0\n") assert (== (array_length nb_paths) 1)
    set nb_paths [] set nb_code ""
}
fn nb_unpack(parser: Parser, local: int) -> int {
    let record: ASTStruct = (parser_get_struct_def parser (at nb_layouts local))
    let mut slots: array<int> = []
    let mut i: int = 0
    while (and (== nb_error "") (< i record.field_count)) {
