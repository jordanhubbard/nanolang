            if (and nb_owner_arrays (or nb_mixed (not nb_value_graph))) { let _: int = (nb_fail "a separate mode-zero owner ARRAY profile") return "" }
    while (!= (% (str_length ownership) 8) 0) { set ownership (+ ownership "00") }
            set i (+ i 1)
