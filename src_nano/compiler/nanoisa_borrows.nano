    if (== nb_error "") { set nb_code (+ nb_code (+ "  " (+ op "\n"))) }
    return 0
}
shadow nb_emit { set nb_code "" set nb_error "" let _: int = (nb_emit "RET") assert (== nb_code "  RET\n") }
