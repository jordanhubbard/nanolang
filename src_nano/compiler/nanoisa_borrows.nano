# My visited concrete types bound shared DAGs; budget exhaustion cannot grant admission.
fn nb_record_has_owner(parser: Parser, record_index: int) -> bool {
    if (< record_index 0) { return false }
    let records: int = (parser_get_struct_def_count parser)
    if (>= record_index records) { return true }
    let unions: int = (parser_get_union_count parser)
    let mut roots: bool = false
    let mut i: int = 0
    while (< i records) {
        if (parser_get_struct_def parser i).is_resource { set roots true break }
        set i (+ i 1)
    }
    # An owner-free compiler AST graph must not select ownership on budget alone.
    if (not roots) { return false }
    if (> (+ records unions) 1024) { return true }
    let mut pending: array<string> = [(parser_get_struct_def parser record_index).name]
    let mut visited: array<string> = []
    let mut cursor: int = 0
    let mut bytes: int = 0
    while (< cursor (array_length pending)) {
        if (> (array_length pending) 512) { return true }
        let queued: string = (at pending cursor)
        if (> (str_length queued) 4096) { return true }
        let spelling: string = (str_trim queued)
        set cursor (+ cursor 1)
        let length: int = (str_length spelling)
        if (> length 4096) { return true }
        set bytes (+ bytes length)
        if (> bytes 65536) { return true }
        let mut seen: bool = false
        set i 0
        while (< i (array_length visited)) { if (== spelling (at visited i)) { set seen true break } set i (+ i 1) }
        if (not seen) {
            set visited (array_push visited spelling)
            let parts: array<string> = (nb_route_parts spelling)
            if (== (array_length parts) 0) { return true }
            let name: string = (at parts 0)
            let mut args: array<string> = []
            set i 1
            while (< i (array_length parts)) { set args (array_push args (at parts i)) set i (+ i 1) }
            let mut fields: array<string> = []
            let record: int = (nb_record parser name)
            if (or (== name "array") (or (== name "List") (== name "HashMap"))) {
                set fields args
            } else {
                if (>= record 0) {
                    let definition: ASTStruct = (parser_get_struct_def parser record)
                    if definition.is_resource { return true }
                    if (> (array_length args) 0) { return true }
                    set fields definition.field_types
                } else {
                    let mut found: bool = false
                    set i 0
                    while (< i unions) {
                        let definition: ASTUnion = (parser_get_union parser i)
                        if (== definition.name name) {
                            set found true
                            if (!= definition.generic_param_count (array_length args)) { return true }
                            if (> (array_length definition.variant_field_types) 256) { return true }
                            let mut maximum: int = 1
                            let mut arg: int = 0
                            while (< arg (array_length args)) { if (> (str_length (at args arg)) maximum) { set maximum (str_length (at args arg)) } set arg (+ arg 1) }
                            let mut field: int = 0
                            while (< field (array_length definition.variant_field_types)) {
                                let raw: string = (at definition.variant_field_types field)
                                # I bound even the worst substitution before constructing its string.
                                if (> (str_length raw) (/ 4096 maximum)) { return true }
                                set fields (array_push fields (substitute_type_parameters raw definition.generic_params args))
                                set field (+ field 1)
                            }
                            break
                        }
                        set i (+ i 1)
                    }
                    if (not found) {
                        if (or (> (array_length args) 0) (str_contains name ".")) { return true }
                    }
                }
            }
            if (> (array_length fields) 256) { return true }
            if (> (+ (array_length pending) (array_length fields)) 512) { return true }
            set i 0
            while (< i (array_length fields)) {
                let field: string = (at fields i)
                if (> (str_length field) 4096) { return true }
                set pending (array_push pending field)
                set i (+ i 1)
            }
        }
    }
    return false
}
