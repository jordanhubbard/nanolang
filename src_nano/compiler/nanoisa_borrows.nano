        if (== function.name "main") { if (>= entry 0) { let _: int = (nb_fail "one main") return "" } set entry i }
        else { set nb_helper i }
        set i (+ i 1)
    }
    if (or (< entry 0) (< nb_helper 0)) { let _: int = (nb_fail "main and one borrowed helper") return "" }
    let main_function: ASTFunction = (parser_get_function parser entry)
    let helper: ASTFunction = (parser_get_function parser nb_helper)
