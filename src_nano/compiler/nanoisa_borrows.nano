        if (or (not record.is_resource) (or (> record.field_count 256) (str_contains record.name "<"))) { let _: int = (nb_fail "finite plain scalar resource records") return "" }
        if (!= (nb_record parser record.name) i) { let _: int = (nb_fail "distinct nominal declarations") return "" }
        let name_index: int = (nb_string record.name)
        set layouts (+ layouts (+ "0000" (+ (nb_hex record.field_count 2) (nb_hex name_index 4))))
        let mut field: int = 0
        while (< field record.field_count) {
            let tag: int = (nb_tag (at record.field_types field))
            if (== tag 0) { let _: int = (nb_fail "only int/bool resource fields") return "" }
            let mut prior: int = 0
            while (< prior field) { if (== (at record.field_names prior) (at record.field_names field)) { let _: int = (nb_fail "distinct field declarations") return "" } set prior (+ prior 1) }
            let field_name: int = (nb_string (at record.field_names field))
