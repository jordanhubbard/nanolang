pub fn lower_service_source(parser: Parser, files: array<string>, sources: array<string>, space: ServiceNamespace,
    bodies: ServiceBodyCheck, owners: ServiceOwnershipCheck, selection: int) -> ServiceLowering {
    set sl_status 0 set sl_diagnostic "" set sl_functions [] set sl_facts bodies.facts set sl_maps []
    let mut result: array<ServiceWireFunction> = []
    if (or (!= space.status 0) (or (!= bodies.status 0) (!= owners.status 0))) { (sl_fail 1 "I require complete nominal and ownership checks before lowering.") }
    let count: int = (+ parser.functions_count parser.shadows_count)
    if (or (== count 0) (> count 63)) { (sl_fail 3 "I exceeded my File function bound.") }
    let mut i: int = 0
    while (< i (array_length space.plan.rows)) {
        if (!= (at space.plan.rows i).request 0) { (sl_fail 2 "I have not lowered multiple nominal File catalog declarations together.") }
        set i (+ i 1)
    }
    let mut selected: int = -1 set i 0
    while (and (== sl_status 0) (< i count)) {
        let mut line: int = 0 let mut body: int = -1 let mut arity: int = 0 let mut params: int = 0 let mut name: string = ""
        let mut typ: ServiceWireType = (service_wire_scalar 0) let mut declaration: int = 0 let mut owner: int = -1
        if (< i parser.functions_count) {
            let fnc: ASTFunction = (parser_get_function parser i)
            set line fnc.line set body fnc.body set arity fnc.param_count set params fnc.param_start set name fnc.name
            set owner (sn_owner files sources line) set typ (sl_annotation space owner fnc.return_type)
            let found: int = (service_namespace_lookup space owner name)
            if (< found 0) { (sl_fail 1 "I require the original function identity.") }
            else { set declaration (at space.names found).target }
            if (and (< selection 0) (and (== name "main") (== owner (- (array_length files) 1)))) { set selected i }
        } else {
            let item: ASTShadow = (list_ASTShadow_get parser.shadows (- i parser.functions_count))
            set line item.line set body item.body set name (+ "shadow." item.target_name)
            set owner (sn_owner files sources line)
            if (== selection (- i parser.functions_count)) { set selected i }
        }
        if (or (< owner 0) (>= owner (array_length files))) { (sl_fail 1 "I require the original function source.") }
        else { set name (+ (at files owner) (+ "::" (+ name (+ "#" (int_to_string i))))) }
        set sl_functions (array_push sl_functions ServiceLowerFunction { declaration: declaration, owner: owner, body: body, arity: arity, params: params, name: name, result: typ })
        set i (+ i 1)
    }
    if (< selected 0) { (sl_fail 1 "I require a selected File entry in this graph.") }
    set i 0
    while (and (== sl_status 0) (< i (array_length sl_functions))) {
        let fnc: ServiceLowerFunction = (at sl_functions i)
        set sl_code [] set sl_locals [] set sl_live [] set sl_names [] set sl_name_count 0
        set sl_loans [] set sl_pending [] set sl_next true set sl_stack 0 set sl_peak 0 set sl_depth 0
        set sl_result fnc.result set sl_next_ref fnc.arity let mut j: int = 0
        while (and (== sl_status 0) (< j fnc.arity)) {
            let parameter: ASTLet = (parser_get_let parser (+ fnc.params j))
            let _: int = (sl_bind parameter.name (sl_annotation space fnc.owner parameter.var_type)) set j (+ j 1)
        }
        (sl_expr parser space ParseNodeType.PNODE_BLOCK fnc.body false)
        if sl_next {
            if (!= sl_result.tag 0) { (sl_fail 1 "I require a return from this File helper.") }
            else { (sl_op 61 0 0) }
        }
        set result (array_push result ServiceWireFunction { name: fnc.name, arity: fnc.arity, result: fnc.result, locals: sl_locals, code: sl_code, max_stack: sl_peak })
        set i (+ i 1)
    }
    if (== sl_status 0) {
        let entry: ServiceLowerFunction = (at sl_functions selected)
        if (or (!= entry.arity 0) (and (< selected parser.functions_count) (and (!= entry.result.tag 1) (!= entry.result.tag 4)))) {
            (sl_fail 2 "I require a zero-argument scalar entry or a selected shadow.")
        } else if (>= selected parser.functions_count) {
            set sl_code [] (sl_integer 59 1) (sl_integer selected 4) (sl_integer 1 1) (sl_integer 0 8) (sl_integer 61 1)
            set selected (array_length result)
            set result (array_push result ServiceWireFunction { name: "__file_selected_shadow", arity: 0,
                result: (service_wire_scalar 1), locals: [], code: sl_code, max_stack: 1 })
        }
    }
    let mut bytes: array<int> = []
    if (== sl_status 0) {
        set bytes (service_wire_serialize_refs result selected sl_maps)
        if (== (array_length bytes) 0) { (sl_fail 3 "I cannot serialize these bounded File lowering records.") }
    }
    return ServiceLowering { status: sl_status, diagnostic: sl_diagnostic, bytes: bytes }
}
shadow lower_service_source {
    let tokens: List<LexerToken> = (tokenize_string "" "test" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program tokens (list_LexerToken_length tokens) "test")
    let space: ServiceNamespace = ServiceNamespace { status: 1, names: [], plan: FileSourcePlan { status: 0, rows: [], logical_bytes: 0 }, text_bytes: 0, ordinary_count: 0, alias_count: 0 }
    let bodies: ServiceBodyCheck = ServiceBodyCheck { status: 0, diagnostic: "", facts: [], functions: 0, shadows: 0 }
    let owners: ServiceOwnershipCheck = ServiceOwnershipCheck { status: 0, diagnostic: "", facts: [], functions: 0, shadows: 0 }
    let result: ServiceLowering = (lower_service_source p [] [] space bodies owners -1)
    assert (== result.status 1) assert (== (array_length result.bytes) 0)
    set sl_status 0 set sl_diagnostic ""
}
