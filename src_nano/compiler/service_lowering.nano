fn sl_match(parser: Parser, space: ServiceNamespace, id: int, want: bool) -> void {
    let node: ASTMatch = (parser_get_match parser id)
    let fact: ServiceBodyFact = (sl_fact node.scrutinee_type node.scrutinee)
