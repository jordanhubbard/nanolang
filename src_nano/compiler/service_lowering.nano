# I lower retained Nano parser and checker facts independently to File bytecode.
import "src_nano/compiler/service_ownership.nano"
import "src_nano/compiler/service_bodies.nano"
import "src_nano/compiler/service_namespace.nano"
import "src_nano/compiler/service_types.nano"
import "src_nano/parser.nano"
from "src_nano/compiler/lexer.nano" import tokenize_string
import "src_nano/compiler/service_wire.nano"
module "modules/file_source_catalog/file_source_catalog.nano" as LowerCatalog

struct ServiceLowering { status: int, diagnostic: string, bytes: array<int> }
struct ServiceLowerName { name: string, slot: int }
struct ServiceLowerFunction { declaration: int, owner: int, body: int, arity: int, params: int, name: string, result: ServiceWireType }
let mut sl_status: int = 0
let mut sl_diagnostic: string = ""
let mut sl_code: array<int> = []
let mut sl_locals: array<ServiceWireType> = []
let mut sl_live: array<bool> = []
let mut sl_names: array<ServiceLowerName> = []
let mut sl_name_count: int = 0
let mut sl_loans: array<int> = []
let mut sl_pending: array<int> = []
let mut sl_next_ref: int = 0
let mut sl_next: bool = true
let mut sl_stack: int = 0
let mut sl_peak: int = 0
let mut sl_depth: int = 0
let mut sl_result: ServiceWireType = ServiceWireType { tag: 0, mode: 0, layout: 4294967295 }
let mut sl_functions: array<ServiceLowerFunction> = []
let mut sl_facts: array<ServiceBodyFact> = []
let mut sl_maps: array<ServiceWireSection> = []

fn sl_fail(status: int, diagnostic: string) -> void {
    if (== sl_status 0) { set sl_status status set sl_diagnostic diagnostic }
}
shadow sl_fail {
    set sl_status 0 (sl_fail 2 "first") (sl_fail 1 "second")
    assert (== sl_status 2) assert (== sl_diagnostic "first") set sl_status 0 set sl_diagnostic ""
}

fn sl_wire_type(typ: ServiceType, mode: int) -> ServiceWireType {
    let mut tag: int = 0 let mut layout: int = 4294967295
    if (== typ.kind 1) { set tag 1 }
    else if (== typ.kind 2) { set tag 4 }
    else if (== typ.kind 3) { set tag 0 }
    else if (and (>= typ.kind 4) (and (> typ.declaration 0) (and (>= typ.ordinal 0) (< typ.ordinal 8)))) {
        set layout typ.ordinal set tag 10 if (< layout 3) { set tag 8 }
    } else { (sl_fail 2 "I have not lowered this checked service type.") }
    return ServiceWireType { tag: tag, mode: mode, layout: layout }
}
shadow sl_wire_type {
    let typ: ServiceType = ServiceType { kind: 1, declaration: 0, owner: -1, ordinal: -1, category: 0 }
    assert (== (sl_wire_type typ 0).tag 1)
    assert (== (sl_wire_type typ 0).layout 4294967295)
    let file: ServiceType = ServiceType { kind: 4, declaration: 1, owner: 0, ordinal: 0, category: 1 }
    assert (== (sl_wire_type file 1).mode 1)
    assert (== (sl_wire_type file 1).layout 0)
}

fn sl_annotation(space: ServiceNamespace, owner: int, spelling: string) -> ServiceWireType {
    let tokens: List<LexerToken> = (tokenize_string spelling "<lower-type>" (list_CompilerDiagnostic_new))
    let mut i: int = 0 let mut mode: int = 0
    if (== (list_LexerToken_get tokens i).token_type LexerTokenType.TOKEN_AMPERSAND) {
        set mode 1 set i 1
        if (== (list_LexerToken_get tokens i).token_type LexerTokenType.TOKEN_MUT) { set mode 2 set i (+ i 1) }
    }
    let mut name: string = (list_LexerToken_get tokens i).value set i (+ i 1)
    while (and (< (+ i 1) (list_LexerToken_length tokens)) (== (list_LexerToken_get tokens i).token_type LexerTokenType.TOKEN_DOT)) {
        set name (+ name (+ "." (list_LexerToken_get tokens (+ i 1)).value)) set i (+ i 2)
    }
    let mut kind: int = 0
    if (== name "int") { set kind 1 } else if (== name "bool") { set kind 2 } else if (== name "void") { set kind 3 }
    if (!= kind 0) { return (sl_wire_type ServiceType { kind: kind, declaration: 0, owner: -1, ordinal: -1, category: 0 } mode) }
    return (sl_wire_type (service_named_type space owner name) mode)
}
shadow sl_annotation {
    let space: ServiceNamespace = ServiceNamespace { status: 0, names: [], plan: FileSourcePlan { status: 0, rows: [], logical_bytes: 0 }, text_bytes: 0, ordinary_count: 0, alias_count: 0 }
    assert (== (sl_annotation space 0 "bool").tag 4)
}

fn sl_fact(kind: int, id: int) -> ServiceBodyFact {
    let mut i: int = 0
    while (< i (array_length sl_facts)) {
        let fact: ServiceBodyFact = (at sl_facts i)
        if (and (== fact.node_kind kind) (== fact.node_id id)) { return fact }
        set i (+ i 1)
    }
    (sl_fail 1 "I require retained nominal facts for each lowered expression.")
    return ServiceBodyFact { node_kind: kind, node_id: id, type: ServiceType { kind: 0, declaration: 0, owner: -1, ordinal: -1, category: 0 }, borrow_mode: 0, declaration: 0 }
}
shadow sl_fact {
    set sl_facts [] set sl_status 0 let fact: ServiceBodyFact = (sl_fact -1 -1)
    assert (== sl_status 1) assert (== fact.type.kind 0) set sl_status 0 set sl_diagnostic ""
}

fn sl_node_type(kind: int, id: int) -> ServiceWireType {
    let fact: ServiceBodyFact = (sl_fact kind id)
    return (sl_wire_type fact.type fact.borrow_mode)
}
shadow sl_node_type {
    set sl_facts [ServiceBodyFact { node_kind: 1, node_id: 2, type: ServiceType { kind: 2, declaration: 0, owner: -1, ordinal: -1, category: 0 }, borrow_mode: 0, declaration: 0 }]
    assert (== (sl_node_type 1 2).tag 4) set sl_facts []
}

fn sl_owner(typ: ServiceWireType) -> bool {
    return (and (== typ.mode 0) (or (== typ.layout 0) (== typ.layout 3)))
}
shadow sl_owner {
    assert (not (sl_owner (service_wire_scalar 1)))
    assert (sl_owner ServiceWireType { tag: 10, mode: 0, layout: 3 })
}

fn sl_integer(value: int, width: int) -> void {
    if (!= sl_status 0) { return }
    if (> (+ (array_length sl_code) width) 65536) { (sl_fail 3 "I exceeded my File code bound.") return }
    let mut remaining: int = value let mut i: int = 0
    while (< i width) {
        let mut octet: int = (% remaining 256) if (< octet 0) { set octet (+ octet 256) }
        set sl_code (array_push sl_code octet) set remaining (/ (- remaining octet) 256) set i (+ i 1)
    }
}
shadow sl_integer {
    set sl_code [] (sl_integer -1 4)
    assert (== (array_length sl_code) 4) assert (== (at sl_code 3) 255) set sl_code []
}

fn sl_op(op: int, pop: int, push: int) -> void {
    if (< sl_stack pop) { (sl_fail 1 "I require a complete operand stack before lowering this instruction.") return }
    set sl_stack (+ (- sl_stack pop) push)
    if (> sl_stack sl_peak) { set sl_peak sl_stack }
    if (> sl_peak 256) { (sl_fail 3 "I exceeded my File operand stack bound.") }
    (sl_integer op 1)
}
shadow sl_op {
    set sl_code [] set sl_stack 0 set sl_peak 0 (sl_op 5 0 1) (sl_op 8 1 0)
    assert (== sl_peak 1) assert (== sl_stack 0) set sl_code [] set sl_peak 0
}

fn sl_local_op(op: int, slot: int, pop: int, push: int) -> void {
    (sl_op op pop push) (sl_integer slot 2)
}
shadow sl_local_op {
    set sl_code [] set sl_stack 0 (sl_local_op 16 257 0 1)
    assert (== (at sl_code 1) 1) assert (== (at sl_code 2) 1)
    set sl_code [] set sl_stack 0 set sl_peak 0
}

fn sl_branch(op: int, slot: int) -> int {
    let pc: int = (array_length sl_code) let mut pop: int = 0
    if (or (== op 57) (== op 58)) { set pop 1 }
    (sl_op op pop 0) if (== op 146) { (sl_integer slot 2) }
    (sl_integer 0 4) return pc
}
shadow sl_branch {
    set sl_code [] set sl_stack 0 assert (== (sl_branch 56 0) 0)
    assert (== (array_length sl_code) 5) set sl_code []
}

fn sl_target(pc: int, target: int) -> void {
    if (!= sl_status 0) { return }
    let mut index: int = (+ pc 1) if (== (at sl_code pc) 146) { set index (+ pc 3) }
    let mut remaining: int = (- target pc) let mut i: int = 0
    while (< i 4) {
        let mut octet: int = (% remaining 256) if (< octet 0) { set octet (+ octet 256) }
        (array_set sl_code (+ index i) octet) set remaining (/ (- remaining octet) 256) set i (+ i 1)
    }
}
shadow sl_target {
    set sl_code [0, 56, 0, 0, 0, 0] (sl_target 1 0)
    assert (== (at sl_code 2) 255) assert (== (at sl_code 5) 255) set sl_code []
}

fn sl_bind(name: string, typ: ServiceWireType) -> int {
    let slot: int = (array_length sl_locals)
    if (>= slot 256) { (sl_fail 3 "I exceeded my File local bound.") return 0 }
    set sl_locals (array_push sl_locals typ) set sl_live (array_push sl_live false)
    if (!= name "") {
        let row: ServiceLowerName = ServiceLowerName { name: name, slot: slot }
        if (< sl_name_count (array_length sl_names)) { (array_set sl_names sl_name_count row) }
        else { set sl_names (array_push sl_names row) }
        set sl_name_count (+ sl_name_count 1)
    }
    return slot
}
shadow sl_bind {
    set sl_locals [] set sl_live [] set sl_names [] set sl_name_count 0
    assert (== (sl_bind "x" (service_wire_scalar 1)) 0)
    assert (== (sl_bind "" (service_wire_scalar 4)) 1) assert (== sl_name_count 1)
    set sl_locals [] set sl_live [] set sl_names [] set sl_name_count 0
}

fn sl_lookup(name: string) -> int {
    let mut i: int = sl_name_count
    while (> i 0) { set i (- i 1) if (== (at sl_names i).name name) { return (at sl_names i).slot } }
    (sl_fail 1 "I require a lexical File binding.") return 0
}
shadow sl_lookup {
    set sl_names [ServiceLowerName { name: "x", slot: 4 }, ServiceLowerName { name: "x", slot: 7 }]
    set sl_name_count 2 assert (== (sl_lookup "x") 7)
    set sl_name_count 1 assert (== (sl_lookup "x") 4) set sl_name_count 0 set sl_names []
}

fn sl_clear(slot: int) -> void {
    let typ: ServiceWireType = (at sl_locals slot)
    if (and (at sl_live slot) (and (not (sl_owner typ)) (and (== typ.mode 0) (!= typ.tag 0)))) {
        (sl_op 5 0 1) (sl_local_op 17 slot 1 0) (array_set sl_live slot false)
    }
}
shadow sl_clear {
    set sl_locals [(service_wire_scalar 1)] set sl_live [true] set sl_code [] set sl_stack 0
    (sl_clear 0) assert (== (array_length sl_code) 4) assert (not (at sl_live 0))
    (sl_clear 0) assert (== (array_length sl_code) 4)
    set sl_locals [] set sl_live [] set sl_code [] set sl_peak 0
}

fn sl_scope_end(names: int, slots: int) -> void {
    let mut i: int = slots
    while (and sl_next (< i (array_length sl_locals))) { (sl_clear i) set i (+ i 1) }
    set sl_name_count names
}
shadow sl_scope_end {
    set sl_name_count 3 set sl_locals [] (sl_scope_end 1 0)
    assert (== sl_name_count 1) set sl_name_count 0
}

fn sl_store(slot: int) -> void {
    let typ: ServiceWireType = (at sl_locals slot)
    if (== typ.tag 0) { (sl_op 8 1 0) return }
    let mut op: int = 17 if (sl_owner typ) { set op 12 }
    (sl_local_op op slot 1 0) (array_set sl_live slot true)
}
shadow sl_store {
    set sl_locals [(service_wire_scalar 1)] set sl_live [false] set sl_code [] set sl_stack 1
    (sl_store 0) assert (== sl_stack 0) assert (at sl_live 0)
    set sl_locals [] set sl_live [] set sl_code []
}

fn sl_load(slot: int) -> void {
    let typ: ServiceWireType = (at sl_locals slot)
    if (== typ.tag 0) { (sl_op 5 0 1) return }
    let mut op: int = 16 if (sl_owner typ) { set op 11 }
    (sl_local_op op slot 0 1)
}
shadow sl_load {
    set sl_locals [(service_wire_scalar 1)] set sl_code [] set sl_stack 0
    (sl_load 0) assert (== sl_stack 1) assert (== (at sl_code 0) 16)
    set sl_locals [] set sl_code [] set sl_stack 0 set sl_peak 0
}

fn sl_prefix(values: array<int>, count: int) -> array<int> {
    let mut result: array<int> = [] let mut i: int = 0
    while (< i count) { set result (array_push result (at values i)) set i (+ i 1) }
    return result
}
shadow sl_prefix { assert (== (array_length (sl_prefix [1, 2, 3] 2)) 2) assert (== (at (sl_prefix [7] 1) 0) 7) }

fn sl_end_loans(start: int) -> void {
    let mut i: int = (array_length sl_loans)
    while (> i start) { set i (- i 1) (sl_local_op 150 (at sl_loans i) 0 0) (sl_op 23 0 0) }
    set sl_loans (sl_prefix sl_loans start)
}
shadow sl_end_loans {
    set sl_loans [4] set sl_code [] set sl_stack 0 (sl_end_loans 0)
    assert (== (array_length sl_loans) 0) assert (== (at sl_code 0) 150) set sl_code []
}

fn sl_pending_exit() -> void {
    let mut i: int = (array_length sl_pending)
    while (> i 0) {
        set i (- i 1) let slot: int = (at sl_pending i)
        if (sl_owner (at sl_locals slot)) { (sl_local_op 148 slot 0 0) } else { (sl_clear slot) }
    }
    set sl_pending []
}
shadow sl_pending_exit {
    set sl_pending [0] set sl_locals [ServiceWireType { tag: 8, mode: 0, layout: 0 }]
    set sl_code [] set sl_stack 0 (sl_pending_exit)
    assert (== (array_length sl_pending) 0) assert (== (at sl_code 0) 148)
    set sl_locals [] set sl_code []
}

fn sl_stage(typ: ServiceWireType) -> int {
    let slot: int = (sl_bind "" typ) (sl_store slot)
    set sl_pending (array_push sl_pending slot) return slot
}
shadow sl_stage {
    set sl_locals [] set sl_live [] set sl_pending [] set sl_code [] set sl_stack 1
    assert (== (sl_stage (service_wire_scalar 1)) 0) assert (== (at sl_pending 0) 0)
    set sl_locals [] set sl_live [] set sl_pending [] set sl_code [] set sl_stack 0
}

fn sl_children(parser: Parser, kind: int, id: int) -> array<ASTStmtRef> {
    let mut result: array<ASTStmtRef> = [] let mut start: int = 0 let mut count: int = 0
    if (< id 0) { return result }
    if (== kind ParseNodeType.PNODE_CALL) { let n: ASTCall = (parser_get_call parser id) set start n.arg_start set count n.arg_count }
    else if (== kind ParseNodeType.PNODE_MODULE_QUALIFIED_CALL) { let n: ASTModuleQualifiedCall = (parser_get_module_qualified_call parser id) set start n.arg_start set count n.arg_count }
    else if (== kind ParseNodeType.PNODE_BLOCK) {
        let n: ASTBlock = (parser_get_block parser id) let mut i: int = 0
        while (< i (list_ASTStmtRef_length n.statements)) { set result (array_push result (list_ASTStmtRef_get n.statements i)) set i (+ i 1) }
    } else if (== kind ParseNodeType.PNODE_BINARY_OP) {
        let n: ASTBinaryOp = (parser_get_binary_op parser id)
        if (not n.is_unary) { set result (array_push result ASTStmtRef { node_type: n.left_type, node_id: n.left }) }
        set result (array_push result ASTStmtRef { node_type: n.right_type, node_id: n.right })
    } else if (== kind ParseNodeType.PNODE_MATCH) {
        let n: ASTMatch = (parser_get_match parser id)
        set result [ASTStmtRef { node_type: n.scrutinee_type, node_id: n.scrutinee }]
        let mut i: int = 0
        while (< i n.arm_count) {
            set result (array_push result ASTStmtRef { node_type: (at n.arm_body_types i), node_id: (at n.arm_body_ids i) }) set i (+ i 1)
        }
    } else if (== kind ParseNodeType.PNODE_IF) {
        let n: ASTIf = (parser_get_if parser id)
        set result [ASTStmtRef { node_type: n.condition_type, node_id: n.condition }, ASTStmtRef { node_type: ParseNodeType.PNODE_BLOCK, node_id: n.then_body }, ASTStmtRef { node_type: ParseNodeType.PNODE_BLOCK, node_id: n.else_body }]
    } else if (== kind ParseNodeType.PNODE_WHILE) {
        let n: ASTWhile = (parser_get_while parser id)
        set result [ASTStmtRef { node_type: n.condition_type, node_id: n.condition }, ASTStmtRef { node_type: ParseNodeType.PNODE_BLOCK, node_id: n.body }]
    } else if (== kind ParseNodeType.PNODE_LET) {
        let n: ASTLet = (parser_get_let parser id) set result [ASTStmtRef { node_type: n.value_type, node_id: n.value }]
    } else if (== kind ParseNodeType.PNODE_SET) {
        let n: ASTSet = (parser_get_set parser id) set result [ASTStmtRef { node_type: n.value_type, node_id: n.value }]
    } else if (== kind ParseNodeType.PNODE_ASSERT) {
        let n: ASTAssert = (parser_get_assert parser id) set result [ASTStmtRef { node_type: n.condition_type, node_id: n.condition }]
    } else if (== kind ParseNodeType.PNODE_FIELD_ACCESS) {
        let n: ASTFieldAccess = (parser_get_field_access parser id) set result [ASTStmtRef { node_type: n.object_type, node_id: n.object }]
    }
    let mut i: int = 0
    while (< i count) { set result (array_push result (parser_get_call_arg parser (+ start i))) set i (+ i 1) }
    return result
}
shadow sl_children {
    let tokens: List<LexerToken> = (tokenize_string "" "test" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program tokens (list_LexerToken_length tokens) "test")
    assert (== (array_length (sl_children p 0 -1)) 0)
}

fn sl_terminal(parser: Parser, kind: int, id: int, depth: int) -> bool {
    if (< id 0) { return false }
    if (or (>= depth 128) (== kind ParseNodeType.PNODE_RETURN)) { return true }
    let children: array<ASTStmtRef> = (sl_children parser kind id) let mut i: int = 0
    while (< i (array_length children)) {
        let child: ASTStmtRef = (at children i)
        if (sl_terminal parser child.node_type child.node_id (+ depth 1)) { return true }
        set i (+ i 1)
    }
    return false
}
shadow sl_terminal {
    let tokens: List<LexerToken> = (tokenize_string "" "test" (list_CompilerDiagnostic_new))
    let p: Parser = (parse_program tokens (list_LexerToken_length tokens) "test")
    assert (sl_terminal p ParseNodeType.PNODE_RETURN 0 0)
    assert (not (sl_terminal p 0 -1 0))
}

fn sl_operator(token: int, unary: bool) -> int {
    if (== token LexerTokenType.TOKEN_PLUS) { return 32 }
    if (== token LexerTokenType.TOKEN_MINUS) { if unary { return 37 } return 33 }
    if (== token LexerTokenType.TOKEN_STAR) { return 34 }
    if (== token LexerTokenType.TOKEN_SLASH) { return 35 }
    if (== token LexerTokenType.TOKEN_PERCENT) { return 36 }
    if (== token LexerTokenType.TOKEN_EQ) { return 40 }
    if (== token LexerTokenType.TOKEN_NE) { return 41 }
    if (== token LexerTokenType.TOKEN_LT) { return 42 }
    if (== token LexerTokenType.TOKEN_LE) { return 43 }
    if (== token LexerTokenType.TOKEN_GT) { return 44 }
    if (== token LexerTokenType.TOKEN_GE) { return 45 }
    if (== token LexerTokenType.TOKEN_NOT) { return 50 }
    (sl_fail 2 "I have not lowered this service operator.") return 0
}
shadow sl_operator {
    assert (== (sl_operator LexerTokenType.TOKEN_MINUS true) 37)
    assert (== (sl_operator LexerTokenType.TOKEN_MINUS false) 33)
}

fn sl_reference_map(references: array<int>) -> int {
    let mut bytes: array<int> = [] let mut i: int = 0
    while (< i (array_length references)) {
        let value: int = (at references i)
        set bytes (array_push bytes (% value 256)) set bytes (array_push bytes (/ value 256))
        set i (+ i 1)
    }
    set i 0
    while (< i (array_length sl_maps)) {
        let prior: array<int> = (at sl_maps i).bytes
        let mut same: bool = (== (array_length prior) (array_length bytes)) let mut j: int = 0
        while (and same (< j (array_length bytes))) {
            set same (== (at prior j) (at bytes j)) set j (+ j 1)
        }
        if same { return i }
        set i (+ i 1)
    }
    set sl_maps (array_push sl_maps ServiceWireSection { kind: 0, bytes: bytes }) return i
}
shadow sl_reference_map {
    set sl_maps []
    assert (== (sl_reference_map [3, 65535, 1]) 0)
    assert (== (sl_reference_map [3, 65535, 1]) 0)
    assert (== (sl_reference_map [1, 65535, 3]) 1)
    assert (== (at (at sl_maps 0).bytes 2) 255) set sl_maps []
}

fn sl_call(parser: Parser, space: ServiceNamespace, kind: int, id: int, want: bool) -> void {
    let fact: ServiceBodyFact = (sl_fact kind id)
    let args: array<ASTStmtRef> = (sl_children parser kind id)
    if (== fact.declaration 0) {
        if (== kind ParseNodeType.PNODE_CALL) {
            let node: ASTCall = (parser_get_call parser id)
            if (and (== node.function_type ParseNodeType.PNODE_IDENTIFIER) (== (parser_get_identifier parser node.function).name "not")) {
                let arg: ASTStmtRef = (at args 0) (sl_expr parser space arg.node_type arg.node_id true)
                if sl_next { (sl_op 50 1 1) if (not want) { (sl_op 8 1 0) } }
                return
            }
        }
        (sl_fail 1 "I require an original callable identity.") return
    }
    let mut target: int = -1 let mut i: int = 0
    while (< i (array_length space.names)) {
        let row: ServiceName = (at space.names i)
        if (and (== row.id fact.declaration) (== row.id row.target)) { set target i }
        set i (+ i 1)
    }
    if (< target 0) { (sl_fail 1 "I require an original callable identity.") return }
    let row: ServiceName = (at space.names target)
    let mut reference: int = 65535 let mut values: int = 0
    let mut references: array<int> = [] let mut borrowed: int = 0
    let loans: int = (array_length sl_loans) let pending: int = (array_length sl_pending)
    let stage: bool = (sl_terminal parser kind id 0) let mut staged: array<int> = []
    if (> (array_length args) 256) { (sl_fail 3 "I exceeded my call operand bound.") return }
    set i 0
    while (and sl_next (and (== sl_status 0) (< i (array_length args)))) {
        let arg: ASTStmtRef = (at args i) let checked: ServiceBodyFact = (sl_fact arg.node_type arg.node_id)
        if (!= checked.borrow_mode 0) {
            if (and (!= checked.borrow_mode 1) (!= checked.borrow_mode 2)) { (sl_fail 2 "I have not lowered this multi-reference call.") return }
            let mut root: ASTStmtRef = arg
            if (== root.node_type ParseNodeType.PNODE_CALL) {
                let borrow: ASTCall = (parser_get_call parser root.node_id)
                if (!= borrow.borrow_mode 0) { set root (parser_get_call_arg parser borrow.arg_start) }
            }
            if (!= root.node_type ParseNodeType.PNODE_IDENTIFIER) { (sl_fail 2 "I require a named File reference root.") return }
            let slot: int = (sl_lookup (parser_get_identifier parser root.node_id).name)
            if (!= (at sl_locals slot).mode 0) { set reference slot }
            else {
                if (>= sl_next_ref 256) { (sl_fail 3 "I exceeded my File reference bound.") return }
                set reference sl_next_ref set sl_next_ref (+ sl_next_ref 1)
                let mut op: int = 25 if (== checked.borrow_mode 1) { set op 24 }
                (sl_op 22 0 0) (sl_local_op op reference 0 0) (sl_integer slot 2)
                set sl_loans (array_push sl_loans reference)
            }
            set references (array_push references reference) set borrowed (+ borrowed 1)
        } else {
            set references (array_push references 65535)
            (sl_expr parser space arg.node_type arg.node_id true) set values (+ values 1)
            if (and sl_next stage) { set staged (array_push staged (sl_stage (sl_wire_type checked.type checked.borrow_mode))) }
        }
        set i (+ i 1)
    }
    if (or (not sl_next) (!= sl_status 0)) { return }
    set i 0
    while (< i (array_length staged)) { (sl_load (at staged i)) (sl_clear (at staged i)) set i (+ i 1) }
