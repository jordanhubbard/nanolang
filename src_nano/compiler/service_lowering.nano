        if (and sl_next stage) { set staged (array_push staged (sl_stage (sl_node_type arg.node_type arg.node_id))) }
        set i (+ i 1)
    }
    if (not sl_next) { return }
    set i 0
    while (< i (array_length staged)) { (sl_load (at staged i)) (sl_clear (at staged i)) set i (+ i 1) }
    set sl_pending (sl_prefix sl_pending pending)
