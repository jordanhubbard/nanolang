        set sl_next true set sl_loans (sl_prefix loans (array_length loans)) set sl_pending (sl_prefix pending (array_length pending)) return
    }
    let args: array<ASTStmtRef> = (sl_children parser ParseNodeType.PNODE_BINARY_OP id)
    let stage: bool = (sl_terminal parser ParseNodeType.PNODE_BINARY_OP id 0)
    let pending: int = (array_length sl_pending) let mut staged: array<int> = [] let mut i: int = 0
    while (and sl_next (< i (array_length args))) {
