    let error: int = (sl_branch 146 slot) let mut end: int = -1 let mut continues: bool = false
    let base: int = sl_stack let loans: array<int> = (sl_prefix sl_loans (array_length sl_loans)) let pending: array<int> = (sl_prefix sl_pending (array_length sl_pending))
    let mut arm: int = 0
