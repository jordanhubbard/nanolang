        let mut index: int = 0
        while (and (< index node.arm_count) (!= (at node.arm_variants index) name)) { set index (+ index 1) }
        if (== index node.arm_count) { (sl_fail 1 "I require both Result arms.") return }
        set sl_next true set sl_stack base set sl_loans (sl_prefix loans (array_length loans)) set sl_pending (sl_prefix pending (array_length pending))
        let names: int = sl_name_count let slots: int = (array_length sl_locals)
        (sl_local_op 147 slot 0 1) (sl_integer arm 1)
        let payload: ServiceWireType = (sl_wire_type (service_member_type space fact.type name) 0)
        if (== payload.tag 0) { (sl_op 8 1 0) }
        else { (sl_store (sl_bind (at node.arm_bindings index) payload)) }
        (sl_expr parser space (at node.arm_body_types index) (at node.arm_body_ids index) want)
        (sl_scope_end names slots) set continues (or continues sl_next)
        if (and (== arm 0) sl_next) { set end (sl_branch 56 0) }
        set arm (+ arm 1)
    }
    if (>= end 0) { (sl_target end (array_length sl_code)) }
    set sl_next continues set sl_loans (sl_prefix loans (array_length loans)) set sl_pending (sl_prefix pending (array_length pending)) set sl_stack base
    if (and continues want) { set sl_stack (+ base 1) }
