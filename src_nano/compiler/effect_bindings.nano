# I retain module ownership and visibility separately from operation spelling.
import "src_nano/parser.nano"
import "src_nano/compiler/module_bindings.nano"
from "src_nano/compiler/lexer.nano" import tokenize_string
from "src_nano/compiler/nominal_bindings.nano" import nb_type

let mut eb_visible_owners: array<int> = []
let mut eb_visible_names: array<string> = []

fn eb_key(name: string) -> string { return (+ "#effect:" name) }
shadow eb_key { assert (== (eb_key "Ask") "#effect:Ask") }

fn eb_expose(owner: int, target: string) -> void {
    set eb_visible_owners (array_push eb_visible_owners owner)
    set eb_visible_names (array_push eb_visible_names target)
}
shadow eb_expose {
    set eb_visible_owners []
    set eb_visible_names []
    (eb_expose 2 "owned_Ask")
    assert (== (at eb_visible_owners 0) 2)
    assert (== (at eb_visible_names 0) "owned_Ask")
    set eb_visible_owners []
    set eb_visible_names []
}

pub fn eb_visible(name: string, line: int) -> bool {
    if (not (mb_active)) { return true }
    let owner: int = (mb_owner line)
    let mut i: int = 0
    while (< i (array_length eb_visible_names)) {
        if (and (== owner (at eb_visible_owners i)) (== name (at eb_visible_names i))) { return true }
        set i (+ i 1)
    }
    return false
}
shadow eb_visible {
    (mb_reset [1, 10])
    set eb_visible_owners []
    set eb_visible_names []
    (eb_expose 0 "Ask")
    assert (eb_visible "Ask" 2)
    assert (not (eb_visible "Ask" 12))
    (mb_reset [])
    assert (eb_visible "Ask" 12)
    set eb_visible_owners []
    set eb_visible_names []
}

pub fn eb_register(parser: Parser, prefix: string) -> bool {
    set eb_visible_owners []
    set eb_visible_names []
    let mut i: int = 0
    while (< i (array_length parser.effects)) {
        let item: ASTEffectDecl = (at parser.effects i)
        let owner: int = (mb_owner item.line)
        if (< owner 0) { return false }
        let mut j: int = 0
        while (< j i) {
            let other: ASTEffectDecl = (at parser.effects j)
            if (and (== owner (mb_owner other.line)) (== item.name other.name)) { return false }
            set j (+ j 1)
        }
        let target: string = (+ prefix (+ (int_to_string owner) (+ "_effect_" item.name)))
        (mb_add owner (eb_key item.name) target)
        (eb_expose owner target)
        set i (+ i 1)
    }
    return true
}
shadow eb_register {
    let tokens: List<LexerToken> = (tokenize_string "effect E{ask:int->int}\neffect E{read:int->int}" "effects.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "effects.nano")
    (mb_reset [1, 2])
    assert (eb_register parser "__test_")
    assert (!= (mb_lookup 0 (eb_key "E")) (mb_lookup 1 (eb_key "E")))
    (mb_reset [1])
    assert (not (eb_register parser "__test_"))
    (mb_reset [])
}

pub fn eb_import(parser: Parser, imp: ASTImport, target_owner: int) -> bool {
    let owner: int = (mb_owner imp.line)
    let mut i: int = 0
    while (< i (array_length parser.effects)) {
        let item: ASTEffectDecl = (at parser.effects i)
        if (== (mb_owner item.line) target_owner) {
            let target: string = (mb_lookup target_owner (eb_key item.name))
            if (and imp.is_selective (not imp.is_wildcard)) {
                let mut j: int = 0
                while (< j imp.import_symbol_count) {
                    if (== (at imp.import_symbols j) item.name) {
                        if (not item.is_pub) { return false }
                        let mut alias: string = item.name
                        if (< j (array_length imp.import_aliases)) {
                            if (!= (at imp.import_aliases j) "") { set alias (at imp.import_aliases j) }
                        }
                        (mb_add owner (eb_key alias) target)
                        (eb_expose owner target)
                    }
                    set j (+ j 1)
                }
            } else {
                if item.is_pub {
                    let mut name: string = item.name
                    if (!= imp.module_name "") { set name (+ imp.module_name (+ "." name)) }
                    (mb_add owner (eb_key name) target)
                    (eb_expose owner target)
                }
            }
        }
        set i (+ i 1)
    }
    return true
}
shadow eb_import {
    let tokens: List<LexerToken> = (tokenize_string "pub effect E{ask:int->int}\neffect Hidden{read:int->int}\nmodule \"lib.nano\" as lib" "effects.nano" (list_CompilerDiagnostic_new))
    let parser: Parser = (parse_program tokens (list_LexerToken_length tokens) "effects.nano")
    (mb_reset [1, 3])
    assert (eb_register parser "__test_")
    assert (eb_import parser (parser_get_import parser 0) 0)
    assert (== (mb_lookup 1 (eb_key "lib.E")) (mb_lookup 0 (eb_key "E")))
    assert (eb_visible (mb_lookup 0 (eb_key "E")) 3)
    assert (not (eb_visible (mb_lookup 0 (eb_key "Hidden")) 3))
    (mb_reset [])
}
